<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Allow file uploads up to 50MB -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <!-- Increase timeout for large file uploads -->
    <aspNetCore requestTimeout="00:10:00" />
  </system.webServer>
</configuration>

