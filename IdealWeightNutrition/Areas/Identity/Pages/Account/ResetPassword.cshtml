@page
@model ResetPasswordModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["ResetYourPassword"];
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <i class="bi bi-shield-lock"></i>
            <h2>@Localizer["ResetYourPassword"]</h2>
            <p>@Localizer["EnterNewPassword"]</p>
        </div>
        <div class="auth-body">
            <form method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                
                <div class="form-group">
                    <label asp-for="Input.Email">
                        <i class="bi bi-envelope me-2"></i>@Localizer["Email"]
                    </label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" 
                           placeholder="@Localizer["YourEmailAddress"]" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="Input.Password">
                        <i class="bi bi-lock me-2"></i>@Localizer["NewPassword"]
                    </label>
                    <input asp-for="Input.Password" class="form-control" type="password" 
                           autocomplete="new-password" placeholder="@Localizer["PasswordPlaceholder"]" 
                           aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">
                        <i class="bi bi-lock-fill me-2"></i>@Localizer["ConfirmPassword"]
                    </label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" 
                           autocomplete="new-password" placeholder="@Localizer["ConfirmPasswordPlaceholder"]" 
                           aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn-auth-submit">
                    <i class="bi bi-check-circle me-2"></i>@Localizer["ResetPassword"]
                </button>
            </form>
        </div>
        
        <div class="auth-footer">
            <p>
                <a asp-page="./Login" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i>@Localizer["BackToLogin"]
                </a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
