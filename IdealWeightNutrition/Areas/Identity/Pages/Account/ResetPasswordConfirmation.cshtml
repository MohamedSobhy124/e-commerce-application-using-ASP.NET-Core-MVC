@page
@model ResetPasswordConfirmationModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["ResetPasswordConfirmation"];
}

<div class="auth-container">
    <div class="auth-card" style="max-width: 500px;">
        <div class="auth-header">
            <i class="bi bi-check-circle-fill"></i>
            <h2>@Localizer["ResetPasswordConfirmation"]</h2>
        </div>
        <div class="auth-body">
            <div class="alert-success" style="text-align: center;">
                <i class="bi bi-shield-check" style="font-size: 3rem; color: #7BC043; margin-bottom: 1rem; display: block;"></i>
                <h3 style="color: #558B2F; margin-bottom: 1rem;">@Localizer["PasswordResetSuccessfully"]</h3>
                <p style="color: #558B2F; margin: 0; line-height: 1.6;">
                    @Localizer["PasswordResetSuccessMessage"]
                </p>
            </div>
        </div>
        
        <div class="auth-footer">
            <p>
                <a asp-page="./Login" class="auth-link">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["ClickHereToLogIn"]
                </a>
            </p>
        </div>
    </div>
</div>
