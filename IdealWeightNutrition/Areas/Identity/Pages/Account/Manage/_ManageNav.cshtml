@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav class="account-nav">
    <div class="nav-header mb-3">
        <h5 class="mb-0">
            <i class="bi bi-list-ul me-2"></i>@Localizer["AccountSettings"]
        </h5>
    </div>
    <ul class="nav nav-pills flex-column account-nav-list">
        <li class="nav-item">
            <a class="nav-link account-nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
                <i class="bi bi-person-circle me-2"></i>
                <span>@Localizer["Profile"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link account-nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
                <i class="bi bi-envelope me-2"></i>
                <span>@Localizer["Email"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link account-nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
                <i class="bi bi-key me-2"></i>
                <span>@Localizer["Password"]</span>
            </a>
        </li>
       @*  @if (hasExternalLogins)
        {
            <li class="nav-item">
                <a class="nav-link account-nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" id="external-login" asp-page="./ExternalLogins">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    <span>@Localizer["ExternalLogins"]</span>
                </a>
            </li>
        } *@
    
         
    </ul>
</nav>

<style>
    .account-nav {
        margin: 0;
    }

    .nav-header {
        padding-bottom: 1rem;
        border-bottom: 2px solid #e9ecef;
    }

    .nav-header h5 {
        color: #2c3e50;
        font-weight: 600;
    }

    .account-nav-list {
        gap: 0.5rem;
    }

    .account-nav-link {
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: #6c757d !important;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        text-decoration: none;
        margin-bottom: 0.25rem;
    }

    .account-nav-link:hover {
        background-color: #f8f9fa;
        color: #3b82f6;
        transform: translateX(5px);
    }

    .account-nav-link.active {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
        font-weight: 600;
    }

    .account-nav-link i {
        font-size: 1.1rem;
        width: 24px;
    }
</style>
