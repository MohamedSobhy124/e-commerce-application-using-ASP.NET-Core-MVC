@page
@model IndexModel
@{
    ViewData["Title"] = Localizer["Profile"];
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="page-header mb-4">
    <h3 class="page-title">
        <i class="bi bi-person-circle me-2"></i>@ViewData["Title"]
    </h3>
    <p class="page-subtitle">@Localizer["ProfileSubtitle"]</p>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="profile-form-wrapper">
    <form id="profile-form" method="post" class="modern-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        
        <!-- Basic Information Card -->
        <div class="form-card">
            <div class="form-card-header">
                <i class="bi bi-person-badge me-2"></i>
                <span>@Localizer["BasicInformation"]</span>
            </div>
            <div class="form-card-body">
                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" placeholder="@Localizer["Username"]" disabled />
                    <label asp-for="Username" class="form-label">
                        <i class="bi bi-at me-2"></i>@Localizer["Username"]
                    </label>
                    <small class="form-text text-muted">
                        <i class="bi bi-lock me-1"></i>@Localizer["UsernameCannotBeChanged"]
                    </small>
                </div>
                
                <div class="form-floating mb-3">
                    <input asp-for="Input.Name" class="form-control" placeholder="@Localizer["FullName"]" />
                    <label asp-for="Input.Name" class="form-label">
                        <i class="bi bi-person me-2"></i>@Localizer["FullName"]
                    </label>
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                
                <div class="form-floating mb-3">
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="@Localizer["PhoneNumber"]" />
                    <label asp-for="Input.PhoneNumber" class="form-label">
                        <i class="bi bi-telephone me-2"></i>@Localizer["PhoneNumber"]
                    </label>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <!-- Address Information Card -->
        <div class="form-card">
            <div class="form-card-header">
                <i class="bi bi-geo-alt me-2"></i>
                <span>@Localizer["AddressInformation"]</span>
            </div>
            <div class="form-card-body">
                <div class="form-floating mb-3">
                    <input asp-for="Input.StreetAddress" class="form-control" placeholder="@Localizer["StreetAddress"]" />
                    <label asp-for="Input.StreetAddress" class="form-label">
                        <i class="bi bi-house me-2"></i>@Localizer["StreetAddress"]
                    </label>
                    <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                </div>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.City" class="form-control" placeholder="@Localizer["City"]" />
                            <label asp-for="Input.City" class="form-label">
                                <i class="bi bi-building me-2"></i>@Localizer["City"]
                            </label>
                            <span asp-validation-for="Input.City" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.State" class="form-control" placeholder="@Localizer["State"]" />
                            <label asp-for="Input.State" class="form-label">
                                <i class="bi bi-map me-2"></i>@Localizer["State"]
                            </label>
                            <span asp-validation-for="Input.State" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <div class="form-floating mb-3 mt-3">
                    <input asp-for="Input.PostalCode" class="form-control" placeholder="@Localizer["PostalCode"]" />
                    <label asp-for="Input.PostalCode" class="form-label">
                        <i class="bi bi-mailbox me-2"></i>@Localizer["PostalCode"]
                    </label>
                    <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                </div>
                
                <small class="form-text text-muted">
                    <i class="bi bi-info-circle me-1"></i>@Localizer["AddressWillBeUsedForCheckout"]
                </small>
            </div>
        </div>
        
        <div class="form-actions">
            <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-check-circle-fill me-2"></i>@Localizer["SaveChanges"]
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        /* Modern Page Header with Gradient */
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 2.5rem 2rem;
            border-radius: 20px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }
        
        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }
        
        .page-header::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .page-title i {
            font-size: 2.5rem;
            animation: iconPulse 2s ease-in-out infinite;
        }
        
        @@keyframes iconPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .page-subtitle {
            color: rgba(255,255,255,0.95);
            margin: 0;
            font-size: 1.1rem;
            position: relative;
            z-index: 1;
        }

        .profile-form-wrapper {
            margin-top: 2rem;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Cool Card Design with Glass Morphism */
        .form-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            margin-bottom: 2rem;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            animation: slideInUp 0.6s ease-out;
        }
        
        @@keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .form-card:nth-child(3) {
            animation-delay: 0.2s;
        }
        
        .form-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(102, 126, 234, 0.2);
            border-color: rgba(102, 126, 234, 0.3);
        }

        .form-card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1.25rem 1.5rem;
            font-weight: 600;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        .form-card-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }
        
        .form-card:hover .form-card-header::before {
            left: 100%;
        }
        
        .form-card-header i {
            font-size: 1.5rem;
            margin-right: 0.5rem;
        }

        .form-card-body {
            padding: 2rem 1.5rem;
            background: white;
        }

        /* Enhanced Form Controls */
        .form-floating {
            position: relative;
        }
        
        .form-floating .form-control {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 1rem 1rem 1rem 3rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: white;
            height: 58px;
        }
        
        .form-floating .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.15);
            transform: translateY(-2px);
        }
        
        .form-floating .form-control:disabled {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            cursor: not-allowed;
            opacity: 0.8;
        }
        
        .form-floating label {
            padding-left: 3rem;
            color: #6c757d;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .form-floating label i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #667eea;
            font-size: 1.25rem;
            z-index: 5;
        }

        /* Status Badges */
        .form-text {
            display: flex;
            align-items: center;
            margin-top: 0.75rem;
            font-size: 0.9rem;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 8px;
        }
        
        .form-text.text-muted {
            color: #6c757d !important;
            background: rgba(108, 117, 125, 0.05);
            border-left: 4px solid #6c757d;
        }
        
        .form-text i {
            margin-right: 0.5rem;
        }

        /* Action Buttons */
        .form-actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 2rem;
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 15px;
            animation: slideInUp 0.6s ease-out 0.4s both;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 1rem 3rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .btn-primary::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }
        
        .btn-primary:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-primary:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.5);
        }
        
        .btn-primary:active {
            transform: translateY(-2px) scale(1.02);
        }
        
        .btn-primary i {
            position: relative;
            z-index: 1;
        }

        /* Validation Alert */
        .alert-danger {
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
            color: #991b1b;
            border-left: 4px solid #dc2626;
            animation: shake 0.5s;
        }
        
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        /* Mobile Responsive */
        @@media (max-width: 768px) {
            .page-header {
                padding: 2rem 1.5rem;
                border-radius: 15px;
            }
            
            .page-title {
                font-size: 1.5rem;
            }
            
            .page-title i {
                font-size: 2rem;
            }
            
            .page-subtitle {
                font-size: 1rem;
            }
            
            .form-card-header {
                padding: 1rem;
                font-size: 1rem;
            }
            
            .form-card-body {
                padding: 1.25rem 1rem;
            }
            
            .btn-primary {
                padding: 0.875rem 2rem;
                font-size: 1rem;
                width: 100%;
            }
            
            .form-actions {
                padding: 1rem;
            }
            
            .form-floating .form-control {
                font-size: 16px; /* Prevents zoom on iOS */
            }
        }
        
        /* Extra Small Devices */
        @@media (max-width: 576px) {
            .page-header {
                padding: 1.5rem 1rem;
                border-radius: 12px;
            }
            
            .page-title {
                font-size: 1.25rem;
                flex-direction: column;
                text-align: center;
            }
            
            .page-title i {
                font-size: 2.5rem;
                margin-bottom: 0.5rem;
            }
            
            .form-card {
                border-radius: 15px;
            }
            
            .form-card-header {
                padding: 0.875rem;
                font-size: 0.95rem;
            }
            
            .profile-form-wrapper {
                padding: 0 0.5rem;
            }
        }
        
        /* Touch Device Improvements */
        @@media (hover: none) {
            .form-card:hover {
                transform: none;
            }
            
            .btn-primary:hover {
                transform: none;
            }
            
            .form-card-header::before {
                display: none;
            }
        }
        
        /* Loading State */
        .btn[disabled] {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        /* Focus States for Accessibility */
        .form-control:focus,
        .btn:focus {
            outline: 3px solid rgba(102, 126, 234, 0.3);
            outline-offset: 2px;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
