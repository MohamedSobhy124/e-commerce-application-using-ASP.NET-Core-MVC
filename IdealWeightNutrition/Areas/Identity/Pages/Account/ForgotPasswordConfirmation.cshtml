@page
@model ForgotPasswordConfirmation
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["ForgotPasswordConfirmation"];
}

<div class="auth-container">
    <div class="auth-card" style="max-width: 500px;">
        <div class="auth-header">
            <i class="bi bi-envelope-check"></i>
            <h2>@Localizer["ForgotPasswordConfirmation"]</h2>
        </div>
        <div class="auth-body">
            <div class="alert-success" style="text-align: center;">
                <i class="bi bi-check-circle-fill" style="font-size: 3rem; color: #7BC043; margin-bottom: 1rem; display: block;"></i>
                <h3 style="color: #558B2F; margin-bottom: 1rem;">@Localizer["CheckYourEmail"]</h3>
                <p style="color: #558B2F; margin: 0; line-height: 1.6;">
                    @Localizer["PasswordResetEmailSent"]
                </p>
            </div>
            
            <div style="text-align: center; margin-top: 1.5rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
                <p style="color: #666; font-size: 0.9rem; margin: 0;">
                    <i class="bi bi-info-circle me-1"></i>@Localizer["DidNotReceiveEmail"]
                </p>
            </div>
        </div>
        
        <div class="auth-footer">
            <p>
                <a asp-page="./Login" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i>@Localizer["BackToLogin"]
                </a>
            </p>
        </div>
    </div>
</div>
