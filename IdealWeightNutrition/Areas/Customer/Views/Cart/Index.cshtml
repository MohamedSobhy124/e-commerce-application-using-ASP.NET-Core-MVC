@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using IdealWeightNutrition.Utility
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@model ShoppingCartVM
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var hasItems = Model.ShoppingCartList != null && Model.ShoppingCartList.Any();
}

<section class="cart-page-wrapper">
    <div class="container py-4">
        <a asp-action="Index" asp-controller="Home" class="continue-shopping-btn">
            <i class="bi bi-arrow-left"></i>
            @Localizer["ContinueShopping"]
        </a>
        
        <div class="row">
            <div class="col-lg-8 col-md-12">
                <div class="cart-header-section">
                    <h3 class="cart-title">
                        <i class="bi bi-cart3"></i>
                        @Localizer["ShoppingCart"]
                        @if (hasItems)
                        {
                            <span class="cart-item-count-badge">@Model.ShoppingCartList.Count()</span>
                        }
                    </h3>
                </div>

                @if (!hasItems)
                {
                    <div class="empty-cart-container">
                        <i class="bi bi-cart-x empty-cart-icon"></i>
                        <h2 class="empty-cart-title">@Localizer["YourCartIsEmpty"]</h2>
                        <p class="empty-cart-message">@Localizer["AddItemsToStartShopping"]</p>
                        <a asp-action="Index" asp-controller="Home" class="continue-shopping-btn">
                            <i class="bi bi-arrow-left"></i>
                            @Localizer["ContinueShopping"]
                        </a>
                    </div>
                }
                else
                {
                    @foreach(var item in Model.ShoppingCartList)
                    {
                        // Check if this is a combo offer
                        bool isComboOffer = item.ComboOfferId.HasValue && item.ComboOffer != null;
                        bool hasFlashSale = item.FlashSaleItemId.HasValue && item.FlashSalePrice.HasValue;
                        bool hasVariant = item.ProductVariantId.HasValue && item.ProductVariant != null;
                        
                        // Get display name - use localized version based on current culture
                        string displayName = isComboOffer 
                            ? (currentCulture == "ar" && !string.IsNullOrEmpty(item.ComboOffer.NameAr) 
                                ? item.ComboOffer.NameAr 
                                : item.ComboOffer.Name)
                            : (currentCulture == "ar" && !string.IsNullOrEmpty(item.product.TitleAr) 
                                ? item.product.TitleAr 
                                : item.product.Title);
                        
                        // Get image - prioritize variant image if available
                        string productImageUrl = null;
                        if (isComboOffer && !string.IsNullOrEmpty(item.ComboOffer.ImageUrl))
                        {
                            productImageUrl = item.ComboOffer.ImageUrl;
                        }
                        else if (hasVariant && item.ProductVariant != null && !string.IsNullOrEmpty(item.ProductVariant.ImageUrl))
                        {
                            // Use variant image if available - normalize path (convert backslashes to forward slashes)
                            productImageUrl = item.ProductVariant.ImageUrl.Replace('\\', '/');
                            // Ensure it starts with / if it's a relative path
                            if (!productImageUrl.StartsWith("/") && !productImageUrl.StartsWith("http"))
                            {
                                productImageUrl = "/" + productImageUrl;
                            }
                        }
                        else if (item.product.ProductImages != null && item.product.ProductImages.Any())
                        {
                            var firstImage = item.product.ProductImages.OrderBy(pi => pi.DisplayOrder).FirstOrDefault();
                            productImageUrl = firstImage?.ImageUrl;
                        }
                        else if (!string.IsNullOrEmpty(item.product.ImageUrl))
                        {
                            productImageUrl = item.product.ImageUrl;
                        }
                        
                        if (string.IsNullOrEmpty(productImageUrl))
                        {
                            productImageUrl = "/images/no-image.png";
                        }
                        
                        // Calculate prices
                        decimal unitPrice = (decimal)item.Price;
                        decimal totalPrice = unitPrice * item.Count;
                        decimal? originalPrice = hasFlashSale && (decimal)item.product.Price > unitPrice ? (decimal)item.product.Price : null;
                        
                        // Get variant display string
                        string variantDisplayText = null;
                        if (hasVariant && item.ProductVariant != null)
                        {
                            // Try to get variant option values directly
                            if (item.ProductVariant.VariantOptionValues != null && item.ProductVariant.VariantOptionValues.Any())
                            {
                                var variantParts = item.ProductVariant.VariantOptionValues
                                    .OrderBy(vov => vov.OptionValue?.ProductOption?.DisplayOrder ?? 0)
                                    .ThenBy(vov => vov.OptionValue?.DisplayOrder ?? 0)
                                    .Select(vov => 
                                    {
                                        if (vov.OptionValue == null) return "";
                                        
                                        var optionName = currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue.ProductOption?.NameAr) 
                                            ? vov.OptionValue.ProductOption.NameAr 
                                            : vov.OptionValue.ProductOption?.Name ?? "";
                                        var optionValue = currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue.ValueAr) 
                                            ? vov.OptionValue.ValueAr 
                                            : vov.OptionValue.Value ?? "";
                                        
                                        if (string.IsNullOrEmpty(optionName) || string.IsNullOrEmpty(optionValue))
                                            return optionValue ?? optionName ?? "";
                                        
                                        return $"{optionName}: {optionValue}";
                                    })
                                    .Where(v => !string.IsNullOrEmpty(v));
                                
                                variantDisplayText = variantParts.Any() ? string.Join(" / ", variantParts) : Localizer["Default"].Value;
                            }
                            else
                            {
                                // If no option values, check if VariantName property is available
                                variantDisplayText = !string.IsNullOrEmpty(item.ProductVariant.VariantName) 
                                    ? item.ProductVariant.VariantName 
                                    : Localizer["Default"].Value;
                            }
                        }
                        else if (item.ProductVariantId.HasValue && item.ProductVariant == null)
                        {
                            // Variant ID exists but variant not loaded - show default
                            variantDisplayText = Localizer["Default"].Value;
                        }

                        <div class="cart-item-card">
                            <div class="cart-item-row">
                                <!-- Product Image -->
                                <div class="cart-item-col cart-item-image-col">
                                    <div class="cart-item-image-wrapper" data-image-url="@productImageUrl" data-product-name="@displayName" style="cursor: pointer;">
                                        <img src="@productImageUrl" class="cart-item-image" alt="@displayName">
                                        <div class="image-zoom-overlay">
                                            <i class="bi bi-zoom-in"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product Details -->
                                <div class="cart-item-col cart-item-details-col">
                                    <h4 class="cart-item-title">@displayName</h4>
                                    
                                    @if (item.ProductVariantId.HasValue || hasVariant)
                                    {
                                        <div class="cart-item-variant-display">
                                            <i class="bi bi-tag-fill"></i>
                                            <span>@(variantDisplayText ?? Localizer["Default"].Value)</span>
                                        </div>
                                    }
                                    
                                    <div class="cart-item-badges">
                                        @if (hasFlashSale)
                                        {
                                            <span class="cart-badge flash-sale">
                                                <i class="bi bi-lightning-fill"></i>
                                                @Localizer["FlashSale"]
                                            </span>
                                        }
                                        @if (isComboOffer)
                                        {
                                            <span class="cart-badge combo">
                                                <i class="bi bi-box-seam"></i>
                                                @Localizer["ComboOffer"]
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Quantity Controls -->
                                <div class="cart-item-col cart-item-quantity-col">
                                    <div class="cart-quantity-controls">
                                        <a href="#" class="cart-quantity-btn minus-btn" data-cart-id="@item.Id" data-product-id="@item.ProductId">
                                            <i class="bi bi-dash"></i>
                                        </a>
                                        <input readonly value="@item.Count" type="number" class="cart-quantity-input" />
                                        <a href="#" class="cart-quantity-btn plus-btn" data-cart-id="@item.Id" data-product-id="@item.ProductId">
                                            <i class="bi bi-plus"></i>
                                        </a>
                                    </div>
                                </div>

                                <!-- Price and Delete -->
                                <div class="cart-item-col cart-item-price-col">
                                    <div class="cart-item-price-wrapper">
                                        @if (originalPrice.HasValue && originalPrice.Value > 0)
                                        {
                                            <div class="cart-item-price original-price">@Html.Raw(currencySymbol) @originalPrice.Value.ToString("N2")</div>
                                        }
                                        <div class="cart-item-price @(hasFlashSale ? "sale-price" : "")">
                                            @Html.Raw(currencySymbol) @unitPrice.ToString("N2")
                                        </div>
                                        <div class="cart-item-total">
                                            @Html.Raw(currencySymbol) @totalPrice.ToString("N2")
                                        </div>
                                    </div>
                                    <a href="#" class="cart-delete-btn" data-cart-id="@item.Id" data-product-id="@item.ProductId" title="@Localizer["Remove"]">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </div>  
                        </div>
                    }
                }
            </div>
            
            @if (hasItems)
            {
                <div class="col-lg-4 col-md-12">
                    <div class="cart-total-card">
                        <p class="cart-total-label">@Localizer["TotalAmount"]</p>
                        <h2 class="cart-total-amount">@Html.Raw(currencySymbol) @Model.OrderTotal.ToString("N2")</h2>
                        <hr style="border-color: rgba(255,255,255,0.3); margin: 1.5rem 0;" />
                        <a asp-action="Summary" class="cart-summary-btn">
                            @Localizer["ProceedToSummary"]
                            <i class="bi bi-arrow-right-circle"></i>
                        </a>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/cart-enhanced.css" />
}

@section Scripts {
    <!-- Load SweetAlert2 before cart-ajax.js to ensure it's available -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" crossorigin="anonymous"></script>
    <script>
        // Define cart action URLs
        window.cartUrls = {
            plus: '@Url.Action("Pluse", "Cart", new { area = "Customer" })',
            minus: '@Url.Action("Minus", "Cart", new { area = "Customer" })',
            remove: '@Url.Action("Remove", "Cart", new { area = "Customer" })'
        };
        
        // Localized messages for cart operations
        window.cartMessages = {
            unitPriceZero: '@Html.Raw(Localizer["UnitPriceZero"] ?? (currentCulture == "ar" ? "تحذير: سعر الوحدة صفر. يرجى التحقق من السعر." : "Warning: Unit price is zero. Please check the price."))',
            flashSaleStockLimit: '@Html.Raw(Localizer["FlashSaleStockLimit"] ?? (currentCulture == "ar" ? "متوفر فقط {0} وحدة لهذا العرض الخاص" : "Only {0} units available for this flash sale"))',
            failedToUpdateQuantity: '@Html.Raw(Localizer["FailedToUpdateQuantity"] ?? (currentCulture == "ar" ? "فشل تحديث الكمية. يرجى المحاولة مرة أخرى." : "Failed to update quantity. Please try again."))',
            errorOccurred: '@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"] ?? (currentCulture == "ar" ? "حدث خطأ. يرجى المحاولة مرة أخرى." : "An error occurred. Please try again."))'
        };
        
        // Verify SweetAlert is loaded and wait for it
        $(document).ready(function() {
            let attempts = 0;
            const maxAttempts = 50; // Wait up to 5 seconds
            
            function checkSweetAlert() {
                if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                    console.log('✅ SweetAlert2 is loaded and ready');
                    // Make sure it's globally available
                    window.Swal = Swal;
                } else if (attempts < maxAttempts) {
                    attempts++;
                    setTimeout(checkSweetAlert, 100);
                } else {
                    console.error('❌ SweetAlert2 failed to load after waiting');
                }
            }
            
            checkSweetAlert();
        });
    </script>
    
    <!-- Image Modal -->
    <div class="modal fade" id="productImageModal" tabindex="-1" aria-labelledby="productImageModalLabel" aria-hidden="true" data-bs-backdrop="true" data-bs-keyboard="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background: transparent; border: none; position: relative;">
                <div class="modal-body" style="padding: 0; text-align: center; position: relative;">
                    <button type="button" class="btn-close-modal" data-bs-dismiss="modal" aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <img id="modalProductImage" src="" alt="" class="img-fluid" style="max-width: 100%; max-height: 80vh; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
                    <h5 id="modalProductName" class="mt-3 text-white" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);"></h5>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Image modal functionality
        $(document).ready(function() {
            $('.cart-item-image-wrapper').on('click', function() {
                const imageUrl = $(this).data('image-url');
                const productName = $(this).data('product-name');
                
                if (imageUrl) {
                    $('#modalProductImage').attr('src', imageUrl);
                    $('#modalProductName').text(productName || '');
                    $('#productImageModal').modal('show');
                }
            });
            
            // Close modal on ESC key
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape') {
                    $('#productImageModal').modal('hide');
                }
            });
            
            // Close modal when clicking outside the image (on backdrop)
            $('#productImageModal').on('click', function(e) {
                // Check if click is on the backdrop (not on modal content)
                if ($(e.target).hasClass('modal') || $(e.target).hasClass('modal-backdrop')) {
                    $('#productImageModal').modal('hide');
                }
            });
            
            // Prevent closing when clicking on the image itself
            $('#productImageModal .modal-body').on('click', function(e) {
                e.stopPropagation();
            });
        });
    </script>
    
    <script src="~/js/cart-ajax.js"></script>
}
