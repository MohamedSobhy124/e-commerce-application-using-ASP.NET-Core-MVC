			$('.payment-method-section .validation-error-message').remove();
		});
	});

		var selectedCityId = null;
		var cityDefaultCharge = 0;

		// Handle city selection
		$('#citySelect').on('change', function() {
			var selectedOption = $(this).find('option:selected');
			selectedCityId = selectedOption.data('city-id');
			cityDefaultCharge = parseFloat(selectedOption.data('city-delivery-charge')) || 0;
			
			// Reset everything
			$('#areaSelect').val('').html('<option value="">' + localizedSelectArea + '</option>');
			$('#customAreaInput').val('').removeClass('is-invalid');
			$('#customAreaError').hide();
			$('#stateInput').val(''); // Reset State field
			$('#areaRow').hide();
			$('#customAreaRow').hide();
			$('#deliveryChargeDisplay').hide();
			$('#deliveryChargeSection').hide();
			deliveryCharge = 0;
			updateTotals();
			
			if (selectedCityId) {
				// Load areas for this city - this will show appropriate input (dropdown or manual)
				loadAreasForCity(selectedCityId);
				// Check free delivery eligibility
				checkFreeDeliveryEligibility(selectedCityId, null);
			} else {
				// No city selected - hide everything
				$('#areaRow').hide();
				$('#customAreaRow').hide();
				deliveryCharge = 0;
				updateDeliveryChargeDisplay();
				updateTotals();
			}
		});

		// Handle area selection
		$('#areaSelect').on('change', function() {
			var selectedValue = $(this).val();
			var selectedOption = $(this).find('option:selected');
			
			if (selectedValue === 'OTHER') {
				// Hide dropdown, show only custom area input
				$('#areaRow').hide();
				$('#customAreaRow').show();
				$('#customAreaInput').prop('required', true).focus();
				$('#areaSelect').prop('required', false);
				// Clear and set delivery charge to city default
				$('#areaSelect').val('OTHER'); // Keep OTHER selected for form submission
				// State will be set when user types in custom input
				$('#stateInput').val('');
				// Check free delivery eligibility
				checkFreeDeliveryEligibility(selectedCityId, 'OTHER');
			} else if (selectedValue) {
				// Remote area selected - show dropdown, hide custom input
				$('#areaRow').show();
				$('#customAreaRow').hide();
				$('#customAreaInput').prop('required', false).val('');
				$('#areaSelect').prop('required', true);
				// Set State to the selected area value
				$('#stateInput').val(selectedValue);
				// Check free delivery eligibility with area name
				checkFreeDeliveryEligibility(selectedCityId, selectedValue);
			} else {
				// No area selected
				$('#customAreaRow').hide();
				$('#customAreaInput').prop('required', false).val('');
				$('#stateInput').val('');
				deliveryCharge = 0;
				$('#deliveryChargeDisplay').hide();
				$('#deliveryChargeSection').hide();
				updateTotals();
			}
		});

		// Handle custom area input - only update delivery charge, don't touch dropdown
		$('#customAreaInput').on('input', function() {
			var customValue = $(this).val().trim();
			// Set State to the custom area value
			$('#stateInput').val(customValue);
			// Check free delivery eligibility for custom area (treated as "OTHER")
			if (selectedCityId) {
				checkFreeDeliveryEligibility(selectedCityId, 'OTHER');
			}
		});

		// Function to load areas for a city
		function loadAreasForCity(cityId) {
			$.ajax({
				url: '@Url.Action("GetAreasByCity", "Cart")',
				type: 'GET',
				data: { cityId: cityId },
				success: function(response) {
					if (response.success) {
						var $areaSelect = $('#areaSelect');
						var $customAreaRow = $('#customAreaRow');
						
						// Store city default charge
						cityDefaultCharge = response.cityDefaultCharge || 0;
						
						// Check if city has remote areas
						if (response.hasRemoteAreas && response.areas && response.areas.length > 0) {
							// City has remote areas - show dropdown with remote areas + Other option
							$areaSelect.html('<option value="">' + localizedSelectArea + '</option>');
							
							// Add remote areas
							response.areas.forEach(function(area) {
								$areaSelect.append($('<option></option>')
									.attr('value', area.name)
									.attr('data-delivery-charge', area.deliveryCharge)
									.text(area.name));
							});
							
							// Add "Other" option - use the localized variable
							var $otherOption = $('<option></option>')
								.attr('value', 'OTHER');
							$otherOption.text(localizedOther);
							$areaSelect.append($otherOption);
							
							// Show dropdown initially, hide manual input
							$('#areaRow').show();
							$customAreaRow.hide();
							$areaSelect.prop('required', true);
							$('#customAreaInput').prop('required', false).val('');
						} else {
							// City has no remote areas - show manual input directly, hide dropdown
							$('#areaRow').hide();
							$customAreaRow.show();
							$areaSelect.prop('required', false);
							$('#customAreaInput').prop('required', true);
							// Set a hidden value in areaSelect for form submission
							$areaSelect.html('<option value="OTHER" selected style="display:none;">' + localizedOther + '</option>');
							// Check free delivery eligibility
							checkFreeDeliveryEligibility(cityId, 'OTHER');
						}
					}
				},
				error: function() {
					console.error('Error loading areas');
					// On error, show manual input as fallback
					$('#areaRow').hide();
					$('#customAreaRow').show();
					$('#areaSelect').prop('required', false);
					$('#customAreaInput').prop('required', true);
				}
			});
		}

		// Function to check free delivery eligibility
		function checkFreeDeliveryEligibility(cityId, areaName) {
			if (!cityId) {
				deliveryCharge = 0;
				updateDeliveryChargeDisplay();
				updateTotals();
				return;
			}

			$.ajax({
				url: '@Url.Action("CheckFreeDeliveryEligibility", "Cart")',
				type: 'GET',
				data: { 
					cityId: cityId,
					areaName: areaName || null
				},
				success: function(response) {
					if (response.success) {
						deliveryCharge = response.deliveryCharge || 0;
						updateDeliveryChargeDisplay();
						updateTotals();
					}
				},
				error: function() {
					console.error('Error checking free delivery eligibility');
					// Fallback to city default charge
					updateDeliveryChargeDisplay();
					updateTotals();
				}
			});
		}

		// Function to update delivery charge display
		function updateDeliveryChargeDisplay() {
			if (deliveryCharge > 0) {
				$('#deliveryChargeDisplay').show();
				$('#deliveryChargeSection').show();
				$('#freeDeliveryMessage').hide();
				$('#deliveryChargeAmount').text(formatCurrency(deliveryCharge));
				$('#deliveryChargeTotal').text(formatCurrency(deliveryCharge));
			} else {
				$('#deliveryChargeDisplay').hide();
				$('#deliveryChargeSection').hide();
				$('#freeDeliveryMessage').show();
			}
		}

		function updateTotals() {
			var finalTotal = subtotal - currentDiscount + deliveryCharge;
			$('#finalTotal').text(formatCurrency(finalTotal));
			
			// Update payment method visibility based on final total
			updatePaymentMethodsVisibility(finalTotal);
		}
		
		// Function to update payment methods visibility based on order total
		function updatePaymentMethodsVisibility(finalTotal) {
			var $tabbyOption = $('#tabbyPaymentOption');
			var $tamaraOption = $('#tamaraPaymentOption');
			var $alternativePayments = $('#alternativePayments');
			var $minimumNotice = $('#paymentMinimumNotice');
			
			// Check Tabby availability - use "enabled" flag (from settings) and check against minimum amount
			var tabbyVisible = tappyEnabled && finalTotal >= tappyMinimumOrderAmount;
			// Check Tamara availability  
			var tamaraVisible = tamaraEnabled && finalTotal >= tamaraMinimumOrderAmount;
			
			// Update Tabby visibility with animation
			if (tabbyVisible) {
				$tabbyOption.removeClass('hiding').css('display', '').fadeIn(300);
			} else {
				$tabbyOption.addClass('hiding').fadeOut(300, function() {
					$(this).css('display', 'none');
				});
				// If Tabby was selected and is now hidden, switch to Geidea
				if ($('#paymentTappy').is(':checked')) {
					$('#paymentGeidea').prop('checked', true);
				}
			}
			
			// Update Tamara visibility with animation
			if (tamaraVisible) {
				$tamaraOption.removeClass('hiding').css('display', '').fadeIn(300);
			} else {
				$tamaraOption.addClass('hiding').fadeOut(300, function() {
					$(this).css('display', 'none');
				});
				// If Tamara was selected and is now hidden, switch to Geidea
				if ($('#paymentTamara').is(':checked')) {
					$('#paymentGeidea').prop('checked', true);
				}
			}
			
			// Show/hide alternative payments section
			if (tabbyVisible || tamaraVisible) {
				$alternativePayments.css('display', '').slideDown(300);
			} else {
				$alternativePayments.slideUp(300);
			}
			
			// Show minimum amount notice if neither alternative is available but they could be
			var showNotice = false;
			var noticePayments = [];
			
			if (tappyEnabled && !tabbyVisible && finalTotal < tappyMinimumOrderAmount) {
				noticePayments.push('Tabby');
			}
			if (tamaraEnabled && !tamaraVisible && finalTotal < tamaraMinimumOrderAmount) {
				noticePayments.push('Tamara');
			}
			
			if (noticePayments.length > 0) {
				var minAmount = Math.max(tappyMinimumOrderAmount, tamaraMinimumOrderAmount);
				var amountNeeded = (minAmount - finalTotal).toFixed(0);
				var paymentNames = noticePayments.join(' & ');
				var noticeText = localizedMinimumOrderMessage.replace('{0}', amountNeeded).replace('{1}', paymentNames);
				$('#paymentMinimumNoticeText').text(noticeText);
				$minimumNotice.slideDown(300);
			} else {
				$minimumNotice.slideUp(300);
			}
		}

		function showPromoMessage(message, type) {
			var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
			var icon = type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill';
			
			$('#promoCodeMessage').html(
				'<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
				'<i class="bi bi-' + icon + ' me-2"></i>' + message +
				'<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
				'</div>'
			);
		}

		const currencySymbol = '@Html.Raw(currencySymbol)';
		function formatCurrency(amount) {
			return currencySymbol + ' ' + amount.toFixed(2);
		}

		// Geidea v2 HPP Payment Integration
		function initiateGeideaPayment(sessionId, orderId, callback) {
			// Load Geidea HPP v2 library if not already loaded
			if (typeof GeideaCheckout === 'undefined') {
				var script = document.createElement('script');
					script.src = 'https://payments.geidea.ae/hpp/geideaCheckout.min.js';
				script.onload = function() {
					startGeideaPayment(sessionId, orderId, callback);
				};
				script.onerror = function() {
					Swal.fire({
						icon: 'error',
						title: 'Payment Error',
						text: 'Failed to load Geidea payment library. Please try again.',
						confirmButtonText: 'OK'
					});
					if (callback) callback(false);
				};
				document.head.appendChild(script);
			} else {
				startGeideaPayment(sessionId, orderId, callback);
			}
		}

		function startGeideaPayment(sessionId, orderId, callback) {
			try {
				// Initialize GeideaCheckout with callback handlers
				const payment = new GeideaCheckout(
					function onSuccess(data) {
						// Payment successful
						if (callback) callback(true);
					},
					function onError(error) {
						// Payment error - extract all available error information
						console.error('Geidea payment error', error);
						
						// Build detailed error message
						let errorMessage = 'Payment failed. Please try again.';
						let errorDetails = [];
						
						if (error) {
							// Extract error message
							if (error.message) {
								errorMessage = error.message;
							} else if (typeof error === 'string') {
								errorMessage = error;
							} else if (error.error) {
								errorMessage = error.error;
							} else if (error.errorMessage) {
								errorMessage = error.errorMessage;
							}
							
							// Extract additional error details
							if (error.code) {
								errorDetails.push(`Error Code: ${error.code}`);
							}
							if (error.status) {
								errorDetails.push(`Status: ${error.status}`);
							}
							if (error.statusCode) {
								errorDetails.push(`Status Code: ${error.statusCode}`);
							}
							if (error.responseCode) {
								errorDetails.push(`Response Code: ${error.responseCode}`);
							}
							if (error.detailedResponseCode) {
								errorDetails.push(`Detailed Response Code: ${error.detailedResponseCode}`);
							}
							if (error.detailedResponseMessage) {
								errorDetails.push(`Details: ${error.detailedResponseMessage}`);
							}
							if (error.responseMessage) {
								errorDetails.push(`Response: ${error.responseMessage}`);
							}
							
							// Log full error object for debugging
							console.error('Full Geidea error object:', JSON.stringify(error, null, 2));
						}
						
						// Build HTML content for SweetAlert
						let htmlContent = `<div style="text-align: left;">
							<p style="margin-bottom: 10px; font-weight: 600; color: #dc2626;">${errorMessage}</p>
							${errorDetails.length > 0 ? `<div style="margin-top: 15px; padding: 10px; background-color: #fef2f2; border-radius: 6px; border-left: 3px solid #dc2626;">
								<p style="margin: 0 0 8px 0; font-weight: 600; color: #991b1b; font-size: 0.875rem;">Error Details:</p>
								<ul style="margin: 0; padding-left: 20px; color: #7f1d1d; font-size: 0.875rem;">
									${errorDetails.map(detail => `<li style="margin-bottom: 4px;">${detail}</li>`).join('')}
								</ul>
							</div>` : ''}
						</div>`;
						
						Swal.fire({
							icon: 'error',
							title: 'Payment Failed',
							html: htmlContent,
							confirmButtonText: 'OK',
							confirmButtonColor: '#dc2626',
							width: '500px',
							customClass: {
								popup: 'swal2-popup-enhanced',
								title: 'swal2-title-enhanced',
								htmlContainer: 'swal2-html-container-enhanced'
							}
						});
						if (callback) callback(false);
					},
					function onCancel() {
						// Payment cancelled
						Swal.fire({
							icon: 'info',
							title: 'Payment Cancelled',
							text: 'Payment was cancelled. You can try again.',
							confirmButtonText: 'OK',
							customClass: {
								popup: 'swal2-popup-enhanced',
								title: 'swal2-title-enhanced'
							}
						});
						if (callback) callback(false);
					}
				);

				// Start payment with sessionId
				payment.startPayment(sessionId);
			} catch (error) {
				console.error('Error initiating Geidea payment:', error);
				let errorMessage = 'Failed to start payment. Please try again.';
				if (error && error.message) {
					errorMessage = error.message;
				}
				Swal.fire({
					icon: 'error',
					title: 'Payment Error',
					html: `<div style="text-align: left;">
						<p style="margin-bottom: 0;">${errorMessage}</p>
						${error && error.stack ? `<p style="margin-top: 10px; font-size: 0.75rem; color: #6b7280;">Technical details logged to console.</p>` : ''}
					</div>`,
					confirmButtonText: 'OK',
					confirmButtonColor: '#dc2626',
					customClass: {
						popup: 'swal2-popup-enhanced',
						title: 'swal2-title-enhanced'
					}
				});
				if (callback) callback(false);
			}
		}
		
		// Initialize Tamara Widget V2 for Checkout Page
		@{
			bool tamaraAvailableCheckout = ViewData["TamaraAvailable"] != null && (bool)ViewData["TamaraAvailable"];
			string tamaraPublicKeyCheckout = ViewData["TamaraPublicKey"]?.ToString() ?? "";
			double tamaraOrderTotalCheckout = ViewData["TamaraOrderTotal"] != null ? (double)ViewData["TamaraOrderTotal"] : 0;
		}
		@if (tamaraAvailableCheckout && !string.IsNullOrEmpty(tamaraPublicKeyCheckout) && tamaraOrderTotalCheckout > 0)
		{
			<text>
			(function() {
				// Load Tamara Widget V2 script
				if (!window.TamaraWidget) {
					var script = document.createElement('script');
					script.src = 'https://cdn.tamara.co/widget-v2/tamara-widget.js';
					script.async = true;
					script.onload = function() {
						initializeTamaraCheckoutWidget();
					};
					document.head.appendChild(script);
				} else {
					initializeTamaraCheckoutWidget();
				}
				
				function initializeTamaraCheckoutWidget() {
					var widgetElement = document.getElementById('tamara-widget-checkout-page');
					if (widgetElement && window.TamaraWidget) {
						var publicKey = widgetElement.getAttribute('data-public-key');
						var amount = parseFloat(widgetElement.getAttribute('data-amount'));
						var currency = widgetElement.getAttribute('data-currency') || 'AED';
						var country = widgetElement.getAttribute('data-country') || 'AE';
						
						if (publicKey && amount > 0) {
							try {
								window.TamaraWidget.init({
									publicKey: publicKey,
									amount: amount,
									currency: currency,
									country: country,
									widgetType: 'checkout_page',
									containerId: 'tamara-widget-checkout-page'
								});
							} catch (e) {
								console.error('Tamara widget initialization error:', e);
							}
						}
					}
				}
			})();
			</text>
		}
		 
	</script>
}
