		$('.form-control').on('input change', function() {
			$(this).removeClass('is-invalid');
			$(this).next('.validation-error-message').remove();
		});
		
		// Remove validation errors on custom area input
		$('#customAreaInput').on('input', function() {
			$(this).removeClass('is-invalid');
			$('#customAreaError').hide();
		});

		// Remove payment method error on selection
