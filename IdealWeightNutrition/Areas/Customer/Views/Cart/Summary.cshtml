				// Enhanced email regex pattern
				var emailRegex = new RegExp('^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$');
				
				if (!email) {
					isValid = false;
					$emailField.addClass('is-invalid');
					var emailError = localizedMessages.emailAddress + ' ' + localizedMessages.isRequired;
					if ($emailField.next('.validation-error-message').length === 0) {
						$emailField.after('<div class="validation-error-message text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i>' + emailError + '</div>');
					}
					if (!firstInvalidField) {
						firstInvalidField = $emailField;
					}
				} else if (!emailRegex.test(email)) {
					isValid = false;
					$emailField.addClass('is-invalid');
					var emailError = localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address';
					if ($emailField.next('.validation-error-message').length === 0) {
						$emailField.after('<div class="validation-error-message text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i>' + emailError + '</div>');
					}
					if (!firstInvalidField) {
						firstInvalidField = $emailField;
					}
