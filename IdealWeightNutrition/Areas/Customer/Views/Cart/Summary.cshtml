						$resendOtpBtn.removeClass('disabled').prop('disabled', false).html('<i class="bi bi-arrow-clockwise me-1"></i>' + (localizedMessages.resendCode || 'Resend Code'));
					}
				}, 1000);
			}
			
			function clearResendTimer() {
				if (resendTimer) {
					clearInterval(resendTimer);
					resendTimer = null;
				}
				$resendOtpBtn.removeClass('disabled').prop('disabled', false).html('<i class="bi bi-arrow-clockwise me-1"></i>' + (localizedMessages.resendCode || 'Resend Code'));
			}
		}

		// Form validation before submission
		$('#orderForm').on('submit', function(e) {
			var isValid = true;
			var firstInvalidField = null;
			var errorMessages = [];

			// Clear previous validation errors
			$('.form-control').removeClass('is-invalid');
			$('.validation-error-message').remove();

			// Check required fields
			var requiredFields = [
				{ selector: 'input[name="OrderHeader.Name"]', label: localizedMessages.name },
				{ selector: 'input[name="OrderHeader.PhoneNumber"]', label: localizedMessages.phone },
				{ selector: 'input[name="OrderHeader.StreetAddress"]', label: localizedMessages.streetAddress },
				{ selector: '#citySelect', label: localizedMessages.city },
				{ selector: '#areaSelect', label: localizedMessages.area }
			];

			// Check guest email if guest checkout
			var isGuest = @((Model.OrderHeader.IsGuestOrder || !User.Identity.IsAuthenticated).ToString().ToLower());
			if (isGuest) {
				requiredFields.push({ selector: 'input[name="OrderHeader.Email"]', label: localizedMessages.emailAddress });
			}

			// Validate each required field
			requiredFields.forEach(function(field) {
				var $field = $(field.selector);
				
				// Skip area select validation if custom area input is visible (city has no remote areas)
				if (field.selector === '#areaSelect' && $('#customAreaRow').is(':visible')) {
					return; // Skip area select validation if manual input is shown directly
				}
				
				// Skip area select validation if "Other" is selected and custom input is filled
				if (field.selector === '#areaSelect' && $('#areaSelect').val() === 'OTHER' && $('#customAreaInput').val().trim()) {
					return;
				}
				
				var value = $field.val() ? $field.val().trim() : '';
				
				if (!value) {
					isValid = false;
					$field.addClass('is-invalid');
					
					if (!firstInvalidField) {
						firstInvalidField = $field;
					}
					
					// Add error message
					var errorMsg = localizedMessages.fieldIsRequired.replace('{0}', field.label);
					if (!errorMsg || errorMsg.includes('{0}')) {
						errorMsg = field.label + ' ' + localizedMessages.isRequired;
					}
					errorMessages.push(errorMsg);
					
					// Show error message below field
					if ($field.next('.validation-error-message').length === 0) {
						$field.after('<div class="validation-error-message text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i>' + errorMsg + '</div>');
					}
				}
			});

			// Validate custom area input if it's visible
			if ($('#customAreaRow').is(':visible')) {
				var customAreaValue = $('#customAreaInput').val() ? $('#customAreaInput').val().trim() : '';
				if (!customAreaValue) {
					isValid = false;
					$('#customAreaInput').addClass('is-invalid');
					$('#customAreaError').text(localizedMessages.area + ' ' + localizedMessages.isRequired).show();
					if (!firstInvalidField) {
						firstInvalidField = $('#customAreaInput');
					}
				} else {
					$('#customAreaError').hide();
					$('#customAreaInput').removeClass('is-invalid');
				}
			}
			
			// Validate area select if dropdown is visible (not custom input)
			if ($('#areaRow').is(':visible') && !$('#customAreaRow').is(':visible')) {
				var areaValue = $('#areaSelect').val();
				if (!areaValue || areaValue === '') {
					isValid = false;
					$('#areaSelect').addClass('is-invalid');
					if (!firstInvalidField) {
						firstInvalidField = $('#areaSelect');
					}
					var errorMsg = localizedMessages.area + ' ' + localizedMessages.isRequired;
					errorMessages.push(errorMsg);
					if ($('#areaSelect').next('.validation-error-message').length === 0) {
						$('#areaSelect').after('<div class="validation-error-message text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i>' + errorMsg + '</div>');
					}
				}
