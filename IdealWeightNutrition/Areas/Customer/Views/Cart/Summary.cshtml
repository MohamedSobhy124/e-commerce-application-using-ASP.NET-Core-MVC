@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@model ShoppingCartVM
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart-summary-enhanced.css" asp-append-version="true" />
}

<form method="post" id="orderForm" novalidate>
	<div class="order-summary-wrapper">
		<div class="container">
			<div class="order-summary-card">

				<div class="order-summary-header">
					<h5 class="order-summary-title">
						<i class="bi bi-file-earmark-text me-2"></i>
						@Localizer["OrderSummary"]
					</h5>
					<a asp-action="Index" class="back-to-cart-btn">
						<i class="bi bi-arrow-left me-2"></i>
						@Localizer["BackToCart"]
					</a>
				</div>

				<div class="order-summary-body">
					<div class="row">
						<div class="col-12 col-lg-6 pb-4">
							<div class="shipping-details-section">
								<h4>
									<i class="bi bi-truck me-2"></i>
									@Localizer["ShippingDetails"]
								</h4>
								
								@if (Model.OrderHeader.IsGuestOrder || !User.Identity.IsAuthenticated)
								{
									<div class="alert alert-info-enhanced">
										<div class="alert-icon">
											<i class="bi bi-info-circle-fill"></i>
										</div>
										<div class="alert-content">
											<strong>@Localizer["GuestCheckout"]</strong>
											<p class="mb-0">@Localizer["GuestCheckoutInfo"]</p>
										</div>
									</div>
									<div class="form-row-enhanced">
										<label class="form-label-enhanced">
											<i class="bi bi-envelope-fill me-2"></i>@Localizer["EmailAddress"] <span class="text-danger">*</span>
										</label>
										<input asp-for="OrderHeader.Email" type="email" id="orderEmailInput" class="form-control-enhanced" placeholder="@Localizer["EnterYourEmail"]" required />
										<span asp-validation-for="OrderHeader.Email" class="text-danger validation-message"></span>
										<div id="emailValidationMessage" class="validation-error-message text-danger small mt-1" style="display: none;"></div>
									</div>
									
									<!-- Email Verification OTP Section -->
									<div id="emailVerificationSection" class="form-row-enhanced" style="display: none; margin-top: 15px; padding: 20px; background: #f0f9ff; border-radius: 8px; border: 2px solid #0ea5e9;">
										<div class="d-flex align-items-center mb-3">
											<i class="bi bi-shield-check text-primary me-2" style="font-size: 1.5rem;"></i>
											<div>
												<strong style="color: #0369a1;">@Localizer["VerifyYourEmail"]</strong>
												<p class="mb-0 text-muted small">@Localizer["VerifyEmailDescription"]</p>
											</div>
										</div>
										
										<div id="otpSendSection">
											<button type="button" id="sendOtpBtn" class="btn btn-primary btn-sm" style="border-radius: 6px;">
												<i class="bi bi-send me-2"></i>@Localizer["SendVerificationCode"]
											</button>
											<div id="otpSendMessage" class="mt-2 small" style="display: none;"></div>
										</div>
										
										<div id="otpVerifySection" style="display: none; margin-top: 15px;">
											<label class="form-label-enhanced small">
												<i class="bi bi-key me-2"></i>@Localizer["EnterVerificationCode"] <span class="text-danger">*</span>
											</label>
											<div class="d-flex gap-2">
												<input type="text" id="otpInput" class="form-control-enhanced" placeholder="000000" maxlength="6" style="text-align: center; font-size: 1.2rem; letter-spacing: 4px; font-weight: bold; font-family: monospace;" />
												<button type="button" id="verifyOtpBtn" class="btn btn-success btn-sm" style="border-radius: 6px; min-width: 100px;">
													<i class="bi bi-check-circle me-1"></i>@Localizer["Verify"]
												</button>
											</div>
											<div id="otpVerifyMessage" class="mt-2 small" style="display: none;"></div>
											<div class="mt-2">
												<button type="button" id="resendOtpBtn" class="btn btn-link btn-sm p-0 text-primary" style="font-size: 0.85rem; text-decoration: none;">
													<i class="bi bi-arrow-clockwise me-1"></i>@Localizer["ResendCode"]
												</button>
											</div>
										</div>
										
										<div id="emailVerifiedSection" style="display: none; margin-top: 15px;">
											<div class="alert alert-success mb-0" style="border-radius: 6px;">
												<i class="bi bi-check-circle-fill me-2"></i>
												<strong>@Localizer["EmailVerified"]</strong>
											</div>
										</div>
									</div>
									
									<!-- Create Account Checkbox -->
									<div class="form-row-enhanced mt-3" id="createAccountSection" style="display: none;">
										<div class="form-check">
											<input class="form-check-input" type="checkbox" id="createAccountCheckbox" name="CreateAccount" value="true" />
											<label class="form-check-label" for="createAccountCheckbox">
												<i class="bi bi-person-plus me-2"></i>
												@(Localizer["CreateAccountForFutureOrders"]?.Value ?? "Create an account for faster checkout on future orders")
											</label>
										</div>
										<small class="text-muted d-block mt-2">
											@(Localizer["CreateAccountDescription"]?.Value ?? "You'll be able to track your orders and save your information for next time.")
										</small>
									</div>
								}
								
								<div class="form-row-enhanced">
									<label class="form-label-enhanced">
										<i class="bi bi-person-fill me-2"></i>@Localizer["Name"] <span class="text-danger">*</span>
									</label>
									<input asp-for="OrderHeader.Name" class="form-control-enhanced" placeholder="@Localizer["EnterYourName"]" required />
									<span asp-validation-for="OrderHeader.Name" class="text-danger validation-message"></span>
								</div>

								<div class="form-row-enhanced">
									<label class="form-label-enhanced">
										<i class="bi bi-telephone-fill me-2"></i>@Localizer["Phone"] <span class="text-danger">*</span>
									</label>
									<input asp-for="OrderHeader.PhoneNumber" class="form-control-enhanced" placeholder="@Localizer["EnterYourPhone"]" required />
									<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger validation-message"></span>
								</div>



							<div class="form-row-enhanced">
								<label class="form-label-enhanced">
									<i class="bi bi-building me-2"></i>@Localizer["City"] <span class="text-danger">*</span>
								</label>
								<select asp-for="OrderHeader.City" id="citySelect" class="form-control-enhanced" required>
									<option value="">@Localizer["SelectCity"]</option>
									@if (ViewData["Cities"] != null)
									{
										@foreach (var city in (IEnumerable<IdealWeightNutrition.Models.City>)ViewData["Cities"])
										{
											var cityName = System.Globalization.CultureInfo.CurrentCulture.Name == "ar" && !string.IsNullOrEmpty(city.NameAr) ? city.NameAr : city.Name;
											<option value="@cityName" data-city-id="@city.Id" data-city-delivery-charge="@city.DeliveryCharge">@cityName</option>
										}
									}
								</select>
								<span asp-validation-for="OrderHeader.City" class="text-danger validation-message"></span>
							</div>

							<div class="form-row-enhanced" id="areaRow" style="display: none;">
								<label class="form-label-enhanced">
									<i class="bi bi-geo-alt me-2"></i>@Localizer["Area"] <span class="text-danger">*</span>
								</label>
								<select asp-for="OrderHeader.Area" id="areaSelect" name="OrderHeader.Area" class="form-control-enhanced">
									<option value="">@Localizer["SelectArea"]</option>
								</select>
								<span asp-validation-for="OrderHeader.Area" class="text-danger validation-message"></span>
							</div>

							<div class="form-row-enhanced" id="customAreaRow" style="display: none;">
								<label class="form-label-enhanced">
									<i class="bi bi-pencil me-2"></i>@Localizer["EnterArea"] <span class="text-danger">*</span>
								</label>
								<input type="text" id="customAreaInput" class="form-control-enhanced" placeholder="@Localizer["EnterAreaName"]" />
								<span class="text-danger validation-message" id="customAreaError" style="display: none;"></span>
							</div>

						 
								<div class="form-row-enhanced">
									<label class="form-label-enhanced">
										<i class="bi bi-geo-alt-fill me-2"></i>@Localizer["StreetAddress"] <span class="text-danger">*</span>
									</label>
									<input asp-for="OrderHeader.StreetAddress" class="form-control-enhanced" placeholder="@Localizer["EnterStreetAddress"]" required />
									<span asp-validation-for="OrderHeader.StreetAddress" class="text-danger validation-message"></span>
								</div>
								<div class="form-row-enhanced" style="display: none;">
									<label class="form-label-enhanced">
										<i class="bi bi-geo me-2"></i>@Localizer["State"] <span class="text-danger">*</span>
									</label>
									<input asp-for="OrderHeader.State" id="stateInput" name="OrderHeader.State" class="form-control-enhanced" value="" />
									<span asp-validation-for="OrderHeader.State" class="text-danger validation-message"></span>
								</div>

							<div class="form-row-enhanced" style="display: none;">
								<label class="form-label-enhanced">
									<i class="bi bi-mailbox me-2"></i>@Localizer["PostalCode"] <span class="text-danger">*</span>
								</label>
								<input asp-for="OrderHeader.PostalCode" class="form-control-enhanced" value="00000" />
								<span asp-validation-for="OrderHeader.PostalCode" class="text-danger validation-message"></span>
							</div>
							</div>
						</div>

						<div class="col-12 col-lg-5 offset-lg-1">
							<div class="order-items-section">
								<h4>
									<i class="bi bi-basket3 me-2"></i>
									@Localizer["OrderItems"]
								</h4>
								<ul class="order-items-list" id="orderItemsList">
									@foreach(var details in Model.ShoppingCartList)
									{
										// Check if this is a combo offer
										bool isComboOffer = details.ComboOfferId.HasValue && details.ComboOffer != null;
										bool hasVariant = details.ProductVariantId.HasValue && details.ProductVariant != null;
										
										// Get display name - use localized version based on current culture
										string displayName = isComboOffer 
											? (currentCulture == "ar" && !string.IsNullOrEmpty(details.ComboOffer.NameAr) 
												? details.ComboOffer.NameAr 
												: details.ComboOffer.Name)
											: (currentCulture == "ar" && !string.IsNullOrEmpty(details.product.TitleAr) 
												? details.product.TitleAr 
												: details.product.Title);
										
										// Get variant display string
										string variantDisplayText = null;
										if (hasVariant && details.ProductVariant != null)
										{
											// Try to get variant option values directly
											if (details.ProductVariant.VariantOptionValues != null && details.ProductVariant.VariantOptionValues.Any())
											{
												var variantParts = details.ProductVariant.VariantOptionValues
													.OrderBy(vov => vov.OptionValue?.ProductOption?.DisplayOrder ?? 0)
													.ThenBy(vov => vov.OptionValue?.DisplayOrder ?? 0)
													.Select(vov => 
													{
														if (vov.OptionValue == null) return "";
														
														var optionName = currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue.ProductOption?.NameAr) 
															? vov.OptionValue.ProductOption.NameAr 
															: vov.OptionValue.ProductOption?.Name ?? "";
														var optionValue = currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue.ValueAr) 
															? vov.OptionValue.ValueAr 
															: vov.OptionValue.Value ?? "";
														
														if (string.IsNullOrEmpty(optionName) || string.IsNullOrEmpty(optionValue))
															return optionValue ?? optionName ?? "";
														
														return $"{optionName}: {optionValue}";
													})
													.Where(v => !string.IsNullOrEmpty(v));
												
												variantDisplayText = variantParts.Any() ? string.Join(" / ", variantParts) : Localizer["Default"].Value;
											}
											else
											{
												// If no option values, check if VariantName property is available
												variantDisplayText = !string.IsNullOrEmpty(details.ProductVariant.VariantName) 
													? details.ProductVariant.VariantName 
													: Localizer["Default"].Value;
											}
										}
										else if (details.ProductVariantId.HasValue && details.ProductVariant == null)
										{
											// Variant ID exists but variant not loaded - show default
											variantDisplayText = Localizer["Default"].Value;
										}
										
										// Create item key for promo code matching
										string itemKey = $"{details.ProductId}_{details.ProductVariantId?.ToString() ?? "0"}_{details.FlashSaleItemId?.ToString() ?? "0"}_{details.ComboOfferId?.ToString() ?? "0"}";
										
										// Get product image - prioritize variant image if available
										string productImageUrl = null;
										if (isComboOffer && !string.IsNullOrEmpty(details.ComboOffer.ImageUrl))
										{
											productImageUrl = details.ComboOffer.ImageUrl;
										}
										else if (details.ProductVariantId.HasValue)
										{
											// Check ProductVariant first
											if (details.ProductVariant != null && !string.IsNullOrEmpty(details.ProductVariant.ImageUrl))
											{
												// Use variant image if available - normalize path (convert backslashes to forward slashes)
												productImageUrl = details.ProductVariant.ImageUrl.Replace('\\', '/');
												// Ensure it starts with / if it's a relative path
												if (!productImageUrl.StartsWith("/") && !productImageUrl.StartsWith("http"))
												{
													productImageUrl = "/" + productImageUrl;
												}
											}
											// If ProductVariant is null or has no image, check FlashSaleItem.ProductVariant for flash sale items
											else if (details.FlashSaleItemId.HasValue && details.FlashSaleItem != null && details.FlashSaleItem.ProductVariant != null && !string.IsNullOrEmpty(details.FlashSaleItem.ProductVariant.ImageUrl))
											{
												// Use FlashSaleItem variant image
												productImageUrl = details.FlashSaleItem.ProductVariant.ImageUrl.Replace('\\', '/');
												// Ensure it starts with / if it's a relative path
												if (!productImageUrl.StartsWith("/") && !productImageUrl.StartsWith("http"))
												{
													productImageUrl = "/" + productImageUrl;
												}
											}
										}else{
											if (details.product.ProductImages != null && details.product.ProductImages.Any())
											{
												var firstImage = details.product.ProductImages.OrderBy(pi => pi.DisplayOrder).FirstOrDefault(_ => _.ImageInfo == null);
												productImageUrl = firstImage?.ImageUrl;
											}
											else if (!string.IsNullOrEmpty(details.product.ImageUrl))
											{
												productImageUrl = details.product.ImageUrl;
											}

										}
										
										 
											
									 
										
										<li class="order-item-enhanced" data-item-key="@itemKey" data-product-id="@details.ProductId" data-variant-id="@(details.ProductVariantId?.ToString() ?? "0")">
											<div class="order-item-image-wrapper">
												<img src="@productImageUrl" alt="@displayName" class="order-item-image" />
											</div>
											<div class="order-item-content">
												<h6 class="order-item-title-enhanced">
													@displayName
													@if (isComboOffer)
													{
														<span class="badge badge-combo">@Localizer["ComboOffer"]</span>
													}
													<span class="promo-applied-badge badge badge-promo" style="display: none;">
														<i class="bi bi-tag-fill"></i> @Localizer["DiscountApplied"]
													</span>
												</h6>
												@if (hasVariant && !string.IsNullOrEmpty(variantDisplayText))
												{
													<small class="order-item-variant-enhanced">
														<i class="bi bi-tag-fill me-1"></i>@variantDisplayText
													</small>
												}
												<div class="order-item-meta">
													<small class="order-item-quantity-enhanced">
														<i class="bi bi-box-seam me-1"></i>@Localizer["Quantity"]: <strong>@details.Count</strong>
													</small>
													@if (isComboOffer)
													{
														<small class="order-item-products-count">
															<i class="bi bi-grid me-1"></i>@details.ComboOffer.TotalProducts @Localizer["Products"]
														</small>
													}
												</div>
												<small class="item-discount-amount text-success" style="display: none;"></small>
											</div>
											<div class="order-item-price-wrapper">
												<div class="order-item-price-enhanced">
													<span class="original-price">@Html.Raw(currencySymbol) @((details.Price*details.Count).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</span>
													<span class="discounted-price text-success" style="display: none;"></span>
												</div>
											</div>
										</li>
									}

									<li class="order-item order-total-item">
										<small class="order-total-label">@Localizer["Subtotal"]</small>
										<strong class="order-subtotal-value">@Html.Raw(currencySymbol) @Model.OrderHeader.OrderTotal.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong>
									</li>
								</ul>
							</div>

							<!-- Promo Code Section -->
							<div class="promo-code-section mt-4">
								<h4>
									<i class="bi bi-tag me-2"></i>
									@Localizer["PromoCode"]
								</h4>
								<div class="promo-code-input-group">
									<input type="text" id="promoCodeInput" class="form-control" placeholder="@Localizer["EnterPromoCode"]" />
									<button type="button" id="applyPromoBtn" class="btn btn-primary">
										<i class="bi bi-check-circle"></i> @Localizer["Apply"]
									</button>
								</div>
								<div id="promoCodeMessage" class="mt-2"></div>
								<div id="promoCodeDetails" class="promo-applied-box mt-3" style="display: none;">
									<div class="d-flex justify-content-between align-items-center">
										<div>
											<i class="bi bi-check-circle-fill text-success me-2"></i>
											<strong id="appliedPromoCode"></strong>
											<span id="promoDiscountText" class="text-muted ms-2"></span>
										</div>
										<button type="button" id="removePromoBtn" class="btn btn-sm btn-danger">
											<i class="bi bi-x"></i> @Localizer["Remove"]
										</button>
									</div>
									<div class="discount-details mt-2">
										<div class="d-flex justify-content-between">
											<span>@Localizer["Discount"]:</span>
											<span class="text-success" id="discountAmount">-$0.00</span>
										</div>
									</div>
								</div>
								<input type="hidden" asp-for="OrderHeader.PromoCodeId" id="promoCodeIdInput" />
								<input type="hidden" asp-for="OrderHeader.PromoCodeText" id="promoCodeTextInput" />
							</div>

							<!-- Delivery Charge -->
							<div class="delivery-charge-section mt-3" id="deliveryChargeSection" style="display: none;">
								<div class="d-flex justify-content-between align-items-center">
									<span>
										<i class="bi bi-truck me-2"></i>
										@Localizer["DeliveryCharge"]
									</span>
									<strong id="deliveryChargeTotal">@Html.Raw(currencySymbol) 0.00</strong>
								</div>
							</div>
							
							<!-- Free Delivery Message -->
							<div class="free-delivery-message mt-2" id="freeDeliveryMessage" style="display: none;">
								<div class="alert alert-success mb-0">
									<i class="bi bi-check-circle-fill me-2"></i>
									<strong>@Localizer["FreeDelivery"]</strong>
								</div>
							</div>

							<!-- Order Total -->
							<div class="order-total-section mt-4">
								<div class="d-flex justify-content-between align-items-center">
									<h4 class="mb-0">
										<i class="bi bi-wallet2 me-2"></i>
										@Localizer["Total"]
									</h4>
									<strong class="order-final-total" id="finalTotal">@Html.Raw(currencySymbol) @Model.OrderHeader.OrderTotal.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</strong>
								</div>
							</div>

							<!-- Payment Method Selection -->
							@{
								bool tappyEnabled = ViewData["TappyEnabled"] != null && (bool)ViewData["TappyEnabled"];
								bool tamaraEnabled = ViewData["TamaraEnabled"] != null && (bool)ViewData["TamaraEnabled"];
								bool tappyAvailable = ViewData["TappyAvailable"] != null && (bool)ViewData["TappyAvailable"];
								bool tamaraAvailable = ViewData["TamaraAvailable"] != null && (bool)ViewData["TamaraAvailable"];
								string tamaraPublicKey = ViewData["TamaraPublicKey"]?.ToString() ?? "";
								double tamaraOrderTotal = ViewData["TamaraOrderTotal"] != null ? (double)ViewData["TamaraOrderTotal"] : 0;
								// Show alternative section if any payment method is enabled (might become available with delivery charges)
								bool hasAlternativePayments = tappyEnabled || tamaraEnabled;
							}
							<div class="payment-method-section mt-4">
								<h4>
									<i class="bi bi-credit-card me-2"></i>
									@Localizer["PaymentMethod"]
								</h4>
								
								<!-- Primary Payment Method - Geidea -->
								<div class="payment-methods-primary">
									<div class="payment-method-option payment-method-primary">
										<input type="radio" id="paymentGeidea" name="OrderHeader.PaymentMethod" value="@IdealWeightNutrition.Utility.SD.PaymentMethodGeidea" checked />
										<label for="paymentGeidea" class="payment-method-label-primary">

											<div class="payment-primary-icon">
												<i class="bi bi-credit-card-fill"></i>
											</div>
											<div class="payment-primary-content">
												<span class="payment-primary-title">@Localizer["CreditDebitCard"]</span>
												<small class="payment-primary-desc">Visa, Mastercard, Apple Pay, Google Pay</small>
											</div>
											<div class="payment-primary-logos">
												<img src="~/Images/payment-methods.png" alt="Payment Methods" class="payment-logos-img" />
											</div>
											<div class="payment-check-indicator">
												<i class="bi bi-check-lg"></i>
											</div>
										</label>
									</div>
								</div>
								
								<!-- Alternative Payment Methods - Tabby & Tamara -->
								<div class="payment-methods-alternative" id="alternativePayments" style="@(hasAlternativePayments ? "" : "display: none;")">
									<div class="alternative-payments-divider">
										<span>@Localizer["OrPayWith"]</span>
									</div>
									<div class="payment-alternatives-grid">
										<!-- Tabby Payment -->
										<div class="payment-method-option payment-method-alt" id="tabbyPaymentOption" data-initial-available="@tappyAvailable.ToString().ToLower()" style="@(tappyAvailable ? "" : "display: none;")">
											<input type="radio" id="paymentTappy" name="OrderHeader.PaymentMethod" value="@IdealWeightNutrition.Utility.SD.PaymentMethodTappy" />
											<label for="paymentTappy" class="payment-method-label-alt">
												<div class="payment-alt-logo">
													<img src="~/Images/tappy.png" alt="Tabby" class="payment-logo-img" />
												</div>
												<div class="payment-alt-content">
													<span class="payment-alt-title">Tabby</span>
													<small class="payment-alt-desc">@Localizer["PayIn4Installments"]</small>
												</div>
												<div class="payment-alt-check">
													<i class="bi bi-check-lg"></i>
												</div>
											</label>
										</div>
										
										<!-- Tamara Payment -->
										<div class="payment-method-option payment-method-alt" id="tamaraPaymentOption" data-initial-available="@tamaraAvailable.ToString().ToLower()" style="@(tamaraAvailable ? "" : "display: none;")">
											<input type="radio" id="paymentTamara" name="OrderHeader.PaymentMethod" value="@IdealWeightNutrition.Utility.SD.PaymentMethodTamara" />
											<label for="paymentTamara" class="payment-method-label-alt">
												<div class="payment-alt-logo">
													<img src="~/Images/tamara.png" alt="Tamara" class="payment-logo-img" />
												</div>
												<div class="payment-alt-content">
													<span class="payment-alt-title">Tamara</span>
													<small class="payment-alt-desc">@Localizer["BuyNowPayLater"]</small>
												</div>
												<div class="payment-alt-check">
													<i class="bi bi-check-lg"></i>
												</div>
											</label>
										</div>
									</div>
									@if (!string.IsNullOrEmpty(tamaraPublicKey) && tamaraOrderTotal > 0)
									{
										<!-- Tamara Widget V2 - Checkout Page -->
										<div id="tamara-widget-checkout-page" data-public-key="@tamaraPublicKey" data-amount="@tamaraOrderTotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" data-currency="AED" data-country="AE" data-widget-type="checkout_page" style="margin-top: 15px;"></div>
									}
								</div>

								<div class="payment-minimum-notice" id="paymentMinimumNotice" style="display: none;">
				<i class="bi bi-info-circle me-2"></i>
				<span id="paymentMinimumNoticeText"></span>
</div>
							 
							</div>
						</div>
					</div>
				</div>

				<div class="order-summary-footer-enhanced">
					<div class="footer-content-wrapper">
						<div class="estimate-delivery-enhanced">
							<div class="delivery-icon">
								<i class="bi bi-truck"></i>
							</div>
							<div class="delivery-text">
								<strong>@Localizer["EstimatedDelivery"]</strong>
								<p class="mb-0">@(Localizer["Within48HoursWorkingDays"]?.Value ?? "Within 48 hours (working days)")</p>
							</div>
						</div>
						<button type="submit" class="place-order-btn-enhanced" id="placeOrderBtn">
							<span class="btn-content">
								<i class="bi bi-check-circle-fill me-2"></i>
								<span class="btn-text">@Localizer["PlaceOrder"]</span>
								<span class="btn-loader" style="display: none;">
									<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
									<span>@Localizer["Processing"]...</span>
								</span>
							</span>
							<span class="btn-shine"></span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

<style>
	/* ===== Payment Method Section - Modern Design ===== */
	.payment-method-section {
		margin-top: 2rem;
		padding: 1.5rem;
		background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
