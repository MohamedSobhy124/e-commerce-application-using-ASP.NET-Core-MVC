						// Create a hidden option with the custom value
						$('#areaSelect').html('<option value="' + customAreaValue + '" selected>' + customAreaValue + '</option>');
					} else {
						$('#areaSelect').val(customAreaValue);
					}
					// Ensure State is set to the custom area value
					$('#stateInput').val(customAreaValue);
				}
			} else if ($('#areaSelect').val() && $('#areaSelect').val() !== 'OTHER') {
				// If dropdown is visible and a remote area is selected, ensure State is set
				$('#stateInput').val($('#areaSelect').val());
			}

			// Final email validation check (async) if guest and all other validations passed
			if (isGuest && isValid) {
				var $emailField = $('#orderEmailInput');
				var email = $emailField.val() ? $emailField.val().trim() : '';
				
				// If email field has validation errors, prevent submission
				if ($emailField.hasClass('is-invalid')) {
					e.preventDefault();
					e.stopPropagation();
					
					var $submitBtn = $('#placeOrderBtn');
					var $btnText = $submitBtn.find('.btn-text');
					var $btnLoader = $submitBtn.find('.btn-loader');
					$submitBtn.prop('disabled', false);
					$btnLoader.hide();
					$btnText.show();
					
					$('html, body').animate({
						scrollTop: $emailField.offset().top - 100
					}, 500);
					$emailField.focus();
					
					return false;
				}
				
				// Check if email is verified via OTP
				// Prevent submission and check verification status
				if (typeof isEmailVerified === 'undefined' || !isEmailVerified) {
					e.preventDefault();
					e.stopPropagation();
					
					// Check verification status on server
					$.ajax({
						url: '/Customer/Cart/CheckEmailVerified',
						method: 'POST',
						data: { email: email },
						success: function(response) {
							if (response.verified) {
								isEmailVerified = true;
								// Re-submit form
								$('#orderForm').off('submit').submit();
							} else {
								var $submitBtn = $('#placeOrderBtn');
								var $btnText = $submitBtn.find('.btn-text');
								var $btnLoader = $submitBtn.find('.btn-loader');
								$submitBtn.prop('disabled', false);
								$btnLoader.hide();
								$btnText.show();
								
								// Show verification section if hidden
								$('#emailVerificationSection').slideDown(300);
								
								// Show error message
								var verifyError = localizedMessages.emailNotVerified || 'Please verify your email address before placing the order.';
								if ($('#emailVerificationSection .alert-danger').length === 0) {
									$('#emailVerificationSection').prepend('<div class="alert alert-danger mb-3"><i class="bi bi-exclamation-circle me-2"></i>' + verifyError + '</div>');
								}
								
								$('html, body').animate({
									scrollTop: $('#emailVerificationSection').offset().top - 100
								}, 500);
								
								showValidationError(verifyError);
							}
						},
						error: function() {
							var $submitBtn = $('#placeOrderBtn');
							var $btnText = $submitBtn.find('.btn-text');
							var $btnLoader = $submitBtn.find('.btn-loader');
							$submitBtn.prop('disabled', false);
							$btnLoader.hide();
							$btnText.show();
							
							var verifyError = localizedMessages.emailNotVerified || 'Please verify your email address before placing the order.';
							$('#emailVerificationSection').slideDown(300);
							if ($('#emailVerificationSection .alert-danger').length === 0) {
								$('#emailVerificationSection').prepend('<div class="alert alert-danger mb-3"><i class="bi bi-exclamation-circle me-2"></i>' + verifyError + '</div>');
							}
							showValidationError(verifyError);
						}
					});
					
					return false;
				}
				
				// If email is valid format but hasn't been server-validated yet, do it now
				var emailRegex = new RegExp('^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$');
				if (email && emailRegex.test(email) && !$emailField.hasClass('is-valid')) {
					// Block submission and validate
					e.preventDefault();
					e.stopPropagation();
					
					var $submitBtn = $('#placeOrderBtn');
					$submitBtn.prop('disabled', true);
					
					// Validate email on server
					$.ajax({
						url: '/Customer/Cart/ValidateEmail',
						method: 'POST',
						data: { email: email },
						success: function(response) {
							$submitBtn.prop('disabled', false);
							
							if (response.valid) {
								$emailField.addClass('is-valid');
								$emailField.removeClass('is-invalid');
								$('#emailValidationMessage').hide();
								// Re-submit form
								$('#orderForm').off('submit').submit();
							} else {
								$emailField.addClass('is-invalid');
								$emailField.removeClass('is-valid');
								$('#emailValidationMessage').html('<i class="bi bi-exclamation-circle me-1"></i>' + (response.message || localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address')).show();
								
								$('html, body').animate({
									scrollTop: $emailField.offset().top - 100
								}, 500);
								$emailField.focus();
							}
						},
						error: function() {
							$submitBtn.prop('disabled', false);
							// On error, allow submission if format is valid (server might be down)
							var emailRegex = new RegExp('^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$');
							var isValidFormat = emailRegex.test(email);
							
							if (isValidFormat) {
								var parts = email.split('@@');
								if (parts.length === 2) {
									var domain = parts[1].toLowerCase();
									if (!domain.includes('..') && !domain.startsWith('.') && !domain.endsWith('.') && domain.length >= 4) {
										// Format is valid, allow submission
										$('#orderForm').off('submit').submit();
										return;
									}
								}
							}
							
							// Format is invalid
							$emailField.addClass('is-invalid');
							$('#emailValidationMessage').html('<i class="bi bi-exclamation-circle me-1"></i>' + (localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address')).show();
							$('html, body').animate({
								scrollTop: $emailField.offset().top - 100
							}, 500);
							$emailField.focus();
						}
					});
					
					return false;
				}
			}

			// Check if Geidea payment method is selected BEFORE preventing default
			var paymentMethod = $('input[name="OrderHeader.PaymentMethod"]:checked').val();
			var geideaPaymentMethod = '@IdealWeightNutrition.Utility.SD.PaymentMethodGeidea';
			
			// Disable button and show loader immediately for all payment methods
			var $submitBtn = $('#placeOrderBtn');
			var $btnContent = $submitBtn.find('.btn-content');
			var $btnText = $submitBtn.find('.btn-text');
			var $btnLoader = $submitBtn.find('.btn-loader');
			var originalText = $btnText.text();
			
			// Disable button and show loader
			$submitBtn.prop('disabled', true);
			$btnText.hide();
			$btnLoader.show();
			
			// Only handle AJAX for Geidea if validation passed
			if (paymentMethod === geideaPaymentMethod) {
				// Prevent default form submission for Geidea
				e.preventDefault();
				e.stopPropagation();
				
				// Submit via AJAX for Geidea to handle errors with SweetAlert
				
				var formData = $('#orderForm').serialize();
				
				$.ajax({
					url: '@Url.Action("Summary", "Cart")',
					type: 'POST',
					data: formData,
					headers: {
						'X-Requested-With': 'XMLHttpRequest'
					},
					success: function(response) {
						// Check if response is valid JSON object
						if (response && typeof response === 'object') {
							if (response.success === false && response.error) {
								// Show error with SweetAlert
								Swal.fire({
									icon: 'error',
									title: 'Payment Error',
									html: response.error,
									confirmButtonText: 'OK',
									confirmButtonColor: '#dc2626'
								});
								// Re-enable button and restore text
								$submitBtn.prop('disabled', false);
								$btnLoader.hide();
								$btnText.text(originalText).show();
							} else if (response.success === true) {
								// Handle Geidea v2 HPP payment
								if (response.paymentMethod === '@IdealWeightNutrition.Utility.SD.PaymentMethodGeidea' && response.sessionId) {
									// Store orderId for redirect after payment
									var orderId = response.orderId;
									// Use Geidea v2 HPP JavaScript library
									initiateGeideaPayment(response.sessionId, orderId, function(success) {
										if (success && orderId) {
											// Payment completed successfully, redirect to order confirmation
											window.location.href = '@Url.Action("OrderConfirmation", "Cart")?id=' + orderId;
										} else {
											// Re-enable button and restore text
											$submitBtn.prop('disabled', false);
											$btnLoader.hide();
											$btnText.text(originalText).show();
										}
									});
								} else if (response.redirectUrl) {
									// Fallback: redirect to payment URL for other payment methods
									window.location.href = response.redirectUrl;
								} else {
									// Unexpected response format
									window.location.reload();
								}
							} else {
								// Unexpected response format
								window.location.reload();
							}
						} else {
							// Response is not JSON (might be HTML), reload page
							window.location.reload();
						}
					},
					error: function(xhr, status, error) {
						// Handle AJAX error
						var errorMessage = 'An error occurred while processing your request.';
						var errorDetails = '';
						
						// Try to parse error response if available
						try {
							if (xhr.responseJSON) {
								if (xhr.responseJSON.error) {
									errorMessage = xhr.responseJSON.error;
								} else if (xhr.responseJSON.message) {
									errorMessage = xhr.responseJSON.message;
								} else if (xhr.responseJSON.title) {
									errorMessage = xhr.responseJSON.title;
									if (xhr.responseJSON.errors) {
										var errorList = [];
										for (var key in xhr.responseJSON.errors) {
											if (xhr.responseJSON.errors.hasOwnProperty(key)) {
												errorList.push(xhr.responseJSON.errors[key].join(', '));
											}
										}
										if (errorList.length > 0) {
											errorDetails = '<br><br>' + errorList.join('<br>');
										}
									}
								}
							} else if (xhr.responseText) {
								// Check if it's HTML (validation error page)
								if (xhr.responseText.indexOf('<html') > -1 || xhr.responseText.indexOf('<!DOCTYPE') > -1) {
									errorMessage = 'Validation error. Please check all required fields and try again.';
								} else if (xhr.responseText.length < 500) {
									// If response is short, try to show it
									errorMessage = 'Error: ' + xhr.responseText.substring(0, 200);
								}
							}
						} catch (e) {
							console.error('Error parsing response:', e);
						}
						
						// Add status code info
						if (xhr.status === 400) {
							if (!errorMessage.includes('Validation')) {
								errorMessage = 'Bad Request. ' + errorMessage;
							}
						} else if (xhr.status === 401) {
							errorMessage = 'Authentication error. Please refresh the page and try again.';
						} else if (xhr.status === 403) {
							errorMessage = 'Access denied. You may not have permission to perform this action.';
						} else if (xhr.status === 404) {
							errorMessage = 'Page not found. Please refresh the page and try again.';
						} else if (xhr.status === 500) {
							errorMessage = 'Server error. Please try again later.';
							errorDetails = errorDetails || '<br><br>If the problem persists, please contact support.';
						}
						
						// Log error to console for debugging
						console.error('AJAX Error:', {
							status: xhr.status,
							statusText: xhr.statusText,
							response: xhr.responseText,
							error: error
						});
						
						Swal.fire({
							icon: 'error',
							title: 'Error',
							html: errorMessage + errorDetails,
							confirmButtonText: 'OK',
							confirmButtonColor: '#dc2626'
						});
						// Re-enable button and restore text
						$submitBtn.prop('disabled', false);
						$btnLoader.hide();
						$btnText.text(originalText).show();
					}
				});
			} else {
				// For other payment methods, submit normally
				// Button is already disabled and loader is shown above
				// Re-enable after 10 seconds as safety (in case of error)
				setTimeout(function() {
					$submitBtn.prop('disabled', false);
					$btnLoader.hide();
					$btnText.text(originalText).show();
				}, 10000);
			}
		});

		// Function to show validation error
		function showValidationError(message) {
			// Remove existing error alert
			$('.validation-summary-error').remove();
			
			// Add error alert at top of form
			var errorHtml = '<div class="validation-summary-error alert alert-danger alert-dismissible fade show" role="alert" style="margin-bottom: 1.5rem;">' +
				'<i class="bi bi-exclamation-triangle-fill me-2"></i>' +
				'<strong>' + localizedMessages.validationError + ':</strong> ' + message +
				'<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
				'</div>';
			
			$('.order-summary-body').prepend(errorHtml);
			
			// Auto-dismiss after 10 seconds
			setTimeout(function() {
				$('.validation-summary-error').fadeOut(function() {
					$(this).remove();
				});
			}, 10000);
		}

