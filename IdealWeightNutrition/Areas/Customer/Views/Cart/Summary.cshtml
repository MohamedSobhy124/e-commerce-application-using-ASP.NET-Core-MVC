		// Real-time email validation for guest checkout
		var isGuest = @((Model.OrderHeader.IsGuestOrder || !User.Identity.IsAuthenticated).ToString().ToLower());
		var emailValidationTimeout;
		var isEmailValidating = false;
		
		if (isGuest) {
			var $emailField = $('#orderEmailInput');
			var $emailValidationMsg = $('#emailValidationMessage');
			
			// Enhanced email regex pattern
			var emailRegex = new RegExp('^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$');
			
			function validateEmailFormat(email) {
				if (!email || email.trim() === '') {
					return { valid: false, message: localizedMessages.emailAddress + ' ' + localizedMessages.isRequired };
				}
				
				if (!emailRegex.test(email)) {
					return { valid: false, message: localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address' };
				}
				
				var parts = email.split('@@');
				if (parts.length !== 2) {
					return { valid: false, message: localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address' };
				}
				
				var domain = parts[1].toLowerCase();
				
				// Check for invalid patterns
				if (domain.includes('..') || domain.startsWith('.') || domain.endsWith('.') || domain.length < 4) {
					return { valid: false, message: localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address' };
				}
				
				return { valid: true, message: '' };
			}
			
			function showEmailError(message) {
				$emailField.addClass('is-invalid');
				$emailValidationMsg.html('<i class="bi bi-exclamation-circle me-1"></i>' + message).show();
			}
			
			function showEmailValid() {
				$emailField.removeClass('is-invalid');
				$emailField.addClass('is-valid');
				$emailValidationMsg.hide();
			}
			
			function clearEmailValidation() {
				$emailField.removeClass('is-invalid is-valid');
				$emailValidationMsg.hide();
			}
			
			// Real-time validation on input (with debounce)
			$emailField.on('input blur', function() {
				var email = $(this).val() ? $(this).val().trim() : '';
				
				// Clear previous timeout
				clearTimeout(emailValidationTimeout);
				
				// Clear validation state
				$emailField.removeClass('is-invalid is-valid');
				$emailValidationMsg.hide();
				
				if (!email) {
					return; // Don't validate empty field in real-time
				}
				
				// First, do client-side format validation
				var formatCheck = validateEmailFormat(email);
				if (!formatCheck.valid) {
					showEmailError(formatCheck.message);
					return;
				}
				
				// If format is valid, do async server-side validation
				emailValidationTimeout = setTimeout(function() {
					if (isEmailValidating) return; // Prevent multiple simultaneous requests
					
					isEmailValidating = true;
					$emailField.addClass('validating');
					
					$.ajax({
						url: '/Customer/Cart/ValidateEmail',
						method: 'POST',
						data: { email: email },
						success: function(response) {
							isEmailValidating = false;
							$emailField.removeClass('validating');
							
							if (response.valid) {
								showEmailValid();
							} else {
								showEmailError(response.message || localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address');
							}
						},
						error: function() {
							isEmailValidating = false;
							$emailField.removeClass('validating');
							// On error, still show format validation result
							var formatCheck = validateEmailFormat(email);
							if (!formatCheck.valid) {
								showEmailError(formatCheck.message);
							} else {
								// If format is valid but server check failed, still allow it
								// (server might be down, but format is correct)
								showEmailValid();
							}
						}
					});
				}, 800); // Wait 800ms after user stops typing
			});
			
			// Clear validation on focus if field is empty
			$emailField.on('focus', function() {
				if (!$(this).val() || $(this).val().trim() === '') {
					clearEmailValidation();
				}
			});
			
			// OTP Verification functionality
			var $verificationSection = $('#emailVerificationSection');
			var $otpSendSection = $('#otpSendSection');
			var $otpVerifySection = $('#otpVerifySection');
			var $emailVerifiedSection = $('#emailVerifiedSection');
			var $sendOtpBtn = $('#sendOtpBtn');
			var $verifyOtpBtn = $('#verifyOtpBtn');
			var $resendOtpBtn = $('#resendOtpBtn');
			var $otpInput = $('#otpInput');
			var $otpSendMessage = $('#otpSendMessage');
			var $otpVerifyMessage = $('#otpVerifyMessage');
			var isEmailVerified = false;
			var resendCooldown = 60; // 60 seconds cooldown for resend
			var resendTimer = null;
			
			// Show verification section when email is valid
			$emailField.on('blur', function() {
				var email = $(this).val() ? $(this).val().trim() : '';
				if (email && emailRegex.test(email) && !$emailField.hasClass('is-invalid')) {
					// Check if email is already verified
					checkEmailVerified(email);
					$verificationSection.slideDown(300);
				} else {
					$verificationSection.slideUp(300);
					resetOtpSection();
				}
			});
			
			// Check if email is already verified
			function checkEmailVerified(email) {
				$.ajax({
					url: '/Customer/Cart/CheckEmailVerified',
					method: 'POST',
					data: { email: email },
					success: function(response) {
						if (response.verified) {
							showEmailVerified();
							isEmailVerified = true;
							// Check if email has account - if yes, show message that order will be linked
							checkEmailHasAccount(email);
						} else {
							showOtpSendSection();
							isEmailVerified = false;
						}
					},
					error: function() {
						showOtpSendSection();
						isEmailVerified = false;
					}
				});
			}
			
			// Check if email has an account
			function checkEmailHasAccount(email) {
				$.ajax({
					url: '/Customer/Cart/CheckEmailHasAccount',
					method: 'POST',
					data: { email: email },
					success: function(response) {
						if (response.hasAccount) {
							// Email has account - show message and hide create account checkbox
							$('#createAccountSection').hide();
							// Remove any existing info message to prevent duplicates
							$('#emailVerifiedSection .alert-info').remove();
							$('#emailVerifiedSection').append(
								'<div class="alert alert-info mt-2 mb-0" style="border-radius: 6px; font-size: 0.9rem;">' +
								'<i class="bi bi-info-circle me-2"></i>' +
								'<strong>' + localizedMessages.accountFound + ':</strong> ' +
								localizedMessages.orderWillBeLinked +
								'</div>'
							);
						} else {
							// Email doesn't have account - show create account checkbox
							$('#createAccountSection').show();
							// Remove any existing info message
							$('#emailVerifiedSection .alert-info').remove();
						}
					},
					error: function() {
						// On error, show create account checkbox as fallback
						$('#createAccountSection').show();
					}
				});
			}
			
			// Send OTP
			$sendOtpBtn.on('click', function() {
				var email = $emailField.val() ? $emailField.val().trim() : '';
				if (!email || !emailRegex.test(email)) {
					showEmailError(localizedMessages.invalidEmailFormat || localizedMessages.pleaseEnterValidEmail || 'Please enter a valid email address');
					return;
				}
				
				$sendOtpBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>' + localizedMessages.sending);
				$otpSendMessage.hide();
				
				$.ajax({
					url: '/Customer/Cart/SendOtp',
					method: 'POST',
					data: { email: email },
					success: function(response) {
						if (response.success) {
							$otpSendMessage.removeClass('text-danger').addClass('text-success').html('<i class="bi bi-check-circle me-1"></i>' + response.message).show();
							showOtpVerifySection();
							startResendCooldown();
						} else {
							$otpSendMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle me-1"></i>' + response.message).show();
							$sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send me-2"></i>' + (localizedMessages.sendVerificationCode || 'Send Verification Code'));
						}
					},
					error: function() {
						$otpSendMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle me-1"></i>' + (localizedMessages.errorSendingOTP || 'Error sending verification code. Please try again.')).show();
						$sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send me-2"></i>' + (localizedMessages.sendVerificationCode || 'Send Verification Code'));
					}
				});
			});
			
			// Verify OTP
			$verifyOtpBtn.on('click', function() {
				var email = $emailField.val() ? $emailField.val().trim() : '';
				var otp = $otpInput.val() ? $otpInput.val().trim() : '';
				
				if (!otp || otp.length !== 6) {
					$otpVerifyMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle me-1"></i>' + (localizedMessages.pleaseEnterValidOTP || 'Please enter a valid 6-digit code')).show();
					return;
				}
				
				$verifyOtpBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>' + localizedMessages.verifying);
				$otpVerifyMessage.hide();
				
				$.ajax({
					url: '/Customer/Cart/VerifyOtp',
					method: 'POST',
					data: { email: email, otp: otp },
					success: function(response) {
						if (response.success) {
							$otpVerifyMessage.removeClass('text-danger').addClass('text-success').html('<i class="bi bi-check-circle me-1"></i>' + response.message).show();
							showEmailVerified();
							isEmailVerified = true;
							clearResendTimer();
							// Check if email has account after OTP verification
							checkEmailHasAccount(email);
						} else {
							$otpVerifyMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle me-1"></i>' + response.message).show();
							$verifyOtpBtn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>' + (localizedMessages.verify || 'Verify'));
							$otpInput.val('').focus();
						}
					},
					error: function() {
						$otpVerifyMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle me-1"></i>' + (localizedMessages.errorVerifyingOTP || 'Error verifying code. Please try again.')).show();
						$verifyOtpBtn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>' + (localizedMessages.verify || 'Verify'));
					}
				});
			});
			
			// Resend OTP
			$resendOtpBtn.on('click', function() {
				if ($(this).hasClass('disabled')) return;
				$sendOtpBtn.click();
			});
			
			// Allow Enter key to verify OTP
			$otpInput.on('keypress', function(e) {
				if (e.which === 13) { // Enter key
					$verifyOtpBtn.click();
				}
			});
			
			// Only allow numbers in OTP input
			$otpInput.on('input', function() {
				this.value = this.value.replace(/[^0-9]/g, '');
			});
			
			function showOtpSendSection() {
				$otpSendSection.show();
				$otpVerifySection.hide();
				$emailVerifiedSection.hide();
				$sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send me-2"></i>' + (localizedMessages.sendVerificationCode || 'Send Verification Code'));
			}
			
			function showOtpVerifySection() {
				$otpSendSection.hide();
				$otpVerifySection.show();
				$emailVerifiedSection.hide();
				$otpInput.focus();
				$verifyOtpBtn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>' + (localizedMessages.verify || 'Verify'));
			}
			
			function showEmailVerified() {
				$otpSendSection.hide();
				$otpVerifySection.hide();
				$emailVerifiedSection.show();
				$('#createAccountSection').show();
				clearResendTimer();
			}
			
			function resetOtpSection() {
				$otpSendSection.show();
				$otpVerifySection.hide();
				$emailVerifiedSection.hide();
				$('#createAccountSection').hide();
				$('#createAccountCheckbox').prop('checked', false);
				$otpInput.val('');
				$otpSendMessage.hide();
				$otpVerifyMessage.hide();
				$sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send me-2"></i>' + (localizedMessages.sendVerificationCode || 'Send Verification Code'));
				isEmailVerified = false;
				clearResendTimer();
			}
			
			function startResendCooldown() {
				clearResendTimer();
				$resendOtpBtn.addClass('disabled').prop('disabled', true);
				var seconds = resendCooldown;
				
				resendTimer = setInterval(function() {
					seconds--;
					if (seconds > 0) {
						$resendOtpBtn.html('<i class="bi bi-arrow-clockwise me-1"></i>' + (localizedMessages.resendCode || 'Resend Code') + ' (' + seconds + 's)');
					} else {
