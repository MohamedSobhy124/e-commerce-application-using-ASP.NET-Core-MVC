@section Scripts {
	<script>
		var subtotal = @Model.OrderHeader.OrderTotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
		var currentDiscount = 0;
		var currentPromoCodeId = null;
		var deliveryCharge = 0;
		
		// Payment method minimum order amounts from configuration
		var tappyMinimumOrderAmount = @(((decimal)(ViewData["TappyMinimumAmount"] ?? 400m)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
		var tamaraMinimumOrderAmount = @(((decimal)(ViewData["TamaraMinimumAmount"] ?? 400m)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
		// Use "Enabled" flag - indicates if payment method is enabled in settings (regardless of amount)
		var tappyEnabled = @((ViewData["TappyEnabled"] != null && (bool)ViewData["TappyEnabled"]).ToString().ToLower());
		var tamaraEnabled = @((ViewData["TamaraEnabled"] != null && (bool)ViewData["TamaraEnabled"]).ToString().ToLower());
		
		// Store localized strings for JavaScript
		var localizedOther = '@Html.Raw(Localizer["Other"].Value)';
		var localizedSelectArea = '@Html.Raw(Localizer["SelectArea"].Value)';
		var localizedMinimumOrderMessage = '@Html.Raw(Localizer["MinimumOrderForPayment"]?.Value ?? "Minimum order of {0} AED required for {1}")';

		// Localized messages for validation
		var localizedMessages = {
			fieldIsRequired: '@Html.Raw(Localizer["FieldIsRequired"].Value)',
			isRequired: '@Html.Raw(Localizer["IsRequired"].Value)',
			invalidEmailFormat: '@Html.Raw(Localizer["InvalidEmailFormat"].Value)',
			pleaseEnterValidEmail: '@Html.Raw(Localizer["PleaseEnterValidEmailAddress"].Value)',
			pleaseSelectPaymentMethod: '@Html.Raw(Localizer["PleaseSelectPaymentMethod"].Value)',
			pleaseFillAllRequiredFields: '@Html.Raw(Localizer["PleaseFillAllRequiredFields"].Value)',
			validationError: '@Html.Raw(Localizer["ValidationError"].Value)',
			processing: '@Html.Raw(Localizer["Processing"].Value)',
			name: '@Html.Raw(Localizer["Name"].Value)',
			phone: '@Html.Raw(Localizer["Phone"].Value)',
			streetAddress: '@Html.Raw(Localizer["StreetAddress"].Value)',
			city: '@Html.Raw(Localizer["City"].Value)',
			area: '@Html.Raw(Localizer["Area"].Value)',
			state: '@Html.Raw(Localizer["State"].Value)',
			postalCode: '@Html.Raw(Localizer["PostalCode"].Value)',
			emailAddress: '@Html.Raw(Localizer["EmailAddress"].Value)',
			sendVerificationCode: '@Html.Raw(Localizer["SendVerificationCode"]?.Value ?? "Send Verification Code")',
			verify: '@Html.Raw(Localizer["Verify"]?.Value ?? "Verify")',
			resendCode: '@Html.Raw(Localizer["ResendCode"]?.Value ?? "Resend Code")',
			errorSendingOTP: '@Html.Raw(Localizer["ErrorSendingOTP"]?.Value ?? "Error sending verification code. Please try again.")',
			errorVerifyingOTP: '@Html.Raw(Localizer["ErrorVerifyingOTP"]?.Value ?? "Error verifying code. Please try again.")',
			pleaseEnterValidOTP: '@Html.Raw(Localizer["PleaseEnterValidOTP"]?.Value ?? "Please enter a valid 6-digit code")',
			emailNotVerified: '@Html.Raw(Localizer["EmailNotVerified"]?.Value ?? "Please verify your email address before placing the order.")',
			sending: '@Html.Raw(Localizer["Sending"]?.Value ?? "Sending...")',
			verifying: '@Html.Raw(Localizer["Verifying"]?.Value ?? "Verifying...")',
			accountFound: '@Html.Raw(Localizer["AccountFound"]?.Value ?? "Account Found")',
			orderWillBeLinked: '@Html.Raw(Localizer["OrderWillBeLinkedToAccount"]?.Value ?? "This order will be linked to your existing account.")'
		};

		$(document).ready(function() {
			// Initialize payment methods visibility on page load
			var initialTotal = subtotal - currentDiscount + deliveryCharge;
			updatePaymentMethodsVisibility(initialTotal);
			
			// Apply promo code
			$('#applyPromoBtn').click(function() {
				var promoCode = $('#promoCodeInput').val().trim().toUpperCase();
				
				if (!promoCode) {
					showPromoMessage('@Localizer["PleaseEnterPromoCode"]', 'danger');
					return;
				}

				// Disable button and show loading
				$(this).prop('disabled', true).html('<i class="spinner-border spinner-border-sm"></i> @Localizer["Applying"]');

				$.ajax({
					url: '@Url.Action("ValidatePromoCode", "Cart")',
					type: 'POST',
					data: { 
						promoCode: promoCode,
						__RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
					},
					success: function(response) {
						if (response.success) {
							// Show promo details
							$('#appliedPromoCode').text(response.promoCode);
							$('#promoDiscountText').text('(' + response.discountText + ')');
							$('#discountAmount').text('-' + formatCurrency(response.discountAmount));
							$('#promoCodeDetails').slideDown();
							$('#promoCodeInput').prop('disabled', true);
							
							// Update hidden fields
							$('#promoCodeIdInput').val(response.promoCodeId);
							$('#promoCodeTextInput').val(response.promoCode);
							
							// Update item-level discounts display
							updateItemDiscountsDisplay(response.itemDiscounts, response.eligibleItems);
							
							// Update totals
							currentDiscount = response.discountAmount;
							currentPromoCodeId = response.promoCodeId;
							updateTotals();
							
							showPromoMessage(response.message, 'success');
						} else {
							showPromoMessage(response.message, 'danger');
						}
					},
					error: function() {
						showPromoMessage('@Localizer["AnErrorOccurredPleaseTryAgain"]', 'danger');
					},
					complete: function() {
						$('#applyPromoBtn').prop('disabled', false).html('<i class="bi bi-check-circle"></i> @Localizer["Apply"]');
					}
				});
			});

			// Remove promo code
			$('#removePromoBtn').click(function() {
				$('#promoCodeDetails').slideUp();
				$('#promoCodeInput').val('').prop('disabled', false);
				$('#promoCodeIdInput').val('');
				$('#promoCodeTextInput').val('');
				$('#promoCodeMessage').html('');
				
				// Remove item-level discount indicators
				clearItemDiscountsDisplay();
				
				currentDiscount = 0;
				currentPromoCodeId = null;
				updateTotals();
			});

			// Function to update item-level discounts display
			function updateItemDiscountsDisplay(itemDiscounts, eligibleItems) {
				// First, clear all previous indicators
				clearItemDiscountsDisplay();
				
				if (!itemDiscounts || !eligibleItems || eligibleItems.length === 0) return;
				
				// Update each eligible item
				eligibleItems.forEach(function(item) {
					var itemKey = item.itemKey;
					var discountAmount = item.discountAmount || 0;
					
					if (discountAmount > 0) {
						// Find the list item by item key
						var $listItem = $('.order-item[data-item-key="' + itemKey + '"]');
						
						if ($listItem.length > 0) {
							// Show promo badge
							$listItem.find('.promo-applied-badge').show();
							
							// Show discount amount
							var $discountAmount = $listItem.find('.item-discount-amount');
							var discountText = '-' + formatCurrency(discountAmount);
							$discountAmount.text(discountText).show();
							
							// Update price display
							var originalPrice = item.originalPrice;
							var discountedPrice = item.discountedPrice;
							
							var $originalPrice = $listItem.find('.original-price');
							var $discountedPrice = $listItem.find('.discounted-price');
							
							$originalPrice.addClass('text-decoration-line-through text-muted');
							$discountedPrice.text(formatCurrency(discountedPrice)).show();
							
							// Highlight the item
							$listItem.addClass('promo-discount-applied');
						}
					}
				});
			}

