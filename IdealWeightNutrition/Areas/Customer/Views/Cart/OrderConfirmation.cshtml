@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@using IdealWeightNutrition.Helpers
@model int
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <div class="success-animation mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    </div>
                    
                    <h1 class="text-success mb-3">@(Localizer["OrderPlacedSuccessful"]?.Value ?? "Order Placed Successfully!")</h1>
                    
                    @if (TempData["AccountLinkedMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">
                            <i class="bi bi-link-45deg me-2"></i>
                            <strong>@(Localizer["AccountLinked"]?.Value ?? "Account Linked"):</strong>
                            @TempData["AccountLinkedMessage"]
                        </div>
                    }
                    
                    @if (TempData["AccountCreatedMessage"] != null)
                    {
                        <div class="alert alert-success mt-4">
                            <i class="bi bi-person-plus me-2"></i>
                            <strong>@(Localizer["AccountCreated"]?.Value ?? "Account Created"):</strong>
                            @TempData["AccountCreatedMessage"]
                        </div>
                    }
                    
                    <div class="alert alert-info mt-4">
                        <h4 class="mb-3">
                            <i class="bi bi-receipt me-2"></i>
                            @(Localizer["YourOrderNumber"]?.Value ?? "Your Order Number")
                        </h4>
                        <h2 class="text-primary mb-0">#@Model</h2>
                    </div>

                    @if (!User.Identity.IsAuthenticated)
                    {
                        <div class="alert alert-warning mt-4">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@(Localizer["Important"]?.Value ?? "Important"):</strong> @(Localizer["SaveYourOrderNumber"]?.Value ?? "Save your order number! You'll need it to track your order.")
                        </div>

                        <div class="track-order-section mt-4 p-4 bg-light rounded">
                            <h5 class="mb-3">
                                <i class="bi bi-search me-2"></i>
                                @(Localizer["TrackYourOrder"]?.Value ?? "Track Your Order")
                            </h5>
                            <p class="text-muted mb-3">
                                @(Localizer["UseOrderIDAndEmailToTrackOrderStatus"]?.Value ?? "Use your Order ID and email address to track your order status anytime.")
                            </p>
                            <a asp-area="Customer" asp-controller="Home" asp-action="TrackOrder" class="btn btn-outline-primary">
                                <i class="bi bi-box-seam me-2"></i>
                                @(Localizer["TrackOrderNow"]?.Value ?? "Track Order Now")
                            </a>
                        </div>
                    }

                    <hr class="my-4" />

                    <div class="next-steps">
                        <h5 class="mb-3">@(Localizer["WhatsNext"]?.Value ?? "What's Next?")</h5>
                        <div class="row text-start">
                            <div class="col-md-4 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-envelope-check text-primary me-3" style="font-size: 2rem;"></i>
                                    <div>
                                        <h6>@(Localizer["ConfirmationEmail"]?.Value ?? "Confirmation Email")</h6>
                                        <small class="text-muted">@(Localizer["CheckYourEmail"]?.Value ?? "Check your email for order details")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-box text-primary me-3" style="font-size: 2rem;"></i>
                                    <div>
                                        <h6>@(Localizer["Processing"]?.Value ?? "Processing")</h6>
                                        <small class="text-muted">@(Localizer["WeWillPrepare"]?.Value ?? "We'll prepare your order")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-truck text-primary me-3" style="font-size: 2rem;"></i>
                                    <div>
                                        <h6>@(Localizer["Delivery"]?.Value ?? "Delivery")</h6>
                                        <small class="text-muted">@(Localizer["Within48HoursWorkingDays"]?.Value ?? "Within 48 hours (working days)")</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg me-2">
                            <i class="bi bi-shop me-2"></i>
                            @(Localizer["ContinueShopping"]?.Value ?? "Continue Shopping")
                        </a>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a href="@Url.EncryptedAction("OrderDetails", "Account", Model, new { area = "Customer" })" class="btn btn-outline-primary btn-lg">
                                <i class="bi bi-receipt me-2"></i>
                                @(Localizer["ViewDetails"]?.Value ?? "View Order Details")
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted">
                    <i class="bi bi-question-circle me-2"></i>
                    @(Localizer["NeedHelp"]?.Value ?? "Need help?") <a href="#">@(Localizer["ContactSupport"]?.Value ?? "Contact our support team")</a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .success-animation i {
        animation: scaleIn 0.5s ease-in-out;
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .card {
        border-radius: 15px;
    }

    .track-order-section {
        border: 2px dashed #dee2e6;
    }

    .next-steps .bi {
        flex-shrink: 0;
    }
</style> 