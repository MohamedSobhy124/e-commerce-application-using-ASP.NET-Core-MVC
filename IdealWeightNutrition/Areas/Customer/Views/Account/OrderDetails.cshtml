@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@using IdealWeightNutrition.Models
@model OrderHeader
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["OrderDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var orderDetails = ViewBag.OrderDetails as List<OrderDetail> ?? new List<OrderDetail>();
    
    // Helper function to translate status values
    Func<string, string> translateStatus = (status) =>
    {
        if (string.IsNullOrEmpty(status)) return Localizer["Pending"]?.Value ?? "Pending";
        var translated = Localizer[status]?.Value;
        return translated ?? status;
    };
    
    var orderStatusColor = Model.OrderStatus switch
    {
        "Approved" => "#7BC043",
        "InProcess" => "#3B9DD5",
        "Shipped" => "#667eea",
        "Cancelled" => "#dc3545",
        "Refunded" => "#6c757d",
        _ => "#ffc107"
    };
    var paymentStatusColor = Model.PaymentStatus switch
    {
        "Approved" => "#7BC043",
        "Pending" => "#ffc107",
        "Rejected" => "#dc3545",
        _ => "#6c757d"
    };
}

<div class="container py-4" style="margin-top: 1rem;">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="display-5 fw-bold mb-2" style="background: linear-gradient(135deg, #3B9DD5 0%, #7BC043 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                <i class="bi bi-receipt-cutoff me-2"></i>@Localizer["OrderDetails"]
            </h1>
            <p class="text-muted mb-0">@(Localizer["OrderNumber"]?.Value ?? "Order Number"): #@Model.Id</p>
        </div>
        @if (ViewBag.IsGuestView == true)
        {
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary" style="border-radius: 10px; padding: 0.6rem 1.5rem;">
                <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToShopping"]?.Value  
            </a>
        }
        else
        {
            <a asp-area="Customer" asp-controller="Account" asp-action="Orders" class="btn btn-outline-primary" style="border-radius: 10px; padding: 0.6rem 1.5rem;">
                <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToOrders"]
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Order Information Card -->
        <div class="col-lg-8">
            <div class="card" style="border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-radius: 20px; overflow: hidden;">
                <div class="card-header" style="background: linear-gradient(135deg, rgba(59, 157, 213, 0.05) 0%, rgba(123, 192, 67, 0.05) 100%); padding: 1.5rem; border-bottom: 2px solid rgba(59, 157, 213, 0.1);">
                    <h5 class="mb-0 fw-bold" style="color: #1f2937;">
                        <i class="bi bi-box-seam me-2" style="color: #3B9DD5;"></i>@Localizer["OrderItems"]
                    </h5>
                </div>
                <div class="card-body p-4">
                    @foreach (var detail in orderDetails)
                    {
                        var product = detail.Product;
                        var productName = currentCulture == "ar" && !string.IsNullOrEmpty(product?.TitleAr) ? product.TitleAr : product?.Title ?? "Product";
                        var productImage = product?.ProductImages?.FirstOrDefault(pi => pi.ImageInfo == null)?.ImageUrl 
                            ?? product?.ProductImages?.FirstOrDefault()?.ImageUrl 
                            ?? product?.ImageUrl 
                            ?? "/images/default-product.jpg";
                        
                        <div class="order-detail-item mb-4 pb-4" style="border-bottom: 1px solid rgba(59, 157, 213, 0.1);">
                            <div class="row align-items-center">
                                <div class="col-md-2 mb-3 mb-md-0">
                                    <img src="@productImage" alt="@productName" style="width: 100%; height: auto; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                                </div>
                                <div class="col-md-6">
                                    <h6 class="fw-bold mb-2" style="color: #1f2937;">@productName</h6>
                                    @if (detail.ProductVariantId.HasValue && detail.ProductVariant != null)
                                    {
                                        var variantOptions = detail.ProductVariant.VariantOptionValues?
                                            .OrderBy(vov => vov.OptionValue?.ProductOption?.DisplayOrder ?? 0)
                                            .ThenBy(vov => vov.OptionValue?.DisplayOrder ?? 0)
                                            .Select(vov => $"{vov.OptionValue?.ProductOption?.Name}: {vov.OptionValue?.Value}")
                                            .Where(s => !string.IsNullOrEmpty(s))
                                            .ToList() ?? new List<string>();
                                        
                                        if (variantOptions.Any())
                                        {
                                            <p class="text-muted mb-2" style="font-size: 0.9rem;">
                                                <i class="bi bi-tag me-1"></i>@string.Join(", ", variantOptions)
                                            </p>
                                        }
                                    }
                                    @if (detail.FlashSaleItemId.HasValue)
                                    {
                                        <span class="badge" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); font-size: 0.75rem; padding: 0.3rem 0.6rem;">
                                            <i class="bi bi-lightning-fill me-1"></i>@(Localizer["FlashSale"]?.Value ?? "Flash Sale")
                                        </span>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <div class="mb-2">
                                        <span class="text-muted">@Localizer["Quantity"]:</span>
                                        <span class="fw-bold ms-2">@detail.Count</span>
                                    </div>
                                    <div class="fw-bold" style="color: #3B9DD5; font-size: 1.2rem;">
                                        @Html.Raw(currencySymbol)@detail.Price.ToString("N2")
                                    </div>
                                    <div class="text-muted" style="font-size: 0.9rem;">
                                        @Localizer["Subtotal"]: @Html.Raw(currencySymbol)@((detail.Price * detail.Count).ToString("N2"))
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="col-lg-4">
            <div class="card" style="border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-radius: 20px; overflow: hidden; position: sticky; top: 100px;">
                <div class="card-header" style="background: linear-gradient(135deg, rgba(59, 157, 213, 0.05) 0%, rgba(123, 192, 67, 0.05) 100%); padding: 1.5rem; border-bottom: 2px solid rgba(59, 157, 213, 0.1);">
                    <h5 class="mb-0 fw-bold" style="color: #1f2937;">
                        <i class="bi bi-info-circle me-2" style="color: #3B9DD5;"></i>@Localizer["OrderSummary"]
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Order Status -->
                    <div class="mb-3">
                        <label class="text-muted small mb-1">@Localizer["OrderStatus"]</label>
                        <div class="order-status-badge" style="display: inline-block; padding: 0.5rem 1rem; border-radius: 25px; font-weight: 700; font-size: 0.85rem; background: @orderStatusColor; color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>@translateStatus(Model.OrderStatus)
                        </div>
                    </div>

                    <!-- Payment Status -->
                    <div class="mb-3">
                        <label class="text-muted small mb-1">@Localizer["PaymentStatus"]</label>
                        <div class="payment-status-badge" style="display: inline-block; padding: 0.5rem 1rem; border-radius: 25px; font-weight: 700; font-size: 0.85rem; background: @paymentStatusColor; color: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                            <i class="bi bi-credit-card me-1"></i>@translateStatus(Model.PaymentStatus)
                        </div>
                    </div>

                    <!-- Order Date -->
                    <div class="mb-3">
                        <label class="text-muted small mb-1">@Localizer["OrderDate"]</label>
                        <p class="mb-0 fw-bold">@Model.OrderDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo(currentCulture)) @(Localizer["At"]?.Value ?? "at") @Model.OrderDate.ToString("HH:mm", System.Globalization.CultureInfo.GetCultureInfo(currentCulture))</p>
                    </div>

                    <!-- Shipping Date -->
                    @if (Model.ShippingDate > DateTime.MinValue)
                    {
                        <div class="mb-3">
                            <label class="text-muted small mb-1">@Localizer["ShippingDate"]</label>
                            <p class="mb-0 fw-bold">@Model.ShippingDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo(currentCulture))</p>
                        </div>
                    }

                    <!-- Tracking -->
                    @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                    {
                        <div class="mb-3">
                            <label class="text-muted small mb-1">@Localizer["TrackingNumber"]</label>
                            <p class="mb-0 fw-bold" style="color: #3B9DD5;">@Model.TrackingNumber</p>
                            @if (!string.IsNullOrEmpty(Model.Carrier))
                            {
                                <p class="mb-0 text-muted small">@(Localizer["Carrier"]?.Value ?? "Carrier"): @Model.Carrier</p>
                            }
                            <a asp-area="Customer" asp-controller="Home" asp-action="OrderTracking" asp-route-trackingNumber="@Model.TrackingNumber" 
                               class="btn btn-sm btn-outline-primary mt-2" style="border-radius: 8px;">
                                <i class="bi bi-truck me-1"></i>@Localizer["TrackOrder"]
                            </a>
                        </div>
                    }

                    <!-- Shipping Address -->
                    <div class="mb-3">
                        <label class="text-muted small mb-1">@Localizer["ShippingAddress"]</label>
                        <p class="mb-0" style="font-size: 0.9rem;">
                            @Model.Name<br />
                            @Model.StreetAddress<br />
                            @Model.City, @Model.State @Model.PostalCode<br />
                            @Model.PhoneNumber
                        </p>
                    </div>

                    <!-- Price Breakdown -->
                    <div class="price-breakdown mt-4 pt-3" style="border-top: 2px solid rgba(59, 157, 213, 0.2);">
                        @if (Model.OrderSubtotal.HasValue && Model.OrderSubtotal.Value > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">@Localizer["Subtotal"]:</span>
                                <span>@Html.Raw(currencySymbol)@Model.OrderSubtotal.Value.ToString("N2")</span>
                            </div>
                        }
                        @if (Model.DiscountAmount.HasValue && Model.DiscountAmount.Value > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-success">
                                    <i class="bi bi-tag me-1"></i>@Localizer["Discount"]:
                                </span>
                                <span class="text-success fw-bold">-@Html.Raw(currencySymbol)@Model.DiscountAmount.Value.ToString("N2")</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-center pt-2" style="border-top: 1px solid rgba(59, 157, 213, 0.1);">
                            <span class="fw-bold" style="font-size: 1.1rem;">@Localizer["Total"]:</span>
                            <span class="fw-bold" style="font-size: 1.3rem; color: #3B9DD5;">
                                @Html.Raw(currencySymbol)@Model.OrderTotal.ToString("N2")
                            </span>
                        </div>
                    </div>
                    
                    <!-- Return Request Section -->
                    @if (ViewBag.HasReturnRequest == true && ViewBag.ReturnRequest != null)
                    {
                        var returnRequest = ViewBag.ReturnRequest as ReturnRequest;
                        <div class="mt-4 pt-3" style="border-top: 2px solid rgba(220, 53, 69, 0.2);">
                            <h5 class="mb-3" style="color: #dc3545;">
                                <i class="bi bi-arrow-return-left me-2"></i>@(Localizer["ReturnRequest"]?.Value ?? "Return Request")
                            </h5>
                            <div class="alert @(returnRequest.Status == SD.ReturnStatusApproved ? "alert-success" : returnRequest.Status == SD.ReturnStatusRejected ? "alert-danger" : returnRequest.Status == SD.ReturnStatusCompleted ? "alert-success" : "alert-warning")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@(Localizer["ReturnRequestStatus"]?.Value ?? "Status"):</strong> 
                                        <span class="badge bg-@(returnRequest.Status == SD.ReturnStatusApproved ? "success" : returnRequest.Status == SD.ReturnStatusRejected ? "danger" : returnRequest.Status == SD.ReturnStatusCompleted ? "success" : "warning")">
                                            @returnRequest.Status
                                        </span>
                                        <br />
                                        <small class="text-muted">
                                            @(Localizer["RequestDate"]?.Value ?? "Request Date"): @returnRequest.RequestDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo(currentCulture))
                                        </small>
                                        @if (returnRequest.RefundAmount.HasValue)
                                        {
                                            <br />
                                            <strong>@(Localizer["RefundAmount"]?.Value ?? "Refund Amount"):</strong> 
                                            <span class="text-success">@Html.Raw(currencySymbol)@returnRequest.RefundAmount.Value.ToString("N2")</span>
                                        }
                                        @if (!string.IsNullOrEmpty(returnRequest.AdminNotes))
                                        {
                                            <br />
                                            <strong>@(Localizer["AdminNotes"]?.Value ?? "Admin Notes"):</strong> @returnRequest.AdminNotes
                                        }
                                        @if (!string.IsNullOrEmpty(returnRequest.RejectionReason))
                                        {
                                            <br />
                                            <strong class="text-danger">@(Localizer["RejectionReason"]?.Value ?? "Rejection Reason"):</strong> @returnRequest.RejectionReason
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.OrderStatus == SD.StatusDelivered || 
                             Model.OrderStatus == SD.StatusShipped || 
                             Model.OrderStatus == SD.StatusOutForDelivery)
                    {
                        <div class="mt-4 pt-3" style="border-top: 2px solid rgba(220, 53, 69, 0.2);">
                            <h5 class="mb-3" style="color: #dc3545;">
                                <i class="bi bi-arrow-return-left me-2"></i>@(Localizer["NeedToReturn"]?.Value ?? "Need to Return?")
                            </h5>
                            <p class="text-muted mb-3">@(Localizer["ReturnRequestDescription"]?.Value ?? "If you're not satisfied with your order, you can request a return within 14 days of delivery.")</p>
                            @if (ViewBag.IsGuestView == true && !string.IsNullOrEmpty(Model.Email))
                            {
                                <a asp-area="Customer" asp-controller="Account" asp-action="RequestReturn" asp-route-orderId="@Model.Id" asp-route-email="@Model.Email" class="btn btn-danger">
                                    <i class="bi bi-arrow-return-left me-2"></i>@(Localizer["RequestReturn"]?.Value ?? "Request Return")
                                </a>
                            }
                            else
                            {
                                <a asp-area="Customer" asp-controller="Account" asp-action="RequestReturn" asp-route-orderId="@Model.Id" class="btn btn-danger">
                                    <i class="bi bi-arrow-return-left me-2"></i>@(Localizer["RequestReturn"]?.Value ?? "Request Return")
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

