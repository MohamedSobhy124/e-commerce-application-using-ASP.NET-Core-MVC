        // Initialize quantity validation
        function initializeQuantityValidation() {
            const quantityInput = $('#quantityInput');
            const decreaseBtn = $('#quantityDecrease');
            const increaseBtn = $('#quantityIncrease');
            
            // Set initial max value based on product type
            if (productType === 0) {
                // Simple product - use product stock
                updateQuantityInputMax(productStockQuantity);
            } else {
                // Variable product - will be updated when variant is selected
                updateQuantityInputMax(productStockQuantity);
            }
            
            // Decrease button click
            decreaseBtn.on('click', function() {
                if ($(this).prop('disabled')) return;
                const currentValue = parseInt(quantityInput.val()) || 1;
                if (currentValue > 1) {
                    quantityInput.val(currentValue - 1);
                    validateQuantity();
                    // Add visual feedback
                    $(this).addClass('quantity-btn-clicked');
                    setTimeout(() => $(this).removeClass('quantity-btn-clicked'), 200);
                }
            });
            
            // Increase button click
            increaseBtn.on('click', function() {
                if ($(this).prop('disabled')) return;
                const currentValue = parseInt(quantityInput.val()) || 1;
                quantityInput.val(currentValue + 1);
                validateQuantity();
                // Add visual feedback
                $(this).addClass('quantity-btn-clicked');
                setTimeout(() => $(this).removeClass('quantity-btn-clicked'), 200);
            });
            
            // Validate on input change (if user types directly)
            quantityInput.on('input change', function() {
                validateQuantity();
            });
            
            // Validate on blur
            quantityInput.on('blur', function() {
                validateQuantity();
            });
            
            // Prevent scrolling when focused on input
            quantityInput.on('wheel', function(e) {
                e.preventDefault();
            });
        }
        
        // Update quantity input max attribute
        function updateQuantityInputMax(maxQuantity) {
            const quantityInput = $('#quantityInput');
            const decreaseBtn = $('#quantityDecrease');
            const increaseBtn = $('#quantityIncrease');
            
            quantityInput.attr('max', maxQuantity);
            
            // If current value exceeds max, adjust it
            const currentValue = parseInt(quantityInput.val()) || 1;
            if (currentValue > maxQuantity && maxQuantity > 0) {
                quantityInput.val(maxQuantity);
            } else if (maxQuantity === 0) {
                quantityInput.val(1);
            }
            
            // Update button states
            const newValue = parseInt(quantityInput.val()) || 1;
            decreaseBtn.prop('disabled', newValue <= 1);
            increaseBtn.prop('disabled', maxQuantity > 0 && newValue >= maxQuantity);
        }
        
        // Validate quantity against available stock
        function validateQuantity() {
            const quantityInput = $('#quantityInput');
            const decreaseBtn = $('#quantityDecrease');
            const increaseBtn = $('#quantityIncrease');
            const quantity = parseInt(quantityInput.val()) || 1;
            let maxQuantity = 0;
            let errorMessage = '';
            
            if (productType === 0) {
                // Simple product - check product stock
                maxQuantity = productStockQuantity;
            } else {
                // Variable product - check variant stock
                const variantId = $('#selectedVariantId').val();
                if (variantId) {
                    const variant = variants.find(v => v.id === parseInt(variantId));
                    if (variant) {
                        maxQuantity = variant.stockQuantity;
                    } else {
                        maxQuantity = 0;
                    }
                } else {
                    // No variant selected yet
                    maxQuantity = productStockQuantity;
                }
            }
            
            // Validate quantity
            if (quantity < 1) {
                quantityInput.val(1);
                updateQuantityInputMax(maxQuantity);
                return true;
            }
            
            if (maxQuantity === 0) {
                errorMessage = localizations.outOfStockMsg;
                quantityInput.val(1);
                decreaseBtn.prop('disabled', true);
                increaseBtn.prop('disabled', true);
                showQuantityError(errorMessage);
                return false;
            }
            
            if (quantity > maxQuantity) {
                errorMessage = localizations.onlyAvailable.replace(/\{0\}/g, maxQuantity);
                quantityInput.val(maxQuantity);
                updateQuantityInputMax(maxQuantity);
                showQuantityError(errorMessage);
                return false;
            }
            
            // Update button states
            decreaseBtn.prop('disabled', quantity <= 1);
            increaseBtn.prop('disabled', quantity >= maxQuantity);
            
            // Clear any error messages
            hideQuantityError();
            return true;
        }
        
        // Show quantity error message
        function showQuantityError(message) {
            let errorDiv = $('#quantityError');
            if (errorDiv.length === 0) {
                errorDiv = $('<div id="quantityError" class="text-danger small mt-1"></div>');
                $('#quantityInput').after(errorDiv);
            }
            errorDiv.text(message).show();
            
            // Auto-hide after 3 seconds
            setTimeout(function() {
                hideQuantityError();
            }, 3000);
        }
        
        // Hide quantity error message
        function hideQuantityError() {
            $('#quantityError').hide();
        }
        
        // Update form submission to include variant ID and validate quantity - CONVERT TO AJAX
        $('form').on('submit', function(e) {
            e.preventDefault(); // Prevent default form submission
            
            // Validate quantity before submission
            if (!validateQuantity()) {
                return false;
            }
            
            if (productType === 1) {
                const variantId = $('#selectedVariantId').val();
                if (!variantId) {
                    Swal.fire({
                        icon: 'warning',
                        title: localizations.selectOptions,
                        text: localizations.selectAllOptions
                    });
                    return false;
                }
                
                // Add variant ID to form
                if (!$('input[name="ProductVariantId"]').length) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'ProductVariantId',
                        value: variantId
                    }).appendTo(this);
                }
            }
            
            // Get form data
            const formData = new FormData(this);
            const addToCartBtn = $('#addToCartBtn');
            const originalBtnText = addToCartBtn.html();
            
            // Show loading state
            addToCartBtn.prop('disabled', true);
            addToCartBtn.html('<i class="bi bi-arrow-repeat spin"></i> @Localizer["Adding"]...');
            
            // Submit via AJAX
            fetch(window.location.href, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            })
            .then(response => {
                // Check if response is JSON
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    return response.json();
                }
                
                // If redirected, it means success (non-AJAX fallback)
                if (response.redirected) {
                    return { success: true, message: '@Localizer["ItemAddedToCart"]' || 'Product added to cart successfully!' };
                }
                
                // Try to parse as JSON, fallback to success
                return response.json().catch(() => ({ success: true }));
            })
            .then(data => {
                // Reset button
                addToCartBtn.prop('disabled', false);
                addToCartBtn.html(originalBtnText);
                
                if (data && data.success !== false) {
                    // Success - update cart count
                    const quantity = parseInt($('#quantityInput').val()) || 1;
                    const variantId = $('#selectedVariantId').val();
                    
                    // Sync with localStorage
                    if (window.cartStorage) {
                        // Get product info for localStorage
                        const item = {
                            productId: productId,
                            count: quantity,
                            productVariantId: variantId ? parseInt(variantId) : null
                        };
                        
                        // Check if there's a flash sale
                        if (productType === 1 && variantId) {
                            const variant = variants.find(v => v.id === parseInt(variantId));
                            if (variant && variantFlashSaleMap[variant.id]) {
                                item.flashSaleItemId = variantFlashSaleMap[variant.id].flashSaleItemId;
                                item.flashSalePrice = variantFlashSaleMap[variant.id].flashSalePrice;
                            }
                        }
                        
                        window.cartStorage.addItem(item);
                    }
                    
                    // Update cart count everywhere
                    updateCartCountAfterAdd();
                    
                    // Show success message
                    const successMsg = data.message || '@Localizer["ItemAddedToCart"]' || 'Product added to cart successfully!';
                    if (typeof toastr !== 'undefined') {
                        toastr.success(successMsg);
                    } else if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: successMsg,
                            timer: 2000,
                            showConfirmButton: false
                        });
                    }
                    
                    // Optionally open cart sidebar (desktop only)
                    if (typeof openCartSidebar === 'function' || typeof window.openCartSidebar === 'function') {
                        const openCart = window.openCartSidebar || openCartSidebar;
                        const sidebar = document.querySelector('.cart-sidebar-new') || document.getElementById('cartSidebar');
                        const isMobile = window.innerWidth <= 768;
                        
                        if (sidebar && !isMobile) {
                            setTimeout(() => {
                                openCart(true);
                            }, 500);
                        }
                    }
                } else {
                    // Error
                    const errorMsg = data.message || '@Localizer["FailedToAddToCart"]' || 'Failed to add product to cart';
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errorMsg);
                    } else if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: errorMsg
                        });
                    }
                }
            })
            .catch(error => {
                console.error('Error adding to cart:', error);
                addToCartBtn.prop('disabled', false);
                addToCartBtn.html(originalBtnText);
                
                const errorMsg = '@Localizer["AnErrorOccurred"]' || 'An error occurred. Please try again.';
                if (typeof toastr !== 'undefined') {
                    toastr.error(errorMsg);
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: errorMsg
                    });
                }
            });
            
            return false;
        });
        
        // Function to update cart count after adding to cart
        function updateCartCountAfterAdd() {
            // Get cart count from server
            fetch('/Customer/Home/GetCartCount')
                .then(response => response.json())
                .then(data => {
                    const cartCount = data.cartCount || 0;
                    
                    // Update navigation cart count
                    const cartCountElement = document.getElementById('cartCount');
                    if (cartCountElement) {
                        cartCountElement.textContent = cartCount;
                        if (cartCount > 0) {
                            cartCountElement.style.display = 'inline-block';
                            // Add pulse animation
                            cartCountElement.style.animation = 'none';
                            setTimeout(() => {
                                cartCountElement.style.animation = 'cartPulse 0.6s ease';
                            }, 10);
                        } else {
                            cartCountElement.style.display = 'none';
                        }
                    }
                    
                    // Update header cart badge
                    const headerCartBadge = document.getElementById('headerCartBadge');
                    if (headerCartBadge) {
                        if (cartCount > 0) {
                            headerCartBadge.textContent = cartCount;
                            headerCartBadge.style.display = 'flex';
                        } else {
                            headerCartBadge.style.display = 'none';
                        }
                    }
                    
                    // Update floating cart badge
                    if (typeof updateFloatingCartBadge === 'function') {
                        updateFloatingCartBadge(cartCount);
                    } else if (typeof window.updateFloatingCartBadge === 'function') {
                        window.updateFloatingCartBadge(cartCount);
                    }
                    
                    // Update cart widget
                    if (typeof updateCartWidget === 'function') {
                        setTimeout(() => {
                            updateCartWidget();
                        }, 150);
                    }
                    
                    // Update localStorage cart count display
                    if (window.cartStorage) {
                        window.cartStorage.updateCartCountFromLocalStorage();
                    }
                })
                .catch(error => {
                    console.error('Error updating cart count:', error);
                    // Fallback: update from localStorage
                    if (window.cartStorage) {
                        window.cartStorage.updateCartCountFromLocalStorage();
                    }
                });
        }

