                        var publicKey = widgetElement.getAttribute('data-public-key');
                        var amount = parseFloat(widgetElement.getAttribute('data-amount'));
                        var currency = widgetElement.getAttribute('data-currency') || 'AED';
                        var country = widgetElement.getAttribute('data-country') || 'AE';
                        
                        if (publicKey && amount > 0) {
                            try {
                                window.TamaraWidget.init({
                                    publicKey: publicKey,
                                    amount: amount,
                                    currency: currency,
                                    country: country,
                                    widgetType: 'product_page',
                                    containerId: 'tamara-widget-product-page'
                                });
                            } catch (e) {
                                console.error('Tamara widget initialization error:', e);
                            }
                        }
                    }
                }
            })();
            </text>
        }
    </script>
    
    <!-- Image Modal -->
    <div class="modal fade" id="productImageModal" tabindex="-1" aria-labelledby="productImageModalLabel" aria-hidden="true" data-bs-backdrop="true" data-bs-keyboard="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background: transparent; border: none; position: relative;">
                <div class="modal-body" style="padding: 0; text-align: center; position: relative;">
                    <button type="button" class="btn-close-modal" data-bs-dismiss="modal" aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <img id="modalProductImage" src="" alt="Product image" class="img-fluid" style="max-width: 100%; max-height: 80vh; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
                    <h5 id="modalProductName" class="mt-3 text-white" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);"></h5>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Image modal functionality for product details page
        $(document).ready(function() {
            $('.product-image-clickable').on('click', function() {
                const imageUrl = $(this).data('image-url');
                const productName = $(this).data('product-name');
                
                if (imageUrl) {
                    $('#modalProductImage').attr('src', imageUrl);
                    $('#modalProductImage').attr('alt', productName || 'Product image');
                    $('#modalProductName').text(productName || '');
                    $('#productImageModal').modal('show');
                }
            });
            
            // Close modal on ESC key
            $(document).on('keydown', function(e) {
                if (e.key === 'Escape') {
                    $('#productImageModal').modal('hide');
                }
            });
            
            // Close modal when clicking outside the image (on backdrop)
            $('#productImageModal').on('click', function(e) {
                // Check if click is on the backdrop (not on modal content)
                if ($(e.target).hasClass('modal') || $(e.target).hasClass('modal-backdrop')) {
                    $('#productImageModal').modal('hide');
                }
            });
            
            // Prevent closing when clicking on the image itself
            $('#productImageModal .modal-body').on('click', function(e) {
                e.stopPropagation();
            });
        });
    </script>
}
