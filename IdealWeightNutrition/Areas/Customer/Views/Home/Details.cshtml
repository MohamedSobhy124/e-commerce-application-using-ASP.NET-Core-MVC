        function subscribeToStockNotification(email, phone) {
            const variantId = $('#selectedVariantId').val();
            const btn = $('#subscribeStockNotificationBtn, #subscribeStockNotificationGuestBtn');
            const messageDiv = $('#stockNotificationMessage');
            
            // Disable button
            if (btn.length) btn.prop('disabled', true);
            
            // Get anti-forgery token
            const token = $('input[name="__RequestVerificationToken"]').val();
            
            // Show loading
            Swal.fire({
                title: '@Localizer["Processing"]',
                text: '@Localizer["PleaseWait"]',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            $.ajax({
                url: '/Customer/Home/SubscribeStockNotification',
                type: 'POST',
                data: {
                    productId: productId,
                    variantId: variantId || null,
                    email: email,
                    phoneNumber: phone,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    Swal.close();
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: response.message,
                            confirmButtonColor: '#7c3aed'
                        });
                        
                        // Hide button and show success message
                        if (btn.length) btn.hide();
                        messageDiv.removeClass('alert-danger').addClass('alert alert-success');
                        messageDiv.html('<i class="bi bi-check-circle me-2"></i>' + response.message).show();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: response.message,
                            confirmButtonColor: '#7c3aed'
                        });
                        
                        // Re-enable button
                        if (btn.length) btn.prop('disabled', false);
                        messageDiv.removeClass('alert-success').addClass('alert alert-danger');
                        messageDiv.html('<i class="bi bi-exclamation-circle me-2"></i>' + response.message).show();
                    }
                },
                error: function() {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: 'An error occurred. Please try again later.',
                        confirmButtonColor: '#7c3aed'
                    });
                    
                    // Re-enable button
                    if (btn.length) btn.prop('disabled', false);
                    messageDiv.removeClass('alert-success').addClass('alert alert-danger');
                    messageDiv.html('<i class="bi bi-exclamation-circle me-2"></i>An error occurred. Please try again later.').show();
                }
            });
        }
        
