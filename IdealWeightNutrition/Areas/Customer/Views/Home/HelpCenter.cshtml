                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" style="background: #F1F8E9; color: #1976D2; font-weight: 600;">
                                            كيف يمكنني إرجاع منتج؟
