@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["HelpCenter"];
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="page-header text-center mb-5">
                <h1 class="display-4" style="color: #1976D2; font-weight: 800;">
                    <i class="bi bi-question-circle me-3"></i>
                    @if(currentLang == "ar") {
                        <text>مركز المساعدة</text>
                    } else {
                        <text>Help Center</text>
                    }
                </h1>
                <div class="underline" style="width: 100px; height: 4px; background: linear-gradient(90deg, #3B9DD5, #7BC043); margin: 1rem auto;"></div>
            </div>

            @if(currentLang == "ar") 
            {
