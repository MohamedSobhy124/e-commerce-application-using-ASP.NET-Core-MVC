@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@model IEnumerable<IdealWeightNutrition.Models.ComboOffer>

@{
    var comboOffers = Model?.ToList() ?? new List<IdealWeightNutrition.Models.ComboOffer>();
    var hasComboOffers = comboOffers.Any();
    var itemsPerSlide = 4;
    var totalSlides = hasComboOffers ? (int)Math.Ceiling(comboOffers.Count / (double)itemsPerSlide) : 0;
}

@if (hasComboOffers)
{
    <section class="combo-offers-section" data-count="@comboOffers.Count">
        <div class="container">
            <div class="section-header">
                <div>
                    <h2 class="section-title">
                        <i class="bi bi-box-seam-fill" aria-hidden="true"></i>
                        @Localizer["ComboOffers"]
                    </h2>
                    <p class="section-subtitle">@Localizer["SaveMoreWithComboDeals"]</p>
                </div>
                <a asp-area="Customer" asp-controller="ComboOffer" asp-action="Index" class="view-all-link">
                    @Localizer["ViewAll"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <div id="comboOffersCarousel" class="carousel slide product-carousel combo-offers-carousel" data-bs-ride="carousel" data-bs-interval="8000" data-bs-pause="hover" data-bs-touch="true">
                <div class="carousel-inner">
                    @for (var slideIndex = 0; slideIndex < totalSlides; slideIndex++)
                    {
                        var slideOffers = comboOffers.Skip(slideIndex * itemsPerSlide).Take(itemsPerSlide).ToList();
                        if (!slideOffers.Any()) { continue; }

                        <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                            <div class="row g-3 g-md-4">
                                @foreach (var comboOffer in slideOffers)
                                {
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        @await Html.PartialAsync("_ComboOfferCard", comboOffer)
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (totalSlides > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#comboOffersCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Previous"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#comboOffersCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Next"]</span>
                    </button>
                    <div class="carousel-indicators">
                        @for (var i = 0; i < totalSlides; i++)
                        {
                            <button type="button" data-bs-target="#comboOffersCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="@Localizer["ComboOffers"] @(i + 1)"></button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}
