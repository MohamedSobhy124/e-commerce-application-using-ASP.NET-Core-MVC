@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@model Dictionary<int, List<IdealWeightNutrition.Models.Product>>
@inject IConfiguration Configuration

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var categories = ViewBag.Categories as IEnumerable<IdealWeightNutrition.Models.Categry> ?? Enumerable.Empty<IdealWeightNutrition.Models.Categry>();
    var categoryProductsMap = Model ?? new Dictionary<int, List<IdealWeightNutrition.Models.Product>>();
    var displayCategories = categories.ToList();
    var hasCategories = displayCategories.Any();
}

@if (hasCategories)
{
    <section class="category-section">
        <div class="category-section-title">
            <h2>@Localizer["ShopByCategory"]</h2>
        </div>
        <div class="category-carousel-container" id="categoryCarouselContainer">
            <button class="carousel-nav prev" onclick="scrollCategoryCarousel(-1)" aria-label="Previous categories">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="category-carousel-wrapper">
                <div class="category-carousel" id="categoryCarousel">
                    @for (int i = 0; i < displayCategories.Count; i++)
                    {
                        var category = displayCategories[i];
                        var categoryProducts = categoryProductsMap.ContainsKey(category.Id) 
                            ? categoryProductsMap[category.Id] 
                            : new List<IdealWeightNutrition.Models.Product>();
                        var categoryName = currentCulture == "ar" && !string.IsNullOrEmpty(category.NameAr) 
                            ? category.NameAr 
                            : category.Name;
                        
                        <div class="category-card"
                             data-category-index="@i"
                             data-category-id="@category.Id"
                             role="button"
                             tabindex="0"
                             style="cursor: pointer;">
                            <div class="category-circle">
                                @if (!string.IsNullOrEmpty(category.ImageUrl))
                                {
                                    <div class="category-image-wrapper">
                                        <img src="@category.ImageUrl" alt="@categoryName" class="category-image" />
                                    </div>
                                }
                                else
                                {
                                        // Get products from the map, limit to 4 for display
                                        var productsToShow = categoryProducts.Take(4).ToList();
                                    
                                    @if (productsToShow.Any())
                                    {
                                        <div class="category-products-grid">
                                            @foreach (var product in productsToShow)
                                            {
                                                // Get product image - check ProductImages first (excluding info images), then ImageUrl
                                                var productImage = product.ProductImages?.FirstOrDefault(pi => pi.ImageInfo == null)?.ImageUrl 
                                                    ?? product.ProductImages?.FirstOrDefault()?.ImageUrl 
                                                    ?? product.ImageUrl;
                                                
                                                if (!string.IsNullOrEmpty(productImage))
                                                {
                                                    <img src="@productImage" alt="@(currentCulture == "ar" && !string.IsNullOrEmpty(product.TitleAr) ? product.TitleAr : product.Title)" class="category-product-mini" />
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        // Fallback icon if no products available
                                        <div class="category-image-wrapper">
                                            <i class="bi bi-box-seam" style="font-size: 2.5rem; color: #667eea;"></i>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="category-label">@categoryName</div>
                        </div>
                    }
                </div>
            </div>
            <button class="carousel-nav next" onclick="scrollCategoryCarousel(1)" aria-label="Next categories">
                <i class="bi bi-chevron-right"></i>
            </button>
            
            <!-- Pagination Dots for Mobile -->
            <div class="category-carousel-dots" id="categoryCarouselDots">
                @for (int i = 0; i < displayCategories.Count; i++)
                {
                    <button class="carousel-dot @(i == 0 ? "active" : "")" 
                            data-index="@i" 
                            onclick="scrollToCategoryIndex(@i)"
                            aria-label="Go to category @(i + 1)"></button>
                }
            </div>
        </div>
    </section>
    
    <script>
    (function() {
        // Category carousel swipe functionality
        const carousel = document.getElementById('categoryCarousel');
        const dotsContainer = document.getElementById('categoryCarouselDots');
        const totalCategories = @displayCategories.Count;
        let currentIndex = 0;
        let touchStartX = 0;
        let touchEndX = 0;
        let touchStartY = 0;
        let touchEndY = 0;
        let isSwiping = false;
        const isRtl = document.documentElement.dir === 'rtl';
        
        if (!carousel) return;
        
        // Get card width for scrolling
        function getCardWidth() {
            const card = carousel.querySelector('.category-card');
            if (!card) return 300;
            return card.offsetWidth + parseFloat(getComputedStyle(carousel).gap || 20);
        }
        
        // Update active dot
        function updateDots(index) {
            if (!dotsContainer) return;
            const dots = dotsContainer.querySelectorAll('.carousel-dot');
            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === index);
            });
        }
        
        // Scroll to specific category index
        window.scrollToCategoryIndex = function(index) {
            if (index < 0) index = 0;
            if (index >= totalCategories) index = totalCategories - 1;
            
            currentIndex = index;
            const cardWidth = getCardWidth();
            const scrollPosition = cardWidth * index;
            
            carousel.scrollTo({
                left: isRtl ? -scrollPosition : scrollPosition,
                behavior: 'smooth'
            });
            
            updateDots(index);
        };
        
        // Scroll carousel by direction (-1 = prev, 1 = next)
        window.scrollCategoryCarousel = function(direction) {
            const newIndex = currentIndex + direction;
            if (newIndex >= 0 && newIndex < totalCategories) {
                scrollToCategoryIndex(newIndex);
            }
        };
        
        // Touch event handlers for swipe
        carousel.addEventListener('touchstart', function(e) {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
            isSwiping = true;
        }, { passive: true });
        
        carousel.addEventListener('touchmove', function(e) {
            if (!isSwiping) return;
            
            const diffX = Math.abs(e.changedTouches[0].screenX - touchStartX);
            const diffY = Math.abs(e.changedTouches[0].screenY - touchStartY);
            
            // If horizontal swipe is more than vertical, prevent page scroll
            if (diffX > diffY && diffX > 10) {
                e.preventDefault();
            }
        }, { passive: false });
        
        carousel.addEventListener('touchend', function(e) {
            if (!isSwiping) return;
            isSwiping = false;
            
            touchEndX = e.changedTouches[0].screenX;
            touchEndY = e.changedTouches[0].screenY;
            
            const diffX = touchStartX - touchEndX;
            const diffY = Math.abs(touchStartY - touchEndY);
            const minSwipeDistance = 50;
            
            // Only trigger if horizontal swipe is more than vertical
            if (Math.abs(diffX) > minSwipeDistance && Math.abs(diffX) > diffY) {
                if (isRtl) {
                    // RTL: swipe left = prev, swipe right = next
                    if (diffX > 0) {
                        scrollCategoryCarousel(-1);
                    } else {
                        scrollCategoryCarousel(1);
                    }
                } else {
                    // LTR: swipe left = next, swipe right = prev
                    if (diffX > 0) {
                        scrollCategoryCarousel(1);
                    } else {
                        scrollCategoryCarousel(-1);
                    }
                }
            }
        }, { passive: true });
        
        // Update current index based on scroll position
        carousel.addEventListener('scroll', function() {
            const cardWidth = getCardWidth();
            const scrollPos = isRtl ? Math.abs(carousel.scrollLeft) : carousel.scrollLeft;
            const newIndex = Math.round(scrollPos / cardWidth);
            
            if (newIndex !== currentIndex && newIndex >= 0 && newIndex < totalCategories) {
                currentIndex = newIndex;
                updateDots(currentIndex);
            }
        }, { passive: true });
        
        // Mouse drag support for desktop
        let isMouseDown = false;
        let startX = 0;
        let scrollLeft = 0;
        
        carousel.addEventListener('mousedown', function(e) {
            isMouseDown = true;
            carousel.classList.add('grabbing');
            startX = e.pageX - carousel.offsetLeft;
            scrollLeft = carousel.scrollLeft;
        });
        
        carousel.addEventListener('mouseleave', function() {
            isMouseDown = false;
            carousel.classList.remove('grabbing');
        });
        
        carousel.addEventListener('mouseup', function() {
            isMouseDown = false;
            carousel.classList.remove('grabbing');
            
            // Snap to nearest card
            const cardWidth = getCardWidth();
            const scrollPos = isRtl ? Math.abs(carousel.scrollLeft) : carousel.scrollLeft;
            const newIndex = Math.round(scrollPos / cardWidth);
            scrollToCategoryIndex(newIndex);
        });
        
        carousel.addEventListener('mousemove', function(e) {
            if (!isMouseDown) return;
            e.preventDefault();
            const x = e.pageX - carousel.offsetLeft;
            const walk = (x - startX) * 1.5;
            carousel.scrollLeft = scrollLeft - walk;
        });
    })();
    </script>
}

