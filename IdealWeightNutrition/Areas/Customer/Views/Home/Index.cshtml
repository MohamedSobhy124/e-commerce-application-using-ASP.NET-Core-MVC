        : "ideal weight nutrition, ideal weight nutrition UAE, ideal weight nutrition Dubai, ideal weight nutrition Abu Dhabi, ideal weight, ideal weight UAE, ideal weight Dubai, ideal weight solutions, ideal weight program, ideal weight supplements, ideal weight products, nutrition, nutrition supplements, nutrition products, nutrition store, nutrition store UAE, nutrition store Dubai, nutrition advice, nutrition expert, nutrition program, nutrition plan, nutrition supplements UAE, nutrition supplements Dubai, nutrition supplements online, supplements, supplements UAE, supplements Dubai, supplements Abu Dhabi, supplements online, buy supplements, protein supplements, protein UAE, protein Dubai, vitamins, vitamins UAE, vitamins Dubai, diet supplements, weight loss products, fitness nutrition, health supplements, nutrition store, free delivery UAE, Dubai delivery, Abu Dhabi delivery, buy supplements online, diet products, sports nutrition, weight management, weight loss, ideal weight program, nutrition advice, nutrition products, health products UAE, nutrition consultation, nutrition expert UAE";
    ViewData["Image"] = baseUrl + "/Images/Products/logo_white_bg.png";
    
    // Preload LCP image (video banner poster or first product image)
    var lcpImageUrl = "";
    if (ViewBag.HasPoster == true)
    {
        lcpImageUrl = baseUrl + $"/images/video-banner-poster.jpg?v={ViewBag.PosterVersion}";
    }
    ViewBag.LcpImageUrl = lcpImageUrl;
    
    var categories = ViewBag.Categories as IEnumerable<IdealWeightNutrition.Models.Categry> ?? Enumerable.Empty<IdealWeightNutrition.Models.Categry>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
    var selectedBrand = ViewBag.SelectedBrand as int?;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "";
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
    var inStock = ViewBag.InStock as bool?;
    var availability = ViewBag.Availability as string ?? "";
    var productFilter = ViewBag.ProductFilter as string ?? "";
    var minPriceRange = ViewBag.MinPriceRange as decimal? ?? 0;
    var maxPriceRange = ViewBag.MaxPriceRange as decimal? ?? 10000;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var brands = ViewBag.Brands as IEnumerable<IdealWeightNutrition.Models.Brand> ?? Enumerable.Empty<IdealWeightNutrition.Models.Brand>();
