        // Function to get current filter parameters
        function getFilterParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const params = new URLSearchParams();
            
            if (urlParams.get('categoryId')) params.append('categoryId', urlParams.get('categoryId'));
            if (urlParams.get('searchTerm')) params.append('searchTerm', urlParams.get('searchTerm'));
            if (urlParams.get('sortBy')) params.append('sortBy', urlParams.get('sortBy'));
            if (urlParams.get('minPrice')) params.append('minPrice', urlParams.get('minPrice'));
            if (urlParams.get('maxPrice')) params.append('maxPrice', urlParams.get('maxPrice'));
            if (urlParams.get('inStock')) params.append('inStock', urlParams.get('inStock'));
            if (urlParams.get('availability')) params.append('availability', urlParams.get('availability'));
            if (urlParams.get('productFilter')) params.append('productFilter', urlParams.get('productFilter'));
            
            return params.toString();
        }

        // Function to load products with filters via AJAX (no page refresh)
        // Now uses the unified GetPaginatedProducts endpoint!
        function loadProductsWithFilters(filters = {}, scrollToProducts = true, updateUrl = false) {
            // Prevent multiple simultaneous calls
            if (window.isLoadingProducts) {
                return;
            }
            window.isLoadingProducts = true;
            
            // Store current filters for pagination to use
            window.currentFilters = filters;

            const productContainer = document.getElementById('productContainer');
            const paginationContainer = document.getElementById('paginationContainer');
            
            if (!productContainer) {
                console.error('Product container not found');
                window.isLoadingProducts = false;
                return;
            }

            // Show loading state (same as pagination)
            productContainer.classList.add('pagination-loading');
            if (paginationContainer) {
                paginationContainer.classList.add('pagination-loading');
            }

            // Build filter parameters
            const params = new URLSearchParams();
            if (filters.categoryId) params.append('categoryId', filters.categoryId);
            if (filters.brandId) params.append('brandId', filters.brandId);
            if (filters.searchTerm) params.append('searchTerm', filters.searchTerm);
            if (filters.sortBy) params.append('sortBy', filters.sortBy);
            if (filters.minPrice) params.append('minPrice', filters.minPrice);
            if (filters.maxPrice) params.append('maxPrice', filters.maxPrice);
            if (filters.inStock !== undefined) params.append('inStock', filters.inStock);
            if (filters.availability) params.append('availability', filters.availability);
            if (filters.productFilter) params.append('productFilter', filters.productFilter);

            // Update active category in category carousel
            if (filters.categoryId) {
                // Remove active class from all category cards
                document.querySelectorAll('.category-card').forEach(card => {
                    card.classList.remove('active');
                });
                // Add active class to selected category
                const activeCard = document.querySelector(`.category-card[data-category-id="${filters.categoryId}"]`);
                if (activeCard) {
                    activeCard.classList.add('active');
                }
            } else {
                // Remove active class from all if no category selected
                document.querySelectorAll('.category-card').forEach(card => {
                    card.classList.remove('active');
                });
                // Set "All Categories" as active when no category is selected
                const allCategoriesCard = document.querySelector('.category-card[data-category-id="0"]');
                if (allCategoriesCard) {
                    allCategoriesCard.classList.add('active');
                }
            }

            // Add pagination params
            params.append('page', 1); // Always start at page 1 for filters
            params.append('pageSize', paginationState.pageSize);
            
            // Use the same GetPaginatedProducts endpoint (unified endpoint for all!)
            const url = `/Customer/Home/GetPaginatedProducts?${params.toString()}`;

            // DON'T update URL - keep it clean!

            // Fetch filtered products
            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    window.isLoadingProducts = false;
                    
                    // Clear container
                    productContainer.innerHTML = '';

                    if (!data.products || data.products.length === 0) {
                        productContainer.innerHTML = `
                            <div class="text-center py-5" style="grid-column: 1 / -1;">
                                <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                <p class="mt-3 text-muted">@Localizer["NoProductsFound"]</p>
                            </div>
                        `;
                        // Hide pagination if no products
                        if (paginationContainer) {
                            paginationContainer.style.display = 'none';
                        }
                        return;
                    }

                    // Render products using createProductCardFromData (same as pagination)
                    data.products.forEach((product, index) => {
                        const productHtml = createProductCardFromData(product);
                        productContainer.insertAdjacentHTML('beforeend', productHtml);
                    });

                    // Animate products with stagger effect
                    const productCards = productContainer.querySelectorAll('.product-card.stagger-item');
                    productCards.forEach((card, index) => {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            card.classList.add('visible');
                            card.style.opacity = '';
                            card.style.transform = '';
                        }, index * 50);
                    });

                    // Load ratings for products
                    if (typeof loadAllProductRatings === 'function') {
                        setTimeout(() => loadAllProductRatings(), 500);
                    }

                    // Update pagination state from response
                    paginationState.currentPage = data.currentPage || 1;
                    paginationState.totalPages = data.totalPages || 1;
                    paginationState.totalProducts = data.totalProducts || 0;

                    // Update/Show pagination UI
                    if (data.totalPages > 1) {
                        updatePaginationUI(data);
                        if (paginationContainer) {
                            paginationContainer.style.display = 'block';
                        }
                    } else {
                        // Hide pagination if only 1 page
                        if (paginationContainer) {
                            paginationContainer.style.display = 'none';
                        }
                    }

                    // Scroll to products section if requested
                    if (scrollToProducts) {
                        const productsSection = document.getElementById('productsSection');
                        if (productsSection) {
                            const headerOffset = 100;
                            const elementPosition = productsSection.getBoundingClientRect().top;
                            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                            
                            window.scrollTo({
                                top: offsetPosition,
                                behavior: 'smooth'
                            });
                        }
                    }

                    // Update filter form inputs to match current filters
                    if (filters.categoryId) {
                        const categoryInput = document.querySelector('select[name="categoryId"]');
                        if (categoryInput) categoryInput.value = filters.categoryId;
                    }
                    
                    if (filters.brandId) {
                        const brandInput = document.querySelector('select[name="brandId"]');
                        if (brandInput) brandInput.value = filters.brandId;
                    }
                    
                })
                .catch(error => {
                    window.isLoadingProducts = false;
                    console.error('Error loading products:', error);
                    productContainer.innerHTML = `
                        <div class="text-center py-5" style="grid-column: 1 / -1;">
                            <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
                            <p class="mt-3 text-danger">@Localizer["ErrorLoadingProducts"]</p>
                            <button class="btn btn-primary mt-3" onclick="loadProductsWithFilters({})">@Localizer["Retry"]</button>
                        </div>
                    `;
                })
                .finally(() => {
                    productContainer.classList.remove('pagination-loading');
                    if (paginationContainer) {
                        paginationContainer.classList.remove('pagination-loading');
                    }
                });
        }

        // Prevent duplicate clicks within short time window
        let lastCategoryClickTime = 0;
        let lastCategoryId = null;
        
        // Direct onclick handler for category cards (bypasses Bootstrap interference)
        window.handleCategoryCardClickDirect = function(categoryCard, event) {
            if (!categoryCard || !categoryCard.hasAttribute('data-category-id')) {
                return false;
            }
            
            // Always prevent default and stop propagation to prevent Bootstrap carousel from handling it
            if (event) {
                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();
            }
            
            return handleCategoryCardClick(categoryCard, event);
        };
        
        // Event delegation for category card clicks (handles dynamically reorganized carousel items)
        window.handleCategoryCardClick = function(categoryCard, event) {
            if (!categoryCard || !categoryCard.hasAttribute('data-category-id')) {
                return false;
            }
            
            // Always prevent default and stop propagation to prevent Bootstrap carousel from handling it
            if (event) {
                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();
            }
            
            const categoryId = categoryCard.getAttribute('data-category-id');
            const categoryIdNum = parseInt(categoryId);
            
            if (isNaN(categoryIdNum)) {
                return false;
            }
            
            // Prevent duplicate clicks within 300ms (debounce)
            const now = Date.now();
            if (now - lastCategoryClickTime < 300 && lastCategoryId === categoryIdNum) {
                return false;
            }
            lastCategoryClickTime = now;
            lastCategoryId = categoryIdNum;
            
            // Remove active class from all category cards
            document.querySelectorAll('.category-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to clicked card
            categoryCard.classList.add('active');
            
            // Load products with category filter via AJAX (without URL update)
            if (typeof loadProductsWithFilters === 'function') {
                // If categoryId is 0, it means "All Categories" - clear the category filter
                if (categoryIdNum === 0) {
                    loadProductsWithFilters({}, true, false);
                } else {
                    loadProductsWithFilters({ categoryId: categoryIdNum }, true, false);
                }
            } else {
                // Fallback to page navigation if function doesn't exist
                if (categoryIdNum === 0) {
                    window.location.href = '@Url.Action("Index", "Home", new { area = "Customer" })';
                } else {
                    window.location.href = `@Url.Action("Index", "Home", new { area = "Customer" })?categoryId=${categoryIdNum}`;
                }
            }
            
            // Scroll to products section smoothly (if function exists)
            if (typeof scrollToProductsSection === 'function') {
                setTimeout(scrollToProductsSection, 100);
            }
            
            return false;
        }
        
        // Initialize category card click handlers after DOM is ready
        function initializeCategoryCardHandlers() {
            // Get all category cards in the carousel
            const categoryCards = document.querySelectorAll('#categoryCarousel .category-card[data-category-id]');
            
            // Disable pointer events on carousel inner to prevent Bootstrap from intercepting
            const carouselInner = document.querySelector('#categoryCarousel .carousel-inner');
            if (carouselInner) {
                // Keep pointer events enabled, but prevent Bootstrap from handling category card clicks
                const carouselElement = document.getElementById('categoryCarousel');
                if (carouselElement && typeof bootstrap !== 'undefined') {
                    const carouselInstance = bootstrap.Carousel.getInstance(carouselElement);
                    if (carouselInstance) {
                        // Pause carousel to prevent auto-cycling from interfering
                        carouselInstance.pause();
                    }
                }
            }
            
            // Attach click handlers directly to each category card AND their parent containers
            categoryCards.forEach(function(card) {
                // Skip if already has handler (check for a data attribute flag)
                if (card.dataset.hasClickHandler === 'true') {
                    return;
                }
                
                // Mark as having handler
                card.dataset.hasClickHandler = 'true';
                
                // Add a specific class to identify clickable cards
                card.style.cursor = 'pointer';
                card.style.pointerEvents = 'auto';
                
                // Attach click handler with capture phase to catch before Bootstrap
                const clickHandler = function(e) {
                    // Stop propagation immediately to prevent Bootstrap from handling it
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    
                    // Only handle if not clicking on carousel navigation buttons or indicators
                    const isCarouselControl = e.target.closest('.carousel-control-prev') || 
                                             e.target.closest('.carousel-control-next') ||
                                             e.target.closest('.carousel-indicators') ||
                                             e.target.closest('button[data-bs-slide]') ||
                                             e.target.closest('button[data-bs-target="#categoryCarousel"]');
                    
                    if (!isCarouselControl) {
                        e.preventDefault();
                        handleCategoryCardClick(card, e);
                        return false;
                    }
                };
                
                card.addEventListener('click', clickHandler, true); // Capture phase
                
                // Also handle mouseup as a fallback (fires before click is processed by Bootstrap)
                card.addEventListener('mouseup', function(e) {
                    if (e.button === 0) { // Left mouse button only
                        const isCarouselControl = e.target.closest('.carousel-control-prev') || 
                                                 e.target.closest('.carousel-control-next') ||
                                                 e.target.closest('.carousel-indicators') ||
                                                 e.target.closest('button[data-bs-slide]') ||
                                                 e.target.closest('button[data-bs-target="#categoryCarousel"]');
                        
                        if (!isCarouselControl) {
                            e.stopPropagation();
                            e.preventDefault();
                            handleCategoryCardClick(card, e);
                            return false;
                        }
                    }
                }, true);
                
                // Also handle touch events for mobile devices (tap detection)
                let touchStartX = 0;
                let touchStartY = 0;
                let touchStartTime = 0;
                
                card.addEventListener('touchstart', function(e) {
                    touchStartX = e.touches[0].clientX;
                    touchStartY = e.touches[0].clientY;
                    touchStartTime = Date.now();
                }, { passive: true, capture: true });
                
                card.addEventListener('touchend', function(e) {
                    // Only handle if it's a tap (not a swipe) - check movement distance and time
                    const touchEndX = e.changedTouches[0].clientX;
                    const touchEndY = e.changedTouches[0].clientY;
                    const touchDuration = Date.now() - touchStartTime;
                    const deltaX = Math.abs(touchEndX - touchStartX);
                    const deltaY = Math.abs(touchEndY - touchStartY);
                    const isTap = deltaX < 10 && deltaY < 10 && touchDuration < 300; // Max 10px movement, max 300ms
                    
                    // Only handle if not touching on carousel navigation buttons or indicators
                    const isCarouselControl = e.target.closest('.carousel-control-prev') || 
                                             e.target.closest('.carousel-control-next') ||
                                             e.target.closest('.carousel-indicators') ||
                                             e.target.closest('button[data-bs-slide]') ||
                                             e.target.closest('button[data-bs-target="#categoryCarousel"]');
                    
                    if (!isCarouselControl && isTap) {
                        // Prevent default touch behavior and trigger click handler
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        handleCategoryCardClick(card, e);
                        return false;
                    }
                }, { passive: false, capture: true });
                
                // Attach keyboard handler for accessibility
                card.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        e.stopPropagation();
                        handleCategoryCardClick(card, e);
                        return false;
                    }
                }, true);
            });
            
            // Also attach to parent row/container to catch any missed clicks
            const carouselRows = document.querySelectorAll('#categoryCarousel .carousel-item .row');
            carouselRows.forEach(function(row) {
                row.addEventListener('click', function(e) {
                    const categoryCard = e.target.closest('.category-card[data-category-id]');
                    if (categoryCard) {
                        const isCarouselControl = e.target.closest('.carousel-control-prev') || 
                                                 e.target.closest('.carousel-control-next') ||
                                                 e.target.closest('.carousel-indicators') ||
                                                 e.target.closest('button[data-bs-slide]') ||
                                                 e.target.closest('button[data-bs-target="#categoryCarousel"]');
                        
                        if (!isCarouselControl) {
                            e.stopPropagation();
                            e.preventDefault();
                            handleCategoryCardClick(categoryCard, e);
                            return false;
                        }
                    }
                }, true);
            });
        }
        
        // Initialize when DOM is ready - use MutationObserver to handle dynamic content
        function setupCategoryCardHandlers() {
            initializeCategoryCardHandlers();
            
            // Also watch for any dynamically added category cards
            const observer = new MutationObserver(function(mutations) {
                const hasNewCards = Array.from(mutations).some(mutation => 
                    Array.from(mutation.addedNodes || []).some(node => 
                        node.nodeType === 1 && (
                            node.classList?.contains('category-card') ||
                            node.querySelector?.('.category-card[data-category-id]')
                        )
                    )
                );
                
                if (hasNewCards) {
                    setTimeout(initializeCategoryCardHandlers, 50);
                }
            });
            
            const carouselContainer = document.getElementById('categoryCarouselContainer');
            if (carouselContainer) {
                observer.observe(carouselContainer, { childList: true, subtree: true });
            }
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                // Wait a bit for Bootstrap carousel to initialize, then attach our handlers
                setTimeout(setupCategoryCardHandlers, 200);
            });
        } else {
            // DOM already loaded, wait for Bootstrap
            setTimeout(setupCategoryCardHandlers, 200);
        }
        
        // Also use event delegation as primary handler (catches all clicks including nested elements)
        // This runs FIRST in capture phase to intercept before Bootstrap
        document.addEventListener('click', function(e) {
            const categoryCard = e.target.closest('.category-card[data-category-id]');
            if (categoryCard) {
                // Only handle if not clicking on carousel navigation buttons or indicators
                const isCarouselControl = e.target.closest('.carousel-control-prev') || 
                                         e.target.closest('.carousel-control-next') ||
                                         e.target.closest('.carousel-indicators') ||
                                         e.target.closest('button[data-bs-slide]') ||
                                         e.target.closest('button[data-bs-target="#categoryCarousel"]');
                
                if (!isCarouselControl) {
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    handleCategoryCardClick(categoryCard, e);
                    return false;
                }
            }
        }, true); // Use capture phase to catch early, before Bootstrap
        
        // Handle keyboard (Enter/Space) for accessibility
        document.addEventListener('keydown', function(e) {
            const categoryCard = e.target.closest('.category-card[data-category-id]');
            if (categoryCard && categoryCard.hasAttribute('data-category-id')) {
                if (e.key === 'Enter' || e.key === ' ') {
                    handleCategoryCardClick(categoryCard, e);
                    return false;
                }
            }
        }, true); // Use capture phase

        // Function to scroll to products section smoothly
        function scrollToProductsSection() {
            const productsSection = document.getElementById('productsSection');
            if (productsSection) {
                const headerOffset = 100; // Account for fixed header
                const elementPosition = productsSection.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }
        }

        // LoadMoreProducts function removed - now using pagination instead!

        // checkAndShowLoadMoreButton function removed - using pagination instead!

        // Save scroll position when clicking on any link (like Details button)
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href) {
                saveScrollPosition();
            }
