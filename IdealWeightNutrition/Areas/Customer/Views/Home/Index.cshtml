<!-- Sticky Hero Search Box Header - At Top -->
<header class="hero-search-box-sticky" id="heroSearchBoxSticky">
    <div class="container">
        <!-- App Logo -->
        <a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="sticky-header-logo">
            <img src="~/Images/Products/Logo2-removebg.png" alt="Ideal Weight Nutrition" class="logo-img" width="120" height="40" loading="eager" />
        </a>
        
        <!-- Desktop & Mobile Search Box -->
        <div class="hero-search-box" id="heroSearchBox">
            <form id="heroSearchForm" onsubmit="return false;" style="width:90%;">
                <div class="advanced-search-container" id="advancedSearchContainer">
                    <!-- Mobile Back Button (shown when search is focused) -->
                    <button type="button" 
                            class="mobile-search-back-btn" 
                            id="mobileSearchBackBtn"
                            aria-label="Back to menu"
                            style="display: none;">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    
                    <div class="search-input-wrapper">
                        <input type="text" 
                               name="searchTerm" 
                               id="heroSearchInput"
                               value="@searchTerm" 
                               class="hero-search-input" 
                               placeholder="@Localizer["SearchSupplements"]"
                               autocomplete="off" />
                        <button type="button" 
                                class="search-clear-btn" 
                                id="searchClearBtn" 
                                aria-label="Clear search"
                                style="display: @(string.IsNullOrEmpty(searchTerm) ? "none" : "block");">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <button type="submit" class="hero-search-btn magnetic-btn ripple">
                        <span class="search-btn-text">@Localizer["Search"]</span>
                        <i class="bi bi-search search-btn-icon"></i>
                    </button>
                </div>
            </form>
        </div>
        
        <!-- Header Actions: Cart, Wishlist, Filter -->
        <div class="hero-header-actions" id="heroHeaderActions">
            <!-- Cart Icon -->
            <button type="button"
               class="header-action-btn cart-action-btn" 
               title="@Localizer["ShoppingCart"]"
               id="headerCartBtn"
               onclick="openCartSidebar(true); return false;">
                <i class="bi bi-cart3"></i>
                <span class="action-badge" id="headerCartBadge" style="display: none;">0</span>
            </button>
            
            <!-- Wishlist Icon (Only for authenticated users) -->
            @if (User.Identity.IsAuthenticated)
            {
                <button type="button" 
                        class="header-action-btn wishlist-action-btn" 
                        onclick="openWishlistSidebar()"
                        title="@Localizer["Wishlist"]"
                        id="headerWishlistBtn">
                    <i class="bi bi-heart"></i>
                    <span class="action-badge" id="headerWishlistBadge" style="display: none;">0</span>
                </button>
            }
            
            <!-- Filter Button -->
            <button type="button" 
                    class="header-action-btn filter-action-btn modern-filter-toggle-header-btn" 
                    id="modernFilterToggleBtn" 
                    aria-label="Toggle filters"
                    style="width: fit-content;"
                    title="@Localizer["Filters"]">
                <i class="bi bi-funnel-fill"></i>
                <span class="filter-btn-text">@Localizer["Filters"]</span>
            </button>
        </div>
    </div>
</header>


