    <!-- Category Carousel -->
    @{
        var categoryProductsMap = ViewBag.CategoryProductsMap as Dictionary<int, List<Product>> ?? new Dictionary<int, List<Product>>();
        var displayCategories = categories.ToList();
    }
    
    <!-- Define category click handler BEFORE the carousel HTML -->
    <script>
        // Define function immediately so it's available for onclick handlers
        window.handleCategoryCardClickDirect = function(categoryCard, event) {
            
            if (!categoryCard) {
                console.error('Category card is null or undefined');
                return false;
            }
            
            if (!categoryCard.hasAttribute('data-category-id')) {
                console.error('Category card missing data-category-id attribute');
                return false;
            }
            
            // Always prevent default and stop propagation
            if (event) {
                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();
            }
            
            const categoryId = categoryCard.getAttribute('data-category-id');
            const categoryIdNum = parseInt(categoryId);
            
            
            if (isNaN(categoryIdNum)) {
                console.error('Invalid category ID:', categoryId);
                return false;
            }
            
            // Remove active class from all category cards
            document.querySelectorAll('.category-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to clicked card
            categoryCard.classList.add('active');
            
            
            const productContainer = document.getElementById('productContainer');
            const paginationContainer = document.getElementById('paginationContainer');
            
            if (!productContainer) {
                console.error('Product container not found');
                return false;
            }
            
            // Show loading state
            productContainer.classList.add('pagination-loading');
            if (paginationContainer) {
                paginationContainer.classList.add('pagination-loading');
            }
            
            // Build URL with category filter
            const params = new URLSearchParams();
            if (categoryIdNum > 0) {
                params.append('categoryId', categoryIdNum);
            }
            params.append('page', '1');
            
            // Get pageSize - check if paginationState exists
            const pageSize = (typeof paginationState !== 'undefined' && paginationState && paginationState.pageSize) 
                ? paginationState.pageSize 
                : 20;
            params.append('pageSize', pageSize);
            
            const url = `/Customer/Home/GetPaginatedProducts?${params.toString()}`;
            
            
            // Make AJAX call directly
            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    
                    // Clear container
                    productContainer.innerHTML = '';
                    
                    if (!data.products || data.products.length === 0) {
                        productContainer.innerHTML = `
                            <div class="text-center py-5" style="grid-column: 1 / -1;">
                                <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                <p class="mt-3 text-muted">@Localizer["NoProductsFound"]</p>
                            </div>
                        `;
                        if (paginationContainer) {
                            paginationContainer.style.display = 'none';
                        }
                    } else {
                        // Render products directly using createProductCardFromData
                        // Wait for createProductCardFromData if not available yet
                        function renderProducts() {
                            if (typeof createProductCardFromData === 'function') {
                                // Use direct rendering
                                data.products.forEach((product, index) => {
                                    const productHtml = createProductCardFromData(product);
                                    productContainer.insertAdjacentHTML('beforeend', productHtml);
                                });
                                
                                // Animate products
                                setTimeout(() => {
                                    const productCards = productContainer.querySelectorAll('.product-card.stagger-item');
                                    productCards.forEach((card, index) => {
                                        card.style.opacity = '0';
                                        card.style.transform = 'translateY(20px)';
                                        setTimeout(() => {
                                            card.classList.add('visible');
                                            card.style.opacity = '';
                                            card.style.transform = '';
                                        }, index * 50);
                                    });
                                    
                                    // Load ratings if function available
                                    if (typeof loadAllProductRatings === 'function') {
                                        loadAllProductRatings();
                                    }
                                }, 100);
                                
                                // Update pagination if available
                                if (typeof paginationState !== 'undefined' && paginationState) {
                                    paginationState.currentPage = data.currentPage || 1;
                                    paginationState.totalPages = data.totalPages || 1;
                                    paginationState.totalProducts = data.totalProducts || 0;
                                    
                                    if (typeof updatePaginationUI === 'function' && data.totalPages > 1) {
                                        updatePaginationUI(data);
                                        if (paginationContainer) {
                                            paginationContainer.style.display = 'block';
                                        }
                                    } else if (paginationContainer) {
                                        paginationContainer.style.display = data.totalPages > 1 ? 'block' : 'none';
                                    }
                                }
                            } else {
                                console.warn('createProductCardFromData not available yet, waiting...');
                                // Wait for createProductCardFromData to be available (up to 5 seconds)
                                let attempts = 0;
                                const maxAttempts = 50;
                                const waitInterval = setInterval(() => {
                                    attempts++;
                                    if (typeof createProductCardFromData === 'function') {
                                        clearInterval(waitInterval);
                                        renderProducts();
                                    } else if (attempts >= maxAttempts) {
                                        clearInterval(waitInterval);
                                        console.error('createProductCardFromData not available after 5 seconds');
                                    }
                                }, 100);
                            }
                        }
                        
                        renderProducts();
                    }
                    
                    // Scroll to products section
                    setTimeout(() => {
                        const productsSection = document.getElementById('productsSection');
                        if (productsSection) {
                            const headerOffset = 100;
                            const elementPosition = productsSection.getBoundingClientRect().top;
                            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                            
                            window.scrollTo({
                                top: offsetPosition,
                                behavior: 'smooth'
                            });
                        }
                    }, 300);
                })
                .catch(error => {
                    console.error('Error loading products:', error);
                    productContainer.innerHTML = `
                        <div class="text-center py-5" style="grid-column: 1 / -1;">
                            <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
                            <p class="mt-3 text-danger">@Localizer["ErrorLoadingProducts"]</p>
                            <button class="btn btn-primary mt-3" onclick="location.reload()">@Localizer["Retry"]</button>
                        </div>
                    `;
                })
                .finally(() => {
                    productContainer.classList.remove('pagination-loading');
                    if (paginationContainer) {
                        paginationContainer.classList.remove('pagination-loading');
                    }
                    if (typeof window !== 'undefined') {
                        window.isLoadingProducts = false;
                    }
                });
            
            return false;
        };
        
        
        // Also ensure loadProductsWithFilters is available on window load
        window.addEventListener('load', function() {
        });
        
        // Enhanced Mobile Swipe for Category Carousel
        function initCategoryCarouselSwipe() {
            const carousel = document.getElementById('categoryCarousel');
            const container = document.getElementById('categoryCarouselContainer');
            
            if (!carousel || !container) {
                // Wait a bit if elements not ready yet
                setTimeout(initCategoryCarouselSwipe, 100);
                return;
            }
            
            // Update scroll indicators (fade edges)
            function updateScrollIndicators() {
                const scrollLeft = carousel.scrollLeft;
                const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;
                
                // Remove existing classes
                container.classList.remove('scroll-start', 'scroll-end');
                
                // Add appropriate classes
                if (scrollLeft <= 10) {
                    container.classList.add('scroll-start');
                }
                if (scrollLeft >= maxScrollLeft - 10) {
                    container.classList.add('scroll-end');
                }
            }
            
            // Initial check
            updateScrollIndicators();
            
            // Update on scroll
            let scrollTimeout;
            carousel.addEventListener('scroll', function() {
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(updateScrollIndicators, 10);
            }, { passive: true });
            
            // Enhanced touch/swipe for mobile
            let touchStartX = 0;
            let touchStartY = 0;
            let touchStartTime = 0;
            let isScrolling = false;
            
            carousel.addEventListener('touchstart', function(e) {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
                touchStartTime = Date.now();
                isScrolling = false;
            }, { passive: true });
            
            carousel.addEventListener('touchmove', function(e) {
                if (!touchStartX) return;
                
                const touchX = e.touches[0].clientX;
                const touchY = e.touches[0].clientY;
                const deltaX = Math.abs(touchX - touchStartX);
                const deltaY = Math.abs(touchY - touchStartY);
                
                // If horizontal movement is greater than vertical, it's a swipe
                if (deltaX > deltaY && deltaX > 10) {
                    isScrolling = true;
                    // Prevent vertical scroll during horizontal swipe
                    if (deltaX > 20) {
                        e.preventDefault();
                    }
                }
            }, { passive: false });
            
            carousel.addEventListener('touchend', function(e) {
                if (!touchStartX || !isScrolling) {
                    touchStartX = 0;
                    return;
                }
                
                const touchEndX = e.changedTouches[0].clientX;
                const deltaX = touchEndX - touchStartX;
                const deltaTime = Date.now() - touchStartTime;
                
                // Snap to nearest card if significant swipe
                if (Math.abs(deltaX) > 30 || (Math.abs(deltaX) > 10 && deltaTime < 300)) {
                    const cardWidth = carousel.querySelector('.category-card')?.offsetWidth || 140;
                    const scrollAmount = Math.round(deltaX / cardWidth);
                    const currentScroll = carousel.scrollLeft;
                    const newScroll = currentScroll + (scrollAmount * cardWidth);
                    
                    carousel.scrollTo({
                        left: newScroll,
                        behavior: 'smooth'
                    });
                }
                
                touchStartX = 0;
                isScrolling = false;
            }, { passive: true });
            
            // Smooth scroll snap on resize
            window.addEventListener('resize', function() {
                updateScrollIndicators();
            }, { passive: true });
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCategoryCarouselSwipe);
        } else {
            initCategoryCarouselSwipe();
        }
    </script>
    
    @if (displayCategories.Any())
    {
        <section class="category-section">
            <div class="category-section-title">
                <h2>@Localizer["ShopByCategory"]</h2>
            </div>
            <div class="category-carousel-container" id="categoryCarouselContainer">
                <div id="categoryCarousel" class="carousel slide category-carousel" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover" data-bs-touch="false">
                    <div class="carousel-inner">
                    @{
                        var categoriesList = displayCategories.ToList();
                            
                            // Responsive items per slide: mobile=1, tablet=2, desktop=4
                            var itemsPerSlideMobile = 1;
                            var itemsPerSlideTablet = 2;
                            var itemsPerSlideDesktop = 4;
                            
                            // Calculate total slides for desktop (most slides) - add 1 for "All Categories"
                            var totalSlidesDesktop = (int)Math.Ceiling((categoriesList.Count + 1) / (double)itemsPerSlideDesktop);
                            
                            // First, render "All Categories" in the first slide
                            var firstSlideHasAllCategories = true;
                            var categoriesToShow = categoriesList.ToList();
                            
                            for (int slideIndex = 0; slideIndex < totalSlidesDesktop; slideIndex++)
                            {
                                var slideCategories = new List<IdealWeightNutrition.Models.Categry>();
                                
                                // First slide: add "All Categories" first, then regular categories
                                if (slideIndex == 0)
                                {
                                    // Add remaining categories for first slide (skip 1 slot for "All Categories")
                                    var remainingSlots = itemsPerSlideDesktop - 1;
                                    slideCategories = categoriesToShow.Take(remainingSlots).ToList();
                                }
                                else
                                {
                                    // For other slides, skip the "All Categories" slot
                                    var skipCount = (slideIndex * itemsPerSlideDesktop) - 1;
                                    slideCategories = categoriesToShow.Skip(skipCount).Take(itemsPerSlideDesktop).ToList();
                    }
                    
                                <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                                    <div class="row g-3 g-md-4">
                                        @if (slideIndex == 0)
                                        {
                                            // Render "All Categories" as first item in first slide
                                            <div class="col-12 col-sm-6 col-lg-3">
                    <div class="category-card @(selectedCategory == null ? "active" : "")"
                         data-category-id="0"
                         data-all-categories="true"
                         role="button"
                         tabindex="0"
                         onclick="window.handleCategoryCardClickDirect(this, event); return false;"
                                                     onmousedown="event.stopPropagation();"
                                                     ontouchstart="event.stopPropagation();"
                         style="cursor: pointer; position: relative; z-index: 10;"
                         onkeydown="if(event.key === 'Enter' || event.key === ' ') { window.handleCategoryCardClickDirect(this, event); return false; }">
                        <div class="category-circle">
                            <div class="category-image-wrapper">
                                <i class="bi bi-grid-3x3-gap-fill" style="font-size: 2rem; color: #3B9DD5;"></i>
                            </div>
                        </div>
                        <div class="category-label">@Localizer["AllCategories"]</div>
                    </div>
                                            </div>
                                        }
                    
                                        @foreach (var category in slideCategories)
                    {
                        if (category == null) continue;
                        
                        var categoryIndex = categoriesList.IndexOf(category);
                        var categoryProducts = categoryProductsMap.ContainsKey(category.Id) 
                            ? categoryProductsMap[category.Id] 
                            : new List<Product>();
                        var categoryName = currentCulture == "ar" && !string.IsNullOrEmpty(category.NameAr) 
                            ? category.NameAr 
                            : category.Name;
                        
                                            <div class="col-12 col-sm-6 col-lg-3">
                        <div class="category-card @(selectedCategory == category.Id ? "active" : "")"
                             data-category-index="@categoryIndex"
                             data-category-id="@category.Id"
                             role="button"
                             tabindex="0"
                             onclick="window.handleCategoryCardClickDirect(this, event); return false;"
                                                     onmousedown="event.stopPropagation();"
                                                     ontouchstart="event.stopPropagation();"
                             style="cursor: pointer; position: relative; z-index: 10;"
                             onkeydown="if(event.key === 'Enter' || event.key === ' ') { window.handleCategoryCardClickDirect(this, event); return false; }">
                            <div class="category-circle">
                                @if (!string.IsNullOrEmpty(category.ImageUrl))
                                {
                                    <div class="category-image-wrapper">
                                        <img src="@category.ImageUrl" alt="@categoryName" class="category-image" loading="lazy" width="200" height="200" />
                                    </div>
                                }
                                else
                                {
                                    var productsToShow = categoryProducts.ToList();
                                    if (!productsToShow.Any() && Model != null)
                                    {
                                        productsToShow = Model
                                            .Where(p => p.CategryId == category.Id)
                                            .Take(4)
                                            .ToList();
                                    }
                                    productsToShow = productsToShow.Take(4).ToList();
                                
                                    @if (productsToShow.Any())
                                    {
                                        <div class="category-products-grid">
                                            @foreach (var product in productsToShow)
                                            {
                                                var productImage = product.ProductImages?.FirstOrDefault(pi => pi.ImageInfo == null)?.ImageUrl 
                                                    ?? product.ProductImages?.FirstOrDefault()?.ImageUrl 
                                                    ?? product.ImageUrl;
                                                
                                                if (!string.IsNullOrEmpty(productImage))
                                                {
                                                    <img src="@productImage" alt="@(currentCulture == "ar" && !string.IsNullOrEmpty(product.TitleAr) ? product.TitleAr : product.Title)" class="category-product-mini" loading="lazy" width="100" height="100" />
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="category-image-wrapper">
                                            <i class="bi bi-box-seam" style="font-size: 2rem; color: #3B9DD5;"></i>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="category-label">@categoryName</div>
                        </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    
                    <!-- Carousel Controls -->
                    <button class="carousel-control-prev category-carousel-control carousel-nav prev" type="button" data-bs-target="#categoryCarousel" data-bs-slide="prev">
                        <i class="bi bi-chevron-left"></i>
                        <span class="visually-hidden">@Localizer["Previous"]</span>
                    </button>
                    <button class="carousel-control-next category-carousel-control carousel-nav next" type="button" data-bs-target="#categoryCarousel" data-bs-slide="next">
                        <i class="bi bi-chevron-right"></i>
                        <span class="visually-hidden">@Localizer["Next"]</span>
                    </button>
                    
                    <!-- Carousel Indicators -->
                    @if (totalSlidesDesktop > 1)
                    {
                        <div class="carousel-indicators category-carousel-indicators">
                            @for (int i = 0; i < totalSlidesDesktop; i++)
                            {
                                <button type="button" data-bs-target="#categoryCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    <!-- Product Grid - Modern Design -->
    <div class="modern-products-container" id="productsSection">
        
        
        <div class="modern-products-grid" id="productContainer">
@foreach (var Product in Model)
{
    var discount = Product.ListPrice > 0 ? (int)((Product.ListPrice - Product.Price) / Product.ListPrice * 100) : 0;
    var cartProductIds = ViewBag.CartProductIds as List<int> ?? new List<int>();
    var isInCart = cartProductIds.Contains(Product.Id);
    var wishlistProductIds = ViewBag.WishlistProductIds as List<int> ?? new List<int>();
    var isInWishlist = wishlistProductIds.Contains(Product.Id);
    var isAuthenticated = User.Identity.IsAuthenticated;
    
    <div class="product-card stagger-item visible" 
         data-stock-quantity="@Product.StockQuantity" 
         data-minimum-stock="@Product.MinimumStockAlert"
         data-product-id="@Product.Id"
         onclick="window.location.href='@Url.Action("Details", "Home", new { slug = Product.GetSlug() })'"
         style="cursor: pointer;">
        <!-- Product Image Carousel -->
        <div class="product-image-wrapper">
            <!-- Product Status Badges (NEW/TRENDING) -->
            @if (Product.IsTrending)
            {
                <div class="badge-trending">
                    <i class="bi bi-graph-up-arrow me-1"></i>
                    @Localizer["TrendingProducts"]
                </div>
            }
            else if (Product.IsNew)
            {
                <div class="badge-new">
                    <i class="bi bi-sparkles me-1"></i>
                    @Localizer["NewProducts"]
                </div>
            }
            
            @if (isAuthenticated)
            {
                <!-- Wishlist Button (Only for logged-in users) -->
                <button class="wishlist-btn @(isInWishlist ? "active" : "")" 
                        data-product-id="@Product.Id" 
                        onclick="toggleWishlist(@Product.Id, this); event.stopPropagation();"
                        title="@(isInWishlist ? "Remove from wishlist" : "Add to wishlist")">
                    <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            }
            @{
                var productImages = Product.ProductImages != null && Product.ProductImages.Any() 
                    ? Product.ProductImages.OrderBy(pi => pi.DisplayOrder).Select(pi => pi.ImageUrl).ToList()
                    : new List<string>();
                
                // If no ProductImages but has ImageUrl, use that
                if (!productImages.Any() && !string.IsNullOrEmpty(Product.ImageUrl))
                {
                    productImages.Add(Product.ImageUrl);
                }
            }
            
            @if (productImages.Count > 1)
            {
                <div id="productCarousel_@Product.Id" class="carousel slide product-image-carousel" data-bs-ride="carousel" data-bs-touch="true">
                    <div class="carousel-inner">
                        @for (int i = 0; i < productImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@productImages[i]" class="product-image" alt="@Product.Title - Image @(i+1)" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Previous"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Next"]</span>
                    </button>
                    <div class="carousel-indicators">
                        @for (int i = 0; i < productImages.Count; i++)
                        {
                            <button type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)"></button>
                        }
                    </div>
                </div>
            }
            else if (productImages.Count == 1)
            {
                <img src="@productImages[0]" class="product-image" alt="@Product.Title" />
            }
            else
            {
            <img src="@Product.ImageUrl" class="product-image" alt="@(currentCulture == "ar" && !string.IsNullOrEmpty(Product.TitleAr) ? Product.TitleAr : Product.Title)" />
            }
        </div>
        
        <!-- Product Info -->
        <div class="product-content">
            <h3 class="product-title">@(currentCulture == "ar" && !string.IsNullOrEmpty(Product.TitleAr) ? Product.TitleAr : Product.Title)</h3>
            
            <!-- Star Rating with Discount -->
            <div class="product-card-rating" data-product-id="@Product.Id">
                <div class="product-card-stars">
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                </div>
                <span class="product-card-rating-text">(0)</span>
                @if (discount > 0)
                {
                    <span class="discount-badge-rating">@discount% @(currentCulture == "ar" ? "خصم" : "OFF")</span>
                }
            </div>
            
            <!-- Price and Actions - Same Line -->
            <div class="price-actions-row" onclick="event.stopPropagation();">
                @{
                    var minPrices = ViewBag.MinPrices as Dictionary<int, double> ?? new Dictionary<int, double>();
                    var showPriceFlags = ViewBag.ShowPriceFlags as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                    var allVariantsOutOfStockFlags = ViewBag.AllVariantsOutOfStockFlags as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                    var shouldShowPrice = showPriceFlags.ContainsKey(Product.Id) ? showPriceFlags[Product.Id] : (Product.StockQuantity > 0);
                    var allVariantsOutOfStock = allVariantsOutOfStockFlags.ContainsKey(Product.Id) && allVariantsOutOfStockFlags[Product.Id];
                    var hasVariants = Product.ProductType == IdealWeightNutrition.Models.ProductType.Variable && minPrices.ContainsKey(Product.Id);
                    // Use flash sale price from minPrices if available, otherwise use regular price
                    var displayPrice = minPrices.ContainsKey(Product.Id) ? minPrices[Product.Id] : Product.Price;
                    var pricePrefix = hasVariants ? (currentCulture == "ar" ? "من " : "From ") : "";
                }
                @if (shouldShowPrice)
                {
                    <div class="price-wrapper">
                        <span class="current-price">
                            @if (hasVariants)
                            {
                                <span class="price-from-text">@pricePrefix</span>
                            }
                            @Html.Raw(currencySymbol) @displayPrice.ToString("N2")
                        </span>
                    </div>
                }
                else if (allVariantsOutOfStock)
                {
                    <div class="price-wrapper">
                        <span class="text-muted" style="font-size: 0.9rem;">
                            @Localizer["OutOfStock"]
                        </span>
                    </div>
                }
                <div class="product-actions">
                    @if (Product.ProductType == IdealWeightNutrition.Models.ProductType.Variable)
                    {
                        <a asp-action="Details" asp-route-slug="@Product.GetSlug()" class="btn-select-options">
                            <i class="bi bi-list-check"></i>
                            <span class="btn-select-options-text">@Localizer["SelectOptions"]</span>
                        </a>
                    }
                    else if (!shouldShowPrice && allVariantsOutOfStock)
                    {
                        <!-- Product out of stock - no add to cart button -->
                    }
                    else
                    {
                        <button class="btn-add-cart-quick @(isInCart ? "in-cart" : "")" 
                                data-product-id="@Product.Id"
                                onclick="toggleCart(@Product.Id, this); event.stopPropagation();" 
                                title="@(isInCart ? "In Cart" : "Add to Cart")">
                            <i class="bi @(isInCart ? "bi-check-lg" : "bi-cart-plus")"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
    </div>
</div>

<!-- Modern Pagination -->
@if ((ViewBag.TotalPages ?? 0) > 1)
{
    <div class="modern-pagination-container" id="paginationContainer" data-pagination="true">
        <div class="pagination-wrapper">
            <!-- Page Info -->
            <div class="pagination-info">
                <span class="page-info-text">
                    @if(currentCulture == "ar") {
                        <text>صفحة @ViewBag.CurrentPage من @ViewBag.TotalPages</text>
                    } else {
                        <text>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</text>
                    }
                </span>
                <span class="total-products-info">
                    @if(currentCulture == "ar") {
                        <text>(@ViewBag.TotalProducts منتج)</text>
                    } else {
                        <text>(@ViewBag.TotalProducts products)</text>
                    }
                </span>
            </div>

            <!-- Pagination Controls -->
            <nav aria-label="Product pagination" class="pagination-nav">
                <ul class="pagination-list">
                    @{
                        // Build base URL for pagination
                        var currentPathForPagination = Context.Request.Path.Value ?? "/Customer/Home";
                        var queryParams = new Dictionary<string, string>();
                        foreach (var param in Context.Request.Query)
                        {
                            if (param.Key != "page" && param.Key != "culture") // Exclude page and culture as we'll add them separately
                            {
                                queryParams[param.Key] = param.Value.ToString();
                            }
                        }
                        var cultureParam = currentCulture == "ar" ? "ar" : "en";
                        queryParams["culture"] = cultureParam;
                        
                        var baseQueryString = string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value)}"));
                        var querySeparatorForPagination = string.IsNullOrEmpty(baseQueryString) ? "?" : "&";
                        
                        Func<int, string> getPageUrl = (pageNum) => 
                        {
                            return $"{currentPathForPagination}?page={pageNum}{(!string.IsNullOrEmpty(baseQueryString) ? "&" + baseQueryString : "")}";
                        };
                    }
                    
                    <!-- First Page Button -->
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="pagination-item">
                            <a href="@getPageUrl(1)" 
                               onclick="event.preventDefault(); loadPage(1); return false;" 
                               class="pagination-link pagination-link-icon"
                               title="@(currentCulture == "ar" ? "الصفحة الأولى" : "First Page")">
                                <i class="bi bi-chevron-double-@(currentCulture == "ar" ? "right" : "left")"></i>
                            </a>
                        </li>
                        <li class="pagination-item">
                            <a href="@getPageUrl(ViewBag.CurrentPage - 1)" 
                               onclick="event.preventDefault(); loadPage(@(ViewBag.CurrentPage - 1)); return false;" 
                               class="pagination-link pagination-link-icon"
                               title="@(currentCulture == "ar" ? "السابق" : "Previous")">
                                <i class="bi bi-chevron-@(currentCulture == "ar" ? "right" : "left")"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-double-@(currentCulture == "ar" ? "right" : "left")"></i>
                            </span>
                        </li>
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-@(currentCulture == "ar" ? "right" : "left")"></i>
                            </span>
                        </li>
                    }

                    <!-- Page Numbers -->
                    @{
                        int currentPage = ViewBag.CurrentPage;
                        int totalPages = ViewBag.TotalPages;
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);
                        
                        // Adjust range to always show 5 pages if possible
                        if (endPage - startPage < 4)
                        {
                            if (startPage == 1)
                            {
                                endPage = Math.Min(totalPages, startPage + 4);
                            }
                            else if (endPage == totalPages)
                            {
                                startPage = Math.Max(1, endPage - 4);
                            }
                        }
                    }

                    @if (startPage > 1)
                    {
                        <li class="pagination-item d-none d-md-block">
                            <span class="pagination-ellipsis">...</span>
                        </li>
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        if (i == currentPage)
                        {
                            <li class="pagination-item">
                                <span class="pagination-link active">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="pagination-item">
                                <a href="@getPageUrl(i)" 
                                   onclick="event.preventDefault(); loadPage(@i); return false;" 
                                   class="pagination-link">
                                    @i
                                </a>
                            </li>
                        }
                    }

                    @if (endPage < totalPages)
                    {
                        <li class="pagination-item d-none d-md-block">
                            <span class="pagination-ellipsis">...</span>
                        </li>
                    }

                    <!-- Next and Last Page Buttons -->
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="pagination-item">
                            <a href="@getPageUrl(ViewBag.CurrentPage + 1)" 
                               onclick="event.preventDefault(); loadPage(@(ViewBag.CurrentPage + 1)); return false;" 
                               class="pagination-link pagination-link-icon"
                               title="@(currentCulture == "ar" ? "التالي" : "Next")">
                                <i class="bi bi-chevron-@(currentCulture == "ar" ? "left" : "right")"></i>
                            </a>
                        </li>
                        <li class="pagination-item">
                            <a href="@getPageUrl(ViewBag.TotalPages)" 
                               onclick="event.preventDefault(); loadPage(@ViewBag.TotalPages); return false;" 
                               class="pagination-link pagination-link-icon"
                               title="@(currentCulture == "ar" ? "الصفحة الأخيرة" : "Last Page")">
                                <i class="bi bi-chevron-double-@(currentCulture == "ar" ? "left" : "right")"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-@(currentCulture == "ar" ? "left" : "right")"></i>
                            </span>
                        </li>
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-double-@(currentCulture == "ar" ? "left" : "right")"></i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>

            <!-- Quick Jump -->
            <div class="pagination-jump d-none d-lg-flex">
                <label for="pageJump" class="jump-label">
                    @if(currentCulture == "ar") {
                        <text>اذهب إلى:</text>
                    } else {
                        <text>Go to:</text>
                    }
                </label>
                <input type="number" 
                       id="pageJump" 
                       class="jump-input" 
                       min="1" 
                       max="@ViewBag.TotalPages" 
                       value="@ViewBag.CurrentPage"
                       onkeypress="if(event.key === 'Enter') jumpToPage(this.value)">
                <button onclick="jumpToPage(document.getElementById('pageJump').value)" 
                        class="jump-button"
                        title="@(currentCulture == "ar" ? "انتقال" : "Jump")">
                    <i class="bi bi-arrow-@(currentCulture == "ar" ? "left" : "right")"></i>
    </button>
    </div>
    </div>
</div>
}

