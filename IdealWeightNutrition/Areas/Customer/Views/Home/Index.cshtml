@section Styles {
    <link rel="stylesheet" href="~/css/video-banner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-home-screen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/category-carousel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flash-sale-carousel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offers-carousel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/testimonials.css" asp-append-version="true" />
    
    <style>
        /* Modern Pagination Styles */
        .modern-pagination-container {
            margin: 3rem 0 4rem;
            padding: 2rem 1rem;
            background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            animation: fadeInUp 0.6s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .pagination-wrapper {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            align-items: center;
            justify-content: center;
        }

        /* Page Info Section */
        .pagination-info {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            text-align: center;
        }

        .page-info-text {
            font-size: 1.1rem;
            font-weight: 700;
            color: #2c3e50;
            background: linear-gradient(135deg, #3B9DD5, #7BC043);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .total-products-info {
            font-size: 0.9rem;
            color: #6c757d;
            font-weight: 500;
        }

        /* Pagination Navigation */
        .pagination-nav {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .pagination-list {
            display: flex;
            gap: 0.5rem;
            list-style: none;
            padding: 0;
            margin: 0;
            flex-wrap: wrap;
            justify-content: center;
        }

        .pagination-item {
            display: inline-block;
        }

        .pagination-link {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 45px;
            height: 45px;
            padding: 0.5rem 1rem;
            background: white;
            color: #495057;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .pagination-link::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: linear-gradient(135deg, #3B9DD5, #7BC043);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.4s ease, height 0.4s ease;
            z-index: 0;
        }

        .pagination-link:hover::before {
            width: 150%;
            height: 150%;
        }

        .pagination-link:hover {
            color: white;
            border-color: #3B9DD5;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(59, 157, 213, 0.3);
        }

        .pagination-link i,
        .pagination-link span {
            position: relative;
            z-index: 1;
        }

        .pagination-link.active {
            background: linear-gradient(135deg, #3B9DD5, #7BC043);
            color: white;
            border-color: transparent;
            box-shadow: 0 8px 25px rgba(59, 157, 213, 0.4);
            transform: scale(1.1);
        }

        .pagination-link.active::before {
            display: none;
        }

        .pagination-link.disabled {
            background: #f8f9fa;
            color: #ced4da;
            border-color: #e9ecef;
            cursor: not-allowed;
            pointer-events: none;
        }

        .pagination-link-icon {
            min-width: 45px;
            padding: 0.5rem;
        }

        .pagination-link-icon i {
            font-size: 1.2rem;
        }

        .pagination-ellipsis {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 45px;
            height: 45px;
            color: #6c757d;
            font-weight: 700;
            font-size: 1.2rem;
        }

        /* Quick Jump Section */
        .pagination-jump {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            background: white;
            border-radius: 12px;
            border: 2px solid #e9ecef;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .pagination-jump:hover {
            border-color: #3B9DD5;
            box-shadow: 0 6px 20px rgba(59, 157, 213, 0.15);
        }

        .jump-label {
            margin: 0;
            font-weight: 600;
            color: #495057;
            font-size: 0.95rem;
        }

        .jump-input {
            width: 70px;
            padding: 0.5rem 0.75rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .jump-input:focus {
            outline: none;
            border-color: #3B9DD5;
            box-shadow: 0 0 0 3px rgba(59, 157, 213, 0.1);
        }

        .jump-input.is-invalid {
            border-color: #dc3545;
            animation: shake 0.5s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .jump-button {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #3B9DD5, #7BC043);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .jump-button:hover {
            transform: translateX(5px);
            box-shadow: 0 4px 15px rgba(59, 157, 213, 0.3);
        }

        .jump-button i {
            font-size: 1rem;
        }

        /* RTL Support */
        [dir="rtl"] .jump-button:hover {
            transform: translateX(-5px);
        }

        /* Responsive Design */
        @@media (max-width: 991px) {
            .pagination-jump {
                display: none !important;
            }
        }

        @@media (max-width: 768px) {
            .modern-pagination-container {
                margin: 2rem 0 3rem;
                padding: 1.5rem 0.75rem;
                border-radius: 15px;
            }

            .pagination-wrapper {
                gap: 1.25rem;
            }

            .pagination-list {
                gap: 0.35rem;
            }

            .pagination-link {
                min-width: 40px;
                height: 40px;
                padding: 0.4rem 0.75rem;
                font-size: 0.9rem;
                border-radius: 10px;
            }

            .pagination-link-icon {
                min-width: 40px;
                padding: 0.4rem;
            }

            .pagination-link-icon i {
                font-size: 1rem;
            }

            .page-info-text {
                font-size: 1rem;
            }

            .total-products-info {
                font-size: 0.85rem;
            }
        }

        @@media (max-width: 576px) {
            .modern-pagination-container {
                margin: 1.5rem 0 2rem;
                padding: 1rem 0.5rem;
            }

            .pagination-list {
                gap: 0.25rem;
            }

            .pagination-link {
                min-width: 35px;
                height: 35px;
                padding: 0.3rem 0.5rem;
                font-size: 0.85rem;
                border-radius: 8px;
            }

            .pagination-link-icon {
                min-width: 35px;
                padding: 0.3rem;
            }

            .page-info-text {
                font-size: 0.95rem;
            }

            /* Hide page numbers except current and adjacent on very small screens */
            .pagination-item:not(.pagination-item:has(.active)):not(.pagination-item:has(.pagination-link-icon)) {
                display: none;
            }

            .pagination-item:has(.active) ~ .pagination-item:first-of-type,
            .pagination-item:has(.active) + .pagination-item:first-of-type {
                display: inline-block;
            }
        }

        /* Loading State for Products */
        .modern-products-grid.pagination-loading {
            opacity: 0.5;
            pointer-events: none;
            position: relative;
            min-height: 400px;
        }

        .modern-products-grid.pagination-loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 60px;
            height: 60px;
            border: 6px solid #f3f3f3;
            border-top: 6px solid #3B9DD5;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            transform: translate(-50%, -50%);
            z-index: 999;
        }

        @@keyframes spin {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }
        
        /* Loading State for Pagination */
        .pagination-loading {
            opacity: 0.6;
            pointer-events: none;
        }
        
        /* Smooth product transitions */
        .product-card {
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
        
        .product-card.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
}

    @section Scripts {
    <script src="~/js/modern-home-screen.js" asp-append-version="true"></script>
    <script src="~/js/category-carousel.js" asp-append-version="true"></script>
    <script src="~/js/flash-sale-carousel.js" asp-append-version="true"></script>
    <script src="~/js/offers-carousel-responsive.js" asp-append-version="true"></script>
    <script src="~/js/testimonials-enhance.js" asp-append-version="true"></script>
    <script>
        // Localizations for JavaScript
        const currentCulture = '@currentCulture';
        const localizations = {
            selectOptions: '@Html.Raw(Localizer["SelectOptions"])',
            addedToCart: '@Html.Raw(Localizer["ItemAddedToCart"] ?? "Product added to cart successfully")',
            removedFromCart: '@Html.Raw(Localizer["ItemRemovedFromCart"] ?? "Product removed from cart")',
            failedToAddToCart: '@Html.Raw(Localizer["FailedToAddToCart"] ?? "Failed to add to cart")',
            failedToUpdateCart: '@Html.Raw(Localizer["FailedToUpdateCart"] ?? "Failed to update cart. Please try again.")',
            flashSaleAddedToCart: '@Html.Raw(Localizer["ItemAddedToCart"] ?? "Flash sale item added to cart!")',
            couldNotAddItemToCart: '@Html.Raw(Localizer["CouldNotAddItemToCart"] ?? "Could not add item to cart")',
            errorOccurred: '@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"] ?? "An error occurred. Please try again.")',
            itemRemovedFromCart: '@Html.Raw(Localizer["ItemRemovedFromCart"] ?? "Item removed from cart")',
            addToCart: '@Html.Raw(Localizer["AddToCart"] ?? "Add to Cart")',
            removeFromCart: '@Html.Raw(Localizer["RemoveFromCart"] ?? "Remove from Cart")',
            inCart: '@Html.Raw(Localizer["InCart"] ?? "In Cart")',
            securityTokenMissing: '@Html.Raw(Localizer["SecurityTokenMissing"] ?? "Security token missing. Please refresh the page.")',
            failedToUpdateQuantity: '@Html.Raw(Localizer["FailedToUpdateQuantity"] ?? "Failed to update quantity. Please try again.")',
            failedToRemoveItem: '@Html.Raw(Localizer["FailedToRemoveItem"] ?? "Failed to remove item. Please try again.")',
            cannotRemoveItemMissingInfo: '@Html.Raw(Localizer["CannotRemoveItemMissingInfo"] ?? "Cannot remove item: missing product information")',
            quantityUpdated: '@Html.Raw(Localizer["QuantityUpdated"] ?? "Quantity updated successfully")',
            maximumStockReached: '@Html.Raw(Localizer["MaximumStockReached"] ?? "Maximum stock reached")',
            increase: '@Html.Raw(Localizer["Increase"] ?? "Increase")',
            remove: '@Html.Raw(Localizer["Remove"] ?? "Remove")',
            flashSale: '@Html.Raw(Localizer["FlashSale"] ?? "Flash Sale")',
            combo: '@Html.Raw(Localizer["Combo"] ?? "Combo")'
        };
        
        // Make localizations globally available
        window.localizations = localizations;

        // Newsletter Form Handler - Fully Implemented
        document.getElementById('newsletterForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const form = e.target;
            const emailInput = document.getElementById('newsletterEmail');
            const submitBtn = form.querySelector('button[type="submit"]');
            const email = emailInput.value.trim();
            
            if (!email) {
                if (typeof toastr !== 'undefined') {
                    toastr.error('@Localizer["PleaseEnterValidEmail"]', '@Localizer["Newsletter"]');
                }
                return;
            }
            
            // Disable submit button
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>@Localizer["Subscribing"]...';
            
            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Create form data
            const formData = new FormData();
            formData.append('email', email);
            formData.append('source', 'HomePage');
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }
            
            // Make AJAX call
            fetch('@Url.Action("SubscribeNewsletter", "Home", new { area = "Customer" })', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token || ''
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    if (typeof toastr !== 'undefined') {
                        toastr.success(data.message, '@Localizer["Newsletter"]');
                    }
                    // Reload page to update subscription status
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    // Show error message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(data.message, '@Localizer["Newsletter"]');
                    }
                    // Reset button
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-send me-2"></i>@Localizer["Subscribe"]';
                }
            })
            .catch(error => {
                console.error('Newsletter subscription error:', error);
                if (typeof toastr !== 'undefined') {
                    toastr.error('@Localizer["SubscriptionError"]', '@Localizer["Newsletter"]');
                }
                // Reset button
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-send me-2"></i>@Localizer["Subscribe"]';
            });
        });

        // Unsubscribe Button Handler
        document.getElementById('unsubscribeBtn')?.addEventListener('click', function() {
            const btn = this;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            Swal.fire({
                title: '@Localizer["Unsubscribe"]',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '@Localizer["Unsubscribe"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }
            
                // Disable button
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>@Localizer["Unsubscribing"]...';
                
                // Create form data
                const formData = new FormData();
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }
                
                // Make AJAX call
                fetch('@Url.Action("UnsubscribeNewsletter", "Home", new { area = "Customer" })', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token || ''
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success message with SweetAlert
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        // Show error message with SweetAlert
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: data.message
                        });
                        // Reset button
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-x-circle me-2"></i>@Localizer["Unsubscribe"]';
                    }
                })
                .catch(error => {
                    console.error('Newsletter unsubscribe error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["SubscriptionError"]'
                    });
                    // Reset button
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-x-circle me-2"></i>@Localizer["Unsubscribe"]';
                });
            });
        });
        
        // Old LoadMore variables removed - using paginationState instead!
        const totalProductsFromServer = @totalProducts; // Total products count from server
        const isAuthenticated = @Json.Serialize(User.Identity.IsAuthenticated);
        let cartProductIds = @Html.Raw(Json.Serialize(ViewBag.CartProductIds ?? new List<int>()));
        let wishlistProductIds = @Html.Raw(Json.Serialize(ViewBag.WishlistProductIds ?? new List<int>()));
        window.isAuthenticated = isAuthenticated; // Make available globally
        document.body.setAttribute('data-is-authenticated', isAuthenticated.toString());

        // Save scroll position before any operation
        function saveScrollPosition() {
            sessionStorage.setItem('scrollPosition', window.scrollY || window.pageYOffset);
        }

        // Restore scroll position
        function restoreScrollPosition() {
            const savedPosition = sessionStorage.getItem('scrollPosition');
            if (savedPosition) {
                window.scrollTo(0, parseInt(savedPosition));
            }
        }

        // Restore scroll position on page load
        window.addEventListener('load', function() {
            restoreScrollPosition();
            // Clear the saved position after restoring
            sessionStorage.removeItem('scrollPosition');
            loadCartItems();
            // Initialize floating cart badge for all users
                const initialCount = cartProductIds.length;
                updateFloatingCartBadge(initialCount);
        });

        // Save scroll position before page unload
        window.addEventListener('beforeunload', function() {
            saveScrollPosition();
        });

        // Function to format currency
        const currencySymbol = '@Html.Raw(currencySymbol)';
        function formatCurrency(value) {
            return currencySymbol + ' ' + value.toFixed(2);
        }

        // Function to update cart widget using AJAX
        function updateCartWidget() {
            // Add timestamp to prevent caching
            const timestamp = new Date().getTime();
            fetch(`/Customer/Home/GetCartWidget?t=${timestamp}`, {
                method: 'GET',
                cache: 'no-cache',
                headers: {
                    'Cache-Control': 'no-cache'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(html => {
                    // Find the cart link by ID first, then by href
                    const cartLink = document.getElementById('cartNavLink') || document.querySelector('a[href*="/Customer/Cart/Index"]');
                    if (cartLink) {
                        cartLink.innerHTML = html;
                    } else {
                        console.error('Cart link not found for AJAX update');
                    }
                })
                .catch(error => {
                    console.error('Error updating cart widget:', error);
                });
        }

        // Function to update navigation cart count directly
        // Make updateNavigationCartCount globally available
        window.updateNavigationCartCount = function(count) {
            // Try to find cart link by ID first, then by href
            const cartLink = document.getElementById('cartNavLink') || document.querySelector('a[href*="/Customer/Cart/Index"]');
            
            if (cartLink) {
                // Find the count span inside the cart link - try multiple selectors
                let countSpan = cartLink.querySelector('span[style*="background"]');
                if (!countSpan) {
                    // Try finding by looking for the span with gradient background
                    const spans = cartLink.querySelectorAll('span');
                    countSpan = Array.from(spans).find(span => {
                        const bg = window.getComputedStyle(span).background || span.style.background || '';
                        return bg.includes('gradient') || bg.includes('linear-gradient');
                    });
                }
                if (!countSpan) {
                    // Try finding the last span (usually the count)
                    const spans = cartLink.querySelectorAll('span');
                    if (spans.length > 0) {
                        countSpan = spans[spans.length - 1];
                    }
                }
                
                if (countSpan) {
                    countSpan.textContent = count;
                    return true;
                } else {
                    // If span doesn't exist, update the entire link content via AJAX
                    return false;
                }
            } else {
                console.error('Cart link not found');
                return false;
            }
        }

