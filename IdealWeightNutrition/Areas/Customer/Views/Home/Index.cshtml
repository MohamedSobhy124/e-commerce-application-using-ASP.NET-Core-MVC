    <!-- PERFORMANCE: Lazy loading for sections - Load independently via AJAX -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get current culture from HTML lang attribute or cookie
            function getCurrentCulture() {
                const htmlLang = document.documentElement.lang;
                if (htmlLang) return htmlLang;
                
                // Fallback: check cookie
                const cookies = document.cookie.split(';');
                for (let cookie of cookies) {
                    const [name, value] = cookie.trim().split('=');
                    if (name === '.AspNetCore.Culture' && value) {
                        const match = value.match(/c=([^|]+)/);
                        if (match) return match[1];
                    }
                }
                return 'ar'; // Default to Arabic
            }
            
            const currentCulture = getCurrentCulture();
            
            // Function to load a section via AJAX with culture parameter
            function loadSection(url, placeholderId) {
                const placeholder = document.getElementById(placeholderId);
                if (!placeholder) return;

                // Add culture parameter to URL to ensure cache varies by language
                const separator = url.includes('?') ? '&' : '?';
                const urlWithCulture = `${url}${separator}culture=${currentCulture}`;

                fetch(urlWithCulture)
                    .then(response => {
                        if (!response.ok) {
                            // If 500 error or other error, hide the placeholder
                            if (response.status >= 500) {
                                console.warn(`Server error loading ${placeholderId}, hiding section`);
                                placeholder.style.display = 'none';
                                return '';
                            }
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.text();
                    })
                    .then(html => {
                        if (html && html.trim().length > 0) {
                            placeholder.outerHTML = html;
                            
                            // Wait a bit for DOM to update before initializing
                            setTimeout(() => {
                                // Reinitialize any scripts/event handlers after content loads
                                if (typeof initializeFlashSaleCarousel === 'function') {
                                    initializeFlashSaleCarousel();
                                }
                                if (typeof initializeProductCarousels === 'function') {
                                    initializeProductCarousels();
                                }
                                
                                // Initialize Bootstrap carousels if they exist with touch support and RTL support
                                // Use the global function to ensure RTL support
                                // Add a small delay to ensure DOM is fully updated
                                setTimeout(() => {
                                    if (typeof initializeCarouselsWithRTL === 'function') {
                                        initializeCarouselsWithRTL();
                                    } else if (typeof window.initializeCarouselsWithRTL === 'function') {
                                        window.initializeCarouselsWithRTL();
                                    }
                                }, 100);
                                
                                // Enhance carousels for mobile if needed
                                if (window.innerWidth <= 767 && typeof enhanceCarouselsForMobile === 'function') {
                                    setTimeout(function() {
                                        enhanceCarouselsForMobile();
                                    }, 100);
                                }
                                
                                // Also enhance carousels for mobile if needed
                                if (typeof window.enhanceCarouselsForMobile === 'function' && window.innerWidth <= 767) {
                                    setTimeout(() => {
                                        window.enhanceCarouselsForMobile();
                                    }, 100);
                                }
                            }, 50);
                        } else {
                            // Hide placeholder if no content
                            placeholder.style.display = 'none';
                        }
                    })
                    .catch(error => {
                        console.error(`Error loading section ${placeholderId}:`, error);
                        // Hide on error instead of showing error message for better UX
                        placeholder.style.display = 'none';
                    });
            }

            // Load sections in sequence with small delays to avoid overwhelming the server
            // Priority order: Flash Sales -> Discounted Products -> Services -> Category Products -> Best Sellers -> New Arrivals
            
            setTimeout(() => loadSection('/Customer/Home/LoadFlashSalesSection', 'flashSalesSectionPlaceholder'), 100);
            setTimeout(() => loadSection('/Customer/Home/LoadDiscountedProductsSection', 'discountedProductsSectionPlaceholder'), 300);
            setTimeout(() => loadSection('/Customer/Home/LoadServicesSection', 'servicesSectionPlaceholder'), 500);
            setTimeout(() => loadSection('/Customer/Home/LoadCategoryProductsSection', 'categoryProductsSectionPlaceholder'), 700);
            setTimeout(() => loadSection('/Customer/Home/LoadBestSellersSection', 'bestSellersSectionPlaceholder'), 900);
            setTimeout(() => loadSection('/Customer/Home/LoadNewArrivalsSection', 'newArrivalsSectionPlaceholder'), 1100);
            setTimeout(() => loadSection('/Customer/Home/LoadComboOffersSection', 'comboOffersSectionPlaceholder'), 1300);
        });

        // Initialize carousels with RTL support on page load
        function initializeCarouselsWithRTL() {
            if (typeof bootstrap !== 'undefined') {
                const isRTL = document.documentElement.dir === 'rtl' || document.documentElement.getAttribute('dir') === 'rtl';
                
                document.querySelectorAll('.carousel').forEach(carousel => {
                    // Check if carousel is already initialized
                    let existingCarousel = bootstrap.Carousel.getInstance(carousel);
                    
                    // Get interval from data attribute or default to 8000
                    const interval = carousel.dataset.bsInterval || carousel.getAttribute('data-bs-interval') || '8000';
                    
                    // If already initialized and RTL, dispose and reinitialize with RTL fixes
                    if (existingCarousel && isRTL) {
                        existingCarousel.dispose();
                        existingCarousel = null;
                    }
                    
                    if (!existingCarousel) {
                        // Set dir attribute for RTL support
                        if (isRTL) {
                            carousel.setAttribute('dir', 'rtl');
                        }
                        
                        const carouselInstance = new bootstrap.Carousel(carousel, {
                            interval: parseInt(interval),
                            wrap: true,
                            touch: !isRTL // Disable Bootstrap's touch for RTL, we'll handle it manually
                        });
                        
                        // Fix RTL carousel swipe direction for mobile
                        if (isRTL) {
                            // Handle touch/swipe manually for RTL to fix direction
                            let touchStartX = 0;
                            let touchStartY = 0;
                            let touchEndX = 0;
                            let touchEndY = 0;
                            let touchStartTime = 0;
                            let isHandlingSwipe = false;
                            
                            // Use a unique identifier to avoid duplicate handlers
                            if (!carousel.dataset.rtlHandlerAdded) {
                                carousel.dataset.rtlHandlerAdded = 'true';
                                
                                const handleTouchStart = function(e) {
                                    touchStartX = e.changedTouches[0].screenX;
                                    touchStartY = e.changedTouches[0].screenY;
                                    touchStartTime = Date.now();
                                    isHandlingSwipe = false;
                                };
                                
                                const handleTouchMove = function(e) {
                                    // Track movement
                                    touchEndX = e.changedTouches[0].screenX;
                                    touchEndY = e.changedTouches[0].screenY;
                                };
                                
                                const handleTouchEnd = function(e) {
                                    touchEndX = e.changedTouches[0].screenX;
                                    touchEndY = e.changedTouches[0].screenY;
                                    const touchDuration = Date.now() - touchStartTime;
                                    const diffX = touchStartX - touchEndX;
                                    const diffY = touchStartY - touchEndY;
                                    const swipeThreshold = 50;
                                    const maxDuration = 300; // Max swipe duration in ms
                                    
                                    // Check if movement is primarily horizontal (for carousel) or vertical (for scrolling)
                                    const isHorizontalSwipe = Math.abs(diffX) > Math.abs(diffY);
                                    
                                    // Only handle if it's a quick horizontal swipe (not vertical scroll)
                                    if (isHorizontalSwipe && Math.abs(diffX) > swipeThreshold && touchDuration < maxDuration && !isHandlingSwipe) {
                                        isHandlingSwipe = true;
                                        e.preventDefault();
                                        e.stopPropagation();
                                        
                                        // In RTL mode, the user expects:
                                        // Swipe RIGHT → items move RIGHT (call prev() which moves content right)
                                        // Swipe LEFT → items move LEFT (call next() which moves content left)
                                        setTimeout(() => {
                                            try {
                                                // Use Bootstrap's data API to trigger slide instead of calling methods directly
                                                if (diffX > 0) {
                                                    // User swiped RIGHT = items should move RIGHT (trigger prev)
                                                    const prevButton = carousel.querySelector('[data-bs-slide="prev"]');
                                                    if (prevButton) {
                                                        prevButton.click();
                                                    } else {
                                                        // Fallback: get instance and call method
                                                        const instance = bootstrap.Carousel.getInstance(carousel);
                                                        if (instance) instance.prev();
                                                    }
                                                } else {
                                                    // User swiped LEFT = items should move LEFT (trigger next)
                                                    const nextButton = carousel.querySelector('[data-bs-slide="next"]');
                                                    if (nextButton) {
                                                        nextButton.click();
                                                    } else {
                                                        // Fallback: get instance and call method
                                                        const instance = bootstrap.Carousel.getInstance(carousel);
                                                        if (instance) instance.next();
                                                    }
                                                }
                                            } catch (err) {
                                                console.error('Error triggering carousel slide:', err);
                                            }
                                            isHandlingSwipe = false;
                                        }, 10);
                                    }
                                };
                                
                                carousel.addEventListener('touchstart', handleTouchStart, { passive: true });
                                carousel.addEventListener('touchmove', handleTouchMove, { passive: true });
                                carousel.addEventListener('touchend', handleTouchEnd, { passive: false });
                            }
                        }
                    }
                });
            }
        }
        
        // Make function globally available
        window.initializeCarouselsWithRTL = initializeCarouselsWithRTL;
        
        // Initialize carousels on page load
        document.addEventListener('DOMContentLoaded', function() {
            initializeCarouselsWithRTL();
        });
        
        // Sticky Header Scroll Detection - Enhanced Design
        document.addEventListener('DOMContentLoaded', function() {
            const stickyHeader = document.getElementById('heroSearchBoxSticky');
            if (stickyHeader) {
                let lastScrollTop = 0;
                
                function handleScroll() {
                    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    
                    if (scrollTop > 50) {
                        stickyHeader.classList.add('scrolled');
                    } else {
                        stickyHeader.classList.remove('scrolled');
                    }
                    
                    lastScrollTop = scrollTop;
                }
                
                // Throttle scroll events for better performance
                let ticking = false;
                window.addEventListener('scroll', function() {
                    if (!ticking) {
                        window.requestAnimationFrame(function() {
                            handleScroll();
                            ticking = false;
                        });
                        ticking = true;
                    }
                });
                
                // Initial check
                handleScroll();
            }
        });

        // Video Banner Optimization
        document.addEventListener('DOMContentLoaded', function() {
            const videoBanner = document.querySelector('.video-banner, .enhanced-video-banner');
            const posterImage = document.querySelector('.video-banner-poster, .enhanced-video-banner-poster');
            
            // Function to force reload image with aggressive cache-busting
            function forceReloadImage(imgElement) {
                if (!imgElement || !imgElement.src) return;
                
                const url = new URL(imgElement.src);
                // Remove all existing cache-busting parameters
                url.searchParams.delete('v');
                url.searchParams.delete('_t');
                url.searchParams.delete('nocache');
                url.searchParams.delete('refresh');
                // Add multiple cache-busting parameters
                url.searchParams.set('v', Date.now());
                url.searchParams.set('_t', Math.random().toString(36).substring(7));
                url.searchParams.set('nocache', Date.now());
                url.searchParams.set('refresh', Math.random().toString(36).substring(2, 15));
                
                // Force reload by clearing src first
                const newSrc = url.toString();
                imgElement.src = '';
                
                // Use requestAnimationFrame to ensure browser processes the change
                requestAnimationFrame(() => {
                    imgElement.src = newSrc;
                    // Force browser to reload by adding a load event
                    imgElement.onload = function() {
                        this.onload = null; // Remove handler after first load
                    };
                });
            }
            
            // Force reload poster image to avoid cache issues
            if (posterImage) {
                forceReloadImage(posterImage);
            }
            
            // Clear browser cache for video banner images
            if ('caches' in window) {
                caches.keys().then(names => {
                    names.forEach(name => {
                        if (name.includes('video-banner') || name.includes('images')) {
                            caches.delete(name);
                        }
                    });
                });
            }
            
            if (videoBanner) {
                // Check if video can play (browser support)
                videoBanner.addEventListener('loadedmetadata', function() {
                    videoBanner.classList.add('loaded');
                });
                
                // Handle video loading errors - show poster if available
                videoBanner.addEventListener('error', function() {
                    console.warn('Video banner failed to load, showing poster fallback');
                    this.style.display = 'none';
                    const container = this.closest('.video-banner-container');
                    if (container) {
                        // Try to show poster image if available
                        const posterFallback = container.querySelector('.video-banner-poster-fallback');
                        if (posterFallback) {
                            // Force reload the poster image with aggressive cache-busting
                            forceReloadImage(posterFallback);
                            posterFallback.style.display = 'block';
                            posterFallback.classList.add('video-banner-poster');
                        } else {
                            // Show fallback content if no poster
                            const fallback = container.querySelector('.video-fallback');
                            if (fallback) {
                                fallback.style.display = 'flex';
                            }
                        }
                    }
                });
                
                // Pause video when page is not visible (performance)
                document.addEventListener('visibilitychange', function() {
                    if (document.hidden) {
                        videoBanner.pause();
                    } else {
                        videoBanner.play().catch(e => console.log('Video autoplay prevented:', e));
                    }
                });
                
                // Lazy load video only when in viewport
                if ('IntersectionObserver' in window) {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const video = entry.target;
                                if (video.readyState === 0) {
                                    video.load();
                                }
                                observer.unobserve(video);
                            }
                        });
                    }, { rootMargin: '50px' });
                    
                    observer.observe(videoBanner);
                }
            }
        });
        
        // Mobile Search Expand/Collapse Functionality
        (function() {
