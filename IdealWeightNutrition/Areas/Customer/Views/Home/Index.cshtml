        // Enhanced Filter Interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Filter toggle for mobile
            const filterToggleBtn = document.getElementById('filterToggleBtn');
            const filterGroups = document.getElementById('filterGroups');
            
            if (filterToggleBtn && filterGroups) {
                filterToggleBtn.addEventListener('click', function() {
                    filterGroups.classList.toggle('active');
                    filterToggleBtn.classList.toggle('active');
                });
            }
            
            // Price range slider interactions
            const priceRangeMin = document.getElementById('priceRangeMin');
            const priceRangeMax = document.getElementById('priceRangeMax');
            const priceMinInput = document.querySelector('input[name="minPrice"]');
            const priceMaxInput = document.querySelector('input[name="maxPrice"]');
            const priceMinDisplay = document.getElementById('priceMinDisplay');
            const priceMaxDisplay = document.getElementById('priceMaxDisplay');
            
            if (priceRangeMin && priceRangeMax && priceMinInput && priceMaxInput) {
                const minPrice = parseFloat(priceRangeMin.getAttribute('min')) || 0;
                const maxPrice = parseFloat(priceRangeMax.getAttribute('max')) || 10000;
                
                // Check if inputs have values from server/URL - don't sync from sliders if empty
                const hasMinPrice = priceMinInput.value && priceMinInput.value.trim() !== '';
                const hasMaxPrice = priceMaxInput.value && priceMaxInput.value.trim() !== '';
                
                // Ensure inputs stay empty if no price filter is set
                if (!hasMinPrice) {
                    priceMinInput.value = '';
                }
                if (!hasMaxPrice) {
                    priceMaxInput.value = '';
                }
                
                // Update display when sliders change (only syncs when user moves slider)
                priceRangeMin.addEventListener('input', function() {
                    const value = parseFloat(this.value);
                    if (priceMinInput) priceMinInput.value = value.toFixed(2);
                    if (priceMinDisplay) priceMinDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                });
                
                priceRangeMax.addEventListener('input', function() {
                    const value = parseFloat(this.value);
                    if (priceMaxInput) priceMaxInput.value = value.toFixed(2);
                    if (priceMaxDisplay) priceMaxDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                });
                
                // Initialize display text from current slider range values (for display only, not input)
                if (!hasMinPrice && priceMinDisplay) {
                    priceMinDisplay.textContent = currencySymbol + ' ' + minPrice.toFixed(2);
                }
                if (!hasMaxPrice && priceMaxDisplay) {
                    priceMaxDisplay.textContent = currencySymbol + ' ' + maxPrice.toFixed(2);
                }
                
                // Update sliders when inputs change
                if (priceMinInput) {
                    priceMinInput.addEventListener('input', function() {
                        const value = Math.max(minPrice, Math.min(maxPrice, parseFloat(this.value) || minPrice));
                        priceRangeMin.value = value;
                        if (priceMinDisplay) priceMinDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                    });
                }
                
                if (priceMaxInput) {
                    priceMaxInput.addEventListener('input', function() {
                        const value = Math.max(minPrice, Math.min(maxPrice, parseFloat(this.value) || maxPrice));
                        priceRangeMax.value = value;
                        if (priceMaxDisplay) priceMaxDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                    });
                }
            }
            
            // Auto-submit on filter change (with debounce for price inputs)
            let filterTimeout;
            const filterForm = document.getElementById('filterForm');
            const priceInputs = document.querySelectorAll('.price-input');
            
            priceInputs.forEach(input => {
                input.addEventListener('input', function() {
                    clearTimeout(filterTimeout);
                    filterTimeout = setTimeout(() => {
                        // Don't auto-submit price, let user click Apply
                    }, 500);
                });
            });
            
            // Select filters - DO NOT auto-submit (use Apply button instead)
            // Removed auto-submit to prevent page reloads - filters now use AJAX via Apply button
            const autoSubmitSelects = document.querySelectorAll('.modern-select:not([name="minPrice"]):not([name="maxPrice"])');
            autoSubmitSelects.forEach(select => {
                select.addEventListener('change', function(e) {
                    e.preventDefault();
                    // Don't auto-submit - user must click Apply Filters button
                    // This prevents page reloads and uses AJAX instead
                });
            });
            
            // Initialize filter state from URL
            initializeFiltersFromURL();
            
            // Search clear button functionality
            const heroSearchInput = document.getElementById('heroSearchInput');
            const searchClearBtn = document.getElementById('searchClearBtn');
            
            if (heroSearchInput && searchClearBtn) {
                // Show/hide clear button based on input value
                function toggleClearButton() {
                    if (heroSearchInput.value.trim() !== '') {
                        searchClearBtn.style.display = 'block';
                    } else {
                        searchClearBtn.style.display = 'none';
                    }
                }
                
                // Toggle on input
                heroSearchInput.addEventListener('input', toggleClearButton);
                
                // Toggle on page load
                toggleClearButton();
                
                // Clear search when button is clicked
                searchClearBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    heroSearchInput.value = '';
                    searchClearBtn.style.display = 'none';
                    heroSearchInput.focus();
                    
                    // Clear search filter and reload products
                    if (typeof loadProductsWithFilters === 'function') {
                        loadProductsWithFilters({ searchTerm: '' }, false, false);
                    }
                });
            }
        });
        
        // Initialize filters from URL parameters
        function initializeFiltersFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const minPrice = urlParams.get('minPrice');
            const maxPrice = urlParams.get('maxPrice');
            
            const priceMinInput = document.querySelector('input[name="minPrice"]');
            const priceMaxInput = document.querySelector('input[name="maxPrice"]');
            const priceRangeMin = document.getElementById('priceRangeMin');
            const priceRangeMax = document.getElementById('priceRangeMax');
            
            // Only set values if they exist in URL - otherwise keep inputs empty
            if (minPrice && minPrice.trim() !== '') {
                if (priceMinInput) priceMinInput.value = parseFloat(minPrice).toFixed(2);
                if (priceRangeMin) priceRangeMin.value = minPrice;
            } else {
                // Ensure input is empty if no minPrice
                if (priceMinInput) priceMinInput.value = '';
            }
            
            if (maxPrice && maxPrice.trim() !== '') {
                if (priceMaxInput) priceMaxInput.value = parseFloat(maxPrice).toFixed(2);
                if (priceRangeMax) priceRangeMax.value = maxPrice;
            } else {
                // Ensure input is empty if no maxPrice
                if (priceMaxInput) priceMaxInput.value = '';
            }
        }

        // Load ratings for all products and check for load more button
        document.addEventListener('DOMContentLoaded', function() {
            loadAllProductRatings();

            // Initialize active category from URL parameter
            const urlParams = new URLSearchParams(window.location.search);
            const categoryId = urlParams.get('categoryId');
            if (categoryId) {
                // Remove active class from all category cards
                document.querySelectorAll('.category-card').forEach(card => {
                    card.classList.remove('active');
                });
                // Add active class to selected category
                const activeCard = document.querySelector(`.category-card[data-category-id="${categoryId}"]`);
                if (activeCard) {
                    activeCard.classList.add('active');
                }
            }
        });
        
        // Load More functionality removed - using pagination instead!

        function loadAllProductRatings() {
            const ratingElements = document.querySelectorAll('.product-card-rating');
            if (ratingElements.length === 0) return;

            // Collect all product IDs
            const productIds = Array.from(ratingElements)
                .map(element => {
                    const productId = element.getAttribute('data-product-id');
                    return productId ? parseInt(productId) : null;
                })
                .filter(id => id !== null);

            if (productIds.length === 0) return;

            // Make a single batch API call for all products
            fetch('/Customer/Review/GetBatchProductRatings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(productIds)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.ratings) {
                        // Update each product card with its rating
                        ratingElements.forEach(element => {
                            const productId = parseInt(element.getAttribute('data-product-id'));
                            if (productId && data.ratings[productId]) {
                                const rating = data.ratings[productId];
                                if (rating.reviewCount > 0) {
                                    const starsHtml = getStarsHTML(rating.averageRating);
                                    const starsElement = element.querySelector('.product-card-stars');
                                    const textElement = element.querySelector('.product-card-rating-text');
                                    if (starsElement) starsElement.innerHTML = starsHtml;
                                    if (textElement) textElement.textContent = `(${rating.reviewCount})`;
                                }
                            }
                        });
                    }
                })
                .catch(error => console.error('Error loading ratings:', error));
        }

        // Keep individual function for backward compatibility (if needed elsewhere)
        function loadProductCardRating(productId, element) {
            fetch(`/Customer/Review/GetProductRating?productId=${productId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.reviewCount > 0) {
                        const starsHtml = getStarsHTML(data.averageRating);
                        element.querySelector('.product-card-stars').innerHTML = starsHtml;
                        element.querySelector('.product-card-rating-text').textContent = 
                            `(${data.reviewCount})`;
                    }
                })
                .catch(error => console.error('Error loading rating:', error));
        }

        function getStarsHTML(rating) {
            const fullStars = Math.floor(rating);
            const hasHalf = (rating % 1) >= 0.5;
            let html = '';
            
            for (let i = 0; i < fullStars; i++) {
                html += '<i class="bi bi-star-fill"></i>';
            }
            if (hasHalf) {
                html += '<i class="bi bi-star-half"></i>';
            }
            for (let i = fullStars + (hasHalf ? 1 : 0); i < 5; i++) {
                html += '<i class="bi bi-star"></i>';
            }
            
            return html;
        }

