        // Function to load cart items (make globally available)
        window.loadCartItems = function() {
            const isAuthenticated = typeof window.isAuthenticated !== 'undefined' ? window.isAuthenticated : (typeof isAuthenticated !== 'undefined' ? isAuthenticated : false);

            fetch('/Customer/Cart/GetCartItems')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const container = document.getElementById('cartItemsContainer');
                    const countElement = document.getElementById('sidebarCartCount');
                    const subtotalElement = document.getElementById('cartSubtotal');
                    const emptyState = document.getElementById('cartEmptyState');

                    if (!container || !countElement || !subtotalElement) {
                        console.error('Cart sidebar elements not found', {
                            container: !!container,
                            countElement: !!countElement,
                            subtotalElement: !!subtotalElement
                        });
                        return;
                    }

                    // Hide/show empty state
                    if (emptyState) {
                        if (data.items && data.items.length > 0) {
                            emptyState.classList.add('hidden');
                        } else {
                            emptyState.classList.remove('hidden');
                        }
                    }

                    if (data.items && data.items.length > 0) {
                        // Use global createCartItemHTML from flash-sale-customer-fixed.js if available
                        // This is the preferred function that handles page detection correctly
                        let createItemHTML = null;
                        
                        // First, try to use the global function from flash-sale-customer-fixed.js
                        if (window.createCartItemHTML && typeof window.createCartItemHTML === 'function') {
                            // Verify it's not the local function (prevent recursion)
                            const globalFunc = window.createCartItemHTML;
                            if (globalFunc !== createCartItemHTML && globalFunc !== createCartItemHTMLLocal) {
                                createItemHTML = globalFunc;
                            }
                        }
                        
                        // If global not available or is recursive, use local fallback
                        if (!createItemHTML) {
                            if (typeof createCartItemHTMLLocal !== 'undefined') {
                                createItemHTML = createCartItemHTMLLocal;
                            } else if (typeof createCartItemHTML !== 'undefined') {
                                createItemHTML = createCartItemHTML;
                            }
                        }
                        
                        if (!createItemHTML) {
                            console.error('createCartItemHTML function not found');
                            if (emptyState) emptyState.classList.remove('hidden');
                            return;
                        }
                        
                        // Use the selected function to create HTML
                        try {
                            container.innerHTML = data.items.map(item => createItemHTML(item)).join('');
                        } catch (error) {
                            console.error('Error creating cart item HTML:', error);
                            if (emptyState) emptyState.classList.remove('hidden');
                            return;
                        }
                        countElement.textContent = data.items.length;
                        
                        // Use formatCurrency if available, otherwise use currencySymbol
                        const formatPrice = typeof formatCurrency !== 'undefined' ? formatCurrency : (value) => {
                            const symbol = typeof currencySymbol !== 'undefined' ? currencySymbol : 'AED';
                            return symbol + ' ' + value.toFixed(2);
                        };
                        subtotalElement.textContent = formatPrice(data.subtotal);
                        
                        // Update floating cart badge
                        if (typeof updateFloatingCartBadge === 'function') {
                            updateFloatingCartBadge(data.items.length);
                        } else if (typeof window.updateFloatingCartBadge === 'function') {
                            window.updateFloatingCartBadge(data.items.length);
                        }
                    } else {
                        container.innerHTML = '';
                        countElement.textContent = '0';
                        const symbol = typeof currencySymbol !== 'undefined' ? currencySymbol : 'AED';
                        subtotalElement.textContent = symbol + ' 0.00';
                        
                        // Update floating cart badge
                        if (typeof updateFloatingCartBadge === 'function') {
                            updateFloatingCartBadge(0);
                        } else if (typeof window.updateFloatingCartBadge === 'function') {
                            window.updateFloatingCartBadge(0);
                        }
                    }
                })
                .catch(error => {
                    console.error('Error loading cart items:', error);
                    const container = document.getElementById('cartItemsContainer');
                    const emptyState = document.getElementById('cartEmptyState');
                    if (container) {
                        container.innerHTML = '';
                    }
                    if (emptyState) {
                        emptyState.classList.remove('hidden');
                    }
                });
        };
        
        // Also keep local function for backward compatibility
        function loadCartItems() {
            window.loadCartItems();
        }

        // Function to create cart item HTML (fallback for home page)
        // NOTE: This is a LOCAL fallback function. The global createCartItemHTML from 
        // flash-sale-customer-fixed.js should be used instead. This function should NOT
        // call window.createCartItemHTML to prevent recursion.
        function createCartItemHTMLLocal(item) {
            // DO NOT call window.createCartItemHTML here - that would cause recursion
            // This is a pure local implementation for fallback use only
            // Fallback for home page (always show controls here since we're on home page)
            const imageUrl = item.imageUrl || '/images/no-image.png';
            const formatPrice = typeof formatCurrency !== 'undefined' ? formatCurrency : (value) => {
                const symbol = typeof currencySymbol !== 'undefined' ? currencySymbol : 'AED';
                return symbol + ' ' + value.toFixed(2);
            };
            return `
                <div class="cart-sidebar-item" data-cart-id="${item.cartId || ''}" data-product-id="${item.productId}">
                    <div class="cart-item-image-wrapper">
                        <img src="${imageUrl}" alt="${item.title}" class="cart-sidebar-item-image" 
                             onerror="this.src='/images/no-image.png'">
                    </div>
                    <div class="cart-item-details">
                        <h6 class="cart-item-title">${item.title}</h6>
                        ${item.variantName ? `<p class="cart-item-variant">${item.variantName}</p>` : ''}
                        <div class="cart-item-meta">
                            <div class="cart-item-quantity-controls">
                                <button class="btn-quantity btn-quantity-minus" onclick="updateCartQuantityFromSidebar(${item.productId}, ${item.count - 1}, ${item.cartId || 'null'})" title="Decrease">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <span class="cart-item-quantity-value">${item.count}</span>
                                <button class="btn-quantity btn-quantity-plus" onclick="updateCartQuantityFromSidebar(${item.productId}, ${item.count + 1}, ${item.cartId || 'null'})" title="Increase">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                            <span class="cart-item-price">${formatPrice(item.price * item.count)}</span>
                        </div>
                        ${(item.isFlashSale || item.isComboOffer) ? `
                        <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            ${item.isFlashSale ? '<span class="badge bg-danger" style="font-size: 0.7rem; padding: 0.25rem 0.5rem;">⚡ Flash Sale</span>' : ''}
                            ${item.isComboOffer ? '<span class="badge bg-warning text-dark" style="font-size: 0.7rem; padding: 0.25rem 0.5rem;">📦 Combo</span>' : ''}
                        </div>
                        ` : ''}
                    </div>
                    <button class="cart-item-remove" onclick="removeCartItem(${item.productId}, ${item.cartId || 'null'})" title="Remove" aria-label="Remove item">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
        }
        
        // Note: We have createCartItemHTMLLocal as a local fallback
        // The global createCartItemHTML from flash-sale-customer-fixed.js should be used
        // DO NOT create a local createCartItemHTML function that calls window.createCartItemHTML
        // as that would cause infinite recursion

        // Function to update cart quantity
        function updateCartQuantity(productId, newCount) {
            if (newCount < 1) {
                removeFromCart(productId);
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('count', newCount);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadCartItems(); // This will also update the floating badge
                    updateCartWidget();
                }
            })
            .catch(error => {
                console.error('Error updating quantity:', error);
            });
        }

        // Function to remove item from cart
        function removeFromCart(productId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Home/ToggleCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update button state for this product
                    const button = document.querySelector(`button[data-product-id="${productId}"]`);
                    if (button) {
                        button.classList.remove('in-cart');
                        button.querySelector('i').className = 'bi bi-plus-lg';
                        button.title = localizations.addToCart;
                    }
                    cartProductIds = cartProductIds.filter(id => id !== productId);
                    
                    // Update floating cart badge
                    updateFloatingCartBadge(data.cartCount);
                    
                    // Update navigation cart count immediately
                    updateNavigationCartCount(data.cartCount);
                    
                    loadCartItems();
                    
                    // Always update via AJAX to ensure it's synced (with small delay)
                    setTimeout(() => {
                        updateCartWidget();
                    }, 150);
                    
                    if (typeof toastr !== 'undefined') {
                        toastr.info(localizations.removedFromCart);
                    }
                }
            })
            .catch(error => {
                console.error('Error removing from cart:', error);
            });
        }

        // Function to toggle product in cart (make globally available)
        window.toggleCart = function(productId, button) {
            // Prevent multiple clicks
            if (!button || button.disabled || button.classList.contains('loading')) {
                return;
            }
            
            const isCurrentlyInCart = button.classList.contains('in-cart');
            const originalIcon = button.querySelector('i').className;
            
            // Save scroll position in case of any unexpected navigation
            saveScrollPosition();
            
            // Disable button and show loading state ONLY in button (no screen blocking)
            button.disabled = true;
            button.classList.add('loading');
            button.style.opacity = '0.7';
            button.style.cursor = 'wait';
            button.querySelector('i').className = 'bi bi-arrow-repeat';
            button.querySelector('i').style.animation = 'spin 1s linear infinite';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Home/ToggleCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Remove loading state from button only
                    button.disabled = false;
                    button.classList.remove('loading');
                    button.style.opacity = '';
                    button.style.cursor = '';
                    button.querySelector('i').style.animation = '';
                    
                    if (data.isAdded) {
                        // Product was added
                        button.classList.add('in-cart');
                        button.querySelector('i').className = 'bi bi-check-lg';
                        button.title = localizations.removeFromCart;
                        cartProductIds.push(productId);
                        
                        // Sync with localStorage
                        if (window.cartStorage) {
                            window.cartStorage.addItem({
                                productId: productId,
                                count: 1
                            });
                        }
                        
                        // Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.success(data.message);
                        }
                        
                        // Update cart count everywhere (works on all screens)
                        if (typeof updateFloatingCartBadge === 'function') {
                            updateFloatingCartBadge(data.cartCount);
                        } else if (typeof window.updateFloatingCartBadge === 'function') {
                            window.updateFloatingCartBadge(data.cartCount);
                        }
                        
                        // Update navigation cart count immediately
                        if (typeof updateNavigationCartCount === 'function') {
                            updateNavigationCartCount(data.cartCount);
                        }
                        
                        // Always update via AJAX to ensure it's synced (with small delay)
                        if (typeof updateCartWidget === 'function') {
                            setTimeout(() => {
                                updateCartWidget();
                            }, 150);
                        }
                        
                        // Open the cart sidebar to show the added item - but NOT on mobile screens
                        if (typeof openCartSidebar === 'function' || typeof window.openCartSidebar === 'function') {
                            const openCart = window.openCartSidebar || openCartSidebar;
                            const sidebar = document.querySelector('.cart-sidebar-new') || document.getElementById('cartSidebar');
                            const isMobile = window.innerWidth <= 768;
                            
                            // Only open sidebar on desktop, not on mobile
                            if (sidebar && !isMobile) {
                                openCart(true); // forceOpen = true for user-initiated action
                            }
                        }
                    } else {
                        // Product was removed
                        button.classList.remove('in-cart');
                        button.querySelector('i').className = 'bi bi-plus-lg';
                        button.title = localizations.addToCart;
                        cartProductIds = cartProductIds.filter(id => id !== productId);
                        
                        // Sync with localStorage
                        if (window.cartStorage) {
                            window.cartStorage.removeItem(productId);
                        }
                        
                        // Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.info(data.message);
                        }
                        
                        // Update cart count everywhere (works on all screens)
                        if (typeof updateFloatingCartBadge === 'function') {
                            updateFloatingCartBadge(data.cartCount);
                        } else if (typeof window.updateFloatingCartBadge === 'function') {
                            window.updateFloatingCartBadge(data.cartCount);
                        }
                        
                        // Update navigation cart count immediately
                        if (typeof updateNavigationCartCount === 'function') {
                            updateNavigationCartCount(data.cartCount);
                        }
                        
                        // Always update via AJAX to ensure it's synced (with small delay)
                        if (typeof updateCartWidget === 'function') {
                            setTimeout(() => {
                                updateCartWidget();
                            }, 150);
                        }
                    }
                } else {
                    throw new Error(data.message || 'Failed to update cart');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                // Remove loading state from button only
                button.disabled = false;
                button.classList.remove('loading');
                button.style.opacity = '';
                button.style.cursor = '';
                button.querySelector('i').className = originalIcon;
                button.querySelector('i').style.animation = '';
                if (typeof toastr !== 'undefined') {
                    toastr.error(localizations.failedToUpdateCart);
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: localizations.failedToUpdateCart
                    });
                }
            });
        }

        // Function to create product HTML - NEW DESIGN
        window.createProductCard = function(product, isAuthenticated) {
            const discount = product.listPrice > 0 ? Math.floor((product.listPrice - product.price) / product.listPrice * 100) : 0;
            const discountText = '@(currentCulture == "ar" ? "خصم" : "OFF")';
            const hasVariants = product.hasVariants === true || product.productType === 1;
            const shouldShowPrice = product.shouldShowPrice !== undefined ? product.shouldShowPrice : (product.stockQuantity > 0);
            const allVariantsOutOfStock = product.allVariantsOutOfStock === true;
            const pricePrefix = hasVariants ? (currentCulture === 'ar' ? 'من ' : 'From ') : '';
            
            const priceHtml = shouldShowPrice 
                ? (discount > 0 
                    ? `<span class="current-price">${hasVariants ? `<span class="price-from-text">${pricePrefix}</span>` : ''}${formatCurrency(product.price)}</span>
                       <span class="list-price">${formatCurrency(product.listPrice)}</span>`
                    : `<span class="current-price">${hasVariants ? `<span class="price-from-text">${pricePrefix}</span>` : ''}${formatCurrency(product.price)}</span>`)
                : '';
            
            const outOfStockHtml = !shouldShowPrice && allVariantsOutOfStock
                ? `<div class="price-wrapper"><span class="text-muted" style="font-size: 0.9rem;">@Localizer["OutOfStock"]</span></div>`
                : '';
            
            const isInCart = cartProductIds.includes(product.id);
            const cartIcon = isInCart ? 'bi-check-lg' : 'bi-cart-plus';
            const cartClass = isInCart ? 'in-cart' : '';
            
            // Handle multiple images
            let imageHtml = '';
            // productImages from API is already an array of image URLs (strings), not objects
            let productImages = [];
            
            // Check if productImages exists and has items
            if (product.productImages && Array.isArray(product.productImages) && product.productImages.length > 0) {
                // If it's an array of strings (URLs), use directly
                if (typeof product.productImages[0] === 'string') {
                    productImages = product.productImages.filter(img => img && String(img).trim() !== '');
                } 
                // If it's an array of objects, extract URLs
                else if (product.productImages[0] && typeof product.productImages[0] === 'object') {
                    productImages = product.productImages
                        .filter(pi => pi && pi.imageUrl)
                        .sort((a, b) => (a.displayOrder || 0) - (b.displayOrder || 0))
                        .map(pi => pi.imageUrl)
                        .filter(img => img && String(img).trim() !== '');
                }
            }
            
            // Fallback to main imageUrl if no productImages
            if (productImages.length === 0) {
                if (product.imageUrl) {
                    productImages.push(product.imageUrl);
                } else {
                    // Last resort: try to get image from first productImage if it exists as object
                    if (product.productImages && product.productImages.length > 0 && product.productImages[0] && typeof product.productImages[0] === 'object') {
                        const firstImg = product.productImages[0];
                        if (firstImg.url) productImages.push(firstImg.url);
                        else if (firstImg.ImageUrl) productImages.push(firstImg.ImageUrl);
                    }
                }
            }
            
            // Normalize image URLs - convert backslashes to forward slashes and ensure leading slash
            productImages = productImages.map(img => {
                if (!img) return '';
                // Convert to string and trim
                img = String(img).trim();
                // Replace backslashes with forward slashes
                img = img.replace(/\\/g, '/');
                // Remove double slashes (except http:// or https://)
                img = img.replace(/([^:]\/)\/+/g, '$1');
                // Ensure it starts with / if it's a relative path
                if (img && !img.startsWith('http') && !img.startsWith('/') && !img.startsWith('data:')) {
                    img = '/' + img;
                }
                return img;
            }).filter(img => img && img.trim() !== '');
            
            if (productImages.length > 1) {
                // Multiple images - carousel
                let carouselItems = '';
                let indicators = '';
                productImages.forEach((img, index) => {
                    // Image URL is already normalized above
                    let imageUrl = img || '/images/no-image.png';
                    
                    carouselItems += `
                        <div class="carousel-item ${index === 0 ? 'active' : ''}">
                            <img src="${imageUrl}" class="product-image" alt="${product.title || 'Product'} - Image ${index + 1}" onerror="this.src='/images/no-image.png'; this.onerror=null;" />
                        </div>
                    `;
                    indicators += `
                        <button type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide-to="${index}" 
                                class="${index === 0 ? 'active' : ''}" aria-current="${index === 0 ? 'true' : 'false'}" 
                                aria-label="Slide ${index + 1}"></button>
                    `;
                });
                
                imageHtml = `
                    <div id="productCarousel_${product.id}" class="carousel slide product-image-carousel" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            ${carouselItems}
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                        <div class="carousel-indicators">
                            ${indicators}
                        </div>
                    </div>
                `;
            } else {
                // Single image - URL is already normalized above
                let imageUrl = productImages.length > 0 ? productImages[0] : '';
                
                // Fallback to main imageUrl if productImages is empty
                if (!imageUrl && product.imageUrl) {
                    imageUrl = product.imageUrl.replace(/\\/g, '/');
                    if (!imageUrl.startsWith('http') && !imageUrl.startsWith('/') && !imageUrl.startsWith('data:')) {
                        imageUrl = '/' + imageUrl;
                    }
                }
                
                // Fallback to a placeholder if no image
                if (!imageUrl) {
                    imageUrl = '/images/no-image.png';
                }
                
                const productTitle = (currentCulture === 'ar' && product.titleAr) ? product.titleAr : (product.title || 'Product');
