<!-- DISCOUNTED PRODUCTS / OFFERS SECTION -->
@{
    var discountedProducts = ViewBag.DiscountedProducts as IEnumerable<IdealWeightNutrition.Models.Product> ?? Enumerable.Empty<IdealWeightNutrition.Models.Product>();
    var hasDiscountedProducts = discountedProducts.Any();
}


@if (hasDiscountedProducts)
{
    <section class="offers-section">
        <div class="container">
            <!-- Section Header -->
            <div class="offers-header">
                <h2 class="offers-title">
                    <span class="offers-icon">🔥</span>
                    @Localizer["Offers"]
                </h2>
                <p class="offers-subtitle">@Localizer["BestDeals"]</p>
            </div>
            
            <!-- Bootstrap Carousel -->
            <div id="offersCarousel" class="carousel slide offers-carousel" data-bs-ride="carousel" data-bs-interval="8000" data-bs-pause="hover" data-bs-touch="true">
                <div class="carousel-inner">
                    @{
                        var productsList = discountedProducts.ToList();
                        var itemsPerSlide = 4; // Fixed 4 items per slide like best sellers
                        var totalSlides = 0; // Initialize total slides
                        
                        // Ensure we have products before creating slides
                        if (productsList.Count > 0)
                        {
                            // Calculate total slides - always create at least one slide
                            totalSlides = productsList.Count < itemsPerSlide 
                                ? 1 
                                : (int)Math.Ceiling(productsList.Count / (double)itemsPerSlide);
                            
                            for (int slideIndex = 0; slideIndex < totalSlides; slideIndex++)
                            {
                                var slideProducts = new List<Product>();
                                
                                // Use circular wrapping to always get exactly 4 items per slide
                                for (int i = 0; i < itemsPerSlide; i++)
                                {
                                    var productIndex = (slideIndex * itemsPerSlide + i) % productsList.Count;
                                    slideProducts.Add(productsList[productIndex]);
                                }
                                
                                if (!slideProducts.Any()) continue;
                            
                            <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                                <div class="row g-3 g-md-4">
                                    @foreach (var product in slideProducts)
                                    {
                                        var productName = currentCulture == "ar" && !string.IsNullOrEmpty(product.TitleAr) 
                                            ? product.TitleAr 
                                            : product.Title;
                                        
                                        // Calculate discount percentage
                                        var discountPercent = product.ListPrice > 0 
                                            ? (int)((product.ListPrice - product.Price) / product.ListPrice * 100) 
                                            : 0;
                                        
                                        // Get product image
                                        var productImages = product.ProductImages != null && product.ProductImages.Any() 
                                            ? product.ProductImages.OrderBy(pi => pi.DisplayOrder).Select(pi => pi.ImageUrl).ToList()
                                            : new List<string>();
                                        
                                        if (!productImages.Any() && !string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            productImages.Add(product.ImageUrl);
                                        }
                                        
                                        var productImage = productImages.FirstOrDefault() ?? "/images/no-image.png";
                                        
                                        // Preload first product image for LCP (first slide, first product)
                                        var isLcpImage = slideIndex == 0 && slideProducts.IndexOf(product) == 0;
                                        
                                        // Get best variant price if product has variants
                                        decimal? variantPrice = null;
                                        decimal? variantListPrice = null;
                                        if (product.HasVariants && product.ProductVariants != null && product.ProductVariants.Any())
                                        {
                                            var bestVariant = product.ProductVariants
                                                .Where(v => v.ListPrice > v.Price && v.StockQuantity > 0)
                                                .OrderByDescending(v => ((v.ListPrice - v.Price) / v.ListPrice) * 100)
                                                .FirstOrDefault();
                                            
                                            if (bestVariant != null)
                                            {
                                                variantPrice = (decimal)bestVariant.Price;
                                                variantListPrice = (decimal)bestVariant.ListPrice;
                                                discountPercent = variantListPrice > 0 
                                                    ? (int)((variantListPrice.Value - variantPrice.Value) / variantListPrice.Value * 100) 
                                                    : discountPercent;
                                            }
                                        }
                                        
                                        var displayPrice = variantPrice ?? (decimal)product.Price;
                                        var displayListPrice = variantListPrice ?? (decimal)product.ListPrice;
                                        
                                        // Check for active flash sale for this product (non-variant items only)
                                        var now = IdealWeightNutrition.Utility.DateTimeHelper.Now;
                                        var activeFlashSaleItem = activeFlashSales
                                            .SelectMany(fs => fs.FlashSaleItems ?? Enumerable.Empty<FlashSaleItem>())
                                            .FirstOrDefault(fsi => fsi.ProductId == product.Id 
                                                && fsi.ProductVariantId == null 
                                                && !fsi.IsDeleted 
                                                && fsi.FlashSaleQuantity > 0
                                                && fsi.FlashSale != null
                                                && fsi.FlashSale.IsActive
                                                && now >= fsi.FlashSale.StartDate
                                                && now <= fsi.FlashSale.EndDate);
                                        
                                        // If product has active flash sale, compare prices and use the lower one
                                        if (activeFlashSaleItem != null)
                                        {
                                            var flashSalePrice = (decimal)activeFlashSaleItem.FlashSalePrice;
                                            // Use flash sale price if it's lower than current display price
                                            if (flashSalePrice < displayPrice)
                                            {
                                                displayPrice = flashSalePrice;
                                                // Use product's original ListPrice (not product.Price) for old price
                                                if (product.ListPrice > 0)
                                                {
                                                    displayListPrice = (decimal)product.ListPrice;
                                                    discountPercent = (int)((displayListPrice - flashSalePrice) / displayListPrice * 100);
                                                }
                                                else if (product.Price > 0)
                                                {
                                                    displayListPrice = (decimal)product.Price;
                                                    discountPercent = (int)((product.Price - (double)flashSalePrice) / product.Price * 100);
                                                }
                                            }
                                        }
                                        
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <div class="offer-card h-100">
                                                <a href="@Url.Action("Details", "Home", new { area = "Customer", slug = product.GetSlug() })" class="offer-card-link">
                                                    <!-- Product Status Badges (NEW/TRENDING) -->
                                                    @if (product.IsTrending)
                                                    {
                                                        <div class="badge-trending">
                                                            <i class="bi bi-graph-up-arrow me-1"></i>
                                                            @Localizer["TrendingProducts"]
                                                        </div>
                                                    }
                                                    else if (product.IsNew)
                                                    {
                                                        <div class="badge-new">
                                                            <i class="bi bi-sparkles me-1"></i>
                                                            @Localizer["NewProducts"]
                                                        </div>
                                                    }
                                                    
                                                    @if (discountPercent > 0)
                                                    {
                                                        <div class="offer-badge">-@discountPercent%</div>
                                                    }
                                                    
                                                    <div class="offer-card-image">
                                                        <img src="@productImage" alt="@productName" class="img-fluid" loading="@(isLcpImage ? "eager" : "lazy")" width="300" height="300" fetchpriority="@(isLcpImage ? "high" : "low")" />
                                                    </div>
                                                    
                                                    <div class="offer-card-content">
                                                        <h3 class="offer-card-title">@productName</h3>
                                                        
                                                        <div class="offer-card-price">
                                                            <span class="offer-price-old">@Html.Raw(currencySymbol)@displayListPrice.ToString("N2")</span>
                                                            <span class="offer-price-new">@Html.Raw(currencySymbol)@displayPrice.ToString("N2")</span>
                                                        </div>
                                                        
                                                        @if (discountPercent > 0)
                                                        {
                                                            <div class="offer-save">
                                                                @Localizer["Save"] @Html.Raw(currencySymbol)@((displayListPrice - displayPrice).ToString("N2"))
                                                            </div>
                                                        }
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            }
                        }
                    }
                </div>
                
                <!-- Carousel Controls -->
                <button class="carousel-control-prev offers-carousel-control" type="button" data-bs-target="#offersCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@Localizer["Previous"]</span>
                </button>
                <button class="carousel-control-next offers-carousel-control" type="button" data-bs-target="#offersCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@Localizer["Next"]</span>
                </button>
                
                <!-- Carousel Indicators -->
                @if (totalSlides > 1)
                {
                    <div class="carousel-indicators offers-carousel-indicators">
                        @for (int i = 0; i < totalSlides; i++)
                        {
                            <button type="button" data-bs-target="#offersCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Services Section -->
@{
    var activeServices = ViewBag.ActiveServices as IEnumerable<IdealWeightNutrition.Models.ServiceSubscription> ?? Enumerable.Empty<IdealWeightNutrition.Models.ServiceSubscription>();
    var hasServices = activeServices.Any();
}

@if (hasServices)
{
    <section class="services-showcase-section">
        <div class="container">
            <div class="services-header">
                <div class="services-header-content">
                    <h2 class="services-title">
                        <i class="bi bi-briefcase-fill me-3"></i>
                        @Localizer["OurPremiumServices"]
                    </h2>
                    <p class="services-subtitle">@Localizer["DiscoverProfessionalServices"]</p>
                </div>
                <a asp-area="Customer" asp-controller="ServiceSubscription" asp-action="Index" class="view-all-services-btn">
                    @Localizer["ViewAllServices"]
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="services-grid">
                @foreach (var service in activeServices.Take(3))
                {
                    var activeOffers = _unitOfWork.ServiceOffers.GetAll(
                        o => o.ServiceSubscriptionId == service.Id && 
                             o.IsActive && 
                             o.StartDate <= IdealWeightNutrition.Utility.DateTimeHelper.Now && 
                             o.EndDate >= IdealWeightNutrition.Utility.DateTimeHelper.Now
                    ).ToList();
                    var hasOffer = activeOffers.Any();
                    var bestOffer = activeOffers.OrderByDescending(o => o.DiscountValue).FirstOrDefault();

                        var serviceTitle = (currentCulture == "ar" && !string.IsNullOrEmpty(service.TitleAr)) ? service.TitleAr : service.Title;
                        var serviceDescription = (currentCulture == "ar" && !string.IsNullOrEmpty(service.DescriptionAr)) ? service.DescriptionAr : service.Description;
                        var serviceDetailsUrl = Url.Action("Details", "ServiceSubscription", new { area = "Customer", id = service.Id });
                    
                    <div class="service-card-home">
                        <a href="@serviceDetailsUrl" class="service-card-image-link">
                            <div class="service-card-image-wrapper">
                            @{
                                var serviceImages = service.ServiceImages != null && service.ServiceImages.Any() 
                                    ? service.ServiceImages.OrderBy(si => si.DisplayOrder).Select(si => si.ImageUrl).ToList()
                                    : new List<string>();
                                
                                // If no ServiceImages but has ImageUrl, use that
                                if (!serviceImages.Any() && !string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    serviceImages.Add(service.ImageUrl);
                                }
                            }
                            
                            @if (serviceImages.Count > 1)
                            {
                                <div id="homeServiceCarousel_@service.Id" class="carousel slide service-home-carousel" data-bs-ride="carousel" data-bs-touch="true">
                                    <div class="carousel-inner">
                                        @for (int i = 0; i < serviceImages.Count; i++)
                                        {
                                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                                <img src="@serviceImages[i]" class="service-card-image" alt="@serviceTitle - Image @(i+1)" loading="lazy" width="400" height="300" />
                                            </div>
                                        }
                                    </div>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">@Localizer["Previous"]</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">@Localizer["Next"]</span>
                                    </button>
                                    <div class="carousel-indicators">
                                        @for (int i = 0; i < serviceImages.Count; i++)
                                        {
                                            <button type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)" onclick="event.stopPropagation();"></button>
                                        }
                                    </div>
                                </div>
                            }
                            else if (serviceImages.Count == 1)
                            {
                                <img src="@serviceImages[0]" class="service-card-image" alt="@serviceTitle" loading="lazy" width="400" height="300" />
                            }
                            else
                            {
                                <div class="service-card-image-placeholder">
                                    <i class="bi bi-briefcase"></i>
                                </div>
                            }
                            @if (hasOffer && bestOffer != null)
                            {
                                <div class="service-offer-badge">
                                    @if (bestOffer.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                    {
                                        <span>@bestOffer.DiscountValue% @Localizer["OFF"]</span>
                                    }
                                    else
                                    {
                                        <span>@Html.Raw(currencySymbol) @bestOffer.DiscountValue.ToString("N2") @Localizer["OFF"]</span>
                                    }
                                </div>
                            }
                                @if (service.ServiceType == IdealWeightNutrition.Models.ServiceType.Online)
                                {
                                    <div class="service-type-badge-home online">
                                        <i class="bi bi-globe"></i> @Localizer["Online"]
                                    </div>
                                }
                                else
                                {
                                    <div class="service-type-badge-home offline">
                                        <i class="bi bi-building"></i> @Localizer["Offline"]
                                    </div>
                                }
                                
                                <div class="service-image-overlay">
                                    <i class="bi bi-eye"></i>
                                    <span>@Localizer["ViewDetails"]</span>
                                </div>
                            </div>
                        </a>
                        <div class="service-card-content">
                            <h3 class="service-card-title">@serviceTitle</h3>
                            @if (!string.IsNullOrEmpty(serviceDescription))
                            {
                                <p class="service-card-description">
                                    @(serviceDescription.Length > 80 ? serviceDescription.Substring(0, 80) + "..." : serviceDescription)
                                </p>
                            }
                            <div class="service-card-pricing">
                                @if (hasOffer && bestOffer != null)
                                {
                                    decimal originalPrice = service.Price;
                                    decimal discount = 0;
                                    if (bestOffer.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                    {
                                        discount = originalPrice * (bestOffer.DiscountValue / 100);
                                    }
                                    else
                                    {
                                        discount = bestOffer.DiscountValue;
                                    }
                                    decimal finalPrice = originalPrice - discount;
                                    
                                    <span class="service-price-original">@Html.Raw(currencySymbol) @originalPrice.ToString("N2")</span>
                                    <span class="service-price-final">@Html.Raw(currencySymbol) @finalPrice.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="service-price-final">@Html.Raw(currencySymbol) @service.Price.ToString("N2")</span>
                                }
                            </div>
                            @if (service.ServiceType == IdealWeightNutrition.Models.ServiceType.Offline && service.OfflinePaymentPercent.HasValue)
                            {
                                <div class="service-payment-info">
                                    <small>
                                        <i class="bi bi-info-circle"></i> 
                                        @Localizer["PayPercentNow", service.OfflinePaymentPercent.Value, currencySymbol + " " + (service.Price * service.OfflinePaymentPercent.Value / 100).ToString("N2")]
                                    </small>
                                </div>
                            }
                            <a href="@serviceDetailsUrl" class="service-card-btn">
                                @Localizer["LearnMore"]
                                <i class="bi bi-arrow-@(isRtl ? "left" : "right") @(isRtl ? "me-2" : "ms-2")"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

