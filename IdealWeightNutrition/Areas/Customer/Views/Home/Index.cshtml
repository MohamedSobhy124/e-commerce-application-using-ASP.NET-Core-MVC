                        <span class="btn-select-options-text">@Localizer["SelectOptions"]</span>
                    </a>
                ` : (product.stockQuantity <= 0)
                    ? `<!-- Product out of stock - no add to cart button -->`
                    : `
                    <button class="btn-add-cart-quick ${product.isInCart ? 'in-cart' : ''}" 
                            data-product-id="${product.id}"
                            onclick="toggleCart(${product.id}, this); event.stopPropagation();" 
                            title="${product.isInCart ? 'In Cart' : 'Add to Cart'}">
                        <i class="bi ${product.isInCart ? 'bi-check-lg' : 'bi-cart-plus'}"></i>
                    </button>
                `;
                
                return `
                    <div class="product-card stagger-item" 
                         data-stock-quantity="${product.stockQuantity}" 
                         data-minimum-stock="${product.minimumStockAlert}"
                         data-product-id="${product.id}"
                         onclick="window.location.href='/Customer/Home/Details/${product.slug}'"
                         style="cursor: pointer;">
                        <div class="product-image-wrapper">
                            ${product.isTrending ? `
                                <div class="badge-trending">
                                    <i class="bi bi-graph-up-arrow me-1"></i>
                                    @Localizer["TrendingProducts"]
                                </div>
                            ` : product.isNew ? `
                                <div class="badge-new">
                                    <i class="bi bi-sparkles me-1"></i>
                                    @Localizer["NewProducts"]
                                </div>
                            ` : ''}
                            ${wishlistButton}
                            ${imageCarouselHtml}
                        </div>
                        <div class="product-content">
                            <h3 class="product-title">${productName}</h3>
                            <div class="product-card-rating" data-product-id="${product.id}">
                                <div class="product-card-stars">
                                    <i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i>
                                </div>
                                <span class="product-card-rating-text">(0)</span>
                                ${discount > 0 ? `<span class="discount-badge-rating">${discount}% ${currentCulture === 'ar' ? 'خصم' : 'OFF'}</span>` : ''}
                            </div>
                            <div class="price-actions-row" onclick="event.stopPropagation();">
                                ${product.stockQuantity > 0 ? `
                                    <div class="price-wrapper">
                                        <span class="current-price">
                                            ${product.hasVariants ? `<span class="price-from-text">${currentCulture === 'ar' ? 'من ' : 'From '}</span>` : ''}
                                            ${currencySymbol} ${product.price.toFixed(2)}
                                        </span>
                                    </div>
                                ` : `
                                    <div class="price-wrapper">
                                        <span class="text-muted" style="font-size: 0.9rem;">@Localizer["OutOfStock"]</span>
                                    </div>
                                `}
                                <div class="product-actions">${actionButton}</div>
                            </div>
                        </div>
                    </div>
                `;
            };
            
            // AJAX Pagination is now ready - using onclick handlers
            const paginationContainer = document.getElementById('paginationContainer');
            if (paginationContainer) {
            }
        });
    </script>
}

@section StructuredData {
    @{
        var homepageSchema = SEOHelper.GenerateHomePageStructuredData(baseUrl, "Ideal Weight Nutrition", siteDescription, currentCulture);
    }
    <script type="application/ld+json">
    @Html.Raw(homepageSchema)
    </script>
}
