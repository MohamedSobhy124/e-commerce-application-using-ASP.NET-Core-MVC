<!-- Customer Testimonials Section -->
@{
    var featuredTestimonials = ViewBag.FeaturedTestimonials as IEnumerable<IdealWeightNutrition.Models.Review> ?? Enumerable.Empty<IdealWeightNutrition.Models.Review>();
    var hasTestimonials = featuredTestimonials.Any();
}

@if (hasTestimonials)
{
    <section class="testimonials-section">
        <div class="container">
            <div class="testimonials-header text-center mb-5">
                <h2 class="testimonials-title">
                    <i class="bi bi-star-fill me-3"></i>
                    @if(currentCulture == "ar") {
                        <text>آراء عملائنا</text>
                    } else {
                        <text>Customer Testimonials</text>
                    }
                </h2>
                <p class="testimonials-subtitle">
                    @if(currentCulture == "ar") {
                        <text>اكتشف ما يقوله عملاؤنا عن منتجاتنا وخدماتنا</text>
                    } else {
                        <text>Discover what our customers say about our products and services</text>
                    }
                </p>
            </div>

            <!-- Bootstrap Carousel with Smooth Slide Effect -->
            <div id="testimonialsCarousel" class="carousel slide testimonials-carousel" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover" data-bs-touch="true">
                <div class="carousel-inner">
                    @{ 
                        int testimonialIndex = 0;
                    }
                    @foreach (var testimonial in featuredTestimonials)
                    {
                        try
                        {
                            var userName = testimonial?.User?.Name ?? "Customer";
                            var userLocation = !string.IsNullOrEmpty(testimonial?.User?.City) 
                                ? (testimonial.User.City + (!string.IsNullOrEmpty(testimonial.User.State) ? ", " + testimonial.User.State : ""))
                                : (currentCulture == "ar" ? "الإمارات العربية المتحدة" : "UAE");
                            
                            <div class="carousel-item @(testimonialIndex == 0 ? "active" : "")">
                                <div class="testimonial-card-wrapper">
                                    <div class="testimonial-card-inner">
                                        <!-- Rating Stars -->
                                        <div class="testimonial-rating mb-3">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= testimonial.Rating)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>

                                        <!-- Review Text -->
                                        <div class="testimonial-text mb-4">
                                            <p>"@testimonial.Comment"</p>
                                        </div>

                                        <!-- Customer Info -->
                                        <div class="testimonial-customer-info">
                                            <!-- Customer Avatar -->
                                            <div class="testimonial-avatar">
                                                <span>
                                                    @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "C")
                                                </span>
                                            </div>

                                            <!-- Customer Details -->
                                            <div class="testimonial-customer-details">
                                                <div class="testimonial-customer-name">
                                                    @userName
                                                </div>
                                                <div class="testimonial-customer-location">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    <span>@userLocation</span>
                                                </div>
                                            </div>

                                            <!-- Verified Purchase Badge -->
                                            @if (testimonial.IsVerifiedPurchase)
                                            {
                                                <div class="verified-badge">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <span>@if(currentCulture == "ar") { <text>شراء موثق</text> } else { <text>Verified Purchase</text> }</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        catch (Exception ex)
                        {
                            // Log error but continue rendering other testimonials
                            <div class="carousel-item @(testimonialIndex == 0 ? "active" : "")">
                                <div class="testimonial-card-wrapper">
                                    <div class="testimonial-card-inner">
                                        <p>Error loading testimonial</p>
                                    </div>
                                </div>
                            </div>
                        }
                        testimonialIndex++;
                    }
                </div>
                
                <!-- Carousel Controls -->
                <button class="carousel-control-prev testimonials-carousel-control" type="button" data-bs-target="#testimonialsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@Localizer["Previous"]</span>
                </button>
                <button class="carousel-control-next testimonials-carousel-control" type="button" data-bs-target="#testimonialsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@Localizer["Next"]</span>
                </button>
            </div>

            <!-- Carousel Indicators -->
            <div class="carousel-indicators testimonials-indicators">
                @for (int i = 0; i < featuredTestimonials.Count(); i++)
                {
                    <button type="button" data-bs-target="#testimonialsCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                }
            </div>
        </div>
    </section>
}
 
