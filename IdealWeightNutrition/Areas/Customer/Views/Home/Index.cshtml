                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                            <div class="carousel-indicators">
                                ${productImages.map((img, idx) => `
                                    <button type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide-to="${idx}" class="${idx === 0 ? 'active' : ''}"></button>
                                `).join('')}
                            </div>
                        </div>
                    `;
                } else {
                    imageCarouselHtml = `<img src="${firstImage}" class="product-image" alt="${productName}" />`;
                }
                
                const wishlistButton = isAuthenticated ? `
                    <button class="wishlist-btn ${product.isInWishlist ? 'active' : ''}" 
                            data-product-id="${product.id}" 
                            onclick="toggleWishlist(${product.id}, this); event.stopPropagation();"
                            title="${product.isInWishlist ? 'Remove from wishlist' : 'Add to wishlist'}">
                        <i class="bi ${product.isInWishlist ? 'bi-heart-fill' : 'bi-heart'}"></i>
                    </button>
                ` : '';
                
                const actionButton = product.hasVariants ? `
                    <a href="/Customer/Home/Details/${product.slug}" class="btn-select-options">
