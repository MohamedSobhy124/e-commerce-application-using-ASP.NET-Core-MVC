        // Pagination State
        let paginationState = {
            currentPage: @((ViewBag.CurrentPage ?? 1).ToString()),
            totalPages: @((ViewBag.TotalPages ?? 1).ToString()),
            totalProducts: @((ViewBag.TotalProducts ?? 0).ToString()),
            pageSize: @((ViewBag.PageSize ?? 20).ToString()),
            isLoading: false
        };
        
        
        // Update pagination UI after AJAX load (define before loadPage uses it)
        function updatePaginationUI(data) {
            const paginationContainer = document.getElementById('paginationContainer');
            if (!paginationContainer) {
                return;
            }
            
            try {
                const currentCulture = '@currentCulture';
                const isRTL = currentCulture === 'ar';
                
                // Calculate page range
                let startPage = Math.max(1, data.currentPage - 2);
                let endPage = Math.min(data.totalPages, data.currentPage + 2);
                
                // Adjust range to show 5 pages if possible
                if (endPage - startPage < 4) {
                    if (startPage === 1) {
                        endPage = Math.min(data.totalPages, startPage + 4);
                    } else if (endPage === data.totalPages) {
                        startPage = Math.max(1, endPage - 4);
                    }
                }
                
                // Build base URL for pagination (crawlable URLs)
                const currentPath = window.location.pathname;
                const urlParams = new URLSearchParams(window.location.search);
                urlParams.delete('page'); // Remove page parameter as we'll add it dynamically
                const baseQueryString = urlParams.toString();
                const querySeparator = baseQueryString ? '&' : '?';
                const getPageUrl = (pageNum) => {
                    return `${currentPath}?page=${pageNum}${baseQueryString ? querySeparator + baseQueryString : ''}`;
                };
                
                // Rebuild pagination HTML
                let paginationHTML = `
                    <div class="pagination-wrapper">
                        <!-- Page Info -->
                        <div class="pagination-info">
                            <span class="page-info-text">
                                ${isRTL ? 'صفحة' : 'Page'} ${data.currentPage} ${isRTL ? 'من' : 'of'} ${data.totalPages}
                            </span>
                            <span class="total-products-info">
                                ${isRTL ? `(${data.totalProducts} منتج)` : `(${data.totalProducts} products)`}
                            </span>
                        </div>
                        
                        <!-- Pagination Controls -->
                        <nav aria-label="Product pagination" class="pagination-nav">
                            <ul class="pagination-list">
                `;
                
                // First page button
                if (data.currentPage > 1) {
                    paginationHTML += `
                        <li class="pagination-item">
                            <a href="${getPageUrl(1)}" onclick="event.preventDefault(); loadPage(1); return false;" class="pagination-link pagination-link-icon" title="${isRTL ? 'الصفحة الأولى' : 'First Page'}">
                                <i class="bi bi-chevron-double-${isRTL ? 'right' : 'left'}"></i>
                            </a>
                        </li>
                        <li class="pagination-item">
                            <a href="${getPageUrl(data.currentPage - 1)}" onclick="event.preventDefault(); loadPage(${data.currentPage - 1}); return false;" class="pagination-link pagination-link-icon" title="${isRTL ? 'السابق' : 'Previous'}">
                                <i class="bi bi-chevron-${isRTL ? 'right' : 'left'}"></i>
                            </a>
                        </li>
                    `;
                } else {
                    paginationHTML += `
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-double-${isRTL ? 'right' : 'left'}"></i>
                            </span>
                        </li>
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-${isRTL ? 'right' : 'left'}"></i>
                            </span>
                        </li>
                    `;
                }
                
                // Ellipsis before
                if (startPage > 1) {
                    paginationHTML += `<li class="pagination-item d-none d-md-block"><span class="pagination-ellipsis">...</span></li>`;
                }
                
                // Page numbers
                for (let i = startPage; i <= endPage; i++) {
                    if (i === data.currentPage) {
                        paginationHTML += `<li class="pagination-item"><span class="pagination-link active">${i}</span></li>`;
                    } else {
                        paginationHTML += `<li class="pagination-item"><a href="${getPageUrl(i)}" onclick="event.preventDefault(); loadPage(${i}); return false;" class="pagination-link">${i}</a></li>`;
                    }
                }
                
                // Ellipsis after
                if (endPage < data.totalPages) {
                    paginationHTML += `<li class="pagination-item d-none d-md-block"><span class="pagination-ellipsis">...</span></li>`;
                }
                
                // Next and Last buttons
                if (data.currentPage < data.totalPages) {
                    paginationHTML += `
                        <li class="pagination-item">
                            <a href="${getPageUrl(data.currentPage + 1)}" onclick="event.preventDefault(); loadPage(${data.currentPage + 1}); return false;" class="pagination-link pagination-link-icon" title="${isRTL ? 'التالي' : 'Next'}">
                                <i class="bi bi-chevron-${isRTL ? 'left' : 'right'}"></i>
                            </a>
                        </li>
                        <li class="pagination-item">
                            <a href="${getPageUrl(data.totalPages)}" onclick="event.preventDefault(); loadPage(${data.totalPages}); return false;" class="pagination-link pagination-link-icon" title="${isRTL ? 'الصفحة الأخيرة' : 'Last Page'}">
                                <i class="bi bi-chevron-double-${isRTL ? 'left' : 'right'}"></i>
                            </a>
                        </li>
                    `;
                } else {
                    paginationHTML += `
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-${isRTL ? 'left' : 'right'}"></i>
                            </span>
                        </li>
                        <li class="pagination-item">
                            <span class="pagination-link pagination-link-icon disabled">
                                <i class="bi bi-chevron-double-${isRTL ? 'left' : 'right'}"></i>
                            </span>
                        </li>
                    `;
                }
                
                paginationHTML += `
                            </ul>
                        </nav>
                        
                        <!-- Quick Jump -->
                        <div class="pagination-jump d-none d-lg-flex">
                            <label for="pageJump" class="jump-label">
                                ${isRTL ? 'اذهب إلى:' : 'Go to:'}
                            </label>
                            <input type="number" id="pageJump" class="jump-input" min="1" max="${data.totalPages}" value="${data.currentPage}" onkeypress="if(event.key === 'Enter') jumpToPage(this.value)">
                            <button onclick="jumpToPage(document.getElementById('pageJump').value)" class="jump-button" title="${isRTL ? 'انتقال' : 'Jump'}">
                                <i class="bi bi-arrow-${isRTL ? 'left' : 'right'}"></i>
                            </button>
                        </div>
                    </div>
                `;
                
                // Replace pagination content
                paginationContainer.innerHTML = paginationHTML;
                
            } catch (error) {
                console.error('Error updating pagination UI:', error);
            }
        }
        
        // AJAX Pagination Function - Load page without reload
        async function loadPage(pageNumber) {
            if (paginationState.isLoading) {
                return;
            }
            
            const page = parseInt(pageNumber);
            if (isNaN(page) || page < 1 || page > paginationState.totalPages) {
                console.warn('Invalid page number:', page);
                return;
            }
            
            if (page === paginationState.currentPage) {
                return;
            }
            
            paginationState.isLoading = true;
            
            const productContainer = document.getElementById('productContainer');
            const paginationContainer = document.getElementById('paginationContainer');
            
            if (!productContainer) {
                console.error('Product container not found');
                paginationState.isLoading = false;
                return;
            }
            
            // Show loading state
            productContainer.classList.add('pagination-loading');
            if (paginationContainer) {
                paginationContainer.classList.add('pagination-loading');
            }
            
            // Build URL parameters for AJAX request only (keeps browser URL clean)
            const ajaxParams = new URLSearchParams();
            ajaxParams.set('page', page);
            ajaxParams.set('pageSize', paginationState.pageSize);
            
            // Preserve any filters that were applied via AJAX or URL
            // Check if filters are stored in JavaScript state
            if (window.currentFilters) {
                if (window.currentFilters.categoryId) ajaxParams.set('categoryId', window.currentFilters.categoryId);
                if (window.currentFilters.brandId) ajaxParams.set('brandId', window.currentFilters.brandId);
                if (window.currentFilters.searchTerm) ajaxParams.set('searchTerm', window.currentFilters.searchTerm);
                if (window.currentFilters.sortBy) ajaxParams.set('sortBy', window.currentFilters.sortBy);
                if (window.currentFilters.minPrice) ajaxParams.set('minPrice', window.currentFilters.minPrice);
                if (window.currentFilters.maxPrice) ajaxParams.set('maxPrice', window.currentFilters.maxPrice);
                if (window.currentFilters.availability) ajaxParams.set('availability', window.currentFilters.availability);
                if (window.currentFilters.productFilter) ajaxParams.set('productFilter', window.currentFilters.productFilter);
            } else {
                // Fallback: Preserve filters from URL (initial page load filters)
                const currentParams = new URLSearchParams(window.location.search);
                if (currentParams.has('categoryId')) ajaxParams.set('categoryId', currentParams.get('categoryId'));
                if (currentParams.has('brandId')) ajaxParams.set('brandId', currentParams.get('brandId'));
                if (currentParams.has('searchTerm')) ajaxParams.set('searchTerm', currentParams.get('searchTerm'));
                if (currentParams.has('sortBy')) ajaxParams.set('sortBy', currentParams.get('sortBy'));
                if (currentParams.has('minPrice')) ajaxParams.set('minPrice', currentParams.get('minPrice'));
                if (currentParams.has('maxPrice')) ajaxParams.set('maxPrice', currentParams.get('maxPrice'));
                if (currentParams.has('availability')) ajaxParams.set('availability', currentParams.get('availability'));
            }
            
            const ajaxUrl = '/Customer/Home/GetPaginatedProducts?' + ajaxParams.toString();
            
            try {
                const response = await fetch(ajaxUrl);
                if (!response.ok) {
                    throw new Error('Failed to load products');
                }
                
                const data = await response.json();
                
                // Fade out current products
                const productCards = productContainer.querySelectorAll('.product-card');
                productCards.forEach((card, index) => {
                    setTimeout(() => {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                    }, index * 20);
                });
                
                // Wait for fade out animation
                await new Promise(resolve => setTimeout(resolve, 400));
                
                // Clear products
                productContainer.innerHTML = '';
                
                // Add new products
                if (data.products && data.products.length > 0) {
                    data.products.forEach((product, index) => {
                        const productHtml = createProductCardFromData(product);
                        productContainer.insertAdjacentHTML('beforeend', productHtml);
                    });
                    
                    // Fade in new products
                    const newProductCards = productContainer.querySelectorAll('.product-card');
                    newProductCards.forEach((card, index) => {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(() => {
                            card.classList.add('visible');
                            card.style.opacity = '';
                            card.style.transform = '';
                        }, index * 50);
                    });
                    
                    // Load ratings for new products
                    if (typeof loadAllProductRatings === 'function') {
                        setTimeout(() => loadAllProductRatings(), 500);
                    }
                } else {
                    const noProductsMsg = '@Html.Raw(Localizer["NoProductsFound"].ToString().Replace("'", "\\'"))';
                    productContainer.innerHTML = '<div class="text-center py-5" style="grid-column: 1 / -1;"><i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i><p class="mt-3 text-muted">' + noProductsMsg + '</p></div>';
                }
                
                // Update pagination state
                paginationState.currentPage = data.currentPage;
                paginationState.totalPages = data.totalPages;
                paginationState.totalProducts = data.totalProducts;
                
                // Update hasMoreProducts for infinite scroll (if variable exists)
                if (typeof hasMoreProducts !== 'undefined') {
                    hasMoreProducts = (data.currentPage || 1) < (data.totalPages || 1);
                }
                
                // Update pagination UI
                updatePaginationUI(data);
                
                // DON'T update URL - keep it clean!
                // URL stays as: /Customer/Home/Index (no query params)
                
                // Scroll to products section smoothly
                const productsSection = document.getElementById('productsSection');
                if (productsSection) {
                    const headerOffset = 100;
                    const elementPosition = productsSection.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    
                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
                
            } catch (error) {
                console.error('Error loading page:', error);
                const errorMessage = 'Error loading products';
                const retryBtn = '<button class="btn btn-primary mt-3" onclick="loadPage(' + page + ')">Retry</button>';
                productContainer.innerHTML = '<div class="text-center py-5" style="grid-column: 1 / -1;"><i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i><p class="mt-3 text-danger">' + errorMessage + '</p>' + retryBtn + '</div>';
            } finally {
                paginationState.isLoading = false;
                productContainer.classList.remove('pagination-loading');
                if (paginationContainer) {
                    paginationContainer.classList.remove('pagination-loading');
                }
            }
        }
        
        // Jump to page function (for quick jump input)
        function jumpToPage(pageNumber) {
            const page = parseInt(pageNumber);
            const jumpInput = document.getElementById('pageJump');
            
            if (isNaN(page) || page < 1 || page > paginationState.totalPages) {
                if (jumpInput) {
                    jumpInput.classList.add('is-invalid');
                    setTimeout(() => jumpInput.classList.remove('is-invalid'), 2000);
                }
                return;
            }
            
            loadPage(page);
        }
        
        // Ensure pagination links work with full page reload (not AJAX)
        document.addEventListener('DOMContentLoaded', function() {
