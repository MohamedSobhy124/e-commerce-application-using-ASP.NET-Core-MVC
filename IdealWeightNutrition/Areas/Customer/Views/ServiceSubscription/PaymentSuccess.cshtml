@model IdealWeightNutrition.Models.ServicePurchase
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["PaymentSuccess"] ?? "Payment Success";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var isRtl = currentCulture.StartsWith("ar");
    
    // Format currency with language-specific symbol
    Func<decimal, string> formatCurrency = (amount) => $"{currencySymbol} {amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture).Replace(".", ",")}";
    
    // Helper function to translate payment status
    Func<string, string> translatePaymentStatus = (status) =>
    {
        if (string.IsNullOrEmpty(status)) return Localizer["Pending"]?.Value ?? "Pending";
        var translated = Localizer[status]?.Value;
        return translated ?? status;
    };
}

<div class="container py-5" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="success-card text-center">
                <div class="success-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h1 class="success-title">@(Localizer["PaymentSuccessful"] ?? "Payment Successful!")</h1>
                <p class="success-message">@(Localizer["ServiceSubscriptionConfirmed"] ?? "Your service subscription has been confirmed.")</p>

                <div class="purchase-details mt-5">
                    <div class="detail-card">
                        <h3>@(Localizer["PurchaseDetails"] ?? "Purchase Details")</h3>
                        <div class="detail-row">
                            <span>@(Localizer["PurchaseID"] ?? "Purchase ID"):</span>
                            <strong>#@Model.Id</strong>
                        </div>
                        <div class="detail-row">
                            <span>@(Localizer["Service"] ?? "Service"):</span>
                            <strong>@(Model.ServiceSubscription != null ? (currentCulture == "ar" && !string.IsNullOrEmpty(Model.ServiceSubscription.TitleAr) ? Model.ServiceSubscription.TitleAr : Model.ServiceSubscription.Title) : "")</strong>
                        </div>
                        <div class="detail-row">
                            <span>@(Localizer["TotalAmount"] ?? "Total Amount"):</span>
                            <strong>@formatCurrency(Model.TotalAmount)</strong>
                        </div>
                        <div class="detail-row">
                            <span>@(Localizer["AmountPaid"] ?? "Amount Paid"):</span>
                            <strong class="text-success">@formatCurrency(Model.AmountPaid)</strong>
                        </div>
                        @if (Model.ServiceSubscription?.ServiceType == IdealWeightNutrition.Models.ServiceType.Offline)
                        {
                            <div class="detail-row">
                                <span>@(Localizer["RemainingAmount"] ?? "Remaining Amount"):</span>
                                <strong>@formatCurrency(Model.TotalAmount - Model.AmountPaid)</strong>
                            </div>
                            @if (Model.ServiceSubscription.OfflinePaymentPercent.HasValue)
                            {
                                var minRequired = Model.TotalAmount * (Model.ServiceSubscription.OfflinePaymentPercent.Value / 100);
                                if (Model.AmountPaid > minRequired)
                                {
                                    <div class="alert alert-success mt-3">
                                        <i class="bi bi-check-circle"></i> 
                                        @(string.Format(Localizer["PaidMoreThanMinimum"]?.Value ?? "You paid {0} more than the minimum required. Thank you!", formatCurrency(Model.AmountPaid - minRequired)))
                                    </div>
                                }
                            }
                            <div class="alert alert-info mt-3">
                                <i class="bi bi-info-circle"></i> 
                                @(string.Format(Localizer["PayRemainingAtLocation"]?.Value ?? "You will pay the remaining amount of {0} at the service location.", formatCurrency(Model.TotalAmount - Model.AmountPaid)))
                            </div>
                        }
                        <div class="detail-row">
                            <span>@(Localizer["PurchaseDate"] ?? "Purchase Date"):</span>
                            <strong>@Model.PurchaseDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo(currentCulture)) @(Localizer["At"] ?? "at") @Model.PurchaseDate.ToString("HH:mm", System.Globalization.CultureInfo.GetCultureInfo(currentCulture))</strong>
                        </div>
                        <div class="detail-row">
                            <span>@(Localizer["Status"] ?? "Status"):</span>
                            <span class="badge bg-success">@translatePaymentStatus(Model.PaymentStatus)</span>
                        </div>
                    </div>
                </div>

                <div class="action-buttons mt-5">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg @(isRtl ? "ms-3" : "me-3")">
                        <i class="bi bi-house @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["GoToHome"] ?? "Go to Home")
                    </a>
                    <a asp-area="Customer" asp-controller="ServiceSubscription" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-briefcase @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["ViewMoreServices"] ?? "View More Services")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .success-icon {
        font-size: 5rem;
        color: #10b981;
        margin-bottom: 20px;
        animation: scaleIn 0.5s ease;
    }

    .success-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 15px;
    }

    .success-message {
        font-size: 1.2rem;
        color: #6b7280;
    }

    .purchase-details {
        text-align: left;
    }

    [dir="rtl"] .purchase-details {
        text-align: right;
    }

    .detail-card {
        background: #f9fafb;
        border-radius: 15px;
        padding: 30px;
        border: 2px solid #e5e7eb;
    }

    .detail-card h3 {
        color: #1f2937;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #e5e7eb;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .action-buttons {
        margin-top: 30px;
    }

    @@keyframes scaleIn {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }

    @@media (max-width: 768px) {
        .success-card {
            padding: 30px 20px;
        }

        .success-title {
            font-size: 2rem;
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .action-buttons .btn {
            width: 100%;
            margin: 0 !important;
        }
    }
</style>
