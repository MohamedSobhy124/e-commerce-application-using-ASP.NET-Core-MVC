@model IdealWeightNutrition.Models.ServiceSubscription
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    // ViewData["Title"] is set by controller based on current language
    var activeOffers = ViewBag.ActiveOffers as IEnumerable<IdealWeightNutrition.Models.ServiceOffer> ?? Enumerable.Empty<IdealWeightNutrition.Models.ServiceOffer>();
    var promoCodes = ViewBag.PromoCode as IEnumerable<IdealWeightNutrition.Models.PromoCode> ?? Enumerable.Empty<IdealWeightNutrition.Models.PromoCode>();
    bool isGuest = !User.Identity.IsAuthenticated;
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var isRtl = currentCulture.StartsWith("ar");
    
    // Format currency with language-specific symbol
    Func<decimal, string> formatCurrency = (amount) => $"{currencySymbol} {amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture).Replace(".", ",")}";
    
    var serviceTitle = currentCulture == "ar" && !string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleAr : Model.Title;
    var serviceDescription = currentCulture == "ar" && !string.IsNullOrEmpty(Model.DescriptionAr) ? Model.DescriptionAr : Model.Description;
    
    decimal finalPrice = Model.Price;
    decimal discountAmount = 0;
    int? selectedOfferId = null;

    if (activeOffers.Any())
    {
        var bestOffer = activeOffers.OrderByDescending(o => o.DiscountValue).First();
        selectedOfferId = bestOffer.Id;
        
        if (bestOffer.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
        {
            discountAmount = Model.Price * (bestOffer.DiscountValue / 100);
        }
        else
        {
            discountAmount = bestOffer.DiscountValue;
        }
        finalPrice = Model.Price - discountAmount;
    }
}

<!-- Breadcrumb Section -->
<section class="breadcrumb-section" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb-modern">
                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="bi bi-house-door"></i>
                        <span>@(Localizer["Home"] ?? "Home")</span>
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index">
                        <i class="bi bi-heart-pulse"></i>
                        <span>@(Localizer["Services"] ?? "Services")</span>
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    <span>@serviceTitle</span>
                </li>
            </ol>
        </nav>
    </div>
</section>

<div class="service-details-page" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="container py-5">
        <div class="row g-4 g-lg-5">
            <!-- Main Content Column -->
            <div class="col-lg-8">
                <!-- Image Gallery Card -->
                <div class="gallery-card animate-fade-in">
                    @{
                        var serviceImages = Model.ServiceImages != null && Model.ServiceImages.Any() 
                            ? Model.ServiceImages.OrderBy(si => si.DisplayOrder).Select(si => si.ImageUrl).ToList()
                            : new List<string>();
                        
                        if (!serviceImages.Any() && !string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            serviceImages.Add(Model.ImageUrl);
                        }
                    }
                    
                    <!-- Badges -->
                    <div class="gallery-badges">
                        @if (Model.ServiceType == IdealWeightNutrition.Models.ServiceType.Online)
                        {
                            <div class="service-badge online">
                                <i class="bi bi-wifi"></i>
                                <span>@(Localizer["OnlineService"] ?? "Online Service")</span>
                            </div>
                        }
                        else
                        {
                            <div class="service-badge offline">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@(Localizer["OfflineService"] ?? "Offline Service")</span>
                            </div>
                        }
                        
                        @if (discountAmount > 0)
                        {
                            var bestOffer = activeOffers.OrderByDescending(o => o.DiscountValue).First();
                            <div class="discount-badge">
                                <i class="bi bi-lightning-fill"></i>
                                @if (bestOffer.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                {
                                    <span>@bestOffer.DiscountValue% @(Localizer["OFF"] ?? "OFF")</span>
                                }
                                else
                                {
                                    <span>@formatCurrency(bestOffer.DiscountValue) @(Localizer["OFF"] ?? "OFF")</span>
                                }
                            </div>
                        }
                    </div>
                    
                    @if (serviceImages.Count > 1)
                    {
                        <div id="serviceDetailsCarousel" class="carousel slide gallery-carousel" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @{
                                    var serviceTitleForAlt = currentCulture == "ar" && !string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleAr : Model.Title;
                                }
                                @for (int i = 0; i < serviceImages.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <div class="gallery-image-wrapper">
                                            <img src="@serviceImages[i]" class="gallery-image" alt="@serviceTitleForAlt - @(Localizer["Image"] ?? "Image") @(i+1)" loading="@(i == 0 ? "eager" : "lazy")" />
                                        </div>
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#serviceDetailsCarousel" data-bs-slide="prev">
                                <span class="carousel-nav-btn"><i class="bi bi-chevron-left"></i></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#serviceDetailsCarousel" data-bs-slide="next">
                                <span class="carousel-nav-btn"><i class="bi bi-chevron-right"></i></span>
                            </button>
                            <div class="carousel-indicators gallery-indicators">
                                @for (int i = 0; i < serviceImages.Count; i++)
                                {
                                    <button type="button" data-bs-target="#serviceDetailsCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="@(Localizer["Slide"] ?? "Slide") @(i+1)"></button>
                                }
                            </div>
                        </div>
                        
                        <!-- Thumbnail Navigation -->
                        <div class="thumbnail-nav">
                            @for (int i = 0; i < serviceImages.Count; i++)
                            {
                                <button class="thumbnail-item @(i == 0 ? "active" : "")" data-bs-target="#serviceDetailsCarousel" data-bs-slide-to="@i">
                                    <img src="@serviceImages[i]" alt="@(Localizer["Thumbnail"] ?? "Thumbnail") @(i+1)" />
                                </button>
                            }
                        </div>
                    }
                    else if (serviceImages.Count == 1)
                    {
                        var serviceTitleForAlt = currentCulture == "ar" && !string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleAr : Model.Title;
                        <div class="gallery-single-image">
                            <img src="@serviceImages[0]" class="gallery-image" alt="@serviceTitleForAlt" loading="lazy" />
                        </div>
                    }
                    else
                    {
                        <div class="gallery-placeholder">
                            <div class="placeholder-content">
                                <div class="placeholder-icon">
                                    <i class="bi bi-heart-pulse"></i>
                                </div>
                                <span>@(Localizer["HealthService"] ?? "Health Service")</span>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Service Info Card -->
                <div class="info-card animate-slide-up">
                    <div class="info-card-header">
                        <h1 class="service-main-title">@serviceTitle</h1>
                        <div class="title-decoration"></div>
                    </div>
                    
                    <!-- Features Grid -->
                    <div class="features-grid">
                        <div class="feature-box">
                            <div class="feature-icon">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                            <div class="feature-text">
                                <strong>@(Localizer["CertifiedExperts"] ?? "Certified Experts")</strong>
                                <span>@(Localizer["ProfessionalTeam"] ?? "Professional Team")</span>
                            </div>
                        </div>
                        <div class="feature-box">
                            <div class="feature-icon">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                            <div class="feature-text">
                                <strong>@(Localizer["FlexibleSchedule"] ?? "Flexible Schedule")</strong>
                                <span>@(Localizer["BookAnytime"] ?? "Book Anytime")</span>
                            </div>
                        </div>
                        <div class="feature-box">
                            <div class="feature-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div class="feature-text">
                                <strong>@(Localizer["Guaranteed"] ?? "Guaranteed")</strong>
                                <span>@(Localizer["QualityService"] ?? "Quality Service")</span>
                            </div>
                        </div>
                        <div class="feature-box">
                            <div class="feature-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div class="feature-text">
                                <strong>@(Localizer["Support"] ?? "Support")</strong>
                                <span>@(Localizer["AlwaysAvailable"] ?? "Always Available")</span>
                            </div>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(serviceDescription))
                    {
                        <div class="description-section">
                            <div class="section-header">
                                <div class="section-icon">
                                    <i class="bi bi-file-text"></i>
                                </div>
                                <h3>@(Localizer["AboutThisService"] ?? "About This Service")</h3>
                            </div>
                            <div class="description-content">
                                <p>@serviceDescription</p>
                            </div>
                        </div>
                    }
                    
                    <!-- What's Included Section -->
                    <div class="included-section">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="bi bi-check2-square"></i>
                            </div>
                            <h3>@(Localizer["WhatsIncluded"] ?? "What's Included")</h3>
                        </div>
                        <div class="included-list">
                            <div class="included-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@(Localizer["PersonalizedPlan"] ?? "Personalized Plan")</span>
                            </div>
                            <div class="included-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@(Localizer["ExpertGuidance"] ?? "Expert Guidance")</span>
                            </div>
                            <div class="included-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@(Localizer["ProgressTracking"] ?? "Progress Tracking")</span>
                            </div>
                            <div class="included-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@(Localizer["OngoingSupport"] ?? "Ongoing Support")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar Column -->
            <div class="col-lg-4">
                <div class="purchase-card-wrapper">
                    <div class="purchase-card animate-slide-up-delay">
                        <!-- Card Header -->
                        <div class="purchase-header">
                            <div class="header-pattern"></div>
                            <div class="header-content">
                                <div class="header-icon">
                                    <i class="bi bi-bag-check"></i>
                                </div>
                                <h3>@(Localizer["SubscriptionDetails"] ?? "Subscription Details")</h3>
                                <p>@(Localizer["SecureCheckout"] ?? "Secure & Easy Checkout")</p>
                            </div>
                        </div>
                        
                        <!-- Card Body -->
                        <div class="purchase-body">
                            <!-- Pricing Section -->
                            <div class="pricing-block">
                                <div class="price-line">
                                    <span class="price-label">
                                        <i class="bi bi-tag"></i>
                                        @(Localizer["ServicePrice"] ?? "Service Price")
                                    </span>
                                    <span class="price-value">@formatCurrency(Model.Price)</span>
                                </div>
                                
                                @if (discountAmount > 0)
                                {
                                    <div class="price-line discount-line">
                                        <span class="price-label">
                                            <i class="bi bi-percent"></i>
                                            @(Localizer["Discount"] ?? "Discount")
                                        </span>
                                        <span class="price-value discount-value">-@formatCurrency(discountAmount)</span>
                                    </div>
                                }
                                
                                <div class="total-line">
                                    <span class="total-label">@(Localizer["TotalAmount"] ?? "Total Amount")</span>
                                    <div class="total-price-wrapper">
                                        @if (discountAmount > 0)
                                        {
                                            <span class="original-price">@formatCurrency(Model.Price)</span>
                                        }
                                        <span class="total-price">@formatCurrency(finalPrice)</span>
                                    </div>
                                </div>
                                
                                @if (Model.ServiceType == IdealWeightNutrition.Models.ServiceType.Offline && Model.OfflinePaymentPercent.HasValue)
                                {
                                    decimal minAmountToPay = finalPrice * (Model.OfflinePaymentPercent.Value / 100);
                                    <div class="minimum-payment-box">
                                        <div class="min-payment-header">
                                            <i class="bi bi-info-circle-fill"></i>
                                            <span>@(Localizer["MinimumPaymentRequired"] ?? "Minimum Payment Required")</span>
                                        </div>
                                        <div class="min-payment-amount">
                                            <span class="percent-badge">@Model.OfflinePaymentPercent.Value%</span>
                                            <span class="amount">@formatCurrency(minAmountToPay)</span>
                                        </div>
                                        <p class="min-payment-note">
                                            @(Localizer["OfflinePaymentNote"] ?? "Pay the remaining amount at the service location")
                                        </p>
                                    </div>
                                }
                            </div>
                            
                            <!-- Active Offers -->
                            @if (activeOffers.Any())
                            {
                                <div class="offers-block">
                                    <div class="offers-header">
                                        <i class="bi bi-lightning-charge-fill"></i>
                                        <span>@(Localizer["ActiveOffers"] ?? "Active Offers")</span>
                                    </div>
                                    <div class="offers-list">
                                        @foreach (var offer in activeOffers)
                                        {
                                            <div class="offer-card">
                                                <div class="offer-icon">
                                                    <i class="bi bi-gift-fill"></i>
                                                </div>
                                                <div class="offer-details">
                                                    <strong>
                                                        @if (offer.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                                        {
                                                            @offer.DiscountValue@:% @(Localizer["OFF"] ?? "OFF")
                                                        }
                                                        else
                                                        {
                                                            @formatCurrency(offer.DiscountValue) @(Localizer["OFF"] ?? "OFF")
                                                        }
                                                    </strong>
                                                    <span>@(Localizer["ValidUntil"] ?? "Valid Until") @offer.EndDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.GetCultureInfo(currentCulture))</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            
                            <!-- CTA Button -->
                            <div class="cta-section">
                                @{
                                    var routeValues = new Dictionary<string, string> { { "id", Model.Id.ToString() } };
                                    if (selectedOfferId.HasValue)
                                    {
                                        routeValues.Add("offerId", selectedOfferId.Value.ToString());
                                    }
                                }
                                <a asp-action="ServiceSummary" asp-all-route-data="routeValues" class="btn-checkout" id="proceedToCheckoutBtn">
                                    <span class="btn-text">@(Localizer["ProceedToCheckout"] ?? "Proceed to Checkout")</span>
                                    <span class="btn-icon">
                                        <i class="bi bi-arrow-@(isRtl ? "left" : "right")"></i>
                                    </span>
                                </a>
                                <div class="checkout-note">
                                    <i class="bi bi-shield-lock"></i>
                                    <span>@(Localizer["CompletePaymentOnNextPage"] ?? "You will complete payment on the next page")</span>
                                </div>
                            </div>
                            
                            <!-- Trust Badges -->
                            <div class="trust-badges">
                                <div class="trust-item">
                                    <i class="bi bi-lock-fill"></i>
                                    <span>@(Localizer["SecurePayment"] ?? "Secure Payment")</span>
                                </div>
                                <div class="trust-item">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span>@(Localizer["EasyRefund"] ?? "Easy Refund")</span>
                                </div>
                                <div class="trust-item">
                                    <i class="bi bi-headset"></i>
                                    <span>@(Localizer["Support"] ?? "24/7 Support")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ========================================
       BASE STYLES
       ======================================== */
    .service-details-page {
        background: linear-gradient(180deg, #f8fdf6 0%, #ffffff 100%);
        min-height: 100vh;
    }

    /* ========================================
       BREADCRUMB SECTION
       ======================================== */
    .breadcrumb-section {
        background: linear-gradient(135deg, #e8f5e1 0%, #d4edda 100%);
        padding: 20px 0;
        border-bottom: 1px solid rgba(123, 192, 67, 0.2);
    }

    .breadcrumb-modern {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .breadcrumb-modern .breadcrumb-item {
        display: flex;
        align-items: center;
    }

    .breadcrumb-modern .breadcrumb-item a {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #4a6332;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .breadcrumb-modern .breadcrumb-item a:hover {
        color: #7BC043;
    }

    .breadcrumb-modern .breadcrumb-item a i {
        font-size: 1rem;
    }

    .breadcrumb-modern .breadcrumb-item:not(:last-child)::after {
        content: '/';
        margin-left: 8px;
        color: #9ca3af;
    }

    [dir="rtl"] .breadcrumb-modern .breadcrumb-item:not(:last-child)::after {
        content: '\\';
        margin-left: 0;
        margin-right: 8px;
    }

    .breadcrumb-modern .breadcrumb-item.active span {
        color: #1f2937;
        font-weight: 600;
    }

    /* ========================================
       GALLERY CARD
       ======================================== */
    .gallery-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        position: relative;
        margin-bottom: 30px;
    }

    .gallery-badges {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 20;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    [dir="rtl"] .gallery-badges {
        left: auto;
        right: 20px;
    }

    .service-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 30px;
        font-size: 0.9rem;
        font-weight: 700;
        color: white;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .service-badge.online {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.95) 0%, rgba(5, 150, 105, 0.95) 100%);
    }

    .service-badge.offline {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.95) 0%, rgba(37, 99, 235, 0.95) 100%);
    }

    .discount-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 30px;
        font-size: 0.9rem;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        box-shadow: 0 4px 20px rgba(239, 68, 68, 0.35);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .gallery-carousel {
        height: 500px;
        background: #f8fafc;
    }

    .gallery-carousel .carousel-inner,
    .gallery-carousel .carousel-item {
        height: 100%;
    }

    .gallery-image-wrapper {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 20px;
    }

    .gallery-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 12px;
        transition: transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .gallery-card:hover .gallery-image {
        transform: scale(1.03);
    }

    .carousel-nav-btn {
        width: 50px;
        height: 50px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #374151;
        font-size: 1.2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
    }

    .carousel-control-prev:hover .carousel-nav-btn,
    .carousel-control-next:hover .carousel-nav-btn {
        background: linear-gradient(135deg, #7BC043 0%, #6ba836 100%);
        color: white;
        transform: scale(1.1);
    }

    .carousel-control-prev,
    .carousel-control-next {
        width: 10%;
        opacity: 1;
    }

    .gallery-indicators {
        margin-bottom: 20px;
    }

    .gallery-indicators button {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.6);
        border: 2px solid white;
        margin: 0 5px;
        transition: all 0.3s ease;
    }

    .gallery-indicators button.active {
        background: #7BC043;
        transform: scale(1.3);
    }

    .gallery-single-image {
        height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        padding: 30px;
    }

    .gallery-placeholder {
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f5e1 0%, #d4edda 100%);
    }

    .placeholder-content {
        text-align: center;
    }

    .placeholder-icon {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #7BC043 0%, #6ba836 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 3.5rem;
        color: white;
        box-shadow: 0 10px 40px rgba(123, 192, 67, 0.35);
    }

    .placeholder-content span {
        color: #4a6332;
        font-weight: 600;
        font-size: 1.1rem;
    }

    /* Thumbnail Navigation */
    .thumbnail-nav {
        display: flex;
        gap: 12px;
        padding: 20px;
        background: white;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: #7BC043 #f1f5f9;
    }

    .thumbnail-nav::-webkit-scrollbar {
        height: 6px;
    }

    .thumbnail-nav::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }

    .thumbnail-nav::-webkit-scrollbar-thumb {
        background: #7BC043;
        border-radius: 3px;
    }

    .thumbnail-item {
        flex-shrink: 0;
        width: 80px;
        height: 80px;
        border-radius: 12px;
        overflow: hidden;
        border: 3px solid transparent;
        padding: 0;
        background: white;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .thumbnail-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .thumbnail-item:hover,
    .thumbnail-item.active {
        border-color: #7BC043;
        transform: scale(1.05);
    }

    /* ========================================
       INFO CARD
       ======================================== */
    .info-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        padding: 40px;
    }

