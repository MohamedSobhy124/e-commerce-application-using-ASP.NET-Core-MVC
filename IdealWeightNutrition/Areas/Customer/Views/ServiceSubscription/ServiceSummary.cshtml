                var currencySymbol = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currencySymbol));
                var formatted = parseFloat(amount).toFixed(2).replace('.', ',');
                return currencySymbol + ' ' + formatted;
            }
            
