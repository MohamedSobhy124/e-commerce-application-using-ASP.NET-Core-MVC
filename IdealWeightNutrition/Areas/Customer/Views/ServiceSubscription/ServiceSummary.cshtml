@model IdealWeightNutrition.Models.ViewModels.ServiceSummaryVM
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["ServiceCheckout"] ?? "Service Checkout";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var isRtl = currentCulture.StartsWith("ar");
    Func<decimal, string> formatCurrency = (amount) => $"{currencySymbol} {amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture).Replace(".", ",")}";
    
    // Payment method flags
    bool tamaraEnabled = ViewData["TamaraEnabled"] != null && (bool)ViewData["TamaraEnabled"];
    bool tamaraAvailable = ViewData["TamaraAvailable"] != null && (bool)ViewData["TamaraAvailable"];
    string tamaraPublicKey = ViewData["TamaraPublicKey"]?.ToString() ?? "";
    decimal tamaraOrderTotal = ViewData["TamaraOrderTotal"] != null ? (decimal)ViewData["TamaraOrderTotal"] : 0;
    decimal tamaraMinimumAmount = ViewData["TamaraMinimumAmount"] != null ? (decimal)ViewData["TamaraMinimumAmount"] : 400m;
    bool tabbyEnabled = ViewData["TabbyEnabled"] != null && (bool)ViewData["TabbyEnabled"];
    bool tabbyAvailable = ViewData["TabbyAvailable"] != null && (bool)ViewData["TabbyAvailable"];
    decimal tabbyMinimumAmount = ViewData["TabbyMinimumAmount"] != null ? (decimal)ViewData["TabbyMinimumAmount"] : 400m;
    bool hasAlternativePayments = tabbyEnabled || tamaraEnabled;
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart-summary-enhanced.css" asp-append-version="true" />
    <style>
        /* Hide Geidea error modals and show our SweetAlert instead */
        [class*="geidea"] [class*="error"],
        [id*="geidea"] [class*="error"],
        [class*="Geidea"] [class*="error"],
        [id*="Geidea"] [class*="error"],
        [class*="geidea"] [class*="rejected"],
        [id*="geidea"] [class*="rejected"],
        [class*="Geidea"] [class*="rejected"],
        [id*="Geidea"] [class*="rejected"] {
            display: none !important;
            visibility: hidden !important;
        }
        
        /* Ensure SweetAlert is always on top */
        .swal2-container {
            z-index: 99999 !important;
        }
        
        .swal2-backdrop-show {
            z-index: 99998 !important;
        }
    </style>
}

<form method="post" id="serviceOrderForm" novalidate>
    <div class="order-summary-wrapper" dir="@(isRtl ? "rtl" : "ltr")">
        <div class="container">
            <div class="order-summary-card">
                <div class="order-summary-header">
                    <h5 class="order-summary-title">
                        <i class="bi bi-briefcase @(isRtl ? "ms-2" : "me-2")"></i>
                        @(Localizer["ServiceCheckout"] ?? "Service Checkout")
                    </h5>
                    <a asp-action="Details" asp-route-id="@Model.Service.Id" class="back-to-cart-btn">
                        <i class="bi bi-arrow-@(isRtl ? "right" : "left") @(isRtl ? "ms-2" : "me-2")"></i>
                        @(Localizer["Back"] ?? "Back")
                    </a>
                </div>

                <div class="order-summary-body">
                    <div class="row">
                        <div class="col-12 col-lg-6 pb-4">
                            <div class="shipping-details-section">
                                <h4>
                                    <i class="bi bi-person @(isRtl ? "ms-2" : "me-2")"></i>
                                    @(Localizer["CustomerInformation"] ?? "Customer Information")
                                </h4>
                                
                                @if (Model.IsGuest || !User.Identity.IsAuthenticated)
                                {
                                    <div class="alert alert-info-enhanced">
                                        <div class="alert-icon">
                                            <i class="bi bi-info-circle-fill"></i>
                                        </div>
                                        <div class="alert-content">
                                            <strong>@(Localizer["GuestCheckout"] ?? "Guest Checkout")</strong>
                                            <p class="mb-0">@(Localizer["GuestCheckoutInfo"] ?? "You can complete your purchase without creating an account")</p>
                                        </div>
                                    </div>
                                    <div class="form-row-enhanced">
                                        <label class="form-label-enhanced">
                                            <i class="bi bi-envelope-fill @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["EmailAddress"] ?? "Email Address") <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="GuestEmail" type="email" id="guestEmailInput" class="form-control-enhanced" placeholder="@(Localizer["EnterYourEmail"] ?? "Enter your email")" required />
                                        <span asp-validation-for="GuestEmail" class="text-danger validation-message"></span>
                                        <div id="emailValidationMessage" class="validation-error-message text-danger small mt-1" style="display: none;"></div>
                                    </div>
                                    
                                    <!-- Email Verification OTP Section -->
                                    <div id="emailVerificationSection" class="form-row-enhanced" style="display: none; margin-top: 15px; padding: 20px; background: #f0f9ff; border-radius: 8px; border: 2px solid #0ea5e9;">
                                        <div class="d-flex align-items-center mb-3">
                                            <i class="bi bi-shield-check text-primary @(isRtl ? "ms-2" : "me-2")" style="font-size: 1.5rem;"></i>
                                            <div>
                                                <strong style="color: #0369a1;">@(Localizer["VerifyYourEmail"] ?? "Verify Your Email")</strong>
                                                <p class="mb-0 text-muted small">@(Localizer["VerifyEmailDescription"] ?? "We need to verify your email address to complete your order. A verification code will be sent to your email.")</p>
                                            </div>
                                        </div>
                                        
                                        <div id="otpSendSection">
                                            <button type="button" id="sendOtpBtn" class="btn btn-primary btn-sm" style="border-radius: 6px;">
                                                <i class="bi bi-send @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["SendVerificationCode"] ?? "Send Verification Code")
                                            </button>
                                            <div id="otpSendMessage" class="mt-2 small" style="display: none;"></div>
                                        </div>
                                        
                                        <div id="otpVerifySection" style="display: none; margin-top: 15px;">
                                            <label class="form-label-enhanced small">
                                                <i class="bi bi-key @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["EnterVerificationCode"] ?? "Enter Verification Code") <span class="text-danger">*</span>
                                            </label>
                                            <div class="d-flex gap-2">
                                                <input type="text" id="otpInput" class="form-control-enhanced" placeholder="000000" maxlength="6" style="text-align: center; font-size: 1.2rem; letter-spacing: 4px; font-weight: bold; font-family: monospace;" />
                                                <button type="button" id="verifyOtpBtn" class="btn btn-success btn-sm" style="border-radius: 6px; min-width: 100px;">
                                                    <i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["Verify"] ?? "Verify")
                                                </button>
                                            </div>
                                            <div id="otpVerifyMessage" class="mt-2 small" style="display: none;"></div>
                                            <div class="mt-2">
                                                <button type="button" id="resendOtpBtn" class="btn btn-link btn-sm p-0 text-primary" style="font-size: 0.85rem; text-decoration: none;">
                                                    <i class="bi bi-arrow-clockwise @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["ResendCode"] ?? "Resend Code")
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <div id="emailVerifiedSection" style="display: none; margin-top: 15px;">
                                            <div class="alert alert-success mb-0" style="border-radius: 6px;">
                                                <i class="bi bi-check-circle-fill @(isRtl ? "ms-2" : "me-2")"></i>
                                                <strong>@(Localizer["EmailVerified"] ?? "Email Verified")</strong>
                                            </div>
                                        </div>
                                        
                                        <!-- Create Account Checkbox -->
                                        <div class="form-row-enhanced mt-3" id="createAccountSection" style="display: none;">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="createAccountCheckbox" name="CreateAccountForGuest" value="true" />
                                                <label class="form-check-label" for="createAccountCheckbox">
                                                    <i class="bi bi-person-plus @(isRtl ? "ms-2" : "me-2")"></i>
                                                    @(Localizer["CreateAccountForFutureOrders"]?.Value ?? "Create an account for faster checkout on future orders")
                                                </label>
                                            </div>
                                            <small class="text-muted d-block mt-2">
                                                @(Localizer["CreateAccountDescription"]?.Value ?? "You'll be able to track your orders and save your information for next time.")
                                            </small>
                                        </div>
                                    </div>
                                }
                                
                                <div class="form-row-enhanced">
                                    <label class="form-label-enhanced">
                                        <i class="bi bi-person-fill me-2"></i>@(Localizer["Name"] ?? "Name") <span class="text-danger">*</span>
                                    </label>
                                    @if (Model.IsGuest)
                                    {
                                        <input asp-for="GuestName" class="form-control-enhanced" placeholder="@(Localizer["EnterYourName"] ?? "Enter your name")" required />
                                        <span asp-validation-for="GuestName" class="text-danger validation-message"></span>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control-enhanced" value="@(Model.User?.Name ?? "")" readonly />
                                    }
                                </div>

                                <div class="form-row-enhanced">
                                    <label class="form-label-enhanced">
                                        <i class="bi bi-telephone-fill me-2"></i>@(Localizer["Phone"] ?? "Phone") <span class="text-danger">*</span>
                                    </label>
                                    @if (Model.IsGuest)
                                    {
                                        <input asp-for="GuestPhone" class="form-control-enhanced" placeholder="@(Localizer["EnterYourPhone"] ?? "Enter your phone")" />
                                        <span asp-validation-for="GuestPhone" class="text-danger validation-message"></span>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control-enhanced" value="@(Model.User?.PhoneNumber ?? "")" readonly />
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="order-items-section">
                                <h4>
                                    <i class="bi bi-briefcase @(isRtl ? "ms-2" : "me-2")"></i>
                                    @(Localizer["ServiceDetails"] ?? "Service Details")
                                </h4>
                                
                                <div class="service-item-card">
                                    @{
                                        var serviceImage = Model.Service.ServiceImages?.FirstOrDefault()?.ImageUrl ?? Model.Service.ImageUrl;
                                        var serviceTitle = currentCulture == "ar" && !string.IsNullOrEmpty(Model.Service.TitleAr) ? Model.Service.TitleAr : Model.Service.Title;
                                        var serviceDescription = currentCulture == "ar" && !string.IsNullOrEmpty(Model.Service.DescriptionAr) ? Model.Service.DescriptionAr : Model.Service.Description;
                                    }
                                    @if (!string.IsNullOrEmpty(serviceImage))
                                    {
                                        <img src="@serviceImage" alt="@serviceTitle" class="service-summary-image" />
                                    }
                                    <div class="service-summary-content">
                                        <h5>@serviceTitle</h5>
                                        @if (!string.IsNullOrEmpty(serviceDescription))
                                        {
                                            <p class="text-muted small">@serviceDescription</p>
                                        }
                                        @if (Model.Service.ServiceType == IdealWeightNutrition.Models.ServiceType.Online)
                                        {
                                            <span class="badge bg-success">@(Localizer["OnlineService"] ?? "Online Service")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@(Localizer["OfflineService"] ?? "Offline Service")</span>
                                        }
                                    </div>
                                </div>

                                <!-- Pricing Summary -->
                                <div class="pricing-summary mt-3">
                                    <div class="price-row">
                                        <span>@(Localizer["ServicePrice"] ?? "Service Price"):</span>
                                        <span id="servicePriceDisplay">@formatCurrency(Model.Service.Price)</span>
                                    </div>
                                    <div class="price-row discount" style="display: @(Model.DiscountAmount > 0 ? "flex" : "none");">
                                        <span>@(Localizer["Discount"] ?? "Discount"):</span>
                                        <span class="text-success" id="discountAmountDisplay">-@formatCurrency(Model.DiscountAmount)</span>
                                    </div>
                                    <div class="price-row total">
                                        <span>@(Localizer["TotalAmount"] ?? "Total Amount"):</span>
                                        <strong class="text-primary" id="totalAmountDisplay">@formatCurrency(Model.TotalAmount)</strong>
                                    </div>
                                    @if (Model.Service.ServiceType == IdealWeightNutrition.Models.ServiceType.Offline && Model.MinAmountRequired > 0)
                                    {
                                        <div class="alert alert-warning mt-3">
                                            <i class="bi bi-info-circle"></i>
                                            @(Localizer["MinimumAmountToPayNow", Model.Service.OfflinePaymentPercent.Value] ?? $"Minimum Amount to Pay Now ({Model.Service.OfflinePaymentPercent.Value}%):") <strong>@formatCurrency(Model.MinAmountRequired)</strong>
                                        </div>
                                        <div class="form-row-enhanced mt-3 amount-input-section">
                                            <label class="form-label-enhanced">
                                                @(Localizer["AmountToPayNow"] ?? "Amount to Pay Now") *
                                                <small class="text-muted d-block mt-1">(@(Localizer["Minimum"] ?? "Minimum"): @formatCurrency(Model.MinAmountRequired))</small>
                                            </label>
                                            <div class="input-group amount-input-group">
                                                <span class="input-group-text">@currencySymbol</span>
                                                <input asp-for="CustomAmount" type="number" id="CustomAmount" class="form-control form-control-enhanced" 
                                                       step="0.01" 
                                                       data-min-amount="@Model.MinAmountRequired.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                                       data-max-amount="@Model.TotalAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                       data-min-formatted="@formatCurrency(Model.MinAmountRequired)"
                                                       data-max-formatted="@formatCurrency(Model.TotalAmount)"
                                                       value="@Model.MinAmountRequired.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                            </div>
                                            <span asp-validation-for="CustomAmount" class="text-danger validation-message"></span>
                                            <div id="customAmountValidationMessage" class="validation-error-message text-danger small mt-1" style="display: none;"></div>
                                        </div>
                                    }
                                </div>

                                <!-- Promo Code Section -->
                                <div class="promo-code-section mt-4">
                                    <h4>
                                        <i class="bi bi-tag @(isRtl ? "ms-2" : "me-2")"></i>
                                        @(Localizer["PromoCode"] ?? "Promo Code")
                                    </h4>
                                    <div class="promo-code-input-group">
                                        <input type="text" asp-for="PromoCode" class="form-control form-control-enhanced" placeholder="@(Localizer["EnterPromoCode"] ?? "Enter promo code")" />
                                        <button type="button" id="applyPromoBtn" class="btn btn-primary promo-apply-btn">
                                            <i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i> @(Localizer["Apply"] ?? "Apply")
                                        </button>
                                    </div>
                                    <div id="promoCodeMessage" class="mt-2"></div>
                                </div>

                                @{
                                    bool isFreeSubscription = Model.TotalAmount <= 0.01m;
                                }
                                
                                @if (isFreeSubscription)
                                {
                                    <!-- Free Subscription Notice -->
                                    <div class="alert alert-success mt-4" style="border-left: 4px solid #10b981; background: #f0fdf4;">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-gift-fill text-success @(isRtl ? "ms-2" : "me-2")" style="font-size: 1.5rem;"></i>
                                            <div>
                                                <strong>@(Localizer["FreeSubscription"] ?? "Free Subscription!")</strong>
                                                <p class="mb-0">@(Localizer["FreeSubscriptionMessage"] ?? "This service is completely free. Click the button below to complete your subscription without payment.")</p>
                                            </div>
                                        </div>
                                    </div>
                                    <input type="hidden" name="PaymentMethod" value="FREE" />
                                }
                                else
                                {
                                    <!-- Payment Method Selection -->
                                    <div class="payment-method-section mt-4">
                                        <h4>
                                            <i class="bi bi-credit-card @(isRtl ? "ms-2" : "me-2")"></i>
                                            @(Localizer["PaymentMethod"] ?? "Payment Method")
                                        </h4>
                                        
                                        <!-- Primary Payment Method - Geidea -->
                                        <div class="payment-methods-primary">
                                            <div class="payment-method-option payment-method-primary">
                                                <input type="radio" id="paymentGeidea" name="PaymentMethod" value="Geidea" checked />
                                                <label for="paymentGeidea" class="payment-method-label-primary">
                                                    <div class="payment-primary-icon">
                                                        <i class="bi bi-credit-card-fill"></i>
                                                    </div>
                                                    <div class="payment-primary-content">
                                                        <span class="payment-primary-title">@(Localizer["CreditDebitCard"] ?? "Credit/Debit Card")</span>
                                                        <small class="payment-primary-desc">Visa, Mastercard, Apple Pay, Google Pay</small>
                                                    </div>
                                                    <div class="payment-primary-logos">
                                                        <img src="~/Images/payment-methods.png" alt="Payment Methods" class="payment-logos-img" />
                                                    </div>
                                                    <div class="payment-check-indicator">
                                                        <i class="bi bi-check-lg"></i>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                        
                                        <!-- Alternative Payment Methods - Tabby & Tamara -->
                                        <div class="payment-methods-alternative" id="alternativePayments" style="@(hasAlternativePayments && (tabbyAvailable || tamaraAvailable) ? "" : "display: none;")">
                                            <div class="alternative-payments-divider">
                                                <span>@(Localizer["OrPayWith"] ?? "Or pay with")</span>
                                            </div>
                                            <div class="payment-alternatives-grid">
                                                <!-- Tabby Payment -->
                                                <div class="payment-method-option payment-method-alt" id="tabbyPaymentOption" style="@(tabbyAvailable ? "" : "display: none;")">
                                                    <input type="radio" id="paymentTabby" name="PaymentMethod" value="Tabby" />
                                                    <label for="paymentTabby" class="payment-method-label-alt">
                                                        <div class="payment-alt-logo">
                                                            <img src="~/Images/tappy.png" alt="Tabby" class="payment-logo-img" />
                                                        </div>
                                                        <div class="payment-alt-content">
                                                            <span class="payment-alt-title">Tabby</span>
                                                            <small class="payment-alt-desc">@(Localizer["PayIn4Installments"] ?? "Pay in 4 installments")</small>
                                                        </div>
                                                        <div class="payment-alt-check">
                                                            <i class="bi bi-check-lg"></i>
                                                        </div>
                                                    </label>
                                                </div>
                                                
                                                <!-- Tamara Payment -->
                                                <div class="payment-method-option payment-method-alt" id="tamaraPaymentOption" style="@(tamaraAvailable ? "" : "display: none;")">
                                                    <input type="radio" id="paymentTamara" name="PaymentMethod" value="Tamara" />
                                                    <label for="paymentTamara" class="payment-method-label-alt">
                                                        <div class="payment-alt-logo">
                                                            <img src="~/Images/tamara.png" alt="Tamara" class="payment-logo-img" />
                                                        </div>
                                                        <div class="payment-alt-content">
                                                            <span class="payment-alt-title">Tamara</span>
                                                            <small class="payment-alt-desc">@(Localizer["BuyNowPayLater"] ?? "Buy Now Pay Later")</small>
                                                        </div>
                                                        <div class="payment-alt-check">
                                                            <i class="bi bi-check-lg"></i>
                                                        </div>
                                                    </label>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(tamaraPublicKey) && tamaraOrderTotal > 0 && tamaraAvailable)
                                            {
                                                <!-- Tamara Widget V2 - Checkout Page -->
                                                <div id="tamara-widget-checkout-page" data-public-key="@tamaraPublicKey" 
                                                     data-amount="@tamaraOrderTotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                                     data-currency="AED" data-country="AE" data-widget-type="checkout_page" 
                                                     style="margin-top: 15px;"></div>
                                            }
                                        </div>
                                        
                                        <div class="payment-minimum-notice" id="paymentMinimumNotice" style="display: none;">
                                            <i class="bi bi-info-circle @(isRtl ? "ms-2" : "me-2")"></i>
                                            <span id="paymentMinimumNoticeText"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="order-summary-footer-enhanced">
                    <div class="footer-content-wrapper">
                        @{
                             isFreeSubscription = Model.TotalAmount <= 0.01m;
                        }
                        <button type="submit" class="place-order-btn-enhanced" id="placeOrderBtn">
                            <span class="btn-content">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <span class="btn-text">@(isFreeSubscription ? (Localizer["CompleteSubscription"] ?? "Complete Subscription") : (Localizer["ProceedToPayment"] ?? "Proceed to Payment"))</span>
                                <span class="btn-loader" style="display: none;">
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>@(Localizer["Processing"] ?? "Processing")...</span>
                                </span>
                            </span>
                            <span class="btn-shine"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <input type="hidden" asp-for="ServiceId" value="@Model.Service.Id" />
    @if (ViewBag.OfferId != null)
    {
        <input type="hidden" asp-for="OfferId" value="@ViewBag.OfferId" />
    }
    @Html.AntiForgeryToken()
</form>

<style>
    .service-item-card {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        background: white;
        border-radius: 10px;
        border: 1px solid #e0e0e0;
        margin-bottom: 1rem;
    }
    
    .service-summary-image {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
    }
    
    .service-summary-content {
        flex: 1;
    }
    
    .pricing-summary {
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 10px;
    }
    
    .price-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #e0e0e0;
    }
    
    .price-row.discount {
        color: #059669;
    }
    
    .price-row.total {
        border-top: 2px solid #e0e0e0;
        margin-top: 0.5rem;
        padding-top: 0.75rem;
        font-size: 1.1rem;
    }
    
    /* Validation error styles */
    .is-invalid {
        border-color: #dc2626 !important;
        background-color: #fef2f2 !important;
    }
    
    .is-invalid:focus {
        border-color: #dc2626 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 38, 38, 0.25) !important;
    }
    
    .validation-error-message {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #dc2626;
    }
    
    .payment-method-section.border-danger {
        border-color: #dc2626 !important;
        background-color: #fef2f2 !important;
    }
    
    /* ===== Payment Method Section - Modern Design ===== */
    .payment-method-section {
        margin-top: 2rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .payment-method-section h4 {
        color: #1e40af;
        font-weight: 700;
        margin-bottom: 1.25rem;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
    }

    .payment-method-section h4 i {
        color: #3b82f6;
    }

    /* Primary Payment Method - Geidea */
    .payment-methods-primary {
        margin-bottom: 0;
    }

    .payment-method-primary {
        position: relative;
    }

    .payment-method-option input[type="radio"] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .payment-method-label-primary {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .payment-primary-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
