                            } else if (response.redirectUrl) {
                                // Redirect to payment URL for payment methods that redirect (Tamara, Tabby)
                                window.location.href = response.redirectUrl;
                            } else {
                                // Unexpected response format
                                window.location.reload();
                            }
                        } else {
                            // Error response
                            Swal.fire({
