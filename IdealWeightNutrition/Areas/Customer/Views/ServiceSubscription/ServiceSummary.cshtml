                            if (response.paymentMethod === 'FREE' && response.redirectUrl) {
                                // Redirect to payment success page for free subscriptions
                                window.location.href = response.redirectUrl;
                                return;
                            }
                            
                            // Handle Geidea v2 HPP payment
                            if (response.paymentMethod === 'Geidea' && response.sessionId) {
                                // Store purchaseId for redirect after payment
                                var purchaseId = response.purchaseId;
                                // Use Geidea v2 HPP JavaScript library
                                initiateGeideaPayment(response.sessionId, purchaseId, function(success) {
                                    if (success && purchaseId) {
                                        // Payment completed successfully, redirect to payment success page
                                        window.location.href = '@Url.Action("PaymentSuccess", "ServiceSubscription")?purchaseId=' + purchaseId;
