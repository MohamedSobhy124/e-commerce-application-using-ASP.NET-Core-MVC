        // Geidea v2 HPP Payment Integration
        function initiateGeideaPayment(sessionId, purchaseId, callback) {
            // Load Geidea HPP v2 library if not already loaded
            if (typeof GeideaCheckout === 'undefined') {
                var script = document.createElement('script');
                script.src = 'https://payments.geidea.ae/hpp/geideaCheckout.min.js';
                script.onload = function() {
                    startGeideaPayment(sessionId, purchaseId, callback);
                };
                script.onerror = function() {
                    Swal.fire({
                        icon: 'error',
                        title: translations.PaymentError,
                        text: translations.FailedToLoadPaymentLibrary,
                        confirmButtonText: translations.OK
                    });
                    if (callback) callback(false);
                };
                document.head.appendChild(script);
            } else {
                startGeideaPayment(sessionId, purchaseId, callback);
            }
        }

        function startGeideaPayment(sessionId, purchaseId, callback) {
            try {
                // Set up a MutationObserver to detect Geidea error messages in their modal
                var errorObserver = null;
                var errorDetected = false;
                
                // Function to close Geidea modal - defined at function scope so it can be used everywhere
                function closeGeideaModal() {
                    try {
                        // Remove all possible Geidea elements
                        var allSelectors = [
                            '*[class*="geidea"]',
                            '*[id*="geidea"]',
                            '*[class*="Geidea"]',
                            '*[id*="Geidea"]',
                            '*[class*="modal"]',
                            '*[class*="overlay"]',
                            '*[class*="popup"]',
                            '*[class*="dialog"]',
                            '*[class*="payment"]',
                            '*[class*="checkout"]',
                            'iframe'
                        ];
                        
                        allSelectors.forEach(function(selector) {
                            try {
                                var elements = document.querySelectorAll(selector);
                                elements.forEach(function(el) {
                                    if (el) {
                                        el.style.cssText = 'display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; z-index: -1 !important;';
                                        try {
                                            if (el.parentNode) {
                                                el.parentNode.removeChild(el);
                                            }
                                        } catch (e) {
                                            // Ignore
                                        }
                                    }
                                });
                            } catch (e) {
                                // Ignore
                            }
                        });
                        
                        // Restore body styles
                        document.body.style.overflow = '';
                        document.body.style.position = '';
                        document.body.style.height = '';
                        
                        // Remove any fixed positioning that might block
                        var fixedElements = document.querySelectorAll('[style*="position: fixed"], [style*="position:fixed"]');
                        fixedElements.forEach(function(el) {
                            if (el && el.style && (el.style.zIndex > 1000 || el.classList.toString().toLowerCase().includes('geidea'))) {
                                el.style.display = 'none';
                            }
                        });
                    } catch (e) {
                        console.error('Error closing Geidea modal:', e);
                    }
                }
                
                // Function to detect and show Geidea errors in SweetAlert
                function detectGeideaModalError() {
                    if (errorDetected) return; // Prevent multiple alerts
                    
                    // Search in all possible locations including iframes
                    function searchInElement(element) {
                        var errorTexts = [];
                        var errorKeywords = [
                            'payer authentication rejected',
                            'authentication rejected',
                            'payment rejected',
                            'transaction declined',
                            'card declined',
                            'رفض',
                            'فشل',
                            'declined',
                            'rejected',
                            'failed',
                            'error'
                        ];
                        
                        // Get all text content
                        var allText = '';
                        try {
                            allText = (element.textContent || element.innerText || element.value || '').toLowerCase();
                        } catch (e) {
                            return [];
                        }
                        
                        // Check for error keywords
                        errorKeywords.forEach(function(keyword) {
                            if (allText.includes(keyword.toLowerCase())) {
                                // Find the element containing this text
                                var walker = document.createTreeWalker(
                                    element,
                                    NodeFilter.SHOW_TEXT,
                                    null,
                                    false
                                );
                                
                                var node;
                                while (node = walker.nextNode()) {
                                    var text = node.textContent || '';
                                    if (text.toLowerCase().includes(keyword.toLowerCase())) {
                                        // Get parent element to get full context
                                        var parent = node.parentElement;
                                        if (parent) {
                                            var fullText = parent.textContent || parent.innerText || text;
                                            if (fullText.trim().length > 0 && fullText.trim().length < 500) {
                                                errorTexts.push(fullText.trim());
                                            }
                                        }
                                    }
                                }
                            }
                        });
                        
                        return errorTexts;
                    }
                    
                    // Search in main document
                    var mainErrors = searchInElement(document.body);
                    
                    // Search in all iframes (Geidea might use iframe)
                    var iframes = document.querySelectorAll('iframe');
                    iframes.forEach(function(iframe) {
                        try {
                            var iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
                            if (iframeDoc && iframeDoc.body) {
                                var iframeErrors = searchInElement(iframeDoc.body);
                                mainErrors = mainErrors.concat(iframeErrors);
                            }
                        } catch (e) {
                            // Cross-origin iframe, can't access
                        }
                    });
                    
                    // Also search by looking for common error patterns in visible text
                    var allElements = document.querySelectorAll('*');
                    allElements.forEach(function(el) {
                        try {
                            var text = (el.textContent || el.innerText || '').toLowerCase();
                            if (text && (
                                text.includes('payer authentication rejected') ||
                                text.includes('authentication rejected') ||
                                (text.includes('rejected') && (text.includes('payer') || text.includes('payment') || text.includes('authentication')))
                            )) {
                                var fullText = (el.textContent || el.innerText || '').trim();
                                if (fullText.length > 0 && fullText.length < 500 && !mainErrors.includes(fullText)) {
                                    mainErrors.push(fullText);
                                }
                            }
                        } catch (e) {
                            // Ignore errors
                        }
                    });
                    
                    if (mainErrors.length > 0 && !errorDetected) {
                        errorDetected = true;
                        // Use the first meaningful error message
                        var errorMessage = mainErrors[0];
                        
                        // Clean up the error message - remove extra whitespace
                        errorMessage = errorMessage.replace(/\s+/g, ' ').trim();
                        
                        // Close Geidea modal/overlay - more aggressive approach
                        try {
                            // Try multiple methods to close Geidea modal
                            var selectors = [
                                '[class*="geidea"]',
                                '[id*="geidea"]',
                                '[class*="Geidea"]',
                                '[id*="Geidea"]',
                                '[class*="modal"]',
                                '[class*="overlay"]',
                                '[class*="popup"]',
                                '[class*="dialog"]',
                                '[class*="payment"]',
                                '[class*="checkout"]'
                            ];
                            
                            selectors.forEach(function(selector) {
                                try {
                                    var elements = document.querySelectorAll(selector);
                                    elements.forEach(function(el) {
                                        if (el.style) {
                                            el.style.display = 'none !important';
                                            el.style.visibility = 'hidden !important';
                                            el.style.opacity = '0 !important';
                                            el.style.pointerEvents = 'none !important';
                                            el.style.zIndex = '-1 !important';
                                        }
                                        // Also try to remove from DOM
                                        try {
                                            if (el.parentNode) {
                                                el.parentNode.removeChild(el);
                                            }
                                        } catch (e) {
                                            // Ignore removal errors
                                        }
                                    });
                                } catch (e) {
                                    // Ignore
                                }
                            });
                            
                            // Remove all iframes that might be Geidea's payment iframe
                            var iframes = document.querySelectorAll('iframe');
                            iframes.forEach(function(iframe) {
                                try {
                                    iframe.style.display = 'none';
                                    iframe.style.visibility = 'hidden';
                                    if (iframe.parentNode) {
                                        iframe.parentNode.removeChild(iframe);
                                    }
                                } catch (e) {
                                    // Ignore
                                }
                            });
                            
                            // Remove backdrop/overlay elements
                            var backdrops = document.querySelectorAll('[class*="backdrop"], [class*="Backdrop"], [class*="mask"], [class*="Mask"]');
                            backdrops.forEach(function(backdrop) {
                                try {
                                    backdrop.style.display = 'none';
                                    backdrop.style.visibility = 'hidden';
                                    if (backdrop.parentNode) {
                                        backdrop.parentNode.removeChild(backdrop);
                                    }
                                } catch (e) {
                                    // Ignore
                                }
                            });
                            
                            // Also try to close any open modals by clicking outside or escape
                            document.body.style.overflow = ''; // Restore scroll
                            document.body.style.position = ''; // Restore position
                            
                            // Try pressing Escape key programmatically
                            var escEvent = new KeyboardEvent('keydown', {
                                key: 'Escape',
                                code: 'Escape',
                                keyCode: 27,
                                which: 27,
                                bubbles: true,
                                cancelable: true
                            });
                            document.dispatchEvent(escEvent);
                        } catch (e) {
                        }
                        
                        // Show SweetAlert - force it to appear on top
                        setTimeout(function() {
                            // Ensure no other modals are blocking
                            var existingModals = document.querySelectorAll('.swal2-container, .modal, [class*="modal"]');
                            existingModals.forEach(function(modal) {
                                try {
                                    if (modal.style) {
                                        modal.style.zIndex = '9999';
                                    }
                                } catch (e) {
                                    // Ignore
                                }
                            });
                            
                            Swal.fire({
                                icon: 'error',
                                title: translations.PaymentFailed,
                                html: '<div style="text-align: ' + (translations.IsRtl === 'true' ? 'right' : 'left') + ';">' +
                                    '<p style="margin-bottom: 10px; font-weight: 600; color: #dc2626; font-size: 1.1rem;">' + 
                                    errorMessage.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>' +
                                    '</div>',
                                confirmButtonText: translations.OK,
                                confirmButtonColor: '#dc2626',
                                width: '500px',
                                allowOutsideClick: true,
                                allowEscapeKey: true,
                                backdrop: true,
                                zIndex: 99999, // Very high z-index to ensure it's on top
                                didOpen: function() {
                                    // Ensure body scroll is restored
                                    document.body.style.overflow = '';
                                    document.body.style.position = '';
                                    
                                    // Force the SweetAlert container to be on top
                                    var swalContainer = document.querySelector('.swal2-container');
                                    if (swalContainer && swalContainer.style) {
                                        swalContainer.style.zIndex = '99999';
                                    }
                                    
                                    // Hide any remaining Geidea elements
                                    var geideaElements = document.querySelectorAll('[class*="geidea"], [id*="geidea"], [class*="Geidea"], [id*="Geidea"]');
                                    geideaElements.forEach(function(el) {
                                        if (el.style) {
                                            el.style.display = 'none';
                                            el.style.visibility = 'hidden';
                                            el.style.opacity = '0';
                                            el.style.pointerEvents = 'none';
                                            el.style.zIndex = '-1';
                                        }
                                    });
                                }
                            }).then(function() {
                                // Re-enable button
                                var $btn = $('#placeOrderBtn');
                                if ($btn.length) {
                                    $btn.prop('disabled', false);
                                    var $btnText = $btn.find('.btn-text');
                                    var $btnLoader = $btn.find('.btn-loader');
                                    if ($btnText.length) $btnText.show();
                                    if ($btnLoader.length) $btnLoader.hide();
                                }
                                errorDetected = false; // Reset for next attempt
                            });
                        }, 500); // Increased delay to ensure Geidea modal is closed
                    }
                }
                
                // Set up MutationObserver to watch for error messages
                if (typeof MutationObserver !== 'undefined') {
                    errorObserver = new MutationObserver(function(mutations) {
                        detectGeideaModalError();
                    });
                    
                    // Start observing the document body for changes
                    errorObserver.observe(document.body, {
                        childList: true,
                        subtree: true,
                        characterData: true,
                        attributes: true,
                        attributeOldValue: false
                    });
                    
                    // Also check periodically (more frequent for better detection)
                    var errorCheckInterval = setInterval(function() {
                        detectGeideaModalError();
                    }, 300); // Check every 300ms
                    
                    // Clear interval after 60 seconds (payment should complete or fail by then)
                    setTimeout(function() {
                        clearInterval(errorCheckInterval);
                        if (errorObserver) {
                            errorObserver.disconnect();
                        }
                    }, 60000);
                } else {
                    // Fallback if MutationObserver not available - check more frequently
                    var errorCheckInterval = setInterval(function() {
                        detectGeideaModalError();
                    }, 200);
                    setTimeout(function() {
                        clearInterval(errorCheckInterval);
                    }, 60000);
                }
                
                // Also listen for window messages (Geidea might post messages)
                window.addEventListener('message', function(event) {
                    try {
                        var message = event.data;
                        if (message && typeof message === 'object') {
                            var messageStr = JSON.stringify(message).toLowerCase();
                            if (messageStr.includes('error') || 
                                messageStr.includes('rejected') || 
                                messageStr.includes('failed') ||
                                messageStr.includes('declined')) {
                                detectGeideaModalError();
                            }
                        } else if (typeof message === 'string') {
                            var msgLower = message.toLowerCase();
                            if (msgLower.includes('error') || 
                                msgLower.includes('rejected') || 
                                msgLower.includes('failed') ||
                                msgLower.includes('declined')) {
                                detectGeideaModalError();
                            }
                        }
                    } catch (e) {
                        // Ignore
                    }
                });
                
                // Override console.error to catch Geidea errors
                var originalConsoleError = console.error;
                console.error = function() {
                    var args = Array.prototype.slice.call(arguments);
                    var errorStr = args.join(' ').toLowerCase();
                    
                    // Check if this is a payment error
                    if (errorStr.includes('payer authentication rejected') ||
                        errorStr.includes('authentication rejected') ||
                        errorStr.includes('payment rejected') ||
                        errorStr.includes('rejected')) {
                        setTimeout(function() {
                            detectGeideaModalError();
                        }, 100);
                    }
                    
                    // Call original console.error
                    originalConsoleError.apply(console, args);
                };
                
                // Initialize GeideaCheckout with callback handlers
                const payment = new GeideaCheckout(
                    function onSuccess(data) {
                        // Restore console.error
                        console.error = originalConsoleError;
                        
                        // Payment successful
                        if (callback) callback(true);
                    },
                    function onError(error) {
                        // Restore console.error
                        console.error = originalConsoleError;
                        
                        // Mark that we've detected an error to prevent duplicate alerts
                        errorDetected = true;
                        
                        // Payment error - extract all available error information
                        console.error('Geidea payment error callback triggered', error);
                        console.error('Error type:', typeof error);
                        console.error('Error stringified:', JSON.stringify(error, null, 2));
                        
                        // Build detailed error message
                        let errorMessage = translations.PaymentFailedPleaseTryAgain;
                        let errorDetails = [];
                        
                        // Try to extract error message from all possible sources
                        if (error) {
                            // If error is a string, use it directly
                            if (typeof error === 'string') {
                                errorMessage = error;
                            } 
                            // If error is an object, check all possible properties
                            else if (typeof error === 'object') {
                                // Try to get message from various properties
                                var possibleMessages = [
                                    error.message,
                                    error.error,
                                    error.errorMessage,
                                    error.detailedResponseMessage,
                                    error.responseMessage,
                                    error.reason,
                                    error.description,
                                    error.text,
                                    error.title,
                                    error.msg
                                ];
                                
                                for (var i = 0; i < possibleMessages.length; i++) {
                                    if (possibleMessages[i] && typeof possibleMessages[i] === 'string' && possibleMessages[i].trim().length > 0) {
                                        errorMessage = possibleMessages[i].trim();
                                        break;
                                    }
                                }
                                
                                // If still no message, try to stringify and parse
                                if (errorMessage === translations.PaymentFailedPleaseTryAgain) {
                                    try {
                                        var errorStr = JSON.stringify(error);
                                        if (errorStr && errorStr.length > 0 && errorStr !== '{}') {
                                            errorMessage = 'Payment Error: ' + errorStr;
                                        }
                                    } catch (e) {
                                        // Ignore
                                    }
                                }
                                
                                // Extract additional error details
                                if (error.code) {
                                    errorDetails.push(translations.ErrorCode + ': ' + error.code);
                                }
                                if (error.status) {
                                    errorDetails.push(translations.Status + ': ' + error.status);
                                }
                                if (error.statusCode) {
                                    errorDetails.push(translations.StatusCode + ': ' + error.statusCode);
                                }
                                if (error.responseCode) {
                                    errorDetails.push(translations.ResponseCode + ': ' + error.responseCode);
                                }
                                if (error.detailedResponseCode) {
                                    errorDetails.push(translations.DetailedResponseCode + ': ' + error.detailedResponseCode);
                                }
                                if (error.detailedResponseMessage && error.detailedResponseMessage !== errorMessage) {
                                    errorDetails.push(translations.Details + ': ' + error.detailedResponseMessage);
                                }
                                if (error.responseMessage && error.responseMessage !== errorMessage) {
                                    errorDetails.push(translations.Response + ': ' + error.responseMessage);
                                }
                            }
                        }
                        
                        // If we still don't have a specific message, use a generic one but still show the alert
                        if (!errorMessage || errorMessage === translations.PaymentFailedPleaseTryAgain) {
                            errorMessage = translations.PaymentFailedPleaseTryAgain || 'Payment was not successful. Please try again.';
                        }
                        
                        // Close modal immediately
                        closeGeideaModal();
                        
                        // Build HTML content for SweetAlert
                        let htmlContent = '<div style="text-align: ' + (translations.IsRtl === 'true' ? 'right' : 'left') + ';">' +
                            '<p style="margin-bottom: 10px; font-weight: 600; color: #dc2626; font-size: 1.1rem;">' + 
                            (errorMessage || translations.PaymentFailedPleaseTryAgain).replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>';
                        
                        if (errorDetails.length > 0) {
                            htmlContent += '<div style="margin-top: 15px; padding: 10px; background-color: #fef2f2; border-radius: 6px; border-left: 3px solid #dc2626;">' +
                                '<p style="margin: 0 0 8px 0; font-weight: 600; color: #991b1b; font-size: 0.875rem;">' + translations.ErrorDetails + ':</p>' +
                                '<ul style="margin: 0; padding-left: 20px; color: #7f1d1d; font-size: 0.875rem;">';
                            errorDetails.forEach(function(detail) {
                                htmlContent += '<li style="margin-bottom: 4px;">' + detail.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</li>';
                            });
                            htmlContent += '</ul></div>';
                        }
                        htmlContent += '</div>';
                        
                        // Show SweetAlert immediately - don't wait
                        // Use requestAnimationFrame to ensure it renders after modal is closed
                        requestAnimationFrame(function() {
                            closeGeideaModal(); // Close again to be sure
                            
                            setTimeout(function() {
                                Swal.fire({
                                    icon: 'error',
                                    title: translations.PaymentFailed || 'Payment Failed',
                                    html: htmlContent,
                                    confirmButtonText: translations.OK || 'OK',
                                    confirmButtonColor: '#dc2626',
                                    width: '500px',
                                    allowOutsideClick: true,
                                    allowEscapeKey: true,
                                    backdrop: true,
                                    zIndex: 99999,
                                    customClass: {
                                        container: 'geidea-error-alert'
                                    },
                                    didOpen: function() {
                                        // Close modal again when SweetAlert opens
                                        closeGeideaModal();
                                        
                                        // Ensure SweetAlert is on top
                                        var swalContainer = document.querySelector('.swal2-container');
                                        if (swalContainer) {
                                            swalContainer.style.zIndex = '99999';
                                            swalContainer.style.position = 'fixed';
                                        }
                                        
                                        // Hide any remaining overlays
                                        var overlays = document.querySelectorAll('.swal2-backdrop-show, [class*="backdrop"], [class*="overlay"]');
                                        overlays.forEach(function(overlay) {
                                            if (overlay && !overlay.classList.contains('swal2-backdrop-show')) {
                                                overlay.style.display = 'none';
                                            }
                                        });
                                    }
                                }).then(function() {
                                    // Re-enable button after user closes the alert
                                    var $btn = $('#placeOrderBtn');
                                    if ($btn.length) {
                                        $btn.prop('disabled', false);
                                        var $btnText = $btn.find('.btn-text');
                                        var $btnLoader = $btn.find('.btn-loader');
                                        if ($btnText.length) $btnText.show();
                                        if ($btnLoader.length) $btnLoader.hide();
                                    }
                                    errorDetected = false; // Reset for next attempt
                                });
                            }, 100);
                        });
                        
                        if (callback) callback(false);
                    },
                    function onCancel() {
                        // Payment cancelled
                        Swal.fire({
                            icon: 'info',
                            title: translations.PaymentCancelled,
                            text: translations.PaymentWasCancelled,
                            confirmButtonText: translations.OK
                        });
                        if (callback) callback(false);
                    }
                );

                // Add a global error handler that will catch any errors
                var globalErrorHandler = function(event) {
                    var errorText = '';
                    if (event && event.target) {
                        errorText = (event.target.textContent || event.target.innerText || '').toLowerCase();
                    }
                    
                    if (errorText && (
                        errorText.includes('payer authentication rejected') ||
                        errorText.includes('authentication rejected') ||
                        errorText.includes('payment rejected') ||
                        errorText.includes('rejected')
                    )) {
                        if (!errorDetected) {
                            errorDetected = true;
                            var fullText = (event.target.textContent || event.target.innerText || '').trim();
                            
                            // Close Geidea modal
                            closeGeideaModal();
                            
                            // Show SweetAlert
                            setTimeout(function() {
                                Swal.fire({
                                    icon: 'error',
                                    title: translations.PaymentFailed || 'Payment Failed',
                                    html: '<div style="text-align: ' + (translations.IsRtl === 'true' ? 'right' : 'left') + ';">' +
                                        '<p style="margin-bottom: 10px; font-weight: 600; color: #dc2626; font-size: 1.1rem;">' + 
                                        fullText.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>' +
                                        '</div>',
                                    confirmButtonText: translations.OK || 'OK',
                                    confirmButtonColor: '#dc2626',
                                    width: '500px',
                                    zIndex: 99999
                                }).then(function() {
                                    var $btn = $('#placeOrderBtn');
                                    if ($btn.length) {
                                        $btn.prop('disabled', false);
                                        var $btnText = $btn.find('.btn-text');
                                        var $btnLoader = $btn.find('.btn-loader');
                                        if ($btnText.length) $btnText.show();
                                        if ($btnLoader.length) $btnLoader.hide();
                                    }
                                    errorDetected = false;
                                });
                            }, 200);
                        }
                    }
                };
                
                // Listen for clicks on error elements
                document.addEventListener('click', globalErrorHandler, true);
                document.addEventListener('DOMNodeInserted', function(e) {
                    if (e.target && e.target.textContent) {
                        globalErrorHandler({ target: e.target });
                    }
                }, true);
                
                // Start payment with sessionId
                payment.startPayment(sessionId);
            } catch (error) {
                console.error('Error initiating Geidea payment:', error);
                let errorMessage = translations.FailedToStartPayment;
                if (error && error.message) {
                    errorMessage = error.message;
                }
                Swal.fire({
                    icon: 'error',
                    title: translations.PaymentError,
                    html: '<div style="text-align: left;">' +
                        '<p style="margin-bottom: 0;">' + errorMessage + '</p>' +
                        (error && error.stack ? '<p style="margin-top: 10px; font-size: 0.75rem; color: #6b7280;">' + translations.TechnicalDetailsLogged + '</p>' : '') +
                        '</div>',
                    confirmButtonText: translations.OK,
                    confirmButtonColor: '#dc2626'
                });
                if (callback) callback(false);
            }
        }
    </script>
}
