@section Scripts {
    <!-- Load SweetAlert2 for payment notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" crossorigin="anonymous"></script>
    
    @if (tamaraAvailable && !string.IsNullOrEmpty(tamaraPublicKey))
    {
        <script src="https://cdn.tamara.co/widget-v2/tamara-widget.js"></script>
    }
    
    <script>
        // Prevent toastr from showing payment errors - use SweetAlert instead
        if (typeof toastr !== 'undefined') {
            var originalToastrError = toastr.error;
            toastr.error = function(message, title, options) {
                // Check if this is a payment-related error
                var isPaymentError = (message && (
                    message.toLowerCase().includes('payment') ||
                    message.toLowerCase().includes('دفع') ||
                    message.toLowerCase().includes('اشتراك') ||
                    message.toLowerCase().includes('subscription')
                )) || (title && (
                    title.toLowerCase().includes('payment') ||
                    title.toLowerCase().includes('دفع')
                ));
                
                // If it's a payment error, don't show toastr - SweetAlert will handle it
                if (isPaymentError) {
                    return;
                }
                
                // For non-payment errors, use original toastr
                return originalToastrError.call(this, message, title, options);
            };
        }
        
        // Translations for JavaScript
        var translations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsTranslations));
        
        // Payment method minimum amounts from server
        var tabbyMinimumOrderAmount = @(tabbyMinimumAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
        var tamaraMinimumOrderAmount = @(tamaraMinimumAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
        var tabbyEnabled = @(tabbyEnabled.ToString().ToLower());
        var tamaraEnabled = @(tamaraEnabled.ToString().ToLower());
        var isOfflineServiceJs = @(Model.MinAmountRequired > 0 && Model.MinAmountRequired < Model.TotalAmount ? "true" : "false");
        var totalServiceAmount = @(Model.TotalAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
        
        // Localized message for minimum order amount
        var localizedMinimumOrderMessage = '@Html.Raw(Localizer["MinimumOrderForPayment"]?.Value ?? "Minimum order of {0} AED required for {1}")';
        
        // Function to update payment methods visibility based on amount to pay
        function updatePaymentMethodsVisibility(amountToPay) {
            var $tabbyOption = $('#tabbyPaymentOption');
            var $tamaraOption = $('#tamaraPaymentOption');
            var $alternativePayments = $('#alternativePayments');
            var $minimumNotice = $('#paymentMinimumNotice');
            
            // Check Tabby availability - use "enabled" flag and check against minimum amount
            var tabbyVisible = tabbyEnabled && amountToPay >= tabbyMinimumOrderAmount;
            // Check Tamara availability  
            var tamaraVisible = tamaraEnabled && amountToPay >= tamaraMinimumOrderAmount;
            
            // Update Tabby visibility with animation
            if (tabbyVisible) {
                $tabbyOption.removeClass('hiding').css('display', '').fadeIn(300);
            } else {
                $tabbyOption.addClass('hiding').fadeOut(300, function() {
                    $(this).css('display', 'none');
                });
                // If Tabby was selected, switch to Geidea
                if ($('#paymentTabby').is(':checked')) {
                    $('#paymentGeidea').prop('checked', true);
                }
            }
            
            // Update Tamara visibility with animation
            if (tamaraVisible) {
                $tamaraOption.removeClass('hiding').css('display', '').fadeIn(300);
            } else {
                $tamaraOption.addClass('hiding').fadeOut(300, function() {
                    $(this).css('display', 'none');
                });
                // If Tamara was selected, switch to Geidea
                if ($('#paymentTamara').is(':checked')) {
                    $('#paymentGeidea').prop('checked', true);
                }
            }
            
            // Show/hide alternative payments section
            if (tabbyVisible || tamaraVisible) {
                $alternativePayments.removeClass('hiding').css('display', '').fadeIn(300);
            } else if (!tabbyVisible && !tamaraVisible && (tabbyEnabled || tamaraEnabled)) {
                $alternativePayments.addClass('hiding').fadeOut(300, function() {
                    $(this).css('display', 'none');
                });
            }
            
            // Show minimum amount notice if neither alternative is available but they could be
            var noticePayments = [];
            
            // Check if Tabby is enabled but not available due to minimum amount
            if (tabbyEnabled && amountToPay < tabbyMinimumOrderAmount) {
                noticePayments.push('Tabby');
            }
            // Check if Tamara is enabled but not available due to minimum amount
            if (tamaraEnabled && amountToPay < tamaraMinimumOrderAmount) {
                noticePayments.push('Tamara');
            }
            
            // Show notice if any payment methods need minimum amount
            if (noticePayments.length > 0) {
                var minAmount = Math.max(tabbyMinimumOrderAmount, tamaraMinimumOrderAmount);
                var amountNeeded = (minAmount - amountToPay).toFixed(0);
                var paymentNames = noticePayments.join(' & ');
                var noticeText = localizedMinimumOrderMessage.replace('{0}', amountNeeded).replace('{1}', paymentNames);
                $('#paymentMinimumNoticeText').text(noticeText);
                $minimumNotice.slideDown(300);
            } else {
                $minimumNotice.slideUp(300);
            }
        }
        
        $(document).ready(function() {
            // Initialize payment methods visibility based on amount
            var initialAmount = totalServiceAmount;
            if (isOfflineServiceJs && $('#CustomAmount').length > 0) {
                initialAmount = parseFloat($('#CustomAmount').val()) || totalServiceAmount;
            }
            updatePaymentMethodsVisibility(initialAmount);
            
            // Update payment methods when custom amount changes
            $('#CustomAmount').on('input blur', function() {
                var amountToPay = parseFloat($(this).val()) || 0;
                updatePaymentMethodsVisibility(amountToPay);
            });
            
            // Promo code input to uppercase
            $('#PromoCode').on('input', function() {
                $(this).val($(this).val().toUpperCase());
            });
            
            // OTP handling for guest users
            @if (Model.IsGuest || !User.Identity.IsAuthenticated)
            {
                <text>
                var $emailField = $('#guestEmailInput');
                var $emailValidationMsg = $('#emailValidationMessage');
                var $emailVerificationSection = $('#emailVerificationSection');
                var $otpSendSection = $('#otpSendSection');
                var $otpVerifySection = $('#otpVerifySection');
                var $emailVerifiedSection = $('#emailVerifiedSection');
                var $sendOtpBtn = $('#sendOtpBtn');
                var $verifyOtpBtn = $('#verifyOtpBtn');
                var $resendOtpBtn = $('#resendOtpBtn');
                var $otpInput = $('#otpInput');
                var $otpSendMessage = $('#otpSendMessage');
                var $otpVerifyMessage = $('#otpVerifyMessage');
                var isEmailVerified = false;
                var resendTimer = null;
                var resendCooldown = 60; // 60 seconds cooldown
                
                // Enhanced email regex pattern
                var emailRegex = new RegExp('^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\\.[a-zA-Z]{2,}$');
                
                function validateEmailFormat(email) {
                    if (!email || email.trim() === '') {
                        return { valid: false, message: '@(Localizer["EmailAddress"]?.Value ?? "Email Address") @(Localizer["IsRequired"]?.Value ?? "is required")' };
                    }
                    
                    if (!emailRegex.test(email)) {
                        return { valid: false, message: '@(Localizer["InvalidEmailFormat"]?.Value ?? "Please enter a valid email address")' };
                    }
                    
                    var parts = email.split('@@');
                    if (parts.length !== 2) {
                        return { valid: false, message: '@(Localizer["InvalidEmailFormat"]?.Value ?? "Please enter a valid email address")' };
                    }
                    
                    var domain = parts[1].toLowerCase();
                    if (domain.includes('..') || domain.startsWith('.') || domain.endsWith('.') || domain.length < 4) {
                        return { valid: false, message: '@(Localizer["InvalidEmailFormat"]?.Value ?? "Please enter a valid email address")' };
                    }
                    
                    return { valid: true, message: '' };
                }
                
                function showEmailError(message) {
                    $emailField.addClass('is-invalid');
                    $emailValidationMsg.html('<i class="bi bi-exclamation-circle @(isRtl ? "ms-1" : "me-1")"></i>' + message).show();
                }
                
                function showEmailValid() {
                    $emailField.removeClass('is-invalid');
                    $emailField.addClass('is-valid');
                    $emailValidationMsg.hide();
                }
                
                function clearEmailValidation() {
                    $emailField.removeClass('is-invalid is-valid');
                    $emailValidationMsg.hide();
                }
                
                // Real-time validation on input (with debounce)
                var emailValidationTimeout;
                $emailField.on('input blur', function() {
                    var email = $(this).val() ? $(this).val().trim() : '';
                    clearTimeout(emailValidationTimeout);
                    
                    if (email.length > 0) {
                        emailValidationTimeout = setTimeout(function() {
                            var validation = validateEmailFormat(email);
                            if (!validation.valid) {
                                showEmailError(validation.message);
                                resetOtpSection();
                            } else {
                                showEmailValid();
                                // Check if email is already verified
                                $.ajax({
                                    url: '/Customer/ServiceSubscription/CheckEmailVerified',
                                    method: 'POST',
                                    data: { email: email },
                                    success: function(response) {
                                        if (response.verified) {
                                            showEmailVerified();
                                            isEmailVerified = true;
                                            // Check if email has account
                                            checkEmailHasAccount(email);
                                        } else {
                                            showOtpSendSection();
                                            isEmailVerified = false;
                                        }
                                    },
                                    error: function() {
                                        showOtpSendSection();
                                        isEmailVerified = false;
                                    }
                                });
                            }
                        }, 500);
                    } else {
                        clearEmailValidation();
                        resetOtpSection();
                    }
                });
                
                // Send OTP
                $sendOtpBtn.on('click', function() {
                    var email = $emailField.val() ? $emailField.val().trim() : '';
                    if (!email || !emailRegex.test(email)) {
                        showEmailError('@(Localizer["InvalidEmailFormat"]?.Value ?? "Please enter a valid email address")');
                        return;
                    }
                    
                    $sendOtpBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm @(isRtl ? "ms-2" : "me-2")"></span>@(Localizer["Sending"]?.Value ?? "Sending")...');
                    $otpSendMessage.hide();
                    
                    $.ajax({
                        url: '/Customer/ServiceSubscription/SendOtp',
                        method: 'POST',
                        data: { email: email },
                        success: function(response) {
                            if (response.success) {
                                $otpSendMessage.removeClass('text-danger').addClass('text-success').html('<i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>' + response.message).show();
                                showOtpVerifySection();
                                startResendCooldown();
                            } else {
                                $otpSendMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle @(isRtl ? "ms-1" : "me-1")"></i>' + response.message).show();
                                $sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["SendVerificationCode"]?.Value ?? "Send Verification Code")');
                            }
                        },
                        error: function() {
                            $otpSendMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["ErrorSendingOTP"]?.Value ?? "Error sending verification code. Please try again.")').show();
                            $sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["SendVerificationCode"]?.Value ?? "Send Verification Code")');
                        }
                    });
                });
                
                // Verify OTP
                $verifyOtpBtn.on('click', function() {
                    var email = $emailField.val() ? $emailField.val().trim() : '';
                    var otp = $otpInput.val() ? $otpInput.val().trim() : '';
                    
                    if (!otp || otp.length !== 6) {
                        $otpVerifyMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["PleaseEnterValidOTP"]?.Value ?? "Please enter a valid 6-digit code")').show();
                        return;
                    }
                    
                    $verifyOtpBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm @(isRtl ? "ms-2" : "me-2")"></span>@(Localizer["Verifying"]?.Value ?? "Verifying")...');
                    $otpVerifyMessage.hide();
                    
                    $.ajax({
                        url: '/Customer/ServiceSubscription/VerifyOtp',
                        method: 'POST',
                        data: { email: email, otp: otp },
                        success: function(response) {
                            if (response.success) {
                                $otpVerifyMessage.removeClass('text-danger').addClass('text-success').html('<i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>' + response.message).show();
                                showEmailVerified();
                                isEmailVerified = true;
                                clearResendTimer();
                                // Check if email has account after OTP verification
                                checkEmailHasAccount(email);
                            } else {
                                $otpVerifyMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle @(isRtl ? "ms-1" : "me-1")"></i>' + response.message).show();
                                $verifyOtpBtn.prop('disabled', false).html('<i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["Verify"]?.Value ?? "Verify")');
                                $otpInput.val('').focus();
                            }
                        },
                        error: function() {
                            $otpVerifyMessage.removeClass('text-success').addClass('text-danger').html('<i class="bi bi-exclamation-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["ErrorVerifyingOTP"]?.Value ?? "Error verifying code. Please try again.")').show();
                            $verifyOtpBtn.prop('disabled', false).html('<i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["Verify"]?.Value ?? "Verify")');
                        }
                    });
                });
                
                // Resend OTP
                $resendOtpBtn.on('click', function() {
                    if ($(this).hasClass('disabled')) return;
                    $sendOtpBtn.click();
                });
                
                // Allow Enter key to verify OTP
                $otpInput.on('keypress', function(e) {
                    if (e.which === 13) {
                        $verifyOtpBtn.click();
                    }
                });
                
                // Only allow numbers in OTP input
                $otpInput.on('input', function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
                
                function showOtpSendSection() {
                    $emailVerificationSection.show();
                    $otpSendSection.show();
                    $otpVerifySection.hide();
                    $emailVerifiedSection.hide();
                    $sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["SendVerificationCode"]?.Value ?? "Send Verification Code")');
                }
                
                function showOtpVerifySection() {
                    $otpSendSection.hide();
                    $otpVerifySection.show();
                    $emailVerifiedSection.hide();
                    $otpInput.focus();
                    $verifyOtpBtn.prop('disabled', false).html('<i class="bi bi-check-circle @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["Verify"]?.Value ?? "Verify")');
                }
                
                function showEmailVerified() {
                    $otpSendSection.hide();
                    $otpVerifySection.hide();
                    $emailVerifiedSection.show();
                    clearResendTimer();
                    
                    // Check if email has account after verification
                    var email = $emailField.val() ? $emailField.val().trim() : '';
                    if (email) {
                        checkEmailHasAccount(email);
                    }
                }
                
                // Check if email has an account
                function checkEmailHasAccount(email) {
                    $.ajax({
                        url: '/Customer/ServiceSubscription/CheckEmailHasAccount',
                        method: 'POST',
                        data: { email: email },
                        success: function(response) {
                            if (response.hasAccount) {
                                // Email has account - show message and hide create account checkbox
                                $('#createAccountSection').hide();
                                // Remove any existing info message to prevent duplicates
                                $('#emailVerifiedSection .alert-info').remove();
                                $('#emailVerifiedSection').append(
                                    '<div class="alert alert-info mt-2 mb-0" style="border-radius: 6px; font-size: 0.9rem;">' +
                                    '<i class="bi bi-info-circle @(isRtl ? "ms-2" : "me-2")"></i>' +
                                    '<strong>@(Localizer["AccountFound"]?.Value ?? "Account Found"):</strong> ' +
                                    '@(Localizer["OrderWillBeLinkedToAccount"]?.Value ?? "This order will be linked to your existing account.")' +
                                    '</div>'
                                );
                            } else {
                                // Email doesn't have account - show create account checkbox
                                $('#createAccountSection').show();
                                // Remove any existing info message
                                $('#emailVerifiedSection .alert-info').remove();
                            }
                        },
                        error: function() {
                            // On error, show create account checkbox as fallback
                            $('#createAccountSection').show();
                        }
                    });
                }
                
                function resetOtpSection() {
                    $emailVerificationSection.hide();
                    $otpSendSection.show();
                    $otpVerifySection.hide();
                    $emailVerifiedSection.hide();
                    $('#createAccountSection').hide();
                    $('#createAccountCheckbox').prop('checked', false);
                    $otpInput.val('');
                    $otpSendMessage.hide();
                    $otpVerifyMessage.hide();
                    $sendOtpBtn.prop('disabled', false).html('<i class="bi bi-send @(isRtl ? "ms-2" : "me-2")"></i>@(Localizer["SendVerificationCode"]?.Value ?? "Send Verification Code")');
                    isEmailVerified = false;
                    clearResendTimer();
                }
                
                function startResendCooldown() {
                    clearResendTimer();
                    $resendOtpBtn.addClass('disabled').prop('disabled', true);
                    var seconds = resendCooldown;
                    
                    resendTimer = setInterval(function() {
                        seconds--;
                        if (seconds > 0) {
                            $resendOtpBtn.html('<i class="bi bi-arrow-clockwise @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["ResendCode"]?.Value ?? "Resend Code") (' + seconds + 's)');
                        } else {
                            clearResendTimer();
                            $resendOtpBtn.removeClass('disabled').prop('disabled', false).html('<i class="bi bi-arrow-clockwise @(isRtl ? "ms-1" : "me-1")"></i>@(Localizer["ResendCode"]?.Value ?? "Resend Code")');
                        }
                    }, 1000);
                }
                
                function clearResendTimer() {
                    if (resendTimer) {
                        clearInterval(resendTimer);
                        resendTimer = null;
                    }
                }
                
                // Show OTP section when email is valid
                $emailField.on('blur', function() {
                    var email = $(this).val() ? $(this).val().trim() : '';
                    if (email && emailRegex.test(email)) {
                        $emailVerificationSection.show();
                    }
                });
                </text>
            }
            
            @if (isOfflineService)
            {
                @:// Store translations in JavaScript variables to avoid encoding issues (defined early for use in validateForm)
                @:var amountToPayNowText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AmountToPayNow"]?.Value ?? "Amount to Pay Now"));
                @:var isRequiredText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["IsRequired"]?.Value ?? "is required"));
                @:var amountMustBeAtLeastText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AmountMustBeAtLeast"]?.Value ?? "Amount must be at least"));
                @:var amountCannotExceedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AmountCannotExceed"]?.Value ?? "Amount cannot exceed"));
            }
            
            // Form validation function
            function validateForm() {
                var errors = [];
                var isValid = true;
                
                @if (Model.IsGuest || !User.Identity.IsAuthenticated)
                {
                    <text>
                    // Validate guest email
                    var email = $('#guestEmailInput').val() ? $('#guestEmailInput').val().trim() : '';
                    var emailValidation = null;
                    if (!email) {
                        errors.push('@(Localizer["EmailAddress"]?.Value ?? "Email Address") @(Localizer["IsRequired"]?.Value ?? "is required")');
                        $('#guestEmailInput').addClass('is-invalid');
                        isValid = false;
                    } else {
                        emailValidation = validateEmailFormat(email);
                        if (!emailValidation.valid) {
                            errors.push(emailValidation.message);
                            $('#guestEmailInput').addClass('is-invalid');
                            isValid = false;
                        } else {
                            $('#guestEmailInput').removeClass('is-invalid');
                        }
                    }
                    
                    // Check if email is verified for guest users
                    if (email && emailValidation && emailValidation.valid && !isEmailVerified) {
                        errors.push('@(Localizer["EmailNotVerified"]?.Value ?? "Please verify your email address before placing the order.")');
                        isValid = false;
                        // Scroll to email verification section
                        setTimeout(function() {
                            $('html, body').animate({
                                scrollTop: $('#emailVerificationSection').offset().top - 100
                            }, 500);
                        }, 100);
                    }
                    
                    // Validate guest name
                    var name = $('#GuestName').val() ? $('#GuestName').val().trim() : '';
                    if (!name) {
                        errors.push('@(Localizer["Name"]?.Value ?? "Name") @(Localizer["IsRequired"]?.Value ?? "is required")');
                        $('#GuestName').addClass('is-invalid');
                        isValid = false;
                    } else {
                        $('#GuestName').removeClass('is-invalid');
                    }
                    
                    // Validate guest phone
                    var phone = $('#GuestPhone').val() ? $('#GuestPhone').val().trim() : '';
                    if (!phone) {
                        errors.push('@(Localizer["Phone"]?.Value ?? "Phone") @(Localizer["IsRequired"]?.Value ?? "is required")');
                        $('#GuestPhone').addClass('is-invalid');
                        isValid = false;
                    } else {
                        $('#GuestPhone').removeClass('is-invalid');
                    }
                    </text>
                }
                
                // Validate payment method (skip for free subscriptions)
                var isFreeSubscription = @(Model.TotalAmount <= 0.01m ? "true" : "false");
                if (!isFreeSubscription) {
                    var paymentMethod = $('input[name="PaymentMethod"]:checked').val();
                    if (!paymentMethod) {
                        errors.push('@(Localizer["PaymentMethod"]?.Value ?? "Payment Method") @(Localizer["IsRequired"]?.Value ?? "is required")');
                        isValid = false;
                        // Highlight payment method section
                        $('.payment-method-section').addClass('border border-danger rounded p-2');
                    } else {
                        $('.payment-method-section').removeClass('border border-danger rounded p-2');
                    }
                }
                
                @if (isOfflineService)
                {
                    @:// Validate custom amount for offline services
                    @:var customAmount = parseFloat($('#CustomAmount').val()) || 0;
                    @:var minAmount = @minAmountJs;
                    @:var maxAmount = @maxAmountJs;
                    @:var minFormatted = '@minAmountFormatted';
                    @:var maxFormatted = '@maxAmountFormatted';
                    @:
                    @:if (!customAmount || customAmount <= 0) {
                    @:    errors.push((typeof amountToPayNowText !== 'undefined' ? amountToPayNowText : '@(Localizer["AmountToPayNow"]?.Value ?? "Amount to Pay Now")') + ' ' + (typeof isRequiredText !== 'undefined' ? isRequiredText : '@(Localizer["IsRequired"]?.Value ?? "is required")'));
                    @:    $('#CustomAmount').addClass('is-invalid');
                    @:    isValid = false;
                    @:} else if (customAmount < minAmount) {
                    @:    errors.push((typeof amountMustBeAtLeastText !== 'undefined' ? amountMustBeAtLeastText : '@(Localizer["AmountMustBeAtLeast"]?.Value ?? "Amount must be at least")') + ' ' + minFormatted);
                    @:    $('#CustomAmount').addClass('is-invalid');
                    @:    isValid = false;
                    @:} else if (customAmount > maxAmount) {
                    @:    errors.push((typeof amountCannotExceedText !== 'undefined' ? amountCannotExceedText : '@(Localizer["AmountCannotExceed"]?.Value ?? "Amount cannot exceed")') + ' ' + maxFormatted);
                    @:    $('#CustomAmount').addClass('is-invalid');
                    @:    isValid = false;
                    @:} else {
                    @:    $('#CustomAmount').removeClass('is-invalid');
                    @:}
                }
                
                return { isValid: isValid, errors: errors };
            }
            
            // Real-time validation for form fields
            @if (Model.IsGuest || !User.Identity.IsAuthenticated)
            {
                <text>
                $('#GuestName').on('blur', function() {
                    var name = $(this).val() ? $(this).val().trim() : '';
                    if (!name) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });
                
                $('#GuestPhone').on('blur', function() {
                    var phone = $(this).val() ? $(this).val().trim() : '';
                    if (!phone) {
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });
                </text>
            }
            
            $('input[name="PaymentMethod"]').on('change', function() {
                $('.payment-method-section').removeClass('border border-danger rounded p-2');
            });
            
            // Promo code application
            var appliedPromoCode = null;
            var originalTotalAmount = @Model.TotalAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            var originalDiscountAmount = @Model.DiscountAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            
            // Test if button exists and jQuery is working
            var testBtn = document.getElementById('applyPromoBtn');
            
            // Promo code apply button handler - use event delegation
            $(document).on('click', '#applyPromoBtn', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                
                
                var promoCode = $('#PromoCode').val() ? $('#PromoCode').val().trim() : '';
                
                if (!promoCode) {
                    Swal.fire({
                        icon: 'warning',
                        title: '@(Localizer["ValidationError"]?.Value ?? "Validation Error")',
                        text: '@(Localizer["PleaseEnterPromoCode"]?.Value ?? "Please enter a promo code")',
                        confirmButtonText: translations.OK
                    });
                    return;
                }
                
                var $btn = $(this);
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm @(isRtl ? "ms-1" : "me-1")" role="status"></span>@(Localizer["Applying"]?.Value ?? "Applying")...');
                
                
                $.ajax({
                    url: '@Url.Action("ValidatePromoCode", "ServiceSubscription", new { area = "Customer" })',
                    method: 'POST',
                    data: {
                        promoCode: promoCode,
                        serviceId: @Model.Service.Id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    beforeSend: function() {
                    },
                    success: function(response) {
                        if (response.success) {
                            appliedPromoCode = promoCode;
                            
                            // Update pricing display
                            var baseAmount = parseFloat(response.baseAmount) || originalTotalAmount;
                            var discountAmount = parseFloat(response.discountAmount) || 0;
                            var finalAmount = parseFloat(response.finalAmount) || originalTotalAmount;
                            
                            // Update discount row
                            var discountRow = $('.pricing-summary .price-row.discount');
                            $('#discountAmountDisplay').text('-' + formatCurrency(discountAmount));
                            discountRow.show();
                            
                            // Update total amount
                            $('#totalAmountDisplay').text(formatCurrency(finalAmount));
                            
                            // Update promo code message
                            var promoCodeAppliedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["PromoCodeApplied"]?.Value ?? "Promo Code Applied"));
                            var removeText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Remove"]?.Value ?? "Remove"));
                            var iconMargin = '@(isRtl ? "ms-2" : "me-2")';
                            var buttonMargin = '@(isRtl ? "ms-2" : "me-2")';
                            
                            $('#promoCodeMessage').html(
                                '<div class="alert alert-success"><i class="bi bi-check-circle ' + iconMargin + '"></i>' +
                                '<strong>' + promoCodeAppliedText + ':</strong> ' + 
                                promoCode + ' - ' + response.discountText + 
                                ' <button type="button" class="btn btn-sm btn-link p-0 ' + buttonMargin + '" id="removePromoBtn" style="text-decoration: none;">' +
                                '<i class="bi bi-x-circle"></i> ' + removeText + '</button></div>'
                            );
                            
                            // Update custom amount max if offline service
                            @if (isOfflineService)
                            {
                                @:var newMaxAmount = finalAmount;
                                @if (Model.Service.OfflinePaymentPercent.HasValue)
                                {
                                    @:var percentValue = @Model.Service.OfflinePaymentPercent.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                    @:var newMinAmount = newMaxAmount * (percentValue / 100);
                                }
                                else
                                {
                                    @:var newMinAmount = @Model.MinAmountRequired.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                }
                                @:$('#CustomAmount').attr('data-max-amount', newMaxAmount);
                                @:$('#CustomAmount').attr('data-max-formatted', formatCurrency(newMaxAmount));
                                @:if (parseFloat($('#CustomAmount').val()) > newMaxAmount) {
                                @:    $('#CustomAmount').val(newMaxAmount.toFixed(2));
                                @:}
                                @:// Update payment methods visibility based on new custom amount
                                @:updatePaymentMethodsVisibility(parseFloat($('#CustomAmount').val()) || newMaxAmount);
                            }
                            
                            // Update payment methods visibility for all services based on final amount
                            updatePaymentMethodsVisibility(finalAmount);
                            
                            Swal.fire({
                                icon: 'success',
                                title: '@(Localizer["Success"]?.Value ?? "Success")',
                                text: response.message,
                                confirmButtonText: translations.OK,
                                timer: 2000,
                                timerProgressBar: true
                            });
                        } else {
                            var errorIconMargin = '@(isRtl ? "ms-2" : "me-2")';
                            var errorTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Error"]?.Value ?? "Error"));
                            $('#promoCodeMessage').html(
                                '<div class="alert alert-danger"><i class="bi bi-exclamation-circle ' + errorIconMargin + '"></i>' + response.message + '</div>'
                            );
                            
                            Swal.fire({
                                icon: 'error',
                                title: errorTitle,
                                text: response.message,
                                confirmButtonText: translations.OK
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Promo code validation error:', error);
                        var errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AnErrorOccurredPleaseTryAgain"]?.Value ?? "An error occurred. Please try again."));
                        var errorIconMargin = '@(isRtl ? "ms-2" : "me-2")';
                        $('#promoCodeMessage').html(
                            '<div class="alert alert-danger"><i class="bi bi-exclamation-circle ' + errorIconMargin + '"></i>' + errorMessage + '</div>'
                        );
                        
                        Swal.fire({
                            icon: 'error',
                            title: translations.Error,
                            text: translations.AnErrorOccurredProcessing,
                            confirmButtonText: translations.OK
                        });
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });
            
            // Remove promo code
            $(document).on('click', '#removePromoBtn', function() {
                appliedPromoCode = null;
                $('#PromoCode').val('');
                
                // Restore original pricing
                var discountRow = $('.pricing-summary .price-row.discount');
                discountRow.hide();
                
                $('#totalAmountDisplay').text(formatCurrency(originalTotalAmount));
                
                // Restore custom amount max if offline service
                @if (isOfflineService)
                {
                    @:var originalMaxAmount = @Model.TotalAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                    @:$('#CustomAmount').attr('data-max-amount', originalMaxAmount);
                    @:$('#CustomAmount').attr('data-max-formatted', '@formatCurrency(Model.TotalAmount)');
                    @:if (parseFloat($('#CustomAmount').val()) > parseFloat(originalMaxAmount)) {
                    @:    $('#CustomAmount').val(parseFloat(originalMaxAmount).toFixed(2));
                    @:}
                    @:// Update payment methods visibility based on custom amount
                    @:updatePaymentMethodsVisibility(parseFloat($('#CustomAmount').val()) || parseFloat(originalMaxAmount));
                }
                
                // Update payment methods visibility for all services based on original total
                updatePaymentMethodsVisibility(originalTotalAmount);
                
                $('#promoCodeMessage').html('');
            });
            
            // Format currency helper function (matches server-side format)
