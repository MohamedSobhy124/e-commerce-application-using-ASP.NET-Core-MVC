@using IdealWeightNutrition.Areas.Customer.Controllers
@model List<BlogPost>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = ViewData["Title"] ?? "Health & Wellness Blog";
    var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var isRtl = currentCulture == "ar";
}

@section Head {
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="@ViewData["Keywords"]" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    
    @if (ViewData["BlogStructuredData"] != null)
    {
        <script type="application/ld+json">
        @Html.Raw(ViewData["BlogStructuredData"])
        </script>
    }
}

<link rel="stylesheet" href="~/css/blog.css" />

<div class="blog-container">
    <!-- Blog Header -->
    <div class="blog-header">
        <div class="container">
            <div class="blog-header-content">
                <div class="blog-header-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div class="blog-header-text">
                    <h1 class="blog-main-title">@Localizer["HealthWellnessBlog"]</h1>
                    <p class="blog-subtitle">@Localizer["ExpertTipsGuidesForBetterHealth"]</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Blog Content -->
    <div class="container blog-content-wrapper">
        <!-- Featured Blog Post -->
        @if (Model.Any())
        {
            var featuredPost = Model.OrderByDescending(b => b.PublishedDate).First();
            <div class="featured-blog-post">
                <div class="featured-blog-image">
                    <div class="featured-badge">
                        <i class="bi bi-star-fill"></i>
                        @Localizer["Featured"]
                    </div>
                    <img src="@featuredPost.ImageUrl" alt="@featuredPost.Title" loading="lazy" onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('image-error');" />
                </div>
                <div class="featured-blog-content">
                    <div class="blog-meta">
                        <span class="blog-category">@featuredPost.Category</span>
                        <span class="blog-date">
                            <i class="bi bi-calendar"></i>
                            @featuredPost.PublishedDate.ToString("MMMM dd, yyyy")
                        </span>
                        <span class="blog-read-time">
                            <i class="bi bi-clock"></i>
                            @featuredPost.ReadTime @Localizer["MinRead"]
                        </span>
                    </div>
                    <h2 class="featured-blog-title">
                        <a asp-action="Details" asp-route-slug="@featuredPost.Slug">@featuredPost.Title</a>
                    </h2>
                    <p class="featured-blog-excerpt">@featuredPost.Excerpt</p>
                    <div class="featured-blog-footer">
                        <div class="blog-author">
                            <i class="bi bi-person-circle"></i>
                            <span>@featuredPost.Author</span>
                        </div>
                        <a asp-action="Details" asp-route-slug="@featuredPost.Slug" class="btn-read-more">
                            @Localizer["ReadMore"]
                            <i class="bi bi-arrow-@(isRtl ? "left" : "right")"></i>
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- Category Filter -->
        <div class="blog-filters">
            <div class="filter-buttons">
                <button class="filter-btn active" data-category="all">
                    <i class="bi bi-grid"></i>
                    @Localizer["AllPosts"]
                </button>
                @foreach (var category in Model.Select(b => b.Category).Distinct())
                {
                    <button class="filter-btn" data-category="@category">
                        <i class="bi bi-tag"></i>
                        @category
                    </button>
                }
            </div>
        </div>

        <!-- Blog Posts Grid -->
        <div class="blog-posts-grid">
            @foreach (var blog in Model.OrderByDescending(b => b.PublishedDate))
            {
                <article class="blog-post-card" data-category="@blog.Category">
                    <div class="blog-card-image">
                        <img src="@blog.ImageUrl" alt="@blog.Title" loading="lazy" onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('image-error');" />
                        <div class="blog-card-category">
                            <i class="bi bi-tag"></i>
                            @blog.Category
                        </div>
                    </div>
                    <div class="blog-card-content">
                        <div class="blog-card-meta">
                            <span class="blog-card-date">
                                <i class="bi bi-calendar"></i>
                                @blog.PublishedDate.ToString("MMM dd, yyyy")
                            </span>
                            <span class="blog-card-read-time">
                                <i class="bi bi-clock"></i>
                                @blog.ReadTime @Localizer["Min"]
                            </span>
                        </div>
                        <h3 class="blog-card-title">
                            <a asp-action="Details" asp-route-slug="@blog.Slug">@blog.Title</a>
                        </h3>
                        <p class="blog-card-excerpt">@blog.Excerpt</p>
                        <div class="blog-card-footer">
                            <div class="blog-card-author">
                                <i class="bi bi-person"></i>
                                <span>@blog.Author</span>
                            </div>
                            <a asp-action="Details" asp-route-slug="@blog.Slug" class="blog-card-link">
                                @Localizer["ReadMore"]
                                <i class="bi bi-arrow-@(isRtl ? "left" : "right")"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Empty State -->
        <div class="blog-empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="bi bi-search"></i>
            </div>
            <h3>@Localizer["NoBlogsFound"]</h3>
            <p>@Localizer["TryDifferentFilter"]</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Category filtering
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const blogCards = document.querySelectorAll('.blog-post-card');
            const emptyState = document.querySelector('.blog-empty-state');

            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Update active state
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    const selectedCategory = this.dataset.category;
                    
                    let visibleCount = 0;
                    blogCards.forEach(card => {
                        const cardCategory = card.dataset.category;
                        
                        if (selectedCategory === 'all' || cardCategory === selectedCategory) {
                            card.style.display = 'block';
                            visibleCount++;
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    // Show/hide empty state
                    if (visibleCount === 0) {
                        emptyState.style.display = 'block';
                    } else {
                        emptyState.style.display = 'none';
                    }
                });
            });
        });
    </script>
}

