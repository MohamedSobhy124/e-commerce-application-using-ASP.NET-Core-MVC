@using Microsoft.AspNetCore.Mvc.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@model IEnumerable<IdealWeightNutrition.Models.ComboOffer>

@{
    ViewData["Title"] = Localizer["ComboOffers"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["EmptyIcon"] = "bi-box-seam";
    ViewData["EmptyTitle"] = Localizer["NoComboOffersFound"].Value;
    ViewData["EmptyText"] = Localizer["CreateFirstComboOffer"].Value;
    ViewData["EmptyActionUrl"] = Url.Action("Create");
    ViewData["EmptyActionText"] = Localizer["CreateNew"].Value;
    var badgeClass = "badge admin-schedule-live";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["ComboOffers"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Model.Count() @Localizer["ComboOffers"]</p>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        @Localizer["CreateNew"]
                    </a>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <partial name="_AdminEmptyState" />
                }
                else
                {
                    <div class="table-responsive admin-table-wrapper">
                        <table class="table table-bordered table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Image"]</th>
                                    <th scope="col">@Localizer["Name"]</th>
                                    <th scope="col">@Localizer["ComboPrice"]</th>
                                    <th scope="col">@Localizer["Discount"]</th>
                                    <th scope="col">@Localizer["Products"]</th>
                                    <th scope="col">@Localizer["ValidPeriod"]</th>
                                    <th scope="col">@Localizer["Status"]</th>
                                    <th scope="col" class="text-center">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comboOffer in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(comboOffer.ImageUrl))
                                            {
                                                <img src="@comboOffer.ImageUrl" alt="@comboOffer.Name" class="admin-thumb" width="56" height="56" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="admin-thumb-placeholder" aria-hidden="true"><i class="bi bi-image"></i></div>
                                            }
                                        </td>
                                        <td>
                                            <strong>@comboOffer.Name</strong>
                                            @if (!string.IsNullOrEmpty(comboOffer.NameAr))
                                            {
                                                <br />
                                                <small class="text-muted" dir="rtl">@comboOffer.NameAr</small>
                                            }
                                        </td>
                                        <td><strong class="text-success">@comboOffer.ComboPrice.ToString("N2")</strong></td>
                                        <td><span class="badge bg-danger">@(comboOffer.DiscountPercentage.ToString("F1"))% @Localizer["OFF"]</span></td>
                                        <td><span class="badge bg-info text-dark">@comboOffer.TotalProducts @Localizer["Items"]</span></td>
                                        <td>
                                            <div>@comboOffer.StartDate.ToString("yyyy-MM-dd HH:mm")</div>
                                            <div>@comboOffer.EndDate.ToString("yyyy-MM-dd HH:mm")</div>
                                            <small class="text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                        </td>
                                        <td>
                                            <span data-schedule-badge
                                                  data-badge-class="@badgeClass"
                                                  data-enabled="@comboOffer.IsActive.ToString().ToLower()"
                                                  data-start="@comboOffer.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                  data-end="@comboOffer.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                  data-label-active="@Localizer["Active"].Value"
                                                  data-label-scheduled="@Localizer["Scheduled"].Value"
                                                  data-label-ended="@Localizer["Ended"].Value"
                                                  data-label-inactive="@Localizer["Inactive"].Value"
                                                  class="@badgeClass bg-secondary">@Localizer["Inactive"]</span>
                                        </td>
                                        <td>
                                            <div class="admin-row-actions">
                                                <a asp-action="Details" asp-route-id="@comboOffer.Id" class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["Details"]">
                                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@comboOffer.Id" class="btn btn-sm btn-primary" aria-label="@Localizer["Edit"]">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="AddProducts" asp-route-id="@comboOffer.Id" class="btn btn-sm btn-outline-primary" aria-label="@Localizer["ManageProducts"]">
                                                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@comboOffer.Id" class="btn btn-sm btn-danger" aria-label="@Localizer["Delete"]">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
