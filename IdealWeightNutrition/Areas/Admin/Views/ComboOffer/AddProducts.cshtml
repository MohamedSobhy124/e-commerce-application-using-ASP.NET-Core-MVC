@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@model IdealWeightNutrition.Models.ComboOffer

@{
    ViewData["Title"] = Localizer["ManageComboProducts"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var itemCount = Model.ComboOfferItems?.Count(i => !i.IsDeleted) ?? 0;
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["ManageProducts"]</h1>
                <p class="text-muted mb-0">@Model.Name</p>
            </div>
            <div class="admin-form-body">
                <div class="admin-picker-layout">
                    <section class="admin-picker-panel" aria-labelledby="combo-add-product-heading">
                        <h2 id="combo-add-product-heading">@Localizer["AddProduct"]</h2>
                        <form asp-action="AddProduct" method="post" id="addProductForm">
                            <input type="hidden" name="comboOfferId" value="@Model.Id" />

                            <div class="admin-form-group admin-picker-search">
                                <label for="productSelect" class="admin-form-label">@Localizer["Product"] <span class="text-danger">*</span></label>
                                <select name="productId" id="productSelect" class="admin-form-control" required aria-label="@Localizer["SelectProduct"]">
                                    <option value="">@Localizer["SelectProduct"]</option>
                                    @foreach (var product in ViewBag.AvailableProducts as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                    {
                                        <option value="@product.Value">@product.Text</option>
                                    }
                                </select>
                                <div id="productInfoBox" class="admin-picker-summary mt-2" hidden>
                                    <small>
                                        <strong>@Localizer["Product"]:</strong> <span id="productName"></span><br />
                                        <strong>@Localizer["Stock"]:</strong> <span id="productStock" class="badge bg-success"></span><br />
                                        <strong>@Localizer["Price"]:</strong> <span id="productPrice" class="badge bg-secondary"></span>
                                    </small>
                                </div>
                            </div>

                            <div class="admin-form-group" id="variantSelectContainer" hidden>
                                <label for="variantSelect" class="admin-form-label">@Localizer["SelectVariant"] <span class="text-danger">*</span></label>
                                <select name="productVariantId" id="variantSelect" class="admin-form-control" aria-label="@Localizer["SelectVariant"]">
                                    <option value="">@Localizer["SelectVariant"]</option>
                                </select>
                                <div id="variantInfoBox" class="admin-picker-summary mt-2" hidden>
                                    <small>
                                        <strong>@Localizer["Price"]:</strong> <span id="variantPrice" class="badge bg-info"></span><br />
                                        <strong>@Localizer["Stock"]:</strong> <span id="variantStock" class="badge bg-success"></span>
                                    </small>
                                </div>
                            </div>

                            <div class="admin-form-group">
                                <label for="quantityInput" class="admin-form-label">@Localizer["Quantity"] <span class="text-danger">*</span></label>
                                <input type="number" name="quantity" id="quantityInput" class="admin-form-control" min="1" value="1" required aria-label="@Localizer["Quantity"]" />
                            </div>

                            <div class="admin-form-group">
                                <label for="displayOrderInput" class="admin-form-label">@Localizer["DisplayOrder"]</label>
                                <input type="number" name="displayOrder" id="displayOrderInput" class="admin-form-control" min="0" value="0" aria-label="@Localizer["DisplayOrder"]" />
                            </div>

                            <div class="admin-form-group">
                                <div class="form-check">
                                    <input type="checkbox" name="isRequired" class="form-check-input" id="isRequiredCheck" checked aria-label="@Localizer["Required"]" />
                                    <label class="form-check-label" for="isRequiredCheck">@Localizer["Required"]</label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100" id="addProductBtn">
                                <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>@Localizer["AddProduct"]
                            </button>
                        </form>
                    </section>

                    <section class="admin-picker-panel" aria-labelledby="combo-products-list-heading">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 id="combo-products-list-heading" class="mb-0">@Localizer["ProductsInCombo"]</h2>
                            <span class="badge bg-primary">@itemCount @Localizer["Items"]</span>
                        </div>

                        @if (Model.ComboOfferItems == null || !Model.ComboOfferItems.Any(i => !i.IsDeleted))
                        {
                            <div class="admin-empty-state">
                                <i class="bi bi-inbox" aria-hidden="true"></i>
                                <h2>@Localizer["NoProductsInThisCombo"]</h2>
                            </div>
                        }
                        else
                        {
                            <div class="admin-picker-selected-list">
                                @foreach (var item in Model.ComboOfferItems.Where(i => !i.IsDeleted).OrderBy(i => i.DisplayOrder))
                                {
                                    var productTitle = (currentCulture == "ar" && !string.IsNullOrEmpty(item.Product?.TitleAr))
                                        ? item.Product.TitleAr
                                        : item.Product?.Title;
                                    <div class="admin-picker-selected-item">
                                        <div class="admin-picker-selected-meta">
                                            <span class="admin-picker-selected-name">@productTitle</span>
                                            @if (item.ProductVariant != null)
                                            {
                                                string variantName = "";
                                                if (item.ProductVariant.VariantOptionValues != null && item.ProductVariant.VariantOptionValues.Any())
                                                {
                                                    variantName = string.Join(" / ", item.ProductVariant.VariantOptionValues
                                                        .OrderBy(vov => vov.OptionValue?.ProductOption?.DisplayOrder ?? 0)
                                                        .ThenBy(vov => vov.OptionValue?.DisplayOrder ?? 0)
                                                        .Select(vov =>
                                                        {
                                                            var optionName = (currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue?.ProductOption?.NameAr))
                                                                ? vov.OptionValue.ProductOption.NameAr
                                                                : vov.OptionValue?.ProductOption?.Name;
                                                            var optionValue = (currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue?.ValueAr))
                                                                ? vov.OptionValue.ValueAr
                                                                : vov.OptionValue?.Value;
                                                            return $"{optionName}: {optionValue}";
                                                        })
                                                        .Where(s => !string.IsNullOrEmpty(s)));
                                                }
                                                else if (!string.IsNullOrEmpty(item.ProductVariant.VariantName))
                                                {
                                                    variantName = item.ProductVariant.VariantName;
                                                }
                                                if (!string.IsNullOrEmpty(variantName))
                                                {
                                                    <span class="admin-picker-selected-sub"><i class="bi bi-tag me-1" aria-hidden="true"></i>@variantName</span>
                                                }
                                            }
                                            <span class="admin-picker-selected-sub">
                                                @Localizer["Quantity"]: @item.Quantity · @Localizer["Total"]: @item.ItemPrice.ToString("N2")
                                                · @(item.IsRequired ? Localizer["Required"] : Localizer["Optional"])
                                            </span>
                                        </div>
                                        <form asp-action="RemoveProduct" method="post" data-picker-remove data-confirm-message="@Localizer["AreYouSureRemoveProduct"].Value">
                                            <input type="hidden" name="comboOfferId" value="@Model.Id" />
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="@Localizer["RemoveProduct"]">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <div class="admin-picker-summary">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <strong>@Localizer["OriginalTotalPrice"]:</strong>
                                        <span class="text-decoration-line-through">@Model.OriginalTotalPrice.ToString("N2")</span>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>@Localizer["ComboPrice"]:</strong>
                                        <span class="text-success">@Model.ComboPrice.ToString("N2")</span>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>@Localizer["YouSave"]:</strong> @Model.TotalSavings.ToString("N2")
                                    </div>
                                    <div class="col-md-6">
                                        <strong>@Localizer["Discount"]:</strong> @(Model.DiscountPercentage.ToString("F1"))%
                                    </div>
                                </div>
                            </div>
                        }
                    </section>
                </div>

                <div class="form-actions mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>@Localizer["Edit"]
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        const localizations = {
            selectVariant: '@Html.Raw(Localizer["SelectVariant"])',
            variantPrice: '@Html.Raw(Localizer["VariantPrice"])',
            stock: '@Html.Raw(Localizer["Stock"])',
            units: '@Html.Raw(Localizer["units"])'
        };

        let currentStockQty = 0;
        let currentPrice = 0;
        let currentProductType = 0;

        $(document).ready(function () {
            $('#productSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '@Html.Raw(Localizer["SelectProduct"])',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0
            });

            $('#productSelect').on('change', function () {
                const productId = $(this).val();
                const productInfoBox = document.getElementById('productInfoBox');
                const variantContainer = document.getElementById('variantSelectContainer');
                const variantSelect = $('#variantSelect');

                if (!productId) {
                    productInfoBox.hidden = true;
                    variantContainer.hidden = true;
                    if (variantSelect.hasClass('select2-hidden-accessible')) {
                        variantSelect.select2('destroy');
                    }
                    variantSelect.empty().append('<option value="">@Html.Raw(Localizer["SelectVariant"])</option>');
                    return;
                }

                fetch(`/Admin/ComboOffer/GetProductInfo?productId=${productId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) return;
                        currentProductType = data.productType || 0;
                        currentStockQty = data.stockQuantity;
                        currentPrice = data.price;
                        document.getElementById('productName').textContent = data.title;
                        document.getElementById('productStock').textContent = data.stockQuantity;
                        document.getElementById('productPrice').textContent = data.price.toFixed(2);
                        productInfoBox.hidden = false;

                        if (currentProductType === 1 && data.variants && data.variants.length > 0) {
                            if (variantSelect.hasClass('select2-hidden-accessible')) {
                                variantSelect.select2('destroy');
                            }
                            variantSelect.empty().append(`<option value="">${localizations.selectVariant}</option>`);
                            data.variants.forEach(variant => {
                                const displayText = `${variant.name} - ${localizations.variantPrice}: ${variant.price.toFixed(2)} (${localizations.stock}: ${variant.stockQuantity})`;
                                variantSelect.append($('<option></option>').attr('value', variant.id).text(displayText).attr('data-price', variant.price).attr('data-stock', variant.stockQuantity));
                            });
                            variantContainer.hidden = false;
                            document.getElementById('variantInfoBox').hidden = true;
                            variantSelect.select2({ theme: 'bootstrap-5', placeholder: localizations.selectVariant, allowClear: true, width: '100%', minimumInputLength: 0 });
                        } else {
                            variantContainer.hidden = true;
                            if (variantSelect.hasClass('select2-hidden-accessible')) {
                                variantSelect.select2('destroy');
                            }
                        }
                        document.getElementById('quantityInput').max = data.stockQuantity;
                    });
            });

            $('#variantSelect').on('change', function () {
                const variantId = $(this).val();
                const variantInfoBox = document.getElementById('variantInfoBox');
                if (!variantId) {
                    variantInfoBox.hidden = true;
                    document.getElementById('quantityInput').max = currentStockQty;
                    return;
                }
                const selectedOption = $(this).find('option:selected');
                const stock = parseInt(selectedOption.data('stock'), 10);
                const price = parseFloat(selectedOption.data('price'));
                document.getElementById('variantPrice').textContent = price.toFixed(2);
                document.getElementById('variantStock').textContent = stock + ' ' + localizations.units;
                variantInfoBox.hidden = false;
                document.getElementById('quantityInput').max = stock;
            });
        });
    </script>
}
