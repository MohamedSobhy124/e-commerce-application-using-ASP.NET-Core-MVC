@using Microsoft.AspNetCore.Mvc.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@model IdealWeightNutrition.Models.ComboOffer

@{
    ViewData["Title"] = Localizer["CreateComboOffer"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["CreateComboOffer"]</h1>
            </div>
            <div class="admin-form-body">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-lg-8">
                <section class="admin-form-section">
                        <h2>@Localizer["BasicInformation"]</h2>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">@Localizer["NameEnglish"] <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NameAr" class="form-label">@Localizer["NameAr"] <span class="text-danger">*</span></label>
                                <input asp-for="NameAr" class="form-control" dir="rtl" />
                                <span asp-validation-for="NameAr" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DescriptionAr" class="form-label">@Localizer["DescriptionAr"]</label>
                            <textarea asp-for="DescriptionAr" class="form-control" rows="3" dir="rtl"></textarea>
                            <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Images"] <span class="text-danger">*</span></label>
                            <input type="file" name="files" aria-label="@Localizer["UploadImages"]" class="form-control" accept="image/*" multiple required />
                            <span class="text-danger field-validation-valid" data-valmsg-for="files" data-valmsg-replace="true"></span>
                            <small class="form-text text-muted">@Localizer["AtLeastOneImageRequired"]</small>
                            <div id="fileCount" class="mt-2 text-info" hidden>
                                <i class="bi bi-info-circle" aria-hidden="true"></i> <span id="fileCountText"></span>
                            </div>
                            <div id="imagePreview" class="mt-3 d-flex flex-wrap gap-2"></div>
                        </div>
                </section>

                <section class="admin-form-section">
                        <h2>@Localizer["Pricing"]</h2>
                        <div class="mb-3">
                            <label asp-for="ComboPrice" class="form-label">@Localizer["ComboPrice"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">AED</span>
                                <input asp-for="ComboPrice" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="ComboPrice" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["TotalPriceForCombo"]</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@Localizer["Note"]:</strong> @Localizer["OriginalPriceWillBeCalculated"] @Localizer["AfterAddingProducts"]
                        </div>
                </section>

                <section class="admin-form-section" data-schedule-from-inputs>
                        <h2>@Localizer["Schedule"]</h2>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="admin-form-label">@Localizer["StartDate"] <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" class="admin-form-control" type="datetime-local" />
                                <small class="form-text text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="admin-form-label">@Localizer["EndDate"] <span class="text-danger">*</span></label>
                                <input asp-for="EndDate" class="admin-form-control" type="datetime-local" />
                                <small class="form-text text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                        <span data-schedule-badge
                              data-badge-class="badge admin-schedule-live"
                              data-enabled="true"
                              data-start=""
                              data-end=""
                              data-label-active="@Localizer["Active"].Value"
                              data-label-scheduled="@Localizer["Scheduled"].Value"
                              data-label-ended="@Localizer["Ended"].Value"
                              data-label-inactive="@Localizer["Inactive"].Value"
                              class="badge admin-schedule-live bg-secondary">@Localizer["Scheduled"]</span>
                </section>
            </div>

            <div class="col-lg-4">
                <section class="admin-form-section">
                        <h2>@Localizer["Settings"]</h2>
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MinimumQuantity" class="form-label">@Localizer["MinimumQuantity"]</label>
                            <input asp-for="MinimumQuantity" class="form-control" type="number" min="1" value="1" />
                            <span asp-validation-for="MinimumQuantity" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["MinimumComboQuantity"]</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaximumQuantity" class="form-label">@Localizer["MaximumQuantityPerCustomer"]</label>
                            <input asp-for="MaximumQuantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="MaximumQuantity" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["LeaveEmptyForUnlimited"]</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisplayOrder" class="form-label">@Localizer["DisplayOrder"]</label>
                            <input asp-for="DisplayOrder" class="form-control" type="number" min="0" value="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["LowerNumbersDisplayFirst"]</small>
                        </div>

                        <hr />
                        <h6 class="mb-3"><i class="bi bi-truck me-2"></i>@Localizer["FreeDeliverySettings"]</h6>
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="AllowFreeDelivery" id="allowFreeDeliveryCheckbox" onchange="toggleFreeDeliveryMinimum()" />
                                <label class="form-check-label" for="allowFreeDeliveryCheckbox">
                                    <i class="bi bi-truck me-2"></i>@Localizer["AllowFreeDelivery"]
                                </label>
                            </div>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>@Localizer["AllowFreeDeliveryHelpText"]
                            </small>
                        </div>
                        <div class="mb-3" id="freeDeliveryMinimumGroup">
                            <label asp-for="FreeDeliveryMinimumAmount" class="form-label">
                                <i class="bi bi-currency-dollar me-2"></i>@Localizer["FreeDeliveryMinimumAmount"] (AED)
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">AED</span>
                                <input asp-for="FreeDeliveryMinimumAmount" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" id="freeDeliveryMinimumInput" />
                            </div>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>@Localizer["FreeDeliveryMinimumAmountHelpText"]
                            </small>
                            <span asp-validation-for="FreeDeliveryMinimumAmount" class="text-danger"></span>
                        </div>
                </section>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@Localizer["CreateComboOffer"]
                    </button>
                </div>
            </div>
        </div>
    </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function() {
            const fileInput = document.querySelector('input[type="file"][name="files" aria-label="@Localizer["UploadImages"]"]');
            const preview = document.getElementById('imagePreview');
            const form = fileInput ? fileInput.closest('form') : null;
            let selectedFiles = [];
            
            if (fileInput && form) {
                // Update file input before form submission
                form.addEventListener('submit', function(e) {
                    
                    // Ensure files are updated
                    if (selectedFiles.length > 0) {
                        updateFileInput();
                        
                        // Verify the update worked
                        
                        if (fileInput.files.length !== selectedFiles.length) {
                            console.warn('File count mismatch! Expected:', selectedFiles.length, 'Got:', fileInput.files.length);
                            // Try alternative method
                            e.preventDefault();
                            submitFormWithFiles();
                            return false;
                        }
                    }
                });
                
                fileInput.addEventListener('change', function(e) {
                    
                    // Add new files to the array
                    if (this.files && this.files.length > 0) {
                        Array.from(this.files).forEach(file => {
                            if (file.type.startsWith('image/')) {
                                // Check if file is not already in the array
                                const isDuplicate = selectedFiles.some(f => f.name === file.name && f.size === file.size && f.lastModified === file.lastModified);
                                if (!isDuplicate) {
                                    selectedFiles.push(file);
                                }
                            }
                        });
                    }
                    
                    // Update the file input with all accumulated files
                    updateFileInput();
                    // Update preview
                    updatePreview();
                });
                
                function updateFileInput() {
                    if (selectedFiles.length === 0) {
                        return;
                    }
                    
                    try {
                        const dataTransfer = new DataTransfer();
                        selectedFiles.forEach(file => {
                            dataTransfer.items.add(file);
                        });
                        fileInput.files = dataTransfer.files;
                    } catch (err) {
                        console.error('DataTransfer API not supported:', err);
                        alert('@Html.Raw(Localizer["MultipleFileSelectionNotSupported"].Value)');
                    }
                }
                
                function submitFormWithFiles() {
                    const formData = new FormData(form);
                    
                    // Remove old files
                    formData.delete('files');
                    
                    // Add all accumulated files
                    selectedFiles.forEach(file => {
                        formData.append('files', file);
                    });
                    
                    // Submit via fetch
                    fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': form.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            return response.text().then(html => {
                                document.open();
                                document.write(html);
                                document.close();
                            });
                        }
                    })
                    .catch(err => {
                        console.error('Form submission error:', err);
                        alert('@Html.Raw(Localizer["ErrorSubmittingForm"].Value)');
                    });
                }
                
                function updatePreview() {
                    // Update file count
                    const fileCountDiv = document.getElementById('fileCount');
                    const fileCountText = document.getElementById('fileCountText');
                    if (fileCountDiv && fileCountText) {
                        if (selectedFiles.length > 0) {
                            fileCountDiv.hidden = false;
                            fileCountText.textContent = '@Html.Raw(string.Format(Localizer["FilesSelectedCount"].Value, "{0}"))'.replace('{0}', selectedFiles.length);
                        } else {
                            fileCountDiv.hidden = true;
                        }
                    }
                    
                    preview.innerHTML = '';
                    selectedFiles.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const imgWrapper = document.createElement('div');
                            imgWrapper.className = 'position-relative';
                            imgWrapper.style.display = 'inline-block';
                            imgWrapper.style.margin = '5px';
                            
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'img-thumbnail';
                            img.style.maxHeight = '150px';
                            img.style.maxWidth = '150px';
                            img.style.objectFit = 'cover';
                            
                            const removeBtn = document.createElement('button');
                            removeBtn.type = 'button';
                            removeBtn.className = 'btn btn-sm btn-danger position-absolute top-0 end-0 m-1';
                            removeBtn.style.zIndex = '10';
                            removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                            removeBtn.onclick = function() {
                                selectedFiles.splice(index, 1);
                                updateFileInput();
                                updatePreview();
                            };
                            
                            imgWrapper.appendChild(img);
                            imgWrapper.appendChild(removeBtn);
                            preview.appendChild(imgWrapper);
                        };
                        reader.readAsDataURL(file);
                    });
                }
            }
        })();

        function toggleFreeDeliveryMinimum() {
            var allowFreeDelivery = document.getElementById('allowFreeDeliveryCheckbox').checked;
            var minimumGroup = document.getElementById('freeDeliveryMinimumGroup');
            var minimumInput = document.getElementById('freeDeliveryMinimumInput');

            if (allowFreeDelivery) {
                minimumGroup.style.display = 'block';
                if (minimumInput.value == 0) {
                    minimumInput.value = '';
                }
            } else {
                minimumGroup.style.display = 'none';
                minimumInput.value = '0';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            toggleFreeDeliveryMinimum();
        });
    </script>
}

