@model IEnumerable<IdealWeightNutrition.Models.City>
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["CitiesManagement"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">
                    <i class="bi bi-building me-3"></i>
                    @Localizer["CitiesManagement"]
                </h1>
                <div class="admin-header-actions">
                    <a asp-action="Upsert" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2"></i>
                        @Localizer["AddNewCity"]
                    </a>
                </div>
            </div>

            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Model.Count() @Localizer["Cities"]</p>
                    <div class="search-box">
                        <label class="visually-hidden" for="searchInput">@Localizer["SearchCities"]</label>
                        <input type="search" id="searchInput" class="form-control" autocomplete="off" placeholder="@Localizer["SearchCities"]" />
                    </div>
                </div>

                @if (!Model.Any())
                {
                    ViewData["EmptyIcon"] = "bi-geo-alt";
                    ViewData["EmptyTitle"] = Localizer["NoCitiesYet"].Value;
                    ViewData["EmptyText"] = Localizer["CreateCitiesToManageDelivery"].Value;
                    ViewData["EmptyActionUrl"] = Url.Action("Upsert");
                    ViewData["EmptyActionText"] = Localizer["CreateFirstCity"].Value;
                    <partial name="_AdminEmptyState" />
                }
                else
                {
                    <div class="row" id="citiesContainer">
                        @foreach (var city in Model)
                        {
                            var remoteAreasCount = ViewBag.RemoteAreasCount != null && ((Dictionary<int, int>)ViewBag.RemoteAreasCount).ContainsKey(city.Id) 
                                ? ((Dictionary<int, int>)ViewBag.RemoteAreasCount)[city.Id] 
                                : 0;
                            <div class="col-md-6 col-lg-4 mb-4 city-card-item" data-city-id="@city.Id" data-city-name="@city.Name.ToLower() @city.NameAr?.ToLower() @city.Emirate.ToLower()">
                                <div class="city-card @(!city.IsActive ? "inactive" : "")" id="city-card-@city.Id">
                                    <div class="city-card-header">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="city-name mb-1">
                                                    <i class="bi bi-geo-alt-fill me-2"></i>
                                                    @city.Name
                                                </h5>
                                                @if (!string.IsNullOrEmpty(city.NameAr))
                                                {
                                                    <p class="city-name-ar mb-0" dir="rtl">@city.NameAr</p>
                                                }
                                            </div>
                                            <div class="city-status">
                                                <button type="button" class="btn btn-sm toggle-active-btn @(city.IsActive ? "btn-success" : "btn-secondary")" 
                                                        data-city-id="@city.Id" 
                                                        aria-label="@(city.IsActive ? Localizer["Active"] : Localizer["Inactive"])">
                                                    <i class="bi bi-@(city.IsActive ? "check-circle-fill" : "x-circle")"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="city-card-body">
                                        <div class="city-info-item">
                                            <i class="bi bi-map me-2"></i>
                                            <strong>@Localizer["Emirate"]:</strong> @city.Emirate
                                        </div>
                                        <div class="city-info-item">
                                            <i class="bi bi-currency-dollar me-2"></i>
                                            <strong>@Localizer["DeliveryCharge"]:</strong> 
                                            <span class="delivery-charge-badge">@city.DeliveryCharge.ToString("N2") AED</span>
                                        </div>
                                        <div class="city-info-item">
                                            <i class="bi bi-geo-alt me-2"></i>
                                            <strong>@Localizer["RemoteAreas"]:</strong> 
                                            <span class="badge bg-info">@remoteAreasCount</span>
                                        </div>
                                        <div class="city-info-item">
                                            <i class="bi bi-sort-numeric-down me-2"></i>
                                            <strong>@Localizer["DisplayOrder"]:</strong> @city.DisplayOrder
                                        </div>
                                    </div>
                                    <div class="city-card-footer">
                                        <div class="btn-group w-100" role="group">
                                            <a asp-action="Upsert" asp-route-id="@city.Id" class="btn btn-sm btn-primary" title="@Localizer["Edit"]">
                                                <i class="bi bi-pencil me-1"></i> @Localizer["Edit"]
                                            </a>
                                            <button type="button" class="btn btn-sm btn-info manage-areas-btn" 
                                                    data-city-id="@city.Id" 
                                                    data-city-name="@city.Name"
                                                    title="@Localizer["ManageRemoteAreas"]">
                                                <i class="bi bi-list-ul me-1"></i> @Localizer["Areas"]
                                            </button>
                                          @*   <a asp-action="Delete" asp-route-id="@city.Id" class="btn btn-sm btn-danger" title="@Localizer["Delete"]">
                                                <i class="bi bi-trash me-1"></i> @Localizer["Delete"]
                                            </a> *@
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <section class="city-master-detail" id="cityMasterDetail" hidden aria-labelledby="cityMasterDetailTitle">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <h2 class="h5 mb-0" id="cityMasterDetailTitle">
                                <i class="bi bi-list-ul me-2" aria-hidden="true"></i>
                                @Localizer["ManageAreasForCity"]: <span id="masterDetailCityName"></span>
                            </h2>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="closeCityMasterDetail" aria-label="@Localizer["Close"]">
                                <i class="bi bi-x-lg" aria-hidden="true"></i> @Localizer["Close"]
                            </button>
                        </div>
                        <div id="remoteAreasContent">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">@Localizer["Loading"]</span>
                                </div>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function() {
            var activeCityId = null;
            var confirmDeleteArea = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AreYouSureDeleteArea"].Value));
            var errorUpdatingCity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ErrorUpdatingCityStatus"].Value));
            var errorLoadingAreas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ErrorLoadingRemoteAreas"].Value));
            var errorDeletingArea = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ErrorDeletingRemoteArea"].Value));
            var loadingText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Loading"].Value));
            var upsertRemoteAreaUrl = '@Url.Action("Upsert", "RemoteArea")';
            var deleteRemoteAreaUrl = '@Url.Action("Delete", "RemoteArea")';

            $('#searchInput').on('keyup', function() {
                var searchText = $(this).val().toLowerCase();
                $('.city-card-item').each(function() {
                    var cityData = $(this).data('city-name') || '';
                    $(this).toggle(cityData.includes(searchText));
                });
            });

            $('.toggle-active-btn').on('click', function() {
                var cityId = $(this).data('city-id');
                $.ajax({
                    url: '@Url.Action("ToggleActive", "City")',
                    type: 'POST',
                    data: { id: cityId },
                    success: function(response) {
                        if (response.success) location.reload();
                    },
                    error: function() {
                        Swal.fire({ icon: 'error', title: '@Localizer["Error"]', text: errorUpdatingCity });
                    }
                });
            });

            function selectCityCard(cityId) {
                $('.city-card').removeClass('is-selected');
                $('#city-card-' + cityId).addClass('is-selected');
            }

            function showMasterDetail(cityId, cityName) {
                activeCityId = cityId;
                selectCityCard(cityId);
                $('#masterDetailCityName').text(cityName);
                $('#cityMasterDetail').prop('hidden', false);
                loadRemoteAreas(cityId);
                document.getElementById('cityMasterDetail')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            $('.manage-areas-btn').on('click', function() {
                showMasterDetail($(this).data('city-id'), $(this).data('city-name'));
            });

            $('#closeCityMasterDetail').on('click', function() {
                $('#cityMasterDetail').prop('hidden', true);
                $('.city-card').removeClass('is-selected');
                activeCityId = null;
            });

            function loadRemoteAreas(cityId) {
                $('#remoteAreasContent').html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">' + loadingText + '</span></div></div>');
                $.ajax({
                    url: '@Url.Action("GetRemoteAreas", "City")',
                    type: 'GET',
                    data: { cityId: cityId },
                    success: function(response) {
                        if (response.success) {
                            renderRemoteAreas(response.data, cityId);
                        }
                    },
                    error: function() {
                        $('#remoteAreasContent').html('<div class="alert alert-danger">' + errorLoadingAreas + '</div>');
                    }
                });
            }

            function renderRemoteAreas(areas, cityId) {
                var html = '<div class="d-flex justify-content-between align-items-center mb-3">';
                html += '<p class="mb-0 text-muted">@Localizer["RemoteAreas"]</p>';
                html += '<button type="button" class="btn btn-sm btn-primary js-add-remote-area" data-city-id="' + cityId + '">';
                html += '<i class="bi bi-plus-circle me-1" aria-hidden="true"></i> @Localizer["AddRemoteArea"]</button></div>';

                if (areas.length === 0) {
                    html += '<div class="alert alert-info">@Localizer["NoRemoteAreasYet"]</div>';
                } else {
                    html += '<div class="table-responsive admin-table-wrapper"><table class="table table-hover"><thead><tr>';
                    html += '<th scope="col">@Localizer["Name"]</th><th scope="col">@Localizer["NameArabic"]</th><th scope="col">@Localizer["DeliveryCharge"]</th>';
                    html += '<th scope="col">@Localizer["DisplayOrder"]</th><th scope="col">@Localizer["Status"]</th><th scope="col">@Localizer["Actions"]</th></tr></thead><tbody>';
                    areas.forEach(function(area) {
                        html += '<tr><td>' + area.name + '</td><td dir="rtl">' + (area.nameAr || '-') + '</td>';
                        html += '<td><span class="badge bg-success">' + area.deliveryCharge.toFixed(2) + ' AED</span></td>';
                        html += '<td>' + area.displayOrder + '</td>';
                        html += '<td><span class="badge bg-' + (area.isActive ? 'success' : 'secondary') + '">' + (area.isActive ? '@Localizer["Active"]' : '@Localizer["Inactive"]') + '</span></td><td>';
                        html += '<div class="admin-row-actions">';
                        html += '<button type="button" class="btn btn-sm btn-primary js-edit-remote-area" data-area-id="' + area.id + '" aria-label="@Localizer["Edit"]"><i class="bi bi-pencil" aria-hidden="true"></i></button>';
                        html += '<button type="button" class="btn btn-sm btn-danger js-delete-remote-area" data-area-id="' + area.id + '" data-city-id="' + cityId + '" aria-label="@Localizer["Delete"]"><i class="bi bi-trash" aria-hidden="true"></i></button>';
                        html += '</div></td></tr>';
                    });
                    html += '</tbody></table></div>';
                }
                $('#remoteAreasContent').html(html);
            }

            $(document).on('click', '.js-add-remote-area', function() {
                window.location.href = upsertRemoteAreaUrl + '?cityId=' + $(this).data('city-id');
            });

            $(document).on('click', '.js-edit-remote-area', function() {
                window.location.href = upsertRemoteAreaUrl + '?id=' + $(this).data('area-id');
            });

            $(document).on('click', '.js-delete-remote-area', function() {
                var areaId = $(this).data('area-id');
                var cityId = $(this).data('city-id');
                Swal.fire({
                    title: '@Localizer["Confirm"]',
                    text: confirmDeleteArea,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--iw-danger)',
                    cancelButtonText: '@Localizer["Cancel"]',
                    confirmButtonText: '@Localizer["Delete"]'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.ajax({
                        url: deleteRemoteAreaUrl,
                        type: 'POST',
                        data: { id: areaId },
                        success: function() { loadRemoteAreas(cityId); },
                        error: function() {
                            Swal.fire({ icon: 'error', title: '@Localizer["Error"]', text: errorDeletingArea });
                        }
                    });
                });
            });

            window.loadRemoteAreas = loadRemoteAreas;
            window.openAddRemoteAreaModal = function(cityId) {
                window.location.href = upsertRemoteAreaUrl + '?cityId=' + cityId;
            };
            window.editRemoteArea = function(areaId) {
                window.location.href = upsertRemoteAreaUrl + '?id=' + areaId;
            };
            window.deleteRemoteArea = function(areaId, cityId) {
                $('.js-delete-remote-area[data-area-id="' + areaId + '"]').trigger('click');
            };
        });
    </script>
}

