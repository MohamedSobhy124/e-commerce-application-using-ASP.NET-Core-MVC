@model IEnumerable<IdealWeightNutrition.Models.ServiceSubscription>

@{
    ViewData["Title"] = Localizer["ServiceSubscriptions"];
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-briefcase me-3"></i>
                    @Localizer["ServiceSubscriptionsManagement"]
                </h2>
                <div class="d-flex gap-2 align-items-center">
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle"></i>
                        @Localizer["CreateNewService"]
                    </a>
                </div>
            </div>

            <div class="admin-card-body">
                <!-- Quick Action Cards -->
                <div class="service-quick-actions">
                    <div class="service-action-card purchases">
                        <i class="bi bi-cart-check service-action-icon"></i>
                        <h3 class="service-action-title">@Localizer["ServicePurchases"]</h3>
                        <p class="service-action-description">View and manage all service purchases and subscriptions from customers.</p>
                        <a asp-action="Purchases" class="service-action-btn">
                            <i class="bi bi-arrow-right"></i>
                            @Localizer["ViewPurchases"]
                        </a>
                    </div>
                    <div class="service-action-card offers">
                        <i class="bi bi-tag service-action-icon"></i>
                        <h3 class="service-action-title">@Localizer["ServiceOffers"]</h3>
                        <p class="service-action-description">Create and manage special offers and discounts for services.</p>
                        <a asp-area="Admin" asp-controller="ServiceOffer" asp-action="Index" class="service-action-btn">
                            <i class="bi bi-arrow-right"></i>
                            @Localizer["ManageOffers"]
                        </a>
                    </div>
                </div>

                <!-- Services Table -->
                <div class="service-subscription-table-wrapper">
                    <div class="admin-table-wrapper">
                        <table id="tblData" class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>@Localizer["ID"]</th>
                                    <th>@Localizer["Image"]</th>
                                    <th>@Localizer["Title"]</th>
                                    <th>@Localizer["Type"]</th>
                                    <th>@Localizer["Price"]</th>
                                    <th>@Localizer["OfflinePercent"]</th>
                                    <th>@Localizer["Status"]</th>
                                    <th>@Localizer["Purchases"]</th>
                                    <th>@Localizer["Actions"]</th>
                                </tr>   
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/service-subscription-admin.css" />
}

@section Scripts{
    <script type="text/javascript" src="~/js/ServiceSubscription.js"></script>
}

