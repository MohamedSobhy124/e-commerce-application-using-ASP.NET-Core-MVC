@{
    ViewData["Title"] = Localizer["ServiceSubscriptions"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["EmptyIcon"] = "bi-briefcase";
    ViewData["EmptyTitle"] = Localizer["NoServiceSubscriptionsYet"].Value;
    ViewData["EmptyActionUrl"] = Url.Action("Create");
    ViewData["EmptyActionText"] = Localizer["CreateNewService"].Value;
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["ServiceSubscriptionsManagement"]</h1>
            </div>

            <div class="admin-card-body">
                <div class="service-quick-actions">
                    <div class="service-action-card purchases">
                        <i class="bi bi-cart-check service-action-icon" aria-hidden="true"></i>
                        <h2 class="service-action-title h5">@Localizer["ServicePurchases"]</h2>
                        <p class="service-action-description">@Localizer["ServicePurchasesCardDescription"]</p>
                        <a asp-action="Purchases" class="service-action-btn">
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            @Localizer["ViewPurchases"]
                        </a>
                    </div>
                    <div class="service-action-card offers">
                        <i class="bi bi-tag service-action-icon" aria-hidden="true"></i>
                        <h2 class="service-action-title h5">@Localizer["ServiceOffers"]</h2>
                        <p class="service-action-description">@Localizer["ServiceOffersCardDescription"]</p>
                        <a asp-area="Admin" asp-controller="ServiceOffer" asp-action="Index" class="service-action-btn">
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            @Localizer["ManageOffers"]
                        </a>
                    </div>
                </div>

                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0" id="serviceCountMeta">@Localizer["ServiceSubscriptions"]</p>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        @Localizer["CreateNewService"]
                    </a>
                </div>

                <div id="serviceSubscriptionsEmpty" hidden>
                    <partial name="_AdminEmptyState" />
                </div>

                <div class="table-responsive admin-table-wrapper" id="serviceSubscriptionsTableWrap">
                    <table id="tblData" class="table table-bordered table-striped table-hover w-100">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["ID"]</th>
                                <th scope="col">@Localizer["Image"]</th>
                                <th scope="col">@Localizer["Title"]</th>
                                <th scope="col">@Localizer["Type"]</th>
                                <th scope="col">@Localizer["Price"]</th>
                                <th scope="col">@Localizer["OfflinePercent"]</th>
                                <th scope="col">@Localizer["Status"]</th>
                                <th scope="col">@Localizer["Purchases"]</th>
                                <th scope="col" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/service-subscription-admin.css" asp-append-version="true" />
}

@section Scripts{
    <script type="text/javascript" src="~/js/ServiceSubscription.js" asp-append-version="true"></script>
}
