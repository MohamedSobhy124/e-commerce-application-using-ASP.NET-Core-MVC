@{
    ViewData["Title"] = Localizer["ServicePurchases"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["EmptyIcon"] = "bi-cart-check";
    ViewData["EmptyTitle"] = Localizer["NoServicePurchasesYet"].Value;
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["ServicePurchasesManagement"]</h1>
            </div>

            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0" id="purchaseCountMeta">@Localizer["ServicePurchases"]</p>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                        @Localizer["BackToList"]
                    </a>
                </div>

                <div id="servicePurchasesEmpty" hidden>
                    <partial name="_AdminEmptyState" />
                </div>

                <div class="table-responsive admin-table-wrapper" id="servicePurchasesTableWrap">
                    <table id="tblData" class="table table-bordered table-striped table-hover w-100">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["PurchaseID"]</th>
                                <th scope="col">@Localizer["Service"]</th>
                                <th scope="col">@Localizer["Customer"]</th>
                                <th scope="col">@Localizer["Email"]</th>
                                <th scope="col">@Localizer["Phone"]</th>
                                <th scope="col">@Localizer["TotalAmount"]</th>
                                <th scope="col">@Localizer["AmountPaid"]</th>
                                <th scope="col">@Localizer["PaymentStatus"]</th>
                                <th scope="col">@Localizer["PurchaseDate"]</th>
                                <th scope="col" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/service-subscription-admin.css" asp-append-version="true" />
}

@section Scripts{
    <script type="text/javascript" src="~/js/ServicePurchase.js" asp-append-version="true"></script>
}
