@model IdealWeightNutrition.Models.ServicePurchase

@{
    ViewData["Title"] = Localizer["ServicePurchaseDetails"];
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="bi bi-cart-check me-2"></i>@Localizer["ServicePurchaseDetails"]
                </h2>
                <a asp-action="Purchases" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToPurchases"]
                </a>
            </div>

            <div class="card shadow-lg">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0">@Localizer["Purchase"] #@Model.Id</h3>
                    <small>@Localizer["PurchasedOn"] @Model.PurchaseDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <!-- Service Information -->
                        <div class="col-md-6 mb-4">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-briefcase text-primary me-2"></i>@Localizer["ServiceInformation"]
                                </h4>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Service"]:</span>
                                    <span class="detail-value">@Model.ServiceSubscription?.Title</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Type"]:</span>
                                    @if (Model.ServiceSubscription?.ServiceType == ServiceType.Online)
                                    {
                                        <span class="badge bg-success">@Localizer["OnlineService"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@Localizer["OfflineService"]</span>
                                        @if (Model.ServiceSubscription?.OfflinePaymentPercent.HasValue == true)
                                        {
                                            <span class="ms-2">(@Model.ServiceSubscription.OfflinePaymentPercent.Value% @Localizer["OnlinePayment"])</span>
                                        }
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(Model.ServiceSubscription?.Description))
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Description"]:</span>
                                        <span class="detail-value">@Model.ServiceSubscription.Description</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Customer Information -->
                        <div class="col-md-6 mb-4">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-person text-success me-2"></i>@Localizer["CustomerInformation"]
                                </h4>
                                @if (Model.ApplicationUser != null)
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Name"]:</span>
                                        <span class="detail-value">@Model.ApplicationUser.Name</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Email"]:</span>
                                        <span class="detail-value">@Model.ApplicationUser.Email</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Phone"]:</span>
                                        <span class="detail-value">@(Model.ApplicationUser.PhoneNumber ?? Localizer["NA"])</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["UserType"]:</span>
                                        <span class="badge bg-primary">@Localizer["RegisteredUser"]</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Name"]:</span>
                                        <span class="detail-value">@Model.GuestName</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Email"]:</span>
                                        <span class="detail-value">@Model.GuestEmail</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Phone"]:</span>
                                        <span class="detail-value">@(Model.GuestPhone ?? Localizer["NA"])</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["UserType"]:</span>
                                        <span class="badge bg-warning">@Localizer["GuestUser"]</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Payment Information -->
                    <div class="row">
                        <div class="col-12">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-credit-card text-danger me-2"></i>@Localizer["PaymentInformation"]
                                </h4>
                                <div class="payment-details-grid">
                                    <div class="payment-detail-card">
                                        <div class="payment-label">@Localizer["TotalAmount"]</div>
                                        <div class="payment-value">@Model.TotalAmount.ToString("C")</div>
                                    </div>
                                    <div class="payment-detail-card">
                                        <div class="payment-label">@Localizer["AmountPaid"]</div>
                                        <div class="payment-value text-success">@Model.AmountPaid.ToString("C")</div>
                                    </div>
                                    @if (Model.ServiceSubscription?.ServiceType == ServiceType.Offline)
                                    {
                                        <div class="payment-detail-card">
                                            <div class="payment-label">@Localizer["RemainingAmount"]</div>
                                            <div class="payment-value text-warning">@((Model.TotalAmount - Model.AmountPaid).ToString("C"))</div>
                                        </div>
                                    }
                                    <div class="payment-detail-card">
                                        <div class="payment-label">@Localizer["Discount"]</div>
                                        <div class="payment-value text-success">-@Model.DiscountAmount.ToString("C")</div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["PaymentStatus"]:</span>
                                        @if (Model.PaymentStatus == "Approved")
                                        {
                                            <span class="badge bg-success">@Model.PaymentStatus</span>
                                        }
                                        else if (Model.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning">@Model.PaymentStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@Model.PaymentStatus</span>
                                        }
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["PurchaseStatus"]:</span>
                                        <span class="badge bg-info">@Model.Status</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.PaymentIntentId))
                                    {
                                        <div class="detail-item">
                                            <span class="detail-label">@Localizer["PaymentIntentID"]:</span>
                                            <span class="detail-value small">@Model.PaymentIntentId</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.SessionId))
                                    {
                                        <div class="detail-item">
                                            <span class="detail-label">@Localizer["SessionID"]:</span>
                                            <span class="detail-value small">@Model.SessionId</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.ServiceOffer != null)
                    {
                        <hr class="my-4" />
                        <div class="row">
                            <div class="col-12">
                                <div class="detail-section">
                                    <h4 class="section-title">
                                        <i class="bi bi-tag text-warning me-2"></i>@Localizer["AppliedOffer"]
                                    </h4>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["DiscountType"]:</span>
                                        @if (Model.ServiceOffer.DiscountType == DiscountType.Percentage)
                                        {
                                            <span class="badge bg-success">@Model.ServiceOffer.DiscountValue% @Localizer["OFF"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@Model.ServiceOffer.DiscountValue.ToString("C") @Localizer["OFF"]</span>
                                        }
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["ValidPeriod"]:</span>
                                        <span class="detail-value">
                                            @Model.ServiceOffer.StartDate.ToString("MMM dd, yyyy") - 
                                            @Model.ServiceOffer.EndDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ServiceSubscription?.ServiceType == ServiceType.Offline)
                    {
                        <hr class="my-4" />
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@Localizer["OfflineServiceNote"]:</strong> 
                            @Localizer["OfflineServiceNoteText", Model.AmountPaid.ToString("C"), (Model.TotalAmount - Model.AmountPaid).ToString("C")]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-section {
        background: #f9fafb;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e5e7eb;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e5e7eb;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: #6b7280;
        min-width: 150px;
    }

    .detail-value {
        color: #1f2937;
        font-weight: 500;
        text-align: right;
    }

    .payment-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .payment-detail-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        border: 2px solid #e5e7eb;
        text-align: center;
        transition: all 0.3s ease;
    }

    .payment-detail-card:hover {
        border-color: #667eea;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
    }

    .payment-label {
        font-size: 0.9rem;
        color: #6b7280;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .payment-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1f2937;
    }

    .bg-gradient {
        position: relative;
        overflow: hidden;
    }
</style>

