@model IdealWeightNutrition.Models.ServicePurchase
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility

@{
    ViewData["Title"] = Localizer["ServicePurchaseDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    string FormatMoney(decimal amount) => $"{currencySymbol} {amount.ToString("N2")}";
}

<div class="admin-wrapper service-purchase-details">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["Purchase"] #@Model.Id</h1>
                <p class="text-muted mb-0">@Localizer["PurchasedOn"] @Model.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="admin-card-body">
                    <div class="row">
                        <!-- Service Information -->
                        <div class="col-md-6 mb-4">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-briefcase text-primary me-2"></i>@Localizer["ServiceInformation"]
                                </h4>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Service"]:</span>
                                    <span class="detail-value">@Model.ServiceSubscription?.Title</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Type"]:</span>
                                    @if (Model.ServiceSubscription?.ServiceType == ServiceType.Online)
                                    {
                                        <span class="badge bg-success">@Localizer["OnlineService"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@Localizer["OfflineService"]</span>
                                        @if (Model.ServiceSubscription?.OfflinePaymentPercent.HasValue == true)
                                        {
                                            <span class="ms-2">(@(Model.ServiceSubscription.OfflinePaymentPercent.Value)% @Localizer["OnlinePayment"])</span>
                                        }
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(Model.ServiceSubscription?.Description))
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Description"]:</span>
                                        <span class="detail-value">@Model.ServiceSubscription.Description</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Customer Information -->
                        <div class="col-md-6 mb-4">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-person text-success me-2"></i>@Localizer["CustomerInformation"]
                                </h4>
                                @if (Model.ApplicationUser != null)
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Name"]:</span>
                                        <span class="detail-value">@Model.ApplicationUser.Name</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Email"]:</span>
                                        <span class="detail-value">@Model.ApplicationUser.Email</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Phone"]:</span>
                                        <span class="detail-value">@(Model.ApplicationUser.PhoneNumber ?? Localizer["NA"])</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["UserType"]:</span>
                                        <span class="badge bg-primary">@Localizer["RegisteredUser"]</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Name"]:</span>
                                        <span class="detail-value">@Model.GuestName</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Email"]:</span>
                                        <span class="detail-value">@Model.GuestEmail</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["Phone"]:</span>
                                        <span class="detail-value">@(Model.GuestPhone ?? Localizer["NA"])</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["UserType"]:</span>
                                        <span class="badge bg-warning">@Localizer["GuestUser"]</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Payment Information -->
                    <div class="row">
                        <div class="col-12">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-credit-card text-danger me-2"></i>@Localizer["PaymentInformation"]
                                </h4>
                                <div class="payment-details-grid">
                                    <div class="payment-detail-card">
                                        <div class="payment-label">@Localizer["TotalAmount"]</div>
                                        <div class="payment-value">@FormatMoney(Model.TotalAmount)</div>
                                    </div>
                                    <div class="payment-detail-card">
                                        <div class="payment-label">@Localizer["AmountPaid"]</div>
                                        <div class="payment-value text-success">@FormatMoney(Model.AmountPaid)</div>
                                    </div>
                                    @if (Model.ServiceSubscription?.ServiceType == ServiceType.Offline)
                                    {
                                        <div class="payment-detail-card">
                                            <div class="payment-label">@Localizer["RemainingAmount"]</div>
                                            <div class="payment-value text-warning">@FormatMoney(Model.TotalAmount - Model.AmountPaid)</div>
                                        </div>
                                    }
                                    <div class="payment-detail-card">
                                        <div class="payment-label">@Localizer["Discount"]</div>
                                        <div class="payment-value text-success">-@FormatMoney(Model.DiscountAmount)</div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["PaymentStatus"]:</span>
                                        @if (Model.PaymentStatus == "Approved" || Model.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">@Model.PaymentStatus</span>
                                        }
                                        else if (Model.PaymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning">@Model.PaymentStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@Model.PaymentStatus</span>
                                        }
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["PurchaseStatus"]:</span>
                                        <span class="badge bg-info">@Model.Status</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.PaymentIntentId))
                                    {
                                        <div class="detail-item">
                                            <span class="detail-label">@Localizer["PaymentIntentID"]:</span>
                                            <span class="detail-value small">@Model.PaymentIntentId</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.SessionId))
                                    {
                                        <div class="detail-item">
                                            <span class="detail-label">@Localizer["SessionID"]:</span>
                                            <span class="detail-value small">@Model.SessionId</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.ServiceOffer != null)
                    {
                        <hr class="my-4" />
                        <div class="row">
                            <div class="col-12">
                                <div class="detail-section">
                                    <h4 class="section-title">
                                        <i class="bi bi-tag text-warning me-2"></i>@Localizer["AppliedOffer"]
                                    </h4>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["DiscountType"]:</span>
                                        @if (Model.ServiceOffer.DiscountType == DiscountType.Percentage)
                                        {
                                            <span class="badge bg-success">@(Model.ServiceOffer.DiscountValue)% @Localizer["OFF"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@FormatMoney(Model.ServiceOffer.DiscountValue) @Localizer["OFF"]</span>
                                        }
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["ValidPeriod"]:</span>
                                        <span class="detail-value">
                                            @Model.ServiceOffer.StartDate.ToString("MMM dd, yyyy") - 
                                            @Model.ServiceOffer.EndDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.ServiceSubscription?.ServiceType == ServiceType.Offline)
                    {
                        <hr class="my-4" />
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@Localizer["OfflineServiceNote"]:</strong> 
                            @Localizer["OfflineServiceNoteText", FormatMoney(Model.AmountPaid), FormatMoney(Model.TotalAmount - Model.AmountPaid)]
                        </div>
                    }

                    <!-- Admin Actions Section -->
                    <hr class="my-4" />
                    <div class="admin-actions-section">
                        <h4 class="section-title">
                            <i class="bi bi-gear text-primary me-2"></i>@(Localizer["AdminActions"]?.Value ?? "Admin Actions")
                        </h4>
                        
                        <div class="row g-3">
                            <!-- Update Payment Status -->
                            <div class="col-md-6">
                                <div class="admin-action-card">
                                    <h5 class="mb-3">
                                        <i class="bi bi-credit-card text-success me-2"></i>@(Localizer["UpdatePaymentStatus"]?.Value ?? "Update Payment Status")
                                    </h5>
                                    <form id="updatePaymentStatusForm" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <div class="mb-3">
                                            <label class="form-label">@(Localizer["CurrentStatus"]?.Value ?? "Current Status"):</label>
                                            <div class="mb-2">
                                                @if (Model.PaymentStatus == "Approved" || Model.PaymentStatus == "Paid")
                                                {
                                                    <span class="badge bg-success" id="currentPaymentStatus">@Model.PaymentStatus</span>
                                                }
                                                else if (Model.PaymentStatus == "Pending")
                                                {
                                                    <span class="badge bg-warning" id="currentPaymentStatus">@Model.PaymentStatus</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger" id="currentPaymentStatus">@Model.PaymentStatus</span>
                                                }
                                            </div>
                                            <select name="paymentStatus" id="paymentStatusSelect" class="form-select" required>
                                                <option value="Pending" selected="@(Model.PaymentStatus == "Pending")">@(Localizer["Pending"]?.Value ?? "Pending")</option>
                                                <option value="Approved" selected="@(Model.PaymentStatus == "Approved")">@(Localizer["Approved"]?.Value ?? "Approved")</option>
                                                <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">@(Localizer["Paid"]?.Value ?? "Paid")</option>
                                                <option value="Rejected" selected="@(Model.PaymentStatus == "Rejected")">@(Localizer["Rejected"]?.Value ?? "Rejected")</option>
                                                <option value="Cancelled" selected="@(Model.PaymentStatus == "Cancelled")">@(Localizer["Cancelled"]?.Value ?? "Cancelled")</option>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-success w-100" id="updatePaymentStatusBtn">
                                            <i class="bi bi-check-circle me-2"></i>@(Localizer["UpdatePaymentStatus"]?.Value ?? "Update Payment Status")
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- Update Service Status -->
                            <div class="col-md-6">
                                <div class="admin-action-card">
                                    <h5 class="mb-3">
                                        <i class="bi bi-briefcase text-info me-2"></i>@(Localizer["UpdateServiceStatus"]?.Value ?? "Update Service Status")
                                    </h5>
                                    <form id="updateServiceStatusForm" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <div class="mb-3">
                                            <label class="form-label">@(Localizer["CurrentStatus"]?.Value ?? "Current Status"):</label>
                                            <div class="mb-2">
                                                <span class="badge bg-info" id="currentServiceStatus">@Model.Status</span>
                                            </div>
                                            <select name="status" id="serviceStatusSelect" class="form-select" required>
                                                <option value="Active" selected="@(Model.Status == "Active")">@(Localizer["Active"]?.Value ?? "Active")</option>
                                                <option value="Expired" selected="@(Model.Status == "Expired")">@(Localizer["Expired"]?.Value ?? "Expired")</option>
                                                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">@(Localizer["Cancelled"]?.Value ?? "Cancelled")</option>
                                                <option value="Suspended" selected="@(Model.Status == "Suspended")">@(Localizer["Suspended"]?.Value ?? "Suspended")</option>
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-info w-100" id="updateServiceStatusBtn">
                                            <i class="bi bi-check-circle me-2"></i>@(Localizer["UpdateServiceStatus"]?.Value ?? "Update Service Status")
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- Update Amount Paid (for offline services) -->
                            @if (Model.ServiceSubscription?.ServiceType == ServiceType.Offline)
                            {
                                <div class="col-md-12">
                                    <div class="admin-action-card">
                                        <h5 class="mb-3">
                                            <i class="bi bi-wallet2 text-warning me-2"></i>@(Localizer["UpdateAmountPaid"]?.Value ?? "Update Amount Paid")
                                        </h5>
                                        <form id="updateAmountPaidForm" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <div class="row">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label">@(Localizer["CurrentAmountPaid"]?.Value ?? "Current Amount Paid"):</label>
                                                    <div class="form-control-plaintext fw-bold text-success" id="currentAmountPaidDisplay">@FormatMoney(Model.AmountPaid)</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label">@(Localizer["TotalAmount"]?.Value ?? "Total Amount"):</label>
                                                    <div class="form-control-plaintext fw-bold">@FormatMoney(Model.TotalAmount)</div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label">@(Localizer["AddAmount"]?.Value ?? "Add Amount"):</label>
                                                    <input type="number" name="amountPaid" id="amountPaidInput" class="form-control" 
                                                           value="0" 
                                                           min="0" 
                                                           step="0.01" 
                                                           required />
                                                    <small class="text-muted">@(Localizer["AmountToAdd"]?.Value ?? "Amount to add to current payment")</small>
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-warning w-100" id="updateAmountPaidBtn">
                                                <i class="bi bi-check-circle me-2"></i>@(Localizer["UpdateAmountPaid"]?.Value ?? "Update Amount Paid")
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                <div class="form-actions">
                    <a asp-action="Purchases" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToPurchases"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/service-subscription-admin.css" asp-append-version="true" />
}

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Helper function to get form data
        function getFormData(form) {
            const formData = new FormData(form);
            const data = {};
            for (let [key, value] of formData.entries()) {
                data[key] = value;
            }
            return new URLSearchParams(data).toString();
        }

        // Helper function to get anti-forgery token
        function getAntiForgeryToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        // Update Payment Status
        const updatePaymentStatusForm = document.getElementById('updatePaymentStatusForm');
        if (updatePaymentStatusForm) {
            updatePaymentStatusForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const form = this;
                const formData = getFormData(form);
                const submitBtn = form.querySelector('#updatePaymentStatusBtn');
                const originalText = submitBtn.innerHTML;
                
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>@(Localizer["Updating"]?.Value ?? "Updating")...';
                
                fetch('@Url.Action("UpdatePaymentStatus", "ServiceSubscription")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@(Localizer["Success"]?.Value ?? "Success")',
                            text: data.message,
                            confirmButtonColor: '#10b981',
                            confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")',
                            timer: 2000,
                            timerProgressBar: true
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@(Localizer["Error"]?.Value ?? "Error")',
                            text: data.message,
                            confirmButtonColor: '#dc2626',
                            confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                        });
                    }
                })
                .catch(error => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    Swal.fire({
                        icon: 'error',
                        title: '@(Localizer["Error"]?.Value ?? "Error")',
                        text: '@(Localizer["AnErrorOccurred"]?.Value ?? "An error occurred. Please try again.")',
                        confirmButtonColor: '#dc2626',
                        confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                    });
                });
            });
        }

        // Update Service Status
        const updateServiceStatusForm = document.getElementById('updateServiceStatusForm');
        if (updateServiceStatusForm) {
            updateServiceStatusForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const form = this;
                const formData = getFormData(form);
                const submitBtn = form.querySelector('#updateServiceStatusBtn');
                const originalText = submitBtn.innerHTML;
                
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>@(Localizer["Updating"]?.Value ?? "Updating")...';
                
                fetch('@Url.Action("UpdateServiceStatus", "ServiceSubscription")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@(Localizer["Success"]?.Value ?? "Success")',
                            text: data.message,
                            confirmButtonColor: '#10b981',
                            confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")',
                            timer: 2000,
                            timerProgressBar: true
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@(Localizer["Error"]?.Value ?? "Error")',
                            text: data.message,
                            confirmButtonColor: '#dc2626',
                            confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                        });
                    }
                })
                .catch(error => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    Swal.fire({
                        icon: 'error',
                        title: '@(Localizer["Error"]?.Value ?? "Error")',
                        text: '@(Localizer["AnErrorOccurred"]?.Value ?? "An error occurred. Please try again.")',
                        confirmButtonColor: '#dc2626',
                        confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                    });
                });
            });
        }

        // Update Amount Paid
        const updateAmountPaidForm = document.getElementById('updateAmountPaidForm');
        if (updateAmountPaidForm) {
            updateAmountPaidForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const form = this;
                const formData = getFormData(form);
                const submitBtn = form.querySelector('#updateAmountPaidBtn');
                const originalText = submitBtn.innerHTML;
                const amountInput = document.getElementById('amountPaidInput');
                const amountValue = parseFloat(amountInput.value) || 0;
                
                if (amountValue <= 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: '@(Localizer["ValidationError"]?.Value ?? "Validation Error")',
                        text: '@(Localizer["PleaseEnterValidAmount"]?.Value ?? "Please enter a valid amount greater than 0.")',
                        confirmButtonColor: '#f59e0b',
                        confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                    });
                    return;
                }
                
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>@(Localizer["Updating"]?.Value ?? "Updating")...';
                
                fetch('@Url.Action("UpdateAmountPaid", "ServiceSubscription")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@(Localizer["Success"]?.Value ?? "Success")',
                            html: '<div style="text-align: left;">' +
                                  '<p style="margin-bottom: 0.5rem;">' + data.message + '</p>' +
                                  (data.paymentStatus ? '<p style="margin-top: 0.5rem; color: #059669; font-weight: 600;"><i class="bi bi-info-circle me-2"></i>Payment status: ' + data.paymentStatus + '</p>' : '') +
                                  '</div>',
                            confirmButtonColor: '#10b981',
                            confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")',
                            timer: 2500,
                            timerProgressBar: true
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@(Localizer["Error"]?.Value ?? "Error")',
                            text: data.message,
                            confirmButtonColor: '#dc2626',
                            confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                        });
                    }
                })
                .catch(error => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                    Swal.fire({
                        icon: 'error',
                        title: '@(Localizer["Error"]?.Value ?? "Error")',
                        text: '@(Localizer["AnErrorOccurred"]?.Value ?? "An error occurred. Please try again.")',
                        confirmButtonColor: '#dc2626',
                        confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")'
                    });
                });
            });
        }
    });
</script>
}
