@model IdealWeightNutrition.Models.ServiceSubscription

@{
    ViewData["Title"] = Localizer["Delete"];
    var purchaseCount = Model.ServicePurchases?.Count() ?? 0;
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["Delete"]</h1>
                <p class="text-muted mb-0">@Model.Title</p>
            </div>
            <div class="admin-form-body">
                <div class="alert alert-warning">
                    @Localizer["ThisActionCannotBeUndone"]
                </div>
                <dl class="admin-details-list">
                    <dt>@Localizer["TitleEnglish"]</dt>
                    <dd>@Model.Title</dd>
                    @if (!string.IsNullOrEmpty(Model.TitleAr))
                    {
                        <dt>@Localizer["TitleArabic"]</dt>
                        <dd dir="rtl">@Model.TitleAr</dd>
                    }
                    <dt>@Localizer["Price"]</dt>
                    <dd>@Model.Price.ToString("N2")</dd>
                    <dt>@Localizer["Type"]</dt>
                    <dd>@(Model.ServiceType == ServiceType.Online ? Localizer["Online"] : Localizer["Offline"])</dd>
                </dl>

                @if (purchaseCount > 0)
                {
                    <div class="alert alert-danger">
                        @string.Format(Localizer["CannotDeleteServiceWithPurchases"].Value, purchaseCount)
                    </div>
                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="form-actions">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["Cancel"]
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["Delete"]
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
