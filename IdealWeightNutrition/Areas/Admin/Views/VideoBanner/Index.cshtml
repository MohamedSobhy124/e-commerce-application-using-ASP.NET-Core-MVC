@{
    ViewData["Title"] = Localizer["VideoBannerManagement"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper video-banner-admin">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["VideoBannerManagement"]</h1>
                <p class="text-muted mb-0">@Localizer["VideoBannerDescription"]</p>
            </div>

            <div class="admin-card-body">
                <section class="admin-form-section">
                    <h2>@Localizer["VideoFile"]</h2>
                    @if (ViewBag.HasVideo == true)
                    {
                        <div class="alert alert-success" role="status">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                            @Localizer["VideoExists"] — @ViewBag.VideoSizeMB MB · @ViewBag.VideoLastModified.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        <video controls class="admin-media-preview w-100 mb-3" style="max-height: 18rem;">
                            <source src="~/videos/home-banner.mp4" type="video/mp4">
                            @Localizer["YourBrowserDoesNotSupportVideo"]
                        </video>
                        <form asp-action="DeleteVideo" method="post" class="video-delete-form mb-4" id="deleteVideoForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["DeleteVideo"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">@Localizer["NoVideoUploaded"]</div>
                    }

                    <p class="text-muted"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@Localizer["VideoDurationSizeHint"]</p>

                    <form asp-action="UploadVideo" method="post" enctype="multipart/form-data" id="videoUploadForm">
                        @Html.AntiForgeryToken()
                        <label class="admin-drop-zone" for="videoFile">
                            <i class="bi bi-cloud-upload" aria-hidden="true"></i>
                            <span>@Localizer["VideoBannerDropZoneHint"]</span>
                            <small class="text-muted d-block mt-2">@Localizer["VideoRequirements"]</small>
                            <input type="file" class="visually-hidden" id="videoFile" name="videoFile" accept="video/mp4,video/webm,video/quicktime" @(ViewBag.HasVideo != true ? "required" : null) />
                        </label>
                        <div id="videoFileError" class="text-danger mt-2" hidden></div>
                        <div id="videoFileInfo" class="text-muted mt-2" hidden></div>
                        <button type="submit" class="btn btn-primary mt-3" id="videoUploadBtn">
                            <i class="bi bi-upload me-2" aria-hidden="true"></i>@(ViewBag.HasVideo == true ? Localizer["ReplaceVideo"] : Localizer["UploadVideo"])
                        </button>
                    </form>
                </section>

                <section class="admin-form-section">
                    <h2>@Localizer["PosterImage"]</h2>
                    @if (ViewBag.HasPoster == true)
                    {
                        <div class="alert alert-success" role="status">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                            @Localizer["PosterExists"] — @ViewBag.PosterSizeKB KB · @ViewBag.PosterLastModified.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        <img src="~/images/video-banner-poster.jpg" alt="@Localizer["PosterImage"]" class="admin-media-preview mb-3" width="640" height="360" loading="lazy" />
                        <form asp-action="DeletePoster" method="post" class="poster-delete-form mb-4" id="deletePosterForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["DeletePoster"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">@Localizer["NoPosterUploaded"]</div>
                    }

                    <form asp-action="UploadPoster" method="post" enctype="multipart/form-data" id="posterUploadForm">
                        @Html.AntiForgeryToken()
                        <label class="admin-drop-zone" for="posterFile">
                            <i class="bi bi-image" aria-hidden="true"></i>
                            <span>@Localizer["VideoBannerDropZoneHint"]</span>
                            <small class="text-muted d-block mt-2">@Localizer["PosterRequirements"]</small>
                            <input type="file" class="visually-hidden" id="posterFile" name="posterFile" accept="image/jpeg,image/png,image/webp" @(ViewBag.HasPoster != true ? "required" : null) />
                        </label>
                        <div id="posterPreviewWrap" class="mt-3" hidden>
                            <img id="posterPreview" src="#" alt="@Localizer["Preview"]" class="admin-media-preview" />
                        </div>
                        <div id="posterFileError" class="text-danger mt-2" hidden></div>
                        <div id="posterFileInfo" class="text-muted mt-2" hidden></div>
                        <button type="submit" class="btn btn-primary mt-3" id="posterUploadBtn">
                            <i class="bi bi-upload me-2" aria-hidden="true"></i>@(ViewBag.HasPoster == true ? Localizer["ReplacePoster"] : Localizer["UploadPoster"])
                        </button>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const MAX_VIDEO_SIZE = 50 * 1024 * 1024;
            const MAX_POSTER_SIZE = 5 * 1024 * 1024;
            const confirmDeleteVideo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmDeleteVideo"].Value));
            const confirmDeletePoster = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmDeletePoster"].Value));

            function bindDeleteConfirm(formId, message) {
                const form = document.getElementById(formId);
                if (!form) return;
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: '@Localizer["Confirm"]',
                        text: message,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: 'var(--iw-danger)',
                        cancelButtonText: '@Localizer["Cancel"]',
                        confirmButtonText: '@Localizer["Delete"]'
                    }).then(function (result) {
                        if (result.isConfirmed) form.submit();
                    });
                });
            }

            bindDeleteConfirm('deleteVideoForm', confirmDeleteVideo);
            bindDeleteConfirm('deletePosterForm', confirmDeletePoster);

            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const i = Math.floor(Math.log(bytes) / Math.log(1024));
                return (bytes / Math.pow(1024, i)).toFixed(2) + ' ' + ['Bytes', 'KB', 'MB', 'GB'][i];
            }

            const videoFileInput = document.getElementById('videoFile');
            const videoUploadBtn = document.getElementById('videoUploadBtn');
            if (videoFileInput) {
                videoFileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    const err = document.getElementById('videoFileError');
                    const info = document.getElementById('videoFileInfo');
                    err.hidden = true;
                    info.hidden = true;
                    if (!file) return;
                    if (file.size > MAX_VIDEO_SIZE) {
                        err.textContent = '@Localizer["VideoFileTooLarge"]';
                        err.hidden = false;
                        videoUploadBtn.disabled = true;
                        return;
                    }
                    videoUploadBtn.disabled = false;
                    info.textContent = formatFileSize(file.size) + ' — ' + file.name;
                    info.hidden = false;
                });
            }

            const posterFileInput = document.getElementById('posterFile');
            const posterUploadBtn = document.getElementById('posterUploadBtn');
            if (posterFileInput) {
                posterFileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    const err = document.getElementById('posterFileError');
                    const info = document.getElementById('posterFileInfo');
                    const wrap = document.getElementById('posterPreviewWrap');
                    const preview = document.getElementById('posterPreview');
                    err.hidden = true;
                    info.hidden = true;
                    if (!file) return;
                    if (file.size > MAX_POSTER_SIZE) {
                        err.textContent = '@Localizer["ImageFileTooLarge"]';
                        err.hidden = false;
                        posterUploadBtn.disabled = true;
                        return;
                    }
                    posterUploadBtn.disabled = false;
                    info.textContent = formatFileSize(file.size) + ' — ' + file.name;
                    info.hidden = false;
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        wrap.hidden = false;
                    };
                    reader.readAsDataURL(file);
                });
            }
        });
    </script>
}
