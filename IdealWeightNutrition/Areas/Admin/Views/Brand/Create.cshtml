@model IdealWeightNutrition.Models.Brand

@{
    ViewData["Title"] = Localizer["CreateNewBrand"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["CreateNewBrand"]</h1>
            </div>
            <div class="admin-form-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <section class="admin-form-section">
                        <h2>@Localizer["BrandInformation"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="Name" class="admin-form-label">@Localizer["NameEnglish"] <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="admin-form-control" autocomplete="organization" placeholder="@Localizer["EnterBrandName"]" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="NameAr" class="admin-form-label">@Localizer["NameArabic"] <span class="text-danger">*</span></label>
                                    <input asp-for="NameAr" class="admin-form-control" dir="rtl" autocomplete="organization" placeholder="@Localizer["EnterBrandName"]" />
                                    <span asp-validation-for="NameAr" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="Description" class="admin-form-label">@Localizer["DescriptionEnglish"]</label>
                                    <textarea asp-for="Description" class="admin-form-control" rows="4" placeholder="@Localizer["EnterBrandDescription"]"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="DescriptionAr" class="admin-form-label">@Localizer["DescriptionArabic"]</label>
                                    <textarea asp-for="DescriptionAr" class="admin-form-control" rows="4" dir="rtl" placeholder="@Localizer["EnterBrandDescription"]"></textarea>
                                    <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="admin-form-section">
                        <h2>@Localizer["BrandImage"]</h2>
                        <div class="admin-form-group">
                            <label asp-for="ImageFile" class="admin-form-label">@Localizer["UploadImage"]</label>
                            <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" />
                            <small class="form-text text-muted">@Localizer["UploadBrandImage"]</small>
                            <div id="imagePreview" class="mt-3" hidden>
                                <img id="previewImg" src="#" alt="@Localizer["Preview"]" class="admin-media-preview" />
                            </div>
                        </div>
                    </section>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@Localizer["Create"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <partial name="_ValidationScriptsPartial" />
}
