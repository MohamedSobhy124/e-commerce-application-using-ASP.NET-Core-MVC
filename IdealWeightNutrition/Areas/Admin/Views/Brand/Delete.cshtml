@model IdealWeightNutrition.Models.Brand

@{
    ViewData["Title"] = Localizer["DeleteBrand"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["DeleteBrand"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="alert alert-warning">
                    @Localizer["AreYouSureDeleteBrand"] <strong>@Model.Name</strong>
                </div>
                <dl class="admin-details-list">
                    <dt>@Localizer["Image"]</dt>
                    <dd>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="admin-media-preview" />
                        }
                        else
                        {
                            <span class="text-muted">@Localizer["NoImage"]</span>
                        }
                    </dd>
                    <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd>@Model.Name</dd>
                    <dt>@Html.DisplayNameFor(model => model.NameAr)</dt>
                    <dd dir="rtl">@Model.NameAr</dd>
                    <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                    <dd>@Model.Description</dd>
                    <dt>@Html.DisplayNameFor(model => model.DescriptionAr)</dt>
                    <dd dir="rtl">@Model.DescriptionAr</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["Delete"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
