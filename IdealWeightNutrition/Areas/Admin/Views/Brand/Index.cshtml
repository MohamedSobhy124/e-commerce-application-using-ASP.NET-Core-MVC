@model IEnumerable<IdealWeightNutrition.Models.Brand>

@{
    ViewData["Title"] = Localizer["BrandsList"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["EmptyIcon"] = "bi-award";
    ViewData["EmptyTitle"] = Localizer["NoBrandsYet"].Value;
    ViewData["EmptyText"] = Localizer["CreateBrandToOrganizeProducts"].Value;
    ViewData["EmptyActionUrl"] = Url.Action("Create");
    ViewData["EmptyActionText"] = Localizer["CreateFirstBrand"].Value;
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["BrandsList"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Model.Count() @Localizer["Brand"]</p>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        @Localizer["CreateNewBrand"]
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <partial name="_AdminEmptyState" />
                }
                else
                {
                    <div class="table-responsive admin-table-wrapper">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Image"]</th>
                                    <th scope="col">@Html.DisplayNameFor(model => model.Name)</th>
                                    <th scope="col">@Html.DisplayNameFor(model => model.NameAr)</th>
                                    <th scope="col">@Html.DisplayNameFor(model => model.Description)</th>
                                    <th scope="col" class="text-center">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="admin-thumb" width="56" height="56" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="admin-thumb-placeholder" aria-hidden="true"><i class="bi bi-image"></i></div>
                                            }
                                        </td>
                                        <td><strong>@item.Name</strong></td>
                                        <td dir="rtl"><strong>@item.NameAr</strong></td>
                                        <td class="text-muted">@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                                        <td>
                                            <div class="admin-row-actions">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary" aria-label="@Localizer["Edit"]">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["Details"]">
                                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" aria-label="@Localizer["Delete"]">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
