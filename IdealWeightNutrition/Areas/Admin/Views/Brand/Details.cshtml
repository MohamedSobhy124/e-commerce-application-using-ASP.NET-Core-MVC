@model IdealWeightNutrition.Models.Brand

@{
    ViewData["Title"] = Localizer["BrandDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Model.Name</h1>
            </div>
            <div class="admin-card-body">
                <dl class="admin-details-list">
                    <dt>@Localizer["Image"]</dt>
                    <dd>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="admin-media-preview" />
                        }
                        else
                        {
                            <span class="text-muted">@Localizer["NoImage"]</span>
                        }
                    </dd>
                    <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd>@Model.Name</dd>
                    <dt>@Html.DisplayNameFor(model => model.NameAr)</dt>
                    <dd dir="rtl">@Model.NameAr</dd>
                    <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                    <dd>@Model.Description</dd>
                    <dt>@Html.DisplayNameFor(model => model.DescriptionAr)</dt>
                    <dd dir="rtl">@Model.DescriptionAr</dd>
                </dl>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>@Localizer["Edit"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
