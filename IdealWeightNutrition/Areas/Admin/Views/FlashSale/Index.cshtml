@model IEnumerable<FlashSale>

@{
    ViewData["Title"] = Localizer["FlashSalesManagement"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">
                    <i class="bi bi-lightning-charge-fill me-3"></i>
                    @Localizer["FlashSalesManagement"]
                </h1>
            </div>

            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Model.Count() @Localizer["FlashSalesManagement"]</p>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        @Localizer["CreateNewFlashSale"]
                    </a>
                </div>

                @if (!Model.Any())
                {
                    ViewData["EmptyIcon"] = "bi-lightning-charge";
                    ViewData["EmptyTitle"] = Localizer["NoFlashSalesYet"].Value;
                    ViewData["EmptyText"] = Localizer["CreateFlashSaleToBoostSales"].Value;
                    ViewData["EmptyActionUrl"] = Url.Action("Create");
                    ViewData["EmptyActionText"] = Localizer["CreateFirstFlashSale"].Value;
                    <partial name="_AdminEmptyState" />
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var flashSale in Model)
                        {
                            var now = IdealWeightNutrition.Utility.DateTimeHelper.Now;
                            var isActive = flashSale.IsActive && now >= flashSale.StartDate && now <= flashSale.EndDate;
                            var hasStarted = now >= flashSale.StartDate;
                            var hasEnded = now > flashSale.EndDate;
                            var itemCount = flashSale.FlashSaleItems?.Count ?? 0;
                            var totalQty = flashSale.FlashSaleItems?.Sum(i => i.FlashSaleQuantity) ?? 0;

                            string statusBadge = "";
                            string statusIcon = "";
                            string cardBorder = "";

                            if (!flashSale.IsActive)
                            {
                                statusBadge = "bg-secondary";
                                statusIcon = "bi-pause-circle";
                                cardBorder = "border-secondary";
                            }
                            else if (hasEnded)
                            {
                                statusBadge = "bg-danger";
                                statusIcon = "bi-x-circle";
                                cardBorder = "border-danger";
                            }
                            else if (isActive)
                            {
                                statusBadge = "bg-success";
                                statusIcon = "bi-lightning-charge-fill";
                                cardBorder = "border-success";
                            }
                            else
                            {
                                statusBadge = "bg-warning";
                                statusIcon = "bi-clock";
                                cardBorder = "border-warning";
                            }

                            <div class="col-md-6 col-lg-4">
                                <div class="card flash-sale-card @cardBorder" id="flashSaleCard_@flashSale.Id">
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span id="flashSaleStatus_@flashSale.Id"
                                              data-schedule-badge
                                              data-badge-class="badge fs-6"
                                              data-enabled="@flashSale.IsActive.ToString().ToLower()"
                                              data-start="@flashSale.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                              data-end="@flashSale.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                              data-label-active="@Localizer["Active"].Value"
                                              data-label-scheduled="@Localizer["Scheduled"].Value"
                                              data-label-ended="@Localizer["Ended"].Value"
                                              data-label-inactive="@Localizer["Inactive"].Value"
                                              class="badge @statusBadge fs-6">@Localizer["Inactive"]</span>
                                    </div>

                                    <div class="card-body">
                                        <!-- Title -->
                                        <h4 class="card-title mb-3">
                                            <i class="bi bi-lightning-charge-fill me-2"></i>
                                            @flashSale.Name
                                        </h4>

                                        <!-- Description -->
                                        @if (!string.IsNullOrEmpty(flashSale.Description))
                                        {
                                            <p class="text-muted small mb-3">@flashSale.Description</p>
                                        }

                                        <!-- Dates -->
                                        <div class="mb-3">
                                            <small class="d-flex mb-1">
                                                <i class="bi bi-calendar-event text-success me-1" aria-hidden="true"></i>
                                                <strong>@Localizer["Start"]:</strong> @flashSale.StartDate.ToString("yyyy-MM-dd HH:mm")
                                            </small>
                                            <small class="d-flex">
                                                <i class="bi bi-calendar-x text-danger me-1" aria-hidden="true"></i>
                                                <strong>@Localizer["End"]:</strong> @flashSale.EndDate.ToString("yyyy-MM-dd HH:mm")
                                            </small>
                                            <small class="text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                        </div>

                                        <!-- Stats -->
                                        <div class="d-flex justify-content-between mb-3 p-2 bg-light rounded">
                                            <div class="text-center flex-fill">
                                                <div style="font-size: 1.4rem; font-weight: 800;">
                                                    @itemCount
                                                </div>
                                                <small class="text-muted">@Localizer["Products"]</small>
                                            </div>
                                            <div class="text-center flex-fill border-start">
                                                <div style="font-size: 1.4rem; font-weight: 800; color: var(--iw-action-green);">
                                                    @totalQty
                                                </div>
                                                <small class="text-muted">@Localizer["TotalQty"]</small>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="d-grid gap-2">
                                            <a asp-action="Details" asp-route-id="@flashSale.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i> @Localizer["ViewDetails"]
                                            </a>
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@flashSale.Id" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil me-1"></i> @Localizer["Edit"]
                                                </a>
                                                <a asp-action="AddProducts" asp-route-id="@flashSale.Id" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-plus-circle me-1"></i> @Localizer["AddProducts"]
                                                </a>
                                            </div>
                                            <div class="btn-group">
                                                <button type="button" onclick="toggleActive(@flashSale.Id)" class="btn btn-sm @(flashSale.IsActive ? "btn-warning" : "btn-success")" id="toggleBtn_@flashSale.Id" data-flash-active="@flashSale.IsActive.ToString().ToLower()">
                                                    <i class="bi @(flashSale.IsActive ? "bi-pause" : "bi-play") me-1"></i>
                                                    @(flashSale.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                                                </button>
                                                <button onclick="deleteFlashSale(@flashSale.Id)" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash me-1"></i> @Localizer["Delete"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function toggleActive(id) {
            Swal.fire({
                title: '@Localizer["ToggleActiveStatus"]',
                text: '@Localizer["ChangeActiveStatusConfirm"]',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B9DD5',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Localizer["YesToggleIt"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/FlashSale/ToggleActive?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success(data.message);
                            var statusEl = document.getElementById('flashSaleStatus_' + id);
                            var toggleBtn = document.getElementById('toggleBtn_' + id);
                            if (statusEl) {
                                statusEl.setAttribute('data-enabled', data.isActive ? 'true' : 'false');
                                if (typeof refreshScheduleBadges === 'function') {
                                    refreshScheduleBadges();
                                }
                            }
                            if (toggleBtn) {
                                toggleBtn.dataset.flashActive = data.isActive ? 'true' : 'false';
                                toggleBtn.classList.toggle('btn-warning', data.isActive);
                                toggleBtn.classList.toggle('btn-success', !data.isActive);
                                toggleBtn.innerHTML = data.isActive
                                    ? '<i class="bi bi-pause me-1" aria-hidden="true"></i>@Html.Raw(Localizer["Deactivate"].Value)'
                                    : '<i class="bi bi-play me-1" aria-hidden="true"></i>@Html.Raw(Localizer["Activate"].Value)';
                            }
                        } else {
                            toastr.error(data.message);
                        }
                    })
                    .catch(error => {
                        toastr.error('@Localizer["AnErrorOccurred"]');
                        console.error('Error:', error);
                    });
                }
            });
        }

        function deleteFlashSale(id) {
            Swal.fire({
                title: '@Localizer["DeleteFlashSaleConfirm"]',
                text: '@Localizer["DeleteFlashSaleWarning"]',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '@Localizer["YesDeleteIt"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/FlashSale/Delete?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('@Localizer["Deleted"]', data.message, 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            toastr.error(data.message);
                        }
                    })
                    .catch(error => {
                        toastr.error('@Localizer["AnErrorOccurred"]');
                        console.error('Error:', error);
                    });
                }
            });
        }
    </script>
}
