@model IEnumerable<IdealWeightNutrition.Models.ServiceOffer>

@{
    ViewData["Title"] = Localizer["ServiceOffers"];
    ViewData["EmptyIcon"] = "bi-gift";
    ViewData["EmptyTitle"] = Localizer["NoServiceOffersYet"].Value;
    ViewData["EmptyActionUrl"] = Url.Action("Create");
    ViewData["EmptyActionText"] = Localizer["CreateNewOffer"].Value;
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["ServiceOffers"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Model.Count() @Localizer["ServiceOffers"]</p>
                    <div class="admin-header-actions">
                        <a asp-action="Create" class="create-new-btn">
                            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                            @Localizer["CreateNewOffer"]
                        </a>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <partial name="_AdminEmptyState" />
                }
                else
                {
                    <div class="table-responsive admin-table-wrapper">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["ID"]</th>
                                    <th scope="col">@Localizer["Service"]</th>
                                    <th scope="col">@Localizer["Discount"]</th>
                                    <th scope="col">@Localizer["ValidPeriod"]</th>
                                    <th scope="col">@Localizer["Status"]</th>
                                    <th scope="col">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var offer in Model)
                                {
                                    var now = IdealWeightNutrition.Utility.DateTimeHelper.Now;
                                    var isExpired = offer.EndDate < now;
                                    var isNotStarted = offer.StartDate > now;
                                    var statusKey = offer.IsActive && !isExpired && !isNotStarted ? "Active" : (!offer.IsActive ? "Inactive" : (isExpired ? "Ended" : "Scheduled"));
                                    <tr>
                                        <td><strong>#@offer.Id</strong></td>
                                        <td>
                                            @if (offer.ServiceSubscription != null)
                                            {
                                                <strong>@offer.ServiceSubscription.Title</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@Localizer["NA"]</span>
                                            }
                                        </td>
                                        <td>
                                            @if (offer.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                            {
                                                <span>@(offer.DiscountValue)%</span>
                                            }
                                            else
                                            {
                                                <span>@offer.DiscountValue.ToString("N2")</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@offer.StartDate.ToString("yyyy-MM-dd")</div>
                                            <div>@offer.EndDate.ToString("yyyy-MM-dd")</div>
                                            <small class="text-muted">@Localizer["TimezoneAsiaDubai"]</small>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@Localizer[statusKey]</span></td>
                                        <td>
                                            <div class="admin-row-actions">
                                                <a asp-action="Edit" asp-route-id="@offer.Id" class="btn btn-sm btn-primary" aria-label="@Localizer["Edit"]">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@offer.Id" class="btn btn-sm btn-danger" aria-label="@Localizer["Delete"]">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
