@model IdealWeightNutrition.Models.ServiceOffer

@{
    ViewData["Title"] = Localizer["EditServiceOffer"];
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h2 class="mb-0">@Localizer["EditServiceOffer"]</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["ServiceSubscription"] *</label>
                                <select asp-for="ServiceSubscriptionId" class="form-select" asp-items="ViewBag.ServiceSubscriptionList" required>
                                    <option value="">@Localizer["SelectService"]</option>
                                </select>
                                <span asp-validation-for="ServiceSubscriptionId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 d-none">
                                <label class="form-label fw-bold">@Localizer["LinkToPromoCodeOptional"]</label>
                                <select asp-for="PromoCodeId" class="form-select" asp-items="ViewBag.PromoCodeList">
                                    <option value="">@Localizer["None"]</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["DiscountType"] *</label>
                                <select asp-for="DiscountType" class="form-select" id="discountType">
                                    <option value="1">@Localizer["Percentage"]</option>
                                    <option value="2">@Localizer["FixedAmount"]</option>
                                </select>
                                <span asp-validation-for="DiscountType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["DiscountValue"] *</label>
                                <div class="input-group">
                                    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" required />
                                    <span class="input-group-text" id="discountSymbol">@(Model.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage ? "%" : "AED")</span>
                                </div>
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["StartDate"] *</label>
                                <input asp-for="StartDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["EndDate"] *</label>
                                <input asp-for="EndDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold d-block">@Localizer["Status"]</label>
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" style="width: 3rem; height: 1.5rem;" />
                                    <label class="form-check-label ms-2 fw-bold">@Localizer["Active"]</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg px-5 me-2">
                                    <i class="bi bi-check-circle me-2"></i>@Localizer["UpdateOffer"]
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg px-4">@Localizer["Cancel"]</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Set initial discount symbol
            var discountType = $('#discountType').val();
            var symbol = discountType == '1' ? '%' : 'AED';
            $('#discountSymbol').text(symbol);
            
            // Update symbol when discount type changes
            $('#discountType').change(function() {
                var symbol = $(this).val() == '1' ? '%' : 'AED';
                $('#discountSymbol').text(symbol);
            });
        });
    </script>
}
