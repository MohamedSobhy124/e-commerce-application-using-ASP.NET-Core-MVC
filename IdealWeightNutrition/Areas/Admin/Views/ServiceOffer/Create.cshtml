@model IdealWeightNutrition.Models.ServiceOffer

@{
    ViewData["Title"] = Localizer["CreateServiceOffer"];
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["CreateServiceOffer"]</h1>
            </div>
            <div class="admin-form-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <section class="admin-form-section">
                        <h2>@Localizer["OfferDetails"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="ServiceSubscriptionId" class="admin-form-label">@Localizer["ServiceSubscription"] <span class="text-danger">*</span></label>
                                    <select asp-for="ServiceSubscriptionId" class="admin-form-control" asp-items="ViewBag.ServiceSubscriptionList">
                                        <option value="">@Localizer["SelectService"]</option>
                                    </select>
                                    <span asp-validation-for="ServiceSubscriptionId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 d-none">
                                <div class="admin-form-group">
                                    <label asp-for="PromoCodeId" class="admin-form-label">@Localizer["LinkToPromoCodeOptional"]</label>
                                    <select asp-for="PromoCodeId" class="admin-form-control" asp-items="ViewBag.PromoCodeList">
                                        <option value="">@Localizer["None"]</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="DiscountType" class="admin-form-label">@Localizer["DiscountType"] <span class="text-danger">*</span></label>
                                    <select asp-for="DiscountType" class="admin-form-control" id="discountType">
                                        <option value="1">@Localizer["Percentage"]</option>
                                        <option value="2">@Localizer["FixedAmount"]</option>
                                    </select>
                                    <span asp-validation-for="DiscountType" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="DiscountValue" class="admin-form-label">@Localizer["DiscountValue"] <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="DiscountValue" class="admin-form-control" type="number" step="0.01" />
                                        <span class="input-group-text" id="discountSymbol">%</span>
                                    </div>
                                    <span asp-validation-for="DiscountValue" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="StartDate" class="admin-form-label">@Localizer["StartDate"] <span class="text-danger">*</span></label>
                                    <input asp-for="StartDate" class="admin-form-control" type="datetime-local" />
                                    <small class="form-text text-muted">@Localizer["TimezoneAsiaDubai"]</small>
                                    <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="EndDate" class="admin-form-label">@Localizer["EndDate"] <span class="text-danger">*</span></label>
                                    <input asp-for="EndDate" class="admin-form-control" type="datetime-local" />
                                    <small class="form-text text-muted">@Localizer["TimezoneAsiaDubai"]</small>
                                    <span asp-validation-for="EndDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                        <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@Localizer["CreateOffer"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('discountType')?.addEventListener('change', function () {
            var symbol = this.value === '1' ? '%' : 'AED';
            var target = document.getElementById('discountSymbol');
            if (target) {
                target.textContent = symbol;
            }
        });
    </script>
}
