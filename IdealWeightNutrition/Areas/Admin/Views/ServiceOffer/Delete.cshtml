@model IdealWeightNutrition.Models.ServiceOffer

@{
    ViewData["Title"] = Localizer["DeleteServiceOffer"];
    var serviceName = Model.ServiceSubscription?.Title ?? Localizer["NA"].Value;
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["DeleteServiceOffer"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="alert alert-warning">
                    @Localizer["AreYouSureDeleteServiceOffer"] <strong>@serviceName</strong>
                </div>
                <dl class="admin-details-list">
                    <dt>@Localizer["ID"]</dt>
                    <dd>#@Model.Id</dd>
                    <dt>@Localizer["Service"]</dt>
                    <dd>@serviceName</dd>
                    <dt>@Localizer["Discount"]</dt>
                    <dd>
                        @(Model.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage
                            ? Model.DiscountValue + "%"
                            : Model.DiscountValue.ToString("N2"))
                    </dd>
                    <dt>@Localizer["StartDate"]</dt>
                    <dd>@Model.StartDate.ToString("yyyy-MM-dd HH:mm")</dd>
                    <dt>@Localizer["EndDate"]</dt>
                    <dd>@Model.EndDate.ToString("yyyy-MM-dd HH:mm")</dd>
                    <dt>@Localizer["Status"]</dt>
                    <dd>@(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["DeleteOffer"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
