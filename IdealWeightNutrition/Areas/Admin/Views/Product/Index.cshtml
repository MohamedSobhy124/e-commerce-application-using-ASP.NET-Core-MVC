@model IEnumerable<IdealWeightNutrition.Models.Product>
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility

@{
    ViewData["Title"] = Localizer["ProductsList"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var isArabic = currentCulture == "ar";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">
                    <i class="bi bi-box-seam-fill me-3"></i>
                    @Localizer["ProductsList"]
                </h1>
            </div>

            <div class="admin-card-body">
                <!-- Product Statistics Cards -->
                <div class="order-stats-container" id="productStatsContainer">
                    <button type="button" class="order-stat-card all is-active" data-product-filter="all" aria-pressed="true">
                        <div class="order-stat-icon"><i class="bi bi-list-ul" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["TotalProducts"]</div>
                        <div class="order-stat-value" id="statAll">0</div>
                    </button>
                    <button type="button" class="order-stat-card approved" data-product-filter="active" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["Active"]</div>
                        <div class="order-stat-value" id="statActive">0</div>
                    </button>
                    <button type="button" class="order-stat-card pending" data-product-filter="lowstock" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["LowStock"]</div>
                        <div class="order-stat-value" id="statLowStock">0</div>
                    </button>
                    <button type="button" class="order-stat-card inprocess" data-product-filter="outofstock" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-x-circle" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["OutOfStock"]</div>
                        <div class="order-stat-value" id="statOutOfStock">0</div>
                    </button>
                    <button type="button" class="order-stat-card shipped" data-product-filter="instock" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["InStock"]</div>
                        <div class="order-stat-value" id="statInStock">0</div>
                    </button>
                    <button type="button" class="order-stat-card delivered" data-product-filter="new" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-star" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["NewProducts"]</div>
                        <div class="order-stat-value" id="statNew">0</div>
                    </button>
                </div>

                <!-- Filter Tabs -->
                <div class="order-filter-tabs" id="productFilterTabs" role="group" aria-label="@Localizer["FilterByStatus"]">
                    <button type="button" class="filter-tab active" data-product-filter="all" aria-pressed="true">
                        <i class="bi bi-list-ul" aria-hidden="true"></i>@Localizer["AllProducts"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="active" aria-pressed="false">
                        <i class="bi bi-check-circle" aria-hidden="true"></i>@Localizer["Active"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="lowstock" aria-pressed="false">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@Localizer["LowStock"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="outofstock" aria-pressed="false">
                        <i class="bi bi-x-circle" aria-hidden="true"></i>@Localizer["OutOfStock"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="instock" aria-pressed="false">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>@Localizer["InStock"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="new" aria-pressed="false">
                        <i class="bi bi-star" aria-hidden="true"></i>@Localizer["NewProducts"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="trending" aria-pressed="false">
                        <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>@Localizer["TrendingProducts"]
                    </button>
                    <button type="button" class="filter-tab" data-product-filter="deleted" aria-pressed="false">
                        <i class="bi bi-trash" aria-hidden="true"></i>@Localizer["Deleted"]
                    </button>
                </div>

                <!-- Search Box -->
                <div class="search-box-container iw-admin-search-box mb-4">
                    <div class="input-group search-box">
                        <button type="button" class="btn btn-outline-secondary" id="clearProductSearchBtn" aria-label="@Localizer["ClearSearch"]">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                        <input type="text"
                               id="productSearchInput"
                               class="form-control"
                               placeholder="@Localizer["SearchProductsPlaceholder"]" aria-label="@Localizer["SearchProductsPlaceholder"]">
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@Localizer["ProductSearchHint"]
                    </small>
                </div>

                <!-- Create New Product Button and Export -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <button type="button" class="btn btn-success" id="exportProductsBtn">
                        <i class="bi bi-download me-1" aria-hidden="true"></i>@Localizer["ExportProducts"]
                    </button>
                    <a asp-action="UpSert" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2"></i>
                        @Localizer["CreateNewProduct"]
                    </a>
                </div>

                <!-- Product Table -->
                <div class="order-table-wrapper">
                    <div id="productTable" class="admin-product-table-host">
                        <div class="admin-table-loading" id="productTableLoading">
                            <i class="bi bi-arrow-repeat admin-spin-icon" aria-hidden="true"></i>
                            <p class="admin-table-loading-title">@Localizer["LoadingProducts"]</p>
                            <p class="text-muted mb-0">@Localizer["LoadingProductsHint"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/order-index.css" />
    <!-- Tabulator CSS -->
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet">
}

@section Scripts {
    <!-- Tabulator JS -->
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    
    <script>
        // Pass translations to JavaScript
        window.productTranslations = {
            id: '@Html.Raw(Localizer["ID"].Value)',
            title: '@Html.Raw(Localizer["TitleEnglish"].Value)',
            titleAr: '@Html.Raw(Localizer["TitleArabic"].Value)',
            price: '@Html.Raw(Localizer["Price"].Value)',
            storeCost: '@Html.Raw(Localizer["StoreCost"].Value)',
            profit: '@Html.Raw(Localizer["Profit"].Value)',
            stock: '@Html.Raw(Localizer["Stock"].Value)',
            category: '@Html.Raw(Localizer["Category"].Value)',
            actions: '@Html.Raw(Localizer["Actions"].Value)',
            edit: '@Html.Raw(Localizer["Edit"].Value)',
            delete: '@Html.Raw(Localizer["Delete"].Value)',
            deleted: '@Html.Raw(Localizer["Deleted"].Value)',
            noActions: '@Html.Raw(Localizer["NoActions"]?.Value ?? "No Actions")',
            undelete: '@Html.Raw(Localizer["Undelete"]?.Value ?? "Undelete")',
            restore: '@Html.Raw(Localizer["Restore"]?.Value ?? "Restore")',
            areYouSure: '@Html.Raw(Localizer["AreYouSure"]?.Value ?? "Are you sure?")',
            deleteConfirm: '@Html.Raw(Localizer["DeleteConfirmMessage"]?.Value ?? "You won't be able to revert this!")',
            restoreConfirm: '@Html.Raw(Localizer["RestoreConfirmMessage"]?.Value ?? "This will restore the product and make it available again.")',
            yesDelete: '@Html.Raw(Localizer["YesDeleteIt"]?.Value ?? "Yes, delete it!")',
            yesRestore: '@Html.Raw(Localizer["YesRestoreIt"]?.Value ?? "Yes, restore it!")',
            cancel: '@Html.Raw(Localizer["Cancel"]?.Value ?? "Cancel")',
            noProductsFound: '@Html.Raw(Localizer["NoProductsFound"].Value)',
            loadingProducts: '@Html.Raw(Localizer["LoadingProducts"].Value)',
            tabulatorLoadFailed: '@Html.Raw(Localizer["TabulatorLoadFailed"].Value)',
            newBadge: '@Html.Raw(Localizer["NewBadge"].Value)',
            trendingBadge: '@Html.Raw(Localizer["TrendingBadge"].Value)',
            notAvailable: '@Html.Raw(Localizer["NotAvailable"].Value)'
        };

        window.adminProductFormat = (function() {
            var t = window.productTranslations;
            var currencySymbol = '@currencySymbol';
            var isArabic = @(isArabic ? "true" : "false");

            function escapeHtml(value) {
                if (value == null || String(value).trim() === '') {
                    return t.notAvailable;
                }
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatMoney(value) {
                var n = parseFloat(value);
                if (isNaN(n)) {
                    n = 0;
                }
                return currencySymbol + ' ' + n.toFixed(2);
            }

            return {
                escapeHtml: escapeHtml,
                formatMoney: formatMoney,
                isArabic: isArabic
            };
        })();
    </script>
    <script>
        
        // Load statistics function
        window.loadProductStatistics = function() {
            fetch('/Admin/Product/GetProductStatistics')
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.stats) {
                        document.getElementById('statAll').textContent = data.stats.all || 0;
                        document.getElementById('statActive').textContent = data.stats.active || 0;
                        document.getElementById('statLowStock').textContent = data.stats.lowStock || 0;
                        document.getElementById('statOutOfStock').textContent = data.stats.outOfStock || 0;
                        document.getElementById('statInStock').textContent = data.stats.inStock || 0;
                        document.getElementById('statNew').textContent = data.stats.newProducts || 0;
                    }
                })
                .catch(error => {
                    console.error('Failed to load statistics:', error);
                });
        };
        
        // Initialize filter in global scope
        window.currentFilter = 'all';
        
        window.addEventListener('load', function() {
            
            // Load statistics first
            window.loadProductStatistics();
            
            setTimeout(function() {
                if (typeof Tabulator === 'undefined') {
                    console.error('❌ Tabulator NOT LOADED');
                    document.getElementById('productTable').innerHTML = '<div class="admin-table-loading"><p class="text-danger">' + window.productTranslations.tabulatorLoadFailed + '</p></div>';
                    return;
                }
                
                
                var table = new Tabulator("#productTable", {
                    layout: "fitColumns",
                    responsiveLayout: false,
                    columnDefaults: { resizable: false },
                    placeholder: window.productTranslations.noProductsFound,
                    pagination: true,
                    paginationMode: "remote",
                    paginationSize: 10,
                    paginationSizeSelector: [10, 25, 50, 100],
                    paginationCounter: "rows",
                    ajaxURL: "/Admin/Product/GetAll",
                    ajaxParams: function() {
                        var filter = window.currentFilter === 'all' ? '' : window.currentFilter;
                        return { filter: filter };
                    },
                    ajaxURLGenerator: function(url, config, params){
                        var filter = window.currentFilter === 'all' ? '' : window.currentFilter;
                        var searchValue = document.getElementById('productSearchInput') ? document.getElementById('productSearchInput').value : '';
                        
                        var queryParams = [
                            `start=${(params.page - 1) * params.size}`,
                            `length=${params.size}`,
                            `filter=${encodeURIComponent(filter)}`,
                            `searchValue=${encodeURIComponent(searchValue)}`
                        ];
                        
                        if (params.sort && params.sort.length > 0) {
                            queryParams.push(`sortColumn=${params.sort[0].field}`);
                            queryParams.push(`sortDirection=${params.sort[0].dir}`);
                        }
                        
                        var finalUrl = url + '?' + queryParams.join('&');
                        return finalUrl;
                    },
                    ajaxResponse: function(url, params, response) {
                        return {
                            last_page: response.last_page || 1,
                            data: response.data || []
                        };
                    },
                    columns: [
                        {
                            title: window.productTranslations.id,
                            field: "id",
                            width: 72,
                            widthGrow: 0,
                            sorter: "number",
                            headerSort: true,
                            variableHeight: true,
                            formatter: function(cell) {
                                var t = window.productTranslations;
                                var data = cell.getRow().getData();
                                var badges = '';
                                if (data.isDeleted) {
                                    badges += '<span class="order-badge badge-danger">' + t.deleted + '</span>';
                                }
                                if (data.isNew) {
                                    badges += '<span class="order-badge badge-info">' + t.newBadge + '</span>';
                                }
                                if (data.isTrending) {
                                    badges += '<span class="order-badge badge-warning">' + t.trendingBadge + '</span>';
                                }
                                return '<div class="admin-order-stack">'
                                    + '<a href="/Admin/Product/UpSert?id=' + data.id + '" class="product-id-cell admin-order-id">#' + data.id + '</a>'
                                    + (badges ? '<div class="admin-product-badges">' + badges + '</div>' : '')
                                    + '</div>';
                            },
                            cellClick: function(e) {
                                e.stopPropagation();
                            }
                        },
                        {
                            title: window.productTranslations.title,
                            field: "title",
                            widthGrow: 2.6,
                            sorter: "string",
                            headerSort: true,
                            variableHeight: true,
                            formatter: function(cell) {
                                var fmt = window.adminProductFormat;
                                var data = cell.getRow().getData();
                                var primary = fmt.isArabic ? data.titleAr : data.title;
                                var secondary = fmt.isArabic ? data.title : data.titleAr;
                                var deletedClass = data.isDeleted ? ' admin-product-deleted' : '';
                                return '<div class="admin-order-stack' + deletedClass + '">'
                                    + '<span class="admin-order-primary">' + fmt.escapeHtml(primary) + '</span>'
                                    + '<span class="admin-order-muted">' + fmt.escapeHtml(secondary) + '</span>'
                                    + '<span class="admin-order-muted">' + fmt.escapeHtml(data.category) + '</span>'
                                    + '</div>';
                            }
                        },
                        {
                            title: window.productTranslations.price,
                            field: "price",
                            width: 88,
                            widthGrow: 0,
                            sorter: "number",
                            headerSort: true,
                            variableHeight: true,
                            formatter: function(cell) {
                                var fmt = window.adminProductFormat;
                                var data = cell.getRow().getData();
                                var html = '<div class="admin-order-stack admin-order-stack--end">'
                                    + '<span class="admin-order-money">' + fmt.formatMoney(data.price) + '</span>';
                                if (data.listPrice && data.listPrice > data.price) {
                                    html += '<span class="admin-order-muted admin-product-list-price">' + fmt.formatMoney(data.listPrice) + '</span>';
                                }
                                return html + '</div>';
                            }
                        },
                        {
                            title: window.productTranslations.profit,
                            field: "profit",
                            widthGrow: 0.9,
                            sorter: "number",
                            headerSort: true,
                            variableHeight: true,
                            formatter: function(cell) {
                                var fmt = window.adminProductFormat;
                                var data = cell.getRow().getData();
                                var profit = parseFloat(data.profit) || 0;
                                var profitPercentage = parseFloat(data.profitPercentage) || 0;
                                if (profit <= 0) {
                                    return '<span class="admin-order-muted">' + window.productTranslations.notAvailable + '</span>';
                                }
                                var html = '<div class="admin-order-stack admin-order-stack--end">'
                                    + '<span class="admin-order-money">' + fmt.formatMoney(profit) + '</span>';
                                if (profitPercentage > 0) {
                                    html += '<span class="admin-order-muted">(' + profitPercentage.toFixed(1) + '%)</span>';
                                }
                                return html + '</div>';
                            }
                        },
                        {
                            title: window.productTranslations.stock,
                            field: "stockQuantity",
                            widthGrow: 0.8,
                            sorter: "number",
                            headerSort: true,
                            formatter: function(cell) {
                                var stock = parseInt(cell.getValue(), 10) || 0;
                                var minAlert = cell.getRow().getData().minimumStockAlert || 0;
                                var cls = 'badge-success';
                                var icon = 'bi-check-circle';
                                if (stock <= 0) {
                                    cls = 'badge-danger';
                                    icon = 'bi-x-circle';
                                } else if (stock <= minAlert) {
                                    cls = 'badge-warning';
                                    icon = 'bi-exclamation-triangle';
                                }
                                return '<span class="order-badge ' + cls + '"><i class="bi ' + icon + '" aria-hidden="true"></i>' + stock + '</span>';
                            }
                        },
                        {
                            title: window.productTranslations.actions,
                            field: "actions",
                            width: 148,
                            headerSort: false,
                            hozAlign: "center",
                            formatter: function(cell) {
                                var t = window.productTranslations;
                                var productId = cell.getRow().getData().id;
                                var rowData = cell.getRow().getData();
                                if (rowData.isDeleted) {
                                    return '<div class="admin-product-actions">'
                                        + '<button type="button" class="btn btn-sm btn-success admin-order-action" data-product-undelete="' + productId + '" aria-label="' + t.restore + '" title="' + t.restore + '">'
                                        + '<i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>'
                                        + '</div>';
                                }
                                return '<div class="admin-product-actions">'
                                    + '<a href="/Admin/Product/UpSert?id=' + productId + '" class="btn btn-sm btn-dark admin-order-action" aria-label="' + t.edit + '" title="' + t.edit + '">'
                                    + '<i class="bi bi-pencil-square" aria-hidden="true"></i></a>'
                                    + '<button type="button" class="btn btn-sm btn-danger admin-order-action" data-product-delete="' + productId + '" aria-label="' + t.delete + '" title="' + t.delete + '">'
                                    + '<i class="bi bi-trash-fill" aria-hidden="true"></i></button>'
                                    + '</div>';
                            },
                            cellClick: function(e) {
                                e.stopPropagation();
                            }
                        }
                    ],
                    initialSort: [
                        {column: "id", dir: "desc"}
                    ],
                    rowFormatter: function(row){
                        var data = row.getData();
                        if (data.isDeleted) {
                            row.getElement().classList.add('deleted-row');
                        }
                        row.getElement().style.cursor = "pointer";
                    }
                });
                
                window.productTable = table;
                table.on("tableBuilt", function() {
                    table.redraw(true);
                });
                
            }, 1500);
        });
        
        window.setProductFilter = function(filter, sourceEl) {
            window.currentFilter = filter;

            document.querySelectorAll('[data-product-filter]').forEach(function(el) {
                el.classList.remove('active', 'is-active');
                el.setAttribute('aria-pressed', 'false');
            });

            document.querySelectorAll('[data-product-filter="' + filter + '"]').forEach(function(el) {
                el.classList.add(el.classList.contains('order-stat-card') ? 'is-active' : 'active');
                el.setAttribute('aria-pressed', 'true');
            });

            if (sourceEl) {
                sourceEl.classList.add(sourceEl.classList.contains('order-stat-card') ? 'is-active' : 'active');
                sourceEl.setAttribute('aria-pressed', 'true');
            }

            if (window.productTable) {
                window.productTable.setPage(1).then(function(){
                    window.productTable.setData();
                });
            }
        };

        window.filterProducts = function(filter) {
            window.setProductFilter(filter);
        };
        
        window.searchProducts = function() {
            var searchValue = document.getElementById('productSearchInput').value;
            
            if (window.productTable) {
                window.productTable.setPage(1).then(function(){
                    window.productTable.setData();
                });
            }
        };
        
        window.clearSearch = function() {
            document.getElementById('productSearchInput').value = '';
            window.searchProducts();
        };
        
        // Export products with current filters
        window.exportProducts = function() {
            // Get current filter values
            var filter = window.currentFilter === 'all' ? '' : window.currentFilter;
            var searchValue = document.getElementById('productSearchInput') ? document.getElementById('productSearchInput').value : '';
            
            // Build query string
            var params = new URLSearchParams();
            if (filter) params.append('filter', filter);
            if (searchValue) params.append('searchValue', searchValue);
            
            // Create download link
            var url = '/Admin/Product/Export?' + params.toString();
            window.location.href = url;
        };
        
        window.deleteProduct = function(productId) {
            Swal.fire({
                title: window.productTranslations.areYouSure,
                text: window.productTranslations.deleteConfirm,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: window.productTranslations.yesDelete,
                cancelButtonText: window.productTranslations.cancel
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Admin/Product/Delete?id=' + productId, {
                        method: 'DELETE',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Deleted!', data.massage || data.message || 'Product deleted successfully', 'success');
                            if (window.productTable) {
                                window.productTable.setData();
                            }
                            window.loadProductStatistics();
                        } else {
                            Swal.fire('Error!', data.massage || data.message || 'Error deleting product', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire('Error!', 'Error deleting product: ' + error, 'error');
                    });
                }
            });
        };
        
        window.undeleteProduct = function(productId) {
            Swal.fire({
                title: window.productTranslations.areYouSure,
                text: window.productTranslations.restoreConfirm || 'This will restore the product and make it available again.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#6b7280',
                confirmButtonText: window.productTranslations.yesRestore || 'Yes, restore it!',
                cancelButtonText: window.productTranslations.cancel
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Admin/Product/Undelete?id=' + productId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Restored!', data.message || 'Product restored successfully', 'success');
                            if (window.productTable) {
                                window.productTable.setData();
                            }
                            window.loadProductStatistics();
                        } else {
                            Swal.fire('Error!', data.message || 'Error restoring product', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire('Error!', 'Error restoring product: ' + error, 'error');
                    });
                }
            });
        };
        
        // Add event listener for search input (with debounce)
        var searchTimeout;
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('#productFilterTabs [data-product-filter], #productStatsContainer [data-product-filter]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    window.setProductFilter(btn.getAttribute('data-product-filter'), btn);
                });
            });

            var filterParam = new URLSearchParams(window.location.search).get('filter');
            if (filterParam && typeof window.setProductFilter === 'function') {
                window.setProductFilter(filterParam);
            }

            document.getElementById('exportProductsBtn')?.addEventListener('click', exportProducts);
            document.getElementById('clearProductSearchBtn')?.addEventListener('click', clearSearch);

            document.getElementById('productTable')?.addEventListener('click', function(e) {
                var deleteBtn = e.target.closest('[data-product-delete]');
                if (deleteBtn) {
                    e.preventDefault();
                    window.deleteProduct(deleteBtn.getAttribute('data-product-delete'));
                    return;
                }
                var restoreBtn = e.target.closest('[data-product-undelete]');
                if (restoreBtn) {
                    e.preventDefault();
                    window.undeleteProduct(restoreBtn.getAttribute('data-product-undelete'));
                }
            });

            var searchInput = document.getElementById('productSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function() {
                        window.searchProducts();
                    }, 500);
                });
                
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        clearTimeout(searchTimeout);
                        window.searchProducts();
                    }
                });
            }
        });
        
    </script>
}
