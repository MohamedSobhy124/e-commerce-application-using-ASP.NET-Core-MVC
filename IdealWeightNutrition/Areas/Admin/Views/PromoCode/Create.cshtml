@model IdealWeightNutrition.Models.PromoCode

@{
    ViewData["Title"] = Localizer["CreatePromoCode"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["CreateNewPromoCode"]</h1>
                <p class="text-muted mb-0">@Localizer["EnterUniqueCode"]</p>
            </div>
            <div class="admin-form-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <section class="admin-form-section">
                        <h2>@Localizer["PromoCodeDetails"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="Code" class="admin-form-label">@Localizer["Code"] <span class="text-danger">*</span></label>
                                    <input asp-for="Code" class="admin-form-control text-uppercase" autocomplete="off" placeholder="@Localizer["ExampleSAVE20"]" />
                                    <span asp-validation-for="Code" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="DiscountType" class="admin-form-label">@Localizer["DiscountType"]</label>
                                    <select asp-for="DiscountType" class="admin-form-control" id="discountType">
                                        <option value="1">@Localizer["Percentage"]</option>
                                        <option value="2">@Localizer["FixedAmount"]</option>
                                    </select>
                                    <span asp-validation-for="DiscountType" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="admin-form-group">
                                    <label asp-for="Description" class="admin-form-label">@Localizer["Description"]</label>
                                    <textarea asp-for="Description" class="admin-form-control" rows="3" placeholder="@Localizer["Example20PercentOff"]"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="DiscountValue" class="admin-form-label">@Localizer["DiscountValue"]</label>
                                    <div class="input-group">
                                        <input asp-for="DiscountValue" class="admin-form-control" type="number" step="0.01" />
                                        <span class="input-group-text" id="discountSymbol">%</span>
                                    </div>
                                    <span asp-validation-for="DiscountValue" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="MinimumOrderAmount" class="admin-form-label">@Localizer["MinimumOrder"]</label>
                                    <input asp-for="MinimumOrderAmount" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                    <small class="form-text text-muted">@Localizer["LeaveEmptyForNoMinimum"]</small>
                                    <span asp-validation-for="MinimumOrderAmount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="admin-form-section" data-schedule-from-inputs>
                        <h2>@Localizer["Schedule"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="StartDate" class="admin-form-label">@Localizer["StartDate"]</label>
                                    <input asp-for="StartDate" class="admin-form-control" type="datetime-local" />
                                    <small class="form-text text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                    <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="EndDate" class="admin-form-label">@Localizer["EndDate"]</label>
                                    <input asp-for="EndDate" class="admin-form-control" type="datetime-local" />
                                    <small class="form-text text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                    <span asp-validation-for="EndDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <span data-schedule-badge
                              data-badge-class="badge admin-schedule-live"
                              data-enabled="true"
                              data-start=""
                              data-end=""
                              data-label-active="@Localizer["Active"].Value"
                              data-label-scheduled="@Localizer["Scheduled"].Value"
                              data-label-ended="@Localizer["Expired"].Value"
                              data-label-inactive="@Localizer["Inactive"].Value"
                              class="badge admin-schedule-live bg-secondary">@Localizer["Scheduled"]</span>
                    </section>

                    <section class="admin-form-section">
                        <h2>@Localizer["UsageStatistics"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="UsageLimit" class="admin-form-label">@Localizer["UsageLimit"]</label>
                                    <input asp-for="UsageLimit" class="admin-form-control" type="number" placeholder="@Localizer["Unlimited"]" />
                                    <small class="form-text text-muted">@Localizer["TotalTimesCodeCanBeUsed"]</small>
                                    <span asp-validation-for="UsageLimit" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="UsageLimitPerUser" class="admin-form-label">@Localizer["PerUserLimit"]</label>
                                    <input asp-for="UsageLimitPerUser" class="admin-form-control" type="number" placeholder="1" />
                                    <small class="form-text text-muted">@Localizer["TimesEachUserCanUseCode"]</small>
                                    <span asp-validation-for="UsageLimitPerUser" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="MaximumDiscountAmount" class="admin-form-label">@Localizer["MaximumDiscount"]</label>
                                    <input asp-for="MaximumDiscountAmount" class="admin-form-control" type="number" step="0.01" placeholder="@Localizer["NoLimit"]" />
                                    <small class="form-text text-muted">@Localizer["MaximumDiscountForPercentageCodes"]</small>
                                    <span asp-validation-for="MaximumDiscountAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                        <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="admin-form-section">
                        <h2>@Localizer["DiscountExclusions"]</h2>
                        <div class="admin-form-group">
                            <div class="form-check form-switch">
                                <input asp-for="ExcludeDiscountedItems" class="form-check-input" type="checkbox" id="excludeDiscountedItems" />
                                <label class="form-check-label" for="excludeDiscountedItems">@Localizer["ExcludeItemsWithExistingDiscounts"]</label>
                            </div>
                            <small class="form-text text-muted">@Localizer["WhenEnabledPromoCodeWillNotApplyToItemsWithFlashSalesComboOffersOrListPriceDiscounts"]</small>
                        </div>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                            @Localizer["YouCanAddExcludedProductsAfterCreatingThePromoCode"]
                        </div>
                        <div class="admin-form-group">
                            <div class="form-check form-switch">
                                <input asp-for="ExcludeAllServices" class="form-check-input" type="checkbox" id="excludeAllServices" checked />
                                <label class="form-check-label" for="excludeAllServices">@Localizer["ExcludeAllServices"]</label>
                            </div>
                            <small class="form-text text-muted">@Localizer["ExcludeAllServicesDescription"]</small>
                        </div>
                    </section>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@Localizer["CreatePromoCode"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('discountType')?.addEventListener('change', function () {
            document.getElementById('discountSymbol').textContent = this.value === '1' ? '%' : 'AED';
        });
        document.querySelector('input[name="Code"]')?.addEventListener('input', function () {
            this.value = this.value.toUpperCase();
        });
        var now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        var nowString = now.toISOString().slice(0, 16);
        var startInput = document.querySelector('input[name="StartDate"]');
        var endInput = document.querySelector('input[name="EndDate"]');
        if (startInput) {
            startInput.min = nowString;
            startInput.value = nowString;
        }
        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        tomorrow.setMinutes(tomorrow.getMinutes() - tomorrow.getTimezoneOffset());
        if (endInput) {
            endInput.min = nowString;
            endInput.value = tomorrow.toISOString().slice(0, 16);
        }
    </script>
}
