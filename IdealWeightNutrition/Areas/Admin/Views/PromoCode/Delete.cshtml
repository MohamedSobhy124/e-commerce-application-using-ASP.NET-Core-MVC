@model IdealWeightNutrition.Models.PromoCode

@{
    ViewData["Title"] = Localizer["DeletePromoCode"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["DeletePromoCode"]</h1>
            </div>
            <div class="admin-form-body">
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
                    <strong>@Localizer["Warning"]</strong> @Localizer["AreYouSureDeletePromoCode"]
                </div>

                <dl class="admin-details-list">
                    <dt>@Localizer["Code"]</dt>
                    <dd><strong class="text-primary">@Model.Code</strong></dd>
                    <dt>@Localizer["Description"]</dt>
                    <dd>@Model.Description</dd>
                    <dt>@Localizer["Discount"]</dt>
                    <dd>
                        @if (Model.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                        {
                            <span class="badge bg-success">@(Model.DiscountValue)%</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@Model.DiscountValue.ToString("N2")</span>
                        }
                    </dd>
                    <dt>@Localizer["ValidPeriod"]</dt>
                    <dd>
                        @Model.StartDate.ToString("yyyy-MM-dd HH:mm") – @Model.EndDate.ToString("yyyy-MM-dd HH:mm")
                        <small class="text-muted admin-schedule-hint d-block">@Localizer["TimezoneAsiaDubai"]</small>
                    </dd>
                    <dt>@Localizer["TimesUsed"]</dt>
                    <dd><span class="badge bg-primary">@Model.TimesUsed</span></dd>
                </dl>

                <form asp-action="Delete" method="post" class="form-actions">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-2" aria-hidden="true"></i>@Localizer["Cancel"]
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["YesDelete"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
