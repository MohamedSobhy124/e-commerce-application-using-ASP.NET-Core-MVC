@model IdealWeightNutrition.Models.PromoCode

@{
    ViewData["Title"] = Localizer["EditPromoCode"];
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <h1 class="admin-form-title">@Localizer["EditPromoCode"]</h1>
                        <p class="text-muted mb-0">@Localizer["Code"]: <strong>@Model.Code</strong></p>
                    </div>
                    <span id="promoHeaderStatus"
                          data-schedule-badge
                          data-badge-class="badge admin-schedule-live"
                          data-enabled="@Model.IsActive.ToString().ToLower()"
                          data-start="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                          data-end="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                          data-label-active="@Localizer["Active"].Value"
                          data-label-scheduled="@Localizer["Scheduled"].Value"
                          data-label-ended="@Localizer["Expired"].Value"
                          data-label-inactive="@Localizer["Inactive"].Value"
                          class="badge admin-schedule-live bg-secondary">@Localizer["Inactive"]</span>
                </div>
            </div>
            <div class="admin-form-body">
                <div class="alert alert-info mb-4" role="status">
                    <strong>@Localizer["UsageStatistics"]:</strong>
                    @Localizer["Currently used"] <strong>@Model.TimesUsed</strong> @Localizer["times"]
                    @if (Model.UsageLimit.HasValue)
                    {
                        <span>/ @Model.UsageLimit</span>
                    }
                </div>

                <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="TimesUsed" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <section class="admin-form-section">
                        <h2>@Localizer["PromoCodeDetails"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                <label asp-for="Code" class="admin-form-label">@Localizer["Code"]</label>
                                <input asp-for="Code" class="admin-form-control text-uppercase" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="admin-form-group">
                                <label asp-for="DiscountType" class="admin-form-label">@Localizer["DiscountType"]</label>
                                <select asp-for="DiscountType" class="admin-form-control" id="discountType">
                                    <option value="1">@Localizer["Percentage"]</option>
                                    <option value="2">@Localizer["FixedAmount"]</option>
                                </select>
                                <span asp-validation-for="DiscountType" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-file-text text-info me-2"></i>@Localizer["Description"]
                                </label>
                                <textarea aria-label="@Localizer["Description"]" asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Discount Value and Minimum Order -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-cash-coin text-warning me-2"></i>@Localizer["DiscountValue"]
                                </label>
                                <div class="input-group input-group-lg">
                                    <input aria-label="@Localizer["DiscountValue"]" asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
                                    <span class="input-group-text bg-primary text-white fw-bold" id="discountSymbol">@(Model.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage ? "%" : "AED")</span>
                                </div>
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-cart-check text-danger me-2"></i>@Localizer["MinimumOrder"]
                                </label>
                                <input aria-label="@Localizer["MinimumOrderAmount"]" asp-for="MinimumOrderAmount" class="form-control form-control-lg" type="number" step="0.01" />
                                <span asp-validation-for="MinimumOrderAmount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4" data-schedule-from-inputs>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                <label asp-for="StartDate" class="admin-form-label">@Localizer["StartDate"]</label>
                                <input asp-for="StartDate" class="admin-form-control" type="datetime-local" />
                                <small class="form-text text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                <label asp-for="EndDate" class="admin-form-label">@Localizer["EndDate"]</label>
                                <input asp-for="EndDate" class="admin-form-control" type="datetime-local" />
                                <small class="form-text text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <span data-schedule-badge
                                      data-badge-class="badge admin-schedule-live"
                                      data-enabled="@Model.IsActive.ToString().ToLower()"
                                      data-start="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                      data-end="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                      data-label-active="@Localizer["Active"].Value"
                                      data-label-scheduled="@Localizer["Scheduled"].Value"
                                      data-label-ended="@Localizer["Expired"].Value"
                                      data-label-inactive="@Localizer["Inactive"].Value"
                                      class="badge admin-schedule-live bg-secondary">@Localizer["Inactive"]</span>
                            </div>
                        </div>

                        <!-- Usage Limits -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-arrow-repeat text-primary me-2"></i>@Localizer["UsageLimit"]
                                </label>
                                <input aria-label="@Localizer["UsageLimit"]" asp-for="UsageLimit" class="form-control form-control-lg" type="number" />
                                <span asp-validation-for="UsageLimit" class="text-danger"></span>
                                <small class="form-text text-muted">
                                    @Localizer["Currently used"]: <strong>@Model.TimesUsed</strong> @Localizer["times"]
                                </small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-person-badge text-warning me-2"></i>@Localizer["PerUserLimit"]
                                </label>
                                <input aria-label="@Localizer["UsageLimitPerUser"]" asp-for="UsageLimitPerUser" class="form-control form-control-lg" type="number" />
                                <span asp-validation-for="UsageLimitPerUser" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Maximum Discount and Active Status -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-shield-check text-info me-2"></i>@Localizer["MaximumDiscount"]
                                </label>
                                <input aria-label="@Localizer["MaximumDiscountAmount"]" asp-for="MaximumDiscountAmount" class="form-control form-control-lg" type="number" step="0.01" />
                                <span asp-validation-for="MaximumDiscountAmount" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold d-block">
                                     @Localizer["Status"]
                                </label>
                                <div class="d-flex align-items-center mt-3 ">
                                    <div class="form-check form-switch me-3 w-100">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheckbox" style="width: 3rem; height: 1.5rem;" />
                                        <label class="form-check-label ms-2 fw-bold" for="isActiveCheckbox">@Localizer["Active"]</label>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>

                        <!-- Exclude Discounted Items -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="ExcludeDiscountedItems" class="form-check-input" type="checkbox" id="excludeDiscountedItems" style="width: 3rem; height: 1.5rem;" />
                                    <label class="form-check-label ms-2 fw-bold d-flex" for="excludeDiscountedItems">
                                        <i class="bi bi-x-circle text-danger me-2"></i>@Localizer["ExcludeItemsWithExistingDiscounts"]
                                    </label>
                                </div>
                                <small class="form-text text-muted ms-5">
                                    @Localizer["WhenEnabledPromoCodeWillNotApplyToItemsWithFlashSalesComboOffersOrListPriceDiscounts"]
                                </small>
                            </div>
                        </div>

                        @{
                            var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
                            var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
                        }
                        <section class="admin-form-section">
                            <h2>@Localizer["ExcludedProducts"]</h2>
                            <p class="text-muted">@Localizer["ProductsInThisListWillNotReceiveThePromoCodeDiscount"]</p>
                            <div class="admin-picker-layout">
                                <div class="admin-picker-panel">
                                    <label for="productSelect" class="admin-form-label">@Localizer["SelectProduct"]</label>
                                    <select id="productSelect" class="admin-form-control admin-picker-search">
                                        <option value="">@Localizer["SelectProduct"]</option>
                                        @if (ViewBag.Products != null)
                                        {
                                            @foreach (var product in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Products)
                                            {
                                                <option value="@product.Value">@product.Text</option>
                                            }
                                        }
                                    </select>
                                    <button type="button" class="btn btn-primary w-100 mt-3" id="addProductBtn" hidden>
                                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>@Localizer["Add"]
                                    </button>
                                </div>
                                <div class="admin-picker-panel">
                                    <div id="excludedProductsList" class="admin-picker-selected-list">
                                        @if (Model.ExcludedProducts != null && Model.ExcludedProducts.Any())
                                        {
                                            @foreach (var excludedProduct in Model.ExcludedProducts)
                                            {
                                                var productTitle = (currentCulture == "ar" && !string.IsNullOrEmpty(excludedProduct.Product?.TitleAr))
                                                    ? excludedProduct.Product.TitleAr
                                                    : (excludedProduct.Product?.Title ?? Localizer["Unknown"].Value);
                                                <div class="admin-picker-selected-item excluded-product-item" data-excluded-id="@excludedProduct.Id" data-product-id="@excludedProduct.ProductId">
                                                    <span class="admin-picker-selected-name">@productTitle</span>
                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-excluded-product" aria-label="@Localizer["Remove"]">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0" id="excludedProductsEmpty">@Localizer["NoProductsExcluded"]</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="admin-form-section">
                            <h2>@Localizer["ExcludedComboOffers"]</h2>
                            <p class="text-muted">@Localizer["ComboOffersInThisListWillNotReceiveThePromoCodeDiscount"]</p>
                            <div class="admin-picker-layout">
                                <div class="admin-picker-panel">
                                    <label for="comboOfferSelect" class="admin-form-label">@Localizer["SelectComboOffer"]</label>
                                    <select id="comboOfferSelect" class="admin-form-control">
                                        <option value="">@Localizer["SelectComboOffer"]</option>
                                        @if (ViewBag.ComboOffers != null)
                                        {
                                            @foreach (var comboOffer in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ComboOffers)
                                            {
                                                <option value="@comboOffer.Value">@comboOffer.Text</option>
                                            }
                                        }
                                    </select>
                                    <button type="button" class="btn btn-primary w-100 mt-3" id="addComboOfferBtn" hidden>
                                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>@Localizer["Add"]
                                    </button>
                                </div>
                                <div class="admin-picker-panel">
                                    <div id="excludedComboOffersList" class="admin-picker-selected-list">
                                        @if (Model.ExcludedComboOffers != null && Model.ExcludedComboOffers.Any())
                                        {
                                            @foreach (var excludedComboOffer in Model.ExcludedComboOffers)
                                            {
                                                var comboOfferName = (currentCulture == "ar" && !string.IsNullOrEmpty(excludedComboOffer.ComboOffer?.NameAr))
                                                    ? excludedComboOffer.ComboOffer.NameAr
                                                    : (excludedComboOffer.ComboOffer?.Name ?? Localizer["Unknown"].Value);
                                                <div class="admin-picker-selected-item excluded-combo-offer-item" data-excluded-id="@excludedComboOffer.Id" data-combo-offer-id="@excludedComboOffer.ComboOfferId">
                                                    <span class="admin-picker-selected-name">@comboOfferName</span>
                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-excluded-combo-offer" aria-label="@Localizer["Remove"]">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0" id="excludedComboOffersEmpty">@Localizer["NoComboOffersExcluded"]</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="admin-form-section">
                            <h2>@Localizer["ServiceExclusions"]</h2>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ExcludeAllServices" id="excludeAllServices" value="true" @(Model.ExcludeAllServices ? "checked" : "")>
                                <label class="form-check-label" for="excludeAllServices">@Localizer["ExcludeAllServices"]</label>
                                <small class="text-muted d-block">@Localizer["ExcludeAllServicesDescription"]</small>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="radio" name="ExcludeAllServices" id="excludeSpecificServices" value="false" @(!Model.ExcludeAllServices ? "checked" : "")>
                                <label class="form-check-label" for="excludeSpecificServices">@Localizer["ExcludeSpecificServices"]</label>
                                <small class="text-muted d-block">@Localizer["ExcludeSpecificServicesDescription"]</small>
                            </div>
                            <div id="serviceExclusionSection" class="mt-3" @(Model.ExcludeAllServices ? "hidden" : "")>
                                <p class="text-muted">@Localizer["ServicesInThisListWillNotReceiveThePromoCodeDiscount"]</p>
                                <div class="admin-picker-layout">
                                    <div class="admin-picker-panel">
                                        <label for="serviceSelect" class="admin-form-label">@Localizer["SelectService"]</label>
                                        <select id="serviceSelect" class="admin-form-control">
                                            <option value="">@Localizer["SelectService"]</option>
                                            @if (ViewBag.ServiceSubscriptions != null)
                                            {
                                                @foreach (var service in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ServiceSubscriptions)
                                                {
                                                    <option value="@service.Value">@service.Text</option>
                                                }
                                            }
                                        </select>
                                        <button type="button" class="btn btn-primary w-100 mt-3" id="addServiceBtn" hidden>
                                            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>@Localizer["Add"]
                                        </button>
                                    </div>
                                    <div class="admin-picker-panel">
                                        <div id="excludedServicesList" class="admin-picker-selected-list">
                                            @if (Model.ExcludedServiceSubscriptions != null && Model.ExcludedServiceSubscriptions.Any())
                                            {
                                                @foreach (var excludedService in Model.ExcludedServiceSubscriptions)
                                                {
                                                    var serviceTitle = (currentCulture == "ar" && !string.IsNullOrEmpty(excludedService.ServiceSubscription?.TitleAr))
                                                        ? excludedService.ServiceSubscription.TitleAr
                                                        : (excludedService.ServiceSubscription?.Title ?? Localizer["Unknown"].Value);
                                                    <div class="admin-picker-selected-item excluded-service-item" data-excluded-id="@excludedService.Id" data-service-id="@excludedService.ServiceSubscriptionId">
                                                        <span class="admin-picker-selected-name">@serviceTitle</span>
                                                        <button type="button" class="btn btn-sm btn-outline-danger remove-excluded-service" aria-label="@Localizer["Remove"]">
                                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0" id="excludedServicesEmpty">@Localizer["NoServicesExcluded"]</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <div class="form-actions">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                                <i class="bi bi-eye me-2" aria-hidden="true"></i>@Localizer["ViewDetails"]
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-2" aria-hidden="true"></i>@Localizer["UpdatePromoCode"]
                            </button>
                        </div>
                    </form>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Styles {
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    
    <style>
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
            border: 1px solid #ced4da;
        }
        
        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }
        
        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        
        .select2-dropdown {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }
        
        .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
        }
        
        .select2-results__option {
            padding: 0.5rem 0.75rem;
        }
        
        .select2-results__option--highlighted {
            background-color: #0d6efd;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        // Update discount symbol based on discount type
        $('#discountType').change(function() {
            var symbol = $(this).val() == '1' ? '%' : 'AED';
            $('#discountSymbol').text(symbol);
        });

        // Convert code to uppercase
        $('input[name="Code"]').on('input', function() {
            $(this).val($(this).val().toUpperCase());
        });

        // Toggle active status from edit page
        $('.toggle-active-edit').click(function (e) {
            e.preventDefault();
            var promoId = $(this).data('id');
            var btn = $(this);
            var checkbox = $('#isActiveCheckbox');
            var statusBadge = $('.badge.fs-6');
            
            // Disable button during request
            btn.prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("ToggleActive", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    id: promoId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        // Update checkbox
                        checkbox.prop('checked', response.isActive);
                        
                        // Update status badge in header
                        if (response.isActive) {
                            statusBadge.removeClass('bg-secondary').addClass('bg-success');
                            statusBadge.html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@Html.Raw(Localizer["Active"].Value)');
                            btn.removeClass('btn-secondary').addClass('btn-success');
                            btn.find('i').removeClass('bi-toggle-off').addClass('bi-toggle-on');
                        } else {
                            statusBadge.removeClass('bg-success').addClass('bg-secondary');
                            statusBadge.html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@Html.Raw(Localizer["Inactive"].Value)');
                            btn.removeClass('btn-success').addClass('btn-secondary');
                            btn.find('i').removeClass('bi-toggle-on').addClass('bi-toggle-off');
                        }
                        
                        // Show success message
                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Toggle active error:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    } else {
                        alert('An error occurred. Please try again.');
                    }
                },
                complete: function () {
                    btn.prop('disabled', false);
                }
            });
        });

        // Prevent checkbox from triggering AJAX - let form submission handle it
        // The toggle button will update the checkbox via AJAX

        // Excluded Products Management
        var promoCodeId = @Model.Id;
        var currentCulture = '@System.Globalization.CultureInfo.CurrentCulture.Name';

        // Initialize Select2 for product dropdown
        $(document).ready(function() {
            $('#productSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '@Html.Raw(Localizer["SelectProduct"])',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                closeOnSelect: false
            });

            // Show/hide Add button based on selection
            $('#productSelect').on('change', function() {
                document.getElementById('addProductBtn').hidden = !$(this).val();
            });

            // Initialize Select2 for combo offer dropdown
            $('#comboOfferSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '@Html.Raw(Localizer["SelectComboOffer"])',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                closeOnSelect: false
            });

            // Show/hide Add button based on selection
            $('#comboOfferSelect').on('change', function() {
                document.getElementById('addComboOfferBtn').hidden = !$(this).val();
            });
        });

        // Add product to excluded list
        $('#addProductBtn').click(function() {
            var productId = $('#productSelect').val();
            if (!productId) {
                return;
            }

            // Get selected product text (title)
            var selectedOption = $('#productSelect option:selected');
            var productTitle = selectedOption.text().split(' (')[0]; // Extract title before stock info

            // Check if already excluded
            if ($('.excluded-product-item[data-product-id="' + productId + '"]').length > 0) {
                if (typeof toastr !== 'undefined') {
                    toastr.warning('@Html.Raw(Localizer["ProductIsAlreadyExcluded"].Value)');
                } else {
                    alert('@Html.Raw(Localizer["ProductIsAlreadyExcluded"].Value)');
                }
                return;
            }

            // Disable button during request
            var btn = $(this);
            btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("AddExcludedProduct", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    promoCodeId: promoCodeId,
                    productId: productId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        // Get localized product title from response
                        var displayTitle = (currentCulture === 'ar' && response.productTitleAr) 
                            ? response.productTitleAr 
                            : (response.productTitle || productTitle);

                        // Add to UI
