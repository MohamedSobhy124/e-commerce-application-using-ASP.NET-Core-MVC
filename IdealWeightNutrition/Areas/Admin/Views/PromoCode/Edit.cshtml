        // Handle ExcludeAllServices radio button changes
        $('input[name="ExcludeAllServices"]').on('change', function() {
            var excludeAll = $(this).val() === 'true';
            if (excludeAll) {
                $('#serviceExclusionSection').slideUp();
            } else {
                $('#serviceExclusionSection').slideDown();
            }
        });

        // Service selection change handler
        $('#serviceSelect').on('change', function() {
            var serviceId = $(this).val();
            if (serviceId) {
                document.getElementById('addServiceBtn').hidden = false;
            } else {
                document.getElementById('addServiceBtn').hidden = true;
            }
        });

        // Add service to excluded list
        $('#addServiceBtn').click(function() {
