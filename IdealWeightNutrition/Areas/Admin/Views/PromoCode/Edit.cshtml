            if (!serviceId) {
                return;
            }

            // Get selected service text (name)
            var selectedOption = $('#serviceSelect option:selected');
            var serviceName = selectedOption.text().split(' (')[0]; // Extract name before price info

            // Check if already excluded
            if ($('.excluded-service-item[data-service-id="' + serviceId + '"]').length > 0) {
