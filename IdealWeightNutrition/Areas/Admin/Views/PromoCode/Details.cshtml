@model IdealWeightNutrition.Models.PromoCode

@{
    ViewData["Title"] = Localizer["PromoCodeDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usages = ViewBag.Usages as IEnumerable<IdealWeightNutrition.Models.PromoCodeUsage>;
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <h1 class="admin-form-title">@Model.Code</h1>
                        <p class="text-muted mb-0">@Model.Description</p>
                    </div>
                    <span data-schedule-badge
                          data-badge-class="badge admin-schedule-live fs-6"
                          data-enabled="@Model.IsActive.ToString().ToLower()"
                          data-start="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                          data-end="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                          data-label-active="@Localizer["Active"].Value"
                          data-label-scheduled="@Localizer["Scheduled"].Value"
                          data-label-ended="@Localizer["Expired"].Value"
                          data-label-inactive="@Localizer["Inactive"].Value"
                          class="badge admin-schedule-live bg-secondary">@Localizer["Inactive"]</span>
                </div>
            </div>
            <div class="admin-form-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <section class="admin-form-section">
                            <h2>@Localizer["DiscountInformation"]</h2>
                            <dl class="admin-details-list">
                                <dt>@Localizer["Type"]</dt>
                                <dd>
                                    @if (Model.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                    {
                                        <span class="badge bg-success">@Localizer["Percentage"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@Localizer["FixedAmount"]</span>
                                    }
                                </dd>
                                <dt>@Localizer["Value"]</dt>
                                <dd>
                                    @if (Model.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                    {
                                        <span>@(Model.DiscountValue.ToString() + "%")</span>
                                    }
                                    else
                                    {
                                        <span>@Model.DiscountValue.ToString("N2")</span>
                                    }
                                </dd>
                                @if (Model.MinimumOrderAmount.HasValue)
                                {
                                    <dt>@Localizer["MinimumOrder"]</dt>
                                    <dd>@Model.MinimumOrderAmount.Value.ToString("N2")</dd>
                                }
                                @if (Model.MaximumDiscountAmount.HasValue)
                                {
                                    <dt>@Localizer["MaximumDiscount"]</dt>
                                    <dd>@Model.MaximumDiscountAmount.Value.ToString("N2")</dd>
                                }
                            </dl>
                        </section>
                    </div>
                    <div class="col-md-6">
                        <section class="admin-form-section">
                            <h2>@Localizer["ValidityPeriod"]</h2>
                            <dl class="admin-details-list">
                                <dt>@Localizer["StartDate"]</dt>
                                <dd>@Model.StartDate.ToString("yyyy-MM-dd HH:mm")</dd>
                                <dt>@Localizer["EndDate"]</dt>
                                <dd>@Model.EndDate.ToString("yyyy-MM-dd HH:mm")</dd>
                            </dl>
                            <small class="text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                        </section>
                    </div>
                </div>

                @if (usages != null && usages.Any())
                {
                    <section class="admin-form-section mt-4">
                        <h2>@Localizer["UsageStatistics"]</h2>
                        <div class="table-responsive admin-table-wrapper">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th scope="col">@Localizer["User"]</th>
                                        <th scope="col">@Localizer["Order"]</th>
                                        <th scope="col">@Localizer["UsedDate"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usage in usages)
                                    {
                                        <tr>
                                            <td>@(usage.ApplicationUser?.Email ?? usage.UserId)</td>
                                            <td>#@usage.OrderId</td>
                                            <td>@usage.UsedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>@Localizer["Edit"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
