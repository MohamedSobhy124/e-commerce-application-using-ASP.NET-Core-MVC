@model IEnumerable<IdealWeightNutrition.Models.PromoCode>

@{
    ViewData["Title"] = Localizer["PromoCodes"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["EmptyIcon"] = "bi-tag";
    ViewData["EmptyTitle"] = Localizer["NoItemsFound"].Value;
    ViewData["EmptyText"] = Localizer["CreateNewPromoCode"].Value;
    ViewData["EmptyActionUrl"] = Url.Action("Create");
    ViewData["EmptyActionText"] = Localizer["CreateNewPromoCode"].Value;
    var badgeClass = "badge admin-schedule-live";
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["PromoCodesManagement"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Model.Count() @Localizer["PromoCodes"]</p>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        @Localizer["CreateNewPromoCode"]
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <partial name="_AdminEmptyState" />
                }
                else
                {
                    <div class="table-responsive admin-table-wrapper">
                        <table class="table table-bordered table-striped table-hover" id="promoCodesTable">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Code"]</th>
                                    <th scope="col">@Localizer["Description"]</th>
                                    <th scope="col">@Localizer["Discount"]</th>
                                    <th scope="col">@Localizer["ValidPeriod"]</th>
                                    <th scope="col">@Localizer["Usage"]</th>
                                    <th scope="col">@Localizer["Status"]</th>
                                    <th scope="col" class="text-center">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var promo in Model)
                                {
                                    var isUsageLimitReached = promo.UsageLimit.HasValue && promo.TimesUsed >= promo.UsageLimit.Value;

                                    <tr class="@(isUsageLimitReached ? "table-secondary" : "")" data-promo-row="@promo.Id">
                                        <td><strong class="text-primary">@promo.Code</strong></td>
                                        <td>@promo.Description</td>
                                        <td>
                                            @if (promo.DiscountType == IdealWeightNutrition.Models.DiscountType.Percentage)
                                            {
                                                <span class="badge bg-success">@(promo.DiscountValue)%</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">@promo.DiscountValue.ToString("N2")</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@promo.StartDate.ToString("yyyy-MM-dd HH:mm")</div>
                                            <div>@promo.EndDate.ToString("yyyy-MM-dd HH:mm")</div>
                                            <small class="text-muted admin-schedule-hint">@Localizer["TimezoneAsiaDubai"]</small>
                                            @if (isUsageLimitReached)
                                            {
                                                <div><span class="badge bg-danger">@Localizer["LimitReached"]</span></div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">@promo.TimesUsed</span>
                                            @if (promo.UsageLimit.HasValue)
                                            {
                                                <span>/ @promo.UsageLimit</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">/ @Localizer["Unlimited"]</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isUsageLimitReached)
                                            {
                                                <span class="badge bg-warning text-dark" id="status-@promo.Id">@Localizer["Paused"]</span>
                                            }
                                            else
                                            {
                                                <span id="status-@promo.Id"
                                                      data-schedule-badge
                                                      data-badge-class="@badgeClass"
                                                      data-enabled="@promo.IsActive.ToString().ToLower()"
                                                      data-start="@promo.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                      data-end="@promo.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                      data-label-active="@Localizer["Active"].Value"
                                                      data-label-scheduled="@Localizer["Scheduled"].Value"
                                                      data-label-ended="@Localizer["Expired"].Value"
                                                      data-label-inactive="@Localizer["Inactive"].Value"
                                                      class="@badgeClass bg-secondary">@Localizer["Inactive"]</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="admin-row-actions">
                                                <a asp-action="Details" asp-route-id="@promo.Id" class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["Details"]">
                                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@promo.Id" class="btn btn-sm btn-primary" aria-label="@Localizer["Edit"]">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary toggle-active toggle-active-btn" data-id="@promo.Id" aria-label="@Localizer["ToggleActive"]">
                                                    <i class="bi bi-toggle-@(promo.IsActive ? "on" : "off")" aria-hidden="true"></i>
                                                </button>
                                                @if (promo.TimesUsed == 0)
                                                {
                                                    <a asp-action="Delete" asp-route-id="@promo.Id" class="btn btn-sm btn-danger" aria-label="@Localizer["Delete"]">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#promoCodesTable').DataTable({
                    order: [[3, 'desc']],
                    pageLength: 25
                });
            }

            $(document).on('click', '.toggle-active', function (e) {
                e.preventDefault();
                var promoId = $(this).data('id');
                var btn = $(this);
                btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleActive", "PromoCode", new { area = "Admin" })',
                    type: 'POST',
                    data: {
                        id: promoId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            var statusBadge = $('#status-' + promoId);
                            var isUsageLimitReached = $('tr[data-promo-row="' + promoId + '"]').find('.badge.bg-danger').filter(function () {
                                return $(this).text().indexOf('@Html.Raw(Localizer["LimitReached"].Value)') >= 0;
                            }).length > 0;

                            if (statusBadge.attr('data-schedule-badge')) {
                                statusBadge.attr('data-enabled', response.isActive ? 'true' : 'false');
                                if (typeof refreshScheduleBadges === 'function') {
                                    refreshScheduleBadges();
                                }
                            } else {
                                statusBadge.removeClass('bg-success bg-secondary bg-warning');
                                statusBadge.addClass(response.isActive && !isUsageLimitReached ? 'bg-success' : 'bg-secondary')
                                    .text(response.isActive ? '@Html.Raw(Localizer["Active"].Value)' : '@Html.Raw(Localizer["Inactive"].Value)');
                            }

                            btn.find('i').removeClass('bi-toggle-on bi-toggle-off')
                                .addClass(response.isActive ? 'bi-toggle-on' : 'bi-toggle-off');

                            if (typeof toastr !== 'undefined') {
                                toastr.success(response.message);
                            }
                        } else if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        }
                    },
                    error: function () {
                        if (typeof toastr !== 'undefined') {
                            toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                        }
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
