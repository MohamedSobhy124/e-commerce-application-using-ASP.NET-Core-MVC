@{
    ViewData["Title"] = "Reviews Management";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-star-fill me-3"></i>
                    @Localizer["ReviewsManagement"]
                </h2>
            </div>

            <div class="admin-card-body">
                <!-- Filter Tabs -->
                <div class="order-filter-tabs mb-4">
                    <button class="filter-tab active" onclick="filterReviews('all')">
                        <i class="bi bi-list-ul me-2"></i>@Localizer["AllReviews"]
                    </button>
                    <button class="filter-tab" onclick="filterReviews('pending')">
                        <i class="bi bi-clock me-2"></i>@Localizer["PendingApproval"]
                    </button>
                    <button class="filter-tab" onclick="filterReviews('approved')">
                        <i class="bi bi-check-circle me-2"></i>@Localizer["Approved"]
                    </button>
                </div>

                <div class="admin-table-wrapper">
                    <table id="tblReviews" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>@Localizer["Product"]</th>
                                <th>@Localizer["Customer"]</th>
                                <th>@Localizer["Rating"]</th>
                                <th>@Localizer["Comment"]</th>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-reviews.js"></script>
}

