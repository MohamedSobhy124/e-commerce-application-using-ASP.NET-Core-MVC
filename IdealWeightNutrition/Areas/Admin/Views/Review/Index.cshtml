@{
    ViewData["Title"] = Localizer["ReviewsList"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-toolbar w-100 mb-0">
                    <h1 class="admin-card-title mb-0">
                        <i class="bi bi-star-fill me-2" aria-hidden="true"></i>
                        @Localizer["ReviewsManagement"]
                    </h1>
                    <button type="button" class="btn btn-outline-primary" id="exportReviewsBtn">
                        <i class="bi bi-download me-2" aria-hidden="true"></i>@Localizer["Export"]
                    </button>
                </div>
            </div>

            <div class="admin-card-body">
                <div class="order-stats-container mb-4" id="reviewStatsContainer">
                    <button type="button" class="order-stat-card all" data-review-filter="all" aria-pressed="true">
                        <div class="order-stat-icon"><i class="bi bi-star-fill" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["TotalReviews"]</div>
                        <div class="order-stat-value" id="totalReviews">0</div>
                    </button>
                    <button type="button" class="order-stat-card pending" data-review-filter="pending" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["PendingApproval"]</div>
                        <div class="order-stat-value" id="pendingReviews">0</div>
                    </button>
                    <button type="button" class="order-stat-card approved" data-review-filter="approved" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["Approved"]</div>
                        <div class="order-stat-value" id="approvedReviews">0</div>
                    </button>
                    <button type="button" class="order-stat-card shipped" data-review-filter="verified" aria-pressed="false">
                        <div class="order-stat-icon"><i class="bi bi-patch-check-fill" aria-hidden="true"></i></div>
                        <div class="order-stat-label">@Localizer["VerifiedPurchases"]</div>
                        <div class="order-stat-value" id="verifiedReviews">0</div>
                    </button>
                </div>

                <div class="admin-filter-bar order-filter-tabs mb-4" id="reviewStatusFilters" role="group" aria-label="@Localizer["FilterByStatus"]">
                    <span class="text-muted fw-semibold me-2"><i class="bi bi-funnel me-1" aria-hidden="true"></i>@Localizer["FilterByStatus"]</span>
                    <button type="button" class="filter-tab active" data-filter="all" aria-pressed="true">
                        <i class="bi bi-list-ul me-1" aria-hidden="true"></i>@Localizer["AllReviews"]
                    </button>
                    <button type="button" class="filter-tab" data-filter="pending" aria-pressed="false">
                        <i class="bi bi-clock me-1" aria-hidden="true"></i>@Localizer["PendingApproval"]
                    </button>
                    <button type="button" class="filter-tab" data-filter="approved" aria-pressed="false">
                        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>@Localizer["Approved"]
                    </button>
                </div>

                <div class="table-responsive admin-table-wrapper">
                    <table id="tblReviews" class="table table-bordered table-striped table-hover w-100">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Type"]</th>
                                <th scope="col">@Localizer["Item"]</th>
                                <th scope="col">@Localizer["Customer"]</th>
                                <th scope="col">@Localizer["Rating"]</th>
                                <th scope="col">@Localizer["Comment"]</th>
                                <th scope="col">@Localizer["Date"]</th>
                                <th scope="col">@Localizer["Status"]</th>
                                <th scope="col">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.reviewAdminTranslations = {
            product: '@Html.Raw(Localizer["Product"].Value)',
            service: '@Html.Raw(Localizer["Service"].Value)',
            verified: '@Html.Raw(Localizer["VerifiedPurchase"].Value)',
            anonymous: '@Html.Raw(Localizer["Anonymous"].Value)',
            noComment: '@Html.Raw(Localizer["NoComment"].Value)',
            viewFull: '@Html.Raw(Localizer["ViewFullComment"].Value)',
            approved: '@Html.Raw(Localizer["Approved"].Value)',
            pending: '@Html.Raw(Localizer["PendingApproval"].Value)',
            approve: '@Html.Raw(Localizer["Approve"].Value)',
            hide: '@Html.Raw(Localizer["HideReview"].Value)',
            delete: '@Html.Raw(Localizer["Delete"].Value)',
            emptyTable: '@Html.Raw(Localizer["NoReviewsFound"].Value)',
            deleteConfirmTitle: '@Html.Raw(Localizer["DeleteReviewTitle"].Value)',
            deleteConfirmText: '@Html.Raw(Localizer["DeleteReviewConfirm"].Value)',
            confirmDelete: '@Html.Raw(Localizer["YesDeleteIt"].Value)',
            cancel: '@Html.Raw(Localizer["Cancel"].Value)',
            exportTitle: '@Html.Raw(Localizer["ExportReviews"].Value)',
            exportPreparing: '@Html.Raw(Localizer["ExportPreparing"].Value)',
            exportComplete: '@Html.Raw(Localizer["ExportComplete"].Value)',
            exportSuccess: '@Html.Raw(Localizer["ExportReviewsSuccess"].Value)',
            errorToggle: '@Html.Raw(Localizer["ErrorTogglingReview"].Value)',
            errorDelete: '@Html.Raw(Localizer["ErrorDeletingReview"].Value)',
            close: '@Html.Raw(Localizer["Close"].Value)'
        };
    </script>
    <script src="~/js/admin-reviews.js" asp-append-version="true"></script>
}
