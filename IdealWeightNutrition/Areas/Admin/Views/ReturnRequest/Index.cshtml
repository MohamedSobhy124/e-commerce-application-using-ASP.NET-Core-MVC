@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["ReturnRequests"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">
                    <i class="bi bi-arrow-return-left me-2" aria-hidden="true"></i>
                    @Localizer["ReturnRequests"]
                </h1>
            </div>
            <div class="admin-card-body">
                <p class="text-muted mb-4">@Localizer["ManageReturnRequests"]</p>

                <div class="admin-filter-bar order-filter-tabs" id="returnStatusFilters" role="group" aria-label="@Localizer["Status"]">
                    <button type="button" class="filter-tab active" data-status="all" aria-pressed="true">
                        <i class="bi bi-list-ul me-1" aria-hidden="true"></i>@Localizer["All"]
                    </button>
                    <button type="button" class="filter-tab" data-status="Pending" aria-pressed="false">
                        <i class="bi bi-clock me-1" aria-hidden="true"></i>@Localizer["Pending"]
                    </button>
                    <button type="button" class="filter-tab" data-status="Approved" aria-pressed="false">
                        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>@Localizer["Approved"]
                    </button>
                    <button type="button" class="filter-tab" data-status="Processing" aria-pressed="false">
                        <i class="bi bi-inbox me-1" aria-hidden="true"></i>@Localizer["MarkReceived"]
                    </button>
                    <button type="button" class="filter-tab" data-status="Completed" aria-pressed="false">
                        <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>@Localizer["Completed"]
                    </button>
                </div>

                <div class="table-responsive admin-table-wrapper">
                    <table id="returnRequestTable" class="table table-bordered table-striped table-hover w-100">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["ID"]</th>
                                <th scope="col">@Localizer["OrderNumber"]</th>
                                <th scope="col">@Localizer["Customer"]</th>
                                <th scope="col">@Localizer["Email"]</th>
                                <th scope="col">@Localizer["Status"]</th>
                                <th scope="col">@Localizer["RequestDate"]</th>
                                <th scope="col">@Localizer["RefundAmount"]</th>
                                <th scope="col">@Localizer["ReturnReason"]</th>
                                <th scope="col" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.returnRequestTranslations = {
            view: '@Html.Raw(Localizer["ViewDetails"].Value)',
            emptyTable: '@Html.Raw(Localizer["NoReturnRequestsFound"].Value)',
            statusPending: '@Html.Raw(Localizer["Pending"].Value)',
            statusApproved: '@Html.Raw(Localizer["Approved"].Value)',
            statusRejected: '@Html.Raw(Localizer["Rejected"].Value)',
            statusProcessing: '@Html.Raw(Localizer["Processing"].Value)',
            statusCompleted: '@Html.Raw(Localizer["Completed"].Value)',
            statusCancelled: '@Html.Raw(Localizer["Cancelled"].Value)'
        };
    </script>
    <script src="~/js/returnRequest.js" asp-append-version="true"></script>
}
