@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["ReturnRequests"]?.Value ?? "Return Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-2">
                        <i class="bi bi-arrow-return-left me-2"></i>@Localizer["ReturnRequests"]
                    </h2>
                    <p class="text-muted mb-0">@(Localizer["ManageReturnRequests"]?.Value ?? "Manage customer return requests")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="returnRequestTable" class="table table-striped table-hover" style="width:100%">
                            <thead>
                                <tr>
                                    <th>@(Localizer["ID"]?.Value ?? "ID")</th>
                                    <th>@(Localizer["OrderNumber"]?.Value ?? "Order ID")</th>
                                    <th>@(Localizer["Customer"]?.Value ?? "Customer")</th>
                                    <th>@(Localizer["Email"]?.Value ?? "Email")</th>
                                    <th>@(Localizer["Status"]?.Value ?? "Status")</th>
                                    <th>@(Localizer["RequestDate"]?.Value ?? "Request Date")</th>
                                    <th>@(Localizer["RefundAmount"]?.Value ?? "Refund Amount")</th>
                                    <th>@(Localizer["ReturnReason"]?.Value ?? "Reason")</th>
                                    <th>@(Localizer["Action"]?.Value ?? "Action")</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/returnRequest.js"></script>
}

