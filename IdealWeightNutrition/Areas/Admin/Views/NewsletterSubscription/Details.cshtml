@model IdealWeightNutrition.Models.NewsletterSubscription

@{
    ViewData["Title"] = Localizer["NewsletterSubscriptionDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["Subscription"] #@Model.Id</h1>
                <p class="text-muted mb-0">@Localizer["SubscribedOn"] @Model.SubscribedDate.ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="admin-card-body">
                <dl class="admin-details-list">
                    <dt>@Localizer["Email"]</dt>
                    <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    <dt>@Localizer["Status"]</dt>
                    <dd>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">@Localizer["Active"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                        }
                    </dd>
                    <dt>@Localizer["SubscribedDate"]</dt>
                    <dd>@Model.SubscribedDate.ToString("yyyy-MM-dd HH:mm")</dd>
                    @if (Model.UnsubscribedDate.HasValue)
                    {
                        <dt>@Localizer["UnsubscribedDate"]</dt>
                        <dd>@Model.UnsubscribedDate.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                    <dt>@Localizer["Source"]</dt>
                    <dd>@(Model.Source ?? Localizer["NA"].Value)</dd>
                </dl>

                <div class="admin-row-actions mb-4">
                    <button type="button"
                            class="btn @(Model.IsActive ? "btn-warning" : "btn-success") toggle-active-btn"
                            data-id="@Model.Id"
                            aria-label="@(Model.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])">
                        <i class="bi bi-@(Model.IsActive ? "x-circle" : "check-circle") me-2" aria-hidden="true"></i>
                        @(Model.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                    </button>
                    <button type="button"
                            class="btn btn-danger delete-btn"
                            data-id="@Model.Id"
                            data-email="@Model.Email"
                            aria-label="@Localizer["Delete"]">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i>
                        @Localizer["Delete"]
                    </button>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        document.querySelector('.toggle-active-btn')?.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            Swal.fire({
                title: '@Localizer["ToggleActiveStatus"]',
                text: '@Localizer["ConfirmToggleStatus"]',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--iw-dark-green)',
                cancelButtonColor: 'var(--iw-muted)',
                confirmButtonText: '@Localizer["Confirm"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const formData = new FormData();
                formData.append('id', id);
                if (token) formData.append('__RequestVerificationToken', token);

                fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': token || '' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        Swal.fire({ icon: 'error', title: '@Localizer["Error"]', text: data.message });
                    }
                });
            });
        });

        document.querySelector('.delete-btn')?.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const email = this.getAttribute('data-email');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            Swal.fire({
                title: '@Localizer["Delete"]',
                text: '@Localizer["ConfirmDeleteSubscription"] ' + email + '?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: 'var(--iw-danger)',
                cancelButtonColor: 'var(--iw-muted)',
                confirmButtonText: '@Localizer["Delete"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const formData = new FormData();
                formData.append('id', id);
                if (token) formData.append('__RequestVerificationToken', token);

                fetch('@Url.Action("Delete")', {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': token || '' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '@Url.Action("Index")';
                    } else {
                        Swal.fire({ icon: 'error', title: '@Localizer["Error"]', text: data.message });
                    }
                });
            });
        });
    </script>
}
