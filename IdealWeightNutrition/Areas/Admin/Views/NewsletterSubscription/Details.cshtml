@model IdealWeightNutrition.Models.NewsletterSubscription

@{
    ViewData["Title"] = Localizer["NewsletterSubscriptionDetails"];
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="bi bi-envelope-heart me-2"></i>@Localizer["NewsletterSubscriptionDetails"]
                </h2>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToList"]
                </a>
            </div>

            <div class="card shadow-lg">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0">@Localizer["Subscription"] #@Model.Id</h3>
                    <small>@Localizer["SubscribedOn"] @Model.SubscribedDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-envelope text-primary me-2"></i>@Localizer["EmailInformation"]
                                </h4>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Email"]:</span>
                                    <span class="detail-value">@Model.Email</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Status"]:</span>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">@Localizer["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-4">
                            <div class="detail-section">
                                <h4 class="section-title">
                                    <i class="bi bi-info-circle text-success me-2"></i>@Localizer["SubscriptionInformation"]
                                </h4>
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["SubscribedDate"]:</span>
                                    <span class="detail-value">@Model.SubscribedDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </div>
                                @if (Model.UnsubscribedDate.HasValue)
                                {
                                    <div class="detail-item">
                                        <span class="detail-label">@Localizer["UnsubscribedDate"]:</span>
                                        <span class="detail-value">@Model.UnsubscribedDate.Value.ToString("MMM dd, yyyy hh:mm tt")</span>
                                    </div>
                                }
                                <div class="detail-item">
                                    <span class="detail-label">@Localizer["Source"]:</span>
                                    <span class="detail-value">@(Model.Source ?? Localizer["NA"])</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2">
                        <button type="button" 
                                class="btn @(Model.IsActive ? "btn-warning" : "btn-success") toggle-active-btn" 
                                data-id="@Model.Id">
                            <i class="bi bi-@(Model.IsActive ? "x-circle" : "check-circle") me-2"></i>
                            @(Model.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])
                        </button>
                        <button type="button" 
                                class="btn btn-danger delete-btn" 
                                data-id="@Model.Id"
                                data-email="@Model.Email">
                            <i class="bi bi-trash me-2"></i>
                            @Localizer["Delete"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-section {
        background: #f9fafb;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e5e7eb;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e5e7eb;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 600;
        color: #6b7280;
        min-width: 150px;
    }

    .detail-value {
        color: #1f2937;
        font-weight: 500;
        text-align: right;
    }
</style>

@section Scripts{
    <script>
        // Toggle active status
        document.querySelector('.toggle-active-btn')?.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const btn = this;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            Swal.fire({
                title: '@Localizer["ToggleActiveStatus"]',
                text: '@Localizer["ConfirmToggleStatus"]',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '@Localizer["Confirm"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }
            
                const formData = new FormData();
                formData.append('id', id);
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }
                
                fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token || ''
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: data.message
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["ErrorUpdatingSubscription"]'
                    });
                });
            });
        });
        
        // Delete subscription
        document.querySelector('.delete-btn')?.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const email = this.getAttribute('data-email');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            Swal.fire({
                title: '@Localizer["Delete"]',
                text: '@Localizer["ConfirmDeleteSubscription"] ' + email + '?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '@Localizer["Delete"]',
                cancelButtonText: '@Localizer["Cancel"]',
                dangerMode: true
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }
            
                const formData = new FormData();
                formData.append('id', id);
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }
                
                fetch('@Url.Action("Delete")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token || ''
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = '@Url.Action("Index")';
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: data.message
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["ErrorDeletingSubscription"]'
                    });
                });
            });
        });
    </script>
}

