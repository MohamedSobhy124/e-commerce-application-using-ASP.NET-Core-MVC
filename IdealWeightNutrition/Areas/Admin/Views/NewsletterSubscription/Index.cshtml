@{
    ViewData["Title"] = Localizer["NewsletterSubscribers"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["EmptyIcon"] = "bi-envelope-heart";
    ViewData["EmptyTitle"] = Localizer["NoNewsletterSubscribersYet"].Value;
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["NewsletterSubscribers"]</h1>
            </div>

            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Localizer["NewsletterSubscriptions"]</p>
                    <a href="@Url.Action("Export")" class="btn btn-success">
                        <i class="bi bi-download me-2" aria-hidden="true"></i>
                        @Localizer["ExportCSV"]
                    </a>
                </div>

                <div id="newsletterEmpty" hidden>
                    <partial name="_AdminEmptyState" />
                </div>

                <div class="table-responsive admin-table-wrapper" id="newsletterTableWrap">
                    <table id="tblData"
                           class="table table-bordered table-striped table-hover w-100"
                           data-label-details="@Localizer["Details"]"
                           data-label-delete="@Localizer["Delete"]"
                           data-label-activate="@Localizer["Active"]"
                           data-label-deactivate="@Localizer["Inactive"]"
                           data-label-active="@Localizer["Active"]"
                           data-label-inactive="@Localizer["Inactive"]"
                           data-confirm-title="@Localizer["AreYouSure"]"
                           data-confirm-status="@Localizer["AreYouSure"]"
                           data-confirm-delete="@Localizer["ConfirmDeleteNamed"]"
                           data-confirm-yes="@Localizer["YesDeleteIt"]"
                           data-empty="@Localizer["NoNewsletterSubscribersYet"]">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["ID"]</th>
                                <th scope="col">@Localizer["Email"]</th>
                                <th scope="col">@Localizer["SubscribedDate"]</th>
                                <th scope="col">@Localizer["Source"]</th>
                                <th scope="col">@Localizer["Status"]</th>
                                <th scope="col">@Localizer["UnsubscribedDate"]</th>
                                <th scope="col" class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript" src="~/js/NewsletterSubscription.js" asp-append-version="true"></script>
}
