        window.servicePurchaseTableInitialized = false;
        
        // Function to initialize service purchase table
        window.initializeServicePurchaseTable = function() {
            var tableElement = document.getElementById('servicePurchaseTable');
            if (!tableElement) {
                console.warn('Service purchase table element not found, will retry...');
                // Check if tab is actually visible
                var servicePane = document.getElementById('service-purchases');
                if (!servicePane || !servicePane.classList.contains('show')) {
                    console.warn('Service purchases tab is not visible yet');
                    return;
                }
                // Retry after a short delay (max 3 retries)
                if (!window.servicePurchaseRetryCount) window.servicePurchaseRetryCount = 0;
                if (window.servicePurchaseRetryCount < 3) {
                    window.servicePurchaseRetryCount++;
                    setTimeout(function() {
                        window.initializeServicePurchaseTable();
                    }, 500);
                } else {
                    console.error('Failed to find service purchase table after multiple retries');
                }
                return;
            }
            
            // Reset retry count on success
            window.servicePurchaseRetryCount = 0;
            
            if (window.servicePurchaseTableInitialized) {
                // Already initialized, just reload data
                if (window.servicePurchaseTable) {
                    window.servicePurchaseTable.setData();
                }
                window.loadServicePurchaseStatistics();
                return;
            }
            
            if (typeof Tabulator === 'undefined') {
                console.error('❌ Tabulator NOT LOADED');
                tableElement.innerHTML = '<div style="padding:2rem;text-align:center;color:red;"><h3>⚠️ Tabulator Library Failed to Load</h3><p>Please check your internet connection or try refreshing the page.</p></div>';
                return;
            }

            window.servicePurchaseTable = new Tabulator("#servicePurchaseTable", {
                        height: "800px",
                        layout: "fitDataFill",
                        responsiveLayout: false,
                        placeholder: "No service purchases found",
                        pagination: true,
                        paginationMode: "remote",
                        paginationSize: 10,
                        paginationSizeSelector: [10, 25, 50, 100],
                        paginationCounter: "rows",
                        ajaxURL: "/Admin/ServiceSubscription/GetAllPurchases",
                        ajaxParams: function() {
                            return {
                                paymentStatus: window.currentServicePaymentStatus,
                                serviceStatus: window.currentServiceStatus,
                                dateFrom: window.currentServiceDateFrom,
                                dateTo: window.currentServiceDateTo,
                                searchValue: document.getElementById('servicePurchaseSearchInput')?.value || '',
                                sortColumn: 'Id',
                                sortDirection: 'desc'
                            };
                        },
                        ajaxRequestFunc: function(url, config, params) {
                            var queryParams = [];
                            var page = params.page || 1;
                            var size = params.size || 10;
                            queryParams.push(`start=${(page - 1) * size}`);
                            queryParams.push(`length=${size}`);
                            
                            if (params.sort && params.sort.length > 0) {
                                queryParams.push(`sortColumn=${params.sort[0].field}`);
                                queryParams.push(`sortDirection=${params.sort[0].dir}`);
                            }
                            
                            queryParams.push(`paymentStatus=${window.currentServicePaymentStatus || ''}`);
                            queryParams.push(`serviceStatus=${window.currentServiceStatus || ''}`);
                            queryParams.push(`dateFrom=${window.currentServiceDateFrom || ''}`);
                            queryParams.push(`dateTo=${window.currentServiceDateTo || ''}`);
                            
                            var searchValue = document.getElementById('servicePurchaseSearchInput')?.value || '';
                            if (searchValue) {
                                queryParams.push(`searchValue=${encodeURIComponent(searchValue)}`);
                            }
                            
                            var finalUrl = url + '?' + queryParams.join('&');
                            return fetch(finalUrl, config).then(response => response.json());
                        },
                        ajaxResponse: function(url, params, response) {
                            return {
                                last_page: response.last_page || 1,
                                data: response.data || []
                            };
                        },
