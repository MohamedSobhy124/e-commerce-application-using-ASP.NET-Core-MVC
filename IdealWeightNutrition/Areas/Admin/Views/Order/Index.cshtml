            }

            return {
                escapeHtml: escapeHtml,
                formatMoney: formatMoney,
                formatDateTime: formatDateTime,
                orderStatusMeta: orderStatusMeta,
                paymentStatusMeta: paymentStatusMeta,
                statusBadge: statusBadge,
                detailsButton: detailsButton
            };
        })();
