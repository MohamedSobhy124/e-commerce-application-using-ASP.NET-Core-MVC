@model IEnumerable<OrderHeader>
@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility

@{
    ViewData["Title"] = Localizer["OrdersManagement"];
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">
                    <i class="bi bi-receipt me-3"></i>
                    @Localizer["OrdersManagement"]
                </h1>
            </div>

            <div class="admin-card-body">
                <!-- Tabs Navigation -->
                <ul class="nav nav-pills admin-tabs" id="ordersTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab" aria-controls="orders" aria-selected="true" data-admin-tab="orders">
                            <i class="bi bi-receipt me-2" aria-hidden="true"></i>@Localizer["Orders"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="service-purchases-tab" data-bs-toggle="tab" data-bs-target="#service-purchases" type="button" role="tab" aria-controls="service-purchases" aria-selected="false" data-admin-tab="service-purchases">
                            <i class="bi bi-cart-check me-2" aria-hidden="true"></i>@Localizer["ServicePurchases"]
                        </button>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content" id="ordersTabsContent">
                    <!-- Orders Tab -->
                    <div class="tab-pane fade show active" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                <!-- Order Statistics Cards -->
                <div class="order-stats-container" id="orderStatsContainer">
                    <div class="order-stat-card all is-active" role="button" tabindex="0" data-order-stat-filter data-filter-value="all" aria-pressed="true">
                        <div class="order-stat-icon">
                            <i class="bi bi-list-ul" aria-hidden="true"></i>
                        </div>
                        <div class="order-stat-label">@Localizer["TotalOrders"]</div>
                        <div class="order-stat-value" id="statAll">0</div>
                    </div>
                    <div class="order-stat-card pending" role="button" tabindex="0" data-order-stat-filter data-filter-value="Pending" aria-pressed="false">
                        <div class="order-stat-icon">
                            <i class="bi bi-clock" aria-hidden="true"></i>
                        </div>
                        <div class="order-stat-label">@Localizer["Pending"]</div>
                        <div class="order-stat-value" id="statPending">0</div>
                    </div>
                    <div class="order-stat-card approved" role="button" tabindex="0" data-order-stat-filter data-filter-value="Approved" aria-pressed="false">
                        <div class="order-stat-icon">
                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                        </div>
                        <div class="order-stat-label">@Localizer["Approved"]</div>
                        <div class="order-stat-value" id="statApproved">0</div>
                    </div>
                    <div class="order-stat-card inprocess" role="button" tabindex="0" data-order-stat-filter data-filter-value="Processing" aria-pressed="false">
                        <div class="order-stat-icon">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                        </div>
                        <div class="order-stat-label">@Localizer["Processing"]</div>
                        <div class="order-stat-value" id="statProcessing">0</div>
                    </div>
                    <div class="order-stat-card shipped" role="button" tabindex="0" data-order-stat-filter data-filter-value="Shipped" aria-pressed="false">
                        <div class="order-stat-icon">
                            <i class="bi bi-truck" aria-hidden="true"></i>
                        </div>
                        <div class="order-stat-label">@Localizer["Shipped"]</div>
                        <div class="order-stat-value" id="statShipped">0</div>
                    </div>
                    <div class="order-stat-card delivered" role="button" tabindex="0" data-order-stat-filter data-filter-value="Delivered" aria-pressed="false">
                        <div class="order-stat-icon">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        </div>
                        <div class="order-stat-label">@Localizer["Delivered"]</div>
                        <div class="order-stat-value" id="statDelivered">0</div>
                    </div>
                </div>

            

                <!-- Compact Advanced Filters -->
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="filters-container">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-link p-0 text-decoration-none admin-filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded="false" aria-controls="advancedFilters">
                                        <i class="bi bi-funnel-fill me-1" aria-hidden="true"></i>
                                        <span class="fw-semibold">@Localizer["Filters"]</span>
                                        <i class="bi bi-chevron-down ms-1 filter-toggle-chevron" id="filterToggleIcon" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="admin-header-actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnExportProductProfits">
                                        <i class="bi bi-graph-up-arrow me-1" aria-hidden="true"></i>@Localizer["ExportProductProfits"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnExportOrders">
                                        <i class="bi bi-download me-1" aria-hidden="true"></i>@Localizer["ExportOrders"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnClearOrderFilters">
                                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>@Localizer["ClearAll"]
                                    </button>
                                </div>
                            </div>
                            
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <div class="order-filter-tabs-compact" role="group" aria-label="@Localizer["OrderStatus"]">
                                    <button type="button" class="filter-tab-compact active" data-order-status-filter data-filter-value="all">
                                        <i class="bi bi-list-ul" aria-hidden="true"></i> @Localizer["All"]
                                    </button>
                                    <button type="button" class="filter-tab-compact" data-order-status-filter data-filter-value="Pending">
                                        <i class="bi bi-clock" aria-hidden="true"></i> @Localizer["Pending"]
                                    </button>
                                    <button type="button" class="filter-tab-compact" data-order-status-filter data-filter-value="Approved">
                                        <i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Approved"]
                                    </button>
                                    <button type="button" class="filter-tab-compact" data-order-status-filter data-filter-value="Processing">
                                        <i class="bi bi-gear" aria-hidden="true"></i> @Localizer["Processing"]
                                    </button>
                                    <button type="button" class="filter-tab-compact" data-order-status-filter data-filter-value="Shipped">
                                        <i class="bi bi-truck" aria-hidden="true"></i> @Localizer["Shipped"]
                                    </button>
                                    <button type="button" class="filter-tab-compact" data-order-status-filter data-filter-value="Delivered">
                                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i> @Localizer["Delivered"]
                                    </button>
                                    <button type="button" class="filter-tab-compact" data-order-status-filter data-filter-value="Cancelled">
                                        <i class="bi bi-x-circle" aria-hidden="true"></i> @Localizer["Cancelled"]
                                    </button>
                                </div>
                                
                                <div class="search-box-compact search-box ms-auto">
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-search" aria-hidden="true"></i>
                                        </span>
                                        <input type="search"
                                               id="orderSearchInput"
                                               class="form-control"
                                               placeholder="@Localizer["SearchOrdersPlaceholder"]"
                                               autocomplete="off">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearOrderSearch" aria-label="@Localizer["ClearSearch"]">
                                            <i class="bi bi-x" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Collapsible Advanced Filters -->
                            <div class="collapse" id="advancedFilters">
                                <div class="border-top pt-3 mt-2">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-muted mb-1" for="paymentStatusFilter">
                                                <i class="bi bi-credit-card me-1" aria-hidden="true"></i>@Localizer["PaymentStatus"]
                                            </label>
                                            <select id="paymentStatusFilter" class="form-select form-select-sm">
                                                <option value="">@Localizer["All"]</option>
                                                <option value="Paid">@Localizer["Paid"]</option>
                                                <option value="Pending">@Localizer["Pending"]</option>
                                                <option value="Rejected">@Localizer["Rejected"]</option>
                                                <option value="Refunded">@Localizer["Refunded"]</option>
                                                <option value="PartiallyRefunded">@Localizer["PartiallyRefunded"]</option>
                                                <option value="Cancelled">@Localizer["Cancelled"]</option>
                                                <option value="Authorized">@Localizer["Authorized"]</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-muted mb-1" for="paymentMethodFilter">
                                                <i class="bi bi-wallet2 me-1" aria-hidden="true"></i>@Localizer["PaymentMethod"]
                                            </label>
                                            <select id="paymentMethodFilter" class="form-select form-select-sm">
                                                <option value="">@Localizer["All"]</option>
                                                <option value="Tamara">Tamara</option>
                                                <option value="Geidea">Geidea</option>
                                                <option value="Tabby">Tabby</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-muted mb-1" for="dateFromFilter">
                                                <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>@Localizer["StartDate"]
                                            </label>
                                            <input type="date" id="dateFromFilter" class="form-control form-control-sm">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-muted mb-1" for="dateToFilter">
                                                <i class="bi bi-calendar-check me-1" aria-hidden="true"></i>@Localizer["EndDate"]
                                            </label>
                                            <input type="date" id="dateToFilter" class="form-control form-control-sm">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                        <!-- Order Table -->
                        <div class="order-table-wrapper">
                            <div id="orderTable" class="order-table-host">
                                <div class="admin-order-loading">
                                    <i class="bi bi-arrow-repeat admin-order-loading-icon" aria-hidden="true"></i>
                                    <p class="admin-order-loading-title">@Localizer["Common_Loading"]</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Orders Tab -->

                    <!-- Service Purchases Tab -->
                    <div class="tab-pane fade" id="service-purchases" role="tabpanel" aria-labelledby="service-purchases-tab">
                        <!-- Service Purchase Statistics Cards -->
                        <div class="order-stats-container" id="servicePurchaseStatsContainer">
                            <div class="order-stat-card all">
                                <div class="order-stat-icon">
                                    <i class="bi bi-list-ul"></i>
                                </div>
                                <div class="order-stat-label">@Localizer["TotalPurchases"]</div>
                                <div class="order-stat-value" id="serviceStatAll">0</div>
                            </div>
                            <div class="order-stat-card pending">
                                <div class="order-stat-icon">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div class="order-stat-label">@Localizer["Pending"]</div>
                                <div class="order-stat-value" id="serviceStatPending">0</div>
                            </div>
                            <div class="order-stat-card approved">
                                <div class="order-stat-icon">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <div class="order-stat-label">@Localizer["Approved"]</div>
                                <div class="order-stat-value" id="serviceStatApproved">0</div>
                            </div>
                        </div>

                        <!-- Compact Advanced Filters for Service Purchases -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="filters-container">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <button class="btn btn-sm btn-link p-0 text-decoration-none admin-filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#serviceAdvancedFilters" aria-expanded="false" aria-controls="serviceAdvancedFilters">
                                                <i class="bi bi-funnel-fill me-1" aria-hidden="true"></i>
                                                <span class="fw-semibold">@Localizer["Filters"]</span>
                                                <i class="bi bi-chevron-down ms-1 filter-toggle-chevron" id="serviceFilterToggleIcon" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <div class="admin-header-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnExportServicePurchases">
                                                <i class="bi bi-download me-1" aria-hidden="true"></i>@Localizer["ExportServicePurchases"]
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" id="btnClearServiceFilters">
                                                <i class="bi bi-x-circle me-1" aria-hidden="true"></i>@Localizer["ClearAll"]
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <div class="order-filter-tabs-compact" role="group" aria-label="@Localizer["PaymentStatus"]">
                                            <button type="button" class="filter-tab-compact active" data-service-status-filter data-filter-value="all">
                                                <i class="bi bi-list-ul" aria-hidden="true"></i> @Localizer["All"]
                                            </button>
                                            <button type="button" class="filter-tab-compact" data-service-status-filter data-filter-value="Pending">
                                                <i class="bi bi-clock" aria-hidden="true"></i> @Localizer["Pending"]
                                            </button>
                                            <button type="button" class="filter-tab-compact" data-service-status-filter data-filter-value="Approved">
                                                <i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Approved"]
                                            </button>
                                            <button type="button" class="filter-tab-compact" data-service-status-filter data-filter-value="Rejected">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> @Localizer["Rejected"]
                                            </button>
                                        </div>
                                        
                                        <div class="search-box-compact search-box ms-auto">
                                            <div class="input-group">
                                                <span class="input-group-text">
                                                    <i class="bi bi-search" aria-hidden="true"></i>
                                                </span>
                                                <input type="search"
                                                       id="servicePurchaseSearchInput"
                                                       class="form-control"
                                                       placeholder="@Localizer["SearchServicePurchasesPlaceholder"]"
                                                       autocomplete="off">
                                                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearServiceSearch" aria-label="@Localizer["ClearSearch"]">
                                                    <i class="bi bi-x" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Collapsible Advanced Filters -->
                                    <div class="collapse" id="serviceAdvancedFilters">
                                        <div class="border-top pt-3 mt-2">
                                            <div class="row g-2">
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold text-muted mb-1" for="servicePaymentStatusFilter">
                                                        <i class="bi bi-credit-card me-1" aria-hidden="true"></i>@Localizer["PaymentStatus"]
                                                    </label>
                                                    <select id="servicePaymentStatusFilter" class="form-select form-select-sm">
                                                        <option value="">@Localizer["All"]</option>
                                                        <option value="Approved">@Localizer["Approved"]</option>
                                                        <option value="Pending">@Localizer["Pending"]</option>
                                                        <option value="Rejected">@Localizer["Rejected"]</option>
                                                        <option value="Cancelled">@Localizer["Cancelled"]</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold text-muted mb-1" for="serviceStatusFilter">
                                                        <i class="bi bi-briefcase me-1" aria-hidden="true"></i>@Localizer["ServiceStatus"]
                                                    </label>
                                                    <select id="serviceStatusFilter" class="form-select form-select-sm">
                                                        <option value="">@Localizer["All"]</option>
                                                        <option value="Active">@Localizer["Active"]</option>
                                                        <option value="Expired">@Localizer["Expired"]</option>
                                                        <option value="Cancelled">@Localizer["Cancelled"]</option>
                                                        <option value="Suspended">@Localizer["Suspended"]</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold text-muted mb-1" for="serviceDateFromFilter">
                                                        <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>@Localizer["StartDate"]
                                                    </label>
                                                    <input type="date" id="serviceDateFromFilter" class="form-control form-control-sm">
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold text-muted mb-1" for="serviceDateToFilter">
                                                        <i class="bi bi-calendar-check me-1" aria-hidden="true"></i>@Localizer["EndDate"]
                                                    </label>
                                                    <input type="date" id="serviceDateToFilter" class="form-control form-control-sm">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Service Purchase Table -->
                        <div class="order-table-wrapper">
                            <div id="servicePurchaseTable" class="order-table-host">
                                <div class="admin-order-loading">
                                    <i class="bi bi-arrow-repeat admin-order-loading-icon" aria-hidden="true"></i>
                                    <p class="admin-order-loading-title">@Localizer["Common_Loading"]</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Service Purchases Tab -->
                </div>
                <!-- End Tab Content -->
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/order-index.css" />
    <!-- Tabulator CSS -->
    <link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet">
}

@section Scripts {
    <!-- Tabulator JS -->
    <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
    
    <script>
        // Pass translations to JavaScript
        window.orderTranslations = {
            orderID: '@Html.Raw(Localizer["OrderID"].Value)',
            customer: '@Html.Raw(Localizer["Customer"].Value)',
            email: '@Html.Raw(Localizer["Email"].Value)',
            paymentMethod: '@Html.Raw(Localizer["PaymentMethod"].Value)',
            phone: '@Html.Raw(Localizer["Phone"].Value)',
            orderDate: '@Html.Raw(Localizer["OrderDate"].Value)',
            total: '@Html.Raw(Localizer["Total"].Value)',
            orderStatus: '@Html.Raw(Localizer["OrderStatus"].Value)',
            paymentStatus: '@Html.Raw(Localizer["PaymentStatus"].Value)',
            actions: '@Html.Raw(Localizer["Actions"].Value)',
            pending: '@Html.Raw(Localizer["Pending"].Value)',
            approved: '@Html.Raw(Localizer["Approved"].Value)',
            processing: '@Html.Raw(Localizer["Processing"].Value)',
            shipped: '@Html.Raw(Localizer["Shipped"].Value)',
            delivered: '@Html.Raw(Localizer["Delivered"].Value)',
            cancelled: '@Html.Raw(Localizer["Cancelled"].Value)',
            paid: '@Html.Raw(Localizer["Paid"]?.Value ?? "Paid")',
            refunded: '@Html.Raw(Localizer["Refunded"].Value)',
            rejected: '@Html.Raw(Localizer["Rejected"].Value)',
            guestOrder: '@Html.Raw(Localizer["GuestOrder"].Value)',
            noOrdersFound: '@Html.Raw(Localizer["NoOrdersFound"].Value)',
            noServicePurchasesFound: '@Html.Raw(Localizer["NoServicePurchasesFound"].Value)',
            details: '@Html.Raw(Localizer["Details"].Value)',
            na: '@Html.Raw(Localizer["NA"]?.Value ?? "N/A")',
            showingOrders: '@Html.Raw(Localizer["ShowingOrders"]?.Value ?? "Showing {start} to {end} of {total} orders")',
            search: '@Html.Raw(Localizer["Search"]?.Value ?? "Search...")',
            vat: '@Html.Raw(Localizer["VATAmount"].Value)',
            amountPaid: '@Html.Raw(Localizer["AmountPaid"].Value)',
            partiallyRefunded: '@Html.Raw(Localizer["PartiallyRefunded"].Value)',
            authorized: '@Html.Raw(Localizer["Authorized"].Value)'
        };

        window.adminOrderFormat = (function() {
            var t = window.orderTranslations;
            var dateLocale = '@currentCulture';
            var currencySymbol = '@currencySymbol';

            function escapeHtml(value) {
                if (value == null || String(value).trim() === '') {
                    return t.na;
                }
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatMoney(value) {
                var n = parseFloat(value);
                if (isNaN(n)) {
                    n = 0;
                }
                return currencySymbol + ' ' + n.toFixed(2);
            }

            function formatDateTime(value) {
                if (!value) {
                    return t.na;
                }
                var date = new Date(value);
                if (isNaN(date.getTime())) {
                    return t.na;
                }
                return date.toLocaleDateString(dateLocale, { day: 'numeric', month: 'short', year: 'numeric' })
                    + ' · '
                    + date.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit' });
            }

            function orderStatusMeta(status) {
                var s = (status || '').toLowerCase();
                if (s.indexOf('delivered') !== -1) return { cls: 'badge-success', icon: 'bi-check-circle-fill', label: t.delivered };
                if (s.indexOf('approved') !== -1) return { cls: 'badge-success', icon: 'bi-check-circle', label: t.approved };
                if (s.indexOf('shipped') !== -1) return { cls: 'badge-primary', icon: 'bi-truck', label: t.shipped };
                if (s.indexOf('cancel') !== -1) return { cls: 'badge-danger', icon: 'bi-x-circle', label: t.cancelled };
                if (s.indexOf('process') !== -1) return { cls: 'badge-info', icon: 'bi-gear', label: t.processing };
                if (s.indexOf('pending') !== -1) return { cls: 'badge-warning', icon: 'bi-clock', label: t.pending };
                if (s.indexOf('reject') !== -1) return { cls: 'badge-danger', icon: 'bi-x-circle', label: t.rejected };
                return { cls: 'badge-secondary', icon: 'bi-circle', label: escapeHtml(status) };
            }

            function paymentStatusMeta(status) {
                var s = (status || '').toLowerCase();
                if (s.indexOf('partial') !== -1) return { cls: 'refunded', icon: 'bi-arrow-counterclockwise', label: t.partiallyRefunded };
                if (s.indexOf('paid') !== -1) return { cls: 'paid', icon: 'bi-check-circle-fill', label: t.paid };
                if (s.indexOf('reject') !== -1) return { cls: 'rejected', icon: 'bi-x-circle', label: t.rejected };
                if (s.indexOf('refund') !== -1) return { cls: 'refunded', icon: 'bi-arrow-counterclockwise', label: t.refunded };
                if (s.indexOf('author') !== -1) return { cls: 'approved', icon: 'bi-shield-check', label: t.authorized };
                if (s.indexOf('cancel') !== -1) return { cls: 'rejected', icon: 'bi-x-circle', label: t.cancelled };
                if (s.indexOf('approved') !== -1) return { cls: 'approved', icon: 'bi-check-circle', label: t.approved };
                if (s.indexOf('pending') !== -1) return { cls: 'pending', icon: 'bi-clock', label: t.pending };
                return { cls: 'pending', icon: 'bi-clock', label: escapeHtml(status) };
            }

            function statusBadge(meta, extraClass) {
                return '<span class="' + extraClass + ' ' + meta.cls + '"><i class="bi ' + meta.icon + '" aria-hidden="true"></i>' + meta.label + '</span>';
            }

            function detailsButton(url) {
