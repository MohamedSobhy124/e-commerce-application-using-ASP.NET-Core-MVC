        // Global filter variables for Service Purchases
        window.currentServiceFilter = 'all';
        window.currentServicePaymentStatus = '';
        window.currentServiceStatus = '';
        window.currentServiceDateFrom = '';
        window.currentServiceDateTo = '';

        // Initialize Service Purchase Table when tab is shown
        window.servicePurchaseTableInitialized = false;
        
        // Function to initialize service purchase table
        window.initializeServicePurchaseTable = function() {
            var tableElement = document.getElementById('servicePurchaseTable');
            if (!tableElement) {
                console.warn('Service purchase table element not found, will retry...');
                // Check if tab is actually visible
                var servicePane = document.getElementById('service-purchases');
                if (!servicePane || !servicePane.classList.contains('show')) {
                    console.warn('Service purchases tab is not visible yet');
                    return;
                }
                // Retry after a short delay (max 3 retries)
                if (!window.servicePurchaseRetryCount) window.servicePurchaseRetryCount = 0;
                if (window.servicePurchaseRetryCount < 3) {
                    window.servicePurchaseRetryCount++;
                    setTimeout(function() {
                        window.initializeServicePurchaseTable();
                    }, 500);
                } else {
                    console.error('Failed to find service purchase table after multiple retries');
                }
                return;
            }
            
            // Reset retry count on success
            window.servicePurchaseRetryCount = 0;
            
            if (window.servicePurchaseTableInitialized) {
                // Already initialized, just reload data
                if (window.servicePurchaseTable) {
                    window.servicePurchaseTable.setData();
                }
                window.loadServicePurchaseStatistics();
                return;
