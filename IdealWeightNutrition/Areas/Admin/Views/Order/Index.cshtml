                            if (searchValue) {
                                queryParams.push(`searchValue=${encodeURIComponent(searchValue)}`);
                            }
                            
                            var finalUrl = url + '?' + queryParams.join('&');
                            return fetch(finalUrl, config).then(response => response.json());
                        },
                        ajaxResponse: function(url, params, response) {
