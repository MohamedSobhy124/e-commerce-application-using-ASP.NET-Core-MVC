                if (activeTab.id === 'orders-tab') {
                    activeTab.style.background = 'linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%)';
                    activeTab.style.color = '#667eea';
                    var indicator = activeTab.querySelector('.tab-indicator');
                    if (indicator) {
                        indicator.style.transform = 'scaleX(1)';
                    }
                }
            }
        });
        
    </script>
}

