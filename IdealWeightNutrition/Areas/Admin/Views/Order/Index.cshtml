        window.filterServicePurchases = function(status) {
            window.currentServiceFilter = status;
            
            // Update active tab
            document.querySelectorAll('#service-purchases .filter-tab-compact').forEach(tab => {
                tab.classList.remove('active');
            });
            
            const tabs = document.querySelectorAll('#service-purchases .filter-tab-compact');
            tabs.forEach(tab => {
                const filterValue = tab.getAttribute('data-filter-value');
                if (filterValue === status) {
                    tab.classList.add('active');
                }
            });
            
            // Update payment status filter based on tab selection
            if (status === 'all') {
                window.currentServicePaymentStatus = '';
            } else {
                window.currentServicePaymentStatus = status;
            }
            
            // Reload table data with new filter
            applyServiceFilters();
        };
        
        window.applyServiceFilters = function() {
            // Update filter values from UI
            window.currentServicePaymentStatus = document.getElementById('servicePaymentStatusFilter') ? document.getElementById('servicePaymentStatusFilter').value : '';
            window.currentServiceStatus = document.getElementById('serviceStatusFilter') ? document.getElementById('serviceStatusFilter').value : '';
            window.currentServiceDateFrom = document.getElementById('serviceDateFromFilter') ? document.getElementById('serviceDateFromFilter').value : '';
            window.currentServiceDateTo = document.getElementById('serviceDateToFilter') ? document.getElementById('serviceDateToFilter').value : '';
            
            // Reload table data with all filters
            if (window.servicePurchaseTable) {
                window.servicePurchaseTable.setPage(1).then(function(){
                    window.servicePurchaseTable.setData();
                });
            }
        };
        
        window.clearAllServiceFilters = function() {
            // Reset all filters
            window.currentServiceFilter = 'all';
            window.currentServicePaymentStatus = '';
            window.currentServiceStatus = '';
            window.currentServiceDateFrom = '';
            window.currentServiceDateTo = '';
            
            // Reset UI
            document.querySelectorAll('#service-purchases .filter-tab-compact').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelector('#service-purchases .filter-tab-compact[data-filter-value="all"]')?.classList.add('active');
            
            if (document.getElementById('servicePaymentStatusFilter')) {
                document.getElementById('servicePaymentStatusFilter').value = '';
            }
            if (document.getElementById('serviceStatusFilter')) {
                document.getElementById('serviceStatusFilter').value = '';
            }
            if (document.getElementById('serviceDateFromFilter')) {
                document.getElementById('serviceDateFromFilter').value = '';
            }
            if (document.getElementById('serviceDateToFilter')) {
                document.getElementById('serviceDateToFilter').value = '';
            }
            if (document.getElementById('servicePurchaseSearchInput')) {
                document.getElementById('servicePurchaseSearchInput').value = '';
            }
            
            // Reload table
            applyServiceFilters();
        };
        
        // Search function for Service Purchases
        window.searchServicePurchases = function() {
            var searchValue = document.getElementById('servicePurchaseSearchInput').value;
            
            if (window.servicePurchaseTable) {
                window.servicePurchaseTable.setPage(1).then(function(){
                    window.servicePurchaseTable.setData();
                });
            }
        };
        
        // Clear search for Service Purchases
        window.clearServiceSearch = function() {
            document.getElementById('servicePurchaseSearchInput').value = '';
            window.searchServicePurchases();
        };
        
        // Export Service Purchases with current filters
        window.exportServicePurchases = function() {
            var paymentStatus = window.currentServicePaymentStatus || '';
            var serviceStatus = window.currentServiceStatus || '';
            var dateFrom = window.currentServiceDateFrom || '';
            var dateTo = window.currentServiceDateTo || '';
            var searchValue = document.getElementById('servicePurchaseSearchInput') ? document.getElementById('servicePurchaseSearchInput').value : '';
            
            // Build query string
            var params = new URLSearchParams();
            if (paymentStatus) params.append('paymentStatus', paymentStatus);
            if (serviceStatus) params.append('serviceStatus', serviceStatus);
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo) params.append('dateTo', dateTo);
            if (searchValue) params.append('searchValue', searchValue);
            
            // Create download link
            var url = '/Admin/ServiceSubscription/ExportServicePurchases?' + params.toString();
            window.location.href = url;
        };

        // Add event listener for service purchase search input (with debounce)
        document.addEventListener('DOMContentLoaded', function() {
            // Setup Service Purchases tab event listener
            var servicePurchaseTabElement = document.getElementById('service-purchases-tab');
            var servicePurchasePane = document.getElementById('service-purchases');
            
            if (servicePurchaseTabElement && servicePurchasePane) {
                // Check if service purchases tab is active
                if (servicePurchasePane.classList.contains('active') && servicePurchasePane.classList.contains('show')) {
                    // Tab is already active, initialize after a delay to ensure DOM is ready
                    setTimeout(function() {
                        window.initializeServicePurchaseTable();
                    }, 800);
                } else {
                    // Tab is not active, wait for it to be shown
                    servicePurchaseTabElement.addEventListener('shown.bs.tab', function() {
                        // Wait a bit to ensure tab content is fully visible and rendered
                        setTimeout(function() {
                            window.initializeServicePurchaseTable();
                        }, 500);
                    });
                }
            }
            
            var serviceSearchInput = document.getElementById('servicePurchaseSearchInput');
            if (serviceSearchInput) {
                var serviceSearchTimeout;
                serviceSearchInput.addEventListener('input', function() {
                    clearTimeout(serviceSearchTimeout);
                    serviceSearchTimeout = setTimeout(function() {
                        window.searchServicePurchases();
                    }, 500);
                });
                
                serviceSearchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        clearTimeout(serviceSearchTimeout);
                        window.searchServicePurchases();
                    }
                });
            }
            
            // Toggle icon rotation for service filters collapse
            var serviceFilterToggle = document.querySelector('[data-bs-toggle="collapse"][data-bs-target="#serviceAdvancedFilters"]');
            var serviceFilterToggleIcon = document.getElementById('serviceFilterToggleIcon');
            if (serviceFilterToggle && serviceFilterToggleIcon) {
                serviceFilterToggle.addEventListener('click', function() {
                    setTimeout(function() {
                        serviceFilterToggleIcon.classList.toggle('is-expanded', serviceFilterToggle.getAttribute('aria-expanded') === 'true');
                    }, 10);
                });
            }
        });
        
    </script>
}

