                                headerSort: true,
                                variableHeight: true,
                                formatter: function(cell) {
                                    return '<span class="admin-order-primary">' + window.adminOrderFormat.escapeHtml(cell.getValue()) + '</span>';
                                }
                            },
                            {
                                title: "@Localizer["Customer"]",
                                field: "customerName",
                                widthGrow: 2.2,
                                sorter: "string",
                                headerSort: true,
                                variableHeight: true,
