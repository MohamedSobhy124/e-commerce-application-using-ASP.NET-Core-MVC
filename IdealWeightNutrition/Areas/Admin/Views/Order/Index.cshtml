        // Load Service Purchase Statistics
        window.loadServicePurchaseStatistics = function() {
            var statAll = document.getElementById('serviceStatAll');
            var statPending = document.getElementById('serviceStatPending');
            var statApproved = document.getElementById('serviceStatApproved');
            
            if (!statAll || !statPending || !statApproved) {
                // Elements not in DOM yet, skip
                return;
            }
            
            fetch('/Admin/ServiceSubscription/GetServicePurchaseStatistics')
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.stats) {
                        if (statAll) statAll.textContent = data.stats.all || 0;
                        if (statPending) statPending.textContent = data.stats.pending || 0;
                        if (statApproved) statApproved.textContent = data.stats.approved || 0;
                    }
                })
                .catch(error => {
                    console.error('Failed to load service purchase statistics:', error);
                });
        };

