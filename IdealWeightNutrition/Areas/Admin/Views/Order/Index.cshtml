                        // Hide orders tab
                        var ordersTab = document.getElementById('orders-tab');
                        var ordersPane = document.getElementById('orders');
                        if (ordersTab && ordersPane) {
                            ordersPane.classList.remove('show', 'active');
                            ordersTab.classList.remove('active');
                            ordersTab.setAttribute('aria-selected', 'false');
                        }
                        
                        // Initialize table after tab is visible
                        setTimeout(function() {
                            window.initializeServicePurchaseTable();
