        window.updateOrdersStatusFilterUI = function(status) {
            document.querySelectorAll('#orders [data-order-status-filter]').forEach(function(tab) {
                tab.classList.toggle('active', tab.getAttribute('data-filter-value') === status);
            });
            document.querySelectorAll('#orderStatsContainer [data-order-stat-filter]').forEach(function(card) {
                var isActive = card.getAttribute('data-filter-value') === status;
                card.classList.toggle('is-active', isActive);
                card.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
        };

        window.filterOrders = function(status) {
            window.currentFilter = status;
            window.updateOrdersStatusFilterUI(status);
            applyFilters();
        };
        
        window.applyFilters = function() {
            // Update filter values from UI
            window.currentPaymentStatus = document.getElementById('paymentStatusFilter') ? document.getElementById('paymentStatusFilter').value : '';
            window.currentPaymentMethod = document.getElementById('paymentMethodFilter') ? document.getElementById('paymentMethodFilter').value : '';
            window.currentDateFrom = document.getElementById('dateFromFilter') ? document.getElementById('dateFromFilter').value : '';
            window.currentDateTo = document.getElementById('dateToFilter') ? document.getElementById('dateToFilter').value : '';
            
            // Reload table data with all filters
            if (window.orderTable) {
                window.orderTable.setPage(1).then(function(){
                    window.orderTable.setData();
                });
            }
        };
        
        window.clearAllFilters = function() {
            // Reset all filters
            window.currentFilter = 'all';
            window.currentPaymentStatus = '';
            window.currentPaymentMethod = '';
            window.currentDateFrom = '';
            window.currentDateTo = '';
            
            window.updateOrdersStatusFilterUI('all');
            
            if (document.getElementById('paymentStatusFilter')) {
                document.getElementById('paymentStatusFilter').value = '';
            }
            if (document.getElementById('paymentMethodFilter')) {
                document.getElementById('paymentMethodFilter').value = '';
            }
            if (document.getElementById('dateFromFilter')) {
                document.getElementById('dateFromFilter').value = '';
            }
            if (document.getElementById('dateToFilter')) {
                document.getElementById('dateToFilter').value = '';
            }
            if (document.getElementById('orderSearchInput')) {
                document.getElementById('orderSearchInput').value = '';
            }
            
            // Reload table
            applyFilters();
        };
        
        // Search function (triggered by input)
        window.searchOrders = function() {
            var searchValue = document.getElementById('orderSearchInput').value;
            
            if (window.orderTable) {
                window.orderTable.setPage(1).then(function(){
                    window.orderTable.setData();
                });
            }
        };
        
        // Clear search
        window.clearSearch = function() {
            document.getElementById('orderSearchInput').value = '';
            window.searchOrders();
        };
        
        // Export orders with current filters
        window.exportOrders = function() {
            // Get current filter values
            var status = window.currentFilter === 'all' ? '' : window.currentFilter;
            var paymentStatus = window.currentPaymentStatus || '';
            var paymentMethod = window.currentPaymentMethod || '';
            var dateFrom = window.currentDateFrom || '';
            var dateTo = window.currentDateTo || '';
            var searchValue = document.getElementById('orderSearchInput') ? document.getElementById('orderSearchInput').value : '';
            
            // Build query string
            var params = new URLSearchParams();
            if (status) params.append('status', status);
            if (paymentStatus) params.append('paymentStatus', paymentStatus);
            if (paymentMethod) params.append('paymentMethod', paymentMethod);
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo) params.append('dateTo', dateTo);
            if (searchValue) params.append('searchValue', searchValue);
            
            // Create download link
            var url = '/Admin/Order/Export?' + params.toString();
            window.location.href = url;
        };
        
        // Export product profits with current filters
        window.exportProductProfits = function() {
            // Get current filter values (only date range is used for product profits)
            var dateFrom = window.currentDateFrom || '';
            var dateTo = window.currentDateTo || '';
            
            // Build query string
            var params = new URLSearchParams();
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo) params.append('dateTo', dateTo);
            
            // Create download link
            var url = '/Admin/Order/ExportProductProfits?' + params.toString();
            window.location.href = url;
        };
        
        // Add event listener for search input (with debounce)
        var searchTimeout;
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-admin-tab]').forEach(function(tabBtn) {
                tabBtn.addEventListener('click', function() {
                    var tabName = tabBtn.getAttribute('data-admin-tab');
                    if (tabName) {
                        window.setActiveTab(tabName);
                    }
                });
            });

            document.getElementById('btnExportProductProfits')?.addEventListener('click', window.exportProductProfits);
            document.getElementById('btnExportOrders')?.addEventListener('click', window.exportOrders);
            document.getElementById('btnClearOrderFilters')?.addEventListener('click', window.clearAllFilters);
            document.getElementById('btnClearOrderSearch')?.addEventListener('click', window.clearSearch);
            document.getElementById('btnExportServicePurchases')?.addEventListener('click', window.exportServicePurchases);
            document.getElementById('btnClearServiceFilters')?.addEventListener('click', window.clearAllServiceFilters);
            document.getElementById('btnClearServiceSearch')?.addEventListener('click', window.clearServiceSearch);

            document.querySelectorAll('#orders [data-order-status-filter]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    window.filterOrders(btn.getAttribute('data-filter-value'));
                });
            });

            document.querySelectorAll('#orderStatsContainer [data-order-stat-filter]').forEach(function(card) {
                var activate = function() {
                    window.filterOrders(card.getAttribute('data-filter-value'));
                };
                card.addEventListener('click', activate);
                card.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        activate();
                    }
                });
            });

            var statusParam = new URLSearchParams(window.location.search).get('status');
            if (statusParam && typeof window.filterOrders === 'function') {
                window.filterOrders(statusParam);
            }

            document.querySelectorAll('#service-purchases [data-service-status-filter]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    window.filterServicePurchases(btn.getAttribute('data-filter-value'));
                });
            });

            ['paymentStatusFilter', 'paymentMethodFilter', 'dateFromFilter', 'dateToFilter'].forEach(function(id) {
                document.getElementById(id)?.addEventListener('change', window.applyFilters);
            });
            ['servicePaymentStatusFilter', 'serviceStatusFilter', 'serviceDateFromFilter', 'serviceDateToFilter'].forEach(function(id) {
                document.getElementById(id)?.addEventListener('change', window.applyServiceFilters);
            });

            var searchInput = document.getElementById('orderSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(function() {
                        window.searchOrders();
                    }, 500);
                });
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        clearTimeout(searchTimeout);
                        window.searchOrders();
                    }
                });
            }

            var filterToggle = document.querySelector('[data-bs-toggle="collapse"][data-bs-target="#advancedFilters"]');
            var filterToggleIcon = document.getElementById('filterToggleIcon');
            if (filterToggle && filterToggleIcon) {
                filterToggle.addEventListener('click', function() {
                    setTimeout(function() {
                        filterToggleIcon.classList.toggle('is-expanded', filterToggle.getAttribute('aria-expanded') === 'true');
                    }, 10);
                });
            }
        });

        // ========== TAB SWITCHING WITH RELOAD ==========
        
        // Store current tab and reload page for clean state
        window.setActiveTab = function(tabName) {
            var currentUrl = window.location.pathname;
            var urlParams = new URLSearchParams(window.location.search);
            urlParams.set('tab', tabName);
            // Reload page to ensure clean state
            window.location.href = currentUrl + '?' + urlParams.toString();
        };

        // Restore active tab on page load
        window.addEventListener('DOMContentLoaded', function() {
            var urlParams = new URLSearchParams(window.location.search);
            var tabParam = urlParams.get('tab');
            if (tabParam === 'service-purchases') {
