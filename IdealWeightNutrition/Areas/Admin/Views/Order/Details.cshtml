@using Microsoft.AspNetCore.Localization
@using IdealWeightNutrition.Utility
@model OrderVM

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Admin_OrderDetails"];
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var orderId = Model.OrderHeader.Id;
    var orderStatus = Model.OrderHeader.OrderStatus ?? string.Empty;
    var paymentStatus = Model.OrderHeader.PaymentStatus ?? string.Empty;
    var canCancelOrder = orderStatus != SD.StatusCancelled && orderStatus != SD.StatusShipped && orderStatus != SD.StatusDelivered;
    var canRefundOrder = paymentStatus == SD.PaymentStatusPaid && orderStatus != SD.StatusCancelled;
    var showForceComplete = orderStatus != SD.StatusDelivered && orderStatus != SD.StatusCancelled;
    var showForceCancel = orderStatus != SD.StatusCancelled;
    var timelineCurrent = orderStatus switch
    {
        SD.StatusCancelled => "cancelled",
        SD.StatusDelivered => "delivered",
        SD.StatusShipped => "shipped",
        SD.StatusInProcess => "processing",
        SD.StatusApproved or SD.StatusPaid => "approved",
        _ => "placed"
    };
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-body">
                <a asp-action="Index" class="btn btn-outline-secondary mb-4">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                    @Localizer["Admin_BackToOrdersList"]
                </a>

                <div class="admin-order-details-header">
                    <div>
                        <h1 class="admin-card-title mb-2">
                            <i class="bi bi-receipt me-2" aria-hidden="true"></i>
                            @Localizer["Admin_Order"] #@orderId
                        </h1>
                        <p class="admin-order-meta">
                            <i class="bi bi-calendar3 me-2" aria-hidden="true"></i>
                            @Localizer["Admin_PlacedOn"] @Model.OrderHeader.OrderDate.ToString("MMM dd, yyyy hh:mm tt")
                        </p>
                    </div>
                    <div class="admin-order-badge-group">
                        <span class="badge bg-primary">@Model.OrderHeader.OrderStatus</span>
                        <span class="badge bg-secondary">@Model.OrderHeader.PaymentStatus</span>
                    </div>
                </div>

                <nav class="admin-status-timeline" aria-label="@Localizer["Admin_OrderTimeline"]">
                    <span class="admin-status-step @(timelineCurrent == "placed" ? "is-current" : "")">@Localizer["Admin_OrderPlaced"]</span>
                    <span class="admin-status-step @(timelineCurrent == "approved" ? "is-current" : "")">@Localizer["Approved"]</span>
                    <span class="admin-status-step @(timelineCurrent == "processing" ? "is-current" : "")">@Localizer["Processing"]</span>
                    <span class="admin-status-step @(timelineCurrent == "shipped" ? "is-current" : "")">@Localizer["Shipped"]</span>
                    <span class="admin-status-step @(timelineCurrent == "delivered" ? "is-current" : "")">@Localizer["Delivered"]</span>
                    @if (timelineCurrent == "cancelled")
                    {
                        <span class="admin-status-step is-current">@Localizer["Cancelled"]</span>
                    }
                </nav>

                <div class="row g-4 mb-4">
                    <div class="col-lg-4">
                        <section class="admin-form-section-card">
                            <h2>@Localizer["Admin_CustomerInformation"]</h2>
                            <dl class="admin-details-list">
                                <dt>@Localizer["Admin_Name"]</dt>
                                <dd>@Model.OrderHeader.Name</dd>
                                <dt>@Localizer["Admin_Email"]</dt>
                                <dd>
                                    @if (Model.OrderHeader.IsGuestOrder || Model.OrderHeader.ApplicationUser == null)
                                    {
                                        @(Model.OrderHeader.Email ?? Localizer["NA"])
                                        @if (Model.OrderHeader.IsGuestOrder)
                                        {
                                            <span class="badge bg-info ms-2">@Localizer["Admin_Guest"]</span>
                                        }
                                    }
                                    else
                                    {
                                        @Model.OrderHeader.ApplicationUser.Email
                                    }
                                </dd>
                                <dt>@Localizer["Admin_Phone"]</dt>
                                <dd>@Model.OrderHeader.PhoneNumber</dd>
                            </dl>
                        </section>
                    </div>
                    <div class="col-lg-4">
                        <section class="admin-form-section-card">
                            <h2>@Localizer["Admin_ShippingInformation"]</h2>
                            <dl class="admin-details-list">
                                <dt>@Localizer["Admin_Address"]</dt>
                                <dd>@Model.OrderHeader.StreetAddress</dd>
                                <dt>@Localizer["Admin_City"]</dt>
                                <dd>@Model.OrderHeader.City</dd>
                                <dt>@Localizer["Admin_State"]</dt>
                                <dd>@Model.OrderHeader.State</dd>
                                <dt>@Localizer["Admin_PostalCode"]</dt>
                                <dd>@Model.OrderHeader.PostalCode</dd>
                            </dl>
                        </section>
                    </div>
                    <div class="col-lg-4">
                        <section class="admin-form-section-card">
                            <h2>@Localizer["Admin_OrderSummary"]</h2>
                            <dl class="admin-details-list">
                                <dt>@Localizer["Admin_OrderDate"]</dt>
                                <dd>@Model.OrderHeader.OrderDate.ToString("MMM dd, yyyy")</dd>
                                @if (Model.OrderHeader.ShippingDate != DateTime.MinValue)
                                {
                                    <dt>@Localizer["Admin_ShippingDate"]</dt>
                                    <dd>@Model.OrderHeader.ShippingDate.ToString("MMM dd, yyyy")</dd>
                                }
                                <dt>@Localizer["Admin_OrderTotal"]</dt>
                                <dd>@Html.Raw(currencySymbol) @Model.OrderHeader.OrderTotal.ToString("N2")</dd>
                            </dl>
                        </section>
                    </div>
                </div>

                <section class="admin-form-section-card mb-4">
                    <h2>@Localizer["Admin_PaymentDetails"]</h2>
                    <dl class="admin-details-list">
                        <dt>@Localizer["Admin_PaymentStatus"]</dt>
                        <dd>@Model.OrderHeader.PaymentStatus</dd>
                        @if (!string.IsNullOrEmpty(Model.OrderHeader.PaymentMethod))
                        {
                            <dt>@Localizer["PaymentMethod"]</dt>
                            <dd class="text-break">@Model.OrderHeader.PaymentMethod</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.OrderHeader.SessionId))
                        {
                            <dt>@Localizer["Admin_SessionID"]</dt>
                            <dd class="text-break">@Model.OrderHeader.SessionId</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.OrderHeader.PaymentIntentId))
                        {
                            <dt>@Localizer["Admin_PaymentIntentID"]</dt>
                            <dd class="text-break">@Model.OrderHeader.PaymentIntentId</dd>
                        }
                        @if (Model.OrderHeader.PaymentDate != DateTime.MinValue)
                        {
                            <dt>@Localizer["Admin_PaymentDate"]</dt>
                            <dd>@Model.OrderHeader.PaymentDate.ToString("MMM dd, yyyy")</dd>
                        }
                    </dl>
                </section>

                <section class="admin-form-section-card mb-4">
                    <h2>@Localizer["Admin_OrderItems"]</h2>
                    <div class="table-responsive">
                        <table class="table order-items-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Admin_Product"]</th>
                                    <th scope="col" class="text-center">@Localizer["Admin_Quantity"]</th>
                                    <th scope="col" class="text-end">@Localizer["Admin_Price"]</th>
                                    <th scope="col" class="text-end">@Localizer["Admin_Total"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetail)
                                {
                                    <tr>
                                        <td>
                                            <div class="admin-product-row">
                                                <img src="@detail.Product.ImageUrl" alt="@detail.Product.Title" width="64" height="64" loading="lazy" />
                                                <div>
                                                    <div class="fw-semibold">@detail.Product.Title</div>
                                                    <div class="text-muted small">@detail.Product.Author</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@detail.Count</td>
                                        <td class="text-end">@Html.Raw(currencySymbol) @detail.Price.ToString("N2")</td>
                                        <td class="text-end">@Html.Raw(currencySymbol) @((detail.Price * detail.Count).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end fw-semibold">@Localizer["Admin_OrderTotal"]</td>
                                    <td class="text-end fw-bold">@Html.Raw(currencySymbol) @Model.OrderHeader.OrderTotal.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>

                <!-- Editable Information (For Admin) -->
                <form method="post">
                    <input hidden asp-for="OrderHeader.Id" />
                    
                    <div class="edit-form-section">
                        <h3>
                            <i class="bi bi-pencil-square me-2"></i>
                            @Localizer["Admin_UpdateOrderInformation"]
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="OrderHeader.Name" class="form-label">
                                    <i class="bi bi-person me-2"></i>@Localizer["Admin_CustomerName"]
                                </label>
                                <input asp-for="OrderHeader.Name" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.PhoneNumber" class="form-label">
                                    <i class="bi bi-telephone me-2"></i>@Localizer["Admin_PhoneNumber"]
                                </label>
                                <input asp-for="OrderHeader.PhoneNumber" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.StreetAddress" class="form-label">
                                    <i class="bi bi-house me-2"></i>@Localizer["Admin_StreetAddress"]
                                </label>
                                <input asp-for="OrderHeader.StreetAddress" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.City" class="form-label">
                                    <i class="bi bi-geo-alt me-2"></i>@Localizer["Admin_City"]
                                </label>
                                <input asp-for="OrderHeader.City" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.State" class="form-label">
                                    <i class="bi bi-map me-2"></i>@Localizer["Admin_State"]
                                </label>
                                <input asp-for="OrderHeader.State" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.PostalCode" class="form-label">
                                    <i class="bi bi-mailbox me-2"></i>@Localizer["Admin_PostalCode"]
                                </label>
                                <input asp-for="OrderHeader.PostalCode" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.Carrier" class="form-label">
                                    <i class="bi bi-truck me-2"></i>@Localizer["Admin_Carrier"]
                                </label>
                                <input asp-for="OrderHeader.Carrier" class="form-control" placeholder="@Localizer["Admin_CarrierPlaceholder"]" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.TrackingNumber" class="form-label">
                                    <i class="bi bi-upc-scan me-2"></i>@Localizer["Admin_TrackingNumber"]
                                </label>
                                <input asp-for="OrderHeader.TrackingNumber" class="form-control" placeholder="@Localizer["Admin_TrackingNumberPlaceholder"]" />
                            </div>
                        </div>
                        
                        <div class="text-end mt-4">
                            <button type="submit" asp-action="UpdateOrderDetail" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                                @Localizer["Admin_UpdateOrderDetails"]
                            </button>
                        </div>
                    </div>
                </form>

              
                <!-- Manual Payment Reconciliation (Admin Tools) -->
                <div class="payment-reconciliation-section">
                    <h2 class="h5 mb-2">
                        <i class="bi bi-shield-check me-2" aria-hidden="true"></i>
                        @Localizer["Admin_PaymentReconciliation"]
                    </h2>
                    <p class="text-muted mb-3">
                        @Localizer["Admin_PaymentReconciliationDescription"]
                    </p>

                    <div class="admin-header-actions mb-3">
                        <form method="post" asp-action="RecheckPaymentStatus" class="d-inline">
                            <input type="hidden" name="id" value="@orderId" />
                            <button type="submit" class="btn btn-outline-primary" title="@Localizer["Admin_RecheckPaymentStatusTooltip"]">
                                <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>
                                @Localizer["Admin_RecheckPaymentStatus"]
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-secondary" id="btnViewAuditLog" title="@Localizer["Admin_ViewAuditLogTooltip"]">
                            <i class="bi bi-journal-text me-2" aria-hidden="true"></i>
                            @Localizer["Admin_ViewAuditLog"]
                        </button>
                    </div>

                    <div id="auditLogSection" class="audit-log-section d-none">
                        <h4>
                            <i class="bi bi-clock-history"></i>
                            @Localizer["Admin_AuditTrail"]
                        </h4>
                        <div id="auditLogContent">
                            <p class="text-center text-muted">
                                <i class="bi bi-hourglass-split"></i> @Localizer["Common_Loading"]
                            </p>
                        </div>
                    </div>
                </div>
                <div class="form-actions form-actions--sticky">
                    @if (Model.OrderHeader.OrderStatus == SD.StatusPaid || Model.OrderHeader.OrderStatus == SD.StatusApproved)
                    {
                        <form method="post" asp-action="StartProcessing" class="d-inline">
                            <input type="hidden" name="id" value="@orderId" />
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-play-circle me-2" aria-hidden="true"></i>
                                @Localizer["Admin_StartProcessing"]
                            </button>
                        </form>
                    }
                    @if (Model.OrderHeader.OrderStatus == SD.StatusInProcess)
                    {
                        <form method="post" asp-action="ShipOrder" class="d-inline">
                            <input type="hidden" name="id" value="@orderId" />
                            <input type="hidden" name="carrier" value="@Model.OrderHeader.Carrier" />
                            <input type="hidden" name="trackingNumber" value="@Model.OrderHeader.TrackingNumber" />
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-truck me-2" aria-hidden="true"></i>
                                @Localizer["Admin_ShipOrder"]
                            </button>
                        </form>
                    }
                    @if (Model.OrderHeader.OrderStatus == SD.StatusShipped)
                    {
                        <form method="post" asp-action="MarkAsDelivered" class="d-inline">
                            <input type="hidden" name="id" value="@orderId" />
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
                                @Localizer["Admin_MarkAsDelivered"]
                            </button>
                        </form>
                    }
                    @if (canCancelOrder)
                    {
                        <button type="button" class="btn btn-outline-danger" id="btnCancelOrder">
                            <i class="bi bi-x-circle me-2" aria-hidden="true"></i>
                            @Localizer["Admin_CancelOrder"]
                        </button>
                    }
                    @if (canRefundOrder)
                    {
                        <button type="button" class="btn btn-outline-warning" id="btnRefundOrder">
                            <i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>
                            @Localizer["Admin_RefundOrder"]
                        </button>
                    }
                    @if (showForceComplete)
                    {
                        <button type="button" class="btn btn-outline-primary" id="btnForceComplete">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                            @Localizer["Admin_ForceComplete"]
                        </button>
                    }
                    @if (showForceCancel)
                    {
                        <button type="button" class="btn btn-outline-danger" id="btnForceCancel">
                            <i class="bi bi-slash-circle me-2" aria-hidden="true"></i>
                            @Localizer["Admin_ForceCancelTitle"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('btnViewAuditLog')?.addEventListener('click', function () {
                loadAuditLog(@orderId);
            });
            document.getElementById('btnCancelOrder')?.addEventListener('click', function () {
                cancelOrder(@orderId);
            });
            document.getElementById('btnRefundOrder')?.addEventListener('click', function () {
                showRefundModal(@orderId, @Model.OrderHeader.OrderTotal.ToString(System.Globalization.CultureInfo.InvariantCulture));
            });
            document.getElementById('btnForceComplete')?.addEventListener('click', function () {
                showForceCompleteModal(@orderId);
            });
            document.getElementById('btnForceCancel')?.addEventListener('click', function () {
                showForceCancelModal(@orderId);
            });
        });
    </script>
    <script>
        const orderNumberLabel = '@Localizer["Admin_Order"] #@orderId';
        const swalConfig = {
            customClass: {
                popup: 'swal2-enhanced',
                title: 'swal2-title-enhanced',
                confirmButton: 'swal2-confirm-enhanced',
                cancelButton: 'swal2-cancel-enhanced'
            },
            buttonsStyling: true,
            allowOutsideClick: false,
            allowEscapeKey: true,
            showClass: {
                popup: 'swal2-show'
            },
            hideClass: {
                popup: 'swal2-hide'
            }
        };
        
        // Cancel Order with AJAX and SweetAlert
        function cancelOrder(orderId) {
            Swal.fire({
                title: '<i class="bi bi-exclamation-triangle-fill" style="color: #f59e0b; font-size: 3rem; display: block; margin-bottom: 1rem;"></i>' + 
                       '<span style="display: block; margin-top: 0.5rem;">@Localizer["Admin_CancelOrderTitle"]</span>',
                html: '<p class="mb-0">@Localizer["Admin_CancelOrderConfirm"]</p><p class="mt-2 fw-bold">' + orderNumberLabel + '</p>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '<i class="bi bi-check-circle me-2"></i>@Localizer["Common_YesCancel"]',
                cancelButtonText: '<i class="bi bi-x-circle me-2"></i>@Localizer["Common_No"]',
                showLoaderOnConfirm: true,
                backdrop: true,
                allowOutsideClick: () => !Swal.isLoading(),
                ...swalConfig,
                preConfirm: () => {
                    return fetch('@Url.Action("CancelOrder", "Order")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        body: `id=${orderId}&__RequestVerificationToken=${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}`
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        // Return data even if success is false, so we can handle it in the then block
                        return data;
                    })
                    .catch(error => {
                        Swal.showValidationMessage(error.message || 'Request failed');
                        return Promise.reject(error);
                    });
                }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    if (result.value.success) {
                        Swal.fire({
                            title: '<i class="bi bi-check-circle-fill" style="color: #10b981; font-size: 4rem; display: block; margin-bottom: 1rem;"></i>' +
                                   '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">Success!</span>',
                            html: '<div style="text-align: center; padding: 1rem 0;"><p style="color: #4b5563; font-size: 1.063rem; line-height: 1.6;">' + 
                                  (result.value.message || 'Order cancelled successfully') + '</p></div>',
                            icon: 'success',
                            confirmButtonColor: '#10b981',
                            confirmButtonText: '<i class="bi bi-check-lg me-2"></i>OK',
                            timer: 2000,
                            timerProgressBar: true,
                            ...swalConfig
                        }).then(() => {
                            // Reload page to show updated status
                            window.location.reload();
                        });
                    } else {
                        // Show error if cancellation failed
                        Swal.fire({
                            title: '<i class="bi bi-x-circle-fill" style="color: #ef4444; font-size: 4rem; display: block; margin-bottom: 1rem;"></i>' +
                                   '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">Cancellation Failed</span>',
                            html: '<div style="text-align: left; padding: 1rem 0;"><p style="color: #4b5563; font-size: 1.063rem; line-height: 1.6;">' + 
                                  (result.value.message || 'Order cancellation failed. Please verify in payment gateway dashboard.') + '</p></div>',
                            icon: 'error',
                            confirmButtonColor: '#ef4444',
                            confirmButtonText: '<i class="bi bi-x-lg me-2"></i>Close',
                            ...swalConfig
                        });
                    }
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    // User cancelled, do nothing
                }
            }).catch((error) => {
                // Handle any unexpected errors
                Swal.fire({
                    title: '<i class="bi bi-exclamation-triangle-fill" style="color: #ef4444; font-size: 4rem; display: block; margin-bottom: 1rem;"></i>' +
                           '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">Error</span>',
                    html: '<div style="text-align: left; padding: 1rem 0;"><p style="color: #4b5563; font-size: 1.063rem; line-height: 1.6;">' + 
                          (error.message || 'An unexpected error occurred') + '</p></div>',
                    icon: 'error',
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: '<i class="bi bi-x-lg me-2"></i>Close',
                    ...swalConfig
                });
            });
        }

        // Show Refund Modal
        function showRefundModal(orderId, orderTotal) {
            const orderTotalValue = parseFloat(orderTotal);
            const orderTotalFormatted = orderTotalValue.toFixed(2);
            const currencySymbol = '@currencySymbol';
            const orderTotalDisplay = '@Model.OrderHeader.OrderTotal.ToString("F2")';
            
            Swal.fire({
                title: '<i class="bi bi-arrow-counterclockwise" style="color: #f59e0b; font-size: 3rem; display: block; margin-bottom: 1rem;"></i>' +
                       '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">Refund Order</span>',
                html: `
                    <div class="refund-modal-content" style="text-align: left;">
                        <div style="background: #fffbeb; border-left: 4px solid #f59e0b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                            <p style="margin: 0; color: #92400e; font-size: 0.938rem;">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Order Total:</strong> <span style="color: #1f2937; font-size: 1.125rem;">${currencySymbol}${orderTotalDisplay}</span>
                            </p>
                        </div>
                        <div style="margin-bottom: 1rem;">
                            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 0.5rem; font-size: 0.938rem;">
                                <i class="bi bi-currency-dollar me-2"></i>Refund Amount <span style="color: #ef4444;">*</span>
                            </label>
                            <input type="number" id="refundAmount" class="swal2-input" 
                                   placeholder="Enter refund amount" 
                                   min="0.01" 
                                   max="${orderTotalValue}" 
                                   step="0.01" 
                                   value="${orderTotalValue}"
                                   style="width:100%; margin-top: 0;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 0.5rem; font-size: 0.938rem;">
                                <i class="bi bi-pencil-square me-2"></i>Refund Reason <span style="color: #6b7280; font-weight: 400;">(Optional)</span>
                            </label>
                            <textarea id="refundReason" class="swal2-textarea" 
                                      placeholder="Enter reason for refund (optional)" 
                                      rows="3" 
                                      style="width:100%; margin-top: 0; resize: vertical;"></textarea>
                        </div>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '<i class="bi bi-check-circle me-2"></i>Process Refund',
                cancelButtonText: '<i class="bi bi-x-circle me-2"></i>Cancel',
                showLoaderOnConfirm: true,
                backdrop: true,
                allowOutsideClick: () => !Swal.isLoading(),
                ...swalConfig,
                preConfirm: () => {
                    const refundAmount = parseFloat(document.getElementById('refundAmount').value);
                    const refundReason = document.getElementById('refundReason').value;
                    
                    if (!refundAmount || refundAmount <= 0) {
                        Swal.showValidationMessage('Refund amount must be greater than 0');
                        return false;
                    }
                    
                    if (refundAmount > orderTotalValue) {
                        Swal.showValidationMessage('Refund amount cannot exceed order total (' + currencySymbol + orderTotalFormatted + ')');
                        return false;
                    }
                    
                    return fetch('@Url.Action("RefundOrder", "Order")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        body: `id=${orderId}&refundAmount=${refundAmount}&refundReason=${encodeURIComponent(refundReason || '')}&__RequestVerificationToken=${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            throw new Error(data.message || 'Refund failed');
                        }
                        return data;
                    })
                    .catch(error => {
                        Swal.showValidationMessage(error.message || 'Request failed');
                        return Promise.reject(error);
                    });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    const isFullRefund = result.value.isFullRefund;
                    Swal.fire({
                        title: '<i class="bi bi-check-circle-fill" style="color: #10b981; font-size: 4rem; display: block; margin-bottom: 1rem;"></i>' +
                               '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">Refund Processed!</span>',
                        html: '<div style="text-align: center; padding: 1rem 0;">' +
                              '<p style="color: #4b5563; font-size: 1.063rem; line-height: 1.6; margin-bottom: 0.5rem;">' + 
                              (result.value.message || 'Refund processed successfully') + '</p>' +
                              (isFullRefund ? '<p style="color: #059669; font-weight: 600; font-size: 0.938rem; margin-top: 0.5rem;"><i class="bi bi-info-circle me-2"></i>Full refund processed</p>' : '') +
                              '</div>',
                        icon: 'success',
                        confirmButtonColor: '#10b981',
                        confirmButtonText: '<i class="bi bi-check-lg me-2"></i>OK',
                        timer: 2500,
                        timerProgressBar: true,
                        ...swalConfig
                    }).then(() => {
                        // Reload page to show updated status
                        window.location.reload();
                    });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    // User cancelled, do nothing
                }
            }).catch((error) => {
                // Handle any unexpected errors
                Swal.fire({
                    title: '<i class="bi bi-exclamation-triangle-fill" style="color: #ef4444; font-size: 4rem; display: block; margin-bottom: 1rem;"></i>' +
                           '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">Refund Failed</span>',
                    html: '<div style="text-align: left; padding: 1rem 0;"><p style="color: #4b5563; font-size: 1.063rem; line-height: 1.6;">' + 
                          (error.message || 'An unexpected error occurred while processing the refund') + '</p></div>',
                    icon: 'error',
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: '<i class="bi bi-x-lg me-2"></i>Close',
                    ...swalConfig
                });
            });
        }

        // Force Complete Modal
        function showForceCompleteModal(orderId) {
            Swal.fire({
                title: '<i class="bi bi-check-circle-fill" style="color: #10b981; font-size: 3rem; display: block; margin-bottom: 1rem;"></i>' +
                       '<span style="display: block; margin-top: 0.5rem; color: #1f2937; font-weight: 700;">@Localizer["Admin_ForceCompleteTitle"]</span>',
                html: `
                    <div style="text-align: left; padding: 1rem 0;">
                        <div style="background: #ecfdf5; border-left: 4px solid #10b981; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                            <p style="margin: 0; color: #065f46; font-size: 0.938rem;">
                                <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["Admin_ForceCompleteWarning"]
                            </p>
                            <p class="mb-0 fw-bold">${orderNumberLabel}</p>
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 0.5rem; font-size: 0.938rem;">
                                <i class="bi bi-pencil-square me-2"></i>@Localizer["Admin_ReasonRequired"] <span style="color: #ef4444;">*</span>
                            </label>
                            <textarea id="forceCompleteReason" class="swal2-textarea" 
                                      placeholder="@Localizer["Admin_ReasonRequired"]" 
                                      rows="4" 
                                      style="width:100%; resize: vertical;"></textarea>
                        </div>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '<i class="bi bi-check-circle me-2"></i>@Localizer["Common_Confirm"]',
                cancelButtonText: '<i class="bi bi-x-circle me-2"></i>@Localizer["Common_Cancel"]',
                backdrop: true,
                ...swalConfig,
                preConfirm: () => {
                    const reason = document.getElementById('forceCompleteReason').value;
                    if (!reason || reason.trim() === '') {
                        Swal.showValidationMessage('@Localizer["Admin_PleaseProvideReason"]');
                        return false;
                    }
                    return reason;
                }
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("ForceComplete", "Order")';

                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = orderId;
                    form.appendChild(idInput);

                    const reasonInput = document.createElement('input');
                    reasonInput.type = 'hidden';
                    reasonInput.name = 'reason';
                    reasonInput.value = result.value;
                    form.appendChild(reasonInput);

                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) {
                        form.appendChild(token.cloneNode());
                    }

                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }

