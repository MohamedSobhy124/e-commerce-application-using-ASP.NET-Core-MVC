        // Load Audit Log via AJAX
        function loadAuditLog(orderId) {
            const section = document.getElementById('auditLogSection');
            const content = document.getElementById('auditLogContent');

            section.classList.remove('d-none');
            content.innerHTML = '<p class="text-center text-muted"><i class="bi bi-hourglass-split"></i> @Localizer["Common_Loading"]</p>';

            fetch(`@Url.Action("GetAuditLog", "Order")?id=${orderId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.logs && data.logs.length > 0) {
                        let html = '<div class="audit-log-table-wrapper"><table class="table table-striped table-hover">';
                        html += '<thead><tr>';
                        html += '<th>@Localizer["Admin_AuditDate"]</th>';
                        html += '<th>@Localizer["Admin_AuditAction"]</th>';
                        html += '<th>@Localizer["Admin_AuditDetails"]</th>';
                        html += '<th>@Localizer["Admin_AuditUser"]</th>';
                        html += '<th>@Localizer["Admin_AuditStatusChange"]</th>';
                        html += '</tr></thead><tbody>';

                        data.logs.forEach(log => {
                            html += '<tr>';
                            html += `<td><small>${new Date(log.actionDate).toLocaleString()}</small></td>`;
                            html += `<td><span class="badge bg-primary">${log.action}</span></td>`;
                            html += `<td><small>${log.actionDetails || '-'}</small></td>`;
                            html += `<td><small>${log.performedByUserEmail || log.performedByUserId || 'System'}</small></td>`;
                            html += `<td><small>`;
                            
                            // Handle payment status changes - check both camelCase and PascalCase
                            const oldPaymentStatus = log.oldPaymentStatus || log.OldPaymentStatus || null;
                            const newPaymentStatus = log.newPaymentStatus || log.NewPaymentStatus || null;
                            
                            // Also check for order status changes
                            const oldOrderStatus = log.oldOrderStatus || log.OldOrderStatus || null;
                            const newOrderStatus = log.newOrderStatus || log.NewOrderStatus || null;
                            
                            let statusChanges = [];
                            
                            // Payment status change
                            if (oldPaymentStatus && newPaymentStatus && oldPaymentStatus !== newPaymentStatus) {
                                statusChanges.push(`<span class="text-muted">Payment:</span> <span class="text-danger">${oldPaymentStatus}</span> → <span class="text-success">${newPaymentStatus}</span>`);
                            }
                            
                            // Order status change
                            if (oldOrderStatus && newOrderStatus && oldOrderStatus !== newOrderStatus) {
                                statusChanges.push(`<span class="text-muted">Order:</span> <span class="text-danger">${oldOrderStatus}</span> → <span class="text-success">${newOrderStatus}</span>`);
                            }
                            
                            if (statusChanges.length > 0) {
                                html += statusChanges.join('<br>');
                            } else {
                                html += '-';
                            }
                            
                            html += `</small></td>`;
                            html += '</tr>';
                        });

                        html += '</tbody></table></div>';
                        content.innerHTML = html;
                    } else {
                        content.innerHTML = '<p class="text-center text-muted"><i class="bi bi-info-circle"></i> @Localizer["Admin_NoAuditLogs"]</p>';
                    }
                })
                .catch(error => {
                    console.error('Error loading audit log:', error);
                    content.innerHTML = '<p class="text-center text-danger"><i class="bi bi-exclamation-triangle"></i> @Localizer["Common_ErrorLoading"]</p>';
                });
        }
    </script>
