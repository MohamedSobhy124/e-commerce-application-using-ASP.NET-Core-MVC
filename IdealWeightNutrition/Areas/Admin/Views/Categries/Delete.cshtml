@model IdealWeightNutrition.Models.Categry

@{
    ViewData["Title"] = Localizer["DeleteCategory"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["DeleteCategory"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="alert alert-warning">
                    @Localizer["AreYouSureDeleteCategory"] <strong>@Model.Name</strong>
                </div>
                <dl class="admin-details-list">
                    <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd>@Model.Name</dd>
                    <dt>@Html.DisplayNameFor(model => model.NameAr)</dt>
                    <dd dir="rtl">@Model.NameAr</dd>
                    <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                    <dd>@Model.Description</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-2" aria-hidden="true"></i>@Localizer["Delete"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
