@{
    ViewData["Title"] = Localizer["CreateAdminUser"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@Localizer["CreateAdminUser"]</h1>
            </div>

            <div class="admin-form-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                    <strong>@Localizer["Note"]:</strong> @Localizer["InternalUserRegistrationHeaderMassage"]
                </div>

                <form method="post" asp-action="CreateAdminUser">
                    @Html.AntiForgeryToken()

                    <section class="admin-form-section">
                        <h2>@Localizer["Basics"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label class="admin-form-label" for="email">@Localizer["Email"] <span class="text-danger">*</span></label>
                                    <input type="email" id="email" name="email" class="admin-form-control" required autocomplete="email" placeholder="@Localizer["EnterEmailAddress"]" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label class="admin-form-label" for="name">@Localizer["FullName"] <span class="text-danger">*</span></label>
                                    <input type="text" id="name" name="name" class="admin-form-control" required autocomplete="name" placeholder="@Localizer["FullName"]" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label class="admin-form-label" for="password">@Localizer["Password"] <span class="text-danger">*</span></label>
                                    <input type="password" id="password" name="password" class="admin-form-control" required autocomplete="new-password" minlength="6" />
                                    <small class="form-text text-muted">@Localizer["MinimumPasswordCharactersHint"]</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label class="admin-form-label" for="phoneNumber">@Localizer["Phone"]</label>
                                    <input type="tel" id="phoneNumber" name="phoneNumber" class="admin-form-control" autocomplete="tel" placeholder="@Localizer["PhonePlaceholder"]" />
                                </div>
                            </div>
                            <div class="col-md-6" id="companyField" hidden>
                                <div class="admin-form-group">
                                    <label class="admin-form-label" for="companyId">@Localizer["Company"] <span class="text-danger">*</span></label>
                                    <select id="companyId" name="companyId" class="admin-form-control">
                                        <option value="">@Localizer["SelectCompanyPlaceholder"]</option>
                                        @foreach (var company in ViewBag.Companies as IEnumerable<SelectListItem>)
                                        {
                                            <option value="@company.Value">@company.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-person-plus me-2" aria-hidden="true"></i>@Localizer["CreateAccount"]
                        </button>
                    </div>
                </form>

                <div class="alert alert-success mt-4 mb-0">
                    <i class="bi bi-shield-check me-2" aria-hidden="true"></i>
                    <strong>@Localizer["Note"]:</strong> @Localizer["InternalUserRegistrationFooterMassage"]
                </div>
            </div>
        </div>
    </div>
</div>
