@model IEnumerable<IdealWeightNutrition.Models.Company>

@{
    ViewData["Title"] = Localizer["CompaniesList"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Localizer["CompaniesList"]</h1>
            </div>
            <div class="admin-card-body">
                <div class="admin-toolbar">
                    <p class="admin-toolbar-meta mb-0">@Localizer["Companies"]</p>
                    <a asp-action="UpSert" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                        @Localizer["CreateNewCompany"]
                    </a>
                </div>
                <div class="table-responsive admin-table-wrapper">
                    <table id="tblData"
                           class="table table-bordered table-striped table-hover"
                           data-label-edit="@Localizer["Edit"]"
                           data-label-delete="@Localizer["Delete"]"
                           data-confirm-title="@Localizer["AreYouSure"]"
                           data-confirm-text="@Localizer["AreYouSureDeleteCompany"]"
                           data-confirm-yes="@Localizer["YesDeleteIt"]"
                           data-empty="@Localizer["NoCompaniesYet"]">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["ID"]</th>
                                <th scope="col">@Localizer["Name"]</th>
                                <th scope="col">@Localizer["PhoneNumber"]</th>
                                <th scope="col">@Localizer["City"]</th>
                                <th scope="col">@Localizer["State"]</th>
                                <th scope="col">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/Company.js" asp-append-version="true"></script>
}
