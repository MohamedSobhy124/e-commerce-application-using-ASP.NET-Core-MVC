@model IdealWeightNutrition.Models.Company

@{
    ViewData["Title"] = Localizer["CompanyDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h1 class="admin-card-title">@Model.Name</h1>
            </div>
            <div class="admin-card-body">
                <dl class="admin-details-list">
                    <dt>@Localizer["Name"]</dt>
                    <dd>@Model.Name</dd>
                    <dt>@Localizer["PhoneNumber"]</dt>
                    <dd>@Model.PhoneNumber</dd>
                    <dt>@Localizer["StreetAddress"]</dt>
                    <dd>@Model.StreetAddress</dd>
                    <dt>@Localizer["City"]</dt>
                    <dd>@Model.City</dd>
                    <dt>@Localizer["State"]</dt>
                    <dd>@Model.State</dd>
                    <dt>@Localizer["PostalCode"]</dt>
                    <dd>@Model.PostalCode</dd>
                </dl>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                    </a>
                    <a asp-action="UpSert" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>@Localizer["Edit"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
