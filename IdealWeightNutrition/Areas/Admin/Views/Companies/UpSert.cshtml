@model Company

@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? Localizer["EditCompany"] : Localizer["CreateCompany"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">@(isEdit ? Localizer["EditCompany"] : Localizer["CreateCompany"])</h1>
            </div>
            <div class="admin-form-body">
                <form asp-action="UpSert" method="post">
                    <input hidden asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <section class="admin-form-section">
                        <h2>@Localizer["CompanyDetails"]</h2>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="Name" class="admin-form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="admin-form-control" autocomplete="organization" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="admin-form-group">
                                    <label asp-for="PhoneNumber" class="admin-form-label">@Localizer["PhoneNumber"]</label>
                                    <input asp-for="PhoneNumber" class="admin-form-control" autocomplete="tel" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="admin-form-group">
                                    <label asp-for="StreetAddress" class="admin-form-label">@Localizer["StreetAddress"]</label>
                                    <textarea asp-for="StreetAddress" class="admin-form-control" rows="3" autocomplete="street-address"></textarea>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="admin-form-group">
                                    <label asp-for="City" class="admin-form-label">@Localizer["City"]</label>
                                    <input asp-for="City" class="admin-form-control" autocomplete="address-level2" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="admin-form-group">
                                    <label asp-for="State" class="admin-form-label">@Localizer["State"]</label>
                                    <input asp-for="State" class="admin-form-control" autocomplete="address-level1" />
                                    <span asp-validation-for="State" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="admin-form-group">
                                    <label asp-for="PostalCode" class="admin-form-label">@Localizer["PostalCode"]</label>
                                    <input asp-for="PostalCode" class="admin-form-control" autocomplete="postal-code" />
                                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>@Localizer["BackToList"]
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@(isEdit ? Localizer["Save"] : Localizer["Create"])
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <partial name="_ValidationScriptsPartial" />
}
