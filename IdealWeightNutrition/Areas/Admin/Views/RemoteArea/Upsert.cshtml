@model IdealWeightNutrition.Models.RemoteArea
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Model.Id == 0 ? Localizer["CreateRemoteArea"].Value : Localizer["EditRemoteArea"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isEdit = Model.Id != 0;
    var cityName = ViewData["CityName"]?.ToString() ?? Localizer["Unknown"].Value;
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h1 class="admin-form-title">
                    <i class="bi bi-@(isEdit ? "pencil" : "plus-circle")-fill me-3"></i>
                    @(isEdit ? Localizer["EditRemoteArea"] : Localizer["CreateRemoteArea"])
                </h1>
                <div class="text-muted">
                    <i class="bi bi-building me-2"></i>
                    @Localizer["City"]: <strong>@cityName</strong>
                </div>
            </div>

            <div class="admin-form-body">
                <form asp-action="Upsert" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                    <input asp-for="Id" hidden />

                    <section class="admin-form-section">
                        <h2>@Localizer["RemoteAreaInformation"]</h2>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label asp-for="CityId" class="admin-form-label">
                                            <i class="bi bi-building me-2"></i>
                                            @Localizer["City"] <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="CityId" asp-items="ViewBag.CityId" class="admin-form-control">
                                            <option value="">-- @Localizer["SelectCity"] --</option>
                                        </select>
                                        <span asp-validation-for="CityId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label asp-for="Name" class="admin-form-label">
                                            <i class="bi bi-geo-alt me-2"></i>
                                            @Localizer["AreaNameEnglish"] <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Name" class="admin-form-control" placeholder="e.g., Liwa" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label asp-for="NameAr" class="admin-form-label">
                                            <i class="bi bi-geo-alt me-2"></i>
                                            @Localizer["AreaNameArabic"]
                                        </label>
                                        <input asp-for="NameAr" class="admin-form-control" dir="rtl" placeholder="ليوا" />
                                        <span asp-validation-for="NameAr" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                    </section>

                    <section class="admin-form-section">
                        <h2>@Localizer["DeliverySettings"]</h2>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label asp-for="DeliveryCharge" class="admin-form-label">
                                            <i class="bi bi-currency-dollar me-2"></i>
                                            @Localizer["DeliveryChargeAED"] <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">AED</span>
                                            <input asp-for="DeliveryCharge" type="number" step="0.01" min="0" class="admin-form-control" placeholder="0.00" />
                                        </div>
                                        <small class="form-text text-muted mt-2">
                                            <i class="bi bi-info-circle me-1"></i>
                                            @Localizer["ChargeOverridesCityDefault"]
                                        </small>
                                        <span asp-validation-for="DeliveryCharge" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label asp-for="DisplayOrder" class="admin-form-label">
                                            <i class="bi bi-sort-numeric-down me-2"></i>
                                            @Localizer["DisplayOrder"]
                                        </label>
                                        <input asp-for="DisplayOrder" type="number" class="admin-form-control" placeholder="0" />
                                        <small class="form-text text-muted mt-2">
                                            <i class="bi bi-info-circle me-1"></i>
                                            @Localizer["LowerNumbersAppearFirst"]
                                        </small>
                                        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <div class="form-check form-switch">
                                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                                            <label class="form-check-label" for="isActiveSwitch">
                                                <i class="bi bi-toggle-on me-2"></i>
                                                @Localizer["ActiveArea"]
                                            </label>
                                        </div>
                                        <small class="form-text text-muted mt-2">
                                            <i class="bi bi-info-circle me-1"></i>
                                            @Localizer["InactiveAreasWontAppear"]
                                        </small>
                                    </div>
                                </div>
                            </div>
                    </section>

                    <div class="form-actions">
                        <a asp-controller="City" asp-action="Upsert" asp-route-id="@Model.CityId" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                            @Localizer["BackToCity"]
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                            @(isEdit ? Localizer["Update"] : Localizer["Create"])
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}

