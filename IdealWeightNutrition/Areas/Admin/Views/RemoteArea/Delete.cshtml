@model IdealWeightNutrition.Models.RemoteArea
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["DeleteRemoteArea"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-exclamation-triangle-fill me-3 text-warning"></i>
                    @Localizer["DeleteRemoteArea"]
                </h2>
            </div>

            <div class="admin-card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>@Localizer["Warning"]</strong> @Localizer["AreYouSureDeleteArea"]
                </div>

                <div class="card">
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">@Localizer["AreaNameEnglish"]:</dt>
                            <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                            @if (!string.IsNullOrEmpty(Model.NameAr))
                            {
                                <dt class="col-sm-3">@Localizer["AreaNameArabic"]:</dt>
                                <dd class="col-sm-9" dir="rtl"><strong>@Model.NameAr</strong></dd>
                            }

                            <dt class="col-sm-3">@Localizer["City"]:</dt>
                            <dd class="col-sm-9">@(Model.City?.Name ?? Localizer["Unknown"].Value)</dd>

                            <dt class="col-sm-3">@Localizer["DeliveryCharge"]:</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-success">@Model.DeliveryCharge.ToString("N2") AED</span>
                            </dd>

                            <dt class="col-sm-3">@Localizer["Status"]:</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-@(Model.IsActive ? "success" : "secondary")">
                                    @(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])
                                </span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-actions">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="bi bi-trash me-2"></i>
                            @Localizer["Delete"]
                        </button>
                        <a asp-controller="City" asp-action="Upsert" asp-route-id="@Model.CityId" class="btn btn-secondary btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>
                            @Localizer["Cancel"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .form-actions {
        display: flex;
        gap: 1rem;
        padding: 1.5rem 0;
    }
</style>
