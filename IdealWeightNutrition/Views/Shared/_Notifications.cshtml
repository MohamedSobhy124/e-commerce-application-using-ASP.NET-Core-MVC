@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer

@if (TempData["success"] != null)
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script type="text/javascript">
        toastr.success('@TempData["success"]');
    </script>

}
@if (TempData["error"] != null)
{
        var errorMessage = TempData["error"].ToString();
        
        // More specific payment error detection - only treat as payment error if:
        // 1. The message explicitly mentions payment
        // 2. OR the path is PaymentSuccess/PaymentCallback AND not a review-related message
        var isReviewError = errorMessage.Contains("review", StringComparison.OrdinalIgnoreCase) || 
                           errorMessage.Contains("تقييم") || 
                           errorMessage.Contains("مراجعة");
        
        var isPaymentError = !isReviewError && (
                            errorMessage.Contains("Payment", StringComparison.OrdinalIgnoreCase) || 
                            errorMessage.Contains("PaymentNotSuccessful") || 
                            errorMessage.Contains("لم يتم الدفع") || 
                            errorMessage.Contains("اشتراكك") ||
                            errorMessage.Contains("فشل الدفع") ||
                            Context.Request.Path.Value.Contains("PaymentSuccess") ||
                            Context.Request.Path.Value.Contains("PaymentCallback"));
    
    @if (isPaymentError)
    {
        <!-- Use SweetAlert2 for payment errors -->
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" crossorigin="anonymous"></script>
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    icon: 'error',
                    title: '@(Localizer["PaymentFailed"]?.Value ?? "Payment Failed")',
                    text: '@Html.Raw(errorMessage)',
                    confirmButtonText: '@(Localizer["OK"]?.Value ?? "OK")',
                    confirmButtonColor: '#dc2626',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });
            });
        </script>
    }
    else
    {
        <!-- Use toastr for other errors -->
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
        <script type="text/javascript">
            toastr.error('@Html.Raw(errorMessage)');
        </script>
    }
}