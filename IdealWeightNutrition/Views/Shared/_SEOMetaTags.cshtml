@using IdealWeightNutrition.Models.ViewModels
@using IdealWeightNutrition.Utility
@using Microsoft.AspNetCore.Localization
@inject IConfiguration Configuration
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    
    var seo = ViewData["SEO"] as SEOViewModel;
    var baseUrl = Configuration["SiteSettings:BaseUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host;
    var siteName = Configuration["SiteSettings:SiteName"] ?? "Ideal Weight Nutrition";
    var siteDescription = currentCulture == "ar" 
        ? (Configuration["SiteSettings:SiteDescriptionAr"] ?? "مكملات صحية ولياقة بدنية متميزة في الإمارات")
        : (Configuration["SiteSettings:SiteDescription"] ?? "Premium health and fitness supplements in UAE");
    
    var pageTitle = seo?.Title ?? ViewData["Title"]?.ToString() ?? (currentCulture == "ar" ? "الرئيسية" : "Home");
    var pageDescription = seo?.Description ?? ViewData["Description"]?.ToString() ?? siteDescription;
    var pageKeywords = seo?.Keywords ?? ViewData["Keywords"]?.ToString() ?? (currentCulture == "ar" ? "مكملات غذائية, صحة, لياقة, وزن مثالي, الإمارات" : "nutrition supplements, health, fitness, ideal weight, UAE");
    var pageImage = seo?.ImageUrl ?? ViewData["Image"]?.ToString() ?? baseUrl + "/Images/Products/logo_white_bg.png";
    var canonicalUrl = seo?.CanonicalUrl ?? (baseUrl + Context.Request.Path + Context.Request.QueryString);
    
    // Ensure baseUrl uses HTTPS for better SEO
    baseUrl = baseUrl.Replace("http://", "https://");
    
    // Logo URL for Google Search and social media - Using absolute HTTPS URL
    var logoUrl = baseUrl + "/Images/Products/logo_white_bg.png";
    var logoUrl192 = baseUrl + "/Images/Products/logo_white_bg.png";
    var logoUrl512 = baseUrl + "/Images/Products/logo_white_bg.png";
    
    // Ensure image URL is absolute
    if (!string.IsNullOrEmpty(pageImage) && !pageImage.StartsWith("http"))
    {
        pageImage = baseUrl + (pageImage.StartsWith("/") ? "" : "/") + pageImage;
    }
    
    // Ensure pageImage uses HTTPS
    pageImage = pageImage.Replace("http://", "https://");
}

<!-- Primary Meta Tags - Optimized for "ideal weight nutrition", "ideal weight", "nutrition" -->
<meta name="title" content="@(pageTitle) - @siteName" />
<meta name="description" content="@pageDescription" />
<meta name="keywords" content="@pageKeywords" />
<meta name="subject" content="@(currentCulture == "ar" ? "وزن مثالي للتغذية، وزن مثالي، التغذية" : "Ideal Weight Nutrition, Ideal Weight, Nutrition")" />
<meta name="topic" content="@(currentCulture == "ar" ? "التغذية والوزن المثالي" : "Nutrition and Ideal Weight")" />
<meta name="classification" content="@(currentCulture == "ar" ? "متجر التغذية والوزن المثالي" : "Nutrition and Ideal Weight Store")" />
<meta name="author" content="@siteName" />
<meta name="robots" content="index, follow" />
<meta name="language" content="@currentCulture" />
<meta name="revisit-after" content="7 days" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />

<!-- Open Graph / Facebook - Enhanced for Google Search Logo Display -->
<meta property="og:type" content="@(seo?.PageType ?? "website")" />
<meta property="og:url" content="@canonicalUrl" />
<meta property="og:title" content="@(pageTitle) - @siteName" />
<meta property="og:description" content="@pageDescription" />
<!-- Primary Open Graph Image - For Google Search Results -->
<meta property="og:image" content="@logoUrl" />
<meta property="og:image:secure_url" content="@logoUrl" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="1200" />
<meta property="og:image:alt" content="@siteName - @(currentCulture == "ar" ? "ايديال ويت للتغذية" : "Ideal Weight Nutrition") Logo" />
<!-- Additional images for better social sharing -->
@if (seo?.PageType == "product")
{
    <meta property="og:image" content="@pageImage" />
    <meta property="og:image:secure_url" content="@pageImage" />
}
<meta property="og:site_name" content="@siteName" />
<meta property="og:locale" content="@(currentCulture == "ar" ? "ar_AE" : "en_US")" />
<!-- Organization Logo for Google Knowledge Graph -->
<meta property="og:logo" content="@logoUrl" />
<meta property="business:logo" content="@logoUrl" />
@if (currentCulture == "ar")
{
    <meta property="og:locale:alternate" content="en_US" />
}
else
{
    <meta property="og:locale:alternate" content="ar_AE" />
}
@if (seo?.PageType == "product" && seo.Price.HasValue)
{
    <meta property="product:price:amount" content="@seo.Price.Value.ToString("F2")" />
    <meta property="product:price:currency" content="@seo.Currency" />
    <meta property="product:availability" content="@(seo.InStock ? "in stock" : "out of stock")" />
}

<!-- Twitter Card - Enhanced for Logo Display -->
