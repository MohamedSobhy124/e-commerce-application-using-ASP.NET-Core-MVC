<meta name="twitter:url" content="@canonicalUrl" />
<meta name="twitter:title" content="@(pageTitle) - @siteName" />
<meta name="twitter:description" content="@pageDescription" />
<!-- Twitter Logo Image - Primary for brand recognition -->
