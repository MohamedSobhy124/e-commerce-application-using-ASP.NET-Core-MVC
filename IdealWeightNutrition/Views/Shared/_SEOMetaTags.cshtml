<!-- Alternate Languages - Proper multilingual support for "ideal weight nutrition", "ideal weight", "nutrition" -->
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var queryString = Context.Request.QueryString.Value ?? "";
    var arUrl = baseUrl + currentPath + (currentPath.Contains("?") ? "&" : "?") + "culture=ar" + queryString.Replace("?culture=en", "").Replace("&culture=en", "");
    var enUrl = baseUrl + currentPath + (currentPath.Contains("?") ? "&" : "?") + "culture=en" + queryString.Replace("?culture=ar", "").Replace("&culture=ar", "");
    var defaultUrl = baseUrl + currentPath + queryString;
}
<link rel="alternate" hreflang="ar" href="@arUrl" />
<link rel="alternate" hreflang="en" href="@enUrl" />
<link rel="alternate" hreflang="x-default" href="@defaultUrl" />

