@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IConfiguration Configuration

@inject IStringLocalizer<IdealWeightNutrition.SharedResources> Localizer
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture.RequestCulture.Culture.Name;
    var isRtl = currentCulture == "ar";
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    @{
        var pageTitle = ViewData["Title"]?.ToString() ?? "";
        var isHomePage = string.IsNullOrEmpty(pageTitle) || pageTitle == "Home" || pageTitle == "الرئيسية";
        var titleSuffix = currentCulture == "ar" 
            ? "ايديال ويت للتغذية | وزن مثالي للتغذية | وزن مثالي | حلول التغذية والوزن المثالي في الإمارات"
            : "Ideal Weight Nutrition | Ideal Weight Nutrition UAE | Ideal Weight Solutions | Nutrition Supplements UAE";
        
        var finalTitle = isHomePage
            ? (currentCulture == "ar" 
                ? "ايديال ويت للتغذية - وزن مثالي للتغذية - وزن مثالي - حلول التغذية المتكاملة | مكملات التغذية الإمارات"
                : "Ideal Weight Nutrition - Ideal Weight Nutrition UAE - Ideal Weight & Nutrition Solutions | Premium Nutrition Supplements UAE")
            : $"{pageTitle} - {titleSuffix}";
    }
    <title>@finalTitle</title>
    
    <!-- Google Search Console Verification -->
    @{
        var googleVerification = Configuration["SiteSettings:GoogleSearchConsoleVerification"] ?? "";
        if (!string.IsNullOrEmpty(googleVerification))
        {
            <meta name="google-site-verification" content="@googleVerification" />
        }
    }
    
    <!-- Favicon and App Icons - Multiple sizes for better Google Search visibility -->
    @{
        var faviconBaseUrl = Configuration["SiteSettings:BaseUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host;
    }
    <link rel="icon" type="image/x-icon" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
 
    <link rel="icon" type="image/png" sizes="32x32" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="apple-touch-icon" sizes="57x57" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <link rel="shortcut icon" href="@(faviconBaseUrl)/images/brand/logo-google.png" />
    <meta name="msapplication-TileImage" content="@@(faviconBaseUrl)/images/brand/logo-google.png" />
    <meta name="msapplication-TileColor" content="#7c3aed" />
    
    <!-- SEO Meta Tags Partial -->
    <partial name="_SEOMetaTags" />
    
    @{
        string baseUrl;
        string siteName;
        string siteDescription;
        string pageDescription;
        string pageImage;
        
        try
        {
            baseUrl = Configuration["SiteSettings:BaseUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host;
            siteName = Configuration["SiteSettings:SiteName"] ?? "Ideal Weight Nutrition";
            siteDescription = currentCulture == "ar" 
                ? (Configuration["SiteSettings:SiteDescriptionAr"] ?? "مكملات صحية ولياقة بدنية متميزة في الإمارات")
                : (Configuration["SiteSettings:SiteDescription"] ?? "Premium health and fitness supplements in UAE");
            pageTitle = ViewData["Title"]?.ToString() ?? (currentCulture == "ar" ? "الرئيسية" : "Home");
            pageDescription = ViewData["Description"]?.ToString() ?? siteDescription;
            pageImage = baseUrl + "/images/brand/logo-google.png";
        }
        catch
        {
            baseUrl = Context.Request.Scheme + "://" + Context.Request.Host;
            siteName = "Ideal Weight Nutrition";
            siteDescription = currentCulture == "ar" 
                ? "مكملات صحية ولياقة بدنية متميزة في الإمارات"
                : "Premium health and fitness supplements in UAE";
            pageTitle = ViewData["Title"]?.ToString() ?? (currentCulture == "ar" ? "الرئيسية" : "Home");
            pageDescription = ViewData["Description"]?.ToString() ?? siteDescription;
            pageImage = baseUrl + "/images/brand/logo-google.png";
        }
    }
    
    <!-- SEO Meta Tags are now handled by _SEOMetaTags partial above -->
    
    <!-- Structured Data (JSON-LD) - Organization, LocalBusiness & Website (Global) -->
    @{
        // Ensure baseUrl uses HTTPS for better SEO
        baseUrl = baseUrl.Replace("http://", "https://");
        var orgSchema = SEOHelper.GenerateOrganizationStructuredData(baseUrl, siteName, siteDescription);
        var localBusinessSchema = SEOHelper.GenerateLocalBusinessStructuredData(baseUrl, siteName, siteDescription, Configuration);
        var websiteSchema = SEOHelper.GenerateWebsiteStructuredData(baseUrl, siteName);
    }
    <script type="application/ld+json">
    @Html.Raw(orgSchema)
    </script>
    
    <script type="application/ld+json">
    @Html.Raw(localBusinessSchema)
    </script>
    
    <script type="application/ld+json">
    @Html.Raw(websiteSchema)
    </script>
     
    
    <!-- Page-Specific Structured Data (will be added by individual pages) -->
    @RenderSection("StructuredData", required: false)
    
    <!-- Performance Optimization: Resource Hints -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://code.jquery.com">
    <link rel="dns-prefetch" href="https://cdn.datatables.net">
    
    <!-- Preload LCP Image (Largest Contentful Paint) -->
    @if (ViewBag.LcpImageUrl != null && !string.IsNullOrEmpty(ViewBag.LcpImageUrl.ToString()))
    {
        <link rel="preload" href="@ViewBag.LcpImageUrl" as="image" fetchpriority="high">
    }
    
    <!-- Critical CSS: Load synchronously (above-the-fold content) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
