                                @await Component.InvokeAsync("ShoppingCart")
                            </a>
                        </li>

                        <!-- Language Switcher -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-globe me-1"></i>
                                <span id="currentLanguageDisplay">
                                    @{
                                        var langDisplay = currentCulture == "ar" ? "العربية" : "English";
                                    }
                                    @langDisplay
                                </span>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="languageDropdown">
                                @{
                                    var currentPath = Context.Request.Path.Value ?? "/";
                                    var queryString = Context.Request.QueryString.Value ?? "";
                                    // Remove existing culture parameter if present
                                    var cleanQueryString = queryString
                                        .Replace("?culture=ar", "")
                                        .Replace("&culture=ar", "")
                                        .Replace("?culture=en", "")
                                        .Replace("&culture=en", "");
                                    var querySeparator = string.IsNullOrEmpty(cleanQueryString) ? "?" : (cleanQueryString.Contains("?") ? "&" : "?");
                                    var arUrl = $"{currentPath}{querySeparator}culture=ar{cleanQueryString}";
                                    var enUrl = $"{currentPath}{querySeparator}culture=en{cleanQueryString}";
                                }
                                <li>
                                    <a href="@arUrl" 
                                    onclick="event.preventDefault(); switchToArabic(); return false;" 
                                    id="langButtonAr"
                                    class="dropdown-item @(currentCulture == "ar" ? "active" : "")">
                                        <i class="bi bi-translate me-2"></i> العربية
                                    </a>
                                </li>
                                <li>
                                    <a href="@enUrl" 
                                    onclick="event.preventDefault(); switchToEnglish(); return false;" 
                                    id="langButtonEn"
                                    class="dropdown-item @(currentCulture == "en" ? "active" : "")">
                                        <i class="bi bi-translate me-2"></i> English
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
