    <!-- Global Authentication State -->
    <script>
        // Set global authentication state from body attribute (set in body tag)
        (function() {
            const isAuthenticated = document.body.getAttribute('data-is-authenticated') === 'true';
            window.isAuthenticated = isAuthenticated;
        })();
    </script>
    
    <!-- Back to Top Functionality -->
    <script>
        // Initialize navbar toggler state on page load
        document.addEventListener('DOMContentLoaded', function() {
            const navbarToggler = document.querySelector('.navbar-toggler');
            const navbarCollapse = document.querySelector('#navbarNav');
            
            if (navbarToggler && navbarCollapse) {
                // Force collapsed state by default (shows hamburger)
                navbarToggler.classList.add('collapsed');
                navbarToggler.setAttribute('aria-expanded', 'false');
            }
        });
        
        // Back to Top Button
        const backToTopBtn = document.getElementById('backToTopBtn');
        const navbar = document.querySelector('.navbar');

        // Show/hide button based on scroll position + sticky navbar effect
        window.addEventListener('scroll', function() {
        // Back to top button
        if (window.pageYOffset > 300) {
        backToTopBtn.classList.add('show');
        } else {
        backToTopBtn.classList.remove('show');
        }

        // Sticky navbar effect
        if (window.pageYOffset > 50) {
        navbar.classList.add('scrolled');
        } else {
        navbar.classList.remove('scrolled');
        }
        });

        // Smooth scroll to top
        backToTopBtn.addEventListener('click', function() {
        window.scrollTo({
        top: 0,
        behavior: 'smooth'
        });
        });

        // Handle navbar toggle icon change (hamburger to X)
        const navbarToggler = document.querySelector('.navbar-toggler');
        const navbarCollapse = document.querySelector('#navbarNav');
        
        if (navbarToggler && navbarCollapse) {
            // Initialize: Always ensure collapsed class and aria-expanded='false' on page load
            // This ensures hamburger icon shows by default
            function initializeToggler() {
                // Force collapsed state on initial load
                navbarToggler.classList.add('collapsed');
                navbarToggler.setAttribute('aria-expanded', 'false');
            }
            
            // Set initial state immediately and on load
            initializeToggler();
            window.addEventListener('load', initializeToggler);
            
            // Listen for Bootstrap collapse events
            navbarCollapse.addEventListener('show.bs.collapse', function() {
                // Menu opening - remove collapsed class (shows X)
                navbarToggler.classList.remove('collapsed');
                navbarToggler.setAttribute('aria-expanded', 'true');
            });
            
            navbarCollapse.addEventListener('shown.bs.collapse', function() {
                // Menu fully open - ensure X icon
                navbarToggler.classList.remove('collapsed');
                navbarToggler.setAttribute('aria-expanded', 'true');
            });
            
            navbarCollapse.addEventListener('hide.bs.collapse', function() {
                // Menu closing - add collapsed class (shows hamburger)
                navbarToggler.classList.add('collapsed');
                navbarToggler.setAttribute('aria-expanded', 'false');
            });
            
            navbarCollapse.addEventListener('hidden.bs.collapse', function() {
                // Menu fully closed - ensure hamburger icon
                navbarToggler.classList.add('collapsed');
                navbarToggler.setAttribute('aria-expanded', 'false');
            });
        }

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(event) {
        const navbar = document.querySelector('.navbar-collapse');
        const toggler = document.querySelector('.navbar-toggler');

        // Don't close if clicking on a dropdown toggle or inside a dropdown menu
        if (event.target.closest('.dropdown-toggle') || event.target.closest('.dropdown-menu')) {
        return;
        }

        if (navbar && navbar.classList.contains('show')) {
        if (!navbar.contains(event.target) && !toggler.contains(event.target)) {
        const bsCollapse = new bootstrap.Collapse(navbar, {
        toggle: false
        });
        bsCollapse.hide();
        }
        }
        });

        // Close mobile menu when clicking a link (but not dropdown toggles)
        document.querySelectorAll('.navbar-nav .nav-link:not(.dropdown-toggle)').forEach(link => {
        link.addEventListener('click', function(e) {
        // Don't close if clicking on a dropdown toggle or inside a dropdown
        if (e.target.closest('.dropdown-toggle') || e.target.closest('.dropdown-menu')) {
        return;
        }
        const navbar = document.querySelector('.navbar-collapse');
        if (navbar && navbar.classList.contains('show')) {
        const bsCollapse = new bootstrap.Collapse(navbar);
        bsCollapse.hide();
        }
        });
        });
    </script>

    @if (User.Identity.IsAuthenticated)
    {
        <script>
            // Set user roles for SignalR
            const userRoles = '@(string.Join(",", User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value)))';
            if (typeof setUserRoles === 'function') {
            setUserRoles(userRoles);
            }
        </script>
        @if (User.IsInRole(SD.Role_Admin))
        {
        }
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                loadNotifications();  // Load notifications count on page load
            });
        </script>
    }


    @await RenderSectionAsync("Scripts", required: false)
    <!-- Performance: Use CDN for DataTables and SweetAlert2 - Defer non-critical -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js" crossorigin="anonymous" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" crossorigin="anonymous" defer></script>
   
    <!-- Floating Call Button -->
    @{
        var callPhone = Configuration["Call:PhoneNumber"] ?? Configuration["SiteSettings:Business:Phone"] ?? "971527383841";
        // Keep original phone for display
        var callPhoneDisplay = callPhone;
        // Remove spaces, dashes, and parentheses for tel: link, but keep + if present
        var callPhoneFormatted = callPhone.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace(".", "");
        // Ensure it starts with + if it doesn't already
        if (!callPhoneFormatted.StartsWith("+") && !callPhoneFormatted.StartsWith("tel:"))
        {
            callPhoneFormatted = "+" + callPhoneFormatted;
        }
        var callUrl = $"tel:{callPhoneFormatted}";
        var callEnabled = Configuration.GetValue<bool>("Call:Enabled", true);
        var callTooltipText = currentCulture == "ar" ? "اتصل بنا" : "Call Us";
    }
    @if (callEnabled)
    {
        <a href="@callUrl" 
           class="floating-call-btn call-pulse"
           title="@callTooltipText - @callPhoneDisplay">
            <i class="bi bi-telephone-fill"></i>
            <span class="call-tooltip">
                <span class="call-tooltip-text">@callTooltipText</span>
                <span class="call-tooltip-phone">@callPhoneDisplay</span>
            </span>
        </a>
    }

    <!-- Floating WhatsApp Button -->
    @{
        var whatsAppPhone = Configuration["WhatsApp:PhoneNumber"] ?? "971507700559"; ;  
        var whatsAppMessage = currentCulture == "ar"
        ? (Configuration["WhatsApp:DefaultMessageAr"] ?? "مرحباً! أنا مهتم بمنتجاتكم.")
        : (Configuration["WhatsApp:DefaultMessage"] ?? "Hello! I'm interested in your products.");
        var whatsAppUrl = $"https://wa.me/{whatsAppPhone}?text={Uri.EscapeDataString(whatsAppMessage)}";
    }
    <a href="@whatsAppUrl" 
       target="_blank" 
       class="floating-whatsapp-btn whatsapp-pulse"
       title="@Localizer["ChatOnWhatsApp"]">
        <i class="bi bi-whatsapp"></i>
        <span class="whatsapp-tooltip">@Localizer["ChatWithUs"]</span>
    </a>
   
    <!-- Cart Sidebar (available on all pages) -->
    <partial name="_CartSidebar" />
    
    <!-- Mobile Bottom Navigation -->
    <partial name="_MobileBottomNav" />
  
</body>
</html>
