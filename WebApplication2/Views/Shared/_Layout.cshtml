    @await RenderSectionAsync("Scripts", required: false)
    <!-- Performance: Use CDN for DataTables and SweetAlert2 -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" crossorigin="anonymous"></script>
    
    <!-- Cool Loader Script -->
    <script>
        (function() {
            const loader = document.getElementById('cool-loader');
            
            // Hide loader when page is fully loaded
            window.addEventListener('load', function() {
                setTimeout(function() {
                    loader.classList.add('hidden');
                    // Remove from DOM after animation completes
                    setTimeout(function() {
                        loader.style.display = 'none';
                    }, 600);
                }, 500); // Small delay for smooth transition
            });

            // Show loader on page navigation (for AJAX navigation)
            document.addEventListener('DOMContentLoaded', function() {
                // Intercept link clicks
                document.addEventListener('click', function(e) {
                    const link = e.target.closest('a[href]');
                    if (link && link.href && !link.href.startsWith('javascript:') && 
                        !link.href.startsWith('#') && !link.hasAttribute('data-bs-toggle') &&
                        !link.hasAttribute('data-bs-target') && link.target !== '_blank') {
                        const href = link.getAttribute('href');
                        // Only show loader for internal links
                        if (href && !href.startsWith('http') && !href.startsWith('//') && 
                            !href.startsWith('mailto:') && !href.startsWith('tel:')) {
                            loader.style.display = 'flex';
                            loader.classList.remove('hidden');
                        }
                    }
                });

                // Show loader on form submissions
                document.addEventListener('submit', function(e) {
                    const form = e.target;
                    if (form.tagName === 'FORM' && form.method.toLowerCase() !== 'get') {
                        loader.style.display = 'flex';
                        loader.classList.remove('hidden');
                    }
                });
            });

            // Global function to show/hide loader programmatically
            window.showLoader = function() {
                loader.style.display = 'flex';
                loader.classList.remove('hidden');
            };

            window.hideLoader = function() {
                loader.classList.add('hidden');
                setTimeout(function() {
                    loader.style.display = 'none';
                }, 600);
            };

            // Show loader for AJAX requests - but exclude cart operations
            if (typeof jQuery !== 'undefined') {
                $(document).ajaxStart(function(event, xhr, settings) {
                    const url = settings?.url || '';
                    const isCartOperation = url.includes('/ToggleCart') || 
                                           url.includes('/AddToCart') || 
                                           url.includes('/RemoveFromCart') ||
                                           url.includes('/UpdateCart') ||
                                           url.includes('/GetCartItems') ||
                                           url.includes('/Cart/');
                    
                    // Don't show loader for cart operations
                    if (!isCartOperation) {
                        loader.style.display = 'flex';
                        loader.classList.remove('hidden');
                    }
                }).ajaxComplete(function(event, xhr, settings) {
                    const url = settings?.url || '';
                    const isCartOperation = url.includes('/ToggleCart') || 
                                           url.includes('/AddToCart') || 
                                           url.includes('/RemoveFromCart') ||
                                           url.includes('/UpdateCart') ||
                                           url.includes('/GetCartItems') ||
                                           url.includes('/Cart/');
                    
                    // Don't hide loader for cart operations (it was never shown)
                    if (!isCartOperation) {
                        setTimeout(function() {
                            loader.classList.add('hidden');
                            setTimeout(function() {
                                loader.style.display = 'none';
                            }, 600);
                        }, 300);
                    }
                });
            }

            // Also handle fetch API - but exclude cart operations and other quick actions
            const originalFetch = window.fetch;
            window.fetch = function(...args) {
                const url = typeof args[0] === 'string' ? args[0] : (args[0]?.url || '');
                const isCartOperation = url.includes('/ToggleCart') || 
                                       url.includes('/AddToCart') || 
                                       url.includes('/RemoveFromCart') ||
                                       url.includes('/UpdateCart') ||
                                       url.includes('/GetCartItems') ||
                                       url.includes('/Cart/');
                
                // Don't show loader for cart operations - they have their own button loaders
                if (!isCartOperation) {
                    loader.style.display = 'flex';
                    loader.classList.remove('hidden');
                }
                
                return originalFetch.apply(this, args)
                    .finally(function() {
                        if (!isCartOperation) {
                            setTimeout(function() {
                                loader.classList.add('hidden');
                                setTimeout(function() {
                                    loader.style.display = 'none';
                                }, 600);
                            }, 300);
                        }
                    });
            };
        })();
    </script>

    <!-- Floating Call Button -->
    @{
        var callPhone = Configuration["Call:PhoneNumber"] ?? Configuration["SiteSettings:Business:Phone"] ?? "971527383841";
        // Keep original phone for display
        var callPhoneDisplay = callPhone;
        // Remove spaces, dashes, and parentheses for tel: link, but keep + if present
        var callPhoneFormatted = callPhone.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace(".", "");
        // Ensure it starts with + if it doesn't already
        if (!callPhoneFormatted.StartsWith("+") && !callPhoneFormatted.StartsWith("tel:"))
        {
            callPhoneFormatted = "+" + callPhoneFormatted;
        }
        var callUrl = $"tel:{callPhoneFormatted}";
        var callEnabled = Configuration.GetValue<bool>("Call:Enabled", true);
        var callTooltipText = currentCulture == "ar" ? "اتصل بنا" : "Call Us";
    }
    @if (callEnabled)
    {
        <a href="@callUrl" 
           class="floating-call-btn call-pulse"
           title="@callTooltipText - @callPhoneDisplay">
            <i class="bi bi-telephone-fill"></i>
            <span class="call-tooltip">
                <span class="call-tooltip-text">@callTooltipText</span>
                <span class="call-tooltip-phone">@callPhoneDisplay</span>
            </span>
        </a>
    }

    <!-- Floating WhatsApp Button -->
    @{
        var whatsAppPhone = Configuration["WhatsApp:PhoneNumber"] ?? "971507700559"; ;  
        var whatsAppMessage = currentCulture == "ar"
        ? (Configuration["WhatsApp:DefaultMessageAr"] ?? "مرحباً! أنا مهتم بمنتجاتكم.")
        : (Configuration["WhatsApp:DefaultMessage"] ?? "Hello! I'm interested in your products.");
        var whatsAppUrl = $"https://wa.me/{whatsAppPhone}?text={Uri.EscapeDataString(whatsAppMessage)}";
    }
    <a href="@whatsAppUrl" 
       target="_blank" 
       class="floating-whatsapp-btn whatsapp-pulse"
       title="@Localizer["ChatOnWhatsApp"]">
        <i class="bi bi-whatsapp"></i>
        <span class="whatsapp-tooltip">@Localizer["ChatWithUs"]</span>
    </a>
   
    <!-- Cart Sidebar (available on all pages) -->
    <partial name="_CartSidebar" />
    
    <!-- Mobile Bottom Navigation -->
    <partial name="_MobileBottomNav" />
  
</body>
</html>
