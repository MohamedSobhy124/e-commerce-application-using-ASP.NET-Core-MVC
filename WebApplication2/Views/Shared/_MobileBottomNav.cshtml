@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    
    // Get current controller and action
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    
    // Determine active tab
    bool isHomeActive = (controller.Equals("Home", StringComparison.OrdinalIgnoreCase) && 
                        action.Equals("Index", StringComparison.OrdinalIgnoreCase) && 
                        area.Equals("Customer", StringComparison.OrdinalIgnoreCase)) ||
                       (string.IsNullOrEmpty(area) && controller.Equals("Home", StringComparison.OrdinalIgnoreCase));
    
    bool isOffersActive = controller.Equals("Offer", StringComparison.OrdinalIgnoreCase) && 
                         area.Equals("Customer", StringComparison.OrdinalIgnoreCase);
    
    bool isAccountActive = controller.Equals("Account", StringComparison.OrdinalIgnoreCase) && 
                          area.Equals("Customer", StringComparison.OrdinalIgnoreCase);
    
    // Account link - redirect to login if not authenticated, otherwise to account page
    string accountLink = User.Identity?.IsAuthenticated == true
        ? Url.Action("Index", "Account", new { area = "Customer" })
        : Url.Page("/Account/Login", new { area = "Identity" });
    
    string accountLabel = User.Identity?.IsAuthenticated == true 
        ? (currentCulture == "ar" ? "حسابي" : "Account")
        : (currentCulture == "ar" ? "تسجيل الدخول" : "Login");
}

<nav class="mobile-bottom-nav" id="mobileBottomNav">
    <div class="nav-container">
        <!-- Home -->
        <a href="@Url.Action("Index", "Home", new { area = "Customer" })" 
           class="nav-item @(isHomeActive ? "active" : "")"
           title="@Localizer["Home"]">
            <i class="bi bi-house-fill nav-icon"></i>
            <span class="nav-label">@Localizer["Home"]</span>
        </a>

        <!-- Offers -->
        <a href="@Url.Action("Index", "Offer", new { area = "Customer" })" 
           class="nav-item @(isOffersActive ? "active" : "")"
           title="@Localizer["Offers"]">
            <i class="bi bi-tag-fill nav-icon"></i>
            <span class="nav-label">@Localizer["Offers"]</span>
        </a>

        <!-- Cart -->
        <button type="button"
           class="nav-item"
           id="mobileCartBtn"
           onclick="if(typeof window.openCartSidebar === 'function') { window.openCartSidebar(true); } else if(typeof openCartSidebar === 'function') { openCartSidebar(true); } return false;"
           title="@Localizer["ShoppingCart"]">
            <i class="bi bi-cart3 nav-icon"></i>
            <span class="nav-label">@Localizer["Cart"]</span>
            <span class="nav-badge" id="mobileCartBadge" style="display: none;">0</span>
        </button>

        <!-- Account -->
        <a href="@accountLink" 
           class="nav-item @(isAccountActive ? "active" : "")"
           title="@accountLabel">
            <i class="bi bi-person-circle nav-icon"></i>
            <span class="nav-label">@accountLabel</span>
        </a>
    </div>
</nav>

<script>
    // Add body class when mobile nav is visible
    document.addEventListener('DOMContentLoaded', function() {
        const mobileNav = document.getElementById('mobileBottomNav');
        if (mobileNav && window.innerWidth <= 768) {
            document.body.classList.add('has-mobile-nav');
        }
        
        // Initialize mobile cart badge if cart count is available
        const headerCartBadge = document.getElementById('headerCartBadge');
        if (headerCartBadge) {
            const cartCount = parseInt(headerCartBadge.textContent) || 0;
            const mobileCartBadge = document.getElementById('mobileCartBadge');
            if (mobileCartBadge) {
                if (cartCount > 0) {
                    mobileCartBadge.textContent = cartCount;
                    mobileCartBadge.style.display = 'flex';
                } else {
                    mobileCartBadge.style.display = 'none';
                }
            }
        }
        
        // Update on resize
        window.addEventListener('resize', function() {
            if (window.innerWidth <= 768) {
                document.body.classList.add('has-mobile-nav');
            } else {
                document.body.classList.remove('has-mobile-nav');
            }
        });
    });
</script>

