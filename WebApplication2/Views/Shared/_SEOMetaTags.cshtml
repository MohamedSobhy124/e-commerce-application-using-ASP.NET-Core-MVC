@using BulkyBook.Models.ViewModels
@using BulkyBook.Utility
@using Microsoft.AspNetCore.Localization
@inject IConfiguration Configuration
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    
    var seo = ViewData["SEO"] as SEOViewModel;
    var baseUrl = Configuration["SiteSettings:BaseUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host;
    var siteName = Configuration["SiteSettings:SiteName"] ?? "Ideal Weight Nutrition";
    var siteDescription = currentCulture == "ar" 
        ? (Configuration["SiteSettings:SiteDescriptionAr"] ?? "مكملات صحية ولياقة بدنية متميزة في الإمارات")
        : (Configuration["SiteSettings:SiteDescription"] ?? "Premium health and fitness supplements in UAE");
    
    var pageTitle = seo?.Title ?? ViewData["Title"]?.ToString() ?? (currentCulture == "ar" ? "الرئيسية" : "Home");
    var pageDescription = seo?.Description ?? ViewData["Description"]?.ToString() ?? siteDescription;
    var pageKeywords = seo?.Keywords ?? ViewData["Keywords"]?.ToString() ?? (currentCulture == "ar" ? "مكملات غذائية, صحة, لياقة, وزن مثالي, الإمارات" : "nutrition supplements, health, fitness, ideal weight, UAE");
    var pageImage = seo?.ImageUrl ?? ViewData["Image"]?.ToString() ?? baseUrl + "/Images/Products/logo_white_bg.png";
    var canonicalUrl = seo?.CanonicalUrl ?? (baseUrl + Context.Request.Path + Context.Request.QueryString);
    
    // Ensure image URL is absolute
    if (!string.IsNullOrEmpty(pageImage) && !pageImage.StartsWith("http"))
    {
        pageImage = baseUrl + (pageImage.StartsWith("/") ? "" : "/") + pageImage;
    }
}

<!-- Primary Meta Tags - Optimized for "ideal weight nutrition", "ideal weight", "nutrition" -->
<meta name="title" content="@(pageTitle) - @siteName" />
<meta name="description" content="@pageDescription" />
<meta name="keywords" content="@pageKeywords" />
<meta name="subject" content="@(currentCulture == "ar" ? "وزن مثالي للتغذية، وزن مثالي، التغذية" : "Ideal Weight Nutrition, Ideal Weight, Nutrition")" />
<meta name="topic" content="@(currentCulture == "ar" ? "التغذية والوزن المثالي" : "Nutrition and Ideal Weight")" />
<meta name="classification" content="@(currentCulture == "ar" ? "متجر التغذية والوزن المثالي" : "Nutrition and Ideal Weight Store")" />
<meta name="author" content="@siteName" />
<meta name="robots" content="index, follow" />
<meta name="language" content="@currentCulture" />
<meta name="revisit-after" content="7 days" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="@(seo?.PageType ?? "website")" />
<meta property="og:url" content="@canonicalUrl" />
<meta property="og:title" content="@(pageTitle) - @siteName" />
<meta property="og:description" content="@pageDescription" />
<meta property="og:image" content="@pageImage" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="@siteName Logo" />
<meta property="og:site_name" content="@siteName" />
<meta property="og:locale" content="@(currentCulture == "ar" ? "ar_AE" : "en_US")" />
@if (currentCulture == "ar")
{
    <meta property="og:locale:alternate" content="en_US" />
}
else
{
    <meta property="og:locale:alternate" content="ar_AE" />
}
@if (seo?.PageType == "product" && seo.Price.HasValue)
{
    <meta property="product:price:amount" content="@seo.Price.Value.ToString("F2")" />
    <meta property="product:price:currency" content="@seo.Currency" />
    <meta property="product:availability" content="@(seo.InStock ? "in stock" : "out of stock")" />
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="@canonicalUrl" />
<meta property="twitter:title" content="@(pageTitle) - @siteName" />
<meta property="twitter:description" content="@pageDescription" />
<meta property="twitter:image" content="@pageImage" />

<!-- Canonical URL -->
<link rel="canonical" href="@canonicalUrl" />

<!-- Alternate Languages - Proper multilingual support for "ideal weight nutrition", "ideal weight", "nutrition" -->
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var queryString = Context.Request.QueryString.Value ?? "";
    var arUrl = baseUrl + currentPath + (currentPath.Contains("?") ? "&" : "?") + "culture=ar" + queryString.Replace("?culture=en", "").Replace("&culture=en", "");
    var enUrl = baseUrl + currentPath + (currentPath.Contains("?") ? "&" : "?") + "culture=en" + queryString.Replace("?culture=ar", "").Replace("&culture=ar", "");
    var defaultUrl = baseUrl + currentPath + queryString;
}
<link rel="alternate" hreflang="ar" href="@arUrl" />
<link rel="alternate" hreflang="en" href="@enUrl" />
<link rel="alternate" hreflang="x-default" href="@defaultUrl" />

<!-- Additional SEO for Arabic searches -->
@if (currentCulture == "ar")
{
    <meta name="keywords" content="وزن مثالي للتغذية, وزن مثالي, التغذية, وزن مثالي للتغذية الإمارات, حلول الوزن المثالي, مكملات التغذية, @pageKeywords" />
    <meta property="og:title" content="@(pageTitle) - وزن مثالي للتغذية" />
}
else
{
    <meta name="keywords" content="ideal weight nutrition, ideal weight, nutrition, ideal weight nutrition UAE, ideal weight solutions, nutrition supplements, @pageKeywords" />
    <meta property="og:title" content="@(pageTitle) - Ideal Weight Nutrition" />
}

<!-- Geo Tags - UAE Specific -->
<meta name="geo.region" content="AE" />
<meta name="geo.placename" content="United Arab Emirates" />
<meta name="geo.position" content="25.2048;55.2708" />
<meta name="ICBM" content="25.2048, 55.2708" />
<meta name="geo.region" content="AE-DU" />
<meta name="DC.title" content="@(pageTitle) - @siteName" />
<meta name="DC.creator" content="@siteName" />
<meta name="DC.subject" content="@pageKeywords" />
<meta name="DC.description" content="@pageDescription" />
<meta name="DC.publisher" content="@siteName" />
<meta name="DC.contributor" content="@siteName" />
<meta name="DC.coverage" content="United Arab Emirates" />
<meta name="DC.language" content="@currentCulture" />

<!-- Enhanced Keywords for Better SEO - Targeting "ideal weight nutrition", "ideal weight", "nutrition" -->
<meta name="keywords" content="ideal weight nutrition, ideal weight, nutrition, @pageKeywords, ideal weight nutrition UAE, ideal weight solutions, nutrition supplements, diet, protein, vitamins, weight loss, fitness, health, Dubai, Abu Dhabi, Sharjah, UAE delivery, free delivery UAE, nutrition store UAE, supplements online UAE, buy supplements, nutrition products, health supplements UAE, diet supplements Dubai, protein supplements UAE, vitamins Dubai, weight management, sports nutrition, ideal weight program, nutrition advice, nutrition products, وزن مثالي للتغذية, وزن مثالي, التغذية" />

<!-- Additional SEO Meta Tags -->
<meta name="theme-color" content="#007bff" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="format-detection" content="telephone=yes" />

<!-- Mobile Optimization -->
<meta name="mobile-web-app-capable" content="yes" />
<meta name="HandheldFriendly" content="true" />
<meta name="MobileOptimized" content="320" />

<!-- Content Language -->
<meta http-equiv="content-language" content="@currentCulture" />

<!-- Cache Control -->
<meta http-equiv="Cache-Control" content="public, max-age=3600" />

<!-- Additional Open Graph Tags -->
<meta property="og:type" content="@(seo?.PageType ?? "website")" />
@if (seo?.PageType == "product")
{
    <meta property="product:brand" content="@(seo.Brand ?? "Ideal Weight Nutrition")" />
    <meta property="product:category" content="@(seo.Category ?? "")" />
    <meta property="product:availability" content="@(seo.InStock ? "in stock" : "out of stock")" />
    <meta property="product:condition" content="new" />
    <meta property="product:retailer" content="Ideal Weight Nutrition" />
    <meta property="product:retailer_item_id" content="@(ViewData["ProductId"]?.ToString() ?? "")" />
    @if (seo.Rating.HasValue && seo.ReviewCount.HasValue && seo.ReviewCount > 0)
    {
        <meta property="product:rating:value" content="@seo.Rating.Value.ToString("F1")" />
        <meta property="product:rating:scale" content="5" />
    }
}

<!-- Twitter Card Enhanced -->
<meta name="twitter:site" content="@("@idealweightnutrition")" />
<meta name="twitter:creator" content="@("@idealweightnutrition")" />
<meta name="twitter:domain" content="idealweightnutrition.ae" />

<!-- Business Information -->
<meta name="contact" content="info@idealweightnutrition.ae" />
<meta name="copyright" content="Ideal Weight Nutrition" />
<meta name="reply-to" content="info@idealweightnutrition.ae" />

<!-- Rich Snippets Support -->
<meta name="application-name" content="Ideal Weight Nutrition" />
<meta name="msapplication-TileColor" content="#007bff" />
<meta name="msapplication-config" content="/browserconfig.xml" />

