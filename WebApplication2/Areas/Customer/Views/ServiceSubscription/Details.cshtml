@model BulkyBook.Models.ServiceSubscription

@{
    ViewData["Title"] = Model.Title;
    var activeOffers = ViewBag.ActiveOffers as IEnumerable<BulkyBook.Models.ServiceOffer> ?? Enumerable.Empty<BulkyBook.Models.ServiceOffer>();
    var promoCodes = ViewBag.PromoCode as IEnumerable<BulkyBook.Models.PromoCode> ?? Enumerable.Empty<BulkyBook.Models.PromoCode>();
    bool isGuest = !User.Identity.IsAuthenticated;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="service-detail-card mb-4">
                @{
                    var serviceImages = Model.ServiceImages != null && Model.ServiceImages.Any() 
                        ? Model.ServiceImages.OrderBy(si => si.DisplayOrder).Select(si => si.ImageUrl).ToList()
                        : new List<string>();
                    
                    // If no ServiceImages but has ImageUrl, use that
                    if (!serviceImages.Any() && !string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        serviceImages.Add(Model.ImageUrl);
                    }
                }
                
                @if (serviceImages.Count > 1)
                {
                    <div id="serviceDetailsCarousel" class="carousel slide service-details-carousel" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < serviceImages.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@serviceImages[i]" class="service-detail-image" alt="@Model.Title - Image @(i+1)" />
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#serviceDetailsCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">@Localizer["Previous"]</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#serviceDetailsCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">@Localizer["Next"]</span>
                        </button>
                        <div class="carousel-indicators">
                            @for (int i = 0; i < serviceImages.Count; i++)
                            {
                                <button type="button" data-bs-target="#serviceDetailsCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                            }
                        </div>
                    </div>
                }
                else if (serviceImages.Count == 1)
                {
                    <img src="@serviceImages[0]" class="service-detail-image" alt="@Model.Title" />
                }
                else
                {
                    <div class="service-detail-image-placeholder">
                        <i class="bi bi-briefcase" style="font-size: 5rem;"></i>
                    </div>
                }
                
                <div class="service-detail-content">
                    <div class="d-flex align-items-center mb-3">
                        <h1 class="service-detail-title me-3">@Model.Title</h1>
                        @if (Model.ServiceType == BulkyBook.Models.ServiceType.Online)
                        {
                            <span class="badge bg-success"><i class="bi bi-globe"></i> @Localizer["OnlineService"]</span>
                        }
                        else
                        {
                            <span class="badge bg-info"><i class="bi bi-building"></i> @Localizer["OfflineService"]</span>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="service-description-full">
                            <h4>@Localizer["Description"]</h4>
                            <p>@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="service-purchase-card">
                <div class="purchase-card-header">
                    <h3>@Localizer["SubscriptionDetails"]</h3>
                </div>
                <div class="purchase-card-body">
                    @{
                        decimal finalPrice = Model.Price;
                        decimal discountAmount = 0;
                        int? selectedOfferId = null;

                        if (activeOffers.Any())
                        {
                            var bestOffer = activeOffers.OrderByDescending(o => o.DiscountValue).First();
                            selectedOfferId = bestOffer.Id;
                            
                            if (bestOffer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                            {
                                discountAmount = Model.Price * (bestOffer.DiscountValue / 100);
                            }
                            else
                            {
                                discountAmount = bestOffer.DiscountValue;
                            }
                            finalPrice = Model.Price - discountAmount;
                        }
                    }

                    <div class="pricing-section">
                        <div class="price-row">
                            <span>@Localizer["ServicePrice"]:</span>
                            <span class="fw-bold">@Model.Price.ToString("C")</span>
                        </div>
                        @if (discountAmount > 0)
                        {
                            <div class="price-row discount">
                                <span>@Localizer["Discount"]:</span>
                                <span class="fw-bold text-success">-@discountAmount.ToString("C")</span>
                            </div>
                        }
                        <div class="price-row total">
                            <span>@Localizer["TotalAmount"]:</span>
                            <span class="fw-bold fs-4 text-primary">@finalPrice.ToString("C")</span>
                        </div>
                        @if (Model.ServiceType == BulkyBook.Models.ServiceType.Offline && Model.OfflinePaymentPercent.HasValue)
                        {
                            decimal minAmountToPay = finalPrice * (Model.OfflinePaymentPercent.Value / 100);
                            <div class="price-row payment-amount">
                                <span>@Localizer["MinimumAmountToPayNow", Model.OfflinePaymentPercent.Value]:</span>
                                <span class="fw-bold fs-5 text-danger" id="minAmountDisplay">@minAmountToPay.ToString("C")</span>
                            </div>
                            <div class="alert alert-info mt-3">
                                <i class="bi bi-info-circle"></i> 
                                @Localizer["OfflinePaymentInfo", Model.OfflinePaymentPercent.Value, minAmountToPay.ToString("C")]
                            </div>
                        }
                    </div>

                    @if (activeOffers.Any())
                    {
                        <div class="offers-section mt-4">
                            <h5><i class="bi bi-tag-fill text-warning"></i> @Localizer["ActiveOffers"]</h5>
                            @foreach (var offer in activeOffers)
                            {
                                <div class="offer-item">
                                    @if (offer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                    {
                                        <strong>@offer.DiscountValue% @Localizer["OFF"]</strong>
                                    }
                                    else
                                    {
                                        <strong>@offer.DiscountValue.ToString("C") @Localizer["OFF"]</strong>
                                    }
                                    <small class="text-muted d-block">@Localizer["ValidUntil"] @offer.EndDate.ToString("MMM dd, yyyy")</small>
                                </div>
                            }
                        </div>
                    }

                    <form asp-action="Subscribe" method="post" class="mt-4" id="subscribeForm"
                          data-service-type="@((int)Model.ServiceType)"
                          data-offline-percent="@(Model.OfflinePaymentPercent ?? 0)"
                          data-final-price="@finalPrice">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="serviceId" value="@Model.Id" />
                        @if (selectedOfferId.HasValue)
                        {
                            <input type="hidden" name="offerId" value="@selectedOfferId.Value" />
                        }

                        @if (isGuest)
                        {
                            <div class="mb-3">
                                <label class="form-label">@Localizer["FullName"] *</label>
                                <input type="text" name="guestName" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Localizer["Email"] *</label>
                                <input type="email" name="guestEmail" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Localizer["Phone"]</label>
                                <input type="tel" name="guestPhone" class="form-control" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">@Localizer["PromoCodeOptional"]</label>
                            <input type="text" name="promoCode" class="form-control" placeholder="@Localizer["EnterPromoCode"]" />
                        </div>

                        @if (Model.ServiceType == BulkyBook.Models.ServiceType.Offline && Model.OfflinePaymentPercent.HasValue)
                        {
                            decimal minAmountToPay = finalPrice * (Model.OfflinePaymentPercent.Value / 100);
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    @Localizer["AmountToPayNow"] *
                                    <small class="text-muted">(@Localizer["Minimum"]: @minAmountToPay.ToString("C"))</small>
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">AED</span>
                                    <input type="number" 
                                           name="customAmount" 
                                           id="customAmount" 
                                           class="form-control" 
                                           step="0.01" 
                                           min="@minAmountToPay" 
                                           max="@finalPrice"
                                           value="@minAmountToPay"
                                           required />
                                </div>
                                <div class="invalid-feedback" id="amountError" style="display: none;">
                                    @Localizer["AmountMustBeAtLeast", minAmountToPay.ToString("C"), Model.OfflinePaymentPercent.Value]
                                </div>
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle"></i> 
                                    @Localizer["OfflinePaymentAmountInfo", finalPrice.ToString("C")]
                                </small>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary btn-lg w-100" id="submitBtn">
                            <i class="bi bi-credit-card me-2"></i>
                            @if (Model.ServiceType == BulkyBook.Models.ServiceType.Online)
                            {
                                <span>@Localizer["SubscribeNow"] - @finalPrice.ToString("C")</span>
                            }
                            else
                            {
                                <span id="submitBtnText">@Localizer["PayNow"]</span>
                            }
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .service-detail-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .service-details-carousel {
        height: 400px;
    }

    .service-details-carousel .carousel-inner {
        height: 100%;
    }

    .service-details-carousel .carousel-item {
        height: 100%;
    }

    .service-detail-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .service-details-carousel .carousel-control-prev,
    .service-details-carousel .carousel-control-next {
        opacity: 0.8;
        width: 5%;
    }

    .service-details-carousel .carousel-control-prev:hover,
    .service-details-carousel .carousel-control-next:hover {
        opacity: 1;
    }

    .service-details-carousel .carousel-indicators {
        margin-bottom: 15px;
    }

    .service-details-carousel .carousel-indicators button {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.5);
        border: 2px solid white;
    }

    .service-details-carousel .carousel-indicators button.active {
        background-color: white;
    }

    .service-detail-image-placeholder {
        width: 100%;
        height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .service-detail-content {
        padding: 30px;
    }

    .service-detail-title {
        font-size: 2rem;
        font-weight: 800;
        color: #1f2937;
    }

    .service-description-full {
        margin-top: 20px;
    }

    .service-description-full h4 {
        color: #374151;
        margin-bottom: 15px;
    }

    .service-description-full p {
        color: #6b7280;
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .service-purchase-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: sticky;
        top: 20px;
    }

    .purchase-card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        text-align: center;
    }

    .purchase-card-header h3 {
        margin: 0;
        font-weight: 700;
    }

    .purchase-card-body {
        padding: 25px;
    }

    .pricing-section {
        border-bottom: 2px solid #e5e7eb;
        padding-bottom: 20px;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .price-row.discount {
        color: #059669;
    }

    .price-row.total {
        border-top: 2px solid #e5e7eb;
        margin-top: 10px;
        padding-top: 15px;
        font-size: 1.2rem;
    }

    .price-row.payment-amount {
        background: #fef2f2;
        padding: 15px;
        border-radius: 10px;
        margin-top: 15px;
        border: 2px solid #fecaca;
    }

    .offers-section {
        background: #fffbeb;
        padding: 15px;
        border-radius: 10px;
        border-left: 4px solid #f59e0b;
    }

    .offer-item {
        padding: 10px;
        background: white;
        border-radius: 8px;
        margin-top: 10px;
    }

    .btn-lg {
        padding: 15px;
        font-size: 1.1rem;
        font-weight: 700;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            var form = $('#subscribeForm');
            var serviceType = parseInt(form.data('service-type'));
            var offlinePercent = parseFloat(form.data('offline-percent'));
            var finalPrice = parseFloat(form.data('final-price'));
            
            // Check if it's an offline service
            if (serviceType == 2 && offlinePercent > 0) {
                var minAmount = finalPrice * (offlinePercent / 100);
                var maxAmount = finalPrice;
                
                // Update submit button text when amount changes
                $('#customAmount').on('input', function() {
                    var amount = parseFloat($(this).val()) || 0;
                    if (amount >= minAmount && amount <= maxAmount) {
                        $('#submitBtnText').text('Pay ' + amount.toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' AED Now');
                        $('#amountError').hide();
                        $(this).removeClass('is-invalid');
                    } else if (amount > 0) {
                        if (amount < minAmount) {
                            $('#amountError').text('Amount must be at least ' + minAmount.toLocaleString('en-AE', { style: 'currency', currency: 'AED' }) + ' (' + offlinePercent + '% of total)');
                            $('#amountError').show();
                            $(this).addClass('is-invalid');
                        } else if (amount > maxAmount) {
                            $('#amountError').text('Amount cannot exceed the total amount of ' + maxAmount.toLocaleString('en-AE', { style: 'currency', currency: 'AED' }) + ' AED');
                            $('#amountError').show();
                            $(this).addClass('is-invalid');
                        }
                    }
                });

                // Validate amount on form submit
                form.on('submit', function(e) {
                    var amount = parseFloat($('#customAmount').val()) || 0;
                    
                    if (amount < minAmount) {
                        e.preventDefault();
                        $('#amountError').text('Amount must be at least ' + minAmount.toLocaleString('en-AE', { style: 'currency', currency: 'AED' }) + ' (' + offlinePercent + '% of total)');
                        $('#amountError').show();
                        $('#customAmount').addClass('is-invalid');
                        $('#customAmount').focus();
                        return false;
                    }
                    
                    if (amount > maxAmount) {
                        e.preventDefault();
                        $('#amountError').text('Amount cannot exceed the total amount of ' + maxAmount.toLocaleString('en-AE', { style: 'currency', currency: 'AED' }));
                        $('#amountError').show();
                        $('#customAmount').addClass('is-invalid');
                        $('#customAmount').focus();
                        return false;
                    }

                    // If validation passes, disable button and show loading
                    var btn = $(this).find('button[type="submit"]');
                    btn.prop('disabled', true);
                    btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Processing...');
                });
            } else {
                // Online service - just show loading
                form.on('submit', function(e) {
                    var btn = $(this).find('button[type="submit"]');
                    btn.prop('disabled', true);
                    btn.html('<span class="spinner-border spinner-border-sm me-2"></span>Processing...');
                });
            }
        });
    </script>
}

