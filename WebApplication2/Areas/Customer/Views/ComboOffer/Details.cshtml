@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@model BulkyBook.Models.ComboOffer

@{
    ViewData["Title"] = Model.Name;
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
    var comboName = currentCulture == "ar" && !string.IsNullOrEmpty(Model.NameAr) ? Model.NameAr : Model.Name;
    var comboDescription = currentCulture == "ar" && !string.IsNullOrEmpty(Model.DescriptionAr) ? Model.DescriptionAr : Model.Description;
}

<style>
    .combo-detail-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 4rem 0;
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }
    
    .combo-detail-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }
    
    .combo-image-container {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        transform: perspective(1000px) rotateY(-5deg);
        transition: transform 0.3s ease;
    }
    
    .combo-image-container:hover {
        transform: perspective(1000px) rotateY(0deg) scale(1.02);
    }
    
    .combo-badge-floating {
        position: absolute;
        top: 20px;
        right: 20px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1.2rem;
        box-shadow: 0 10px 30px rgba(245, 87, 108, 0.4);
        animation: pulse 2s ease-in-out infinite;
        z-index: 10;
    }
    
    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    .combo-price-section {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    
    .price-original {
        font-size: 1.5rem;
        color: #9ca3af;
        text-decoration: line-through;
    }
    
    .price-combo {
        font-size: 3rem;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0.5rem 0;
    }
    
    .savings-badge {
        display: inline-block;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        margin-top: 1rem;
    }
    
    .combo-features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 2rem 0;
    }
    
    .feature-card {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 1.5rem;
        border-radius: 15px;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }
    
    .product-card-combo {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        position: relative;
    }
    
    .product-card-combo:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }
    
    .product-image-wrapper {
        position: relative;
        height: 250px;
        overflow: hidden;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }
    
    .product-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }
    
    .product-card-combo:hover .product-image-wrapper img {
        transform: scale(1.1);
    }
    
    .product-quantity-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(102, 126, 234, 0.9);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9rem;
    }
    
    .required-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .add-to-cart-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border: none !important;
        color: white !important;
        padding: 1rem 2rem !important;
        border-radius: 50px !important;
        font-weight: 700 !important;
        font-size: 1.1rem !important;
        width: 100% !important;
        max-width: 500px !important;
        margin: 0 auto !important;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4) !important;
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
    }
    
    .add-to-cart-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(102, 126, 234, 0.6);
    }
    
    .add-to-cart-btn:active {
        transform: translateY(-1px);
    }
    
    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 2rem;
        text-align: center;
    }
    
    @@media (max-width: 768px) {
        .combo-price-section {
            padding: 1.5rem;
        }
        
        .price-combo {
            font-size: 2rem;
        }
        
        .products-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Hero Section -->
<div class="combo-detail-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="combo-image-container">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@comboName" class="img-fluid w-100" style="height: 400px; object-fit: contain;" />
                    }
                    <div class="combo-badge-floating">
                        @Model.DiscountPercentage.ToString("F0")% @Localizer["Off"]
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-4 fw-bold mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.2);">
                    @comboName
                </h1>
                @if (!string.IsNullOrEmpty(comboDescription))
                {
                    <p class="lead mb-4" style="opacity: 0.95;">
                        @comboDescription
                    </p>
                }
                <div class="combo-features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <h5 class="fw-bold">@Model.TotalProducts</h5>
                        <p class="mb-0 text-muted">@Localizer["Products"]</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <h5 class="fw-bold">@Localizer["InStock"]</h5>
                        <p class="mb-0 text-muted">@Localizer["Available"]</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        <h5 class="fw-bold">@Model.DiscountPercentage.ToString("F0")%</h5>
                        <p class="mb-0 text-muted">@Localizer["Discount"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Combined Price and Add to Cart Section -->
    <div class="mb-5" style="padding: 3rem 2rem; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 20px; margin: 2rem 0; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div class="row align-items-center g-4">
            <!-- Price Section (Left Side) -->
            <div class="col-lg-6 text-center text-lg-start">
                <h3 class="text-muted mb-3">@Localizer["SpecialPrice"]</h3>
                <div class="price-original">
                    @Html.Raw(currencySymbol)@Model.OriginalTotalPrice.ToString("N2")
                </div>
                <div class="price-combo">
                    @Html.Raw(currencySymbol)@Model.ComboPrice.ToString("N2")
                </div>
                <div class="savings-badge">
                    <i class="bi bi-tag-fill me-2"></i>@Localizer["YouSave"] @Html.Raw(currencySymbol)@Model.TotalSavings.ToString("N2")
                </div>
            </div>
            
            <!-- Add to Cart Section (Right Side) -->
            <div class="col-lg-6 text-center">
                @if (!Model.IsCurrentlyActive)
                {
                    <div class="alert alert-warning text-center mb-3" role="alert">
                        @if (Model.HasEnded)
                        {
                            <i class="bi bi-clock-history me-2"></i>@Localizer["ComboOfferHasEnded"]
                        }
                        else if (!Model.HasStarted)
                        {
                            <i class="bi bi-calendar-event me-2"></i>@Localizer["ComboOfferNotStartedYet"]
                        }
                        else if (!Model.IsActive)
                        {
                            <i class="bi bi-x-circle me-2"></i>@Localizer["ComboOfferNotAvailable"]
                        }
                        else if (!Model.HasAvailableStock)
                        {
                            <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["InsufficientStockForCombo"]
                        }
                        else
                        {
                            <i class="bi bi-x-circle me-2"></i>@Localizer["ComboOfferNotAvailable"]
                        }
                    </div>
                }
                
                <!-- Add to Cart Button -->
                <form asp-action="AddToCart" method="post" style="display: block !important;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="comboOfferId" value="@Model.Id" />
                    <button type="submit" 
                            id="addComboToCartBtn"
                            class="btn btn-lg w-100" 
                            style="font-size: 1.3rem !important; 
                                   padding: 1.2rem 2rem !important; 
                                   display: inline-block !important; 
                                   visibility: visible !important; 
                                   opacity: 1 !important;
                                   cursor: @(Model.IsCurrentlyActive ? "pointer" : "not-allowed") !important;
                                   border: none !important;
                                   background: @(Model.IsCurrentlyActive ? "linear-gradient(135deg, #667eea 0%, #764ba2 100%)" : "#9ca3af") !important;
                                   color: white !important;
                                   border-radius: 50px !important;
                                   font-weight: 700 !important;
                                   box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4) !important;
                                   transition: all 0.3s ease !important;"
                            @(!Model.IsCurrentlyActive ? "disabled" : "")>
                        <i class="bi bi-cart-plus-fill me-2"></i>@Localizer["AddComboToCart"]
                    </button>
                </form>
                
                <p class="text-muted mt-3 mb-0" style="font-size: 0.9rem;">
                    <i class="bi bi-info-circle me-1"></i>@(currentCulture == "ar" ? "سيتم إضافة الكومبو الكامل إلى السلة" : "The entire combo will be added to your cart")
                </p>
            </div>
        </div>
    </div>

    <!-- Products Included Section -->
    <div class="mt-5">
        <h2 class="section-title">
            <i class="bi bi-box-seam-fill me-3"></i>@Localizer["ProductsIncluded"]
        </h2>
        
        @if (Model.ComboOfferItems != null && Model.ComboOfferItems.Any(i => !i.IsDeleted))
        {
            <div class="products-grid">
                @foreach (var item in Model.ComboOfferItems.Where(i => !i.IsDeleted).OrderBy(i => i.DisplayOrder))
                {
                    var productName = currentCulture == "ar" && !string.IsNullOrEmpty(item.Product?.TitleAr) 
                        ? item.Product.TitleAr 
                        : item.Product?.Title ?? "Unknown Product";
                    
                    var productImage = item.Product?.ProductImages?.FirstOrDefault(pi => pi.ImageInfo == null)?.ImageUrl 
                        ?? item.Product?.ImageUrl 
                        ?? "/images/no-image.png";
                    
                    var productPrice = item.ProductVariant != null
                        ? (double)item.ProductVariant.ListPrice
                        : (item.Product?.ListPrice ?? 0);
                    
                    <div class="product-card-combo">
                        <div class="product-image-wrapper" style="cursor: pointer;" >
                            <img src="@productImage" alt="@productName" />
                            <div class="product-quantity-badge">
                                x @item.Quantity
                            </div>
                            @if (item.IsRequired)
                            {
                                <div class="required-badge">
                                    <i class="bi bi-star-fill me-1"></i>@Localizer["Required"]
                                </div>
                            }
                        </div>
                        <div class="p-4">
                            <h5 class="fw-bold mb-2" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "Home", new { area = "Customer", productId = item.ProductId })'">@productName</h5>
                            @if (item.ProductVariant != null)
                            {
                                string variantName = "";
                                if (item.ProductVariant.VariantOptionValues != null && item.ProductVariant.VariantOptionValues.Any())
                                {
                                    var optionValues = item.ProductVariant.VariantOptionValues
                                        .OrderBy(vov => vov.OptionValue?.ProductOption?.DisplayOrder ?? 0)
                                        .ThenBy(vov => vov.OptionValue?.DisplayOrder ?? 0)
                                        .Select(
                                        vov =>
                                        {
                                            var optionName = (currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue?.ProductOption?.NameAr))
                                                        ? vov.OptionValue.ProductOption.NameAr
                                                        : vov.OptionValue?.ProductOption?.Name;

                                            var optionValue = (currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue?.ValueAr))
                                                        ? vov.OptionValue.ValueAr
                                                        : vov.OptionValue?.Value;

                                            return $"{optionName}: {optionValue}";
                                        }
                                        )
                                        .Where(s => !string.IsNullOrEmpty(s))
                                        .ToList();
                                    variantName = string.Join(" / ", optionValues);
                                }
                                else if (!string.IsNullOrEmpty(item.ProductVariant.VariantName))
                                {
                                    variantName = item.ProductVariant.VariantName;
                                }
                                
                                if (!string.IsNullOrEmpty(variantName))
                                {
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-palette me-1"></i>@variantName
                                    </p>
                                }
                            }
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-primary fw-bold">
                                    @Html.Raw(currencySymbol)@productPrice.ToString("N2")
                                </span>
                                <span class="text-muted">
                                    @Localizer["Qty"]: @item.Quantity
                                </span>
                            </div>
                          
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-box-seam display-1 text-muted"></i>
                <p class="text-muted mt-3">@Localizer["NoProductsInCombo"]</p>
            </div>
        }
    </div>
</div>
