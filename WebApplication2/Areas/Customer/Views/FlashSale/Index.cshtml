@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@model IEnumerable<FlashSale>

@{
    ViewData["Title"] = Localizer["FlashSalesLimitedTimeOffers"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<!-- Page Header -->
<section class="flash-sale-hero" style="margin-top: 0.5rem;">
    <div class="container">
        <div class="flash-sale-hero-content">
            <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap;">
                <i class="bi bi-lightning-charge-fill lightning-icon"></i>
                <h1 class="flash-sale-title text-white">@Localizer["AllFlashSales"]</h1>
                <i class="bi bi-fire fire-icon lightning-icon"></i>
            </div>
            <p class="flash-sale-subtitle text-white">
                @Localizer["DontMissIncredibleDeals"]
            </p>
        </div>
    </div>
</section>

@if (!Model.Any())
{
    <!-- Empty State -->
    <div class="flash-sale-empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-inbox"></i>
        </div>
        <h2 class="empty-state-title">@Localizer["NoActiveFlashSales"]</h2>
        <p class="empty-state-text">
            @Localizer["CheckBackForAmazingDeals"]
        </p>
        <a href="@Url.Action("Index", "Home")" class="view-all-flash-sales-btn mt-4">
            <i class="bi bi-house-fill me-2"></i>
            @Localizer["BackToHome"]
        </a>
    </div>
}
else
{
    @foreach (var flashSale in Model)
    {
        var flashSaleItems = flashSale.FlashSaleItems.Where(i => i.FlashSaleQuantity > 0 && i.Product != null).ToList();
        
        if (!flashSaleItems.Any()) continue;

        <!-- Flash Sale Section -->
        <section class="flash-sale-products">
            <div class="container">
                <!-- Flash Sale Header -->
                <div class="card mb-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px; padding: 1rem; color: white;">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            @{
                                var flashSaleName = currentCulture == "ar" && !string.IsNullOrEmpty(flashSale.NameAr) 
                                    ? flashSale.NameAr 
                                    : flashSale.Name;
                                var flashSaleDesc = currentCulture == "ar" && !string.IsNullOrEmpty(flashSale.DescriptionAr) 
                                    ? flashSale.DescriptionAr 
                                    : flashSale.Description;
                            }
                            <h2 class=" text-white" style="font-size: 1.4rem; font-weight: 900; margin-bottom: 0.5rem;">
                                <i class="bi bi-lightning-charge-fill me-2" style="font-size: 1.2rem;"></i>
                                @flashSaleName
                            </h2>
                            @if (!string.IsNullOrEmpty(flashSaleDesc))
                            {
                                <p class=" text-white" style="font-size: 0.85rem; opacity: 0.95; margin-bottom: 0;">
                                    @flashSaleDesc
                                </p>
                            }
                        </div>
                        <div class="col-md-4 text-end">
                            <div style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); padding: 0.8rem; border-radius: 10px;">
                                <div style="font-size: 0.7rem; opacity: 0.9; margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.5px;">@Localizer["ENDSIN"]</div>
                                <div id="timer_@flashSale.Id" data-flash-sale-end="@flashSale.EndDate.ToString("o")" class="flash-sale-timer" style="display: flex; justify-content: center; gap: 0.3rem; flex-wrap: wrap;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Products Grid -->
                <div class="row g-4">
                    @foreach (var item in flashSaleItems)
                    {
                        var product = item.Product;
                        var variant = item.ProductVariant;
                        
                        // Use variant image if available, otherwise product image
                        var imageUrl = variant?.ImageUrl ?? (product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/default-product.jpg");
                        
                        // Use variant stock/price if variant exists
                        var availableStock = variant?.StockQuantity ?? product.StockQuantity;
                        var originalPrice = variant?.Price ?? (decimal)product.Price;
                        var stockPercentage = (double)item.FlashSaleQuantity / Math.Max(availableStock, 1) * 100;
                        var isLowStock = item.FlashSaleQuantity <= 5;
                        var isCriticalStock = item.FlashSaleQuantity <= 2;
                        
                        // Build variant name string with localization
                        string variantName = "";
                        if (variant != null && variant.VariantOptionValues != null)
                        {
                            var optionValues = variant.VariantOptionValues
                                .OrderBy(vov => vov.OptionValue?.ProductOption?.DisplayOrder ?? 0)
                                .ThenBy(vov => vov.OptionValue?.DisplayOrder ?? 0)
                                .Select(vov => 
                                {
                                    if (vov.OptionValue == null) return "";
                                    
                                    var optionName = currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue.ProductOption?.NameAr) 
                                        ? vov.OptionValue.ProductOption.NameAr 
                                        : vov.OptionValue.ProductOption?.Name ?? "";
                                    var optionValue = currentCulture == "ar" && !string.IsNullOrEmpty(vov.OptionValue.ValueAr) 
                                        ? vov.OptionValue.ValueAr 
                                        : vov.OptionValue.Value ?? "";
                                    
                                    if (string.IsNullOrEmpty(optionName) || string.IsNullOrEmpty(optionValue))
                                        return optionValue ?? optionName ?? "";
                                    
                                    return $"{optionName}: {optionValue}";
                                })
                                .Where(s => !string.IsNullOrEmpty(s))
                                .ToList();
                            variantName = string.Join(", ", optionValues);
                        }
                        
                        // Get localized product name
                        var productName = currentCulture == "ar" && !string.IsNullOrEmpty(product.TitleAr) 
                            ? product.TitleAr 
                            : product.Title;

                        <div class="col-md-6 col-lg-4 col-xl-3">
                            <div class="flash-sale-product-card">
                                <!-- Flash Sale Badge -->
                                <div class="flash-sale-badge">
                                    <i class="bi bi-lightning-fill"></i>
                                    -@Math.Round(item.DiscountPercentage)% @Localizer["OFF"]
                                </div>

                                <!-- Product Image -->
                                <div class="flash-sale-product-image-wrapper">
                                    <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-slug="@product.GetSlug()">
                                        <img src="@imageUrl" alt="@productName" class="flash-sale-product-image" />
                                    </a>
                                    <div class="fire-effect">🔥</div>
                                </div>

                                <!-- Product Info -->
                                <div class="flash-sale-product-info">
                                    <!-- Product Timer -->
                                    <div class="flash-sale-product-timer">
                                        <i class="bi bi-clock-fill me-2"></i>
                                        @Localizer["EndsIn"]: <span id="productTimer_@item.Id" data-product-timer-end="@flashSale.EndDate.ToString("o")"></span>
                                    </div>

                                    <!-- Product Title -->
                                    <h4 class="flash-sale-product-title">
                                        <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-slug="@product.GetSlug()" style="color: inherit; text-decoration: none;">
                                            @productName
                                        </a>
                                    </h4>

                                    <!-- Variant Info (if exists) -->
                                    @if (!string.IsNullOrEmpty(variantName))
                                    {
                                        <div class="flash-sale-variant-info" style="background: #f0f0f0; padding: 0.5rem; border-radius: 6px; margin: 0.5rem 0; font-size: 0.85rem; color: #666;">
                                            <i class="bi bi-tag-fill me-1"></i>
                                            <strong>@Localizer["Variant"]:</strong> @variantName
                                        </div>
                                    }

                                    <!-- Price Section -->
                                    <div class="flash-sale-price-section">
                                        <div class="flash-sale-prices">
                                            <span class="flash-sale-normal-price">@Html.Raw(currencySymbol) @originalPrice.ToString("N2")</span>
                                            <span class="flash-sale-current-price">@Html.Raw(currencySymbol) @item.FlashSalePrice.ToString("N2")</span>
                                        </div>
                                        <div class="flash-sale-discount-badge">
                                            @Localizer["SAVE"] @Html.Raw(currencySymbol) @((originalPrice - (decimal)item.FlashSalePrice).ToString("N2"))
                                        </div>
                                    </div>

                                    <!-- Stock Progress -->
                                    <div class="flash-sale-stock-info">
                                        @if (isCriticalStock)
                                        {
                                            <div class="stock-urgent">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                @Localizer["Only"] @item.FlashSaleQuantity @Localizer["leftHurry"]
                                            </div>
                                        }
                                        else if (isLowStock)
                                        {
                                            <div class="stock-urgent" style="color: #f39c12;">
                                                <i class="bi bi-exclamation-circle-fill me-1"></i>
                                                @Localizer["AlmostGone"] @item.FlashSaleQuantity @Localizer["remaining"]
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="stock-progress-label">
                                                <span><i class="bi bi-box-seam me-1"></i>@Localizer["Available"]:</span>
                                                <span><strong>@item.FlashSaleQuantity</strong> @Localizer["units"]</span>
                                            </div>
                                        }
                                        <div class="stock-progress-bar-wrapper" data-stock-percentage="@stockPercentage">
                                            <div class="stock-progress-bar-fill" style="width: 0%;"></div>
                                        </div>
                                    </div>

                                    <!-- Add to Cart Button -->
                                    <button type="button" 
                                            onclick="addFlashSaleToCart(@item.Id, @product.Id, @item.FlashSalePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @(item.ProductVariantId?.ToString() ?? "null"))" 
                                            class="flash-sale-add-to-cart-btn"
                                            @(item.FlashSaleQuantity <= 0 ? "disabled" : "")>
                                        <i class="bi bi-cart-plus-fill me-2"></i>
                                        @Localizer["AddToCart"]
                                    </button>
                                </div>

                                <!-- Sold Out Overlay (if applicable) -->
                                @if (item.FlashSaleQuantity <= 0)
                                {
                                    <div class="sold-out-overlay">
                                        <div class="sold-out-text">@Localizer["SOLDOUT"]</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <hr style="margin: 2rem 0; border: none; height: 1px; background: linear-gradient(90deg, transparent, #ddd, transparent);" />
            </div>
        </section>
    }
}

@section Scripts {
    <script src="~/js/flash-sale-customer.js"></script>
    <script>
        // Initialize all flash sale timers
        document.addEventListener('DOMContentLoaded', function() {
            // Main timers for each flash sale
            document.querySelectorAll('[data-flash-sale-end]').forEach(timerElement => {
                if (timerElement.id.startsWith('timer_')) {
                    const endDate = timerElement.getAttribute('data-flash-sale-end');
                    const timerId = timerElement.id;
                    const timer = new FlashSaleTimer(endDate, timerId, () => {
                        location.reload(); // Reload when timer expires
                    });
                    timer.start();
                }
            });
            
            // Product timers
            document.querySelectorAll('[data-product-timer-end]').forEach(timerElement => {
                const endDate = timerElement.getAttribute('data-product-timer-end');
                const timerId = timerElement.id;
                const timer = new ProductFlashTimer(endDate, timerId);
                timer.start();
            });
            
            // Update stock progress bars
            document.querySelectorAll('[data-stock-percentage]').forEach(bar => {
                const percentage = parseFloat(bar.getAttribute('data-stock-percentage'));
                const fillElement = bar.querySelector('.stock-progress-bar-fill');
                if (fillElement) {
                    fillElement.style.width = percentage + '%';
                    
                    // Change color based on stock level
                    if (percentage < 20) {
                        fillElement.style.background = 'linear-gradient(90deg, #e74c3c, #c0392b)';
                    } else if (percentage < 50) {
                        fillElement.style.background = 'linear-gradient(90deg, #f39c12, #e67e22)';
                    }
                }
            });
        });
    </script>
}
