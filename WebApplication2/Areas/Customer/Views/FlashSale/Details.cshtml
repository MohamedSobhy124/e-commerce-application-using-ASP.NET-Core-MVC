@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@model FlashSale

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var flashSaleName = currentCulture == "ar" && !string.IsNullOrEmpty(Model.NameAr) 
        ? Model.NameAr 
        : Model.Name;
    ViewData["Title"] = flashSaleName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<!-- Page Header -->
<section class="flash-sale-hero" style="margin-top: 1rem;">
    <div class="container">
        <div class="flash-sale-hero-content">
            @{
                var flashSaleDesc = currentCulture == "ar" && !string.IsNullOrEmpty(Model.DescriptionAr) 
                    ? Model.DescriptionAr 
                    : Model.Description;
            }
            <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap;">
                <i class="bi bi-lightning-charge-fill lightning-icon"></i>
                <h1 class="flash-sale-title">@flashSaleName</h1>
                <i class="bi bi-fire fire-icon lightning-icon"></i>
            </div>
            @if (!string.IsNullOrEmpty(flashSaleDesc))
            {
                <p class="flash-sale-subtitle">
                    @flashSaleDesc
                </p>
            }
            else
            {
                <p class="flash-sale-subtitle">
                    @Localizer["DontMissIncredibleDeals"]
                </p>
            }
        </div>
        
        <!-- Countdown Timer -->
        <div class="flash-sale-timer">
            <div style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); padding: 1.5rem; border-radius: 15px; margin-top: 2rem;">
                <div style="font-size: 0.9rem; opacity: 0.9; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; text-align: center; color: white;">@Localizer["ENDSIN"]</div>
                <div id="mainTimer" data-flash-sale-end="@Model.EndDate.ToString("o")" style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;"></div>
            </div>
        </div>
    </div>
</section>

@{
    var flashSaleItems = Model.FlashSaleItems?.Where(i => i.FlashSaleQuantity > 0 && i.Product != null).ToList() ?? new List<FlashSaleItem>();
}

@if (!flashSaleItems.Any())
{
    <!-- Empty State -->
    <div class="flash-sale-empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-inbox"></i>
        </div>
        <h2 class="empty-state-title">@Localizer["NoActiveFlashSales"]</h2>
        <p class="empty-state-text">
            @Localizer["CheckBackForAmazingDeals"]
        </p>
        <a href="@Url.Action("Index", "FlashSale")" class="view-all-flash-sales-btn mt-4">
            <i class="bi bi-arrow-left me-2"></i>
            @Localizer["Back"]
        </a>
    </div>
}
else
{
    <!-- Flash Sale Section -->
    <section class="flash-sale-products">
        <div class="container">
            <!-- Products Grid -->
            <div class="row g-4">
                @foreach (var item in flashSaleItems)
                {
                    var product = item.Product;
                    var imageUrl = product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/default-product.jpg";
                    var stockPercentage = (double)item.FlashSaleQuantity / Math.Max(product.StockQuantity, 1) * 100;
                    var isLowStock = item.FlashSaleQuantity <= 5;
                    var isCriticalStock = item.FlashSaleQuantity <= 2;

                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="flash-sale-product-card">
                            <!-- Flash Sale Badge -->
                            <div class="flash-sale-badge">
                                <i class="bi bi-lightning-fill"></i>
                                -@Math.Round(item.DiscountPercentage)% @Localizer["OFF"]
                            </div>

                            <!-- Product Image -->
                            <div class="flash-sale-product-image-wrapper">
                                <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-productId="@product.Id">
                                    <img src="@imageUrl" alt="@product.Title" class="flash-sale-product-image" />
                                </a>
                                <div class="fire-effect">🔥</div>
                            </div>

                            <!-- Product Info -->
                            <div class="flash-sale-product-info">
                                <!-- Product Timer -->
                                <div class="flash-sale-product-timer">
                                    <i class="bi bi-clock-fill me-2"></i>
                                    @Localizer["EndsIn"]: <span id="productTimer_@item.Id" data-product-timer-end="@Model.EndDate.ToString("o")"></span>
                                </div>

                                <!-- Product Title -->
                                <h4 class="flash-sale-product-title">
                                    <a asp-area="Customer" asp-controller="Home" asp-action="Details" asp-route-productId="@product.Id" style="color: inherit; text-decoration: none;">
                                        @product.Title
                                    </a>
                                </h4>

                                <!-- Price Section -->
                                <div class="flash-sale-price-section">
                                    <div class="flash-sale-prices">
                                        <span class="flash-sale-normal-price">@Html.Raw(currencySymbol) @product.Price.ToString("N2")</span>
                                        <span class="flash-sale-current-price">@Html.Raw(currencySymbol) @item.FlashSalePrice.ToString("N2")</span>
                                    </div>
                                    <div class="flash-sale-discount-badge">
                                        @Localizer["SAVE"] @Html.Raw(currencySymbol) @((product.Price - (double)item.FlashSalePrice).ToString("N2"))
                                    </div>
                                </div>

                                <!-- Stock Progress -->
                                <div class="flash-sale-stock-info">
                                    @if (isCriticalStock)
                                    {
                                        <div class="stock-urgent">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            @Localizer["Only"] @item.FlashSaleQuantity @Localizer["leftHurry"]
                                        </div>
                                    }
                                    else if (isLowStock)
                                    {
                                        <div class="stock-urgent" style="color: #f39c12;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                                            @Localizer["AlmostGone"] @item.FlashSaleQuantity @Localizer["remaining"]
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="stock-progress-label">
                                            <span><i class="bi bi-box-seam me-1"></i>@Localizer["Available"]:</span>
                                            <span><strong>@item.FlashSaleQuantity</strong> @Localizer["units"]</span>
                                        </div>
                                    }
                                    <div class="stock-progress-bar-wrapper" data-stock-percentage="@stockPercentage">
                                        <div class="stock-progress-bar-fill" style="width: 0%;"></div>
                                    </div>
                                </div>

                                <!-- Add to Cart Button -->
                                <button type="button" 
                                        onclick="addFlashSaleToCart(@item.Id, @product.Id, @item.FlashSalePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" 
                                        class="flash-sale-add-to-cart-btn"
                                        @(item.FlashSaleQuantity <= 0 ? "disabled" : "")>
                                    <i class="bi bi-cart-plus-fill me-2"></i>
                                    @Localizer["AddToCart"]
                                </button>
                            </div>

                            <!-- Sold Out Overlay (if applicable) -->
                            @if (item.FlashSaleQuantity <= 0)
                            {
                                <div class="sold-out-overlay">
                                    <div class="sold-out-text">@Localizer["SOLDOUT"]</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <!-- Back Button -->
            <div class="text-center mt-5">
                <a href="@Url.Action("Index", "FlashSale")" class="view-all-flash-sales-btn">
                    <i class="bi bi-arrow-left me-2"></i>
                    @Localizer["Back"]
                </a>
            </div>
        </div>
    </section>
}

@section Scripts {
    <script src="~/js/flash-sale-customer.js"></script>
    <script>
        // Initialize all flash sale timers
        document.addEventListener('DOMContentLoaded', function() {
            // Main timer
            const mainTimer = document.getElementById('mainTimer');
            if (mainTimer) {
                const endDate = mainTimer.getAttribute('data-flash-sale-end');
                const timer = new FlashSaleTimer(endDate, 'mainTimer', () => {
                    location.reload(); // Reload when timer expires
                });
                timer.start();
            }
            
            // Product timers
            document.querySelectorAll('[data-product-timer-end]').forEach(timerElement => {
                const endDate = timerElement.getAttribute('data-product-timer-end');
                const timerId = timerElement.id;
                const timer = new ProductFlashTimer(endDate, timerId);
                timer.start();
            });
            
            // Update stock progress bars
            document.querySelectorAll('[data-stock-percentage]').forEach(bar => {
                const percentage = parseFloat(bar.getAttribute('data-stock-percentage'));
                const fillElement = bar.querySelector('.stock-progress-bar-fill');
                if (fillElement) {
                    fillElement.style.width = percentage + '%';
                    
                    // Change color based on stock level
                    if (percentage < 20) {
                        fillElement.style.background = 'linear-gradient(90deg, #e74c3c, #c0392b)';
                    } else if (percentage < 50) {
                        fillElement.style.background = 'linear-gradient(90deg, #f39c12, #e67e22)';
                    }
                }
            });
        });
    </script>
}

