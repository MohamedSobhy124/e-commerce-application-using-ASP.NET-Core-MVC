@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["TermsAndConditions"];
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="page-header text-center mb-5">
                <h1 class="display-4" style="color: #1976D2; font-weight: 800;">
                    <i class="bi bi-file-earmark-text me-3"></i>
                    @if(currentLang == "ar") {
                        <text>شروط الاستخدام</text>
                    } else {
                        <text>Terms of Use</text>
                    }
                </h1>
                <div class="underline" style="width: 100px; height: 4px; background: linear-gradient(90deg, #3B9DD5, #7BC043); margin: 1rem auto;"></div>
            </div>

            @if(currentLang == "ar") 
            {
                <!-- Arabic Content -->
                <div class="content-section" style="direction: rtl; text-align: right;">
                    <!-- Privacy Policy Reference -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #3B9DD5; font-weight: 700;">
                                <i class="bi bi-shield-lock me-3"></i>سياسة الخصوصية
                            </h2>
                            <p class="lead" style="line-height: 1.8; color: #555;">
                                يرجى الاطلاع على سياسة الخصوصية التي بموجبها نقدم خدماتنا لعملائنا لفهم ممارساتنا من سياسة الخصوصية.
                            </p>
                        </div>
                    </div>

                    <!-- Payment and Purchases -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-credit-card me-3"></i>الدفع والمشتريات
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                أنت توافق على تقديم بيانات الحساب الحالية والدقيقة والكاملة ومعلومات الشراء لجميع المشتريات التي تتم من خلال الموقع بما في ذلك البريد الإلكتروني وطريقة الدفع وتاريخ انتهاء صلاحية بطاقة الدفع 
                                حتى نتمكن من إكمال معاملاتك والاتصال بك حسب الحاجة. كما توافق على تحديث معلومات الحساب والدفع بسرعة معك إذا لزم الأمر.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                سيتم إضافة قيمة ضريبة المبيعات إلى سعر الشراء وفقًا لما نعتبره مطلوبًا. قد تخضع الأسعار للتغيير من قبلنا في أي وقت. يجب أن تكون جميع المدفوعات بالدرهم الإماراتي. 
                                لاحظ أنه أثناء الدفع، قد تفرض عليك البنك رسومًا إضافية للدفع بعملة مختلفة، ومعدل العملة عرضة للتغيير.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                أنت توافق على دفع جميع الرسوم لمشترياتك بالأسعار المعمول بها وأي رسوم شحن معمول بها، وتخولنا تحصيل المبالغ اللازمة لأي رسوم من مزود الدفع الخاص بك عند تقديم الطلب. 
                                إذا كان طلبك يخضع لرسوم دورية، فإنك توافق على تحصيل طريقة الدفع الخاصة بك على أساس دوري دون الحاجة إلى موافقتك المسبقة على كل معاملة لمثل هذه الرسوم، حتى تلغي الطلب.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                نحتفظ بالحق في تصحيح أي أخطاء في التسعير أو عدم الدقة حتى لو طلبنا أو تلقينا الدفع. نحتفظ بالحق في رفض أي طلب يتم تقديمه من خلال الموقع. 
                                يجوز لنا، وفقًا لتقديرنا الخاص، تحديد أو إلغاء الكميات المشتراة لكل شخص أو أسرة أو طلب. قد تشمل هذه القيود الطلبات المقدمة من أو تحت نفس حساب العميل، أو نفس طريقة الدفع، أو تلك التي تستخدم نفس عنوان الفوترة أو الشحن.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                نحتفظ أيضًا بالحق في تحديد أو منع الطلبات، وفقًا لتقديرنا الخاص، التي يبدو أنها تم تقديمها من قبل التجار أو الموزعين أو الموزعين. 
                                لاحظ أن منتجات التصفية لا تخضع للتبديل أو الإلغاء.
                            </p>
                        </div>
                    </div>

                    <!-- Validity -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #1976D2; font-weight: 700;">
                                <i class="bi bi-person-check me-3"></i>الصلاحية
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                باستخدام موقعنا، أنت تمثل وتضمن أنك تبلغ من العمر 18 عامًا على الأقل أو أكبر. أنت قادر على الوصول إلى الشروط والأحكام والتمثيلات والضمانات المنصوص عليها في هذه الاتفاقية وعرضها. 
                                الموقع غير مخصص أو مصمم للمستخدمين الذين تقل أعمارهم عن 18 عامًا. لا يتم جمع أي معلومات شخصية من أي شخص نحدده على أنه أقل من 18 عامًا.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                إذا كان عمرك أقل من 18 عامًا، فأنت غير مخول بالكشف عن أو إرسال أي معلومات شخصية إلينا. 
                                يتم إدارة الموقع من الإمارات العربية المتحدة والمعلومات الشخصية التي نتلقاها منا تخضع لسياسات الخصوصية في الإمارات العربية المتحدة.
                            </p>
                        </div>
