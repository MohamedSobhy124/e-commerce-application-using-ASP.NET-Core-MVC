                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #3B9DD5; font-weight: 700;">
                                <i class="bi bi-shield-lock me-3"></i>Privacy Policy
                            </h2>
                            <p class="lead" style="line-height: 1.8; color: #555;">
                                Please see the privacy policy under which we provide our services to our customers to understand our practices from Privacy & Policy.
                            </p>
                        </div>
                    </div>

                    <!-- Payment and Purchases -->
                    <div class="card mb-4 border-0 shadow-sm">
