@model OrderHeader

@{
    ViewData["Title"] = "Order Tracking";
    var orderDetails = ViewBag.OrderDetails as IEnumerable<OrderDetail>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-check-circle me-2"></i>
                        Order #@Model.Id
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Order Status:</strong> @Model.OrderStatus
                        <br />
                        <strong>Payment Status:</strong> @Model.PaymentStatus
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3">
                                <i class="bi bi-person me-2"></i>
                                Customer Information
                            </h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Name:</strong></td>
                                    <td>@Model.Name</td>
                                </tr>
                                <tr>
                                    <td><strong>Email:</strong></td>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <td><strong>Phone:</strong></td>
                                    <td>@Model.PhoneNumber</td>
                                </tr>
                            </table>
                        </div>

                        <div class="col-md-6">
                            <h5 class="mb-3">
                                <i class="bi bi-truck me-2"></i>
                                Shipping Information
                            </h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Address:</strong></td>
                                    <td>
                                        @Model.StreetAddress<br />
                                        @Model.City, @Model.State @Model.PostalCode
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.Carrier))
                                {
                                    <tr>
                                        <td><strong>Carrier:</strong></td>
                                        <td>@Model.Carrier</td>
                                    </tr>
                                }
                                @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                                {
                                    <tr>
                                        <td><strong>Tracking #:</strong></td>
                                        <td>@Model.TrackingNumber</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                    <hr />

                    <h5 class="mb-3">
                        <i class="bi bi-basket3 me-2"></i>
                        Order Items
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in orderDetails)
                                {
                                    <tr>
                                        <td>@item.Product.Title</td>
                                        <td>@item.Price.ToString("c")</td>
                                        <td>@item.Count</td>
                                        <td class="text-end">@((item.Price * item.Count).ToString("c"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Order Total:</strong></td>
                                    <td class="text-end"><strong>@Model.OrderTotal.ToString("c")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p class="text-muted">
                                <i class="bi bi-calendar me-2"></i>
                                <strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy")
                            </p>
                        </div>
                        @if (Model.ShippingDate != DateTime.MinValue)
                        {
                            <div class="col-md-6">
                                <p class="text-muted">
                                    <i class="bi bi-truck me-2"></i>
                                    <strong>Shipping Date:</strong> @Model.ShippingDate.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="text-center mb-4">
                <a asp-action="TrackOrder" class="btn btn-outline-primary me-2">
                    <i class="bi bi-search me-2"></i>
                    Track Another Order
                </a>
                <a asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-shop me-2"></i>
                    Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 15px;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
        padding: 1.5rem;
    }

    .table-borderless td {
        padding: 0.5rem 1rem;
    }
</style>

