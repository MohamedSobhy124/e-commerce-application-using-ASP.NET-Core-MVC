@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error"] ?? "Error";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var isRtl = currentCulture == "ar";
}

<div class="error-page-container">
    <div class="error-content-wrapper">
        <div class="error-animation">
            <div class="error-icon-wrapper">
                @if (Model.StatusCode == 404)
                {
                    <i class="bi bi-file-earmark-x-fill error-icon" style="color: #3b82f6;"></i>
                }
                else if (Model.StatusCode == 500)
                {
                    <i class="bi bi-exclamation-octagon-fill error-icon" style="color: #ef4444;"></i>
                }
                else
                {
                    <i class="bi bi-exclamation-triangle-fill error-icon" style="color: #f59e0b;"></i>
                }
            </div>
            <div class="error-particles">
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
                <div class="particle"></div>
            </div>
        </div>

        <div class="error-message-section">
            <h1 class="error-title">
                @if (Model.StatusCode == 404)
                {
                    @if (isRtl)
                    {
                        <text>الصفحة غير موجودة</text>
                    }
                    else
                    {
                        <text>Page Not Found</text>
                    }
                }
                else if (Model.StatusCode == 500)
                {
                    @if (isRtl)
                    {
                        <text>خطأ في الخادم</text>
                    }
                    else
                    {
                        <text>Server Error</text>
                    }
                }
                else
                {
                    @if (isRtl)
                    {
                        <text>عذراً، حدث خطأ</text>
                    }
                    else
                    {
                        <text>Oops! Something Went Wrong</text>
                    }
                }
            </h1>
            
            <p class="error-description">
                @if (Model.StatusCode == 404)
                {
                    @if (isRtl)
                    {
                        <text>عذراً، الصفحة التي تبحث عنها غير موجودة. قد تكون الصفحة قد تم نقلها أو حذفها.</text>
                    }
                    else
                    {
                        <text>Sorry, the page you're looking for doesn't exist. The page may have been moved or deleted.</text>
                    }
                }
                else if (Model.StatusCode == 500)
                {
                    @if (isRtl)
                    {
                        <text>حدث خطأ داخلي في الخادم. يرجى المحاولة مرة أخرى لاحقاً أو الاتصال بالدعم.</text>
                    }
                    else
                    {
                        <text>An internal server error occurred. Please try again later or contact support.</text>
                    }
                }
                else
                {
                    @if (isRtl)
                    {
                        <text>نعتذر عن الإزعاج. يبدو أن شيئاً ما لم يعمل بشكل صحيح. يرجى المحاولة مرة أخرى أو العودة إلى الصفحة الرئيسية.</text>
                    }
                    else
                    {
                        <text>We apologize for the inconvenience. It seems something didn't work as expected. Please try again or return to the homepage.</text>
                    }
                }
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="error-request-id">
                    <small>
                        @if (isRtl)
                        {
                            <text>معرف الطلب:</text>
                        }
                        else
                        {
                            <text>Request ID:</text>
                        }
                        <code>@Model.RequestId</code>
                    </small>
                </div>
            }
        </div>

        <div class="error-actions">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn-error-primary">
                <i class="bi bi-house-door me-2"></i>
                @if (isRtl)
                {
                    <text>العودة للصفحة الرئيسية</text>
                }
                else
                {
                    <text>Go to Homepage</text>
                }
            </a>
            
            <button onclick="window.history.back()" class="btn-error-secondary">
                <i class="bi bi-arrow-left me-2"></i>
                @if (isRtl)
                {
                    <text>العودة للخلف</text>
                }
                else
                {
                    <text>Go Back</text>
                }
            </button>
        </div>

        <div class="error-help-section">
            <div class="help-card">
                <i class="bi bi-question-circle-fill help-icon"></i>
                <h3>
                    @if (isRtl)
                    {
                        <text>تحتاج مساعدة؟</text>
                    }
                    else
                    {
                        <text>Need Help?</text>
                    }
                </h3>
                <p>
                    @if (isRtl)
                    {
                        <text>إذا استمرت المشكلة، يرجى التواصل معنا</text>
                    }
                    else
                    {
                        <text>If the problem persists, please contact our support team</text>
                    }
                </p>
                <a asp-area="Customer" asp-controller="Home" asp-action="HelpCenter" class="help-link">
                    @if (isRtl)
                    {
                        <text>مركز المساعدة</text>
                    }
                    else
                    {
                        <text>Help Center</text>
                    }
                    <i class="bi bi-arrow-left ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .error-page-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        overflow: hidden;
    }

    .error-page-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="100" height="100" patternUnits="userSpaceOnUse"><path d="M 100 0 L 0 0 0 100" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(%23grid)"/></svg>');
        opacity: 0.3;
        animation: gridMove 20s linear infinite;
    }

    @@keyframes gridMove {
        0% { transform: translate(0, 0); }
        100% { transform: translate(100px, 100px); }
    }

    .error-content-wrapper {
        max-width: 700px;
        width: 100%;
        background: white;
        border-radius: 30px;
        padding: 3rem 2.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        position: relative;
        z-index: 1;
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .error-animation {
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
    }

    .error-icon-wrapper {
        position: relative;
        display: inline-block;
    }

    .error-icon {
        font-size: 6rem;
        animation: pulse 2s ease-in-out infinite;
        filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.2));
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }
        50% {
            transform: scale(1.1);
            opacity: 0.9;
        }
    }

    .error-particles {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        height: 200px;
        pointer-events: none;
    }

    .error-particles .particle {
        position: absolute;
        width: 8px;
        height: 8px;
        background: #f59e0b;
        border-radius: 50%;
        opacity: 0.6;
        animation: float 3s ease-in-out infinite;
    }

    .error-particles .particle:nth-child(1) {
        top: 20%;
        left: 20%;
        animation-delay: 0s;
    }

    .error-particles .particle:nth-child(2) {
        top: 30%;
        right: 20%;
        animation-delay: 0.5s;
    }

    .error-particles .particle:nth-child(3) {
        bottom: 20%;
        left: 30%;
        animation-delay: 1s;
    }

    .error-particles .particle:nth-child(4) {
        bottom: 30%;
        right: 30%;
        animation-delay: 1.5s;
    }

    .error-particles .particle:nth-child(5) {
        top: 50%;
        left: 50%;
        animation-delay: 2s;
    }

    @@keyframes float {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.6;
        }
        50% {
            transform: translate(20px, -20px) scale(1.2);
            opacity: 1;
        }
    }

    .error-message-section {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .error-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    .error-description {
        font-size: 1.1rem;
        color: #6b7280;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .error-request-id {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: #f3f4f6;
        border-radius: 10px;
        display: inline-block;
    }

    .error-request-id code {
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        color: #374151;
        background: white;
        padding: 0.25rem 0.5rem;
        border-radius: 5px;
        margin-left: 0.5rem;
    }

    .error-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }

    .btn-error-primary,
    .btn-error-secondary {
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-error-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-error-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
        color: white;
        text-decoration: none;
    }

    .btn-error-secondary {
        background: white;
        color: #374151;
        border: 2px solid #e5e7eb;
    }

    .btn-error-secondary:hover {
        background: #f9fafb;
        border-color: #d1d5db;
        transform: translateY(-2px);
        color: #374151;
    }

    .error-help-section {
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 2px solid #e5e7eb;
    }

    .help-card {
        text-align: center;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        border-radius: 15px;
        border: 2px solid #bae6fd;
    }

    .help-icon {
        font-size: 2.5rem;
        color: #0ea5e9;
        margin-bottom: 1rem;
    }

    .help-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e40af;
        margin-bottom: 0.5rem;
    }

    .help-card p {
        color: #475569;
        margin-bottom: 1rem;
        font-size: 0.95rem;
    }

    .help-link {
        color: #0ea5e9;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
    }

    .help-link:hover {
        color: #0284c7;
        text-decoration: underline;
    }

    /* RTL Support */
    [dir="rtl"] .error-actions {
        flex-direction: row-reverse;
    }

    [dir="rtl"] .btn-error-primary i,
    [dir="rtl"] .btn-error-secondary i {
        margin-left: 0.5rem;
        margin-right: 0;
    }

    [dir="rtl"] .help-link i {
        margin-left: 0;
        margin-right: 0.5rem;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .error-content-wrapper {
            padding: 2rem 1.5rem;
            border-radius: 20px;
        }

        .error-icon {
            font-size: 4rem;
        }

        .error-title {
            font-size: 2rem;
        }

        .error-description {
            font-size: 1rem;
        }

        .error-actions {
            flex-direction: column;
        }

        .btn-error-primary,
        .btn-error-secondary {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 480px) {
        .error-page-container {
            padding: 1rem;
        }

        .error-content-wrapper {
            padding: 1.5rem 1rem;
        }

        .error-title {
            font-size: 1.75rem;
        }
    }
</style>

