<!-- OLD CODE - Commented out, will be replaced by lazy-loaded sections
@{
    var activeFlashSales = ViewBag.ActiveFlashSales as IEnumerable<FlashSale> ?? Enumerable.Empty<FlashSale>();
    var hasActiveFlashSales = activeFlashSales.Any();
}

@if (hasActiveFlashSales)
{
    <!-- FLASH SALE CAROUSEL SECTION -->
    <section class="flash-sale-carousel-section">
        <div class="container">
            <div class="flash-sale-carousel-wrapper">
                <button class="flash-sale-carousel-nav prev" data-action="prev-slide" aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>
                
                <div class="flash-sale-carousel" id="flashSaleCarousel">
                    @foreach (var flashSale in activeFlashSales)
                    {
                        var flashSaleName = currentCulture == "ar" && !string.IsNullOrEmpty(flashSale.NameAr) 
                            ? flashSale.NameAr 
                            : flashSale.Name;
                        var flashSaleDesc = currentCulture == "ar" && !string.IsNullOrEmpty(flashSale.DescriptionAr) 
                            ? flashSale.DescriptionAr 
                            : flashSale.Description;
                        
                        <div class="flash-sale-slide" 
                             data-flash-sale-id="@flashSale.Id"
                             data-flash-sale-end="@flashSale.EndDate.ToString("o")"
                             data-flash-sale-name="@flashSaleName"
                             data-action="open-flash-sale">
                            @if (!string.IsNullOrEmpty(flashSale.ImageUrl))
                            {
                                <img src="@flashSale.ImageUrl" alt="@flashSaleName" class="flash-sale-slide-image" />
                            }
                            else
                            {
                                <div class="flash-sale-slide-placeholder">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <h3>@flashSaleName</h3>
                                    @if (!string.IsNullOrEmpty(flashSaleDesc))
                                    {
                                        <p>@flashSaleDesc</p>
                                    }
                                </div>
                            }
                            <div class="flash-sale-slide-overlay">
                                <div class="flash-sale-slide-content">
                                    <h3 class="flash-sale-slide-title">@flashSaleName</h3>
                                    @if (!string.IsNullOrEmpty(flashSaleDesc))
                {
                                        <p class="flash-sale-slide-desc">@flashSaleDesc</p>
                                    }
                                    <div class="flash-sale-slide-timer" data-flash-sale-end="@flashSale.EndDate.ToString("o")">
                        <!-- Timer will be populated by JavaScript -->
                                    </div>
                                    <button class="flash-sale-slide-btn">
                                        @Localizer["ShopNow"]
                                        <i class="bi bi-arrow-left ms-2"></i>
                                    </button>
                                </div>
                            </div>
                    </div>
                }
                </div>
                
                <button class="flash-sale-carousel-nav next" data-action="next-slide" aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            
            <!-- Carousel Indicators -->
            <div class="flash-sale-carousel-indicators" id="flashSaleIndicators">
                @for (int i = 0; i < activeFlashSales.Count(); i++)
                {
                    <button class="flash-sale-indicator @(i == 0 ? "active" : "")" 
                            data-action="go-to-slide"
                            data-slide-index="@i"
                            aria-label="Go to slide @(i + 1)"></button>
                }
            </div>
            
            <!-- View All Button -->
            <div class="text-center mt-3">
                    <a href="@Url.Action("Index", "FlashSale", new { area = "Customer" })" class="view-all-flash-sales-btn">
                        @Localizer["ViewAllFlashSales"]
                    <i class="bi bi-arrow-right ms-2"></i>
                    </a>
            </div>
        </div>
    </section>
     
    <!-- Flash Sale Products Modal -->
    <div class="flash-sale-products-modal" id="flashSaleProductsModal">
        <div class="flash-sale-modal-overlay" onclick="closeFlashSaleProducts()"></div>
        <div class="flash-sale-modal-content">
            <button class="flash-sale-modal-close" onclick="closeFlashSaleProducts()">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="flash-sale-modal-header">
                <h2 id="modalFlashSaleTitle"></h2>
                <div id="modalFlashSaleTimer" class="flash-sale-timer" data-flash-sale-end=""></div>
            </div>
            <div class="flash-sale-modal-body" id="flashSaleProductsContainer">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- DISCOUNTED PRODUCTS / OFFERS SECTION -->
@{
    var discountedProducts = ViewBag.DiscountedProducts as IEnumerable<BulkyBook.Models.Product> ?? Enumerable.Empty<BulkyBook.Models.Product>();
    var hasDiscountedProducts = discountedProducts.Any();
}

@if (hasDiscountedProducts)
{
    <section class="offers-section">
        <div class="container">
            <!-- Section Header -->
            <div class="offers-header">
                <h2 class="offers-title">
                    <span class="offers-icon">🔥</span>
                    @Localizer["Offers"]
                </h2>
                <p class="offers-subtitle">@Localizer["BestDeals"]</p>
            </div>
            
            <!-- Bootstrap Carousel -->
            <div id="offersCarousel" class="carousel slide offers-carousel" data-bs-ride="carousel" data-bs-interval="8000" data-bs-pause="hover" data-bs-touch="true">
                <div class="carousel-inner">
                    @{
                        var productsList = discountedProducts.ToList();
                        var itemsPerSlide = 4; // Fixed 4 items per slide like best sellers
                        var totalSlides = 0; // Initialize total slides
                        
                        // Ensure we have products before creating slides
                        if (productsList.Count > 0)
                        {
                            // Calculate total slides - always create at least one slide
                            totalSlides = productsList.Count < itemsPerSlide 
                                ? 1 
                                : (int)Math.Ceiling(productsList.Count / (double)itemsPerSlide);
                            
                            for (int slideIndex = 0; slideIndex < totalSlides; slideIndex++)
                            {
                                var slideProducts = new List<Product>();
                                
                                // Use circular wrapping to always get exactly 4 items per slide
                                for (int i = 0; i < itemsPerSlide; i++)
                                {
                                    var productIndex = (slideIndex * itemsPerSlide + i) % productsList.Count;
                                    slideProducts.Add(productsList[productIndex]);
                                }
                                
                                if (!slideProducts.Any()) continue;
                            
                            <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                                <div class="row g-3 g-md-4">
                                    @foreach (var product in slideProducts)
                                    {
                                        var productName = currentCulture == "ar" && !string.IsNullOrEmpty(product.TitleAr) 
                                            ? product.TitleAr 
                                            : product.Title;
                                        
                                        // Calculate discount percentage
                                        var discountPercent = product.ListPrice > 0 
                                            ? (int)((product.ListPrice - product.Price) / product.ListPrice * 100) 
                                            : 0;
                                        
                                        // Get product image
                                        var productImages = product.ProductImages != null && product.ProductImages.Any() 
                                            ? product.ProductImages.OrderBy(pi => pi.DisplayOrder).Select(pi => pi.ImageUrl).ToList()
                                            : new List<string>();
                                        
                                        if (!productImages.Any() && !string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            productImages.Add(product.ImageUrl);
                                        }
                                        
                                        var productImage = productImages.FirstOrDefault() ?? "/images/no-image.png";
                                        
                                        // Get best variant price if product has variants
                                        decimal? variantPrice = null;
                                        decimal? variantListPrice = null;
                                        if (product.HasVariants && product.ProductVariants != null && product.ProductVariants.Any())
                                        {
                                            var bestVariant = product.ProductVariants
                                                .Where(v => v.ListPrice > v.Price && v.StockQuantity > 0)
                                                .OrderByDescending(v => ((v.ListPrice - v.Price) / v.ListPrice) * 100)
                                                .FirstOrDefault();
                                            
                                            if (bestVariant != null)
                                            {
                                                variantPrice = (decimal)bestVariant.Price;
                                                variantListPrice = (decimal)bestVariant.ListPrice;
                                                discountPercent = variantListPrice > 0 
                                                    ? (int)((variantListPrice.Value - variantPrice.Value) / variantListPrice.Value * 100) 
                                                    : discountPercent;
                                            }
                                        }
                                        
                                        var displayPrice = variantPrice ?? (decimal)product.Price;
                                        var displayListPrice = variantListPrice ?? (decimal)product.ListPrice;
                                        
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <div class="offer-card h-100">
                                                <a href="@Url.Action("Details", "Home", new { area = "Customer", productId = product.Id })" class="offer-card-link">
                                                    @if (discountPercent > 0)
                                                    {
                                                        <div class="offer-badge">-@discountPercent%</div>
                                                    }
                                                    
                                                    <div class="offer-card-image">
                                                        <img src="@productImage" alt="@productName" class="img-fluid" loading="lazy" />
                                                    </div>
                                                    
                                                    <div class="offer-card-content">
                                                        <h3 class="offer-card-title">@productName</h3>
                                                        
                                                        <div class="offer-card-price">
                                                            <span class="offer-price-old">@Html.Raw(currencySymbol)@displayListPrice.ToString("N2")</span>
                                                            <span class="offer-price-new">@Html.Raw(currencySymbol)@displayPrice.ToString("N2")</span>
                                                        </div>
                                                        
                                                        @if (discountPercent > 0)
                                                        {
                                                            <div class="offer-save">
                                                                @Localizer["Save"] @Html.Raw(currencySymbol)@((displayListPrice - displayPrice).ToString("N2"))
                                                            </div>
                                                        }
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            }
                        }
                    }
                </div>
                
                <!-- Carousel Controls -->
                <button class="carousel-control-prev offers-carousel-control" type="button" data-bs-target="#offersCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@Localizer["Previous"]</span>
                </button>
                <button class="carousel-control-next offers-carousel-control" type="button" data-bs-target="#offersCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@Localizer["Next"]</span>
                </button>
                
                <!-- Carousel Indicators -->
                @if (totalSlides > 1)
                {
                    <div class="carousel-indicators offers-carousel-indicators">
                        @for (int i = 0; i < totalSlides; i++)
                        {
                            <button type="button" data-bs-target="#offersCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Services Section -->
@{
    var activeServices = ViewBag.ActiveServices as IEnumerable<BulkyBook.Models.ServiceSubscription> ?? Enumerable.Empty<BulkyBook.Models.ServiceSubscription>();
    var hasServices = activeServices.Any();
}

@if (hasServices)
{
    <section class="services-showcase-section">
        <div class="container">
            <div class="services-header">
                <div class="services-header-content">
                    <h2 class="services-title">
                        <i class="bi bi-briefcase-fill me-3"></i>
                        @Localizer["OurPremiumServices"]
                    </h2>
                    <p class="services-subtitle">@Localizer["DiscoverProfessionalServices"]</p>
                </div>
                <a asp-area="Customer" asp-controller="ServiceSubscription" asp-action="Index" class="view-all-services-btn">
                    @Localizer["ViewAllServices"]
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="services-grid">
                @foreach (var service in activeServices.Take(3))
                {
                    var activeOffers = _unitOfWork.ServiceOffers.GetAll(
                        o => o.ServiceSubscriptionId == service.Id && 
                             o.IsActive && 
                             o.StartDate <= BulkyBook.Utility.DateTimeHelper.Now && 
                             o.EndDate >= BulkyBook.Utility.DateTimeHelper.Now
                    ).ToList();
                    var hasOffer = activeOffers.Any();
                    var bestOffer = activeOffers.OrderByDescending(o => o.DiscountValue).FirstOrDefault();

                    <div class="service-card-home">
                        <div class="service-card-image-wrapper">
                            @{
                                var serviceImages = service.ServiceImages != null && service.ServiceImages.Any() 
                                    ? service.ServiceImages.OrderBy(si => si.DisplayOrder).Select(si => si.ImageUrl).ToList()
                                    : new List<string>();
                                
                                // If no ServiceImages but has ImageUrl, use that
                                if (!serviceImages.Any() && !string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    serviceImages.Add(service.ImageUrl);
                                }
                            }
                            
                            @if (serviceImages.Count > 1)
                            {
                                <div id="homeServiceCarousel_@service.Id" class="carousel slide service-home-carousel" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        @for (int i = 0; i < serviceImages.Count; i++)
                                        {
                                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                                <img src="@serviceImages[i]" class="service-card-image" alt="@service.Title - Image @(i+1)" />
                                            </div>
                                        }
                                    </div>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">@Localizer["Previous"]</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">@Localizer["Next"]</span>
                                    </button>
                                    <div class="carousel-indicators">
                                        @for (int i = 0; i < serviceImages.Count; i++)
                                        {
                                            <button type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                                        }
                                    </div>
                                </div>
                            }
                            else if (serviceImages.Count == 1)
                            {
                                <img src="@serviceImages[0]" class="service-card-image" alt="@service.Title" />
                            }
                            else
                            {
                                <div class="service-card-image-placeholder">
                                    <i class="bi bi-briefcase"></i>
                                </div>
                            }
                            @if (hasOffer && bestOffer != null)
                            {
                                <div class="service-offer-badge">
                                    @if (bestOffer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                    {
                                        <span>@bestOffer.DiscountValue% @Localizer["OFF"]</span>
                                    }
                                    else
                                    {
                                        <span>@Html.Raw(currencySymbol) @bestOffer.DiscountValue.ToString("N2") @Localizer["OFF"]</span>
                                    }
                                </div>
                            }
                            @if (service.ServiceType == BulkyBook.Models.ServiceType.Online)
                            {
                                <div class="service-type-badge-home online">
                                    <i class="bi bi-globe"></i> @Localizer["Online"]
                                </div>
                            }
                            else
                            {
                                <div class="service-type-badge-home offline">
                                    <i class="bi bi-building"></i> @Localizer["Offline"]
                                </div>
                            }
                        </div>
                        <div class="service-card-content">
                            <h3 class="service-card-title">@service.Title</h3>
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="service-card-description">
                                    @(service.Description.Length > 80 ? service.Description.Substring(0, 80) + "..." : service.Description)
                                </p>
                            }
                            <div class="service-card-pricing">
                                @if (hasOffer && bestOffer != null)
                                {
                                    decimal originalPrice = service.Price;
                                    decimal discount = 0;
                                    if (bestOffer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                    {
                                        discount = originalPrice * (bestOffer.DiscountValue / 100);
                                    }
                                    else
                                    {
                                        discount = bestOffer.DiscountValue;
                                    }
                                    decimal finalPrice = originalPrice - discount;
                                    
                                    <span class="service-price-original">@Html.Raw(currencySymbol) @originalPrice.ToString("N2")</span>
                                    <span class="service-price-final">@Html.Raw(currencySymbol) @finalPrice.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="service-price-final">@Html.Raw(currencySymbol) @service.Price.ToString("N2")</span>
                                }
                            </div>
                            @if (service.ServiceType == BulkyBook.Models.ServiceType.Offline && service.OfflinePaymentPercent.HasValue)
                            {
                                <div class="service-payment-info">
                                    <small>
                                        <i class="bi bi-info-circle"></i> 
                                        @Localizer["PayPercentNow", service.OfflinePaymentPercent.Value, currencySymbol + " " + (service.Price * service.OfflinePaymentPercent.Value / 100).ToString("N2")]
                                    </small>
                                </div>
                            }
                            <a asp-area="Customer" asp-controller="ServiceSubscription" asp-action="Details" asp-route-id="@service.Id" class="service-card-btn">
                                @Localizer["ViewDetails"]
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Active Filters Display -->
    @if (selectedCategory.HasValue || !string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(sortBy) || minPrice.HasValue || maxPrice.HasValue || !string.IsNullOrEmpty(availability))
    {
        <div class="modern-active-filters" id="modernActiveFilters">
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <span class="modern-active-filter-tag">
                    @Localizer["Search"]: @searchTerm
                    <button type="button" class="remove-btn" data-filter="searchTerm">
                        <i class="bi bi-x"></i>
                    </button>
                </span>
            }
            @if (selectedCategory.HasValue)
            {
                var categoryName = categories.FirstOrDefault(c => c.Id == selectedCategory.Value)?.Name ?? "";
                <span class="modern-active-filter-tag">
                    @Localizer["Category"]: @categoryName
                    <button type="button" class="remove-btn" data-filter="categoryId">
                        <i class="bi bi-x"></i>
                    </button>
                </span>
            }
            @if (minPrice.HasValue || maxPrice.HasValue)
            {
                <span class="modern-active-filter-tag">
                    @Localizer["Price"]: @Html.Raw(currencySymbol) @(minPrice?.ToString("N2") ?? "0") - @Html.Raw(currencySymbol) @(maxPrice?.ToString("N2") ?? maxPriceRange.ToString("N2"))
                    <button type="button" class="remove-btn" data-filter="price">
                        <i class="bi bi-x"></i>
                    </button>
