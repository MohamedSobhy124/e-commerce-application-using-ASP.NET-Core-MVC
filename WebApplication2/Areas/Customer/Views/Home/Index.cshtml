<!-- Newsletter Section - Only for Logged-in Users -->
@if (User.Identity.IsAuthenticated)
{
    var isSubscribed = ViewBag.IsNewsletterSubscribed as bool? ?? false;
    var userEmail = ViewBag.UserEmail as string ?? "";
    
    <section class="newsletter-section">
        <div class="container">
            <div class="newsletter-content">
                <div class="newsletter-icon">
                    <i class="bi bi-envelope-heart"></i>
                </div>
                
                @if (isSubscribed)
                {
                    <h2 class="newsletter-title">@Localizer["NewsletterSubscription"]</h2>
                    <p class="newsletter-subtitle">@Localizer["YouAreSubscribedToNewsletter"]</p>
                    <div class="newsletter-subscribed-info">
                        <p class="newsletter-email-display">
                            <i class="bi bi-envelope-check me-2"></i>
                            <strong>@userEmail</strong>
                        </p>
                        <button type="button" class="newsletter-unsubscribe-btn" id="unsubscribeBtn">
                            <i class="bi bi-x-circle me-2"></i>
                            @Localizer["Unsubscribe"]
                        </button>
                    </div>
                }
                else
                {
                    <h2 class="newsletter-title">@Localizer["SubscribeToNewsletter"]</h2>
                    <p class="newsletter-subtitle">@Localizer["GetLatestOffersAndUpdates"]</p>
                    <form class="newsletter-form" id="newsletterForm">
                        <input type="email" 
                               class="newsletter-input" 
                               placeholder="@Localizer["EnterYourEmail"]" 
                               value="@userEmail"
                               required 
                               id="newsletterEmail" />
                        <button type="submit" class="newsletter-submit-btn">
                            <i class="bi bi-send me-2"></i>
                            @Localizer["Subscribe"]
                        </button>
                    </form>
                }
                
                <p class="newsletter-privacy">
                    <i class="bi bi-shield-check me-2"></i>
                    @Localizer["WeRespectYourPrivacy"]
                </p>
            </div>
        </div>
    </section>
}

