        let currentPage = 1;
        let isLoading = false;
        let hasMoreProducts = true;
        const isAuthenticated = @Json.Serialize(User.Identity.IsAuthenticated);
        let cartProductIds = @Html.Raw(Json.Serialize(ViewBag.CartProductIds ?? new List<int>()));
        let wishlistProductIds = @Html.Raw(Json.Serialize(ViewBag.WishlistProductIds ?? new List<int>()));
        window.isAuthenticated = isAuthenticated; // Make available globally
        document.body.setAttribute('data-is-authenticated', isAuthenticated.toString());

        // Save scroll position before any operation
        function saveScrollPosition() {
            sessionStorage.setItem('scrollPosition', window.scrollY || window.pageYOffset);
        }

        // Restore scroll position
        function restoreScrollPosition() {
            const savedPosition = sessionStorage.getItem('scrollPosition');
            if (savedPosition) {
                window.scrollTo(0, parseInt(savedPosition));
            }
        }

        // Restore scroll position on page load
        window.addEventListener('load', function() {
            restoreScrollPosition();
            // Clear the saved position after restoring
            sessionStorage.removeItem('scrollPosition');
            loadCartItems();
            // Initialize floating cart badge for all users
                const initialCount = cartProductIds.length;
                updateFloatingCartBadge(initialCount);
        });

        // Save scroll position before page unload
        window.addEventListener('beforeunload', function() {
            saveScrollPosition();
        });

        // Function to format currency
        const currencySymbol = '@Html.Raw(currencySymbol)';
        function formatCurrency(value) {
            return currencySymbol + ' ' + value.toFixed(2);
        }

        // Function to update cart widget using AJAX
        function updateCartWidget() {
            // Add timestamp to prevent caching
            const timestamp = new Date().getTime();
            fetch(`/Customer/Home/GetCartWidget?t=${timestamp}`, {
                method: 'GET',
                cache: 'no-cache',
                headers: {
                    'Cache-Control': 'no-cache'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(html => {
                    // Find the cart link by ID first, then by href
                    const cartLink = document.getElementById('cartNavLink') || document.querySelector('a[href*="/Customer/Cart/Index"]');
                    if (cartLink) {
                        cartLink.innerHTML = html;
                        console.log('Cart widget updated successfully via AJAX');
                    } else {
                        console.error('Cart link not found for AJAX update');
                    }
                })
                .catch(error => {
                    console.error('Error updating cart widget:', error);
                });
        }

        // Function to update navigation cart count directly
        function updateNavigationCartCount(count) {
            // Try to find cart link by ID first, then by href
            const cartLink = document.getElementById('cartNavLink') || document.querySelector('a[href*="/Customer/Cart/Index"]');
            
            if (cartLink) {
                // Find the count span inside the cart link - try multiple selectors
                let countSpan = cartLink.querySelector('span[style*="background"]');
                if (!countSpan) {
                    // Try finding by looking for the span with gradient background
                    const spans = cartLink.querySelectorAll('span');
                    countSpan = Array.from(spans).find(span => {
                        const bg = window.getComputedStyle(span).background || span.style.background || '';
                        return bg.includes('gradient') || bg.includes('linear-gradient');
                    });
                }
                if (!countSpan) {
                    // Try finding the last span (usually the count)
                    const spans = cartLink.querySelectorAll('span');
                    if (spans.length > 0) {
                        countSpan = spans[spans.length - 1];
                    }
                }
                
                if (countSpan) {
                    countSpan.textContent = count;
                    console.log('Cart count updated directly to:', count);
                    return true;
                } else {
                    // If span doesn't exist, update the entire link content via AJAX
                    console.log('Count span not found, will update via AJAX');
                    return false;
                }
            } else {
                console.error('Cart link not found');
                return false;
            }
        }

        // Function to update floating cart badge
        function updateFloatingCartBadge(count) {
            const floatingBadge = document.getElementById('floatingCartBadge');
            const floatingBtn = document.querySelector('.floating-cart-btn');
            if (floatingBadge) {
                floatingBadge.textContent = count;
                // Add pulse animation
                if (floatingBtn) {
                    floatingBtn.classList.add('pulse');
                    setTimeout(() => {
                        floatingBtn.classList.remove('pulse');
                    }, 600);
                }
            }
        }

        // Function to open cart sidebar
        function openCartSidebar() {
            console.log('Opening cart sidebar...');
            const sidebar = document.getElementById('cartSidebar');
            const overlay = document.getElementById('cartOverlay');
            
            if (sidebar && overlay) {
                sidebar.classList.add('active');
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden'; // Prevent background scrolling
                console.log('Cart sidebar opened successfully');
                loadCartItems();
            } else {
                console.error('Cart sidebar or overlay not found!');
            }
        }

        // Function to close cart sidebar
        function closeCartSidebar() {
            document.getElementById('cartSidebar').classList.remove('active');
            document.getElementById('cartOverlay').classList.remove('active');
            document.body.style.overflow = ''; // Restore scrolling
        }

        // Function to load cart items
        function loadCartItems() {
            console.log('loadCartItems called, isAuthenticated:', isAuthenticated);

            console.log('Fetching cart items from server...');
            fetch('/Customer/Cart/GetCartItems')
                .then(response => {
                    console.log('Cart items response received:', response.status);
                    return response.json();
                })
                .then(data => {
                    console.log('Cart items data:', data);
                    const container = document.getElementById('cartItemsContainer');
                    const countElement = document.getElementById('sidebarCartCount');
                    const subtotalElement = document.getElementById('cartSubtotal');

                    if (data.items && data.items.length > 0) {
                        container.innerHTML = data.items.map(item => createCartItemHTML(item)).join('');
                        countElement.textContent = data.items.length;
                        subtotalElement.textContent = formatCurrency(data.subtotal);
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(data.items.length);
                        console.log('Cart items loaded successfully:', data.items.length, 'items');
                    } else {
                        container.innerHTML = '<div class="cart-empty"><i class="bi bi-cart-x"></i><p>@Localizer["YourCartIsEmpty"]</p></div>';
                        countElement.textContent = '0';
                        subtotalElement.textContent = currencySymbol + ' 0.00';
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(0);
                        console.log('Cart is empty');
                    }
                })
                .catch(error => {
                    console.error('Error loading cart items:', error);
                });
        }

        // Function to create cart item HTML
        function createCartItemHTML(item) {
            return `
                <div class="cart-item" data-product-id="${item.productId}">
                    <img src="${item.imageUrl}" alt="${item.title}" class="cart-item-image">
                    <div class="cart-item-details">
                        <h6 class="cart-item-title">${item.title}</h6>
                        <p class="cart-item-price">${formatCurrency(item.price * item.count)}</p>
                        <div class="cart-item-quantity">
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateCartQuantity(${item.productId}, ${item.count - 1})">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span>${item.count}</span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateCartQuantity(${item.productId}, ${item.count + 1})">
                                <i class="bi bi-plus"></i>
                            </button>
                            <button class="cart-item-remove" onclick="removeFromCart(${item.productId})" title="Remove">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        // Function to update cart quantity
        function updateCartQuantity(productId, newCount) {
            if (newCount < 1) {
                removeFromCart(productId);
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('count', newCount);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadCartItems(); // This will also update the floating badge
                    updateCartWidget();
                }
            })
            .catch(error => {
                console.error('Error updating quantity:', error);
            });
        }

        // Function to remove item from cart
        function removeFromCart(productId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Home/ToggleCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update button state for this product
                    const button = document.querySelector(`button[data-product-id="${productId}"]`);
                    if (button) {
                        button.classList.remove('in-cart');
                        button.querySelector('i').className = 'bi bi-plus-lg';
                        button.title = 'Add to Cart';
                    }
                    cartProductIds = cartProductIds.filter(id => id !== productId);
                    
                    // Update floating cart badge
                    updateFloatingCartBadge(data.cartCount);
                    
                    // Update navigation cart count immediately
                    updateNavigationCartCount(data.cartCount);
                    
                    loadCartItems();
                    
                    // Always update via AJAX to ensure it's synced (with small delay)
                    setTimeout(() => {
                        updateCartWidget();
                    }, 150);
                    
                    if (typeof toastr !== 'undefined') {
                        toastr.info('Product removed from cart');
                    }
                }
            })
            .catch(error => {
                console.error('Error removing from cart:', error);
            });
        }

        // Function to toggle product in cart
        function toggleCart(productId, button) {
            const isCurrentlyInCart = button.classList.contains('in-cart');
            const originalIcon = button.querySelector('i').className;
            
            // Save scroll position in case of any unexpected navigation
            saveScrollPosition();
            
            button.classList.add('loading');
            button.querySelector('i').className = 'bi bi-arrow-repeat';
            button.querySelector('i').style.animation = 'spin 1s linear infinite';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Home/ToggleCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                console.log('Server response:', data);
                if (data.success) {
                    button.classList.remove('loading');
                    button.querySelector('i').style.animation = '';
                    
                    if (data.isAdded) {
                        // Product was added
                        button.classList.add('in-cart');
                        button.querySelector('i').className = 'bi bi-check-lg';
                        button.title = 'Remove from Cart';
                        cartProductIds.push(productId);
                        
                        // Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.success(data.message);
                        }
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(data.cartCount);
                        
                        // Update navigation cart count immediately
                        updateNavigationCartCount(data.cartCount);
                        
                        // Always update via AJAX to ensure it's synced (with small delay)
                        setTimeout(() => {
                            updateCartWidget();
                        }, 150);
                        
                        console.log('About to open cart sidebar...');
                        // Open the cart sidebar to show the added item
                        openCartSidebar();
                    } else {
                        // Product was removed
                        button.classList.remove('in-cart');
                        button.querySelector('i').className = 'bi bi-plus-lg';
                        button.title = 'Add to Cart';
                        cartProductIds = cartProductIds.filter(id => id !== productId);
                        
                        // Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.info(data.message);
                        }
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(data.cartCount);
                        
                        // Update navigation cart count immediately
                        updateNavigationCartCount(data.cartCount);
                        
                        // Always update via AJAX to ensure it's synced (with small delay)
                        setTimeout(() => {
                            updateCartWidget();
                        }, 150);
                    }
                } else {
                    throw new Error(data.message || 'Failed to update cart');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                button.classList.remove('loading');
                button.querySelector('i').className = originalIcon;
                button.querySelector('i').style.animation = '';
                if (typeof toastr !== 'undefined') {
                    toastr.error('Failed to update cart. Please try again.');
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to update cart. Please try again.'
                    });
                }
            });
        }

        // Function to create product HTML - NEW DESIGN
        function createProductCard(product, isAuthenticated) {
            const discount = product.listPrice > 0 ? Math.floor((product.listPrice - product.price) / product.listPrice * 100) : 0;
            const discountBadge = discount > 0 ? `<span class="product-badge badge-discount">-${discount}%</span>` : '';
            
            const priceHtml = discount > 0 
                ? `<span class="current-price">${formatCurrency(product.price)}</span>
                   <span class="list-price">${formatCurrency(product.listPrice)}</span>
                   <span class="discount-percent">${discount}% OFF</span>`
                : `<span class="current-price">${formatCurrency(product.price)}</span>`;
            
            const isInCart = cartProductIds.includes(product.id);
            const cartIcon = isInCart ? 'bi-check-lg' : 'bi-cart-plus';
            const cartClass = isInCart ? 'in-cart' : '';
            
            // Handle multiple images
            let imageHtml = '';
            const productImages = product.productImages && product.productImages.length > 0 
                ? product.productImages.sort((a, b) => (a.displayOrder || 0) - (b.displayOrder || 0)).map(pi => pi.imageUrl)
                : [];
            
            if (productImages.length === 0 && product.imageUrl) {
                productImages.push(product.imageUrl);
            }
            
            if (productImages.length > 1) {
                // Multiple images - carousel
                let carouselItems = '';
                let indicators = '';
                productImages.forEach((img, index) => {
                    carouselItems += `
                        <div class="carousel-item ${index === 0 ? 'active' : ''}">
                            <img src="${img}" class="product-image" alt="${product.title} - Image ${index + 1}" />
                        </div>
                    `;
                    indicators += `
                        <button type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide-to="${index}" 
                                class="${index === 0 ? 'active' : ''}" aria-current="${index === 0 ? 'true' : 'false'}" 
                                aria-label="Slide ${index + 1}"></button>
                    `;
                });
                
                imageHtml = `
                    <div id="productCarousel_${product.id}" class="carousel slide product-image-carousel" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            ${carouselItems}
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                        <div class="carousel-indicators">
                            ${indicators}
                        </div>
                    </div>
                `;
            } else {
                // Single image
                const imageUrl = productImages.length > 0 ? productImages[0] : product.imageUrl || '';
                imageHtml = `<img src="${imageUrl}" class="product-image" alt="${product.title}" />`;
            }
            
            return `
                <div class="product-card stagger-item" 
                     data-stock-quantity="${product.stockQuantity || 0}" 
                     data-minimum-stock="${product.minimumStockAlert || 5}">
                    <div class="product-image-wrapper">
                        ${imageHtml}
                        <div class="product-badges">
                            ${discountBadge}
                        </div>
                    </div>
                    <div class="product-content">
                        <div class="product-category">${product.categry?.name || 'PRODUCT'}</div>
                        <h3 class="product-title">${product.title}</h3>
                        <div class="product-card-rating" data-product-id="${product.id}">
                            <div class="product-card-stars">
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                            </div>
                            <span class="product-card-rating-text">(0)</span>
                        </div>
                        <div class="price-section">
                            <div class="price-wrapper">
                                ${priceHtml}
                            </div>
                        </div>
                        <div class="product-actions">
                            <a href="/Customer/Home/Details?productId=${product.id}" class="btn-view-details">
                                <i class="bi bi-eye"></i>
                                @Localizer["ViewDetails"]
                            </a>
                            ${(product.productType === 1 || product.productType === 'Variable')
                                ? `<a href="/Customer/Home/Details?productId=${product.id}" class="btn-select-options">
                                    <i class="bi bi-list-check"></i>
                                    ${localizations.selectOptions}
                                   </a>`
                                : `<button class="btn-add-cart-quick ${cartClass}" 
                                    data-product-id="${product.id}"
                                    onclick="toggleCart(${product.id}, this)" 
                                    title="${isInCart ? 'In Cart' : 'Add to Cart'}">
                                    <i class="bi ${cartIcon}"></i>
                                   </button>`
                            }
                        </div>
                    </div>
                </div>
            `;
        }

        // Function to get current filter parameters
        function getFilterParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const params = new URLSearchParams();
            
            if (urlParams.get('categoryId')) params.append('categoryId', urlParams.get('categoryId'));
            if (urlParams.get('searchTerm')) params.append('searchTerm', urlParams.get('searchTerm'));
            if (urlParams.get('sortBy')) params.append('sortBy', urlParams.get('sortBy'));
            if (urlParams.get('minPrice')) params.append('minPrice', urlParams.get('minPrice'));
            if (urlParams.get('maxPrice')) params.append('maxPrice', urlParams.get('maxPrice'));
            if (urlParams.get('inStock')) params.append('inStock', urlParams.get('inStock'));
            if (urlParams.get('availability')) params.append('availability', urlParams.get('availability'));
            
            return params.toString();
        }

        // Function to load more products with filters
        function loadMoreProducts() {
            if (isLoading || !hasMoreProducts) return;

            isLoading = true;
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const loadingIndicator = document.getElementById('loadingIndicator');
            const loadMoreContainer = document.getElementById('loadMoreContainer');
            
            // Hide button, show loading
            if (loadMoreBtn) loadMoreBtn.style.display = 'none';
            if (loadingIndicator) loadingIndicator.style.display = 'block';

            const filterParams = getFilterParams();
            const url = `/Customer/Home/LoadMoreProducts?page=${currentPage}&pageSize=20${filterParams ? '&' + filterParams : ''}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('productContainer');
                    
                    data.products.forEach(product => {
                        container.insertAdjacentHTML('beforeend', createProductCard(product, isAuthenticated));
                    });

                    // Load ratings for newly added products
                    loadAllProductRatings();
                    
                    // Initialize badges for newly loaded products
                    if (typeof initProductBadges === 'function') {
                        initProductBadges();
                    }

                    hasMoreProducts = data.hasMore;
                    currentPage++;
                    isLoading = false;
                    
                    // Hide loading, show button if more products available
                    if (loadingIndicator) loadingIndicator.style.display = 'none';
                    
                    if (hasMoreProducts) {
                        if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                    } else {
                        // No more products, hide the container
                        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
                    }
                })
                .catch(error => {
                    console.error('Error loading products:', error);
                    isLoading = false;
                    if (loadingIndicator) loadingIndicator.style.display = 'none';
                    if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                });
        }

        // Check if there are more products on page load and show button
        function checkAndShowLoadMoreButton() {
            const loadMoreContainer = document.getElementById('loadMoreContainer');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const productCount = document.querySelectorAll('.product-card').length;
            
            
            // If we have exactly 20 products, likely there are more (since Index shows 20 max)
            if (productCount === 20) {
                hasMoreProducts = true;
                if (loadMoreContainer) {
                    loadMoreContainer.style.display = 'block';
                }
                if (loadMoreBtn) {
                    loadMoreBtn.style.display = 'inline-block';
                }
                
                // Still verify by checking the API
                fetch(`/Customer/Home/LoadMoreProducts?page=1&pageSize=20`)
                    .then(response => response.json())
                    .then(data => {
                        if (!data.hasMore && (!data.products || data.products.length === 0)) {
                            // No more products, hide the button
                            hasMoreProducts = false;
                            if (loadMoreContainer) {
                                loadMoreContainer.style.display = 'none';
                            }
                        }
                    })
                    .catch(error => {
                    });
            } 
            // If we have products but less than 20, check if there are more
            else if (productCount > 0 && productCount < 20) {
                fetch(`/Customer/Home/LoadMoreProducts?page=1&pageSize=20`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.hasMore || (data.products && data.products.length > 0)) {
                            hasMoreProducts = true;
                            if (loadMoreContainer) {
                                loadMoreContainer.style.display = 'block';
                            }
                            if (loadMoreBtn) {
                                loadMoreBtn.style.display = 'inline-block';
                            }
                        } else {
                            hasMoreProducts = false;
                            if (loadMoreContainer) {
                                loadMoreContainer.style.display = 'none';
                            }
                        }
                    })
                    .catch(error => {
                    });
            } 
            // No products at all
            else {
                hasMoreProducts = false;
                if (loadMoreContainer) {
                    loadMoreContainer.style.display = 'none';
            }
            }
        }

        // Save scroll position when clicking on any link (like Details button)
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href) {
                saveScrollPosition();
            }
        });

        // Enhanced Filter Interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Filter toggle for mobile
            const filterToggleBtn = document.getElementById('filterToggleBtn');
            const filterGroups = document.getElementById('filterGroups');
            
            if (filterToggleBtn && filterGroups) {
                filterToggleBtn.addEventListener('click', function() {
                    filterGroups.classList.toggle('active');
                    filterToggleBtn.classList.toggle('active');
                });
            }
            
            // Price range slider interactions
            const priceRangeMin = document.getElementById('priceRangeMin');
            const priceRangeMax = document.getElementById('priceRangeMax');
            const priceMinInput = document.querySelector('input[name="minPrice"]');
            const priceMaxInput = document.querySelector('input[name="maxPrice"]');
            const priceMinDisplay = document.getElementById('priceMinDisplay');
            const priceMaxDisplay = document.getElementById('priceMaxDisplay');
            
            if (priceRangeMin && priceRangeMax && priceMinInput && priceMaxInput) {
                const minPrice = parseFloat(priceRangeMin.getAttribute('min')) || 0;
                const maxPrice = parseFloat(priceRangeMax.getAttribute('max')) || 1000;
                
                // Update display when sliders change
                priceRangeMin.addEventListener('input', function() {
                    const value = parseFloat(this.value);
                    if (priceMinInput) priceMinInput.value = value.toFixed(2);
                    if (priceMinDisplay) priceMinDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                });
                
                priceRangeMax.addEventListener('input', function() {
                    const value = parseFloat(this.value);
                    if (priceMaxInput) priceMaxInput.value = value.toFixed(2);
                    if (priceMaxDisplay) priceMaxDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                });
                
                // Update sliders when inputs change
                if (priceMinInput) {
                    priceMinInput.addEventListener('input', function() {
                        const value = Math.max(minPrice, Math.min(maxPrice, parseFloat(this.value) || minPrice));
                        priceRangeMin.value = value;
                        if (priceMinDisplay) priceMinDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                    });
                }
                
                if (priceMaxInput) {
                    priceMaxInput.addEventListener('input', function() {
                        const value = Math.max(minPrice, Math.min(maxPrice, parseFloat(this.value) || maxPrice));
                        priceRangeMax.value = value;
                        if (priceMaxDisplay) priceMaxDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                    });
                }
            }
            
            // Auto-submit on filter change (with debounce for price inputs)
            let filterTimeout;
            const filterForm = document.getElementById('filterForm');
            const priceInputs = document.querySelectorAll('.price-input');
            
            priceInputs.forEach(input => {
                input.addEventListener('input', function() {
                    clearTimeout(filterTimeout);
                    filterTimeout = setTimeout(() => {
                        // Don't auto-submit price, let user click Apply
                    }, 500);
                });
            });
            
            // Select filters auto-submit
            const autoSubmitSelects = document.querySelectorAll('.modern-select:not([name="minPrice"]):not([name="maxPrice"])');
            autoSubmitSelects.forEach(select => {
                select.addEventListener('change', function() {
                    if (filterForm) {
                        filterForm.submit();
                    }
                });
            });
            
            // Initialize filter state from URL
            initializeFiltersFromURL();
        });
        
        // Initialize filters from URL parameters
        function initializeFiltersFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const minPrice = urlParams.get('minPrice');
            const maxPrice = urlParams.get('maxPrice');
            
            if (minPrice) {
                const priceMinInput = document.querySelector('input[name="minPrice"]');
                const priceRangeMin = document.getElementById('priceRangeMin');
                if (priceMinInput) priceMinInput.value = minPrice;
                if (priceRangeMin) priceRangeMin.value = minPrice;
            }
            
            if (maxPrice) {
                const priceMaxInput = document.querySelector('input[name="maxPrice"]');
                const priceRangeMax = document.getElementById('priceRangeMax');
                if (priceMaxInput) priceMaxInput.value = maxPrice;
                if (priceRangeMax) priceRangeMax.value = maxPrice;
            }
        }

        // Load ratings for all products and check for load more button
        document.addEventListener('DOMContentLoaded', function() {
            loadAllProductRatings();

            // Check if we need to show the Load More button after products are rendered
            setTimeout(function() {
                checkAndShowLoadMoreButton();
            }, 1500);
        });
        
        // Also check when window loads (in case DOMContentLoaded fires too early)
        window.addEventListener('load', function() {
            setTimeout(function() {
                checkAndShowLoadMoreButton();
            }, 1000);
        });
        
        // Also check after a longer delay to ensure everything is loaded
        setTimeout(function() {
            checkAndShowLoadMoreButton();
        }, 2000);

        function loadAllProductRatings() {
            const ratingElements = document.querySelectorAll('.product-card-rating');
            ratingElements.forEach(element => {
                const productId = element.getAttribute('data-product-id');
                if (productId) {
                    loadProductCardRating(productId, element);
                }
            });
        }

        function loadProductCardRating(productId, element) {
            fetch(`/Customer/Review/GetProductRating?productId=${productId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.reviewCount > 0) {
                        const starsHtml = getStarsHTML(data.averageRating);
                        element.querySelector('.product-card-stars').innerHTML = starsHtml;
                        element.querySelector('.product-card-rating-text').textContent = 
                            `(${data.reviewCount})`;
                    }
                })
                .catch(error => console.error('Error loading rating:', error));
        }

        function getStarsHTML(rating) {
            const fullStars = Math.floor(rating);
            const hasHalf = (rating % 1) >= 0.5;
            let html = '';
            
            for (let i = 0; i < fullStars; i++) {
                html += '<i class="bi bi-star-fill"></i>';
            }
            if (hasHalf) {
                html += '<i class="bi bi-star-half"></i>';
            }
            for (let i = fullStars + (hasHalf ? 1 : 0); i < 5; i++) {
                html += '<i class="bi bi-star"></i>';
            }
            
            return html;
        }

        // ==========================================
        // WISHLIST FUNCTIONS
        // ==========================================
        
        @if (User.Identity.IsAuthenticated)
        {
            <text>
            // Wishlist Sidebar Functions
            function openWishlistSidebar() {
                const sidebar = document.getElementById('wishlistSidebar');
                const overlay = document.getElementById('wishlistOverlay');
                
                if (sidebar && overlay) {
                    sidebar.classList.add('active');
                    overlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                    loadWishlistItemsToSidebar();
                }
            }

            function closeWishlistSidebar() {
                const sidebar = document.getElementById('wishlistSidebar');
                const overlay = document.getElementById('wishlistOverlay');
                
                if (sidebar) sidebar.classList.remove('active');
                if (overlay) overlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            function loadWishlistItemsToSidebar() {
                fetch('/Customer/Home/GetWishlistItems')
                    .then(response => response.json())
                    .then(data => {
                        const container = document.getElementById('wishlistItemsContainer');
                        const countElement = document.getElementById('sidebarWishlistCount');

                        if (data.success && data.items && data.items.length > 0) {
                            container.innerHTML = data.items.map(item => createWishlistItemHTML(item)).join('');
                            if (countElement) countElement.textContent = data.count;
                            updateFloatingWishlistBadge(data.count);
                        } else {
                            container.innerHTML = '<div class="wishlist-empty"><i class="bi bi-heart"></i><p>@Localizer["YourWishlistIsEmpty"]</p></div>';
                            if (countElement) countElement.textContent = '0';
                            updateFloatingWishlistBadge(0);
                        }
                    })
                    .catch(error => {
                        console.error('Error loading wishlist items:', error);
                        const container = document.getElementById('wishlistItemsContainer');
                        if (container) {
                            container.innerHTML = '<div class="wishlist-empty"><p>Error loading wishlist</p></div>';
                        }
                    });
            }

            function createWishlistItemHTML(item) {
                const discount = item.listPrice && item.listPrice > item.price 
                    ? Math.floor((item.listPrice - item.price) / item.listPrice * 100) 
                    : 0;
                
                const isVariable = item.productType === 1 || item.productType === 'Variable';
                
                return `
                    <div class="wishlist-item" data-product-id="${item.productId}">
                        <img src="${item.imageUrl}" alt="${item.title}" class="wishlist-item-image">
                        <div class="wishlist-item-details">
                            <h6 class="wishlist-item-title">${item.title}</h6>
                            <div class="wishlist-item-price">
                                ${discount > 0 
                                    ? `<span class="current-price">AED ${item.price.toFixed(2)}</span>
                                       <span class="list-price">AED ${item.listPrice.toFixed(2)}</span>`
                                    : `<span class="current-price">AED ${item.price.toFixed(2)}</span>`
                                }
                            </div>
                            <div class="wishlist-item-actions">
                                ${isVariable
                                    ? `<a href="/Customer/Home/Details?productId=${item.productId}" class="btn btn-select-options-from-wishlist" title="Select Options">
                                        <i class="bi bi-list-check me-1"></i>${localizations.selectOptions}
                                       </a>`
                                    : `<button class="btn btn-add-cart-from-wishlist" onclick="addToCartFromWishlist(${item.productId}, ${item.id})" title="Add to Cart">
                                        <i class="bi bi-cart-plus me-1"></i>@Localizer["AddToCart"]
                                       </button>`
                                }
                                <button class="btn btn-remove-wishlist" onclick="removeFromWishlist(${item.id}, ${item.productId})" title="Remove">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            function addToCartFromWishlist(productId, wishlistId) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('productId', productId);
                formData.append('__RequestVerificationToken', token);

                fetch('/Customer/Home/ToggleCart', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.isAdded) {
                        if (typeof toastr !== 'undefined') {
                            toastr.success('Added to cart!');
                        }
                        if (typeof updateFloatingCartBadge === 'function') {
                            updateFloatingCartBadge(data.cartCount);
                        }
                    }
                })
                .catch(error => {
                    console.error('Error adding to cart:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to add to cart');
                    }
                });
            }

            function removeFromWishlist(wishlistId, productId) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('wishlistId', wishlistId);
                formData.append('__RequestVerificationToken', token);

                fetch('/Customer/Home/RemoveFromWishlist', {
                    method: 'DELETE',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const item = document.querySelector(`.wishlist-item[data-product-id="${productId}"]`);
                        if (item) item.remove();
                        
                        const btn = document.querySelector(`.wishlist-btn[data-product-id="${productId}"]`);
                        if (btn) {
                            btn.classList.remove('active');
                            btn.querySelector('i').className = 'bi bi-heart';
                            btn.title = 'Add to wishlist';
                        }
                        
                        updateFloatingWishlistBadge(data.wishlistCount);
                        
                        const countElement = document.getElementById('sidebarWishlistCount');
                        if (countElement) countElement.textContent = data.wishlistCount;
                        
                        if (data.wishlistCount === 0) {
                            loadWishlistItemsToSidebar();
                        }
                        
                        if (typeof toastr !== 'undefined') {
                            toastr.info(data.message);
                        }
                        
                        wishlistProductIds = wishlistProductIds.filter(id => id !== productId);
                    }
                })
                .catch(error => {
                    console.error('Error removing from wishlist:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to remove from wishlist');
                    }
                });
            }

            function updateFloatingWishlistBadge(count) {
                const floatingBadge = document.getElementById('floatingWishlistBadge');
                const floatingBtn = document.querySelector('.floating-wishlist-btn');
                if (floatingBadge) {
                    floatingBadge.textContent = count;
                    if (count > 0) {
                        floatingBadge.style.display = 'flex';
                    } else {
                        floatingBadge.style.display = 'none';
                    }
                    if (floatingBtn) {
                        floatingBtn.classList.add('pulse');
                        setTimeout(() => {
                            floatingBtn.classList.remove('pulse');
                        }, 600);
                    }
                }
            }

            // Load wishlist on page load
            window.addEventListener('load', function() {
                fetch('/Customer/Home/GetWishlistProductIds')
                    .then(response => response.json())
                    .then(data => {
                        if (data.productIds) {
                            updateFloatingWishlistBadge(data.productIds.length);
                        }
                    })
                    .catch(error => console.error('Error loading wishlist count:', error));
            });
            </text>
        }
    </script>
}
