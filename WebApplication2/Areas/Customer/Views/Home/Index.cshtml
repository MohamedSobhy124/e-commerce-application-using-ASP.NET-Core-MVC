<!-- Desktop Filter Side Panel -->
<div class="modern-filter-side-panel" id="modernFilterSidePanel">
    <div class="modern-filter-side-panel-header">
        <h3 class="modern-filter-side-panel-title">@Localizer["FilterAndSort"]</h3>
        <button type="button" class="modern-filter-bottom-sheet-close" id="modernFilterSidePanelClose">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div class="modern-filter-side-panel-content">
        <!-- Filter content will be moved here by JS -->
    </div>
    <div class="modern-filter-side-panel-footer">
        <button type="button" class="modern-filter-reset-btn" id="modernFilterSidePanelResetBtn">@Localizer["Reset"]</button>
        <button type="button" class="modern-filter-apply-btn" id="modernFilterSidePanelApplyBtn">@Localizer["ApplyFilters"]</button>
