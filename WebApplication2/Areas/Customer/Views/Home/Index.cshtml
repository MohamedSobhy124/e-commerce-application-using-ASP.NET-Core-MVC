            @if (!string.IsNullOrEmpty(sortBy))
            {
                <span class="modern-active-filter-tag">
                    @Localizer["Sort"]: @sortBy
                    <button type="button" class="remove-btn" data-filter="sortBy">
                        <i class="bi bi-x"></i>
                    </button>
