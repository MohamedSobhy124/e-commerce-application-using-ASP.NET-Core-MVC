@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@model IEnumerable<Product>
@inject BulkyBook.DataAccess.Repository.IRepository.IUnitOfWork _unitOfWork
@inject IConfiguration Configuration

@{
    ViewData["Title"] = Localizer["Home"];
    var baseUrl = Configuration["SiteSettings:BaseUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host;
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    // SEO-Optimized Descriptions with Key Keywords
    var siteDescription = currentCulture == "ar" 
        ? (Configuration["SiteSettings:SiteDescriptionAr"] ?? "ايديال وايت للتغذية - متجر المكملات الغذائية والبروتين في الإمارات. مكملات غذائية أصلية 100%، بروتين، فيتامينات، منتجات تخسيس، حمية غذائية، مكملات رياضية. توصيل سريع مجاني في دبي وأبوظبي. اكتشف طريقك للوزن المثالي مع أفضل المكملات الغذائية في الإمارات.")
        : (Configuration["SiteSettings:SiteDescription"] ?? "Ideal Weight Nutrition - UAE's #1 Nutrition & Supplements Store. Buy authentic 100% original protein supplements, vitamins, diet products, weight loss supplements, fitness nutrition online. Fast free delivery in Dubai, Abu Dhabi. Discover your path to ideal weight with premium nutrition supplements in UAE.");
    
    ViewData["Description"] = siteDescription;
    ViewData["Keywords"] = currentCulture == "ar" 
        ? "مكملات غذائية, بروتين, فيتامينات, مكملات رياضية, منتجات تخسيس, حمية غذائية, مكملات صحية, وزن مثالي, تغذية, مكملات الإمارات, مكملات دبي, مكملات أبوظبي, بروتين الإمارات, فيتامينات الإمارات, منتجات صحية الإمارات, متجر تغذية, توصيل مجاني الإمارات"
        : "nutrition supplements, protein supplements, vitamins UAE, diet supplements, weight loss products, fitness nutrition, health supplements, ideal weight, nutrition store UAE, supplements Dubai, supplements Abu Dhabi, protein UAE, vitamins Dubai, health products UAE, nutrition store, free delivery UAE, buy supplements online, diet products, sports nutrition, weight management";
    ViewData["Image"] = baseUrl + "/Images/Products/logo_white_bg.png";
    
    var categories = ViewBag.Categories as IEnumerable<BulkyBook.Models.Categry> ?? Enumerable.Empty<BulkyBook.Models.Categry>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "";
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
    var inStock = ViewBag.InStock as bool?;
    var availability = ViewBag.Availability as string ?? "";
    var minPriceRange = ViewBag.MinPriceRange as decimal? ?? 0;
    var maxPriceRange = ViewBag.MaxPriceRange as decimal? ?? 10000;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<!-- Sticky Hero Search Box Header - At Top -->
<header class="hero-search-box-sticky" id="heroSearchBoxSticky">
    <div class="container">
        <div class="hero-search-box">
            <form id="heroSearchForm" onsubmit="return false;">
                <div class="advanced-search-container">
                    <div class="search-input-wrapper">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" 
                               name="searchTerm" 
                               id="heroSearchInput"
                               value="@searchTerm" 
                               class="hero-search-input" 
                               placeholder="@Localizer["SearchSupplements"]"
                               autocomplete="off" />
                        <button type="button" 
                                class="search-clear-btn" 
                                id="searchClearBtn" 
                                aria-label="Clear search"
                                style="display: @(string.IsNullOrEmpty(searchTerm) ? "none" : "block");">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <button type="submit" class="hero-search-btn magnetic-btn ripple">
                        @Localizer["Search"]
                    </button>
                </div>
            </form>
        </div>
        
        <!-- Header Actions -->
        <div class="hero-header-actions">
            <!-- Filter Button -->
            <button type="button" class="modern-filter-toggle-header-btn" id="modernFilterToggleBtn" aria-label="Toggle filters">
                <i class="bi bi-funnel-fill"></i>
                <span class="filter-btn-text">@Localizer["Filters"]</span>
            </button>
        </div>
    </div>
    
     
</header>

