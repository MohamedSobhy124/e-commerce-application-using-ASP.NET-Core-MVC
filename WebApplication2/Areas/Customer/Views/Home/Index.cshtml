    }
</header>

<!-- Filter Overlay -->
<div class="modern-filter-overlay" id="modernFilterOverlay"></div>

<!-- Mobile Filter Bottom Sheet -->
<div class="modern-filter-bottom-sheet" id="modernFilterBottomSheet">
    <div class="modern-filter-bottom-sheet-header">
