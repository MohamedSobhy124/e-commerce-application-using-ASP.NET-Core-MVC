            </button>
        </div>
        
        <div id="wishlistItemsContainer" class="wishlist-items-container">
            <div class="wishlist-empty">
                <i class="bi bi-heart"></i>
                <p>@Localizer["YourWishlistIsEmpty"]</p>
            </div>
        </div>
        
        <div class="wishlist-footer">
            <a href="/Customer/Home/Index" class="btn btn-view-all w-100">
                <i class="bi bi-arrow-left me-2"></i>@Localizer["ContinueShopping"]
            </a>
        </div>
    </div>

    <!-- Wishlist Overlay -->
    <div id="wishlistOverlay" class="wishlist-overlay" onclick="closeWishlistSidebar()"></div>
}

<!-- Floating Action Button (FAB) Menu 
<div class="fab-container">
    <div class="fab-main" title="Quick Actions">
        <i class="bi bi-plus-lg"></i>
    </div>
    <div class="fab-options">
        <div class="fab-option" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Back to Top">
            <i class="bi bi-arrow-up"></i>
        </div>
        <div class="fab-option" onclick="window.location.href='@Url.Action("Index", "Home")#features'" title="Features">
            <i class="bi bi-star"></i>
        </div>
        <div class="fab-option" onclick="openCartSidebar()" title="Cart">
            <i class="bi bi-cart"></i>
        </div>
    </div>
</div>
-->
@section Styles {
    <link rel="stylesheet" href="~/css/modern-home-screen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/category-carousel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flash-sale-carousel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offers-carousel.css" asp-append-version="true" />
}

    @section Scripts {
    <script src="~/js/modern-home-screen.js" asp-append-version="true"></script>
    <script src="~/js/category-carousel.js" asp-append-version="true"></script>
    <script src="~/js/flash-sale-carousel.js" asp-append-version="true"></script>
    <script src="~/js/offers-carousel-responsive.js" asp-append-version="true"></script>
    <script>
        // Localizations for JavaScript
        const currentCulture = '@currentCulture';
        const localizations = {
            selectOptions: '@Html.Raw(Localizer["SelectOptions"])'
        };

        // Newsletter Form Handler - Fully Implemented
        document.getElementById('newsletterForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const form = e.target;
            const emailInput = document.getElementById('newsletterEmail');
            const submitBtn = form.querySelector('button[type="submit"]');
            const email = emailInput.value.trim();
            
            if (!email) {
                if (typeof toastr !== 'undefined') {
                    toastr.error('@Localizer["PleaseEnterValidEmail"]', '@Localizer["Newsletter"]');
                }
                return;
            }
            
            // Disable submit button
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>@Localizer["Subscribing"]...';
            
            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            // Create form data
            const formData = new FormData();
            formData.append('email', email);
            formData.append('source', 'HomePage');
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }
            
            // Make AJAX call
            fetch('@Url.Action("SubscribeNewsletter", "Home", new { area = "Customer" })', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token || ''
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    if (typeof toastr !== 'undefined') {
                        toastr.success(data.message, '@Localizer["Newsletter"]');
                    }
                    // Reload page to update subscription status
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    // Show error message
                    if (typeof toastr !== 'undefined') {
                        toastr.error(data.message, '@Localizer["Newsletter"]');
                    }
                    // Reset button
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-send me-2"></i>@Localizer["Subscribe"]';
                }
            })
            .catch(error => {
                console.error('Newsletter subscription error:', error);
                if (typeof toastr !== 'undefined') {
                    toastr.error('@Localizer["SubscriptionError"]', '@Localizer["Newsletter"]');
                }
                // Reset button
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-send me-2"></i>@Localizer["Subscribe"]';
            });
        });

        // Unsubscribe Button Handler
        document.getElementById('unsubscribeBtn')?.addEventListener('click', function() {
            const btn = this;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            Swal.fire({
                title: '@Localizer["Unsubscribe"]',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '@Localizer["Unsubscribe"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }
            
                // Disable button
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>@Localizer["Unsubscribing"]...';
                
                // Create form data
                const formData = new FormData();
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }
                
                // Make AJAX call
                fetch('@Url.Action("UnsubscribeNewsletter", "Home", new { area = "Customer" })', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token || ''
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Show success message with SweetAlert
                        Swal.fire({
                            icon: 'success',
                            title: '@Localizer["Success"]',
                            text: data.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        // Show error message with SweetAlert
                        Swal.fire({
                            icon: 'error',
                            title: '@Localizer["Error"]',
                            text: data.message
                        });
                        // Reset button
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-x-circle me-2"></i>@Localizer["Unsubscribe"]';
                    }
                })
                .catch(error => {
                    console.error('Newsletter unsubscribe error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["SubscriptionError"]'
                    });
                    // Reset button
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-x-circle me-2"></i>@Localizer["Unsubscribe"]';
                });
            });
        });
        
        let currentPage = 1;
        let isLoading = false;
        let hasMoreProducts = true;
        const isAuthenticated = @Json.Serialize(User.Identity.IsAuthenticated);
        let cartProductIds = @Html.Raw(Json.Serialize(ViewBag.CartProductIds ?? new List<int>()));
        let wishlistProductIds = @Html.Raw(Json.Serialize(ViewBag.WishlistProductIds ?? new List<int>()));
        window.isAuthenticated = isAuthenticated; // Make available globally
        document.body.setAttribute('data-is-authenticated', isAuthenticated.toString());

        // Save scroll position before any operation
        function saveScrollPosition() {
            sessionStorage.setItem('scrollPosition', window.scrollY || window.pageYOffset);
        }

        // Restore scroll position
        function restoreScrollPosition() {
            const savedPosition = sessionStorage.getItem('scrollPosition');
            if (savedPosition) {
                window.scrollTo(0, parseInt(savedPosition));
            }
        }

        // Restore scroll position on page load
        window.addEventListener('load', function() {
            restoreScrollPosition();
            // Clear the saved position after restoring
            sessionStorage.removeItem('scrollPosition');
            loadCartItems();
            // Initialize floating cart badge for all users
                const initialCount = cartProductIds.length;
                updateFloatingCartBadge(initialCount);
        });

        // Save scroll position before page unload
        window.addEventListener('beforeunload', function() {
            saveScrollPosition();
        });

        // Function to format currency
        const currencySymbol = '@Html.Raw(currencySymbol)';
        function formatCurrency(value) {
            return currencySymbol + ' ' + value.toFixed(2);
        }

        // Function to update cart widget using AJAX
        function updateCartWidget() {
            // Add timestamp to prevent caching
            const timestamp = new Date().getTime();
            fetch(`/Customer/Home/GetCartWidget?t=${timestamp}`, {
                method: 'GET',
                cache: 'no-cache',
                headers: {
                    'Cache-Control': 'no-cache'
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(html => {
                    // Find the cart link by ID first, then by href
                    const cartLink = document.getElementById('cartNavLink') || document.querySelector('a[href*="/Customer/Cart/Index"]');
                    if (cartLink) {
                        cartLink.innerHTML = html;
                        console.log('Cart widget updated successfully via AJAX');
                    } else {
                        console.error('Cart link not found for AJAX update');
                    }
                })
                .catch(error => {
                    console.error('Error updating cart widget:', error);
                });
        }

        // Function to update navigation cart count directly
        function updateNavigationCartCount(count) {
            // Try to find cart link by ID first, then by href
            const cartLink = document.getElementById('cartNavLink') || document.querySelector('a[href*="/Customer/Cart/Index"]');
            
            if (cartLink) {
                // Find the count span inside the cart link - try multiple selectors
                let countSpan = cartLink.querySelector('span[style*="background"]');
                if (!countSpan) {
                    // Try finding by looking for the span with gradient background
                    const spans = cartLink.querySelectorAll('span');
                    countSpan = Array.from(spans).find(span => {
                        const bg = window.getComputedStyle(span).background || span.style.background || '';
                        return bg.includes('gradient') || bg.includes('linear-gradient');
                    });
                }
                if (!countSpan) {
                    // Try finding the last span (usually the count)
                    const spans = cartLink.querySelectorAll('span');
                    if (spans.length > 0) {
                        countSpan = spans[spans.length - 1];
                    }
                }
                
                if (countSpan) {
                    countSpan.textContent = count;
                    console.log('Cart count updated directly to:', count);
                    return true;
                } else {
                    // If span doesn't exist, update the entire link content via AJAX
                    console.log('Count span not found, will update via AJAX');
                    return false;
                }
            } else {
                console.error('Cart link not found');
                return false;
            }
        }

        // Function to update floating cart badge
        function updateFloatingCartBadge(count) {
            const floatingBadge = document.getElementById('floatingCartBadge');
            const floatingBtn = document.querySelector('.floating-cart-btn');
            if (floatingBadge) {
                floatingBadge.textContent = count;
                // Add pulse animation
                if (floatingBtn) {
                    floatingBtn.classList.add('pulse');
                    setTimeout(() => {
                        floatingBtn.classList.remove('pulse');
                    }, 600);
                }
            }
        }

        // Function to open cart sidebar
        function openCartSidebar() {
            console.log('Opening cart sidebar...');
            const sidebar = document.getElementById('cartSidebar');
            const overlay = document.getElementById('cartOverlay');
            
            if (sidebar && overlay) {
                sidebar.classList.add('active');
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden'; // Prevent background scrolling
                console.log('Cart sidebar opened successfully');
                loadCartItems();
            } else {
                console.error('Cart sidebar or overlay not found!');
            }
        }

        // Function to close cart sidebar
        function closeCartSidebar() {
            document.getElementById('cartSidebar').classList.remove('active');
            document.getElementById('cartOverlay').classList.remove('active');
            document.body.style.overflow = ''; // Restore scrolling
        }

        // Function to load cart items
        function loadCartItems() {
            console.log('loadCartItems called, isAuthenticated:', isAuthenticated);

            console.log('Fetching cart items from server...');
            fetch('/Customer/Cart/GetCartItems')
                .then(response => {
                    console.log('Cart items response received:', response.status);
                    return response.json();
                })
                .then(data => {
                    console.log('Cart items data:', data);
                    const container = document.getElementById('cartItemsContainer');
                    const countElement = document.getElementById('sidebarCartCount');
                    const subtotalElement = document.getElementById('cartSubtotal');

                    if (data.items && data.items.length > 0) {
                        container.innerHTML = data.items.map(item => createCartItemHTML(item)).join('');
                        countElement.textContent = data.items.length;
                        subtotalElement.textContent = formatCurrency(data.subtotal);
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(data.items.length);
                        console.log('Cart items loaded successfully:', data.items.length, 'items');
                    } else {
                        container.innerHTML = '<div class="cart-empty"><i class="bi bi-cart-x"></i><p>@Localizer["YourCartIsEmpty"]</p></div>';
                        countElement.textContent = '0';
                        subtotalElement.textContent = currencySymbol + ' 0.00';
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(0);
                        console.log('Cart is empty');
                    }
                })
                .catch(error => {
                    console.error('Error loading cart items:', error);
                });
        }

        // Function to create cart item HTML
        function createCartItemHTML(item) {
            return `
                <div class="cart-item" data-product-id="${item.productId}">
                    <img src="${item.imageUrl}" alt="${item.title}" class="cart-item-image">
                    <div class="cart-item-details">
                        <h6 class="cart-item-title">${item.title}</h6>
                        <p class="cart-item-price">${formatCurrency(item.price * item.count)}</p>
                        <div class="cart-item-quantity">
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateCartQuantity(${item.productId}, ${item.count - 1})">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span>${item.count}</span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateCartQuantity(${item.productId}, ${item.count + 1})">
                                <i class="bi bi-plus"></i>
                            </button>
                            <button class="cart-item-remove" onclick="removeFromCart(${item.productId})" title="Remove">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        // Function to update cart quantity
        function updateCartQuantity(productId, newCount) {
            if (newCount < 1) {
                removeFromCart(productId);
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('count', newCount);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadCartItems(); // This will also update the floating badge
                    updateCartWidget();
                }
            })
            .catch(error => {
                console.error('Error updating quantity:', error);
            });
        }

        // Function to remove item from cart
        function removeFromCart(productId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Home/ToggleCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update button state for this product
                    const button = document.querySelector(`button[data-product-id="${productId}"]`);
                    if (button) {
                        button.classList.remove('in-cart');
                        button.querySelector('i').className = 'bi bi-plus-lg';
                        button.title = 'Add to Cart';
                    }
                    cartProductIds = cartProductIds.filter(id => id !== productId);
                    
                    // Update floating cart badge
                    updateFloatingCartBadge(data.cartCount);
                    
                    // Update navigation cart count immediately
                    updateNavigationCartCount(data.cartCount);
                    
                    loadCartItems();
                    
                    // Always update via AJAX to ensure it's synced (with small delay)
                    setTimeout(() => {
                        updateCartWidget();
                    }, 150);
                    
                    if (typeof toastr !== 'undefined') {
                        toastr.info('Product removed from cart');
                    }
                }
            })
            .catch(error => {
                console.error('Error removing from cart:', error);
            });
        }

        // Function to toggle product in cart
        function toggleCart(productId, button) {
            const isCurrentlyInCart = button.classList.contains('in-cart');
            const originalIcon = button.querySelector('i').className;
            
            // Save scroll position in case of any unexpected navigation
            saveScrollPosition();
            
            button.classList.add('loading');
            button.querySelector('i').className = 'bi bi-arrow-repeat';
            button.querySelector('i').style.animation = 'spin 1s linear infinite';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('__RequestVerificationToken', token);

            fetch('/Customer/Home/ToggleCart', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                console.log('Server response:', data);
                if (data.success) {
                    button.classList.remove('loading');
                    button.querySelector('i').style.animation = '';
                    
                    if (data.isAdded) {
                        // Product was added
                        button.classList.add('in-cart');
                        button.querySelector('i').className = 'bi bi-check-lg';
                        button.title = 'Remove from Cart';
                        cartProductIds.push(productId);
                        
                        // Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.success(data.message);
                        }
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(data.cartCount);
                        
                        // Update navigation cart count immediately
                        updateNavigationCartCount(data.cartCount);
                        
                        // Always update via AJAX to ensure it's synced (with small delay)
                        setTimeout(() => {
                            updateCartWidget();
                        }, 150);
                        
                        console.log('About to open cart sidebar...');
                        // Open the cart sidebar to show the added item
                        openCartSidebar();
                    } else {
                        // Product was removed
                        button.classList.remove('in-cart');
                        button.querySelector('i').className = 'bi bi-plus-lg';
                        button.title = 'Add to Cart';
                        cartProductIds = cartProductIds.filter(id => id !== productId);
                        
                        // Show notification
                        if (typeof toastr !== 'undefined') {
                            toastr.info(data.message);
                        }
                        
                        // Update floating cart badge
                        updateFloatingCartBadge(data.cartCount);
                        
                        // Update navigation cart count immediately
                        updateNavigationCartCount(data.cartCount);
                        
                        // Always update via AJAX to ensure it's synced (with small delay)
                        setTimeout(() => {
                            updateCartWidget();
                        }, 150);
                    }
                } else {
                    throw new Error(data.message || 'Failed to update cart');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                button.classList.remove('loading');
                button.querySelector('i').className = originalIcon;
                button.querySelector('i').style.animation = '';
                if (typeof toastr !== 'undefined') {
                    toastr.error('Failed to update cart. Please try again.');
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to update cart. Please try again.'
                    });
                }
            });
        }

        // Function to create product HTML - NEW DESIGN
        window.createProductCard = function(product, isAuthenticated) {
            const discount = product.listPrice > 0 ? Math.floor((product.listPrice - product.price) / product.listPrice * 100) : 0;
            const discountText = '@(currentCulture == "ar" ? "خصم" : "OFF")';
            const hasVariants = product.hasVariants === true || product.productType === 1;
            const shouldShowPrice = product.shouldShowPrice !== undefined ? product.shouldShowPrice : (product.stockQuantity > 0);
            const allVariantsOutOfStock = product.allVariantsOutOfStock === true;
            const pricePrefix = hasVariants ? (currentCulture === 'ar' ? 'من ' : 'From ') : '';
            
            const priceHtml = shouldShowPrice 
                ? (discount > 0 
                    ? `<span class="current-price">${hasVariants ? `<span class="price-from-text">${pricePrefix}</span>` : ''}${formatCurrency(product.price)}</span>
                       <span class="list-price">${formatCurrency(product.listPrice)}</span>`
                    : `<span class="current-price">${hasVariants ? `<span class="price-from-text">${pricePrefix}</span>` : ''}${formatCurrency(product.price)}</span>`)
                : '';
            
            const outOfStockHtml = !shouldShowPrice && allVariantsOutOfStock
                ? `<div class="price-wrapper"><span class="text-muted" style="font-size: 0.9rem;">@Localizer["OutOfStock"]</span></div>`
                : '';
            
            const isInCart = cartProductIds.includes(product.id);
            const cartIcon = isInCart ? 'bi-check-lg' : 'bi-cart-plus';
            const cartClass = isInCart ? 'in-cart' : '';
            
            // Handle multiple images
            let imageHtml = '';
            // productImages from API is already an array of image URLs (strings), not objects
            let productImages = [];
            
            // Check if productImages exists and has items
            if (product.productImages && Array.isArray(product.productImages) && product.productImages.length > 0) {
                // If it's an array of strings (URLs), use directly
                if (typeof product.productImages[0] === 'string') {
                    productImages = product.productImages.filter(img => img && String(img).trim() !== '');
                } 
                // If it's an array of objects, extract URLs
                else if (product.productImages[0] && typeof product.productImages[0] === 'object') {
                    productImages = product.productImages
                        .filter(pi => pi && pi.imageUrl)
                        .sort((a, b) => (a.displayOrder || 0) - (b.displayOrder || 0))
                        .map(pi => pi.imageUrl)
                        .filter(img => img && String(img).trim() !== '');
                }
            }
            
            // Fallback to main imageUrl if no productImages
            if (productImages.length === 0) {
                if (product.imageUrl) {
                    productImages.push(product.imageUrl);
                } else {
                    // Last resort: try to get image from first productImage if it exists as object
                    if (product.productImages && product.productImages.length > 0 && product.productImages[0] && typeof product.productImages[0] === 'object') {
                        const firstImg = product.productImages[0];
                        if (firstImg.url) productImages.push(firstImg.url);
                        else if (firstImg.ImageUrl) productImages.push(firstImg.ImageUrl);
                    }
                }
            }
            
            // Normalize image URLs - convert backslashes to forward slashes and ensure leading slash
            productImages = productImages.map(img => {
                if (!img) return '';
                // Convert to string and trim
                img = String(img).trim();
                // Replace backslashes with forward slashes
                img = img.replace(/\\/g, '/');
                // Remove double slashes (except http:// or https://)
                img = img.replace(/([^:]\/)\/+/g, '$1');
                // Ensure it starts with / if it's a relative path
                if (img && !img.startsWith('http') && !img.startsWith('/') && !img.startsWith('data:')) {
                    img = '/' + img;
                }
                return img;
            }).filter(img => img && img.trim() !== '');
            
            if (productImages.length > 1) {
                // Multiple images - carousel
                let carouselItems = '';
                let indicators = '';
                productImages.forEach((img, index) => {
                    // Image URL is already normalized above
                    let imageUrl = img || '/images/placeholder.png';
                    
                    carouselItems += `
                        <div class="carousel-item ${index === 0 ? 'active' : ''}">
                            <img src="${imageUrl}" class="product-image" alt="${product.title || 'Product'} - Image ${index + 1}" onerror="this.src='/images/placeholder.png'; this.onerror=null;" />
                        </div>
                    `;
                    indicators += `
                        <button type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide-to="${index}" 
                                class="${index === 0 ? 'active' : ''}" aria-current="${index === 0 ? 'true' : 'false'}" 
                                aria-label="Slide ${index + 1}"></button>
                    `;
                });
                
                imageHtml = `
                    <div id="productCarousel_${product.id}" class="carousel slide product-image-carousel" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            ${carouselItems}
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_${product.id}" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                        <div class="carousel-indicators">
                            ${indicators}
                        </div>
                    </div>
                `;
            } else {
                // Single image - URL is already normalized above
                let imageUrl = productImages.length > 0 ? productImages[0] : '';
                
                // Fallback to main imageUrl if productImages is empty
                if (!imageUrl && product.imageUrl) {
                    imageUrl = product.imageUrl.replace(/\\/g, '/');
                    if (!imageUrl.startsWith('http') && !imageUrl.startsWith('/') && !imageUrl.startsWith('data:')) {
                        imageUrl = '/' + imageUrl;
                    }
                }
                
                // Fallback to a placeholder if no image
                if (!imageUrl) {
                    imageUrl = '/images/placeholder.png';
                }
                
                const productTitle = (currentCulture === 'ar' && product.titleAr) ? product.titleAr : (product.title || 'Product');
                imageHtml = `<img src="${imageUrl}" class="product-image" alt="${productTitle}" onerror="this.src='/images/placeholder.png'; this.onerror=null;" />`;
            }
            
            return `
                <div class="product-card stagger-item visible" 
                     data-stock-quantity="${product.stockQuantity || 0}" 
                     data-minimum-stock="${product.minimumStockAlert || 5}"
                     onclick="window.location.href='/Customer/Home/Details?productId=${product.id}'"
                     style="cursor: pointer;">
                    <div class="product-image-wrapper">
                        ${imageHtml}
                    </div>
                    <div class="product-content">
                        <h3 class="product-title">${(currentCulture === 'ar' && product.titleAr) ? product.titleAr : product.title}</h3>
                        <div class="product-card-rating" data-product-id="${product.id}">
                            <div class="product-card-stars">
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                                <i class="bi bi-star"></i>
                            </div>
                            <span class="product-card-rating-text">(0)</span>
                            ${discount > 0 ? `<span class="discount-badge-rating">${discount}% ${discountText}</span>` : ''}
                        </div>
                        <div class="price-actions-row" onclick="event.stopPropagation();">
                            ${shouldShowPrice ? `<div class="price-wrapper">${priceHtml}</div>` : outOfStockHtml}
                            <div class="product-actions">
                                ${(product.productType === 1 || product.productType === 'Variable')
                                    ? `<a href="/Customer/Home/Details?productId=${product.id}" class="btn-select-options">
                                        <i class="bi bi-list-check"></i>
                                        ${localizations.selectOptions}
                                       </a>`
                                    : `<button class="btn-add-cart-quick ${cartClass}" 
                                        data-product-id="${product.id}"
                                        onclick="toggleCart(${product.id}, this); event.stopPropagation();" 
                                        title="${isInCart ? 'In Cart' : 'Add to Cart'}">
                                        <i class="bi ${cartIcon}"></i>
                                       </button>`
                                }
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Function to get current filter parameters
        function getFilterParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const params = new URLSearchParams();
            
            if (urlParams.get('categoryId')) params.append('categoryId', urlParams.get('categoryId'));
            if (urlParams.get('searchTerm')) params.append('searchTerm', urlParams.get('searchTerm'));
            if (urlParams.get('sortBy')) params.append('sortBy', urlParams.get('sortBy'));
            if (urlParams.get('minPrice')) params.append('minPrice', urlParams.get('minPrice'));
            if (urlParams.get('maxPrice')) params.append('maxPrice', urlParams.get('maxPrice'));
            if (urlParams.get('inStock')) params.append('inStock', urlParams.get('inStock'));
            if (urlParams.get('availability')) params.append('availability', urlParams.get('availability'));
            
            return params.toString();
        }

        // Function to load products with filters via AJAX (no page refresh)
        function loadProductsWithFilters(filters = {}, scrollToProducts = true, updateUrl = false) {
            // Prevent multiple simultaneous calls
            if (window.isLoadingProducts) {
                return;
            }
            window.isLoadingProducts = true;

            const productContainer = document.getElementById('productContainer');
            const loadMoreContainer = document.getElementById('loadMoreContainer');
            
            if (!productContainer) {
                console.error('Product container not found');
                window.isLoadingProducts = false;
                return;
            }

            // Show loading state
            const originalContent = productContainer.innerHTML;
            productContainer.innerHTML = `
                <div class="text-center py-5" style="grid-column: 1 / -1;">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">@Localizer["LoadingProducts"]...</p>
                </div>
            `;
            
            // Hide load more button during loading
            if (loadMoreContainer) {
                loadMoreContainer.style.display = 'none';
            }

            // Build filter parameters
            const params = new URLSearchParams();
            if (filters.categoryId) params.append('categoryId', filters.categoryId);
            if (filters.searchTerm) params.append('searchTerm', filters.searchTerm);
            if (filters.sortBy) params.append('sortBy', filters.sortBy);
            if (filters.minPrice) params.append('minPrice', filters.minPrice);
            if (filters.maxPrice) params.append('maxPrice', filters.maxPrice);
            if (filters.inStock !== undefined) params.append('inStock', filters.inStock);
            if (filters.availability) params.append('availability', filters.availability);

            // Update active category in category carousel
            if (filters.categoryId) {
                // Remove active class from all category cards
                document.querySelectorAll('.category-card').forEach(card => {
                    card.classList.remove('active');
                });
                // Add active class to selected category
                const activeCard = document.querySelector(`.category-card[data-category-id="${filters.categoryId}"]`);
                if (activeCard) {
                    activeCard.classList.add('active');
                }
            } else {
                // Remove active class from all if no category selected
                document.querySelectorAll('.category-card').forEach(card => {
                    card.classList.remove('active');
                });
                // Set "All Categories" as active when no category is selected
                const allCategoriesCard = document.querySelector('.category-card[data-category-id="0"]');
                if (allCategoriesCard) {
                    allCategoriesCard.classList.add('active');
                }
            }

            // Build URL
            const url = `/Customer/Home/FilterProducts?${params.toString()}`;

            // Update URL without page reload (only if updateUrl is true)
            if (updateUrl) {
                const newUrl = new URL(window.location.href);
                newUrl.search = params.toString();
                window.history.pushState({ path: newUrl.href }, '', newUrl.href);
            }

            // Fetch filtered products
            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    window.isLoadingProducts = false;
                    
                    // Clear container
                    productContainer.innerHTML = '';

                    if (!data.products || data.products.length === 0) {
                        productContainer.innerHTML = `
                            <div class="text-center py-5" style="grid-column: 1 / -1;">
                                <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                <p class="mt-3 text-muted">@Localizer["NoProductsFound"]</p>
                            </div>
                        `;
                        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
                        currentPage = 0;
                        hasMoreProducts = false;
                        return;
                    }

                    // Render products
                    data.products.forEach((product, index) => {
                        const productHtml = createProductCard(product, isAuthenticated);
                        productContainer.insertAdjacentHTML('beforeend', productHtml);
                    });

                    // Animate products with stagger effect
                    const productCards = productContainer.querySelectorAll('.product-card.stagger-item');
                    productCards.forEach((card, index) => {
                        card.classList.remove('visible');
                        setTimeout(() => {
                            card.classList.add('visible');
                        }, index * 50);
                    });

                    // Load ratings for products
                    loadAllProductRatings();

                    // Update pagination state
                    currentPage = 0;
                    hasMoreProducts = data.hasMore || false;

                    // Show/hide load more button
                    if (loadMoreContainer) {
                        if (hasMoreProducts) {
                            loadMoreContainer.style.display = 'block';
                            const loadMoreBtn = document.getElementById('loadMoreBtn');
                            if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                        } else {
                            loadMoreContainer.style.display = 'none';
                        }
                    }

                    // Scroll to products section if requested
                    if (scrollToProducts) {
                        scrollToProductsSection();
                    }

                    // Update filter form inputs to match current filters
                    if (filters.categoryId) {
                        const categoryInput = document.querySelector('input[name="categoryId"]');
                        if (categoryInput) categoryInput.value = filters.categoryId;
                    }
                })
                .catch(error => {
                    window.isLoadingProducts = false;
                    console.error('Error loading products:', error);
                    productContainer.innerHTML = `
                        <div class="text-center py-5" style="grid-column: 1 / -1;">
                            <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
                            <p class="mt-3 text-danger">@Localizer["ErrorLoadingProducts"]</p>
                            <button class="btn btn-primary mt-3" onclick="loadProductsWithFilters({})">@Localizer["Retry"]</button>
                        </div>
                    `;
                });
        }

        // Event delegation for category card clicks (handles dynamically reorganized carousel items)
        window.handleCategoryCardClick = function(categoryCard, event) {
            if (!categoryCard || !categoryCard.hasAttribute('data-category-id')) {
                return false;
            }
            
            // Always prevent default and stop propagation
            if (event) {
                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();
            }
            
            const categoryId = categoryCard.getAttribute('data-category-id');
            const categoryIdNum = parseInt(categoryId);
            
            if (isNaN(categoryIdNum)) {
                return false;
            }
            
            // Remove active class from all category cards
            document.querySelectorAll('.category-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to clicked card
            categoryCard.classList.add('active');
            
            // Load products with category filter via AJAX (without URL update)
            if (typeof loadProductsWithFilters === 'function') {
                // If categoryId is 0, it means "All Categories" - clear the category filter
                if (categoryIdNum === 0) {
                    loadProductsWithFilters({}, true, false);
                } else {
                    loadProductsWithFilters({ categoryId: categoryIdNum }, true, false);
                }
            } else {
                // Fallback to page navigation if function doesn't exist
                if (categoryIdNum === 0) {
                    window.location.href = '@Url.Action("Index", "Home", new { area = "Customer" })';
                } else {
                    window.location.href = `@Url.Action("Index", "Home", new { area = "Customer" })?categoryId=${categoryIdNum}`;
                }
            }
            
            return false;
        }
        
        // Handle clicks - use capture phase to catch early
        document.addEventListener('click', function(e) {
            const categoryCard = e.target.closest('.category-card');
            if (categoryCard && categoryCard.hasAttribute('data-category-id')) {
                handleCategoryCardClick(categoryCard, e);
                return false;
            }
        }, true); // Use capture phase
        
        // Handle keyboard (Enter/Space) for accessibility
        document.addEventListener('keydown', function(e) {
            const categoryCard = e.target.closest('.category-card');
            if (categoryCard && categoryCard.hasAttribute('data-category-id')) {
                if (e.key === 'Enter' || e.key === ' ') {
                    handleCategoryCardClick(categoryCard, e);
                    return false;
                }
            }
        }, true); // Use capture phase

        // Function to scroll to products section smoothly
        function scrollToProductsSection() {
            const productsSection = document.getElementById('productsSection');
            if (productsSection) {
                const headerOffset = 100; // Account for fixed header
                const elementPosition = productsSection.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }
        }

        // Function to load more products with filters
        function loadMoreProducts() {
            if (isLoading || !hasMoreProducts) return;

            isLoading = true;
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const loadingIndicator = document.getElementById('loadingIndicator');
            const loadMoreContainer = document.getElementById('loadMoreContainer');
            
            // Hide button, show loading
            if (loadMoreBtn) loadMoreBtn.style.display = 'none';
            if (loadingIndicator) loadingIndicator.style.display = 'block';

            const filterParams = getFilterParams();
            const url = `/Customer/Home/LoadMoreProducts?page=${currentPage}&pageSize=20${filterParams ? '&' + filterParams : ''}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('productContainer');
                    
                    if (!container) {
                        console.error('Product container not found');
                        isLoading = false;
                        if (loadingIndicator) loadingIndicator.style.display = 'none';
                        if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                        return;
                    }
                    
                    // Get the number of existing products to calculate stagger delay
                    const existingProducts = container.querySelectorAll('.product-card.stagger-item').length;
                    
                    data.products.forEach((product, index) => {
                        // Debug: Log product data to console
                        if (index === 0) {
                            console.log('Sample product data:', {
                                id: product.id,
                                title: product.title,
                                imageUrl: product.imageUrl,
                                productImages: product.productImages,
                                productImagesType: typeof product.productImages,
                                productImagesLength: product.productImages ? product.productImages.length : 0
                            });
                        }
                        
                        const productHtml = createProductCard(product, isAuthenticated);
                        container.insertAdjacentHTML('beforeend', productHtml);
                    });
                    
                    // Get all newly added product cards and make them visible with stagger animation
                    const allProductCards = container.querySelectorAll('.product-card.stagger-item');
                    const newProductCards = Array.from(allProductCards).slice(existingProducts);
                    
                    // Force image reload and make cards visible
                    newProductCards.forEach((card, index) => {
                        // Find all images in this card and ensure they load
                        const images = card.querySelectorAll('img');
                        images.forEach(img => {
                            // Force reload by setting src again
                            const originalSrc = img.src;
                            img.src = '';
                            setTimeout(() => {
                                img.src = originalSrc;
                            }, 10);
                            
                            // Add error handler
                            img.onerror = function() {
                                console.error('Image failed to load:', originalSrc);
                                this.src = '/images/placeholder.png';
                            };
                        });
                        
                        // Add visible class with stagger delay for smooth animation
                        setTimeout(() => {
                            card.classList.add('visible');
                        }, (index * 50) + 100);
                    });

                    // Load ratings for newly added products
                    loadAllProductRatings();
                    
                    // Initialize badges for newly loaded products
                    if (typeof initProductBadges === 'function') {
                        initProductBadges();
                    }
                    
                    // Create or reuse observer for newly loaded products
                    // This ensures any products that scroll into view later will animate
                    if (!window.staggerObserver) {
                        window.staggerObserver = new IntersectionObserver((entries) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('visible');
                                }
                            });
                        }, { threshold: 0.1 });
                    }
                    
                    // Observe newly added products that aren't visible yet
                    newProductCards.forEach(item => {
                        if (!item.classList.contains('visible')) {
                            window.staggerObserver.observe(item);
                        }
                    });

                    hasMoreProducts = data.hasMore;
                    currentPage++;
                    isLoading = false;
                    
                    // Hide loading, show button if more products available
                    if (loadingIndicator) loadingIndicator.style.display = 'none';
                    
                    if (hasMoreProducts) {
                        if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                    } else {
                        // No more products, hide the container
                        if (loadMoreContainer) loadMoreContainer.style.display = 'none';
                    }
                })
                .catch(error => {
                    console.error('Error loading products:', error);
                    isLoading = false;
                    if (loadingIndicator) loadingIndicator.style.display = 'none';
                    if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
                });
        }

        // Flag to prevent multiple simultaneous API calls
        let isCheckingLoadMore = false;
        let hasCheckedLoadMore = false;

        // Check if there are more products on page load and show button (without API call)
        function checkAndShowLoadMoreButton() {
            // Prevent multiple simultaneous calls
            if (hasCheckedLoadMore) {
                return;
            }

            const loadMoreContainer = document.getElementById('loadMoreContainer');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const productCount = document.querySelectorAll('.product-card').length;
            
            // If we have exactly 20 products, likely there are more (since Index shows 20 max)
            // Just show the button, don't make an API call - let the user click to load more
            if (productCount === 20) {
                hasMoreProducts = true; // Assume there are more
                if (loadMoreContainer) {
                    loadMoreContainer.style.display = 'block';
                }
                if (loadMoreBtn) {
                    loadMoreBtn.style.display = 'inline-block';
                }
            } 
            // If we have products but less than 20, likely no more products
            else if (productCount > 0 && productCount < 20) {
                hasMoreProducts = false;
                if (loadMoreContainer) {
                    loadMoreContainer.style.display = 'none';
                }
            } 
            // No products at all
            else {
                hasMoreProducts = false;
                if (loadMoreContainer) {
                    loadMoreContainer.style.display = 'none';
                }
            }
            
            hasCheckedLoadMore = true; // Mark as checked
        }

        // Save scroll position when clicking on any link (like Details button)
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href) {
                saveScrollPosition();
            }
        });

        // Enhanced Filter Interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Filter toggle for mobile
            const filterToggleBtn = document.getElementById('filterToggleBtn');
            const filterGroups = document.getElementById('filterGroups');
            
            if (filterToggleBtn && filterGroups) {
                filterToggleBtn.addEventListener('click', function() {
                    filterGroups.classList.toggle('active');
                    filterToggleBtn.classList.toggle('active');
                });
            }
            
            // Price range slider interactions
            const priceRangeMin = document.getElementById('priceRangeMin');
            const priceRangeMax = document.getElementById('priceRangeMax');
            const priceMinInput = document.querySelector('input[name="minPrice"]');
            const priceMaxInput = document.querySelector('input[name="maxPrice"]');
            const priceMinDisplay = document.getElementById('priceMinDisplay');
            const priceMaxDisplay = document.getElementById('priceMaxDisplay');
            
            if (priceRangeMin && priceRangeMax && priceMinInput && priceMaxInput) {
                const minPrice = parseFloat(priceRangeMin.getAttribute('min')) || 0;
                const maxPrice = parseFloat(priceRangeMax.getAttribute('max')) || 10000;
                
                // Check if inputs have values from server/URL - don't sync from sliders if empty
                const hasMinPrice = priceMinInput.value && priceMinInput.value.trim() !== '';
                const hasMaxPrice = priceMaxInput.value && priceMaxInput.value.trim() !== '';
                
                // Ensure inputs stay empty if no price filter is set
                if (!hasMinPrice) {
                    priceMinInput.value = '';
                }
                if (!hasMaxPrice) {
                    priceMaxInput.value = '';
                }
                
                // Update display when sliders change (only syncs when user moves slider)
                priceRangeMin.addEventListener('input', function() {
                    const value = parseFloat(this.value);
                    if (priceMinInput) priceMinInput.value = value.toFixed(2);
                    if (priceMinDisplay) priceMinDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                });
                
                priceRangeMax.addEventListener('input', function() {
                    const value = parseFloat(this.value);
                    if (priceMaxInput) priceMaxInput.value = value.toFixed(2);
                    if (priceMaxDisplay) priceMaxDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                });
                
                // Initialize display text from current slider range values (for display only, not input)
                if (!hasMinPrice && priceMinDisplay) {
                    priceMinDisplay.textContent = currencySymbol + ' ' + minPrice.toFixed(2);
                }
                if (!hasMaxPrice && priceMaxDisplay) {
                    priceMaxDisplay.textContent = currencySymbol + ' ' + maxPrice.toFixed(2);
                }
                
                // Update sliders when inputs change
                if (priceMinInput) {
                    priceMinInput.addEventListener('input', function() {
                        const value = Math.max(minPrice, Math.min(maxPrice, parseFloat(this.value) || minPrice));
                        priceRangeMin.value = value;
                        if (priceMinDisplay) priceMinDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                    });
                }
                
                if (priceMaxInput) {
                    priceMaxInput.addEventListener('input', function() {
                        const value = Math.max(minPrice, Math.min(maxPrice, parseFloat(this.value) || maxPrice));
                        priceRangeMax.value = value;
                        if (priceMaxDisplay) priceMaxDisplay.textContent = currencySymbol + ' ' + value.toFixed(2);
                    });
                }
            }
            
            // Auto-submit on filter change (with debounce for price inputs)
            let filterTimeout;
            const filterForm = document.getElementById('filterForm');
            const priceInputs = document.querySelectorAll('.price-input');
            
            priceInputs.forEach(input => {
                input.addEventListener('input', function() {
                    clearTimeout(filterTimeout);
                    filterTimeout = setTimeout(() => {
                        // Don't auto-submit price, let user click Apply
                    }, 500);
                });
            });
            
            // Select filters - DO NOT auto-submit (use Apply button instead)
            // Removed auto-submit to prevent page reloads - filters now use AJAX via Apply button
            const autoSubmitSelects = document.querySelectorAll('.modern-select:not([name="minPrice"]):not([name="maxPrice"])');
            autoSubmitSelects.forEach(select => {
                select.addEventListener('change', function(e) {
                    e.preventDefault();
                    // Don't auto-submit - user must click Apply Filters button
                    // This prevents page reloads and uses AJAX instead
                });
            });
            
            // Initialize filter state from URL
            initializeFiltersFromURL();
            
            // Search clear button functionality
            const heroSearchInput = document.getElementById('heroSearchInput');
            const searchClearBtn = document.getElementById('searchClearBtn');
            
            if (heroSearchInput && searchClearBtn) {
                // Show/hide clear button based on input value
                function toggleClearButton() {
                    if (heroSearchInput.value.trim() !== '') {
                        searchClearBtn.style.display = 'block';
                    } else {
                        searchClearBtn.style.display = 'none';
                    }
                }
                
                // Toggle on input
                heroSearchInput.addEventListener('input', toggleClearButton);
                
                // Toggle on page load
                toggleClearButton();
                
                // Clear search when button is clicked
                searchClearBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    heroSearchInput.value = '';
                    searchClearBtn.style.display = 'none';
                    heroSearchInput.focus();
                    
                    // Clear search filter and reload products
                    if (typeof loadProductsWithFilters === 'function') {
                        loadProductsWithFilters({ searchTerm: '' }, false, false);
                    }
                });
            }
        });
        
        // Initialize filters from URL parameters
        function initializeFiltersFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const minPrice = urlParams.get('minPrice');
            const maxPrice = urlParams.get('maxPrice');
            
            const priceMinInput = document.querySelector('input[name="minPrice"]');
            const priceMaxInput = document.querySelector('input[name="maxPrice"]');
            const priceRangeMin = document.getElementById('priceRangeMin');
            const priceRangeMax = document.getElementById('priceRangeMax');
            
            // Only set values if they exist in URL - otherwise keep inputs empty
            if (minPrice && minPrice.trim() !== '') {
                if (priceMinInput) priceMinInput.value = parseFloat(minPrice).toFixed(2);
                if (priceRangeMin) priceRangeMin.value = minPrice;
            } else {
                // Ensure input is empty if no minPrice
                if (priceMinInput) priceMinInput.value = '';
            }
            
            if (maxPrice && maxPrice.trim() !== '') {
                if (priceMaxInput) priceMaxInput.value = parseFloat(maxPrice).toFixed(2);
                if (priceRangeMax) priceRangeMax.value = maxPrice;
            } else {
                // Ensure input is empty if no maxPrice
                if (priceMaxInput) priceMaxInput.value = '';
            }
        }

        // Load ratings for all products and check for load more button
        document.addEventListener('DOMContentLoaded', function() {
            loadAllProductRatings();

            // Check if we need to show the Load More button after products are rendered
            // Use a single call with appropriate delay to ensure DOM is ready
            setTimeout(function() {
                checkAndShowLoadMoreButton();
            }, 500);

            // Initialize active category from URL parameter
            const urlParams = new URLSearchParams(window.location.search);
            const categoryId = urlParams.get('categoryId');
            if (categoryId) {
                // Remove active class from all category cards
                document.querySelectorAll('.category-card').forEach(card => {
                    card.classList.remove('active');
                });
                // Add active class to selected category
                const activeCard = document.querySelector(`.category-card[data-category-id="${categoryId}"]`);
                if (activeCard) {
                    activeCard.classList.add('active');
                }
            }
        });
        
        // Also check when window loads (as a fallback, but only if not already checked)
        window.addEventListener('load', function() {
            // Only check if not already checked (in case DOMContentLoaded was too early)
            if (!hasCheckedLoadMore) {
                setTimeout(function() {
                    checkAndShowLoadMoreButton();
                }, 300);
            }
        });

        function loadAllProductRatings() {
            const ratingElements = document.querySelectorAll('.product-card-rating');
            if (ratingElements.length === 0) return;

            // Collect all product IDs
            const productIds = Array.from(ratingElements)
                .map(element => {
                    const productId = element.getAttribute('data-product-id');
                    return productId ? parseInt(productId) : null;
                })
                .filter(id => id !== null);

            if (productIds.length === 0) return;

            // Make a single batch API call for all products
            fetch('/Customer/Review/GetBatchProductRatings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(productIds)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.ratings) {
                        // Update each product card with its rating
                        ratingElements.forEach(element => {
                            const productId = parseInt(element.getAttribute('data-product-id'));
                            if (productId && data.ratings[productId]) {
                                const rating = data.ratings[productId];
                                if (rating.reviewCount > 0) {
                                    const starsHtml = getStarsHTML(rating.averageRating);
                                    const starsElement = element.querySelector('.product-card-stars');
                                    const textElement = element.querySelector('.product-card-rating-text');
                                    if (starsElement) starsElement.innerHTML = starsHtml;
                                    if (textElement) textElement.textContent = `(${rating.reviewCount})`;
                                }
                            }
                        });
                    }
                })
                .catch(error => console.error('Error loading ratings:', error));
        }

        // Keep individual function for backward compatibility (if needed elsewhere)
        function loadProductCardRating(productId, element) {
            fetch(`/Customer/Review/GetProductRating?productId=${productId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.reviewCount > 0) {
                        const starsHtml = getStarsHTML(data.averageRating);
                        element.querySelector('.product-card-stars').innerHTML = starsHtml;
                        element.querySelector('.product-card-rating-text').textContent = 
                            `(${data.reviewCount})`;
                    }
                })
                .catch(error => console.error('Error loading rating:', error));
        }

        function getStarsHTML(rating) {
            const fullStars = Math.floor(rating);
            const hasHalf = (rating % 1) >= 0.5;
            let html = '';
            
            for (let i = 0; i < fullStars; i++) {
                html += '<i class="bi bi-star-fill"></i>';
            }
            if (hasHalf) {
                html += '<i class="bi bi-star-half"></i>';
            }
            for (let i = fullStars + (hasHalf ? 1 : 0); i < 5; i++) {
                html += '<i class="bi bi-star"></i>';
            }
            
            return html;
        }

        // ==========================================
        // WISHLIST FUNCTIONS
        // ==========================================
        
        @if (User.Identity.IsAuthenticated)
        {
            <text>
            // Wishlist Sidebar Functions
            function openWishlistSidebar() {
                const sidebar = document.getElementById('wishlistSidebar');
                const overlay = document.getElementById('wishlistOverlay');
                
                if (sidebar && overlay) {
                    sidebar.classList.add('active');
                    overlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                    loadWishlistItemsToSidebar();
                }
            }

            function closeWishlistSidebar() {
                const sidebar = document.getElementById('wishlistSidebar');
                const overlay = document.getElementById('wishlistOverlay');
                
                if (sidebar) sidebar.classList.remove('active');
                if (overlay) overlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            function loadWishlistItemsToSidebar() {
                fetch('/Customer/Home/GetWishlistItems')
                    .then(response => response.json())
                    .then(data => {
                        const container = document.getElementById('wishlistItemsContainer');
                        const countElement = document.getElementById('sidebarWishlistCount');

                        if (data.success && data.items && data.items.length > 0) {
                            container.innerHTML = data.items.map(item => createWishlistItemHTML(item)).join('');
                            if (countElement) countElement.textContent = data.count;
                            updateFloatingWishlistBadge(data.count);
                        } else {
                            container.innerHTML = '<div class="wishlist-empty"><i class="bi bi-heart"></i><p>@Localizer["YourWishlistIsEmpty"]</p></div>';
                            if (countElement) countElement.textContent = '0';
                            updateFloatingWishlistBadge(0);
                        }
                    })
                    .catch(error => {
                        console.error('Error loading wishlist items:', error);
                        const container = document.getElementById('wishlistItemsContainer');
                        if (container) {
                            container.innerHTML = '<div class="wishlist-empty"><p>Error loading wishlist</p></div>';
                        }
                    });
            }

            function createWishlistItemHTML(item) {
                const discount = item.listPrice && item.listPrice > item.price 
                    ? Math.floor((item.listPrice - item.price) / item.listPrice * 100) 
                    : 0;
                
                const isVariable = item.productType === 1 || item.productType === 'Variable';
                
                return `
                    <div class="wishlist-item" data-product-id="${item.productId}">
                        <img src="${item.imageUrl}" alt="${item.title}" class="wishlist-item-image">
                        <div class="wishlist-item-details">
                            <h6 class="wishlist-item-title">${item.title}</h6>
                            <div class="wishlist-item-price">
                                ${discount > 0 
                                    ? `<span class="current-price">AED ${item.price.toFixed(2)}</span>
                                       <span class="list-price">AED ${item.listPrice.toFixed(2)}</span>`
                                    : `<span class="current-price">AED ${item.price.toFixed(2)}</span>`
                                }
                            </div>
                            <div class="wishlist-item-actions">
                                ${isVariable
                                    ? `<a href="/Customer/Home/Details?productId=${item.productId}" class="btn btn-select-options-from-wishlist" title="Select Options">
                                        <i class="bi bi-list-check me-1"></i>${localizations.selectOptions}
                                       </a>`
                                    : `<button class="btn btn-add-cart-from-wishlist" onclick="addToCartFromWishlist(${item.productId}, ${item.id})" title="Add to Cart">
                                        <i class="bi bi-cart-plus me-1"></i>@Localizer["AddToCart"]
                                       </button>`
                                }
                                <button class="btn btn-remove-wishlist" onclick="removeFromWishlist(${item.id}, ${item.productId})" title="Remove">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            function addToCartFromWishlist(productId, wishlistId) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('productId', productId);
                formData.append('__RequestVerificationToken', token);

                fetch('/Customer/Home/ToggleCart', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.isAdded) {
                        if (typeof toastr !== 'undefined') {
                            toastr.success('Added to cart!');
                        }
                        if (typeof updateFloatingCartBadge === 'function') {
                            updateFloatingCartBadge(data.cartCount);
                        }
                    }
                })
                .catch(error => {
                    console.error('Error adding to cart:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to add to cart');
                    }
                });
            }

            function removeFromWishlist(wishlistId, productId) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('wishlistId', wishlistId);
                formData.append('__RequestVerificationToken', token);

                fetch('/Customer/Home/RemoveFromWishlist', {
                    method: 'DELETE',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const item = document.querySelector(`.wishlist-item[data-product-id="${productId}"]`);
                        if (item) item.remove();
                        
                        const btn = document.querySelector(`.wishlist-btn[data-product-id="${productId}"]`);
                        if (btn) {
                            btn.classList.remove('active');
                            btn.querySelector('i').className = 'bi bi-heart';
                            btn.title = 'Add to wishlist';
                        }
                        
                        updateFloatingWishlistBadge(data.wishlistCount);
                        
                        const countElement = document.getElementById('sidebarWishlistCount');
                        if (countElement) countElement.textContent = data.wishlistCount;
                        
                        if (data.wishlistCount === 0) {
                            loadWishlistItemsToSidebar();
                        }
                        
                        if (typeof toastr !== 'undefined') {
                            toastr.info(data.message);
                        }
                        
                        wishlistProductIds = wishlistProductIds.filter(id => id !== productId);
                    }
                })
                .catch(error => {
                    console.error('Error removing from wishlist:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to remove from wishlist');
                    }
                });
            }

            function updateFloatingWishlistBadge(count) {
                const floatingBadge = document.getElementById('floatingWishlistBadge');
                const floatingBtn = document.querySelector('.floating-wishlist-btn');
                if (floatingBadge) {
                    floatingBadge.textContent = count;
                    if (count > 0) {
                        floatingBadge.style.display = 'flex';
                    } else {
                        floatingBadge.style.display = 'none';
                    }
                    if (floatingBtn) {
                        floatingBtn.classList.add('pulse');
                        setTimeout(() => {
                            floatingBtn.classList.remove('pulse');
                        }, 600);
                    }
                }
            }

            // // Load wishlist on page load
            // window.addEventListener('load', function() {
            //     fetch('/Customer/Home/GetWishlistProductIds')
            //         .then(response => response.json())
            //         .then(data => {
            //             if (data.productIds) {
            //                 updateFloatingWishlistBadge(data.productIds.length);
            //             }
            //         })
            //         .catch(error => console.error('Error loading wishlist count:', error));
            // });
            </text>
        }
    </script>

    <!-- PERFORMANCE: Lazy loading for sections - Load independently via AJAX -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Function to load a section via AJAX
            function loadSection(url, placeholderId) {
                const placeholder = document.getElementById(placeholderId);
                if (!placeholder) return;

                fetch(url)
                    .then(response => {
                        if (!response.ok) {
                            // If 500 error or other error, hide the placeholder
                            if (response.status >= 500) {
                                console.warn(`Server error loading ${placeholderId}, hiding section`);
                                placeholder.style.display = 'none';
                                return '';
                            }
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.text();
                    })
                    .then(html => {
                        if (html && html.trim().length > 0) {
                            placeholder.outerHTML = html;
                            
                            // Wait a bit for DOM to update before initializing
                            setTimeout(() => {
                                // Reinitialize any scripts/event handlers after content loads
                                if (typeof initializeFlashSaleCarousel === 'function') {
                                    initializeFlashSaleCarousel();
                                }
                                if (typeof initializeProductCarousels === 'function') {
                                    initializeProductCarousels();
                                }
                                
                                // Initialize Bootstrap carousels if they exist with touch support
                                if (typeof bootstrap !== 'undefined') {
                                    document.querySelectorAll('.carousel').forEach(carousel => {
                                        // Check if carousel is already initialized
                                        const existingCarousel = bootstrap.Carousel.getInstance(carousel);
                                        if (!existingCarousel) {
                                            // Get interval from data attribute or default to 8000
                                            const interval = carousel.dataset.bsInterval || carousel.getAttribute('data-bs-interval') || '8000';
                                            new bootstrap.Carousel(carousel, {
                                                interval: parseInt(interval),
                                                wrap: true,
                                                touch: true // Enable touch support for mobile
                                            });
                                        }
                                    });
                                }
                                
                                // Enhance carousels for mobile if needed
                                if (window.innerWidth <= 767 && typeof enhanceCarouselsForMobile === 'function') {
                                    setTimeout(function() {
                                        enhanceCarouselsForMobile();
                                    }, 100);
                                }
                                
                                // Also enhance carousels for mobile if needed
                                if (typeof window.enhanceCarouselsForMobile === 'function' && window.innerWidth <= 767) {
                                    setTimeout(() => {
                                        window.enhanceCarouselsForMobile();
                                    }, 100);
                                }
                            }, 50);
                        } else {
                            // Hide placeholder if no content
                            placeholder.style.display = 'none';
                        }
                    })
                    .catch(error => {
                        console.error(`Error loading section ${placeholderId}:`, error);
                        // Hide on error instead of showing error message for better UX
                        placeholder.style.display = 'none';
                    });
            }

            // Load sections in sequence with small delays to avoid overwhelming the server
            // Priority order: Flash Sales -> Discounted Products -> Services -> Category Products -> Best Sellers -> New Arrivals
            
            setTimeout(() => loadSection('/Customer/Home/LoadFlashSalesSection', 'flashSalesSectionPlaceholder'), 100);
            setTimeout(() => loadSection('/Customer/Home/LoadDiscountedProductsSection', 'discountedProductsSectionPlaceholder'), 300);
            setTimeout(() => loadSection('/Customer/Home/LoadServicesSection', 'servicesSectionPlaceholder'), 500);
            setTimeout(() => loadSection('/Customer/Home/LoadCategoryProductsSection', 'categoryProductsSectionPlaceholder'), 700);
            setTimeout(() => loadSection('/Customer/Home/LoadBestSellersSection', 'bestSellersSectionPlaceholder'), 900);
            setTimeout(() => loadSection('/Customer/Home/LoadNewArrivalsSection', 'newArrivalsSectionPlaceholder'), 1100);
            setTimeout(() => loadSection('/Customer/Home/LoadComboOffersSection', 'comboOffersSectionPlaceholder'), 1300);
        });
    </script>
}

