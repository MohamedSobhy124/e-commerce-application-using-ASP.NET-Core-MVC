@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@model IEnumerable<Product>
@inject BulkyBook.DataAccess.Repository.IRepository.IUnitOfWork _unitOfWork

@{
    var categories = ViewBag.Categories as IEnumerable<BulkyBook.Models.Categry> ?? Enumerable.Empty<BulkyBook.Models.Categry>();
    var selectedCategory = ViewBag.SelectedCategory as int?;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "";
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
    var inStock = ViewBag.InStock as bool?;
    var availability = ViewBag.Availability as string ?? "";
    var minPriceRange = ViewBag.MinPriceRange as decimal? ?? 0;
    var maxPriceRange = ViewBag.MaxPriceRange as decimal? ?? 1000;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
}
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<!-- Hero Section -->
<section class="hero-section">
    <!-- Morphing Shapes Background -->
    <div class="morphing-bg">
        <div class="morph-shape"></div>
        <div class="morph-shape"></div>
    </div>
    
    <!-- Floating Particles -->
    <div class="particles-container">
        <div class="particle-orb"></div>
        <div class="particle-orb"></div>
        <div class="particle-orb"></div>
        <div class="particle-orb"></div>
    </div>
    
    <div class="container">
        <div class="hero-content">
            <!-- Welcome Message -->
            <div class="hero-welcome">
                <p class="hero-welcome-text">
                    <i class="bi bi-stars"></i>
                    <span>@Localizer["WelcomeToHealthFitness"]</span>
                </p>
            </div>

            <h1 class="hero-title neon-text">
                <i class="bi bi-heart-pulse me-3"></i>
                @Localizer["DiscoverIdealWeight"]
            </h1>
            <p class="hero-subtitle">
                @Localizer["InnovativeSupplements"]
            </p>

            <!-- Trust Badges -->
            <div class="hero-trust-badges mb-2">
                <div class="trust-badge">
                    <i class="bi bi-shield-check"></i>
                    <span>@Localizer["AuthenticProducts"]</span>
                </div>
                <div class="trust-badge">
                    <i class="bi bi-truck"></i>
                    <span>@Localizer["FastDeliveryTitle"]</span>
                </div>
                <div class="trust-badge">
                    <i class="bi bi-award"></i>
                    <span>@Localizer["QualityGuaranteed"]</span>
                </div>
            </div>

            <div class="hero-search-box">
                <form asp-action="Index" method="get">
                    <div class="advanced-search-container">
                        <div class="search-input-wrapper">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" 
                                   name="searchTerm" 
                                   value="@searchTerm" 
                                   class="hero-search-input" 
                                   placeholder="@Localizer["SearchSupplements"]" />
                        </div>
                        <button type="submit" class="hero-search-btn magnetic-btn ripple">
                            <i class="bi bi-search me-2"></i>
                            @Localizer["Search"]
                        </button>
                    </div>
                </form>
            </div>

            <div class="hero-categories">
                <a href="@Url.Action("Index")" class="hero-category-badge @(!selectedCategory.HasValue ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap me-2"></i>@Localizer["AllBooks"]
                </a>
                @foreach (var category in categories.Take(5))
                {
                    <a href="@Url.Action("Index", new { categoryId = category.Id })" 
                       class="hero-category-badge @(selectedCategory == category.Id ? "active" : "")">
                        <i class="bi bi-tag me-2"></i>@category.Name
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<partial name="_Notifications" />
@Html.AntiForgeryToken()

@{
    var activeFlashSales = ViewBag.ActiveFlashSales as IEnumerable<FlashSale> ?? Enumerable.Empty<FlashSale>();
    var hasActiveFlashSales = activeFlashSales.Any();
}

@if (hasActiveFlashSales)
{
       <div class="flash-sale-section-header">
        <h3 class="flash-sale-section-title">
            <i class="bi bi-star-fill"></i>
            @Localizer["HotDealsRightNow"]
            <i class="bi bi-star-fill"></i>
        </h3>
    </div>
    <!-- FLASH SALE SECTION - COMPACT -->
    <section class="flash-sale-hero">
        <div class="container">
         
            <div class="flash-sale-hero-content">
                <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    <i class="bi bi-lightning-charge-fill lightning-icon"></i>
                    <h2 class="flash-sale-title" style="color:white;">@Localizer["FlashSale"]</h2>
                </div>
                <p class="flash-sale-subtitle">@Localizer["LimitedTimeOffers"]</p>

                @{
                    var nearestEndingSale = activeFlashSales.OrderBy(f => f.EndDate).FirstOrDefault();
                }

                @if (nearestEndingSale != null)
                {
                    <div id="mainFlashTimer" class="flash-sale-timer" data-flash-sale-end="@nearestEndingSale.EndDate.ToString("o")">
                        <!-- Timer will be populated by JavaScript -->
                    </div>
                }

                <div class="text-center mt-2">
                    <a href="@Url.Action("Index", "FlashSale", new { area = "Customer" })" class="view-all-flash-sales-btn">
                        @Localizer["ViewAllFlashSales"]
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
     
}

<!-- Services Section -->
@{
    var activeServices = ViewBag.ActiveServices as IEnumerable<BulkyBook.Models.ServiceSubscription> ?? Enumerable.Empty<BulkyBook.Models.ServiceSubscription>();
    var hasServices = activeServices.Any();
}

@if (hasServices)
{
    <section class="services-showcase-section">
        <div class="container">
            <div class="services-header">
                <div class="services-header-content">
                    <h2 class="services-title">
                        <i class="bi bi-briefcase-fill me-3"></i>
                        @Localizer["OurPremiumServices"]
                    </h2>
                    <p class="services-subtitle">@Localizer["DiscoverProfessionalServices"]</p>
                </div>
                <a asp-area="Customer" asp-controller="ServiceSubscription" asp-action="Index" class="view-all-services-btn">
                    @Localizer["ViewAllServices"]
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="services-grid">
                @foreach (var service in activeServices.Take(3))
                {
                    var activeOffers = _unitOfWork.ServiceOffers.GetAll(
                        o => o.ServiceSubscriptionId == service.Id && 
                             o.IsActive && 
                             o.StartDate <= DateTime.Now && 
                             o.EndDate >= DateTime.Now
                    ).ToList();
                    var hasOffer = activeOffers.Any();
                    var bestOffer = activeOffers.OrderByDescending(o => o.DiscountValue).FirstOrDefault();

                    <div class="service-card-home">
                        <div class="service-card-image-wrapper">
                            @{
                                var serviceImages = service.ServiceImages != null && service.ServiceImages.Any() 
                                    ? service.ServiceImages.OrderBy(si => si.DisplayOrder).Select(si => si.ImageUrl).ToList()
                                    : new List<string>();
                                
                                // If no ServiceImages but has ImageUrl, use that
                                if (!serviceImages.Any() && !string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    serviceImages.Add(service.ImageUrl);
                                }
                            }
                            
                            @if (serviceImages.Count > 1)
                            {
                                <div id="homeServiceCarousel_@service.Id" class="carousel slide service-home-carousel" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        @for (int i = 0; i < serviceImages.Count; i++)
                                        {
                                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                                <img src="@serviceImages[i]" class="service-card-image" alt="@service.Title - Image @(i+1)" />
                                            </div>
                                        }
                                    </div>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">@Localizer["Previous"]</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">@Localizer["Next"]</span>
                                    </button>
                                    <div class="carousel-indicators">
                                        @for (int i = 0; i < serviceImages.Count; i++)
                                        {
                                            <button type="button" data-bs-target="#homeServiceCarousel_@service.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                                        }
                                    </div>
                                </div>
                            }
                            else if (serviceImages.Count == 1)
                            {
                                <img src="@serviceImages[0]" class="service-card-image" alt="@service.Title" />
                            }
                            else
                            {
                                <div class="service-card-image-placeholder">
                                    <i class="bi bi-briefcase"></i>
                                </div>
                            }
                            @if (hasOffer && bestOffer != null)
                            {
                                <div class="service-offer-badge">
                                    @if (bestOffer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                    {
                                        <span>@bestOffer.DiscountValue% @Localizer["OFF"]</span>
                                    }
                                    else
                                    {
                                        <span>@Html.Raw(currencySymbol) @bestOffer.DiscountValue.ToString("N2") @Localizer["OFF"]</span>
                                    }
                                </div>
                            }
                            @if (service.ServiceType == BulkyBook.Models.ServiceType.Online)
                            {
                                <div class="service-type-badge-home online">
                                    <i class="bi bi-globe"></i> @Localizer["Online"]
                                </div>
                            }
                            else
                            {
                                <div class="service-type-badge-home offline">
                                    <i class="bi bi-building"></i> @Localizer["Offline"]
                                </div>
                            }
                        </div>
                        <div class="service-card-content">
                            <h3 class="service-card-title">@service.Title</h3>
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="service-card-description">
                                    @(service.Description.Length > 80 ? service.Description.Substring(0, 80) + "..." : service.Description)
                                </p>
                            }
                            <div class="service-card-pricing">
                                @if (hasOffer && bestOffer != null)
                                {
                                    decimal originalPrice = service.Price;
                                    decimal discount = 0;
                                    if (bestOffer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                    {
                                        discount = originalPrice * (bestOffer.DiscountValue / 100);
                                    }
                                    else
                                    {
                                        discount = bestOffer.DiscountValue;
                                    }
                                    decimal finalPrice = originalPrice - discount;
                                    
                                    <span class="service-price-original">@Html.Raw(currencySymbol) @originalPrice.ToString("N2")</span>
                                    <span class="service-price-final">@Html.Raw(currencySymbol) @finalPrice.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="service-price-final">@Html.Raw(currencySymbol) @service.Price.ToString("N2")</span>
                                }
                            </div>
                            @if (service.ServiceType == BulkyBook.Models.ServiceType.Offline && service.OfflinePaymentPercent.HasValue)
                            {
                                <div class="service-payment-info">
                                    <small>
                                        <i class="bi bi-info-circle"></i> 
                                        @Localizer["PayPercentNow", service.OfflinePaymentPercent.Value, currencySymbol + " " + (service.Price * service.OfflinePaymentPercent.Value / 100).ToString("N2")]
                                    </small>
                                </div>
                            }
                            <a asp-area="Customer" asp-controller="ServiceSubscription" asp-action="Details" asp-route-id="@service.Id" class="service-card-btn">
                                @Localizer["ViewDetails"]
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<div class="container-fluid px-3">
    <!-- Enhanced Filter Section -->
    <div class="filter-section enhanced-filters">
        <div class="filter-header">
            <div class="filter-header-left">
                <h2 class="filter-title">
                    <i class="bi bi-funnel-fill"></i>
                    @Localizer["FilterAndSort"]
                </h2>
            </div>
            <div class="filter-actions">
                @if (selectedCategory.HasValue || !string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(sortBy) || minPrice.HasValue || maxPrice.HasValue || !string.IsNullOrEmpty(availability))
                {
                    <a href="@Url.Action("Index")" class="clear-filters-btn">
                        <i class="bi bi-x-circle me-2"></i>
                        @Localizer["ClearFilters"]
                    </a>
                }
                <button type="button" class="filter-toggle-btn" id="filterToggleBtn" aria-label="Toggle filters">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
        </div>

        <form asp-action="Index" method="get" id="filterForm" class="filter-form">
            <input type="hidden" name="searchTerm" value="@searchTerm" />
            
            <div class="filter-groups" id="filterGroups">
                <!-- Category Filter -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-folder-fill"></i>
                        @Localizer["Category"]
                    </label>
                    <select name="categoryId" class="filter-select modern-select">
                        <option value="">@Localizer["AllCategories"]</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id" selected="@(selectedCategory == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Price Range Filter -->
                <div class="filter-group price-filter-group">
                    <label class="filter-label">
                        <i class="bi bi-currency-darham"></i>
                        @Localizer["PriceRange"]
                    </label>
                    <div class="price-range-container">
                        <div class="price-input-group">
                            <input type="number" name="minPrice" class="price-input" 
                                   placeholder="@Localizer["Min"]"
                                   value="@(minPrice?.ToString("F2") ?? "")" 
                                   min="0" step="0.01" />
                            <span class="price-separator">-</span>
                            <input type="number" name="maxPrice" class="price-input" 
                                   placeholder="@Localizer["Max"]"
                                   value="@(maxPrice?.ToString("F2") ?? "")" 
                                   min="0" step="0.01" />
                        </div>
                        <div class="price-range-slider">
                            <input type="range" id="priceRangeMin" class="range-input" 
                                   min="@minPriceRange" max="@maxPriceRange" 
                                   value="@(minPrice ?? minPriceRange)" step="1" />
                            <input type="range" id="priceRangeMax" class="range-input" 
                                   min="@minPriceRange" max="@maxPriceRange" 
                                   value="@(maxPrice ?? maxPriceRange)" step="1" />
                        </div>
                        <div class="price-display">
                            <span id="priceMinDisplay">@Html.Raw(currencySymbol) @(minPrice?.ToString("N2") ?? minPriceRange.ToString("N2"))</span>
                            <span> - </span>
                            <span id="priceMaxDisplay">@Html.Raw(currencySymbol) @(maxPrice?.ToString("N2") ?? maxPriceRange.ToString("N2"))</span>
                        </div>
                    </div>
                </div>

                <!-- Availability Filter -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-check-circle-fill"></i>
                        @Localizer["Availability"]
                    </label>
                    <select name="availability" class="filter-select modern-select">
                        <option value="">@Localizer["All"]</option>
                        <option value="instock" selected="@(availability == "instock")">@Localizer["InStock"]</option>
                        <option value="outofstock" selected="@(availability == "outofstock")">@Localizer["OutOfStock"]</option>
                    </select>
                </div>

                <!-- Sort By Filter -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-sort-down-alt"></i>
                        @Localizer["SortBy"]
                    </label>
                    <select name="sortBy" class="filter-select modern-select">
                        <option value="" selected="@(string.IsNullOrEmpty(sortBy))">@Localizer["Default"]</option>
                        <option value="name" selected="@(sortBy == "name")">@Localizer["NameAZ"]</option>
                        <option value="price_low" selected="@(sortBy == "price_low")">@Localizer["PriceLowToHigh"]</option>
                        <option value="price_high" selected="@(sortBy == "price_high")">@Localizer["PriceHighToLow"]</option>
                        <option value="newest" selected="@(sortBy == "newest")">@Localizer["Newest"]</option>
                        <option value="oldest" selected="@(sortBy == "oldest")">@Localizer["Oldest"]</option>
                    </select>
                </div>

                <!-- Apply Filters Button -->
                <div class="filter-group filter-actions-group">
                    <button type="submit" class="apply-filters-btn">
                        <i class="bi bi-check-lg me-2"></i>
                        @Localizer["ApplyFilters"]
                    </button>
                </div>
            </div>
        </form>
    </div>

    
    <!-- Product Grid - Modern Design -->
    <div class="products-grid-container" id="productContainer">
@foreach (var Product in Model)
{
    var discount = Product.ListPrice > 0 ? (int)((Product.ListPrice - Product.Price) / Product.ListPrice * 100) : 0;
    var cartProductIds = ViewBag.CartProductIds as List<int> ?? new List<int>();
    var isInCart = cartProductIds.Contains(Product.Id);
    var wishlistProductIds = ViewBag.WishlistProductIds as List<int> ?? new List<int>();
    var isInWishlist = wishlistProductIds.Contains(Product.Id);
    var isAuthenticated = User.Identity.IsAuthenticated;
    
    <div class="product-card stagger-item" 
         data-stock-quantity="@Product.StockQuantity" 
         data-minimum-stock="@Product.MinimumStockAlert"
         data-product-id="@Product.Id">
        <!-- Product Image Carousel -->
        <div class="product-image-wrapper">
            @if (isAuthenticated)
            {
                <!-- Wishlist Button (Only for logged-in users) -->
                <button class="wishlist-btn @(isInWishlist ? "active" : "")" 
                        data-product-id="@Product.Id" 
                        onclick="toggleWishlist(@Product.Id, this); event.stopPropagation();"
                        title="@(isInWishlist ? "Remove from wishlist" : "Add to wishlist")">
                    <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            }
            @{
                var productImages = Product.ProductImages != null && Product.ProductImages.Any() 
                    ? Product.ProductImages.OrderBy(pi => pi.DisplayOrder).Select(pi => pi.ImageUrl).ToList()
                    : new List<string>();
                
                // If no ProductImages but has ImageUrl, use that
                if (!productImages.Any() && !string.IsNullOrEmpty(Product.ImageUrl))
                {
                    productImages.Add(Product.ImageUrl);
                }
            }
            
            @if (productImages.Count > 1)
            {
                <div id="productCarousel_@Product.Id" class="carousel slide product-image-carousel" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < productImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@productImages[i]" class="product-image" alt="@Product.Title - Image @(i+1)" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Previous"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Next"]</span>
                    </button>
                    <div class="carousel-indicators">
                        @for (int i = 0; i < productImages.Count; i++)
                        {
                            <button type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)"></button>
                        }
                    </div>
                </div>
            }
            else if (productImages.Count == 1)
            {
                <img src="@productImages[0]" class="product-image" alt="@Product.Title" />
            }
            else
            {
            <img src="@Product.ImageUrl" class="product-image" alt="@Product.Title" />
            }
            
            <!-- Badges -->
            <div class="product-badges">
                @if (discount > 0)
                {
                    <span class="product-badge badge-discount">-@discount%</span>
                }
            </div>
        </div>
        
        <!-- Product Info -->
        <div class="product-content">
            <div class="product-category">@Product.categry.Name</div>
            <h3 class="product-title">@Product.Title</h3>
            
            <!-- Star Rating -->
            <div class="product-card-rating" data-product-id="@Product.Id">
                <div class="product-card-stars">
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                </div>
                <span class="product-card-rating-text">(0)</span>
            </div>
            
            <!-- Price -->
            <div class="price-section">
                <div class="price-wrapper">
                    <span class="current-price">@Html.Raw(currencySymbol) @Product.Price.ToString("N2")</span>
                    @if (discount > 0)
                    {
                        <span class="list-price">@Html.Raw(currencySymbol) @Product.ListPrice.ToString("N2")</span>
                        <span class="discount-percent">@discount% @Localizer["OFF"]</span>
                    }
                </div>
            </div>
            
            <!-- Actions - View Details + Add to Cart / Select Options -->
            <div class="product-actions">
                <a asp-action="Details" asp-route-productId="@Product.Id" class="btn-view-details">
                    <i class="bi bi-eye"></i>
                    @Localizer["ViewDetails"]
                </a>
                @if (Product.ProductType == BulkyBook.Models.ProductType.Variable)
                {
                    <a asp-action="Details" asp-route-productId="@Product.Id" class="btn-select-options">
                        <i class="bi bi-list-check"></i>
                        @Localizer["SelectOptions"]
                    </a>
                }
                else
                {
                    <button class="btn-add-cart-quick @(isInCart ? "in-cart" : "")" 
                            data-product-id="@Product.Id"
                            onclick="toggleCart(@Product.Id, this)" 
                            title="@(isInCart ? "In Cart" : "Add to Cart")">
                        <i class="bi @(isInCart ? "bi-check-lg" : "bi-cart-plus")"></i>
                    </button>
                }
            </div>
        </div>
    </div>
}
    </div>
</div>

<!-- Load More Button -->
<div class="text-center my-5" id="loadMoreContainer" style="display: none;">
    <button id="loadMoreBtn" class="btn btn-lg" onclick="loadMoreProducts()" style="background: linear-gradient(135deg, #3B9DD5, #7BC043); color: white; border: none; padding: 0.75rem 2.5rem; border-radius: 50px; font-weight: 700; transition: all 0.3s ease;">
        <i class="bi bi-arrow-down-circle me-2"></i>
        @Localizer["LoadMoreProducts"]
    </button>
    <div id="loadingIndicator" class="text-center mt-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">@Localizer["Loading"]</span>
    </div>
        <p class="mt-2 text-muted">
            @Localizer["LoadingMoreProducts"]
        </p>
    </div>
</div>

<!-- Features Section -->
<section class="features-section scroll-reveal">
    <div class="container">
        <h2 class="features-title">@Localizer["WhyChooseIdealWeight"]</h2>
        <div class="features-grid">
            <div class="feature-card glass-card tilt-3d scroll-reveal">
                <div class="feature-icon">
                    <i class="bi bi-award"></i>
                </div>
                <h3 class="feature-title">@Localizer["PremiumQualityTitle"]</h3>
                <p class="feature-description">
                    @Localizer["PremiumQualityDesc"]
                </p>
            </div>

            <div class="feature-card glass-card tilt-3d scroll-reveal">
                <div class="feature-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h3 class="feature-title">@Localizer["ExpertGuidanceTitle"]</h3>
                <p class="feature-description">
                    @Localizer["ExpertGuidanceDesc"]
                </p>
            </div>

            <div class="feature-card glass-card tilt-3d scroll-reveal">
                <div class="feature-icon">
