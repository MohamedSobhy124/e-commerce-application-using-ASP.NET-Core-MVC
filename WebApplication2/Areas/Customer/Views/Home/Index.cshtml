</div>

<div class="container">
    <!-- Enhanced Filter Section (Hidden - will be moved to side panel/bottom sheet) -->
    <div class="filter-section enhanced-filters" id="originalFilterSection" style="display: none;">
        <div class="filter-header">
            <div class="filter-header-left">
                <h2 class="filter-title">
                    <i class="bi bi-funnel-fill"></i>
                    @Localizer["FilterAndSort"]
                </h2>
            </div>
            <div class="filter-actions">
                @if (selectedCategory.HasValue || !string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(sortBy) || minPrice.HasValue || maxPrice.HasValue || !string.IsNullOrEmpty(availability))
                {
                    <a href="@Url.Action("Index")" class="clear-filters-btn">
                        <i class="bi bi-x-circle me-2"></i>
                        @Localizer["ClearFilters"]
                    </a>
                }
                <button type="button" class="filter-toggle-btn" id="filterToggleBtn" aria-label="Toggle filters">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
        </div>

        <form id="filterForm" class="filter-form" onsubmit="return false;">
            <input type="hidden" name="searchTerm" value="@searchTerm" />
            
            <div class="filter-groups" id="filterGroups">
                <!-- Category Filter -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-folder-fill"></i>
                        @Localizer["Category"]
                    </label>
                    <select name="categoryId" class="filter-select modern-select">
                        <option value="">@Localizer["AllCategories"]</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id" selected="@(selectedCategory == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Price Range Filter -->
                <div class="filter-group price-filter-group">
                    <label class="filter-label">
                        <i class="bi bi-currency-darham"></i>
                        @Localizer["PriceRange"]
                    </label>
                    <div class="price-range-container">
                        <div class="price-input-group">
                            <input type="number" name="minPrice" class="price-input" 
                                   placeholder="@Localizer["Min"]"
                                   value="@(minPrice?.ToString("F2") ?? "")" 
                                   min="0" step="0.01" />
                            <span class="price-separator">-</span>
                            <input type="number" name="maxPrice" class="price-input" 
                                   placeholder="@Localizer["Max"]"
                                   value="@(maxPrice?.ToString("F2") ?? "")" 
                                   min="0" step="0.01" />
                        </div>
                        <div class="price-range-slider">
                            <input type="range" id="priceRangeMin" class="range-input" 
                                   min="@minPriceRange" max="@maxPriceRange" 
                                   value="@(minPrice?.ToString("F0") ?? minPriceRange.ToString("F0"))" step="1" />
                            <input type="range" id="priceRangeMax" class="range-input" 
                                   min="@minPriceRange" max="@maxPriceRange" 
                                   value="@(maxPrice?.ToString("F0") ?? maxPriceRange.ToString("F0"))" step="1" />
                        </div>
                        <div class="price-display">
                            <span id="priceMinDisplay">@Html.Raw(currencySymbol) @(minPrice?.ToString("N2") ?? minPriceRange.ToString("N2"))</span>
                            <span> - </span>
                            <span id="priceMaxDisplay">@Html.Raw(currencySymbol) @(maxPrice?.ToString("N2") ?? maxPriceRange.ToString("N2"))</span>
                        </div>
                    </div>
                </div>

                <!-- Availability Filter -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-check-circle-fill"></i>
                        @Localizer["Availability"]
                    </label>
                    <select name="availability" class="filter-select modern-select">
                        <option value="">@Localizer["All"]</option>
                        <option value="instock" selected="@(availability == "instock")">@Localizer["InStock"]</option>
                        <option value="outofstock" selected="@(availability == "outofstock")">@Localizer["OutOfStock"]</option>
                    </select>
                </div>

                <!-- Sort By Filter -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="bi bi-sort-down-alt"></i>
                        @Localizer["SortBy"]
                    </label>
                    <select name="sortBy" class="filter-select modern-select">
                        <option value="" selected="@(string.IsNullOrEmpty(sortBy))">@Localizer["Default"]</option>
                        <option value="name" selected="@(sortBy == "name")">@Localizer["NameAZ"]</option>
                        <option value="price_low" selected="@(sortBy == "price_low")">@Localizer["PriceLowToHigh"]</option>
                        <option value="price_high" selected="@(sortBy == "price_high")">@Localizer["PriceHighToLow"]</option>
                        <option value="newest" selected="@(sortBy == "newest")">@Localizer["Newest"]</option>
                        <option value="oldest" selected="@(sortBy == "oldest")">@Localizer["Oldest"]</option>
                    </select>
                </div>

                <!-- Apply Filters Button - Hidden, using modern filter panels instead -->
                <div class="filter-group filter-actions-group" style="display: none;">
                    <button type="button" class="apply-filters-btn" style="display: none;">
                        <i class="bi bi-check-lg me-2"></i>
                        @Localizer["ApplyFilters"]
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Category Carousel -->
    @{
        var categoryProductsMap = ViewBag.CategoryProductsMap as Dictionary<int, List<Product>> ?? new Dictionary<int, List<Product>>();
        var displayCategories = categories.ToList();
    }
    @if (displayCategories.Any())
    {
        <section class="category-section">
            <div class="category-section-title">
                <h2>@Localizer["ShopByCategory"]</h2>
            </div>
            <div class="category-carousel-container" id="categoryCarouselContainer">
                <div id="categoryCarousel" class="carousel slide category-carousel" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover">
                    <div class="carousel-inner">
                        @{
                            var categoriesList = displayCategories.ToList();
                            
                            // Responsive items per slide: mobile=1, tablet=2, desktop=4
                            var itemsPerSlideMobile = 1;
                            var itemsPerSlideTablet = 2;
                            var itemsPerSlideDesktop = 4;
                            
                            // Calculate total slides for desktop (most slides) - add 1 for "All Categories"
                            var totalSlidesDesktop = (int)Math.Ceiling((categoriesList.Count + 1) / (double)itemsPerSlideDesktop);
                            
                            // First, render "All Categories" in the first slide
                            var firstSlideHasAllCategories = true;
                            var categoriesToShow = categoriesList.ToList();
                            
                            for (int slideIndex = 0; slideIndex < totalSlidesDesktop; slideIndex++)
                            {
                                var slideCategories = new List<BulkyBook.Models.Categry>();
                                
                                // First slide: add "All Categories" first, then regular categories
                                if (slideIndex == 0)
                                {
                                    // Add remaining categories for first slide (skip 1 slot for "All Categories")
                                    var remainingSlots = itemsPerSlideDesktop - 1;
                                    slideCategories = categoriesToShow.Take(remainingSlots).ToList();
                                }
                                else
                                {
                                    // For other slides, skip the "All Categories" slot
                                    var skipCount = (slideIndex * itemsPerSlideDesktop) - 1;
                                    slideCategories = categoriesToShow.Skip(skipCount).Take(itemsPerSlideDesktop).ToList();
                                }
                                
                                <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                                    <div class="row g-3 g-md-4">
                                        @if (slideIndex == 0)
                                        {
                                            // Render "All Categories" as first item in first slide
                                            <div class="col-12 col-sm-6 col-lg-3">
                                                <div class="category-card @(selectedCategory == null ? "active" : "")"
                                                     data-category-id="0"
                                                     data-all-categories="true"
                                                     role="button"
                                                     tabindex="0"
                                                     style="cursor: pointer;">
                                                    <div class="category-circle">
                                                        <div class="category-image-wrapper">
                                                            <i class="bi bi-grid-3x3-gap-fill" style="font-size: 2.5rem; color: #667eea;"></i>
                                                        </div>
                                                    </div>
                                                    <div class="category-label">@Localizer["AllCategories"]</div>
                                                </div>
                                            </div>
                                        }
                                        
                                        @foreach (var category in slideCategories)
                                        {
                                            if (category == null) continue;
                                            
                                            var categoryIndex = categoriesList.IndexOf(category);
                                            var categoryProducts = categoryProductsMap.ContainsKey(category.Id) 
                                                ? categoryProductsMap[category.Id] 
                                                : new List<Product>();
                                            var categoryName = currentCulture == "ar" && !string.IsNullOrEmpty(category.NameAr) 
                                                ? category.NameAr 
                                                : category.Name;
                                            
                                            <div class="col-12 col-sm-6 col-lg-3">
                                                <div class="category-card @(selectedCategory == category.Id ? "active" : "")"
                                                     data-category-index="@categoryIndex"
                                                     data-category-id="@category.Id"
                                                     role="button"
                                                     tabindex="0"
                                                     style="cursor: pointer;">
                                                    <div class="category-circle">
                                                        @if (!string.IsNullOrEmpty(category.ImageUrl))
                                                        {
                                                            <div class="category-image-wrapper">
                                                                <img src="@category.ImageUrl" alt="@categoryName" class="category-image" />
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                                // Try to get products from the map first
                                                                var productsToShow = categoryProducts.ToList();
                                                                
                                                                // If no products in map, try to get from all products if available
                                                                if (!productsToShow.Any() && Model != null)
                                                                {
                                                                    productsToShow = Model
                                                                        .Where(p => p.CategryId == category.Id)
                                                                        .Take(4)
                                                                        .ToList();
                                                                }
                                                                
                                                                // Limit to 4 products max for display
                                                                productsToShow = productsToShow.Take(4).ToList();
                                                            
                                                            @if (productsToShow.Any())
                                                            {
                                                                <div class="category-products-grid">
                                                                    @foreach (var product in productsToShow)
                                                                    {
                                                                        // Get product image - check ProductImages first, then ImageUrl
                                                                        var productImage = product.ProductImages?.FirstOrDefault(pi => pi.ImageInfo == null)?.ImageUrl 
                                                                            ?? product.ProductImages?.FirstOrDefault()?.ImageUrl 
                                                                            ?? product.ImageUrl;
                                                                        
                                                                        if (!string.IsNullOrEmpty(productImage))
                                                                        {
                                                                            <img src="@productImage" alt="@(currentCulture == "ar" && !string.IsNullOrEmpty(product.TitleAr) ? product.TitleAr : product.Title)" class="category-product-mini" />
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                // Fallback icon if no products available
                                                                <div class="category-image-wrapper">
                                                                    <i class="bi bi-box-seam" style="font-size: 2.5rem; color: #667eea;"></i>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                    <div class="category-label">@categoryName</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    
                    <!-- Carousel Controls -->
                    <button class="carousel-control-prev category-carousel-control carousel-nav prev" type="button" data-bs-target="#categoryCarousel" data-bs-slide="prev">
                        <i class="bi bi-chevron-left"></i>
                        <span class="visually-hidden">@Localizer["Previous"]</span>
                    </button>
                    <button class="carousel-control-next category-carousel-control carousel-nav next" type="button" data-bs-target="#categoryCarousel" data-bs-slide="next">
                        <i class="bi bi-chevron-right"></i>
                        <span class="visually-hidden">@Localizer["Next"]</span>
                    </button>
                    
                    <!-- Carousel Indicators -->
                    @if (totalSlidesDesktop > 1)
                    {
                        <div class="carousel-indicators category-carousel-indicators">
                            @for (int i = 0; i < totalSlidesDesktop; i++)
                            {
                                <button type="button" data-bs-target="#categoryCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    <!-- Product Grid - Modern Design -->
    <div class="modern-products-container" id="productsSection">
        <div class="modern-products-grid" id="productContainer">
@foreach (var Product in Model)
{
    var discount = Product.ListPrice > 0 ? (int)((Product.ListPrice - Product.Price) / Product.ListPrice * 100) : 0;
    var cartProductIds = ViewBag.CartProductIds as List<int> ?? new List<int>();
    var isInCart = cartProductIds.Contains(Product.Id);
    var wishlistProductIds = ViewBag.WishlistProductIds as List<int> ?? new List<int>();
    var isInWishlist = wishlistProductIds.Contains(Product.Id);
    var isAuthenticated = User.Identity.IsAuthenticated;
    
    <div class="product-card stagger-item visible" 
         data-stock-quantity="@Product.StockQuantity" 
         data-minimum-stock="@Product.MinimumStockAlert"
         data-product-id="@Product.Id"
         onclick="window.location.href='@Url.Action("Details", "Home", new { productId = Product.Id })'"
         style="cursor: pointer;">
        <!-- Product Image Carousel -->
        <div class="product-image-wrapper">
            @if (isAuthenticated)
            {
                <!-- Wishlist Button (Only for logged-in users) -->
                <button class="wishlist-btn @(isInWishlist ? "active" : "")" 
                        data-product-id="@Product.Id" 
                        onclick="toggleWishlist(@Product.Id, this); event.stopPropagation();"
                        title="@(isInWishlist ? "Remove from wishlist" : "Add to wishlist")">
                    <i class="bi @(isInWishlist ? "bi-heart-fill" : "bi-heart")"></i>
                </button>
            }
            @{
                var productImages = Product.ProductImages != null && Product.ProductImages.Any() 
                    ? Product.ProductImages.OrderBy(pi => pi.DisplayOrder).Select(pi => pi.ImageUrl).ToList()
                    : new List<string>();
                
                // If no ProductImages but has ImageUrl, use that
                if (!productImages.Any() && !string.IsNullOrEmpty(Product.ImageUrl))
                {
                    productImages.Add(Product.ImageUrl);
                }
            }
            
            @if (productImages.Count > 1)
            {
                <div id="productCarousel_@Product.Id" class="carousel slide product-image-carousel" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < productImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@productImages[i]" class="product-image" alt="@Product.Title - Image @(i+1)" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Previous"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Next"]</span>
                    </button>
                    <div class="carousel-indicators">
                        @for (int i = 0; i < productImages.Count; i++)
                        {
                            <button type="button" data-bs-target="#productCarousel_@Product.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)"></button>
                        }
                    </div>
                </div>
            }
            else if (productImages.Count == 1)
            {
                <img src="@productImages[0]" class="product-image" alt="@Product.Title" />
            }
            else
            {
            <img src="@Product.ImageUrl" class="product-image" alt="@(currentCulture == "ar" && !string.IsNullOrEmpty(Product.TitleAr) ? Product.TitleAr : Product.Title)" />
            }
        </div>
        
        <!-- Product Info -->
        <div class="product-content">
            <h3 class="product-title">@(currentCulture == "ar" && !string.IsNullOrEmpty(Product.TitleAr) ? Product.TitleAr : Product.Title)</h3>
            
            <!-- Star Rating with Discount -->
            <div class="product-card-rating" data-product-id="@Product.Id">
                <div class="product-card-stars">
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                    <i class="bi bi-star"></i>
                </div>
                <span class="product-card-rating-text">(0)</span>
                @if (discount > 0)
                {
                    <span class="discount-badge-rating">@discount% @(currentCulture == "ar" ? "خصم" : "OFF")</span>
                }
            </div>
            
            <!-- Price and Actions - Same Line -->
            <div class="price-actions-row" onclick="event.stopPropagation();">
                @{
                    var minPrices = ViewBag.MinPrices as Dictionary<int, double> ?? new Dictionary<int, double>();
                    var showPriceFlags = ViewBag.ShowPriceFlags as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                    var allVariantsOutOfStockFlags = ViewBag.AllVariantsOutOfStockFlags as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                    var shouldShowPrice = showPriceFlags.ContainsKey(Product.Id) ? showPriceFlags[Product.Id] : (Product.StockQuantity > 0);
                    var allVariantsOutOfStock = allVariantsOutOfStockFlags.ContainsKey(Product.Id) && allVariantsOutOfStockFlags[Product.Id];
                    var hasVariants = Product.ProductType == BulkyBook.Models.ProductType.Variable && minPrices.ContainsKey(Product.Id);
                    var displayPrice = hasVariants ? minPrices[Product.Id] : Product.Price;
                    var pricePrefix = hasVariants ? (currentCulture == "ar" ? "من " : "From ") : "";
                }
                @if (shouldShowPrice)
                {
                    <div class="price-wrapper">
                        <span class="current-price">
                            @if (hasVariants)
                            {
                                <span class="price-from-text">@pricePrefix</span>
                            }
                            @Html.Raw(currencySymbol) @displayPrice.ToString("N2")
                        </span>
                    </div>
                }
                else if (allVariantsOutOfStock)
                {
                    <div class="price-wrapper">
                        <span class="text-muted" style="font-size: 0.9rem;">
                            @Localizer["OutOfStock"]
                        </span>
                    </div>
                }
                <div class="product-actions">
                    @if (Product.ProductType == BulkyBook.Models.ProductType.Variable)
                    {
                        <a asp-action="Details" asp-route-productId="@Product.Id" class="btn-select-options">
                            <i class="bi bi-list-check"></i>
                            @Localizer["SelectOptions"]
                        </a>
                    }
                    else
                    {
                        <button class="btn-add-cart-quick @(isInCart ? "in-cart" : "")" 
                                data-product-id="@Product.Id"
                                onclick="toggleCart(@Product.Id, this); event.stopPropagation();" 
                                title="@(isInCart ? "In Cart" : "Add to Cart")">
                            <i class="bi @(isInCart ? "bi-check-lg" : "bi-cart-plus")"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
    </div>
