@using Microsoft.Extensions.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["ShippingInfo"];
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.Name;
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="page-header text-center mb-5">
                <h1 class="display-4" style="color: #1976D2; font-weight: 800;">
                    <i class="bi bi-truck me-3"></i>
                    @if(currentLang == "ar") {
                        <text>الشحن والتسليم</text>
                    } else {
                        <text>Shipping & Delivery</text>
                    }
                </h1>
                <div class="underline" style="width: 100px; height: 4px; background: linear-gradient(90deg, #3B9DD5, #7BC043); margin: 1rem auto;"></div>
            </div>

            @if(currentLang == "ar") 
            {
                <!-- Arabic Content -->
                <div class="content-section" style="direction: rtl; text-align: right;">
                    <!-- Introduction -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #3B9DD5; font-weight: 700;">
                                <i class="bi bi-info-circle me-3"></i>معلومات الشحن
                            </h2>
                            <p class="lead" style="line-height: 1.8; color: #555;">
                                Ideal Weight تفهم أنه من المهم بالنسبة لك الحصول على العناصر في الوقت المحدد، لذلك نبذل قصارى جهدنا لمعالجة طلبك في أسرع وقت ممكن، 
                                وتزويد عملائنا بأقل أسعار الشحن المتاحة. للأوزان الأثقل أو أحجام العبوات الكبيرة، يرجى الاتصال بنا حيث قد تنطبق رسوم إضافية.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                <strong>ملاحظة:</strong> في الحالات التي تتطلب فيها منتجات الطلب الشحن في أكثر من صندوق واحد، سيتم التنسيق داخليًا دون تأكيد مسبق مع العميل.
                            </p>
                        </div>
                    </div>

                    <!-- Delivery Time -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-clock me-3"></i>مدة التسليم
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                تختلف مدة التسليم من شركة إلى أخرى وتختلف أيضًا حسب المنطقة/المدينة/الدولة. 
                                سيتم الإشارة إلى فترة الشحن والتسليم من قبل كل شركة أثناء تقديم الطلب. 
                                لاحظ أن الفترة قد تتأثر وفقًا للمناسبات الخاصة والعطلات وقد يتم تعديلها على الموقع دون إشعار مسبق.
                            </p>
                        </div>
                    </div>

                    <!-- Customs and International Shipping -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #1976D2; font-weight: 700;">
                                <i class="bi bi-globe me-3"></i>الشحن الدولي والجمارك
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                المستلم مسؤول عن أي رسوم تخليص جمركي محتملة يتم تكبدها عند الشحن عبر الحدود. 
                                بالإضافة إلى ذلك، من المهم ملاحظة أن السلطات المحلية قد تفحص وتتحقق من محتويات الشحنة لضمان سلامة المنتج ورفاهية العميل. 
                                هذه الإجراءات موجودة لصالح وضمان صحة العميل.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                أي رسوم قانونية وجمركية مرتبطة خارج الإمارات العربية المتحدة يتحملها المستلم. 
                                قد تتطلب الشحنات الدولية توفير وثائق تعريف مثل بطاقات الهوية أو جوازات السفر أو أشكال أخرى من إثبات الهوية للسلطات المحلية لأغراض المعالجة والتحقق.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                إذا تم رفض الشحنة من قبل الجمارك، فإن المسؤولية تقع على عاتق المستلم.
                            </p>
                        </div>
                    </div>

                    <!-- Business Days -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #3B9DD5; font-weight: 700;">
                                <i class="bi bi-calendar me-3"></i>أيام العمل
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                جميع الأيام المشار إليها هي أيام عمل (الأحد - الخميس). مع العلم أن الجمعة والسبت ليستا أيام عمل. 
                                أي طلبات يتم تقديمها بعد الساعة 10 صباحًا، سيتم معالجتها في يوم العمل التالي.
                            </p>
                        </div>
                    </div>

                    <!-- Delivery Details -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-geo-alt me-3"></i>التسليم
                            </h2>
                            <ul style="line-height: 2; color: #555;">
                                <li><strong>خارج حدود المدينة:</strong> قد نرتب لتسليم الطلب إلى أقرب فرع في مدينته ويجب على العميل استلام الطلب خلال 3 أيام عمل ما لم يتم إرجاع الطلب. خلاف ذلك، يمكن للعميل ترتيب عملية التسليم مع شركة الشحن من طرف ثالث ويمكننا التعاون للتعامل مع الشحنة في موقعهم (داخل حدود المدينة).</li>
                                <li><strong>المنطقة الغربية للإمارات:</strong> ستستغرق عمليات التسليم إلى المنطقة الغربية للإمارات وقتًا أطول مما هو مذكور على الموقع، وستكون ضمن حدود فرعنا.</li>
                                <li><strong>المناطق النائية:</strong> إذا كان موقع تسليم الطلب في منطقة نائية، فقد نرتب تسليم الطلب من خلال طرف ثالث وقد يطلب شركة الشحن تكلفة إضافية.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- ID Requirement -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #1976D2; font-weight: 700;">
                                <i class="bi bi-person-badge me-3"></i>متطلبات الهوية عند التسليم
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                قد تطلب Ideal Weight منك تزويدنا بنسخة/صورة من هويتك الصالحة للتحقق من هويتك لضمان تسليم منتجاتك للمستلم الصحيح، أثناء عملية التسليم. 
                                إذا لم نتمكن من التحقق من أو المصادقة على أي معلومات تقدمها، يحق لنا رفض التسليم وإلغاء الطلب.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                لمزيد من المعلومات يرجى الاتصال بفريق خدمة العملاء لدينا <a asp-area="Customer" asp-controller="Home" asp-action="AboutUs" style="color: #7BC043; font-weight: 600;">من هنا</a>.
                            </p>
                        </div>
                    </div>

                    <!-- Free Shipping -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-gift me-3"></i>الشحن/التسليم المجاني
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                قد يتم تنفيذ عرض شحن مجاني محدود الوقت عبر جميع المنتجات على الموقع، وفقًا لاستثناءاتنا القياسية. 
                                سيتم عرض المنتجات المستثناة بدون تسمية "تسليم مجاني". بالإضافة إلى المنتجات المستثناة من التسليم المجاني، 
                                سيتم أيضًا عرض منتجات التصفية بدون تسمية.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                في حالة إضافة عناصر مستثناة من التسليم المجاني إلى عربة التسوق مع عناصر التسليم المجاني، 
                                سيتم حساب رسوم الشحن مباشرة وعرضها أثناء عملية الدفع.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                نحتفظ بالحق في تحديد أو منع عروض الشحن/التسليم المجاني على أي طلبات، وفقًا لتقديرنا الخاص، 
                                التي يبدو أنها تم تقديمها من قبل التجار أو الموزعين أو الموزعين.
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- English Content -->
                <div class="content-section">
                    <!-- Introduction -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #3B9DD5; font-weight: 700;">
                                <i class="bi bi-info-circle me-3"></i>Shipping Information
                            </h2>
                            <p class="lead" style="line-height: 1.8; color: #555;">
                                Ideal Weight understands that it is important to you to get your items on time, so we do our best to process your order as quickly as possible, 
                                and provide our customers with the lowest shipping rates available. For heavier weights or large package sizes, please contact us as additional fees may apply.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                <strong>Note:</strong> In cases where products in an order require shipping in more than one box, coordination will be done internally without prior confirmation with the customer.
                            </p>
                        </div>
                    </div>

                    <!-- Delivery Time -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-clock me-3"></i>Delivery Time
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                The delivery time varies from one company to another and also varies according to the region/city/country. 
                                The shipping and delivery period will be indicated by each company during the order placement. 
                                Note that the period may be affected according to special occasions and holidays and may be modified on the site without prior notice.
                            </p>
                        </div>
                    </div>

                    <!-- Customs and International Shipping -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #1976D2; font-weight: 700;">
                                <i class="bi bi-globe me-3"></i>International Shipping & Customs
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                The consignee is responsible for any potential customs clearance fees incurred when shipping across borders. 
                                Additionally, it is important to note that local authorities may inspect and verify the contents of the shipment to ensure product safety and customer well-being. 
                                These measures are in place for the benefit and health assurance of the customer.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                Any associated legal and customs fees outside the UAE are to be borne by the consignee. 
                                International shipments may require the provision of identification documents, such as ID cards, passports, or other forms of proof of identity, to local authorities for processing and verification purposes.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                If the shipment is rejected by customs, it is the responsibility of the consignee.
                            </p>
                        </div>
                    </div>

                    <!-- Business Days -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #3B9DD5; font-weight: 700;">
                                <i class="bi bi-calendar me-3"></i>Business Days
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                All days referenced are working days (Sunday - Thursday). Knowing that Friday and Saturday are not business days. 
                                Any orders placed after 10 AM, will be processed on the next business day.
                            </p>
                        </div>
                    </div>

                    <!-- Delivery Details -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-geo-alt me-3"></i>Delivery
                            </h2>
                            <ul style="line-height: 2; color: #555;">
                                <li><strong>Outside the city limits:</strong> We may arrange for the order to be delivered to the nearest branch in his city and the customer must pick up the order within 3 business days unless the order will be returned. Otherwise, The customer can arrange the delivery process with 3rd party courier and we can cooperate to handle the shipment at their location (within city limits).</li>
                                <li><strong>UAE western area:</strong> Deliveries to the UAE western area will take longer than mentioned on the website, and it will be within our branch's limits.</li>
                                <li><strong>Remote areas:</strong> If the order delivery location is in a remote area we may arrange the order to be delivered through 3rd party and the shipping courier may request for an extra cost.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- ID Requirement -->
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #1976D2; font-weight: 700;">
                                <i class="bi bi-person-badge me-3"></i>ID Requirement at Delivery
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                Ideal Weight may request you provide us a copy/picture of your valid ID to verify your identity to ensure that your products are handled to the right receiver, during the delivery process. 
                                If we are unable to verify or authenticate any information you provide, we have the right to refuse delivery and cancel the order.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                For more information please contact our customer service team <a asp-area="Customer" asp-controller="Home" asp-action="AboutUs" style="color: #7BC043; font-weight: 600;">from Here</a>.
                            </p>
                        </div>
                    </div>

                    <!-- Free Shipping -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="mb-4" style="color: #7BC043; font-weight: 700;">
                                <i class="bi bi-gift me-3"></i>Free Shipping/Delivery
                            </h2>
                            <p style="line-height: 1.8; color: #555;">
                                A limited-time free shipping offer may be implemented across all products on the website, subject to our standard exclusions. 
                                Excluded products will be shown without a Free Delivery label. As well as products that are excluded from Free Delivery, clearance products will also be shown without a label.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                In the event that free delivery excluded items are added to the cart with free delivery items, the shipping fees will be calculated directly and displayed during the checkout process.
                            </p>
                            <p style="line-height: 1.8; color: #555;">
                                We reserve the right to limit or prohibit free shipping/delivery offers on any orders, in our sole judgment, appear to be placed by dealers, resellers, or distributors.
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
