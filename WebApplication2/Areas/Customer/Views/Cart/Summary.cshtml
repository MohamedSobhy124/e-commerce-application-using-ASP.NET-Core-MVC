@model ShoppingCartVM

<form method="post">
	<div class="order-summary-wrapper">
		<div class="container">
			<div class="order-summary-card">

				<div class="order-summary-header">
					<h5 class="order-summary-title">
						<i class="bi bi-file-earmark-text me-2"></i>
						@Localizer["OrderSummary"]
					</h5>
					<a asp-action="Index" class="back-to-cart-btn">
						<i class="bi bi-arrow-left me-2"></i>
						@Localizer["BackToCart"]
					</a>
				</div>

				<div class="order-summary-body">
					<div class="row">
						<div class="col-12 col-lg-6 pb-4">
							<div class="shipping-details-section">
								<h4>
									<i class="bi bi-truck me-2"></i>
									@Localizer["ShippingDetails"]
								</h4>
								
								@if (Model.OrderHeader.IsGuestOrder || !User.Identity.IsAuthenticated)
								{
									<div class="alert alert-info">
										<i class="bi bi-info-circle me-2"></i>
										<strong>@Localizer["GuestCheckout"]</strong> - @Localizer["GuestCheckoutInfo"]
									</div>
									<div class="form-row">
										<label>@Localizer["EmailAddress"] *</label>
										<input asp-for="OrderHeader.Email" type="email" class="form-control" required />
										<span asp-validation-for="OrderHeader.Email" class="text-danger"></span>
									</div>
								}
								
								<div class="form-row">
									<label>@Localizer["Name"]</label>
									<input asp-for="OrderHeader.Name" class="form-control" />
									<span asp-validation-for="OrderHeader.Name" class="text-danger"></span>
								</div>

								<div class="form-row">
									<label>@Localizer["Phone"]</label>
									<input asp-for="OrderHeader.PhoneNumber" class="form-control" />
									<span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
								</div>

								<div class="form-row">
									<label>@Localizer["StreetAddress"]</label>
									<input asp-for="OrderHeader.StreetAddress" class="form-control" />
									<span asp-validation-for="OrderHeader.StreetAddress" class="text-danger"></span>
								</div>

								<div class="form-row">
									<label>@Localizer["City"]</label>
									<input asp-for="OrderHeader.City" class="form-control" />
									<span asp-validation-for="OrderHeader.City" class="text-danger"></span>
								</div>

								<div class="form-row">
									<label>@Localizer["State"]</label>
									<input asp-for="OrderHeader.State" class="form-control" />
									<span asp-validation-for="OrderHeader.State" class="text-danger"></span>
								</div>

								<div class="form-row">
									<label>@Localizer["PostalCode"]</label>
									<input asp-for="OrderHeader.PostalCode" class="form-control" />
									<span asp-validation-for="OrderHeader.PostalCode" class="text-danger"></span>
								</div>
							</div>
						</div>

						<div class="col-12 col-lg-5 offset-lg-1">
							<div class="order-items-section">
								<h4>
									<i class="bi bi-basket3 me-2"></i>
									@Localizer["OrderItems"]
								</h4>
								<ul class="order-items-list">
									@foreach(var details in Model.ShoppingCartList)
									{
										<li class="order-item">
											<div>
												<h6 class="order-item-title">@details.product.Title</h6>
												<small class="order-item-quantity">@Localizer["Quantity"]: @details.Count</small>
											</div>
											<span class="order-item-price">@((details.Price*details.Count).ToString("c"))</span>
										</li>
									}

									<li class="order-item order-total-item">
										<small class="order-total-label">@Localizer["Total"] (USD)</small>
										<strong class="order-total-value">@Model.OrderHeader.OrderTotal.ToString("c")</strong>
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>

				<div class="order-summary-footer">
					<div class="row align-items-center">
						<div class="col-12 col-md-8">
							<p class="estimate-delivery">
								<i class="bi bi-calendar-check me-2"></i>
								@Localizer["EstimatedDelivery"]: @DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()
							</p>
						</div>
						<div class="col-12 col-md-8">
							<button type="submit" class="place-order-btn">
								<i class="bi bi-check-circle me-2"></i>
								@Localizer["PlaceOrder"]
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
