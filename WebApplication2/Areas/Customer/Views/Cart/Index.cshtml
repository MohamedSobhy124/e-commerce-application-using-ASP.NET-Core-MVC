@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@model ShoppingCartVM
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<section class="cart-page-wrapper">
    <div class="container py-4">
        <a asp-action="Index" asp-controller="Home" class="continue-shopping-btn">
            <i class="bi bi-arrow-left"></i>
            @Localizer["ContinueShopping"]
        </a>
        
        <div class="row">
            <div class="col-12">
                <div class="cart-header-section">
                    <h3 class="cart-title">
                        <i class="bi bi-cart3 me-3"></i>@Localizer["ShoppingCart"]e
                    </h3>
                    <div class="cart-sort">
                        <p class="cart-sort-label">@Localizer["SortBy"]:</p>
                        <a href="#!" class="cart-sort-link">
                            @Localizer["Price"] <i class="bi bi-chevron-down"></i>
                        </a>
                    </div>                  
                </div>

                @foreach(var item in Model.ShoppingCartList)
                {
                     
                        // Get product image - check ProductImages first, then fallback to ImageUrl
                        string productImageUrl = null;
                        if (item.product.ProductImages != null && item.product.ProductImages.Any())
                        {
                            var firstImage = item.product.ProductImages.OrderBy(pi => pi.DisplayOrder).FirstOrDefault();
                            productImageUrl = firstImage?.ImageUrl;
                        }
                        if (string.IsNullOrEmpty(productImageUrl))
                        {
                            productImageUrl = item.product.ImageUrl;
                        }
                        if (string.IsNullOrEmpty(productImageUrl))
                        {
                            productImageUrl = "/images/no-image.png";
                        }
                    
                    <div class="cart-item-card">
                        <div class="row d-flex justify-content-between align-items-center">
                            <div class="col-md-2 col-lg-2 col-xl-2">
                                <img src="@productImageUrl" class="cart-item-image" alt="@item.product.Title">
                            </div>
                            <div class="col-md-3 col-lg-3 col-xl-3">
                                <p class="cart-item-title">@item.product.Title</p>
                                <div class="cart-item-description">
                                    @Html.Raw(@item.product.Description)
                                </div>
                            </div>
                            <div class="col-md-3 col-lg-3 col-xl-2">
                                <div class="cart-quantity-controls">
                                    <a class="cart-quantity-btn" asp-action="Minus" asp-route-CartId="@item.Id" asp-route-ProductId="@item.ProductId">
                                        <i class="bi bi-dash"></i>
                                    </a>

                                    <input readonly value="@item.Count" type="number" class="cart-quantity-input" />

                                    <a class="cart-quantity-btn" asp-action="Pluse" asp-route-CartId="@item.Id" asp-route-ProductId="@item.ProductId">
                                        <i class="bi bi-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-3 col-lg-2 col-xl-2">
                                <h5 class="cart-item-price">@Html.Raw(currencySymbol) @item.Price.ToString("N2")</h5>
                            </div>                          
                            <div class="col-md-1 col-lg-1 col-xl-1 text-end">
                                <a asp-action="Remove" asp-route-CartId="@item.Id" asp-route-ProductId="@item.ProductId" class="cart-delete-btn">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </div>  
                    </div>
                }

                <div class="cart-total-card">
                    <p class="cart-total-label">@Localizer["TotalAmount"]</p>
                    <h2 class="cart-total-amount">@Html.Raw(currencySymbol) @Model.OrderTotal.ToString("N2")</h2>
                    <hr style="border-color: rgba(255,255,255,0.3); margin: 1.5rem 0;" />
                    <a asp-action="Summary" class="cart-summary-btn">
                        <i class="bi bi-arrow-right-circle"></i>
                        @Localizer["ProceedToSummary"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
