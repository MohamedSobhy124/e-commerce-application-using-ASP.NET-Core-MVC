@using BulkyBook.Areas.Customer.Controllers
@model BlogPost
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = ViewData["Title"] ?? Model.Title;
    var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var isRtl = currentCulture == "ar";
    var relatedBlogs = ViewBag.RelatedBlogs as List<BlogPost> ?? new List<BlogPost>();
}

@section Head {
    <meta name="description" content="@Model.MetaDescription" />
    <meta name="keywords" content="@Model.MetaKeywords" />
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@Model.MetaDescription" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)@Model.ImageUrl" />
    <meta property="article:published_time" content="@Model.PublishedDate.ToString("yyyy-MM-ddTHH:mm:ssZ")" />
    <meta property="article:author" content="@Model.Author" />
    <meta property="article:section" content="@Model.Category" />
    <link rel="canonical" href="@(ViewData["Canonical"] ?? (Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path))" />
    
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BlogPosting",
        "headline": "@Model.Title",
        "description": "@Model.MetaDescription",
        "image": "@Context.Request.Scheme://@Context.Request.Host@Model.ImageUrl",
        "datePublished": "@Model.PublishedDate.ToString("yyyy-MM-ddTHH:mm:ssZ")",
        "dateModified": "@Model.PublishedDate.ToString("yyyy-MM-ddTHH:mm:ssZ")",
        "author": {
            "@@type": "Person",
            "name": "@Model.Author"
        },
        "publisher": {
            "@@type": "Organization",
            "name": "Ideal Weight",
            "logo": {
                "@@type": "ImageObject",
                "url": "@Context.Request.Scheme://@Context.Request.Host/images/logo.png"
            }
        },
        "mainEntityOfPage": {
            "@@type": "WebPage",
            "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)"
        }
    }
    </script>
}

<link rel="stylesheet" href="~/css/blog.css" />

<div class="blog-detail-container">
    <!-- Breadcrumb -->
    <nav class="blog-breadcrumb">
        <div class="container">
            <ol class="breadcrumb-list">
                <li><a asp-area="Customer" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                <li><a asp-action="Index">@Localizer["Blog"]</a></li>
                <li class="active">@Model.Title</li>
            </ol>
        </div>
    </nav>

    <!-- Blog Article -->
    <article class="blog-article">
        <div class="container">
            <div class="blog-article-header">
                <div class="article-category">
                    <i class="bi bi-tag"></i>
                    @Model.Category
                </div>
                <h1 class="article-title">@Model.Title</h1>
                <div class="article-meta">
                    <div class="article-author">
                        <i class="bi bi-person-circle"></i>
                        <span>@Model.Author</span>
                    </div>
                    <div class="article-date">
                        <i class="bi bi-calendar"></i>
                        <span>@Model.PublishedDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="article-read-time">
                        <i class="bi bi-clock"></i>
                        <span>@Model.ReadTime @Localizer["MinRead"]</span>
                    </div>
                </div>
            </div>

            <div class="blog-article-image">
                <img src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('image-error');" />
            </div>

            <div class="blog-article-content">
                <div class="article-excerpt">
                    <p>@Model.Excerpt</p>
                </div>

                <div class="article-body">
                    @Html.Raw(Model.Content)
                </div>

                <!-- Share Buttons -->
                <div class="article-share">
                    <h4>@Localizer["ShareThisArticle"]</h4>
                    <div class="share-buttons">
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" 
                           target="_blank" 
                           class="share-btn share-facebook">
                            <i class="bi bi-facebook"></i>
                            Facebook
                        </a>
                        <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)&text=@Uri.EscapeDataString(Model.Title)" 
                           target="_blank" 
                           class="share-btn share-twitter">
                            <i class="bi bi-twitter"></i>
                            Twitter
                        </a>
                        <a href="https://www.linkedin.com/shareArticle?url=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)&title=@Uri.EscapeDataString(Model.Title)" 
                           target="_blank" 
                           class="share-btn share-linkedin">
                            <i class="bi bi-linkedin"></i>
                            LinkedIn
                        </a>
                        <button onclick="copyToClipboard('@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)')" class="share-btn share-copy">
                            <i class="bi bi-link-45deg"></i>
                            @Localizer["CopyLink"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </article>

    <!-- Related Articles -->
    @if (relatedBlogs.Any())
    {
        <section class="related-articles">
            <div class="container">
                <h2 class="section-title">
                    <i class="bi bi-journal-text me-2"></i>
                    @Localizer["RelatedArticles"]
                </h2>
                <div class="related-articles-grid">
                    @foreach (var relatedBlog in relatedBlogs)
                    {
                        <div class="related-article-card">
                            <div class="related-article-image">
                                <img src="@relatedBlog.ImageUrl" alt="@relatedBlog.Title" loading="lazy" onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('image-error');" />
                            </div>
                            <div class="related-article-content">
                                <div class="related-article-meta">
                                    <span class="related-article-category">@relatedBlog.Category</span>
                                    <span class="related-article-date">@relatedBlog.PublishedDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <h3 class="related-article-title">
                                    <a asp-action="Details" asp-route-slug="@relatedBlog.Slug">@relatedBlog.Title</a>
                                </h3>
                                <p class="related-article-excerpt">@(relatedBlog.Excerpt.Length > 120 ? relatedBlog.Excerpt.Substring(0, 120) + "..." : relatedBlog.Excerpt)</p>
                                <a asp-action="Details" asp-route-slug="@relatedBlog.Slug" class="related-article-link">
                                    @Localizer["ReadMore"]
                                    <i class="bi bi-arrow-@(isRtl ? "left" : "right")"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Back to Blog -->
    <div class="back-to-blog">
        <div class="container">
            <a asp-action="Index" class="btn-back-blog">
                <i class="bi bi-arrow-@(isRtl ? "right" : "left")"></i>
                @Localizer["BackToBlog"]
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                toastr.success('@Localizer["LinkCopied"]');
            }, function(err) {
                toastr.error('@Localizer["FailedToCopy"]');
            });
        }
    </script>
}

