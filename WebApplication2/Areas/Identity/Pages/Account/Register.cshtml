@page
@model RegisterModel
 
<div class="container" style="max-width: 700px; margin-top: 3rem;">
    <div class="card shadow-lg border-0">
        <div class="card-header" style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); padding: 2rem; text-align: center; border: none;">
            <h2 class="text-white mb-0" style="font-weight: 800; font-size: 2rem;">
                <i class="bi bi-person-plus me-2"></i>
                Create Account
            </h2>
            <p class="text-white-50 mb-0" style="margin-top: 0.5rem;">Join BulkyBook today</p>
        </div>
        <div class="card-body p-4">
            <!-- External Registration Options -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="mb-4">
                    <div class="external-login-title" style="margin-bottom: 1.5rem;">
                        <span>Quick sign up with</span>
                    </div>
                    
                    <div class="external-login-buttons">
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="external-login-form">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                @if (provider.Name == "Google")
                                {
                                    <button type="submit" name="provider" value="@provider.Name" class="google-login-btn">
                                        <span class="google-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                            </svg>
                                        </span>
                                        Sign up with Google
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="provider" value="@provider.Name" class="google-login-btn">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                        Sign up with @provider.DisplayName
                                    </button>
                                }
                            }
                        </form>
                    </div>

                    <div class="external-login-title" style="margin-top: 2rem; margin-bottom: 1.5rem;">
                        <span>Or register with email</span>
                    </div>
                </div>
            }

            <!-- Traditional Registration Form -->
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Input.Email" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-envelope me-2"></i>Email
                        </label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Input.Name" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-person me-2"></i>Full Name
                        </label>
                        <input asp-for="Input.Name" class="form-control" autocomplete="name" aria-required="true" placeholder="John Doe" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Password" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-lock me-2"></i>Password
                        </label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-lock-fill me-2"></i>Confirm Password
                        </label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.PhoneNumber" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-telephone me-2"></i>Phone Number
                        </label>
                        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" placeholder="+1 (555) 000-0000" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.StreetAddress" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-house me-2"></i>Street Address
                        </label>
                        <input asp-for="Input.StreetAddress" class="form-control" autocomplete="street-address" placeholder="123 Main St" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.City" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-geo-alt me-2"></i>City
                        </label>
                        <input asp-for="Input.City" class="form-control" autocomplete="address-level2" placeholder="New York" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.City" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.State" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-map me-2"></i>State
                        </label>
                        <input asp-for="Input.State" class="form-control" autocomplete="address-level1" placeholder="NY" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.State" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.PostalCode" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-mailbox me-2"></i>Postal Code
                        </label>
                        <input asp-for="Input.PostalCode" class="form-control" autocomplete="postal-code" placeholder="10001" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Role" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-person-badge me-2"></i>Role
                        </label>
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-weight: 500;">
                            <option disabled selected>-- Select Role --</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.CompanyId" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-building me-2"></i>Company
                        </label>
                        <select asp-for="Input.CompanyId" style="display:none; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-weight: 500;" asp-items="@Model.Input.CompanyList" class="form-select">
                            <option disabled selected>-- Select Company --</option>
                        </select>
                    </div>
                </div>
                
                <div class="mb-3">
                    <button id="registerSubmit" type="submit" class="w-100 btn" style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); color: white; padding: 0.875rem; font-weight: 700; font-size: 1.063rem; border: none; border-radius: 8px; transition: all 0.3s ease;">
                        <i class="bi bi-person-plus me-2"></i>Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Help Text -->
    <div class="text-center mt-4" style="color: #6b7280; font-size: 0.95rem;">
        <p class="mb-0">
            Already have an account? 
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" style="color: #7c3aed; font-weight: 600; text-decoration: none;">
                <i class="bi bi-box-arrow-in-right me-1"></i>Log in
            </a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function(){
            $('#Input_Role').change(function(){
                var Selection = $('#Input_Role option:selected').text();
                if (Selection == 'Company') {
                    $('#Input_CompanyId').show();
                } else {
                    $('#Input_CompanyId').hide();
                }
            });
        });

        // Add hover effect to register button
        document.getElementById('registerSubmit').addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
            this.style.boxShadow = '0 10px 25px rgba(124, 58, 237, 0.4)';
        });
        document.getElementById('registerSubmit').addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
            this.style.boxShadow = 'none';
        });
    </script>
}
