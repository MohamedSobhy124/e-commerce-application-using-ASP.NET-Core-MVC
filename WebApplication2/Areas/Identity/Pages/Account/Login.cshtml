@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container" style="max-width: 500px; margin-top: 3rem;">
    <div class="card shadow-lg border-0">
        <div class="card-header" style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); padding: 2rem; text-align: center; border: none;">
            <h2 class="text-white mb-0" style="font-weight: 800; font-size: 2rem;">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Welcome Back
            </h2>
            <p class="text-white-50 mb-0" style="margin-top: 0.5rem;">Log in to continue to BulkyBook</p>
        </div>
        <div class="card-body p-4">
            <section>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-envelope me-2"></i>Email
                        </label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label" style="font-weight: 600; color: #374151;">
                            <i class="bi bi-lock me-2"></i>Password
                        </label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" style="padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px;" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label" style="font-weight: 500; color: #6b7280;">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    
                    <div class="mb-3">
                        <button id="login-submit" type="submit" class="w-100 btn" style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); color: white; padding: 0.875rem; font-weight: 700; font-size: 1.063rem; border: none; border-radius: 8px; transition: all 0.3s ease;">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log In
                        </button>
                    </div>
                    
                    <div class="d-flex justify-content-between flex-wrap gap-2" style="font-size: 0.95rem;">
                        <a id="forgot-password" asp-page="./ForgotPassword" style="color: #7c3aed; font-weight: 600; text-decoration: none;">
                            <i class="bi bi-question-circle me-1"></i>Forgot password?
                        </a>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="color: #7c3aed; font-weight: 600; text-decoration: none;">
                            <i class="bi bi-person-plus me-1"></i>Register new user
                        </a>
                    </div>
                </form>
            </section>

            <!-- External Login Section -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="external-login-section">
                    <div class="external-login-title">
                        <span>Or continue with</span>
                    </div>
                    
                    <div class="external-login-buttons">
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="external-login-form">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                @if (provider.Name == "Google")
                                {
                                    <button type="submit" name="provider" value="@provider.Name" class="google-login-btn">
                                        <span class="google-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                            </svg>
                                        </span>
                                        Continue with Google
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="provider" value="@provider.Name" class="google-login-btn">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                        Continue with @provider.DisplayName
                                    </button>
                                }
                            }
                        </form>
                    </div>

                    <div class="external-login-notice">
                        <i class="bi bi-shield-check"></i>
                        <p>Your data is secure. We'll never share your information without your permission.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Note:</strong> External authentication services are not configured yet. 
                    Please follow the setup guide to enable Google login.
                </div>
            }
        </div>
    </div>
    
    <!-- Help Text -->
    <div class="text-center mt-4" style="color: #6b7280; font-size: 0.875rem;">
        <p class="mb-1">
            Need help? <a href="#" style="color: #7c3aed; font-weight: 600; text-decoration: none;">Contact Support</a>
        </p>
        <p class="mb-0">
            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="color: #7c3aed; font-weight: 600; text-decoration: none;">
                Resend email confirmation
            </a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Add hover effect to login button
        document.getElementById('login-submit').addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
            this.style.boxShadow = '0 10px 25px rgba(124, 58, 237, 0.4)';
        });
        document.getElementById('login-submit').addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
            this.style.boxShadow = 'none';
        });
    </script>
}
