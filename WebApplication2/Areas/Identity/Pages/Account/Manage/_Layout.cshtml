@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="account-manage-container">
    <div class="container py-4">
        <!-- Header Section -->
        <div class="account-header mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="account-title">
                        <i class="bi bi-person-gear me-2"></i>@Localizer["ManageAccount"]
                    </h1>
                    <p class="account-subtitle mb-0">@Localizer["ManageAccountSubtitle"]</p>
                </div>
                <a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToHome"]
                </a>
            </div>
        </div>

        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3 mb-4">
                <div class="account-sidebar">
                    <partial name="_ManageNav" />
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div class="account-content">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .account-manage-container {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: calc(100vh - 200px);
            padding: 2rem 0;
        }

        .account-header {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .account-title {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }

        .account-subtitle {
            color: #6c757d;
            font-size: 1rem;
        }

        .account-sidebar {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            position: sticky;
            top: 100px;
        }

        .account-content {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            min-height: 400px;
        }

        @@media (max-width: 991px) {
            .account-sidebar {
                position: relative;
                top: 0;
                margin-bottom: 1.5rem;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
}

@section Scripts {
    @RenderSection("Scripts", required: false)
}
