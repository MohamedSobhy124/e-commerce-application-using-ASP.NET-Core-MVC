@model IEnumerable<BulkyBook.Models.Categry>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-tag-fill me-3"></i>
                    @Localizer["CategoriesList"]
                </h2>
            </div>

            <div class="admin-card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="text-muted">
                        <i class="bi bi-info-circle me-2"></i>
                        <span>@Model.Count() @Localizer["Category"]</span>
                    </div>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle me-2"></i>
                        @Localizer["CreateNewCategory"]
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center py-5">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #3B9DD5;"></i>
                        <h4 class="mt-3">@Localizer["NoCategoriesYet"]</h4>
                        <p class="mb-3">@Localizer["CreateCategoryToOrganizeProducts"]</p>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            @Localizer["CreateFirstCategory"]
                        </a>
                    </div>
                }
                else
                {
                    <div class="admin-table-wrapper">
                        <table class="table table-bordered table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 80px;">
                                        <i class="bi bi-image me-2"></i>@Localizer["Image"]
                                    </th>
                                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.NameAr)</th>
                                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                                    <th style="width: 200px;" class="text-center">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" 
                                                     class="category-thumbnail" 
                                                     style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 2px solid #dee2e6;" />
                                            }
                                            else
                                            {
                                                <div class="category-thumbnail-placeholder">
                                                    <i class="bi bi-image" style="font-size: 1.5rem; color: #adb5bd;"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                        </td>
                                        <td dir="rtl">
                                            <strong>@Html.DisplayFor(modelItem => item.NameAr)</strong>
                                        </td>
                                        <td>
                                            <span class="text-muted">
                                                @(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary" title="@Localizer["Edit"]">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="@Localizer["Details"]">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="@Localizer["Delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .category-thumbnail-placeholder {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 8px;
        border: 2px dashed #dee2e6;
        margin: 0 auto;
    }
    
    .admin-table-wrapper {
        overflow-x: auto;
    }
    
    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }
    
    .btn-group .btn {
        margin: 0 2px;
    }
</style>
