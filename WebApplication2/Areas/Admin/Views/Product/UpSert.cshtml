        function saveProductBasicInfo() {
            return new Promise((resolve, reject) => {
                const form = document.querySelector('form[asp-action="UpSert"]') || document.querySelector('form');
                if (!form) {
                    reject('Form not found');
                    return;
                }

                const formData = new FormData(form);
                formData.append('saveOnly', 'true'); // Flag to indicate partial save

                const formAction = form.getAttribute('action') || '/Admin/Product/UpSert';
                fetch(formAction, {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    // Check if response is JSON or HTML
                    const contentType = response.headers.get("content-type");
                    if (contentType && contentType.includes("application/json")) {
                        return response.json();
                    } else {
                        // If HTML, try to parse as text and check for errors
                        return response.text().then(text => {
                            throw new Error('Unexpected response format');
                        });
                    }
                })
                .then(data => {
                    if (data.success) {
                        productId = data.productId;
                        const idInput = document.querySelector('input[name="product.Id"]');
                        if (idInput) {
                            idInput.value = productId;
                        }
                        // Show add option button after product is saved
                        const addOptionBtn = document.getElementById('addOptionBtn');
                        if (addOptionBtn) addOptionBtn.style.display = 'inline-block';
                        resolve();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: localizations.error,
                            text: data.message || 'Failed to save product'
                        });
                        reject(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: 'Failed to save product. Please check all required fields are filled.'
                    });
                    reject(error);
                });
            });
        }

        function addNewOption() {
            if (productId === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: localizations.saveProductFirst,
                    text: localizations.pleaseSaveProductBeforeAddingOptions
                });
                return;
            }

            Swal.fire({
                title: localizations.addNewOption,
                input: 'text',
                inputLabel: localizations.optionNameExample,
                inputPlaceholder: localizations.enterOptionName,
                showCancelButton: true,
                confirmButtonText: localizations.add,
                cancelButtonText: localizations.cancel,
                inputValidator: (value) => {
                    if (!value) {
                        return localizations.optionNameRequired;
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Admin/Product/AddOption', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify({
                            productId: productId,
                            optionName: result.value,
                            displayOrder: options.length
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            loadOptions();
                            Swal.fire(localizations.success, localizations.optionAddedSuccessfully, 'success');
                        } else {
                            Swal.fire(localizations.error, data.message || localizations.failedToAddOption, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire(localizations.error, localizations.failedToAddOption, 'error');
                    });
                }
            });
        }

        function loadOptions() {
            if (productId === 0) return;
            
            fetch(`/Admin/Product/GetProductOptions?productId=${productId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        options = data.options;
                        renderOptions();
                        updateStepProgress();
                    }
                })
                .catch(error => console.error('Error loading options:', error));
        }

        function renderOptions() {
            const container = document.getElementById('optionsList');
            container.innerHTML = '';

            if (!options || options.length === 0) {
                container.innerHTML = `
                    <div class="no-options-message">
                        <i class="bi bi-inbox me-2"></i>
                        ${localizations.noOptionsAddedYet}
                    </div>
                `;
                document.getElementById('generateVariantsBtn').style.display = 'none';
                document.getElementById('variantsContainer').style.display = 'none';
                return;
            }

            options.forEach((option, optionIndex) => {
                const optionDiv = document.createElement('div');
                optionDiv.className = 'option-card';
                optionDiv.innerHTML = `
                    <div class="option-card-header">
                        <div class="option-card-title-wrapper">
                            <i class="bi bi-tag-fill option-card-icon"></i>
                            <strong class="option-card-name">${option.name}</strong>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger btn-delete-option" onclick="deleteOption(${option.id})" title="${localizations.deleteOption}">
                            <i class="bi bi-trash-fill"></i>
                            <span class="d-none d-md-inline ms-1">${localizations.delete}</span>
                        </button>
                    </div>
                    <div class="option-card-body">
                        <div class="option-value-input-group">
                            <input type="text" class="form-control option-value-input" id="newValue_${option.id}" placeholder="${localizations.addValuePlaceholder}">
                            <button type="button" class="btn btn-primary btn-add-value" onclick="addOptionValue(${option.id})">
                                <i class="bi bi-plus-circle-fill me-1"></i>
                                <span>${localizations.add}</span>
                            </button>
                        </div>
                        <div id="values_${option.id}" class="option-values-list"></div>
                    </div>
                `;
                container.appendChild(optionDiv);
                renderOptionValues(option.id, option.values || []);
            });

            // Show generate variants button and variants container when options exist
            document.getElementById('generateVariantsBtn').style.display = 'inline-block';
            document.getElementById('variantsContainer').style.display = 'block';
            const saveStep2Btn = document.getElementById('saveStep2Btn');
            const saveStep3Btn = document.getElementById('saveStep3Btn');
            if (saveStep2Btn && productId > 0) saveStep2Btn.style.display = 'inline-block';
            if (saveStep3Btn && productId > 0) saveStep3Btn.style.display = 'inline-block';
            updateStepProgress();
        }

        function renderOptionValues(optionId, values) {
            const container = document.getElementById(`values_${optionId}`);
            container.innerHTML = '';
            
            if (!values || values.length === 0) {
                container.innerHTML = `<div class="no-values-message"><i class="bi bi-info-circle me-2"></i>${localizations.noValuesAddedYet}</div>`;
                return;
            }

            values.forEach(value => {
                const valueBadge = document.createElement('div');
                valueBadge.className = 'option-value-badge';
                valueBadge.innerHTML = `
                    <span class="value-text">${value.value}</span>
                    <button type="button" class="btn-remove-value" onclick="deleteOptionValue(${value.id}, ${optionId})" title="${localizations.removeValue}">
                        <i class="bi bi-x-lg"></i>
                    </button>
                `;
                container.appendChild(valueBadge);
            });
        }

        function addOptionValue(optionId) {
            const input = document.getElementById(`newValue_${optionId}`);
            const value = input.value.trim();
            
            if (!value) {
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: localizations.pleaseEnterValue
                });
                return;
            }

            fetch('/Admin/Product/AddOptionValue', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                    optionId: optionId,
                    value: value,
                    displayOrder: 0
                })
            })
            .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            input.value = '';
                            loadOptions();
                            updateStepProgress();
                        } else {
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: data.message || localizations.failedToAddValue
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: localizations.failedToAddValue
                });
            });
        }

        function deleteOption(optionId) {
            Swal.fire({
                title: localizations.deleteOption + '?',
                text: localizations.deleteOptionWarning,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: localizations.yesDeleteIt,
                cancelButtonText: localizations.cancel
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/Product/DeleteOption?optionId=${optionId}`, {
                        method: 'DELETE',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            loadOptions();
                            Swal.fire({
                                icon: 'success',
                                title: localizations.deleted,
                                text: localizations.optionDeletedSuccessfully,
                                timer: 2000,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: localizations.error,
                                text: data.message || localizations.failedToDeleteOption
                            });
                        }
                    });
                }
            });
        }

        function deleteOptionValue(valueId, optionId) {
            fetch(`/Admin/Product/DeleteOptionValue?valueId=${valueId}`, {
                method: 'DELETE',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            loadOptions();
                            updateStepProgress();
                        } else {
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: data.message || localizations.failedToDeleteValue
                    });
                }
            });
        }

        function generateVariants() {
            if (productId === 0) {
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: localizations.pleaseSaveProductFirst
                });
                return;
            }

            Swal.fire({
                title: localizations.generateVariants + '?',
                text: localizations.generateVariantsWarning,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: localizations.yesGenerate,
                cancelButtonText: localizations.cancel
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: localizations.generating,
                        text: localizations.pleaseWaitGeneratingVariants,
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    fetch(`/Admin/Product/GenerateVariants?productId=${productId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`Network response was not ok: ${response.status} ${response.statusText}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        Swal.close();
                        console.log('Generate variants response:', data); // Debug
                        if (data.success) {
                            variants = data.variants;
                            console.log('Variants assigned:', variants); // Debug
                            
                            // Show Step 4 before rendering variants
                            const step4 = document.getElementById('step4');
                            if (step4) {
                                step4.style.display = 'block';
                            }
                            
                            renderVariants();
                            updateStepProgress();
                            Swal.fire({
                                icon: 'success',
                                title: localizations.success,
                                text: data.message || localizations.variantsGeneratedSuccessfully,
                                timer: 3000,
                                showConfirmButton: true
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: localizations.error,
                                text: data.message || localizations.failedToGenerateVariants
                            });
                        }
                    })
                    .catch(error => {
                        Swal.close();
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: localizations.error,
                            text: error.message || localizations.failedToGenerateVariantsCheckConsole
                        });
                    });
                }
            });
        }

        function renderVariants() {
            const container = document.getElementById('variantsTableContainer');
            const table = document.getElementById('variantsTable');
            const tbody = document.getElementById('variantsTableBody');
            
            // Always show the variants container when this function is called
            const variantsContainer = document.getElementById('variantsContainer');
            if (variantsContainer) {
                variantsContainer.style.display = 'block';
            }
            
            console.log('Rendering variants:', variants); // Debug log
            
            if (!variants || variants.length === 0) {
                if (container) {
                    container.innerHTML = `
                        <div class="no-variants-message">
                            <i class="bi bi-info-circle me-2"></i>
                            @Localizer["NoVariantsGeneratedYet"]
                        </div>
                    `;
                }
                if (table) {
                    table.style.display = 'none';
                }
                return;
            }

            // Clear container but keep table structure
            if (container) {
                // Don't clear innerHTML if table is inside - just show the table
                const existingMessage = container.querySelector('p.text-muted');
                if (existingMessage) {
                    existingMessage.remove();
                }
            }
            
            if (table) {
                table.style.display = 'table';
            }
            
            if (tbody) {
                tbody.innerHTML = '';

                variants.forEach(variant => {
                    console.log('Rendering variant:', variant); // Debug log
                    const row = document.createElement('tr');
                    row.className = 'variant-row';
                    row.innerHTML = `
                        <td class="variant-name-cell" data-label="${localizations.variant}">
                            <div class="variant-name-wrapper">
                                <i class="bi bi-tag-fill variant-name-icon"></i>
                                <span class="variant-name-text">${variant.variantName || variant.name || localizations.default}</span>
                            </div>
                        </td>
                        <td data-label="${localizations.price}">
                            <div class="input-group-sm">
                                <input type="number" step="0.01" class="form-control variant-input" value="${variant.price || 0}" onchange="updateVariantField(${variant.id}, 'price', this.value)">
                            </div>
                        </td>
                        <td data-label="${localizations.listPrice}">
                            <div class="input-group-sm">
                                <input type="number" step="0.01" class="form-control variant-input" value="${variant.listPrice || ''}" onchange="updateVariantField(${variant.id}, 'listPrice', this.value)">
                            </div>
                        </td>
                        <td data-label="${localizations.stock}">
                            <div class="input-group-sm">
                                <input type="number" class="form-control variant-input" value="${variant.stockQuantity || 0}" onchange="updateVariantField(${variant.id}, 'stockQuantity', this.value)">
                            </div>
                        </td>
                        <td data-label="${localizations.minStockAlert}">
                            <div class="input-group-sm">
                                <input type="number" class="form-control variant-input" value="${variant.minimumStockAlert || 5}" onchange="updateVariantField(${variant.id}, 'minimumStockAlert', this.value)">
                            </div>
                        </td>
                        <td class="variant-image-cell" data-label="${localizations.image}">
                            <div class="variant-image-upload">
                                <label class="variant-image-upload-label">
                                    <input type="file" accept="image/*" class="variant-image-input" onchange="uploadVariantImage(${variant.id}, this)">
                                    <i class="bi bi-camera-fill"></i>
                                    <span class="d-none d-md-inline">${localizations.upload}</span>
                                </label>
                                ${variant.imageUrl ? `<img src="${variant.imageUrl}" class="variant-image-preview" alt="Variant image">` : ''}
                            </div>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            }
        }

        function updateVariantField(variantId, field, value) {
            const variant = variants.find(v => v.id === variantId);
            if (!variant) {
                console.error('Variant not found:', variantId);
                return;
            }

            // Update local variant object
            variant[field] = value;

            // Debounce API call to avoid too many requests
            clearTimeout(window.variantUpdateTimeout);
            window.variantUpdateTimeout = setTimeout(() => {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                
                fetch('/Admin/Product/UpdateVariant', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        variantId: variantId,
                        price: parseFloat(variant.price) || 0,
                        listPrice: variant.listPrice ? parseFloat(variant.listPrice) : null,
                        stockQuantity: parseInt(variant.stockQuantity) || 0,
                        minimumStockAlert: parseInt(variant.minimumStockAlert) || 5
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            console.error('Server error:', response.status, text);
                            throw new Error(`Server error: ${response.status}`);
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    if (data && data.success) {
                        console.log('Variant updated successfully:', variantId);
                        // Show subtle success indicator
                        const input = document.querySelector(`input[onchange*="updateVariantField(${variantId}"]`);
                        if (input) {
                            input.style.borderColor = '#10b981';
                            setTimeout(() => {
                                input.style.borderColor = '';
                            }, 1000);
                        }
                    } else {
                        console.error('Failed to update variant:', data?.message || 'Unknown error');
                        // Show error indicator
                        const input = document.querySelector(`input[onchange*="updateVariantField(${variantId}"]`);
                        if (input) {
                            input.style.borderColor = '#ef4444';
                            setTimeout(() => {
                                input.style.borderColor = '';
                            }, 2000);
                        }
                    }
                })
                .catch(error => {
                    console.error('Error updating variant:', error);
                    // Show error indicator
                    const input = document.querySelector(`input[onchange*="updateVariantField(${variantId}"]`);
                    if (input) {
                        input.style.borderColor = '#ef4444';
                        setTimeout(() => {
                            input.style.borderColor = '';
                        }, 2000);
                    }
                });
            }, 500);
        }

        function uploadVariantImage(variantId, input) {
            if (!input.files || input.files.length === 0) return;

            const formData = new FormData();
            formData.append('file', input.files[0]);

            fetch(`/Admin/Product/UploadVariantImage?variantId=${variantId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const variant = variants.find(v => v.id === variantId);
                    if (variant) {
                        variant.imageUrl = data.imageUrl;
                        renderVariants();
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: data.message || localizations.failedToUploadImage
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: localizations.failedToUploadImage
                });
            });
        }

        function deleteVariant(variantId) {
            Swal.fire({
                title: localizations.deleteVariant + '?',
                text: localizations.deleteVariantWarning,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: localizations.yesDeleteIt,
                cancelButtonText: localizations.cancel
            }).then((result) => {
                if (result.isConfirmed) {
                    // Remove from local array
                    variants = variants.filter(v => v.id !== variantId);
                    renderVariants();
                    // TODO: Add API call to delete from database
                }
            });
        }

        // Preview multiple images
        document.getElementById('files-input')?.addEventListener('change', function(e) {
            const previewContainer = document.getElementById('preview-container');
            previewContainer.innerHTML = '';
            
            if (this.files && this.files.length > 0) {
                Array.from(this.files).forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = 'preview-image-item';
                        div.innerHTML = `
                            <img src="${e.target.result}" alt="Preview ${index + 1}" class="preview-image" />
                            <span class="preview-badge">New</span>
                        `;
                        previewContainer.appendChild(div);
            };
                    reader.readAsDataURL(file);
                });
            }
        });

        // Delete image function
        function deleteImage(imageId, button) {
            Swal.fire({
                title: localizations.deleteImage,
                text: localizations.areYouSureDeleteImage,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: localizations.yesDeleteIt,
                cancelButtonText: localizations.cancel,
                dangerMode: true
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

            const imageItem = button.closest('.image-item');
            
            fetch('/Admin/Product/DeleteImage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ imageId: imageId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    imageItem.remove();
                    
                    // Check if any images remain
                    const remainingImages = document.querySelectorAll('.image-item').length;
                    if (remainingImages === 0) {
                        const gallery = document.getElementById('images-gallery');
                        if (gallery) {
                            gallery.innerHTML = '<p class="text-muted text-center">@Localizer["NoImagesPleaseUpload"]</p>';
                        }
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["ErrorDeletingImage"]: ' + (data.message || '@Localizer["UnknownError"]')
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: '@Localizer["Error"]',
                    text: '@Localizer["ErrorDeletingImageTryAgain"]'
                });
            });
            });
        }
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

