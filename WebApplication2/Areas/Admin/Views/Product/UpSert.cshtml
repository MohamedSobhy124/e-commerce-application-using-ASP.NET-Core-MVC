@model ProductVM

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container-fluid">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h2 class="admin-form-title">
                    <i class="bi bi-@(Model.product.Id != 0 ? "pencil-square" : "plus-circle") me-3"></i>
                    @(Model.product.Id != 0 ? Localizer["Update"] : Localizer["Create"]) @Localizer["Product"]
                </h2>
            </div>

            <div class="admin-form-body">
                <form asp-action="UpSert" enctype="multipart/form-data" id="productForm">
                    @Html.AntiForgeryToken()
                    <input hidden asp-for="product.Id" />
                    <input hidden asp-for="product.ImageUrl" />

                    <div class="row">
                        <div class="col-lg-9 col-md-8">
                            <div class="admin-form-container">
                                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                                <div class="admin-form-group">
                                    <label asp-for="product.Title" class="admin-form-label">
                                        <i class="bi bi-card-heading me-2"></i>@Localizer["Title"] <span class="text-danger" style="font-weight: 700;">*</span>
                                    </label>
                                    <input asp-for="product.Title" class="admin-form-control" placeholder="@Localizer["EnterProductTitle"]" required />
                                    <span asp-validation-for="product.Title" class="text-danger"></span>
                                </div>

                                <div class="admin-form-group">
                                    <label asp-for="product.Description" class="admin-form-label">
                                        <i class="bi bi-text-paragraph me-2"></i>@Localizer["Description"] <span class="text-danger" style="font-weight: 700;">*</span>
                                    </label>
                                    <textarea asp-for="product.Description" class="admin-form-control" rows="4" placeholder="@Localizer["EnterProductDescription"]" required></textarea>
                                    <span asp-validation-for="product.Description" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.ListPrice" class="admin-form-label">
                                                <i class="bi bi-tag me-2"></i>@Localizer["ListPrice"] <span class="text-danger" style="font-weight: 700;">*</span>
                                            </label>
                                            <input asp-for="product.ListPrice" class="admin-form-control" type="number" step="0.01" placeholder="0.00" min="0" required />
                                            <span asp-validation-for="product.ListPrice" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>@Localizer["Price"] <span class="text-danger" style="font-weight: 700;">*</span>
                                            </label>
                                            <input asp-for="product.Price" class="admin-form-control" type="number" step="0.01" placeholder="0.00" min="0" required />
                                            <span asp-validation-for="product.Price" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Stock Management Section -->
                                <div class="admin-form-section-title">
                                    <h4>
                                        <i class="bi bi-box-seam me-2"></i>@Localizer["StockManagement"]
                                    </h4>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.StockQuantity" class="admin-form-label">
                                                <i class="bi bi-boxes me-2"></i>@Localizer["StockQuantity"]
                                            </label>
                                            <input asp-for="product.StockQuantity" class="admin-form-control" type="number" min="0" placeholder="@Localizer["EnterAvailableStock"]" />
                                            <span asp-validation-for="product.StockQuantity" class="text-danger"></span>
                                            <small class="form-text text-muted">
                                                <i class="bi bi-info-circle me-1"></i>@Localizer["CurrentQuantityInStock"]
                                            </small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.MinimumStockAlert" class="admin-form-label">
                                                <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["LowStockAlertLevel"]
                                            </label>
                                            <input asp-for="product.MinimumStockAlert" class="admin-form-control" type="number" min="0" placeholder="@Localizer["SetAlertThreshold"]" />
                                            <span asp-validation-for="product.MinimumStockAlert" class="text-danger"></span>
                                            <small class="form-text text-muted">
                                                <i class="bi bi-info-circle me-1"></i>@Localizer["ShowWarningWhenStockFalls"]
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div class="admin-form-group">
                                    <label asp-for="product.CategryId" class="admin-form-label">
                                        <i class="bi bi-folder me-2"></i>@Localizer["Category"] <span class="text-danger" style="font-weight: 700;">*</span>
                                    </label>
                                    <select asp-for="product.CategryId" asp-items="@Model.CategryList" class="admin-form-select" required>
                                        <option value="" disabled selected>--- @Localizer["SelectCategory"] ---</option>
                                    </select>
                                    <span asp-validation-for="product.CategryId" class="text-danger"></span>
                                </div>

                                <!-- Product Type Field (in main form for new products) -->
                                @if (Model.product.Id == 0)
                                {
                                    <div class="admin-form-group">
                                        <label asp-for="product.ProductType" class="admin-form-label">
                                            <i class="bi bi-diagram-3-fill me-2"></i>
                                            @Localizer["ProductType"] <span class="text-danger" style="font-weight: 700;">*</span>
                                        </label>
                                        <select asp-for="product.ProductType" class="admin-form-select product-type-select" id="productTypeSelect" onchange="onProductTypeChange()" required>
                                            <option value="0">@Localizer["SimpleProduct"]</option>
                                            <option value="1">@Localizer["VariableProduct"]</option>
                                        </select>
                                        <span asp-validation-for="product.ProductType" class="text-danger"></span>
                                        <div class="form-help-text">
                                            <i class="bi bi-info-circle-fill me-1"></i>
                                            <span>@Localizer["ProductTypeHelp"]</span>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="col-lg-3 col-md-4">
                            <div class="image-upload-wrapper">
                                <h5 class="mb-3" style="color: #1976D2; font-weight: 700;">
                                    <i class="bi bi-images me-2"></i>@Localizer["ProductImages"]
                                </h5>
                                
                                <!-- Upload Multiple Images -->
                                <label for="files-input" class="upload-button" style="display: block; text-align: center; padding: 1rem; background: linear-gradient(135deg, #3B9DD5, #7BC043); color: white; border-radius: 10px; cursor: pointer; margin-bottom: 1.5rem;">
                                    <span class="upload-icon">
                                        <i class="bi bi-cloud-upload" style="font-size: 1.5rem;"></i>
                                    </span>
                                    <span style="display: block; margin-top: 0.5rem; font-weight: 600;">@Localizer["UploadImages"]</span>
                                    <small style="display: block; margin-top: 0.25rem; opacity: 0.9;">(@Localizer["AtLeastOneRequired"])</small>
                                    <input id="files-input" type="file" name="files" class="file-input" accept="image/*" multiple style="display: none;" />
                                </label>

                                <!-- Existing Images Gallery -->
                                <div id="images-gallery" class="images-gallery">
                                    @if (Model.product.ProductImages != null && Model.product.ProductImages.Any())
                                    {
                                        @foreach (var image in Model.product.ProductImages.OrderBy(pi => pi.DisplayOrder))
                                        {
                                            <div class="image-item" data-image-id="@image.Id">
                                                <img src="@image.ImageUrl" alt="Product Image" class="gallery-image" />
                                                <button type="button" class="delete-image-btn" onclick="deleteImage(@image.Id, this)" title="@Localizer["DeleteImage"]">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(Model.product.ImageUrl))
                                    {
                                        <div class="image-item" data-image-id="0">
                                            <img src="@Model.product.ImageUrl" alt="Product Image" class="gallery-image" />
                                            <span class="main-image-badge">Main</span>
                                        </div>
                                    }
                                </div>

                                <!-- Preview for new images -->
                                <div id="preview-container" class="preview-container mt-3"></div>
                            </div>
                        </div>
                            
                    </div>
                
                    <!-- Product Type & Variant Management Section -->
                    @if (Model.product.Id != 0)
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="variant-management-wrapper">
                                    <div class="admin-form-section-title mb-4">
                                        <h4 class="section-title">
                                            <i class="bi bi-layers-fill me-2"></i>
                                            @Localizer["ProductTypeAndVariants"]
                                        </h4>
                                        <p class="section-subtitle">@Localizer["ConfigureProductVariantsDescription"]</p>
                                    </div>
                                    
                                    <!-- Step-by-Step Wizard -->
                                    <div class="variant-wizard">
                                    <!-- Step 1: Choose Product Type -->
                                    <div class="wizard-step" id="step1">
                                        <div class="step-header">
                                            <div class="step-number active">1</div>
                                            <div class="step-content">
                                                <h5 class="step-title">
                                                    <i class="bi bi-diagram-3-fill me-2"></i>
                                                    @Localizer["Step1Title"]
                                                </h5>
                                                <p class="step-description">@Localizer["Step1Description"]</p>
                                            </div>
                                        </div>
                                        <div class="step-body">
                                            <div class="admin-form-group">
                                                <label asp-for="product.ProductType" class="admin-form-label">
                                                    <i class="bi bi-diagram-3-fill me-2"></i>
                                                    @Localizer["ProductType"] <span class="text-danger" style="font-weight: 700;">*</span>
                                                </label>
                                                <select asp-for="product.ProductType" class="admin-form-select product-type-select" id="productTypeSelect" onchange="onProductTypeChange()" required>
                                                    <option value="0">@Localizer["SimpleProduct"]</option>
                                                    <option value="1">@Localizer["VariableProduct"]</option>
                                                </select>
                                                <div id="productTypeSaveStatus" class="mt-2" style="display: none;">
                                                    <small class="text-success" id="productTypeSaveMessage">
                                                        <i class="bi bi-check-circle me-1"></i>
                                                        <span>@Html.Raw(Localizer["Saved"] ?? "Saved")</span>
                                                    </small>
                                                </div>
                                                <span asp-validation-for="product.ProductType" class="text-danger"></span>
                                                <div class="form-help-text">
                                                    <i class="bi bi-info-circle-fill me-1"></i>
                                                    <span>@Localizer["ProductTypeHelp"]</span>
                                                </div>
                                            </div>
                                            @* Auto-save is enabled, save button is hidden *@
                                            <div class="step-actions" id="step1Actions" style="display: none;">
                                                @* <button type="button" class="btn btn-primary btn-save-step" onclick="saveStep1()">
                                                    <i class="bi bi-check-circle me-2"></i>
                                                    @Localizer["SaveStep"]
                                                </button> *@
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Step 2: Add Options (shown only for Variable products) -->
                                    <div id="variantManagementSection" class="variant-management-card" style="display: none;">
                                        <div class="wizard-step" id="step2">
                                            <div class="step-header">
                                                <div class="step-number" id="step2Number">2</div>
                                                <div class="step-content">
                                                    <h5 class="step-title">
                                                        <i class="bi bi-list-ul-fill me-2"></i>
                                                        @Localizer["Step2Title"]
                                                    </h5>
                                                    <p class="step-description">@Localizer["Step2Description"]</p>
                                                </div>
                                            </div>
                                            <div class="step-body">
                                                <div id="optionsContainer" class="options-container">
                                                    <div class="options-header">
                                                        <button type="button" class="btn btn-primary btn-add-option" onclick="addNewOption()" id="addOptionBtn" style="display: none;">
                                                            <i class="bi bi-plus-circle-fill me-2"></i>
                                                            @Localizer["AddOption"]
                                                        </button>
                                                    </div>
                                                    <div id="optionsList" class="options-list"></div>
                                                </div>
                                                @*  <div class="step-actions">
                                                        <button type="button" class="btn btn-primary btn-save-step" onclick="saveStep2()" id="saveStep2Btn" style="display: none;">
                                                            <i class="bi bi-check-circle me-2"></i>
                                                            @Localizer["SaveStep"]
                                                        </button>
                                                    </div> *@
                                            </div>
                                        </div>

                                        <!-- Step 3: Generate Variants -->
                                        <div class="wizard-step" id="step3" style="display: none;">
                                            <div class="step-header">
                                                <div class="step-number" id="step3Number">3</div>
                                                <div class="step-content">
                                                    <h5 class="step-title">
                                                        <i class="bi bi-magic me-2"></i>
                                                        @Localizer["Step4Title"]
                                                    </h5>
                                                    <p class="step-description">@Localizer["Step4Description"]</p>
                                                </div>
                                            </div>
                                            <div class="step-body">
                                                <div class="generate-variants-section">
                                                    <button type="button" class="btn btn-success btn-lg btn-generate-variants" onclick="generateVariants()" id="generateVariantsBtn" style="display: none;">
                                                        <i class="bi bi-arrow-repeat me-2"></i>
                                                        @Localizer["GenerateVariants"]
                                                    </button>
                                                    <div class="step-info-box mt-3">
                                                        <i class="bi bi-info-circle-fill me-2"></i>
                                                        <span>@Localizer["Step4Info"]</span>
                                                    </div>
                                                </div>
                                                @*   <div class="step-actions">
                                                        <button type="button" class="btn btn-primary btn-save-step" onclick="saveStep3()" id="saveStep3Btn" style="display: none;">
                                                            <i class="bi bi-check-circle me-2"></i>
                                                            @Localizer["SaveStep"]
                                                        </button>
                                                    </div> *@
                                            </div>
                                        </div>

                                        <!-- Step 4: Edit Variants -->
                                        <div class="wizard-step" id="step4" style="display: none;">
                                            <div class="step-header">
                                                <div class="step-number completed" id="step4Number">4</div>
                                                <div class="step-content">
                                                    <h5 class="step-title">
                                                        <i class="bi bi-pencil-square me-2"></i>
                                                        @Localizer["Step5Title"]
                                                    </h5>
                                                    <p class="step-description">@Localizer["Step5Description"]</p>
                                                </div>
                                            </div>
                                            <div class="step-body">
                                                <div id="variantsContainer" class="variants-container">
                                                    <div id="variantsTableContainer" class="variants-table-wrapper">
                                                        <table class="table table-variants" id="variantsTable" style="display: none;">
                                                            <thead>
                                                                <tr>
                                                                    <th><i class="bi bi-tag-fill me-1"></i>@Localizer["Variant"]</th>
                                                                    <th><i class="bi bi-currency-dollar me-1"></i>@Localizer["Price"]</th>
                                                                    <th><i class="bi bi-tag me-1"></i>@Localizer["ListPrice"]</th>
                                                                    <th><i class="bi bi-box-seam me-1"></i>@Localizer["Stock"]</th>
                                                                    <th><i class="bi bi-exclamation-triangle me-1"></i>@Localizer["MinStockAlert"]</th>
                                                                    <th><i class="bi bi-image me-1"></i>@Localizer["Image"]</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="variantsTableBody"></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                                <div class="step-actions">
                                                    <button type="button" class="btn btn-primary btn-save-step" onclick="saveStep4()" id="saveStep4Btn" style="display: none;">
                                                        <i class="bi bi-check-circle me-2"></i>
                                                        @Localizer["SaveStep"]
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    }

                    <!-- Form Actions - Always at the bottom -->
                    <div class="row mt-5">
                        <div class="col-12">
                            <div class="form-actions">
                                @if (Model.product.Id != 0)
                                {
                                    <button type="button" class="btn btn-submit" onclick="saveMainProduct(); return false;" id="saveProductBtn">
                                        <i class="bi bi-check-circle me-2"></i>
                                        @Localizer["Update"] @Localizer["Product"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-submit" onclick="saveMainProduct(); return false;" id="saveProductBtn">
                                        <i class="bi bi-plus-circle me-2"></i>
                                        @Localizer["Create"] @Localizer["Product"]
                                    </button>
                                }
                                <a asp-action="Index" class="btn btn-back">
                                    <i class="bi bi-arrow-left me-2"></i>
                                    @Localizer["BackToList"]
                                </a>
                            </div>
                        </div>
                    </div>
                
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        let productId = @(Model.product.Id);
        let options = @Html.Raw(Json.Serialize(Model.product.ProductOptions?.Select(o => new {
            Id = o.Id,
            Name = o.Name,
            DisplayOrder = o.DisplayOrder,
            Values = o.OptionValues?.Select(v => new { Id = v.Id, Value = v.Value, DisplayOrder = v.DisplayOrder })  
        })  ));
        let variants = @Html.Raw(Json.Serialize(Model.product.ProductVariants?.Select(v => new {
            Id = v.Id,
            Price = v.Price,
            ListPrice = v.ListPrice,
            StockQuantity = v.StockQuantity,
            MinimumStockAlert = v.MinimumStockAlert,
            ImageUrl = v.ImageUrl,
            VariantName = v.VariantName
        })  ));

        // Initialize on page load
        // Prevent form submission completely
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('productForm') || document.querySelector('form');
            if (form) {
                // Remove any existing onsubmit handlers
                form.onsubmit = null;
                
                // Add event listener to prevent all form submissions
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    console.log('Form submission prevented');
                    return false;
                }, true); // Use capture phase to catch early
                
                // Also prevent Enter key from submitting
                form.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
                        const target = e.target;
                        if (target.type === 'submit' || target.type === 'button') {
                            return; // Let button handle it
                        }
                        e.preventDefault();
                        return false;
                    }
                });
                
                // Prevent save button from submitting form
                const saveBtn = document.getElementById('saveProductBtn');
                if (saveBtn) {
                    saveBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        console.log('Save button click - preventing default');
                        try {
                            saveMainProduct();
                        } catch (error) {
                            console.error('Error in saveMainProduct:', error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred. Please try again.'
                            });
                        }
                        return false;
                    }, true); // Use capture phase
                }
            }
            
            // Initialize Step 1 as active
            const step1Number = document.querySelector('#step1 .step-number');
            if (step1Number) {
                step1Number.classList.add('active');
            }
            
            // Show Step 1 save button only if product already exists
            if (productId > 0) {
                const step1Actions = document.getElementById('step1Actions');
                if (step1Actions) step1Actions.style.display = 'block';
                
                loadOptions();
                fetch(`/Admin/Product/GetProductVariants?productId=${productId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.variants) {
                            variants = data.variants;
                            if (variants && variants.length > 0) {
                                renderVariants();
                            } else {
                                document.getElementById('variantsContainer').style.display = 'block';
                            }
                            updateStepProgress();
                        }
                    })
                    .catch(error => console.error('Error loading variants:', error));
                
                // Check product type on load
                const productType = document.getElementById('productTypeSelect').value;
                if (productType === '1') {
                    toggleVariantSection();
                }
            }
        });

        // Auto-save Product Type when changed
        function onProductTypeChange() {
            const productType = document.getElementById('productTypeSelect').value;
            
            // Only auto-save if product already exists
            if (productId && productId > 0) {
                // Hide previous save status
                const saveStatus = document.getElementById('productTypeSaveStatus');
                const saveMessage = document.getElementById('productTypeSaveMessage');
                if (saveStatus) saveStatus.style.display = 'none';
                
                // Show saving indicator
                if (saveMessage) {
                    saveMessage.className = 'text-info';
                    saveMessage.innerHTML = '<i class="bi bi-hourglass-split me-1"></i><span>@Html.Raw(Localizer["Saving"] ?? "Saving...")</span>';
                    saveStatus.style.display = 'block';
                }
                
                // Auto-save the product type
                saveStep1Data(true); // Pass true to indicate auto-save (no success message)
            }
            
            // Toggle variant section visibility
            toggleVariantSection();
        }
        
        function toggleVariantSection() {
            const productType = document.getElementById('productTypeSelect').value;
            const variantSection = document.getElementById('variantManagementSection');
            const addOptionBtn = document.getElementById('addOptionBtn');
            const step1 = document.getElementById('step1');
            const step2 = document.getElementById('step2');
            const step2Number = document.getElementById('step2Number');
            const saveStep2Btn = document.getElementById('saveStep2Btn');
            
            if (productType === '1') {
                variantSection.style.display = 'block';
                step2.style.display = 'block';
                step2Number.classList.add('active');
                step2Number.classList.remove('completed');
                if (productId > 0) {
                    addOptionBtn.style.display = 'inline-block';
                    if (saveStep2Btn) saveStep2Btn.style.display = 'inline-block';
                }
                updateStepProgress();
            } else {
                variantSection.style.display = 'none';
                step2.style.display = 'none';
                step2Number.classList.remove('active', 'completed');
                if (saveStep2Btn) saveStep2Btn.style.display = 'none';
            }
        }

        function updateStepProgress() {
            // Step 2: Check if options exist and have values
            const step2 = document.getElementById('step2');
            const step2Number = document.getElementById('step2Number');
            const step3 = document.getElementById('step3');
            const step3Number = document.getElementById('step3Number');
            const step4 = document.getElementById('step4');
            const step4Number = document.getElementById('step4Number');

            // Check if all options have values
            const allOptionsHaveValues = options && options.length > 0 && 
                options.every(opt => opt.values && opt.values.length > 0);
            
            if (allOptionsHaveValues) {
                step2Number.classList.add('completed');
                step2Number.classList.remove('active');
                step3.style.display = 'block';
                step3Number.classList.add('active');
                step3Number.classList.remove('completed');
                const saveStep3Btn = document.getElementById('saveStep3Btn');
                if (saveStep3Btn && productId > 0) saveStep3Btn.style.display = 'inline-block';
            } else {
                step3.style.display = 'none';
                step4.style.display = 'none';
            }

            // Step 3: Check if variants exist
            if (variants && variants.length > 0) {
                step3Number.classList.add('completed');
                step3Number.classList.remove('active');
                step4.style.display = 'block';
                step4Number.classList.add('active');
                step4Number.classList.remove('completed');
                const saveStep4Btn = document.getElementById('saveStep4Btn');
                if (saveStep4Btn && productId > 0) saveStep4Btn.style.display = 'inline-block';
                
                // Ensure variants are rendered when step 4 is shown
                if (step4.style.display === 'block') {
                    renderVariants();
                }
            } else {
                step4.style.display = 'none';
                const saveStep4Btn = document.getElementById('saveStep4Btn');
                if (saveStep4Btn) saveStep4Btn.style.display = 'none';
            }
        }

        // Localized strings for JavaScript
        const localizations = {
            saveProductFirst: '@Html.Raw(Localizer["SaveProductFirst"])',
            pleaseSaveProductBeforeAddingOptions: '@Html.Raw(Localizer["PleaseSaveProductBeforeAddingOptions"])',
            addNewOption: '@Html.Raw(Localizer["AddNewOption"])',
            optionNameExample: '@Html.Raw(Localizer["OptionNameExample"])',
            enterOptionName: '@Html.Raw(Localizer["EnterOptionName"])',
            add: '@Html.Raw(Localizer["Add"])',
            cancel: '@Html.Raw(Localizer["Cancel"])',
