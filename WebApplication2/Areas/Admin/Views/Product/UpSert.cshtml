    /* ============================================
       Variant Management Enhanced Styles
       ============================================ */
    
    .variant-management-wrapper {
        margin-top: 2rem;
    }

    .admin-form-section-title {
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .section-title {
        color: #3B9DD5;
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .section-subtitle {
        color: #6c757d;
        font-size: 0.9rem;
        margin: 0.5rem 0 0 0;
    }

    .product-type-select {
        border-radius: 8px;
        border: 2px solid #dee2e6;
        transition: all 0.3s ease;
    }

    .product-type-select:focus {
        border-color: #3B9DD5;
        box-shadow: 0 0 0 0.2rem rgba(59, 157, 213, 0.25);
    }

    .form-help-text {
        display: flex;
        align-items: center;
        margin-top: 0.5rem;
        color: #6c757d;
        font-size: 0.875rem;
    }

    .form-help-text i {
        color: #3B9DD5;
    }

    /* Step-by-Step Wizard Styles */
    .variant-wizard {
        margin-top: 1.5rem;
    }

    .wizard-step {
        margin-bottom: 2rem;
        background: #ffffff;
        border-radius: 12px;
        border: 2px solid #e9ecef;
        padding: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .wizard-step::before {
        content: '';
