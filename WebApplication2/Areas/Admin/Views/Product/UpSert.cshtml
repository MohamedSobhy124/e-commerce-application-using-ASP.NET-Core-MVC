@model ProductVM

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h2 class="admin-form-title">
                    <i class="bi bi-@(Model.product.Id != 0 ? "pencil-square" : "plus-circle") me-3"></i>
                    @(Model.product.Id != 0 ? "Update" : "Create") Product
                </h2>
            </div>

            <div class="admin-form-body">
                <form asp-action="UpSert" enctype="multipart/form-data">
                    <input hidden asp-for="product.Id" />
                    <input hidden asp-for="product.ImageUrl" />

                    <div class="row">
                        <div class="col-lg-9 col-md-8">
                            <div class="admin-form-container">
                                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                                <div class="admin-form-group">
                                    <label asp-for="product.Title" class="admin-form-label">
                                        <i class="bi bi-card-heading me-2"></i>Title
                                    </label>
                                    <input asp-for="product.Title" class="admin-form-control" placeholder="Enter product title" />
                                    <span asp-validation-for="product.Title" class="text-danger"></span>
                                </div>

                                <div class="admin-form-group">
                                    <label asp-for="product.Description" class="admin-form-label">
                                        <i class="bi bi-text-paragraph me-2"></i>Description
                                    </label>
                                    <textarea asp-for="product.Description" class="admin-form-control" rows="4" placeholder="Enter product description"></textarea>
                                    <span asp-validation-for="product.Description" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.ISBN" class="admin-form-label">
                                                <i class="bi bi-upc me-2"></i>ISBN
                                            </label>
                                            <input asp-for="product.ISBN" class="admin-form-control" placeholder="Enter ISBN" />
                                            <span asp-validation-for="product.ISBN" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Author" class="admin-form-label">
                                                <i class="bi bi-person me-2"></i>Author
                                            </label>
                                            <input asp-for="product.Author" class="admin-form-control" placeholder="Enter author name" />
                                            <span asp-validation-for="product.Author" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.ListPrice" class="admin-form-label">
                                                <i class="bi bi-tag me-2"></i>List Price
                                            </label>
                                            <input asp-for="product.ListPrice" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.ListPrice" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>Price
                                            </label>
                                            <input asp-for="product.Price" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.Price" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price50" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>Price for 50+
                                            </label>
                                            <input asp-for="product.Price50" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.Price50" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price100" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>Price for 100+
                                            </label>
                                            <input asp-for="product.Price100" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.Price100" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="admin-form-group">
                                    <label asp-for="product.CategryId" class="admin-form-label">
                                        <i class="bi bi-folder me-2"></i>Category
                                    </label>
                                    <select asp-for="product.CategryId" asp-items="@Model.CategryList" class="admin-form-select">
                                        <option disabled selected>--- Select Category ---</option>
                                    </select>
                                    <span asp-validation-for="product.CategryId" class="text-danger"></span>
                                </div>

                                <div class="form-actions">
                                    @if (Model.product.Id != 0)
                                    {
                                        <button type="submit" class="btn btn-submit">
                                            <i class="bi bi-check-circle me-2"></i>
                                            Update Product
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-submit">
                                            <i class="bi bi-plus-circle me-2"></i>
                                            Create Product
                                        </button>
                                    }
                                    <a asp-action="Index" class="btn btn-back">
                                        <i class="bi bi-arrow-left me-2"></i>
                                        Back to List
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-4">
                            <div class="image-upload-wrapper">
                                <label for="file-input" class="upload-button">
                                    <span class="upload-icon">
                                        <i class="bi bi-cloud-upload"></i>
                                    </span>
                                    <span>Upload Image</span>
                                    <input id="file-input" type="file" onchange="previewImage(event)" name="file" class="file-input" accept="image/*" />
                                </label>

                                <img src="@Model.product.ImageUrl" id="preview" class="image-preview" alt="Product Image Preview" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        function previewImage(event) {
            var input = event.target;
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('preview');
                output.src = reader.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
