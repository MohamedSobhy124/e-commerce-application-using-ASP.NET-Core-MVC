@model ProductVM

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h2 class="admin-form-title">
                    <i class="bi bi-@(Model.product.Id != 0 ? "pencil-square" : "plus-circle") me-3"></i>
                    @(Model.product.Id != 0 ? "Update" : "Create") Product
                </h2>
            </div>

            <div class="admin-form-body">
                <form asp-action="UpSert" enctype="multipart/form-data">
                    <input hidden asp-for="product.Id" />
                    <input hidden asp-for="product.ImageUrl" />

                    <div class="row">
                        <div class="col-lg-9 col-md-8">
                            <div class="admin-form-container">
                                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                                <div class="admin-form-group">
                                    <label asp-for="product.Title" class="admin-form-label">
                                        <i class="bi bi-card-heading me-2"></i>Title
                                    </label>
                                    <input asp-for="product.Title" class="admin-form-control" placeholder="Enter product title" />
                                    <span asp-validation-for="product.Title" class="text-danger"></span>
                                </div>

                                <div class="admin-form-group">
                                    <label asp-for="product.Description" class="admin-form-label">
                                        <i class="bi bi-text-paragraph me-2"></i>Description
                                    </label>
                                    <textarea asp-for="product.Description" class="admin-form-control" rows="4" placeholder="Enter product description"></textarea>
                                    <span asp-validation-for="product.Description" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.ISBN" class="admin-form-label">
                                                <i class="bi bi-upc me-2"></i>ISBN
                                            </label>
                                            <input asp-for="product.ISBN" class="admin-form-control" placeholder="Enter ISBN" />
                                            <span asp-validation-for="product.ISBN" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Author" class="admin-form-label">
                                                <i class="bi bi-person me-2"></i>Author
                                            </label>
                                            <input asp-for="product.Author" class="admin-form-control" placeholder="Enter author name" />
                                            <span asp-validation-for="product.Author" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.ListPrice" class="admin-form-label">
                                                <i class="bi bi-tag me-2"></i>List Price
                                            </label>
                                            <input asp-for="product.ListPrice" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.ListPrice" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>Price
                                            </label>
                                            <input asp-for="product.Price" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.Price" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price50" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>Price for 50+
                                            </label>
                                            <input asp-for="product.Price50" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.Price50" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.Price100" class="admin-form-label">
                                                <i class="bi bi-currency-dollar me-2"></i>Price for 100+
                                            </label>
                                            <input asp-for="product.Price100" class="admin-form-control" type="number" step="0.01" placeholder="0.00" />
                                            <span asp-validation-for="product.Price100" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Stock Management Section -->
                                <div class="admin-form-section-title" style="margin-top: 2rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e5e7eb;">
                                    <h4 style="color: #3B9DD5; font-weight: 700;">
                                        <i class="bi bi-box-seam me-2"></i>Stock Management
                                    </h4>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.StockQuantity" class="admin-form-label">
                                                <i class="bi bi-boxes me-2"></i>Stock Quantity
                                            </label>
                                            <input asp-for="product.StockQuantity" class="admin-form-control" type="number" min="0" placeholder="Enter available stock" />
                                            <span asp-validation-for="product.StockQuantity" class="text-danger"></span>
                                            <small class="form-text text-muted">
                                                <i class="bi bi-info-circle me-1"></i>Current quantity in stock
                                            </small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="admin-form-group">
                                            <label asp-for="product.MinimumStockAlert" class="admin-form-label">
                                                <i class="bi bi-exclamation-triangle me-2"></i>Low Stock Alert Level
                                            </label>
                                            <input asp-for="product.MinimumStockAlert" class="admin-form-control" type="number" min="0" placeholder="Set alert threshold" />
                                            <span asp-validation-for="product.MinimumStockAlert" class="text-danger"></span>
                                            <small class="form-text text-muted">
                                                <i class="bi bi-info-circle me-1"></i>Show warning when stock falls to this level
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div class="admin-form-group">
                                    <label asp-for="product.CategryId" class="admin-form-label">
                                        <i class="bi bi-folder me-2"></i>Category
                                    </label>
                                    <select asp-for="product.CategryId" asp-items="@Model.CategryList" class="admin-form-select">
                                        <option disabled selected>--- Select Category ---</option>
                                    </select>
                                    <span asp-validation-for="product.CategryId" class="text-danger"></span>
                                </div>

                                <div class="form-actions">
                                    @if (Model.product.Id != 0)
                                    {
                                        <button type="submit" class="btn btn-submit">
                                            <i class="bi bi-check-circle me-2"></i>
                                            Update Product
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-submit">
                                            <i class="bi bi-plus-circle me-2"></i>
                                            Create Product
                                        </button>
                                    }
                                    <a asp-action="Index" class="btn btn-back">
                                        <i class="bi bi-arrow-left me-2"></i>
                                        Back to List
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-4">
                            <div class="image-upload-wrapper">
                                <h5 class="mb-3" style="color: #1976D2; font-weight: 700;">
                                    <i class="bi bi-images me-2"></i>Product Images
                                </h5>
                                
                                <!-- Upload Multiple Images -->
                                <label for="files-input" class="upload-button" style="display: block; text-align: center; padding: 1rem; background: linear-gradient(135deg, #3B9DD5, #7BC043); color: white; border-radius: 10px; cursor: pointer; margin-bottom: 1.5rem;">
                                    <span class="upload-icon">
                                        <i class="bi bi-cloud-upload" style="font-size: 1.5rem;"></i>
                                    </span>
                                    <span style="display: block; margin-top: 0.5rem; font-weight: 600;">Upload Images</span>
                                    <small style="display: block; margin-top: 0.25rem; opacity: 0.9;">(At least 1 required)</small>
                                    <input id="files-input" type="file" name="files" class="file-input" accept="image/*" multiple style="display: none;" />
                                </label>

                                <!-- Existing Images Gallery -->
                                <div id="images-gallery" class="images-gallery">
                                    @if (Model.product.ProductImages != null && Model.product.ProductImages.Any())
                                    {
                                        @foreach (var image in Model.product.ProductImages.OrderBy(pi => pi.DisplayOrder))
                                        {
                                            <div class="image-item" data-image-id="@image.Id">
                                                <img src="@image.ImageUrl" alt="Product Image" class="gallery-image" />
                                                <button type="button" class="delete-image-btn" onclick="deleteImage(@image.Id, this)" title="Delete Image">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(Model.product.ImageUrl))
                                    {
                                        <div class="image-item" data-image-id="0">
                                            <img src="@Model.product.ImageUrl" alt="Product Image" class="gallery-image" />
                                            <span class="main-image-badge">Main</span>
                                        </div>
                                    }
                                </div>

                                <!-- Preview for new images -->
                                <div id="preview-container" class="preview-container mt-3"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        // Preview multiple images
        document.getElementById('files-input')?.addEventListener('change', function(e) {
            const previewContainer = document.getElementById('preview-container');
            previewContainer.innerHTML = '';
            
            if (this.files && this.files.length > 0) {
                Array.from(this.files).forEach((file, index) => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = 'preview-image-item';
                        div.innerHTML = `
                            <img src="${e.target.result}" alt="Preview ${index + 1}" class="preview-image" />
                            <span class="preview-badge">New</span>
                        `;
                        previewContainer.appendChild(div);
            };
                    reader.readAsDataURL(file);
                });
            }
        });

        // Delete image function
        function deleteImage(imageId, button) {
            Swal.fire({
                title: 'Delete Image',
                text: 'Are you sure you want to delete this image?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, Delete It',
                cancelButtonText: 'Cancel',
                dangerMode: true
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

            const imageItem = button.closest('.image-item');
            
            fetch('/Admin/Product/DeleteImage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ imageId: imageId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    imageItem.remove();
                    
                    // Check if any images remain
                    const remainingImages = document.querySelectorAll('.image-item').length;
                    if (remainingImages === 0) {
                        const gallery = document.getElementById('images-gallery');
                        if (gallery) {
                            gallery.innerHTML = '<p class="text-muted text-center">No images. Please upload at least one image.</p>';
                        }
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Error deleting image: ' + (data.message || 'Unknown error')
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error deleting image. Please try again.'
                });
            });
            });
        }
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

<style>
    .images-gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .image-item {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid #e0e0e0;
        transition: all 0.3s ease;
    }

    .image-item:hover {
        border-color: #3B9DD5;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .gallery-image {
        width: 100%;
        height: 120px;
        object-fit: cover;
        display: block;
    }

    .delete-image-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(220, 53, 69, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .delete-image-btn:hover {
        background: #dc3545;
        transform: scale(1.1);
    }

    .main-image-badge {
        position: absolute;
        bottom: 5px;
        left: 5px;
        background: rgba(59, 157, 213, 0.9);
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .preview-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
    }

    .preview-image-item {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 2px dashed #7BC043;
    }

    .preview-image {
        width: 100%;
        height: 80px;
        object-fit: cover;
    }

    .preview-badge {
        position: absolute;
        top: 5px;
        right: 5px;
        background: #7BC043;
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .images-gallery {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
