        // VALIDATION: Validate required fields before saving
        function validateProductForm() {
            const errors = [];
            const errorFields = [];
            
            // Clear previous validation errors
            document.querySelectorAll('.field-error').forEach(el => el.remove());
            document.querySelectorAll('.admin-form-control.is-invalid').forEach(el => {
                el.classList.remove('is-invalid');
            });
            
            // Validate Title (Required)
            const titleInput = document.querySelector('input[name="product.Title"]');
            const titleLabel = '@Html.Raw(Localizer["Title"])';
            if (!titleInput || !titleInput.value || titleInput.value.trim() === '') {
                errors.push(titleLabel + ' ' + localizations.isRequired);
                errorFields.push({ field: titleInput, message: titleLabel + ' ' + localizations.isRequired });
            }
            
            // Validate Description (Required)
            const descriptionInput = document.querySelector('textarea[name="product.Description"]');
            const descriptionLabel = '@Html.Raw(Localizer["Description"])';
            if (!descriptionInput || !descriptionInput.value || descriptionInput.value.trim() === '') {
                errors.push(descriptionLabel + ' ' + localizations.isRequired);
                errorFields.push({ field: descriptionInput, message: descriptionLabel + ' ' + localizations.isRequired });
            }
            
            // Validate Price (Required)
            const priceInput = document.querySelector('input[name="product.Price"]');
            const priceLabel = '@Html.Raw(Localizer["Price"])';
            if (!priceInput || !priceInput.value || priceInput.value.trim() === '' || parseFloat(priceInput.value) < 0) {
                errors.push(priceLabel + ' ' + localizations.isRequired);
                errorFields.push({ field: priceInput, message: priceLabel + ' ' + localizations.isRequired });
            }
            
            // Validate ListPrice (Required)
            const listPriceInput = document.querySelector('input[name="product.ListPrice"]');
            const listPriceLabel = '@Html.Raw(Localizer["ListPrice"])';
            if (!listPriceInput || !listPriceInput.value || listPriceInput.value.trim() === '' || parseFloat(listPriceInput.value) < 0) {
                errors.push(listPriceLabel + ' ' + localizations.isRequired);
                errorFields.push({ field: listPriceInput, message: listPriceLabel + ' ' + localizations.isRequired });
            }
            
            // Validate Category (Required)
            const categorySelect = document.querySelector('select[name="product.CategryId"]');
            const categoryLabel = '@Html.Raw(Localizer["Category"])';
            if (!categorySelect || !categorySelect.value || categorySelect.value === '' || categorySelect.value === '0') {
                errors.push(categoryLabel + ' ' + localizations.isRequired);
                errorFields.push({ field: categorySelect, message: categoryLabel + ' ' + localizations.isRequired });
            }
            
            // Validate ProductType (Required)
            const productTypeSelect = document.querySelector('select[name="product.ProductType"]');
            const productTypeLabel = '@Html.Raw(Localizer["ProductType"])';
            if (!productTypeSelect || productTypeSelect.value === null || productTypeSelect.value === undefined) {
                errors.push(productTypeLabel + ' ' + localizations.isRequired);
                errorFields.push({ field: productTypeSelect, message: productTypeLabel + ' ' + localizations.isRequired });
            }
            
            // Validate Images (Required for new products)
            if (productId === 0) {
                const fileInput = document.getElementById('files-input');
                const existingImages = document.querySelectorAll('#images-gallery .image-item').length;
                if ((!fileInput || !fileInput.files || fileInput.files.length === 0) && existingImages === 0) {
                    errors.push(localizations.atLeastOneImageRequired);
                }
            }
            
            // Display errors
            if (errors.length > 0) {
                // Show error messages for each field
                errorFields.forEach(({ field, message }) => {
                    if (field) {
                        field.classList.add('is-invalid');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'field-error text-danger mt-1';
                        errorDiv.style.fontSize = '0.875rem';
                        errorDiv.style.fontWeight = '600';
                        errorDiv.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>' + message;
                        field.parentElement.appendChild(errorDiv);
                    }
                });
                
                // Scroll to first error
                if (errorFields.length > 0 && errorFields[0].field) {
                    errorFields[0].field.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    errorFields[0].field.focus();
                }
                
                // Show summary alert
                Swal.fire({
                    icon: 'error',
                    title: localizations.validationError,
                    html: '<div style="text-align: left;"><strong>' + localizations.pleaseFillRequiredFields + '</strong><ul style="margin-top: 1rem; padding-left: 1.5rem;">' +
                          errors.map(err => '<li>' + err + '</li>').join('') +
                          '</ul></div>',
                    confirmButtonText: localizations.ok,
                    confirmButtonColor: '#3B9DD5'
                });
                
                return false;
            }
            
            return true;
        }

        // Save Main Product (stays on same page)
        function saveMainProduct() {
            console.log('saveMainProduct called');
            
            // VALIDATION: Validate form before saving
            if (!validateProductForm()) {
                return false;
            }
            
            const form = document.getElementById('productForm') || document.querySelector('form');
            if (!form) {
                console.error('Form not found');
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: 'Form not found'
                });
                return false;
            }

            // Check for anti-forgery token
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenInput) {
                console.error('Anti-forgery token not found');
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: 'Security token not found. Please refresh the page.'
                });
                return false;
            }

            console.log('Preparing form data...');
            const formData = new FormData(form);
            formData.append('saveOnly', 'true'); // Flag to indicate AJAX save

            Swal.fire({
                title: localizations.generating,
                text: 'Saving product...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const formAction = form.getAttribute('action') || '/Admin/Product/UpSert';
            console.log('Sending request to:', formAction);
            
            fetch(formAction, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin', // Include cookies for authentication
                headers: {
                    'X-Requested-With': 'XMLHttpRequest' // Identify as AJAX request
                }
            })
            .then(response => {
                console.log('Response received:', response.status, response.statusText);
                console.log('Response redirected:', response.redirected);
                console.log('Response URL:', response.url);
                
                // Check if we got redirected (authentication issue)
                if (response.redirected) {
                    console.error('Response was redirected - likely authentication issue');
                    Swal.close();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Authentication Required',
                        text: 'Your session may have expired. Please refresh the page and try again.',
                        confirmButtonText: 'Refresh Page',
                        allowOutsideClick: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.reload();
                        }
                    });
                    return Promise.reject(new Error('Authentication required - redirected'));
                }
                
                if (response.status === 302 || response.status === 401 || response.status === 403) {
                    console.error('Authentication error:', response.status);
                    Swal.close();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Authentication Required',
                        text: 'Your session may have expired. Please refresh the page and try again.',
                        confirmButtonText: 'Refresh Page',
                        allowOutsideClick: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.reload();
                        }
                    });
                    return Promise.reject(new Error('Authentication required'));
                }

                const contentType = response.headers.get("content-type");
                console.log('Content-Type:', contentType);
                
                if (contentType && contentType.includes("application/json")) {
                    return response.json();
                } else if (response.ok) {
                    // If response is OK but not JSON, try to parse as text
                    return response.text().then(text => {
                        console.log('Response text (first 200 chars):', text.substring(0, 200));
                        // Check if it's HTML (likely a redirect or error page)
                        if (text.trim().startsWith('<!DOCTYPE') || text.trim().startsWith('<html')) {
                            console.error('Received HTML instead of JSON - likely a redirect');
                            throw new Error('Received HTML response instead of JSON. This may indicate a redirect or error.');
                        }
                        // Try to parse as JSON anyway
                        try {
                            return JSON.parse(text);
                        } catch {
                            throw new Error('Unexpected response format');
                        }
                    });
                } else {
                    return response.text().then(text => {
                        console.error('Server error:', response.status, text);
                        throw new Error(`Server error: ${response.status} ${response.statusText}`);
                    });
                }
            })
            .then(data => {
                Swal.close();
                if (data && data.success) {
                    const newProductId = data.productId;
                    const wasNewProduct = productId === 0;
                    
                    productId = newProductId;
                    const idInput = document.querySelector('input[name="product.Id"]');
                    if (idInput) {
                        idInput.value = productId;
                    }
                    
                    // If this was a new product creation, reload the page with the new ID
                    if (wasNewProduct && newProductId > 0) {
                        Swal.fire({
                            icon: 'success',
                            title: localizations.success,
                            text: data.message || 'Product created successfully!',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            // Reload the page with the new product ID in the URL
                            window.location.href = `/Admin/Product/UpSert?id=${newProductId}`;
                        });
                        return;
                    }
                    
                    // For existing products, just show success and stay on page
                    // Show Step 1 save button after product is saved
                    const step1Actions = document.getElementById('step1Actions');
                    if (step1Actions) step1Actions.style.display = 'block';
                    
                    // Show add option button if variable product
                    const productType = document.getElementById('productTypeSelect').value;
                    if (productType === '1') {
                        const addOptionBtn = document.getElementById('addOptionBtn');
                        if (addOptionBtn) addOptionBtn.style.display = 'inline-block';
                    }
                    
                    Swal.fire({
                        icon: 'success',
                        title: localizations.success,
                        text: data.message || 'Product updated successfully!',
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: (data && data.message) || 'Failed to save product'
                    });
                }
            })
            .catch(error => {
                Swal.close();
                console.error('Error saving product:', error);
                
                // Don't show error if user already saw authentication message
                if (error.message && error.message.includes('Authentication required')) {
                    return;
                }
                
                Swal.fire({
                    icon: 'error',
                    title: localizations.error,
                    text: error.message || 'Failed to save product. Please check all required fields are filled and try again.'
                });
            });
        }

        // Save Step Functions
        // Manual save function (kept for backward compatibility, but auto-save is now enabled)
        function saveStep1() {
            // Check if productId is valid
            if (!productId || productId === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: localizations.error,
                    text: localizations.pleaseSaveProductFirst || 'Please save the product first before saving this step.'
                });
                return;
            }
            
            saveStep1Data(false); // false = manual save (show SweetAlert)
        }

        function saveStep1Data(isAutoSave = false) {
            // Double check productId is valid
            if (!productId || productId === 0) {
                console.error('Invalid productId:', productId);
                if (!isAutoSave) {
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: 'Product ID is missing. Please save the product first.'
                    });
                }
                return;
            }
            
            const productType = document.getElementById('productTypeSelect').value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('productType', productType);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            console.log('Saving Step 1 - productId:', productId, 'productType:', productType, 'isAutoSave:', isAutoSave);

            fetch('/Admin/Product/SaveProductStep', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                console.log('SaveProductStep response status:', response.status);
                if (!response.ok) {
                    return response.text().then(text => {
                        console.error('Error response:', text);
                        throw new Error(`Server error: ${response.status}`);
                    });
                }
                return response.json();
            })
            .then(data => {
                console.log('SaveProductStep response data:', data);
                if (data && data.success) {
                    // Update step number visual indicator
                    const step1Number = document.querySelector('#step1 .step-number');
                    if (step1Number) {
                        step1Number.classList.add('completed');
                        step1Number.classList.remove('active');
                    }
                    
                    if (isAutoSave) {
                        // For auto-save, show subtle success message
                        const saveStatus = document.getElementById('productTypeSaveStatus');
                        const saveMessage = document.getElementById('productTypeSaveMessage');
                        if (saveStatus && saveMessage) {
                            saveMessage.className = 'text-success';
                            saveMessage.innerHTML = '<i class="bi bi-check-circle me-1"></i><span>@Html.Raw(Localizer["Saved"] ?? "Saved")</span>';
                            saveStatus.style.display = 'block';
                            
                            // Hide the message after 3 seconds
                            setTimeout(() => {
                                if (saveStatus) saveStatus.style.display = 'none';
                            }, 3000);
                        }
                    } else {
                        // For manual save, show SweetAlert
                        Swal.fire({
                            icon: 'success',
                            title: localizations.success,
                            text: data.message || localizations.stepSavedSuccessfully,
                            timer: 2000,
                            showConfirmButton: false
                        });
                    }
                } else {
                    // Show error message
                    const saveStatus = document.getElementById('productTypeSaveStatus');
                    const saveMessage = document.getElementById('productTypeSaveMessage');
                    if (saveStatus && saveMessage && isAutoSave) {
                        saveMessage.className = 'text-danger';
                        saveMessage.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i><span>@Html.Raw(Localizer["SaveFailed"] ?? "Save failed")</span>';
                        saveStatus.style.display = 'block';
                    } else if (!isAutoSave) {
                        Swal.fire({
                            icon: 'error',
                            title: localizations.error,
                            text: (data && data.message) || localizations.failedToSaveStep
                        });
                    }
                }
            })
            .catch(error => {
                console.error('Error saving step:', error);
                
                // Show error in status message for auto-save
                const saveStatus = document.getElementById('productTypeSaveStatus');
                const saveMessage = document.getElementById('productTypeSaveMessage');
                if (saveStatus && saveMessage && isAutoSave) {
                    saveMessage.className = 'text-danger';
                    saveMessage.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i><span>@Html.Raw(Localizer["SaveFailed"] ?? "Save failed")</span>';
                    saveStatus.style.display = 'block';
                } else if (!isAutoSave) {
                    Swal.fire({
                        icon: 'error',
                        title: localizations.error,
                        text: error.message || localizations.failedToSaveStep
                    });
                }
            });
        }

