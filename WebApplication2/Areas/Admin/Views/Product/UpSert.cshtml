    .step-header {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .step-number {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        flex-shrink: 0;
        transition: all 0.3s ease;
        border: 3px solid transparent;
    }

    .step-number.active {
        background: linear-gradient(135deg, #3B9DD5, #7BC043);
        color: white;
        border-color: #3B9DD5;
        box-shadow: 0 4px 12px rgba(59, 157, 213, 0.3);
        transform: scale(1.1);
    }

    .step-number.completed {
        background: #7BC043;
        color: white;
        border-color: #7BC043;
    }

    .step-number.completed::after {
        content: '✓';
        font-size: 1.2rem;
    }

    .step-content {
        flex: 1;
    }

    .step-title {
        color: #212529;
        font-weight: 700;
        font-size: 1.25rem;
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
    }

    .step-title i {
        color: #3B9DD5;
        font-size: 1.5rem;
    }

    .step-description {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    .step-body {
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .step-info-box {
        background: linear-gradient(135deg, #e3f2fd 0%, #f1f8ff 100%);
        border-left: 4px solid #3B9DD5;
        padding: 1rem 1.25rem;
        border-radius: 8px;
        margin: 1rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .step-info-box i {
        color: #3B9DD5;
        font-size: 1.25rem;
    }

    .step-info-box span {
        color: #495057;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .generate-variants-section {
        text-align: center;
        padding: 2rem;
    }

