@model FlashSale

@{
    ViewData["Title"] = Localizer["CreateFlashSale"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h2 class="admin-form-title">
                    <i class="bi bi-lightning-charge-fill me-3"></i>
                    @Localizer["CreateNewFlashSale"]
                </h2>
            </div>

            <div class="admin-form-body">
                <form asp-action="Create" method="post">
                    <input hidden asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Flash Sale Information -->
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                @Localizer["FlashSaleInformation"]
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Name -->
                            <div class="admin-form-group">
                                <label class="admin-form-label">
                                    <i class="bi bi-tag me-2"></i>@Localizer["FlashSaleName"]
                                    <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name" class="admin-form-control" placeholder="@Localizer["ExampleFlashSaleName"]" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @Localizer["GiveCatchyName"]
                                </small>
                            </div>

                            <!-- Description -->
                            <div class="admin-form-group">
                                <label class="admin-form-label">
                                    <i class="bi bi-text-paragraph me-2"></i>@Localizer["Description"]
                                </label>
                                <textarea asp-for="Description" class="admin-form-control" rows="3" placeholder="@Localizer["DescribeFlashSale"]"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @Localizer["OptionalDescription"]
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Date & Time Settings -->
                    <div class="card mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-event me-2"></i>
                                @Localizer["Schedule"]
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info">
                                <i class="bi bi-lightbulb me-2"></i>
                                <strong>@Localizer["Tip"]:</strong> @Localizer["SetTimesCarefully"]
                            </div>

                            <div class="row">
                                <!-- Start Date & Time -->
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label class="admin-form-label">
                                            <i class="bi bi-calendar-check text-success me-2"></i>@Localizer["StartDateTime"]
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="StartDate" type="datetime-local" class="admin-form-control" />
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                        <small class="form-text text-muted">
                                            @Localizer["WhenFlashSaleStarts"]
                                        </small>
                                    </div>
                                </div>

                                <!-- End Date & Time -->
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label class="admin-form-label">
                                            <i class="bi bi-calendar-x text-danger me-2"></i>@Localizer["EndDateTime"]
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="EndDate" type="datetime-local" class="admin-form-control" />
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                        <small class="form-text text-muted">
                                            @Localizer["WhenFlashSaleEnds"]
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Duration Display -->
                       @*      <div class="alert alert-secondary mt-3" id="durationAlert" style="display: none;">
                                <i class="bi bi-clock me-2"></i>
                                <strong>Duration:</strong> <span id="durationText"></span>
                            </div> *@
                        </div>
                    </div>

                    <!-- Active Status -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" style="width: 3rem; height: 1.5rem;" checked />
                                <label class="form-check-label ms-2" style="font-size: 1.1rem; font-weight: 600;">
                                    <i class="bi bi-toggle-on text-success me-2"></i>
                                    @Localizer["ActiveBasedOnSchedule"]
                                </label>
                            </div>
                            <small class="form-text text-muted ms-5">
                                <i class="bi bi-info-circle me-1"></i>
                                @Localizer["CanDeactivateLater"]
                            </small>
                        </div>
                    </div>

                    <!-- Notify Subscribers -->
                    <div class="card mb-4 border-info">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-envelope-heart me-2"></i>
                                @Localizer["NotifySubscribers"]
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" id="notifySubscribers" name="notifySubscribers" style="width: 3rem; height: 1.5rem;" />
                                <label class="form-check-label ms-2" for="notifySubscribers" style="font-size: 1.1rem; font-weight: 600;">
                                    <i class="bi bi-bell-fill text-primary me-2"></i>
                                    @Localizer["SendToAllSubscribers"]
                                </label>
                            </div>
                            <small class="form-text text-muted ms-5">
                                <i class="bi bi-info-circle me-1"></i>
                                @Localizer["SendFlashSaleNotificationToSubscribers"]
                            </small>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>
                            @Localizer["CreateFlashSale"]
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle me-2"></i>
                            @Localizer["Cancel"]
                        </a>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>@Localizer["NextStep"]:</strong> @Localizer["AfterCreatingAddProducts"]
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        // Calculate and display duration
        function updateDuration() {
            const startInput = document.querySelector('input[name="StartDate"]');
            const endInput = document.querySelector('input[name="EndDate"]');
            const durationAlert = document.getElementById('durationAlert');
            const durationText = document.getElementById('durationText');

            if (startInput.value && endInput.value) {
                const start = new Date(startInput.value);
                const end = new Date(endInput.value);
                const diff = end - start;

                if (diff > 0) {
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

                    let durationStr = '';
                    if (days > 0) durationStr += days + ' @Localizer["day"]' + (days > 1 ? '@Localizer["s"]' : '') + ' ';
                    if (hours > 0) durationStr += hours + ' @Localizer["hour"]' + (hours > 1 ? '@Localizer["s"]' : '') + ' ';
                    if (minutes > 0) durationStr += minutes + ' @Localizer["minute"]' + (minutes > 1 ? '@Localizer["s"]' : '');

                    durationText.textContent = durationStr.trim();
                    durationAlert.style.display = 'block';
                } else {
                    durationAlert.style.display = 'none';
                }
            }
        }

        document.querySelector('input[name="StartDate"]').addEventListener('change', updateDuration);
        document.querySelector('input[name="EndDate"]').addEventListener('change', updateDuration);

        // Initial calculation
        updateDuration();
    </script>
}


