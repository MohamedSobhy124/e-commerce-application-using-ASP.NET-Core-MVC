@model FlashSale

@{
    ViewData["Title"] = "Flash Sale Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var now = DateTime.Now;
    var isActive = Model.IsActive && now >= Model.StartDate && now <= Model.EndDate;
    var hasStarted = now >= Model.StartDate;
    var hasEnded = now > Model.EndDate;
    var totalProducts = Model.FlashSaleItems?.Count ?? 0;
    var totalQtyCreated = Model.FlashSaleItems?.Sum(i => i.FlashSaleQuantityCreated) ?? 0;
    var totalQty = Model.FlashSaleItems?.Sum(i => i.FlashSaleQuantity) ?? 0;
    var totalValue = Model.FlashSaleItems?.Sum(i => i.FlashSalePrice * i.FlashSaleQuantity) ?? 0;
}

<div class="admin-wrapper">
    <div class="container-fluid">
        <div class="admin-form-wrapper" style="max-width: 1400px;">
            <div class="admin-form-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="admin-form-title mb-2">
                            <i class="bi bi-lightning-charge-fill me-3"></i>
                            @Model.Name
                        </h2>
                        <p class="text-muted mb-0">Flash Sale Details</p>
                    </div>
                    <div>
                        @if (!Model.IsActive)
                        {
                            <span class="badge bg-secondary fs-5 px-4 py-2">
                                <i class="bi bi-pause-circle me-2"></i>Inactive
                            </span>
                        }
                        else if (hasEnded)
                        {
                            <span class="badge bg-danger fs-5 px-4 py-2">
                                <i class="bi bi-x-circle me-2"></i>Ended
                            </span>
                        }
                        else if (isActive)
                        {
                            <span class="badge bg-success fs-5 px-4 py-2">
                                <i class="bi bi-lightning-charge-fill me-2"></i>Active Now
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning fs-5 px-4 py-2">
                                <i class="bi bi-clock me-2"></i>Scheduled
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="admin-form-body">
                <!-- Flash Sale Info Card -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Flash Sale Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width: 40%;"><i class="bi bi-tag me-2 text-primary"></i>Name:</td>
                                        <td>@Model.Name</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold"><i class="bi bi-text-paragraph me-2 text-primary"></i>Description:</td>
                                        <td>@(string.IsNullOrEmpty(Model.Description) ? "N/A" : Model.Description)</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold"><i class="bi bi-calendar-check me-2 text-success"></i>Start Date:</td>
                                        <td>@Model.StartDate.ToString("dddd, MMMM dd, yyyy HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold"><i class="bi bi-calendar-x me-2 text-danger"></i>End Date:</td>
                                        <td>@Model.EndDate.ToString("dddd, MMMM dd, yyyy HH:mm")</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <div class="stats-grid">
                                    <div class="stat-card bg-gradient-primary">
                                        <i class="bi bi-box-seam"></i>
                                        <div class="stat-value">@totalProducts</div>
                                        <div class="stat-label">Products</div>
                                    </div>
                                    <div class="stat-card bg-gradient-success">
                                        <i class="bi bi-hash"></i>
                                        <div class="stat-value">@totalQtyCreated</div>
                                        <div class="stat-label">Total Quantity Created</div>
                                    </div><div class="stat-card bg-gradient-success">
                                        <i class="bi bi-hash"></i>
                                        <div class="stat-value">@totalQty</div>
                                        <div class="stat-label">Total Quantity</div>
                                    </div>
                                    <div class="stat-card bg-gradient-info">
                                        <i class="bi bi-currency-dollar"></i>
                                        <div class="stat-value">$@totalValue.ToString("N2")</div>
                                        <div class="stat-label">Total Value</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Products List -->
                <div class="card mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2"></i>
                            Products in This Flash Sale
                            <span class="badge bg-light text-dark ms-2">@totalProducts</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (totalProducts == 0)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                                <h4 class="mt-3 text-muted">No Products in This Flash Sale</h4>
                                <a asp-action="AddProducts" asp-route-id="@Model.Id" class="btn btn-primary mt-3">
                                    <i class="bi bi-plus-circle me-2"></i>Add Products Now
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 5%;">#</th>
                                            <th style="width: 35%;">Product</th>
                                            <th style="width: 15%;">Normal Price</th>
                                            <th style="width: 15%;">Flash Price</th>
                                            <th style="width: 10%;">Discount</th>
                                            <th style="width: 10%;">Quantity</th>
                                            <th style="width: 10%;">Total Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int index = 1;
                                        }
                                        @foreach (var item in Model.FlashSaleItems)
                                        {
                                            var discount = item.Product != null && item.Product.Price > 0
                                                ? Math.Round(((item.Product.Price - (double)item.FlashSalePrice) / item.Product.Price) * 100, 0)
                                                : 0;
                                            var totalItemValue = item.FlashSalePrice * item.FlashSaleQuantity;

                                            <tr>
                                                <td>@index</td>
                                                <td>
                                                    <strong>@item.Product?.Title</strong><br />
                                                    <small class="text-muted">
                                                        <i class="bi bi-box me-1"></i>Stock: @item.Product?.StockQuantity units
                                                    </small>
                                                </td>
                                                <td>
                                                    <span class="text-muted text-decoration-line-through">
                                                        $@item.Product?.Price.ToString("N2")
                                                    </span>
                                                </td>
                                                <td>
                                                    <strong style="color: #ef4444; font-size: 1.1rem;">
                                                        $@item.FlashSalePrice.ToString("N2")
                                                    </strong>
                                                </td>
                                                <td>
                                                    <span class="badge bg-success">-@discount%</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary">@item.FlashSaleQuantity</span>
                                                </td>
                                                <td>
                                                    <strong>$@totalItemValue.ToString("N2")</strong>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="6" class="text-end fw-bold">Total Flash Sale Value:</td>
                                            <td class="fw-bold" style="color: #3B9DD5; font-size: 1.2rem;">
                                                $@totalValue.ToString("N2")
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="form-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg">
                        <i class="bi bi-pencil me-2"></i>
                        Edit Flash Sale
                    </a>
                    <a asp-action="AddProducts" asp-route-id="@Model.Id" class="btn btn-success btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>
                        Manage Products
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
    }

    .stat-card {
        text-align: center;
        padding: 1.5rem;
        border-radius: 12px;
        color: white;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .stat-card i {
        font-size: 2rem;
        opacity: 0.8;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        margin: 0.5rem 0;
    }

    .stat-label {
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #3B9DD5 0%, #1976D2 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #7BC043 0%, #558B2F 100%);
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #17a2b8 0%, #117a8b 100%);
    }
</style>



