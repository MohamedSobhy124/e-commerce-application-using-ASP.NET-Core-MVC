@model IEnumerable<FlashSale>

@{
    ViewData["Title"] = "Flash Sales Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_Notifications" />
@Html.AntiForgeryToken()

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-lightning-charge-fill me-3"></i>
                    Flash Sales Management
                </h2>
            </div>

            <div class="admin-card-body">
                <div class="text-end mb-4">
                    <a asp-action="Create" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>
                        Create New Flash Sale
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center py-5">
                        <i class="bi bi-info-circle" style="font-size: 3rem; color: #3B9DD5;"></i>
                        <h4 class="mt-3">No Flash Sales Yet</h4>
                        <p class="mb-3">Create your first flash sale to boost sales and create urgency!</p>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Create First Flash Sale
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var flashSale in Model)
                        {
                            var now = DateTime.Now;
                            var isActive = flashSale.IsActive && now >= flashSale.StartDate && now <= flashSale.EndDate;
                            var hasStarted = now >= flashSale.StartDate;
                            var hasEnded = now > flashSale.EndDate;
                            var itemCount = flashSale.FlashSaleItems?.Count ?? 0;
                            var totalQty = flashSale.FlashSaleItems?.Sum(i => i.FlashSaleQuantity) ?? 0;

                            string statusBadge = "";
                            string statusIcon = "";
                            string cardBorder = "";

                            if (!flashSale.IsActive)
                            {
                                statusBadge = "bg-secondary";
                                statusIcon = "bi-pause-circle";
                                cardBorder = "border-secondary";
                            }
                            else if (hasEnded)
                            {
                                statusBadge = "bg-danger";
                                statusIcon = "bi-x-circle";
                                cardBorder = "border-danger";
                            }
                            else if (isActive)
                            {
                                statusBadge = "bg-success";
                                statusIcon = "bi-lightning-charge-fill";
                                cardBorder = "border-success";
                            }
                            else
                            {
                                statusBadge = "bg-warning";
                                statusIcon = "bi-clock";
                                cardBorder = "border-warning";
                            }

                            <div class="col-md-6 col-lg-4">
                                <div class="card flash-sale-card @cardBorder" style="border-width: 2px;">
                                    <!-- Status Badge -->
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge @statusBadge fs-6">
                                            <i class="bi @statusIcon me-1"></i>
                                            @if (!flashSale.IsActive)
                                            {
                                                <text>Inactive</text>
                                            }
                                            else if (hasEnded)
                                            {
                                                <text>Ended</text>
                                            }
                                            else if (isActive)
                                            {
                                                <text>Active</text>
                                            }
                                            else
                                            {
                                                <text>Scheduled</text>
                                            }
                                        </span>
                                    </div>

                                    <div class="card-body">
                                        <!-- Title -->
                                        <h4 class="card-title mb-3" style="color: #1976D2; font-weight: 700;">
                                            <i class="bi bi-lightning-charge-fill me-2"></i>
                                            @flashSale.Name
                                        </h4>

                                        <!-- Description -->
                                        @if (!string.IsNullOrEmpty(flashSale.Description))
                                        {
                                            <p class="text-muted small mb-3">@flashSale.Description</p>
                                        }

                                        <!-- Dates -->
                                        <div class="mb-3">
                                            <small class="d-block mb-1">
                                                <i class="bi bi-calendar-event text-success me-1"></i>
                                                <strong>Start:</strong> @flashSale.StartDate.ToString("MMM dd, yyyy HH:mm")
                                            </small>
                                            <small class="d-block">
                                                <i class="bi bi-calendar-x text-danger me-1"></i>
                                                <strong>End:</strong> @flashSale.EndDate.ToString("MMM dd, yyyy HH:mm")
                                            </small>
                                        </div>

                                        <!-- Stats -->
                                        <div class="d-flex justify-content-between mb-3 p-2 bg-light rounded">
                                            <div class="text-center flex-fill">
                                                <div style="font-size: 1.5rem; font-weight: 700; color: #3B9DD5;">
                                                    @itemCount
                                                </div>
                                                <small class="text-muted">Products</small>
                                            </div>
                                            <div class="text-center flex-fill border-start">
                                                <div style="font-size: 1.5rem; font-weight: 700; color: #7BC043;">
                                                    @totalQty
                                                </div>
                                                <small class="text-muted">Total Qty</small>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="d-grid gap-2">
                                            <a asp-action="Details" asp-route-id="@flashSale.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i> View Details
                                            </a>
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@flashSale.Id" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil me-1"></i> Edit
                                                </a>
                                                <a asp-action="AddProducts" asp-route-id="@flashSale.Id" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-plus-circle me-1"></i> Add Products
                                                </a>
                                            </div>
                                            <div class="btn-group">
                                                <button onclick="toggleActive(@flashSale.Id)" class="btn btn-sm @(flashSale.IsActive ? "btn-warning" : "btn-success")" id="toggleBtn_@flashSale.Id">
                                                    <i class="bi @(flashSale.IsActive ? "bi-pause" : "bi-play") me-1"></i>
                                                    @(flashSale.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                                <button onclick="deleteFlashSale(@flashSale.Id)" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .flash-sale-card {
        transition: all 0.3s ease;
        height: 100%;
    }

    .flash-sale-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }
</style>

@section Scripts {
    <script>
        function toggleActive(id) {
            Swal.fire({
                title: 'Toggle Active Status',
                text: 'Are you sure you want to change the active status?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B9DD5',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, toggle it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/FlashSale/ToggleActive?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success(data.message);
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            toastr.error(data.message);
                        }
                    })
                    .catch(error => {
                        toastr.error('An error occurred');
                        console.error('Error:', error);
                    });
                }
            });
        }

        function deleteFlashSale(id) {
            Swal.fire({
                title: 'Delete Flash Sale?',
                text: 'This will delete the flash sale and all its products. This cannot be undone!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/FlashSale/Delete?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Deleted!', data.message, 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            toastr.error(data.message);
                        }
                    })
                    .catch(error => {
                        toastr.error('An error occurred');
                        console.error('Error:', error);
                    });
                }
            });
        }
    </script>
}


