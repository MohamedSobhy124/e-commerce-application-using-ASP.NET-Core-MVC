@model FlashSale

@{
    ViewData["Title"] = Localizer["EditFlashSale"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <h2 class="admin-form-title">
                    <i class="bi bi-pencil-square me-3"></i>
                    @Localizer["EditFlashSale"]
                </h2>
            </div>

            <div class="admin-form-body">
                <form asp-action="Edit" method="post">
                    <input hidden asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Flash Sale Information -->
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                @Localizer["FlashSaleInformation"]
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Name -->
                            <div class="admin-form-group">
                                <label class="admin-form-label">
                                    <i class="bi bi-tag me-2"></i>@Localizer["FlashSaleName"]
                                    <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name" class="admin-form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <!-- Description -->
                            <div class="admin-form-group">
                                <label class="admin-form-label">
                                    <i class="bi bi-text-paragraph me-2"></i>@Localizer["Description"]
                                </label>
                                <textarea asp-for="Description" class="admin-form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Date & Time Settings -->
                    <div class="card mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-event me-2"></i>
                                @Localizer["Schedule"]
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Start Date & Time -->
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label class="admin-form-label">
                                            <i class="bi bi-calendar-check text-success me-2"></i>@Localizer["StartDateTime"]
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="StartDate" type="datetime-local" class="admin-form-control" />
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- End Date & Time -->
                                <div class="col-md-6">
                                    <div class="admin-form-group">
                                        <label class="admin-form-label">
                                            <i class="bi bi-calendar-x text-danger me-2"></i>@Localizer["EndDateTime"]
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="EndDate" type="datetime-local" class="admin-form-control" />
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Active Status -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" style="width: 3rem; height: 1.5rem;" />
                                <label class="form-check-label ms-2" style="font-size: 1.1rem; font-weight: 600;">
                                    <i class="bi bi-toggle-on text-success me-2"></i>
                                    @Localizer["Active"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>
                            @Localizer["UpdateFlashSale"]
                        </button>
                        <a asp-action="AddProducts" asp-route-id="@Model.Id" class="btn btn-info btn-lg">
                            <i class="bi bi-plus-circle me-2"></i>
                            @Localizer["ManageProducts"]
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle me-2"></i>
                            @Localizer["Cancel"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

