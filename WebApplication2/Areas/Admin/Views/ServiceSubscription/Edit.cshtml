@model BulkyBook.Models.ServiceSubscription

@{
    ViewData["Title"] = Localizer["EditServiceSubscription"];
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pencil-fill me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h2 class="mb-0">@Localizer["EditServiceSubscription"]</h2>
                            <small class="opacity-75">@Localizer["UpdateServiceDetails"]</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <!-- Title and Type -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["TitleEnglish"]</label>
                                <input asp-for="Title" class="form-control form-control-lg" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["TitleArabic"]</label>
                                <input asp-for="TitleAr" class="form-control form-control-lg" />
                                <span asp-validation-for="TitleAr" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["DescriptionEnglish"]</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["DescriptionArabic"]</label>
                                <textarea asp-for="DescriptionAr" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Service Type and Price -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["ServiceType"]</label>
                                <select asp-for="ServiceType" class="form-select form-select-lg" id="serviceType">
                                    <option value="1">@Localizer["OnlineFullPayment"]</option>
                                    <option value="2">@Localizer["OfflinePartialPayment"]</option>
                                </select>
                                <span asp-validation-for="ServiceType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["PriceAED"]</label>
                                <input asp-for="Price" class="form-control form-control-lg" type="number" step="0.01" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Offline Payment Percent -->
                        <div class="row mb-4" id="offlinePercentRow" style="display: @(Model.ServiceType == ServiceType.Offline ? "block" : "none");">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["OfflinePaymentPercentage"]</label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="OfflinePaymentPercent" class="form-control" type="number" step="0.01" min="1" max="100" />
                                    <span class="input-group-text bg-primary text-white fw-bold">%</span>
                                </div>
                                <span asp-validation-for="OfflinePaymentPercent" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Image Upload -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-images text-info me-2"></i>@Localizer["ServiceImages"]
                                </label>
                                
                                <!-- Existing Images Gallery -->
                                <div id="images-gallery" class="images-gallery mb-3">
                                    @if (Model.ServiceImages != null && Model.ServiceImages.Any())
                                    {
                                        @foreach (var image in Model.ServiceImages.OrderBy(si => si.DisplayOrder))
                                        {
                                            <div class="image-item" data-image-id="@image.Id">
                                                <img src="@image.ImageUrl" alt="Service Image" class="gallery-image" />
                                                <button type="button" class="delete-image-btn" onclick="deleteImage(@image.Id, this)" title="Delete Image">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <div class="image-item" data-image-id="0">
                                            <img src="@Model.ImageUrl" alt="Service Image" class="gallery-image" />
                                            <span class="main-image-badge">Main</span>
                                        </div>
                                    }
                                </div>

                                <!-- Upload New Images -->
                                <div class="image-upload-section">
                                    <label for="files-input" class="upload-button">
                                        <i class="bi bi-cloud-upload me-2"></i>@Localizer["UploadAdditionalImages"]
                                    </label>
                                    <input id="files-input" type="file" name="files" class="form-control form-control-lg d-none" accept="image/*" multiple />
                                    <div id="preview-container" class="preview-container mt-3"></div>
                                    <div id="image-error" class="text-danger mt-2" style="display: none;">@Localizer["AtLeastOneImageRequired"]</div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@Localizer["DisplayOrder"]</label>
                                <input asp-for="DisplayOrder" class="form-control form-control-lg" type="number" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Active Status -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold d-block">@Localizer["Status"]</label>
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" style="width: 3rem; height: 1.5rem;" />
                                    <label class="form-check-label ms-2 fw-bold">@Localizer["Active"]</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Action Buttons -->
                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-lg btn-primary px-5 me-2">
                                    <i class="bi bi-check-circle me-2"></i>@Localizer["UpdateService"]
                                </button>
                                <a asp-action="Index" class="btn btn-lg btn-outline-secondary px-4">
                                    <i class="bi bi-x-circle me-2"></i>@Localizer["Cancel"]
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .images-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .image-item {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid #e0e0e0;
        transition: all 0.3s ease;
    }

    .image-item:hover {
        border-color: #667eea;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .gallery-image {
        width: 100%;
        height: 150px;
        object-fit: cover;
    }

    .delete-image-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(220, 38, 38, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        transition: all 0.3s ease;
    }

    .delete-image-btn:hover {
        background: rgba(220, 38, 38, 1);
        transform: scale(1.1);
    }

    .main-image-badge {
        position: absolute;
        top: 5px;
        left: 5px;
        background: rgba(34, 197, 94, 0.9);
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .image-upload-section {
        border: 2px dashed #667eea;
        border-radius: 10px;
        padding: 2rem;
        text-align: center;
        background: #f9fafb;
        transition: all 0.3s ease;
    }

    .image-upload-section:hover {
        border-color: #764ba2;
        background: #f3f4f6;
    }

    .upload-button {
        display: inline-block;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .upload-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .preview-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .preview-item {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .preview-item img {
        width: 100%;
        height: 150px;
        object-fit: cover;
    }

    .preview-item .remove-preview {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(220, 38, 38, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .preview-item .remove-preview:hover {
        background: rgba(220, 38, 38, 1);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $('#serviceType').change(function() {
            if ($(this).val() == '2') {
                $('#offlinePercentRow').show();
                $('#OfflinePaymentPercent').attr('required', true);
            } else {
                $('#offlinePercentRow').hide();
                $('#OfflinePaymentPercent').removeAttr('required');
            }
        });

        // Multiple image upload preview
        let selectedFiles = [];
        const filesInput = document.getElementById('files-input');
        const previewContainer = document.getElementById('preview-container');
        const imageError = document.getElementById('image-error');

        // Click on label triggers file input
        document.querySelector('.upload-button').addEventListener('click', function(e) {
            e.preventDefault();
            filesInput.click();
        });

        filesInput.addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            selectedFiles = files;
            
            previewContainer.innerHTML = '';

            if (files.length > 0) {
                files.forEach((file, index) => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const previewItem = document.createElement('div');
                            previewItem.className = 'preview-item';
                            previewItem.innerHTML = `
                                <img src="${e.target.result}" alt="Preview ${index + 1}" />
                                <button type="button" class="remove-preview" onclick="removePreview(${index})">
                                    <i class="bi bi-x"></i>
                                </button>
                            `;
                            previewContainer.appendChild(previewItem);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });

        function removePreview(index) {
            selectedFiles.splice(index, 1);
            const dt = new DataTransfer();
            selectedFiles.forEach(file => dt.items.add(file));
            filesInput.files = dt.files;
            filesInput.dispatchEvent(new Event('change'));
        }

        // Delete image function
        function deleteImage(imageId, button) {
            // Get imageId from data attribute as fallback
            const imageItem = button.closest('.image-item');
            const dataImageId = imageItem ? parseInt(imageItem.getAttribute('data-image-id')) : 0;
            
            // Use data attribute if imageId parameter is invalid
            const finalImageId = (imageId && imageId > 0) ? imageId : dataImageId;
            
            // Validate imageId
            if (!finalImageId || finalImageId <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: '@Localizer["Error"]',
                    text: 'Invalid image ID. Please refresh the page and try again.'
                });
                console.error('Invalid imageId:', imageId, 'data-image-id:', dataImageId);
                return;
            }
            
            Swal.fire({
                title: '@Localizer["Delete"]',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: '@Localizer["Delete"]',
                cancelButtonText: '@Localizer["Cancel"]',
                dangerMode: true
            }).then((result) => {
                if (!result.isConfirmed) {
                    return;
                }

                const existingImages = document.querySelectorAll('.image-item').length;
                
                if (existingImages <= 1) {
                    Swal.fire({
                        icon: 'warning',
                        title: '@Localizer["Warning"]',
                        text: '@Localizer["AtLeastOneImageRequiredAddNew"]'
                    });
                    return;
                }
            
            fetch('/Admin/ServiceSubscription/DeleteImage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ imageId: finalImageId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    imageItem.remove();
                    
                    // Check if any images remain
                    const remainingImages = document.querySelectorAll('.image-item').length;
                    if (remainingImages === 0) {
                        const gallery = document.getElementById('images-gallery');
                        if (gallery) {
                            gallery.innerHTML = '<p class="text-muted text-center">@Localizer["NoImagesPleaseUpload"]</p>';
                        }
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '@Localizer["Error"]',
                        text: '@Localizer["ErrorDeletingImage"]: ' + (data.message || '@Localizer["UnknownError"]')
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: '@Localizer["Error"]',
                    text: '@Localizer["ErrorDeletingImageTryAgain"]'
                });
            });
            });
        }

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const existingImages = document.querySelectorAll('.image-item').length;
            const newFiles = filesInput.files.length;
            
            if (existingImages === 0 && newFiles === 0) {
                e.preventDefault();
                imageError.style.display = 'block';
                imageError.textContent = '@Localizer["AtLeastOneImageRequired"]';
                imageError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }
        });
    </script>
}

