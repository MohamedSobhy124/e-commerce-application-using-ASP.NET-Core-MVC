@model IEnumerable<BulkyBook.Models.ServicePurchase>

@{
    ViewData["Title"] = Localizer["ServicePurchases"];
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-cart-check me-3"></i>
                    @Localizer["ServicePurchasesManagement"]
                </h2>
                <div class="d-flex gap-2 align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        @Localizer["BackToList"]
                    </a>
                </div>
            </div>

            <div class="admin-card-body">
                <div class="admin-table-wrapper" style="overflow-x: auto;">
                    <table id="tblData" class="table table-bordered table-striped table-hover" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>@Localizer["PurchaseID"]</th>
                                <th>@Localizer["Service"]</th>
                                <th>@Localizer["Customer"]</th>
                                <th>@Localizer["Email"]</th>
                                <th>@Localizer["Phone"]</th>
                                <th>@Localizer["TotalAmount"]</th>
                                <th>@Localizer["AmountPaid"]</th>
                                <th>@Localizer["PaymentStatus"]</th>
                                <th>@Localizer["PurchaseDate"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>   
                        </thead>
                        <tbody>
                            <!-- DataTable will populate this -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript" src="~/js/ServicePurchase.js"></script>
}

