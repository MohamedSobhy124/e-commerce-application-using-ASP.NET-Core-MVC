@model BulkyBook.Models.PromoCode

@{
    ViewData["Title"] = Localizer["EditPromoCode"];
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-pencil-square me-3" style="font-size: 2rem;"></i>
                            <div>
                                <h2 class="mb-0">@Localizer["EditPromoCode"]</h2>
                                <small class="opacity-75">@Localizer["Code"]: <strong>@Model.Code</strong></small>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-6">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                                @(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Usage Statistics Card -->
                    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-3" style="font-size: 1.5rem;"></i>
                        <div>
                            <strong>@Localizer["UsageStatistics"]:</strong>
                            @Localizer["Currently used"]: <strong>@Model.TimesUsed</strong> @Localizer["times"]
                            @if (Model.UsageLimit.HasValue)
                            {
                                <span> / @Model.UsageLimit @Localizer["total"]</span>
                            }
                        </div>
                    </div>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="TimesUsed" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <!-- Code and Discount Type -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-tag-fill text-primary me-2"></i>@Localizer["Code"]
                                </label>
                                <input asp-for="Code" class="form-control form-control-lg text-uppercase" />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-percent text-success me-2"></i>@Localizer["DiscountType"]
                                </label>
                                <select asp-for="DiscountType" class="form-select form-select-lg" id="discountType">
                                    <option value="1">@Localizer["Percentage"]</option>
                                    <option value="2">@Localizer["FixedAmount"]</option>
                                </select>
                                <span asp-validation-for="DiscountType" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-file-text text-info me-2"></i>@Localizer["Description"]
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Discount Value and Minimum Order -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-cash-coin text-warning me-2"></i>@Localizer["DiscountValue"]
                                </label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
                                    <span class="input-group-text bg-primary text-white fw-bold" id="discountSymbol">@(Model.DiscountType == BulkyBook.Models.DiscountType.Percentage ? "%" : "AED")</span>
                                </div>
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-cart-check text-danger me-2"></i>@Localizer["MinimumOrder"]
                                </label>
                                <input asp-for="MinimumOrderAmount" class="form-control form-control-lg" type="number" step="0.01" />
                                <span asp-validation-for="MinimumOrderAmount" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Start and End Date -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-check text-success me-2"></i>@Localizer["StartDate"]
                                </label>
                                <input asp-for="StartDate" class="form-control form-control-lg" type="datetime-local" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-x text-danger me-2"></i>@Localizer["EndDate"]
                                </label>
                                <input asp-for="EndDate" class="form-control form-control-lg" type="datetime-local" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Usage Limits -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-arrow-repeat text-primary me-2"></i>@Localizer["UsageLimit"]
                                </label>
                                <input asp-for="UsageLimit" class="form-control form-control-lg" type="number" />
                                <span asp-validation-for="UsageLimit" class="text-danger"></span>
                                <small class="form-text text-muted">
                                    @Localizer["Currently used"]: <strong>@Model.TimesUsed</strong> @Localizer["times"]
                                </small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-person-badge text-warning me-2"></i>@Localizer["PerUserLimit"]
                                </label>
                                <input asp-for="UsageLimitPerUser" class="form-control form-control-lg" type="number" />
                                <span asp-validation-for="UsageLimitPerUser" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Maximum Discount and Active Status -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-shield-check text-info me-2"></i>@Localizer["MaximumDiscount"]
                                </label>
                                <input asp-for="MaximumDiscountAmount" class="form-control form-control-lg" type="number" step="0.01" />
                                <span asp-validation-for="MaximumDiscountAmount" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold d-block">
                                     @Localizer["Status"]
                                </label>
                                <div class="d-flex align-items-center mt-3 ">
                                    <div class="form-check form-switch me-3 w-100">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheckbox" style="width: 3rem; height: 1.5rem;" />
                                        <label class="form-check-label ms-2 fw-bold" for="isActiveCheckbox">@Localizer["Active"]</label>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>

                        <!-- Exclude Discounted Items -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="ExcludeDiscountedItems" class="form-check-input" type="checkbox" id="excludeDiscountedItems" style="width: 3rem; height: 1.5rem;" />
                                    <label class="form-check-label ms-2 fw-bold d-flex" for="excludeDiscountedItems">
                                        <i class="bi bi-x-circle text-danger me-2"></i>@Localizer["ExcludeItemsWithExistingDiscounts"]
                                    </label>
                                </div>
                                <small class="form-text text-muted ms-5">
                                    @Localizer["WhenEnabledPromoCodeWillNotApplyToItemsWithFlashSalesComboOffersOrListPriceDiscounts"]
                                </small>
                            </div>
                        </div>

                        <!-- Excluded Products Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-primary">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">
                                            <i class="bi bi-ban me-2"></i>@Localizer["ExcludedProducts"]
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="text-muted mb-3">
                                            @Localizer["ProductsInThisListWillNotReceiveThePromoCodeDiscount"]
                                        </p>
                                        
                                        <!-- Add Product Form -->
                                        <div class="mb-3">
                                            <div class="row g-2">
                                                <div class="col-md-8">
                                                    <label for="productSelect" class="form-label">
                                                        <i class="bi bi-box-seam me-1"></i>@Localizer["SelectProduct"]
                                                    </label>
                                                    <select id="productSelect" class="form-select">
                                                        <option value="">-- @Localizer["SelectProduct"] --</option>
                                                        @if (ViewBag.Products != null)
                                                        {
                                                            @foreach (var product in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Products)
                                                            {
                                                                <option value="@product.Value">@product.Text</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4 d-flex align-items-end">
                                                    <button type="button" class="btn btn-primary w-100" id="addProductBtn" style="display: none;">
                                                        <i class="bi bi-plus-circle me-1"></i>@Localizer["Add"]
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Excluded Products List -->
                                        <div id="excludedProductsList">
                                            @{
                                                var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
                                                var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
                                            }
                                            @if (Model.ExcludedProducts != null && Model.ExcludedProducts.Any())
                                            {
                                                @foreach (var excludedProduct in Model.ExcludedProducts)
                                                {
                                                    var productTitle = (currentCulture == "ar" && !string.IsNullOrEmpty(excludedProduct.Product?.TitleAr)) 
                                                        ? excludedProduct.Product.TitleAr 
                                                        : (excludedProduct.Product?.Title ?? Localizer["Unknown"].Value);
                                                    <div class="badge bg-danger me-2 mb-2 p-2 excluded-product-item" data-excluded-id="@excludedProduct.Id" data-product-id="@excludedProduct.ProductId">
                                                        <span>@productTitle</span>
                                                        <button type="button" class="btn-close btn-close-white ms-2 remove-excluded-product" aria-label="@Localizer["Remove"]"></button>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted">@Localizer["NoProductsExcluded"]</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Excluded Combo Offers Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-warning">
                                    <div class="card-header bg-warning text-dark">
                                        <h5 class="mb-0">
                                            <i class="bi bi-box-seam me-2"></i>@Localizer["ExcludedComboOffers"]
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="text-muted mb-3">
                                            @Localizer["ComboOffersInThisListWillNotReceiveThePromoCodeDiscount"]
                                        </p>
                                        
                                        <!-- Add Combo Offer Form -->
                                        <div class="mb-3">
                                            <div class="row g-2">
                                                <div class="col-md-8">
                                                    <label for="comboOfferSelect" class="form-label">
                                                        <i class="bi bi-box-seam me-1"></i>@Localizer["SelectComboOffer"]
                                                    </label>
                                                    <select id="comboOfferSelect" class="form-select">
                                                        <option value="">-- @Localizer["SelectComboOffer"] --</option>
                                                        @if (ViewBag.ComboOffers != null)
                                                        {
                                                            @foreach (var comboOffer in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.ComboOffers)
                                                            {
                                                                <option value="@comboOffer.Value">@comboOffer.Text</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4 d-flex align-items-end">
                                                    <button type="button" class="btn btn-warning w-100" id="addComboOfferBtn" style="display: none;">
                                                        <i class="bi bi-plus-circle me-1"></i>@Localizer["Add"]
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Excluded Combo Offers List -->
                                        <div id="excludedComboOffersList">
                                            @if (Model.ExcludedComboOffers != null && Model.ExcludedComboOffers.Any())
                                            {
                                                @foreach (var excludedComboOffer in Model.ExcludedComboOffers)
                                                {
                                                    var comboOfferName = (currentCulture == "ar" && !string.IsNullOrEmpty(excludedComboOffer.ComboOffer?.NameAr)) 
                                                        ? excludedComboOffer.ComboOffer.NameAr 
                                                        : (excludedComboOffer.ComboOffer?.Name ?? Localizer["Unknown"].Value);
                                                    <div class="badge bg-warning text-dark me-2 mb-2 p-2 excluded-combo-offer-item" data-excluded-id="@excludedComboOffer.Id" data-combo-offer-id="@excludedComboOffer.ComboOfferId">
                                                        <span>@comboOfferName</span>
                                                        <button type="button" class="btn-close btn-close-dark ms-2 remove-excluded-combo-offer" aria-label="@Localizer["Remove"]"></button>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted">@Localizer["NoComboOffersExcluded"]</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Action Buttons -->
                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-lg btn-warning px-5 me-2">
                                    <i class="bi bi-save me-2"></i>@Localizer["UpdatePromoCode"]
                                </button>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-lg btn-outline-info px-4 me-2">
                                    <i class="bi bi-eye me-2"></i>@Localizer["ViewDetails"]
                                </a>
                                <a asp-action="Index" class="btn btn-lg btn-outline-secondary px-4">
                                    <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToList"]
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient {
        position: relative;
        overflow: hidden;
    }
    
    .bg-gradient::before {
        content: "";
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: pulse 3s ease-in-out infinite;
    }
    
    @@keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }

    .form-control:focus, .form-select:focus {
        border-color: #f5576c;
        box-shadow: 0 0 0 0.25rem rgba(245, 87, 108, 0.25);
    }

    .card {
        border-radius: 15px;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
    }

    .form-check-input:checked {
        background-color: #f5576c;
        border-color: #f5576c;
    }
</style>

@Html.AntiForgeryToken()

@section Styles {
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    
    <style>
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
            border: 1px solid #ced4da;
        }
        
        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }
        
        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }
        
        .select2-dropdown {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }
        
        .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
        }
        
        .select2-results__option {
            padding: 0.5rem 0.75rem;
        }
        
        .select2-results__option--highlighted {
            background-color: #0d6efd;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        // Update discount symbol based on discount type
        $('#discountType').change(function() {
            var symbol = $(this).val() == '1' ? '%' : 'AED';
            $('#discountSymbol').text(symbol);
        });

        // Convert code to uppercase
        $('input[name="Code"]').on('input', function() {
            $(this).val($(this).val().toUpperCase());
        });

        // Toggle active status from edit page
        $('.toggle-active-edit').click(function (e) {
            e.preventDefault();
            var promoId = $(this).data('id');
            var btn = $(this);
            var checkbox = $('#isActiveCheckbox');
            var statusBadge = $('.badge.fs-6');
            
            // Disable button during request
            btn.prop('disabled', true);
            
            $.ajax({
                url: '@Url.Action("ToggleActive", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    id: promoId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        // Update checkbox
                        checkbox.prop('checked', response.isActive);
                        
                        // Update status badge in header
                        if (response.isActive) {
                            statusBadge.removeClass('bg-secondary').addClass('bg-success');
                            statusBadge.html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@Html.Raw(Localizer["Active"].Value)');
                            btn.removeClass('btn-secondary').addClass('btn-success');
                            btn.find('i').removeClass('bi-toggle-off').addClass('bi-toggle-on');
                        } else {
                            statusBadge.removeClass('bg-success').addClass('bg-secondary');
                            statusBadge.html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@Html.Raw(Localizer["Inactive"].Value)');
                            btn.removeClass('btn-success').addClass('btn-secondary');
                            btn.find('i').removeClass('bi-toggle-on').addClass('bi-toggle-off');
                        }
                        
                        // Show success message
                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Toggle active error:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    } else {
                        alert('An error occurred. Please try again.');
                    }
                },
                complete: function () {
                    btn.prop('disabled', false);
                }
            });
        });

        // Prevent checkbox from triggering AJAX - let form submission handle it
        // The toggle button will update the checkbox via AJAX

        // Excluded Products Management
        var promoCodeId = @Model.Id;
        var currentCulture = '@System.Globalization.CultureInfo.CurrentCulture.Name';

        // Initialize Select2 for product dropdown
        $(document).ready(function() {
            $('#productSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '@Html.Raw(Localizer["SelectProduct"])',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                closeOnSelect: false
            });

            // Show/hide Add button based on selection
            $('#productSelect').on('change', function() {
                if ($(this).val()) {
                    $('#addProductBtn').show();
                } else {
                    $('#addProductBtn').hide();
                }
            });

            // Initialize Select2 for combo offer dropdown
            $('#comboOfferSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '@Html.Raw(Localizer["SelectComboOffer"])',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                closeOnSelect: false
            });

            // Show/hide Add button based on selection
            $('#comboOfferSelect').on('change', function() {
                if ($(this).val()) {
                    $('#addComboOfferBtn').show();
                } else {
                    $('#addComboOfferBtn').hide();
                }
            });
        });

        // Add product to excluded list
        $('#addProductBtn').click(function() {
            var productId = $('#productSelect').val();
            if (!productId) {
                return;
            }

            // Get selected product text (title)
            var selectedOption = $('#productSelect option:selected');
            var productTitle = selectedOption.text().split(' (')[0]; // Extract title before stock info

            // Check if already excluded
            if ($('.excluded-product-item[data-product-id="' + productId + '"]').length > 0) {
                if (typeof toastr !== 'undefined') {
                    toastr.warning('@Html.Raw(Localizer["ProductIsAlreadyExcluded"].Value)');
                } else {
                    alert('@Html.Raw(Localizer["ProductIsAlreadyExcluded"].Value)');
                }
                return;
            }

            // Disable button during request
            var btn = $(this);
            btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("AddExcludedProduct", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    promoCodeId: promoCodeId,
                    productId: productId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        // Get localized product title from response
                        var displayTitle = (currentCulture === 'ar' && response.productTitleAr) 
                            ? response.productTitleAr 
                            : (response.productTitle || productTitle);

                        // Add to UI
                        var badgeHtml = '<div class="badge bg-danger me-2 mb-2 p-2 excluded-product-item" data-excluded-id="' + response.excludedProductId + '" data-product-id="' + productId + '">';
                        badgeHtml += '<span>' + displayTitle + '</span>';
                        badgeHtml += '<button type="button" class="btn-close btn-close-white ms-2 remove-excluded-product" aria-label="@Html.Raw(Localizer["Remove"].Value)"></button>';
                        badgeHtml += '</div>';

                        if ($('#excludedProductsList p.text-muted').length > 0) {
                            $('#excludedProductsList').html(badgeHtml);
                        } else {
                            $('#excludedProductsList').append(badgeHtml);
                        }

                        // Remove from dropdown and reset selection
                        selectedOption.remove();
                        $('#productSelect').val('').trigger('change');
                        $('#addProductBtn').hide();

                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function() {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    } else {
                        alert('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    }
                },
                complete: function() {
                    btn.prop('disabled', false);
                }
            });
        });

        // Remove product from excluded list
        $(document).on('click', '.remove-excluded-product', function(e) {
            e.preventDefault();
            var excludedItem = $(this).closest('.excluded-product-item');
            var excludedId = excludedItem.data('excluded-id');
            var productId = excludedItem.data('product-id');

            if (!confirm('@Html.Raw(Localizer["AreYouSureYouWantToRemoveThisProductFromExcludedList"].Value)')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("RemoveExcludedProduct", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    excludedProductId: excludedId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        excludedItem.remove();
                        
                        // Re-add product to dropdown
                        // Get product info to add back to dropdown
                        $.ajax({
                            url: '@Url.Action("GetProductForDropdown", "PromoCode", new { area = "Admin" })',
                            type: 'GET',
                            data: { productId: productId },
                            success: function(productData) {
                                if (productData.success) {
                                    var option = new Option(productData.text, productData.value, false, false);
                                    $('#productSelect').append(option).trigger('change');
                                }
                            }
                        });
                        
                        // Show message if no products left
                        if ($('.excluded-product-item').length === 0) {
                            $('#excludedProductsList').html('<p class="text-muted">@Html.Raw(Localizer["NoProductsExcluded"].Value)</p>');
                        }

                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function() {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    } else {
                        alert('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    }
                }
            });
        });

        // Add combo offer to excluded list
        $('#addComboOfferBtn').click(function() {
            var comboOfferId = $('#comboOfferSelect').val();
            if (!comboOfferId) {
                return;
            }

            // Get selected combo offer text (name)
            var selectedOption = $('#comboOfferSelect option:selected');
            var comboOfferName = selectedOption.text().split(' (')[0]; // Extract name before price info

            // Check if already excluded
            if ($('.excluded-combo-offer-item[data-combo-offer-id="' + comboOfferId + '"]').length > 0) {
                if (typeof toastr !== 'undefined') {
                    toastr.warning('@Html.Raw(Localizer["ComboOfferIsAlreadyExcluded"].Value)');
                } else {
                    alert('@Html.Raw(Localizer["ComboOfferIsAlreadyExcluded"].Value)');
                }
                return;
            }

            // Disable button during request
            var btn = $(this);
            btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("AddExcludedComboOffer", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    promoCodeId: promoCodeId,
                    comboOfferId: comboOfferId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        // Get localized combo offer name from response
                        var displayName = (currentCulture === 'ar' && response.comboOfferNameAr) 
                            ? response.comboOfferNameAr 
                            : (response.comboOfferName || comboOfferName);

                        // Add to UI
                        var badgeHtml = '<div class="badge bg-warning text-dark me-2 mb-2 p-2 excluded-combo-offer-item" data-excluded-id="' + response.excludedComboOfferId + '" data-combo-offer-id="' + comboOfferId + '">';
                        badgeHtml += '<span>' + displayName + '</span>';
                        badgeHtml += '<button type="button" class="btn-close btn-close-dark ms-2 remove-excluded-combo-offer" aria-label="@Html.Raw(Localizer["Remove"].Value)"></button>';
                        badgeHtml += '</div>';

                        if ($('#excludedComboOffersList p.text-muted').length > 0) {
                            $('#excludedComboOffersList').html(badgeHtml);
                        } else {
                            $('#excludedComboOffersList').append(badgeHtml);
                        }

                        // Remove from dropdown and reset selection
                        selectedOption.remove();
                        $('#comboOfferSelect').val('').trigger('change');
                        $('#addComboOfferBtn').hide();

                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function() {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    } else {
                        alert('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    }
                },
                complete: function() {
                    btn.prop('disabled', false);
                }
            });
        });

        // Remove combo offer from excluded list
        $(document).on('click', '.remove-excluded-combo-offer', function(e) {
            e.preventDefault();
            var excludedItem = $(this).closest('.excluded-combo-offer-item');
            var excludedId = excludedItem.data('excluded-id');
            var comboOfferId = excludedItem.data('combo-offer-id');

            if (!confirm('@Html.Raw(Localizer["AreYouSureYouWantToRemoveThisComboOfferFromExcludedList"].Value)')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("RemoveExcludedComboOffer", "PromoCode", new { area = "Admin" })',
                type: 'POST',
                data: {
                    excludedComboOfferId: excludedId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        excludedItem.remove();
                        
                        // Re-add combo offer to dropdown
                        $.ajax({
                            url: '@Url.Action("GetComboOfferForDropdown", "PromoCode", new { area = "Admin" })',
                            type: 'GET',
                            data: { comboOfferId: comboOfferId },
                            success: function(comboOfferData) {
                                if (comboOfferData.success) {
                                    var option = new Option(comboOfferData.text, comboOfferData.value, false, false);
                                    $('#comboOfferSelect').append(option).trigger('change');
                                }
                            }
                        });
                        
                        // Show message if no combo offers left
                        if ($('.excluded-combo-offer-item').length === 0) {
                            $('#excludedComboOffersList').html('<p class="text-muted">@Html.Raw(Localizer["NoComboOffersExcluded"].Value)</p>');
                        }

                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(response.message);
                        } else {
                            alert(response.message);
                        }
                    }
                },
                error: function() {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    } else {
                        alert('@Html.Raw(Localizer["AnErrorOccurredPleaseTryAgain"].Value)');
                    }
                }
            });
        });
    </script>
}
