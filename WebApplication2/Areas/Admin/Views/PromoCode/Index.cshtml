@model IEnumerable<BulkyBook.Models.PromoCode>

@{
    ViewData["Title"] = Localizer["PromoCodes"];
}

<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="mt-4">@Localizer["PromoCodesManagement"]</h1>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> @Localizer["CreateNewPromoCode"]
                </a>
            </div>

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow">
                <div class="card-body">
                    <table class="table table-hover" id="promoCodesTable">
                        <thead>
                            <tr>
                                <th>@Localizer["Code"]</th>
                                <th>@Localizer["Description"]</th>
                                <th>@Localizer["Discount"]</th>
                                <th>@Localizer["ValidPeriod"]</th>
                                <th>@Localizer["Usage"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var promo in Model)
                            {
                                var now = BulkyBook.Utility.DateTimeHelper.Now;
                                var isExpired = promo.EndDate < now;
                                var isNotStarted = promo.StartDate > now;
                                var isUsageLimitReached = promo.UsageLimit.HasValue && promo.TimesUsed >= promo.UsageLimit.Value;
                                
                                <tr class="@(isExpired || isUsageLimitReached ? "table-secondary" : "")">
                                    <td>
                                        <strong class="text-primary">@promo.Code</strong>
                                    </td>
                                    <td>@promo.Description</td>
                                    <td>
                                        @if (promo.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                        {
                                            <span class="badge bg-success">@promo.DiscountValue%</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@promo.DiscountValue.ToString("C")</span>
                                        }
                                    </td>
                                    <td>
                                        <small>
                                            @promo.StartDate.ToString("MMM dd, yyyy")<br/>
                                            <i class="bi bi-arrow-right"></i> @promo.EndDate.ToString("MMM dd, yyyy")
                                        </small>
                                        @if (isExpired)
                                        {
                                            <br/><span class="badge bg-danger">@Localizer["Expired"]</span>
                                        }
                                        else if (isNotStarted)
                                        {
                                            <br/><span class="badge bg-warning">@Localizer["Upcoming"]</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@promo.TimesUsed</span>
                                        @if (promo.UsageLimit.HasValue)
                                        {
                                            <span>/ @promo.UsageLimit</span>
                                            @if (isUsageLimitReached)
                                            {
                                                <br/><span class="badge bg-danger">@Localizer["LimitReached"]</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">/ @Localizer["Unlimited"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (promo.IsActive && !isExpired && !isUsageLimitReached && !isNotStarted)
                                        {
                                            <span class="badge bg-success" id="status-@promo.Id">@Localizer["Active"]</span>
                                        }
                                        else if (!promo.IsActive)
                                        {
                                            <span class="badge bg-secondary" id="status-@promo.Id">@Localizer["Inactive"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning" id="status-@promo.Id">@Localizer["Paused"]</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@promo.Id" class="btn btn-sm btn-info" title="@Localizer["Details"]">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@promo.Id" class="btn btn-sm btn-warning" title="@Localizer["Edit"]">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-secondary toggle-active" data-id="@promo.Id" title="@Localizer["ToggleActive"]">
                                                <i class="bi bi-toggle-@(promo.IsActive ? "on" : "off")"></i>
                                            </button>
                                            @if (promo.TimesUsed == 0)
                                            {
                                                <a asp-action="Delete" asp-route-id="@promo.Id" class="btn btn-sm btn-danger" title="@Localizer["Delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            $('#promoCodesTable').DataTable({
                "order": [[3, "desc"]], // Sort by start date descending
                "pageLength": 25
            });

            // Toggle active status - Use event delegation for DataTable compatibility
            $(document).on('click', '.toggle-active', function (e) {
                e.preventDefault();
                var promoId = $(this).data('id');
                var btn = $(this);
                
                // Disable button during request
                btn.prop('disabled', true);
                
                $.ajax({
                    url: '@Url.Action("ToggleActive", "PromoCode", new { area = "Admin" })',
                    type: 'POST',
                    data: {
                        id: promoId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            // Update status badge
                            var statusBadge = $('#status-' + promoId);
                            var row = btn.closest('tr');
                            
                            // Check if promo is expired or not started
                            var isExpired = row.find('.badge.bg-danger').length > 0;
                            var isNotStarted = row.find('.badge.bg-warning:contains("@Localizer["Upcoming"]")').length > 0;
                            var isUsageLimitReached = row.find('.badge.bg-danger:contains("@Localizer["LimitReached"]")').length > 0;
                            
                            // Update badge based on active status and other conditions
                            statusBadge.removeClass('bg-success bg-secondary bg-warning');
                            
                            if (response.isActive && !isExpired && !isUsageLimitReached && !isNotStarted) {
                                statusBadge.addClass('bg-success').text('@Html.Raw(Localizer["Active"].Value)');
                            } else if (!response.isActive) {
                                statusBadge.addClass('bg-secondary').text('@Html.Raw(Localizer["Inactive"].Value)');
                            } else {
                                statusBadge.addClass('bg-warning').text('@Html.Raw(Localizer["Paused"].Value)');
                            }
                            
                            // Update toggle button
                            if (response.isActive) {
                                btn.find('i').removeClass('bi-toggle-off').addClass('bi-toggle-on');
                                btn.removeClass('btn-secondary').addClass('btn-success');
                            } else {
                                btn.find('i').removeClass('bi-toggle-on').addClass('bi-toggle-off');
                                btn.removeClass('btn-success').addClass('btn-secondary');
                            }
                            
                            // Show success message
                            if (typeof toastr !== 'undefined') {
                                toastr.success(response.message);
                            } else {
                                alert(response.message);
                            }
                        } else {
                            if (typeof toastr !== 'undefined') {
                                toastr.error(response.message);
                            } else {
                                alert(response.message);
                            }
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Toggle active error:', error);
                        if (typeof toastr !== 'undefined') {
                            toastr.error('@Html.Raw(Localizer["An error occurred. Please try again."].Value)');
                        } else {
                            alert('An error occurred. Please try again.');
                        }
                    },
                    complete: function () {
                        btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}

