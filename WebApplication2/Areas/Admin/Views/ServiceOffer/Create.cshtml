@model BulkyBook.Models.ServiceOffer

@{
    ViewData["Title"] = "Create Service Offer";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h2 class="mb-0">Create Service Offer</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Service Subscription *</label>
                                <select asp-for="ServiceSubscriptionId" class="form-select" asp-items="ViewBag.ServiceSubscriptionList" required>
                                    <option value="">-- Select Service --</option>
                                </select>
                                <span asp-validation-for="ServiceSubscriptionId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Link to Promo Code (Optional)</label>
                                <select asp-for="PromoCodeId" class="form-select" asp-items="ViewBag.PromoCodeList">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Discount Type *</label>
                                <select asp-for="DiscountType" class="form-select" id="discountType">
                                    <option value="1">Percentage</option>
                                    <option value="2">Fixed Amount</option>
                                </select>
                                <span asp-validation-for="DiscountType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Discount Value *</label>
                                <div class="input-group">
                                    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" required />
                                    <span class="input-group-text" id="discountSymbol">%</span>
                                </div>
                                <span asp-validation-for="DiscountValue" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Start Date *</label>
                                <input asp-for="StartDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">End Date *</label>
                                <input asp-for="EndDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold d-block">Status</label>
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" style="width: 3rem; height: 1.5rem;" checked />
                                    <label class="form-check-label ms-2 fw-bold">Active</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg px-5 me-2">
                                    <i class="bi bi-check-circle me-2"></i>Create Offer
                                </button>
                                <a asp-action="Index" class="btn btn-secondary btn-lg px-4">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $('#discountType').change(function() {
            var symbol = $(this).val() == '1' ? '%' : 'AED';
            $('#discountSymbol').text(symbol);
        });
    </script>
}

