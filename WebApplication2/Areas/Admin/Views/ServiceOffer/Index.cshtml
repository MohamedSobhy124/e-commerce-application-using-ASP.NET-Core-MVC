@model IEnumerable<BulkyBook.Models.ServiceOffer>

@{
    ViewData["Title"] = "Service Offers";
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-tag me-3"></i>
                    Service Offers Management
                </h2>
                <a asp-action="Create" class="create-new-btn">
                    <i class="bi bi-plus-circle"></i>
                    Create New Offer
                </a>
            </div>

            <div class="admin-card-body">
                <div class="admin-table-wrapper">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Service</th>
                                <th>Discount</th>
                                <th>Valid Period</th>
                                <th>Promo Code</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model)
                            {
                                var now = DateTime.Now;
                                var isExpired = offer.EndDate < now;
                                var isNotStarted = offer.StartDate > now;
                                
                                <tr class="@(isExpired || !offer.IsActive ? "table-secondary" : "")">
                                    <td>@offer.Id</td>
                                    <td>
                                        @if (offer.ServiceSubscription != null)
                                        {
                                            <strong>@offer.ServiceSubscription.Title</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (offer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                        {
                                            <span class="badge bg-success">@offer.DiscountValue%</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@offer.DiscountValue.ToString("C")</span>
                                        }
                                    </td>
                                    <td>
                                        <small>
                                            @offer.StartDate.ToString("MMM dd, yyyy")<br/>
                                            <i class="bi bi-arrow-right"></i> @offer.EndDate.ToString("MMM dd, yyyy")
                                        </small>
                                        @if (isExpired)
                                        {
                                            <br/><span class="badge bg-danger">Expired</span>
                                        }
                                        else if (isNotStarted)
                                        {
                                            <br/><span class="badge bg-warning">Upcoming</span>
                                        }
                                    </td>
                                    <td>
                                        @if (offer.PromoCode != null)
                                        {
                                            <span class="badge bg-primary">@offer.PromoCode.Code</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (offer.IsActive && !isExpired && !isNotStarted)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (!offer.IsActive)
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Paused</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@offer.Id" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@offer.Id" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

