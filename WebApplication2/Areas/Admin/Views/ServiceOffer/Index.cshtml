@model IEnumerable<BulkyBook.Models.ServiceOffer>

@{
    ViewData["Title"] = Localizer["ServiceOffers"];
}

<partial name="_Notifications" />

<div class="admin-wrapper">
    <div class="container">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">
                    <i class="bi bi-tag me-3"></i>
                    @Localizer["ServiceOffers"]
                </h2>
                <div class="d-flex gap-2 align-items-center">
                    <a asp-area="Admin" asp-controller="ServiceSubscription" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        @Localizer["BackToList"]
                    </a>
                    <a asp-action="Create" class="create-new-btn">
                        <i class="bi bi-plus-circle"></i>
                        @Localizer["CreateNewOffer"]
                    </a>
                </div>
            </div>

            <div class="admin-card-body">
                <div class="service-offers-wrapper">
                    <div class="admin-table-wrapper">
                        <table class="table table-hover service-offers-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["ID"]</th>
                                    <th>@Localizer["Service"]</th>
                                    <th>@Localizer["Discount"]</th>
                                    <th>@Localizer["ValidPeriod"]</th>
                                    <th>@Localizer["PromoCode"]</th>
                                    <th>@Localizer["Status"]</th>
                                    <th>@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var offer in Model)
                                {
                                    var now = BulkyBook.Utility.DateTimeHelper.Now;
                                    var isExpired = offer.EndDate < now;
                                    var isNotStarted = offer.StartDate > now;
                                    
                                    <tr class="@(isExpired || !offer.IsActive ? "table-secondary" : "")">
                                        <td><strong>#@offer.Id</strong></td>
                                        <td>
                                            @if (offer.ServiceSubscription != null)
                                            {
                                                <strong>@offer.ServiceSubscription.Title</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@Localizer["NA"]</span>
                                            }
                                        </td>
                                        <td>
                                            @if (offer.DiscountType == BulkyBook.Models.DiscountType.Percentage)
                                            {
                                                <span class="discount-badge percentage">@offer.DiscountValue%</span>
                                            }
                                            else
                                            {
                                                <span class="discount-badge fixed">@offer.DiscountValue.ToString("C")</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <small class="text-muted">@Localizer["From"]</small>
                                                <strong>@offer.StartDate.ToString("MMM dd, yyyy")</strong>
                                                <small class="text-muted mt-1">@Localizer["To"]</small>
                                                <strong>@offer.EndDate.ToString("MMM dd, yyyy")</strong>
                                            </div>
                                            @if (isExpired)
                                            {
                                                <br/><span class="status-badge expired"><i class="bi bi-x-circle me-1"></i>@Localizer["Expired"]</span>
                                            }
                                            else if (isNotStarted)
                                            {
                                                <br/><span class="status-badge upcoming"><i class="bi bi-clock me-1"></i>@Localizer["Upcoming"]</span>
                                            }
                                        </td>
                                        <td>
                                            @if (offer.PromoCode != null)
                                            {
                                                <span class="badge bg-primary"><i class="bi bi-ticket-perforated me-1"></i>@offer.PromoCode.Code</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (offer.IsActive && !isExpired && !isNotStarted)
                                            {
                                                <span class="status-badge active"><i class="bi bi-check-circle me-1"></i>@Localizer["Active"]</span>
                                            }
                                            else if (!offer.IsActive)
                                            {
                                                <span class="status-badge inactive"><i class="bi bi-pause-circle me-1"></i>@Localizer["Inactive"]</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge paused"><i class="bi bi-pause-circle me-1"></i>@Localizer["Paused"]</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-action-group">
                                                <a asp-action="Edit" asp-route-id="@offer.Id" class="btn btn-sm btn-warning" title="@Localizer["Edit"]">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@offer.Id" class="btn btn-sm btn-danger" title="@Localizer["Delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/service-offers-admin.css" />
}

