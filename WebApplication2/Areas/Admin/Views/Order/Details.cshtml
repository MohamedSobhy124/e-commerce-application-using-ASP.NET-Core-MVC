@using Microsoft.AspNetCore.Localization
@using BulkyBook.Utility
@model OrderVM

@{
    ViewData["Title"] = "Order Details";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
    var currencySymbol = CurrencyHelper.GetCurrencySymbol(currentCulture);
}

<partial name="_Notifications" />

<div class="order-details-wrapper">
    <div class="container">
        <!-- Back Button -->
        <a asp-action="Index" class="back-to-list-btn">
            <i class="bi bi-arrow-left"></i>
            Back to Orders List
        </a>

        <!-- Order Details Card -->
        <div class="order-details-card">
            <!-- Header -->
            <div class="order-details-header">
                <div class="order-header-left">
                    <h1>
                        <i class="bi bi-receipt me-3"></i>
                        Order #@Model.OrderHeader.Id
                    </h1>
                    <p>
                        <i class="bi bi-calendar3 me-2"></i>
                        Placed on @Model.OrderHeader.OrderDate.ToString("MMM dd, yyyy hh:mm tt")
                    </p>
                </div>
                <div class="order-status-badges">
                    @{
                        var orderStatusClass = Model.OrderHeader.OrderStatus?.ToLower() switch
                        {
                            var s when s.Contains("pending") => "pending",
                            var s when s.Contains("approved") => "approved",
                            var s when s.Contains("process") => "processing",
                            var s when s.Contains("shipped") => "shipped",
                            var s when s.Contains("cancel") => "cancelled",
                            _ => "pending"
                        };

                        var paymentStatusClass = Model.OrderHeader.PaymentStatus?.ToLower() switch
                        {
                            var s when s.Contains("approved") || s.Contains("paid") => "approved",
                            var s when s.Contains("pending") => "pending",
                            var s when s.Contains("rejected") || s.Contains("refunded") => "cancelled",
                            _ => "pending"
                        };
                    }
                    <div class="status-badge @orderStatusClass">
                        <i class="bi bi-box"></i>
                        @Model.OrderHeader.OrderStatus
                    </div>
                    <div class="status-badge @paymentStatusClass">
                        <i class="bi bi-credit-card"></i>
                        @Model.OrderHeader.PaymentStatus
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="order-details-body">
                <!-- Order Information Grid -->
                <div class="order-info-grid">
                    <!-- Customer Information -->
                    <div class="info-card">
                        <div class="info-card-header">
                            <div class="info-card-icon">
                                <i class="bi bi-person"></i>
                            </div>
                            <h3 class="info-card-title">Customer Information</h3>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Name</span>
                            <span class="info-value">@Model.OrderHeader.Name</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Email</span>
                            <span class="info-value">
                                @if (Model.OrderHeader.IsGuestOrder || Model.OrderHeader.ApplicationUser == null)
                                {
                                    @(Model.OrderHeader.Email ?? "N/A")
                                    @if (Model.OrderHeader.IsGuestOrder)
                                    {
                                        <span class="badge bg-info ms-2">Guest</span>
                                    }
                                }
                                else
                                {
                                    @Model.OrderHeader.ApplicationUser.Email
                                }
                            </span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Phone</span>
                            <span class="info-value">@Model.OrderHeader.PhoneNumber</span>
                        </div>
                    </div>

                    <!-- Shipping Information -->
                    <div class="info-card">
                        <div class="info-card-header">
                            <div class="info-card-icon">
                                <i class="bi bi-truck"></i>
                            </div>
                            <h3 class="info-card-title">Shipping Information</h3>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Address</span>
                            <span class="info-value">@Model.OrderHeader.StreetAddress</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">City</span>
                            <span class="info-value">@Model.OrderHeader.City</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">State</span>
                            <span class="info-value">@Model.OrderHeader.State</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Postal Code</span>
                            <span class="info-value">@Model.OrderHeader.PostalCode</span>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="info-card">
                        <div class="info-card-header">
                            <div class="info-card-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <h3 class="info-card-title">Order Summary</h3>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Order Date</span>
                            <span class="info-value">@Model.OrderHeader.OrderDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (Model.OrderHeader.ShippingDate != DateTime.MinValue)
                        {
                            <div class="info-row">
                                <span class="info-label">Shipping Date</span>
                                <span class="info-value">@Model.OrderHeader.ShippingDate.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                        <div class="info-row">
                            <span class="info-label">Order Status</span>
                            <span class="info-value success">@Model.OrderHeader.OrderStatus</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Order Total</span>
                            <span class="info-value highlight">@Html.Raw(currencySymbol) @Model.OrderHeader.OrderTotal.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <!-- Payment Information -->
                <div class="payment-info-box">
                    <h4>
                        <i class="bi bi-credit-card-2-front"></i>
                        Payment Details
                    </h4>
                    <div class="payment-details">
                        <div class="payment-detail-item">
                            <span class="payment-label">Payment Status</span>
                            <span class="payment-value">@Model.OrderHeader.PaymentStatus</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.OrderHeader.SessionId))
                        {
                            <div class="payment-detail-item">
                                <span class="payment-label">Session ID</span>
                                <span class="payment-value" style="font-size: 0.875rem; word-break: break-all;">@Model.OrderHeader.SessionId</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.OrderHeader.PaymentIntentId))
                        {
                            <div class="payment-detail-item">
                                <span class="payment-label">Payment Intent ID</span>
                                <span class="payment-value" style="font-size: 0.875rem; word-break: break-all;">@Model.OrderHeader.PaymentIntentId</span>
                            </div>
                        }
                        @if (Model.OrderHeader.PaymentDate != DateTime.MinValue)
                        {
                            <div class="payment-detail-item">
                                <span class="payment-label">Payment Date</span>
                                <span class="payment-value">@Model.OrderHeader.PaymentDate.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Items -->
                <div class="order-items-section">
                    <div class="order-items-header">
                        <h3>
                            <i class="bi bi-basket3"></i>
                            Order Items
                        </h3>
                    </div>
                    <table class="order-items-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th style="text-align: center;">Quantity</th>
                                <th style="text-align: right;">Price</th>
                                <th style="text-align: right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetail)
                            {
                                <tr>
                                    <td>
                                        <div class="product-info">
                                            <img src="@detail.Product.ImageUrl" alt="@detail.Product.Title" class="product-image" />
                                            <div class="product-details">
                                                <h4>@detail.Product.Title</h4>
                                                <p>by @detail.Product.Author</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="quantity-badge">@detail.Count</span>
                                    </td>
                                    <td style="text-align: right;" class="price-cell">
                                        @Html.Raw(currencySymbol) @detail.Price.ToString("N2")
                                    </td>
                                    <td style="text-align: right;" class="total-cell">
                                        @Html.Raw(currencySymbol) @((detail.Price * detail.Count).ToString("N2"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="label">Order Total:</td>
                                <td class="value">@Html.Raw(currencySymbol) @Model.OrderHeader.OrderTotal.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Editable Information (For Admin) -->
                <form method="post">
                    <input hidden asp-for="OrderHeader.Id" />
                    
                    <div class="edit-form-section">
                        <h3>
                            <i class="bi bi-pencil-square me-2"></i>
                            Update Order Information
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="OrderHeader.Name" class="form-label">
                                    <i class="bi bi-person me-2"></i>Customer Name
                                </label>
                                <input asp-for="OrderHeader.Name" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.PhoneNumber" class="form-label">
                                    <i class="bi bi-telephone me-2"></i>Phone Number
                                </label>
                                <input asp-for="OrderHeader.PhoneNumber" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.StreetAddress" class="form-label">
                                    <i class="bi bi-house me-2"></i>Street Address
                                </label>
                                <input asp-for="OrderHeader.StreetAddress" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.City" class="form-label">
                                    <i class="bi bi-geo-alt me-2"></i>City
                                </label>
                                <input asp-for="OrderHeader.City" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.State" class="form-label">
                                    <i class="bi bi-map me-2"></i>State
                                </label>
                                <input asp-for="OrderHeader.State" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.PostalCode" class="form-label">
                                    <i class="bi bi-mailbox me-2"></i>Postal Code
                                </label>
                                <input asp-for="OrderHeader.PostalCode" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.Carrier" class="form-label">
                                    <i class="bi bi-truck me-2"></i>Carrier
                                </label>
                                <input asp-for="OrderHeader.Carrier" class="form-control" placeholder="e.g., FedEx, UPS, USPS" />
                            </div>
                            <div class="form-group">
                                <label asp-for="OrderHeader.TrackingNumber" class="form-label">
                                    <i class="bi bi-upc-scan me-2"></i>Tracking Number
                                </label>
                                <input asp-for="OrderHeader.TrackingNumber" class="form-control" placeholder="Enter tracking number" />
                            </div>
                        </div>
                        
                        <div class="text-end mt-4">
                            <button type="submit" asp-action="UpdateOrderDetail" class="action-btn action-btn-primary">
                                <i class="bi bi-check-circle"></i>
                                Update Order Details
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Order Actions -->
                <div class="order-actions">
                    @if (Model.OrderHeader.OrderStatus == SD.StatusPaid)
                    {
                        <form method="post" asp-action="StartProcessing">
                            <input type="hidden" name="id" value="@Model.OrderHeader.Id" />
                            <button type="submit" class="action-btn action-btn-info">
                                <i class="bi bi-play-circle"></i>
                                Start Processing
                            </button>
                        </form>
                    }

                    @if (Model.OrderHeader.OrderStatus == SD.StatusInProcess)
                    {
                        <form method="post" asp-action="ShipOrder">
                            <input type="hidden" name="id" value="@Model.OrderHeader.Id" />
                            <input type="hidden" name="carrier" value="@Model.OrderHeader.Carrier" />
                            <input type="hidden" name="trackingNumber" value="@Model.OrderHeader.TrackingNumber" />
                            <button type="submit" class="action-btn action-btn-success">
                                <i class="bi bi-truck"></i>
                                Ship Order
                            </button>
                        </form>
                    }

                    @if (Model.OrderHeader.OrderStatus == SD.StatusShipped)
                    {
                        <form method="post" asp-action="MarkAsDelivered">
                            <input type="hidden" name="id" value="@Model.OrderHeader.Id" />
                            <button type="submit" class="action-btn action-btn-success">
                                <i class="bi bi-check-circle-fill"></i>
                                Mark as Delivered
                            </button>
                        </form>
                    }

                    @if (Model.OrderHeader.OrderStatus != SD.StatusCancelled && 
                         Model.OrderHeader.OrderStatus != SD.StatusShipped &&
                         Model.OrderHeader.OrderStatus != SD.StatusDelivered)
                    {
                        <form method="post" asp-action="CancelOrder">
                            <input type="hidden" name="id" value="@Model.OrderHeader.Id" />
                            <button type="submit" class="action-btn action-btn-danger" 
                                    onclick="event.preventDefault(); Swal.fire({title: 'Cancel Order', text: 'Are you sure you want to cancel this order?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc2626', cancelButtonColor: '#6b7280', confirmButtonText: 'Yes, Cancel It', cancelButtonText: 'No'}).then((result) => { if (result.isConfirmed) { this.closest('form').submit(); } }); return false;">
                                <i class="bi bi-x-circle"></i>
                                Cancel Order
                            </button>
                        </form>
                    }
                </div>

                <!-- Order Timeline -->
                <div class="order-timeline">
                    <h3>
                        <i class="bi bi-clock-history"></i>
                        Order Timeline
                    </h3>
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-icon completed">
                                <i class="bi bi-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h4 class="timeline-title">Order Placed</h4>
                                <p class="timeline-date">@Model.OrderHeader.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                                <p class="timeline-description">Order has been successfully placed and payment confirmed.</p>
                            </div>
                        </div>

                        @if (Model.OrderHeader.OrderStatus == SD.StatusInProcess || 
                             Model.OrderHeader.OrderStatus == SD.StatusShipped)
                        {
                            <div class="timeline-item">
                                <div class="timeline-icon completed">
                                    <i class="bi bi-gear"></i>
                                </div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">Processing</h4>
                                    <p class="timeline-description">Order is being processed and prepared for shipping.</p>
                                </div>
                            </div>
                        }

                        @if (Model.OrderHeader.OrderStatus == SD.StatusShipped)
                        {
                            <div class="timeline-item">
                                <div class="timeline-icon completed">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">Shipped</h4>
                                    <p class="timeline-date">@Model.OrderHeader.ShippingDate.ToString("MMM dd, yyyy")</p>
                                    <p class="timeline-description">
                                        Carrier: <strong>@Model.OrderHeader.Carrier</strong><br />
                                        Tracking: <strong>@Model.OrderHeader.TrackingNumber</strong>
                                    </p>
                                </div>
                            </div>
                        }

                        @if (Model.OrderHeader.OrderStatus == SD.StatusCancelled)
                        {
                            <div class="timeline-item">
                                <div class="timeline-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                                    <i class="bi bi-x"></i>
                                </div>
                                <div class="timeline-content" style="border-left-color: #ef4444;">
                                    <h4 class="timeline-title">Order Cancelled</h4>
                                    <p class="timeline-description">This order has been cancelled.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="timeline-item">
                                <div class="timeline-icon pending">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">Delivered</h4>
                                    <p class="timeline-description">Estimated delivery: @DateTime.Now.AddDays(7).ToString("MMM dd") - @DateTime.Now.AddDays(14).ToString("MMM dd, yyyy")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add confirmation for cancel button
        document.querySelectorAll('.action-btn-danger').forEach(btn => {
            btn.addEventListener('click', function(e) {
                if (btn.type === 'submit') {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Cancel Order',
                        text: 'Are you sure you want to cancel this order? This action cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc2626',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Yes, Cancel It',
                        cancelButtonText: 'No',
                        dangerMode: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            btn.closest('form').submit();
                        }
                    });
                }
            });
        });
    </script>
}

