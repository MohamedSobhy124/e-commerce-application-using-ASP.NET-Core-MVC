@using Microsoft.AspNetCore.Mvc.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@model BulkyBook.Models.ComboOffer

@{
    ViewData["Title"] = Localizer["EditComboOffer"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="bi bi-pencil-square me-2"></i>@Localizer["EditComboOffer"]
            </h2>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input hidden asp-for="Id" />
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>@Localizer["BasicInformation"]</h5>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NameAr" class="form-label">@Localizer["NameAr"] <span class="text-danger">*</span></label>
                                <input asp-for="NameAr" class="form-control" dir="rtl" />
                                <span asp-validation-for="NameAr" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DescriptionAr" class="form-label">@Localizer["DescriptionAr"]</label>
                            <textarea asp-for="DescriptionAr" class="form-control" rows="3" dir="rtl"></textarea>
                            <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["CurrentImages"]</label>
                            <div id="existingImages" class="d-flex flex-wrap gap-2 mb-3">
                                @if (Model.ComboOfferImages != null && Model.ComboOfferImages.Any())
                                {
                                    foreach (var image in Model.ComboOfferImages.OrderBy(img => img.DisplayOrder))
                                    {
                                        <div class="position-relative" style="display: inline-block;">
                                            <img src="@image.ImageUrl" alt="@Model.Name" class="img-thumbnail existing-image" 
                                                 style="max-height: 150px; max-width: 150px; object-fit: cover;" 
                                                 data-image-id="@image.Id" />
                                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-image-btn" 
                                                    data-image-id="@image.Id" style="z-index: 10;">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="position-relative" style="display: inline-block;">
                                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail existing-image" 
                                             style="max-height: 150px; max-width: 150px; object-fit: cover;" 
                                             data-image-id="main" />
                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-image-btn" 
                                                data-image-id="main" style="z-index: 10;" title="Delete image">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">@Localizer["NoImages"]</p>
                                }
                            </div>
                            <input type="hidden" id="deletedImageIds" name="deletedImageIds" value="" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["AddMoreImages"]</label>
                            <input type="file" name="files" class="form-control" accept="image/*" multiple />
                            <small class="form-text text-muted">@Localizer["SelectMultipleImages"]</small>
                            <div id="newFileCount" class="mt-2 text-info" style="display: none;">
                                <i class="bi bi-info-circle"></i> <span id="newFileCountText">0 new file(s) selected</span>
                            </div>
                            <div id="imagePreview" class="mt-3 d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-currency-dollar me-2"></i>@Localizer["Pricing"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ComboPrice" class="form-label">@Localizer["ComboPrice"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">AED</span>
                                <input asp-for="ComboPrice" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="ComboPrice" class="text-danger"></span>
                        </div>

                        @if (Model.ComboOfferItems != null && Model.ComboOfferItems.Any())
                        {
                            <div class="alert alert-info">
                                <strong>@Localizer["OriginalTotalPrice"]:</strong> @Model.OriginalTotalPrice.ToString("C")<br />
                                <strong>@Localizer["ComboPrice"]:</strong> @Model.ComboPrice.ToString("C")<br />
                                <strong>@Localizer["Discount"]:</strong> <span class="text-danger">@Model.DiscountPercentage.ToString("F1")%</span><br />
                                <strong>@Localizer["YouSave"]:</strong> <span class="text-success">@Model.TotalSavings.ToString("C")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>@Localizer["Schedule"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label">@Localizer["StartDate"] <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label">@Localizer["EndDate"] <span class="text-danger">*</span></label>
                                <input asp-for="EndDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>@Localizer["Settings"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MinimumQuantity" class="form-label">@Localizer["MinimumQuantity"]</label>
                            <input asp-for="MinimumQuantity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="MinimumQuantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaximumQuantity" class="form-label">@Localizer["MaximumQuantityPerCustomer"]</label>
                            <input asp-for="MaximumQuantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="MaximumQuantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisplayOrder" class="form-label">@Localizer["DisplayOrder"]</label>
                            <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>@Localizer["UpdateComboOffer"]
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToList"]
                            </a>
                            <a asp-action="AddProducts" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="bi bi-box-seam me-2"></i>@Localizer["ManageProducts"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let deletedImageIds = [];
        
        // Handle delete image buttons
        document.querySelectorAll('.delete-image-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const imageId = this.getAttribute('data-image-id');
                const imageDiv = this.closest('.position-relative');
                
                if (imageId !== 'main') {
                    deletedImageIds.push(parseInt(imageId));
                } else {
                    // For main image, we'll mark it for deletion
                    deletedImageIds.push('main');
                }
                
                imageDiv.style.opacity = '0.5';
                imageDiv.style.pointerEvents = 'none';
                this.disabled = true;
                
                document.getElementById('deletedImageIds').value = deletedImageIds.join(',');
            });
        });
        
        // Handle new image preview with file accumulation
        let newFiles = [];
        const fileInput = document.querySelector('input[type="file"][name="files"]');
        const preview = document.getElementById('imagePreview');
        const form = fileInput ? fileInput.closest('form') : null;
        
        if (fileInput && form) {
            // Intercept form submission to ensure all files are included
            form.addEventListener('submit', function(e) {
                console.log('Form submitting. New files count:', newFiles.length);
                
                // If we have accumulated files, always use alternative method to ensure they're sent
                if (newFiles.length > 0) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Try to update file input first
                    updateFileInput();
                    
                    // Verify the update worked
                    console.log('File input files count after update:', fileInput.files.length);
                    
                    // Always use alternative method to ensure files are sent correctly
                    console.log('Using alternative submission method to ensure files are sent');
                    submitFormWithFiles();
                    return false;
                }
                
                // If no new files, allow normal submission
                console.log('No new files, submitting normally');
                return true;
            });
            
            fileInput.addEventListener('change', function(e) {
                console.log('File input changed. Files selected:', this.files.length);
                
                // Add new files to the array
                if (this.files && this.files.length > 0) {
                    Array.from(this.files).forEach(file => {
                        if (file.type.startsWith('image/')) {
                            // Check if file is not already in the array (use name, size, and lastModified for better duplicate detection)
                            const isDuplicate = newFiles.some(f => 
                                f.name === file.name && 
                                f.size === file.size && 
                                f.lastModified === file.lastModified
                            );
                            if (!isDuplicate) {
                                newFiles.push(file);
                                console.log('Added file:', file.name, 'Total new files:', newFiles.length);
                            }
                        }
                    });
                }
                
                // Update the file input with all accumulated files
                updateFileInput();
                // Update preview
                updateNewFilesPreview();
            });
            
            function updateFileInput() {
                if (newFiles.length === 0) {
                    console.log('No new files to update');
                    return;
                }
                
                try {
                    const dataTransfer = new DataTransfer();
                    newFiles.forEach(file => {
                        dataTransfer.items.add(file);
                    });
                    fileInput.files = dataTransfer.files;
                    console.log('File input updated. Files in input:', fileInput.files.length);
                } catch (err) {
                    console.error('DataTransfer not supported:', err);
                    // If DataTransfer fails, we'll use alternative submission
                }
            }
            
            function submitFormWithFiles() {
                // Use the original form's FormData to preserve all fields and anti-forgery token
                const originalFormData = new FormData(form);
                
                // Remove old files from form data
                originalFormData.delete('files');
                
                // Add all accumulated files
                newFiles.forEach(file => {
                    originalFormData.append('files', file);
                });
                
                // Ensure ID is set correctly
                const idInput = form.querySelector('input[name="Id"]');
                if (idInput) {
                    originalFormData.set('Id', idInput.value);
                }
                
                // Ensure anti-forgery token is in form data (not header for FormData)
                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput && !originalFormData.has('__RequestVerificationToken')) {
                    originalFormData.append('__RequestVerificationToken', tokenInput.value);
                }
                
                console.log('Submitting form with', newFiles.length, 'files via fetch');
                console.log('Form action:', form.action);
                console.log('ID:', idInput?.value);
                console.log('Files being sent:', Array.from(newFiles).map(f => f.name));
                console.log('Anti-forgery token present:', !!tokenInput?.value);
                
                // Submit via fetch - don't set Content-Type header, let browser set it with boundary for multipart/form-data
                fetch(form.action, {
                    method: 'POST',
                    body: originalFormData
                    // Don't set Content-Type - browser will set it automatically with boundary for FormData
                })
                .then(response => {
                    console.log('Response status:', response.status);
                    console.log('Response redirected:', response.redirected);
                    console.log('Response URL:', response.url);
                    
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else if (response.ok) {
                        return response.text().then(html => {
                            // Always show the response to see validation errors
                            document.open();
                            document.write(html);
                            document.close();
                        });
                    } else {
                        return response.text().then(html => {
                            console.error('Server error response:', html.substring(0, 1000));
                            // Try to extract error message
                            const errorMatch = html.match(/<div[^>]*class="[^"]*validation-summary-errors[^"]*"[^>]*>([\s\S]*?)<\/div>/i);
                            if (errorMatch) {
                                alert('Validation Error: ' + errorMatch[1].substring(0, 200));
                            }
                            document.open();
                            document.write(html);
                            document.close();
                        });
                    }
                })
                .catch(err => {
                    console.error('Form submission error:', err);
                    alert('Error submitting form: ' + err.message);
                });
            }
            
            function updateNewFilesPreview() {
                // Update file count
                const fileCountDiv = document.getElementById('newFileCount');
                const fileCountText = document.getElementById('newFileCountText');
                if (fileCountDiv && fileCountText) {
                    if (newFiles.length > 0) {
                        fileCountDiv.style.display = 'block';
                        fileCountText.textContent = newFiles.length + ' new file(s) selected';
                    } else {
                        fileCountDiv.style.display = 'none';
                    }
                }
                
                preview.innerHTML = '';
                newFiles.forEach((file, index) => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const imgWrapper = document.createElement('div');
                            imgWrapper.className = 'position-relative';
                            imgWrapper.style.display = 'inline-block';
                            imgWrapper.style.margin = '5px';
                            
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'img-thumbnail';
                            img.style.maxHeight = '150px';
                            img.style.maxWidth = '150px';
                            img.style.objectFit = 'cover';
                            
                            const removeBtn = document.createElement('button');
                            removeBtn.type = 'button';
                            removeBtn.className = 'btn btn-sm btn-danger position-absolute top-0 end-0 m-1';
                            removeBtn.style.zIndex = '10';
                            removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                            removeBtn.onclick = function() {
                                newFiles.splice(index, 1);
                                updateFileInput();
                                updateNewFilesPreview();
                            };
                            
                            imgWrapper.appendChild(img);
                            imgWrapper.appendChild(removeBtn);
                            preview.appendChild(imgWrapper);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        }
    </script>
}

