@using Microsoft.AspNetCore.Mvc.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@model BulkyBook.Models.ComboOffer

@{
    ViewData["Title"] = Localizer["ComboOfferDetails"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="bi bi-info-circle me-2"></i>@Localizer["ComboOfferDetails"]
                </h2>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-2"></i>@Localizer["Edit"]
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToList"]
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Localizer["Image"]</h5>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" />
                    }
                    else
                    {
                        <div class="bg-light p-5 rounded">
                            <i class="bi bi-image display-4 text-muted"></i>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">@Localizer["QuickInfo"]</h5>
                </div>
                <div class="card-body">
                    <p><strong>@Localizer["Status"]:</strong>
                        @if (Model.IsCurrentlyActive)
                        {
                            <span class="badge bg-success">@Localizer["Active"]</span>
                        }
                        else if (Model.HasEnded)
                        {
                            <span class="badge bg-secondary">@Localizer["Ended"]</span>
                        }
                        else if (!Model.HasStarted)
                        {
                            <span class="badge bg-warning">@Localizer["Upcoming"]</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@Localizer["Inactive"]</span>
                        }
                    </p>
                    <p><strong>@Localizer["TotalProducts"]:</strong> @Model.TotalProducts</p>
                    <p><strong>@Localizer["RequiredProducts"]:</strong> @Model.RequiredProductsCount</p>
                    <p><strong>@Localizer["MinimumQuantity"]:</strong> @Model.MinimumQuantity</p>
                    @if (Model.MaximumQuantity.HasValue)
                    {
                        <p><strong>@Localizer["MaximumQuantity"]:</strong> @Model.MaximumQuantity</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Localizer["BasicInformation"]</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Localizer["Name"]:</strong>
                            <p>@Model.Name</p>
                        </div>
                        <div class="col-md-6">
                            <strong>@Localizer["NameAr"]:</strong>
                            <p dir="rtl">@Model.NameAr</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["Description"]:</strong>
                        <p>@(string.IsNullOrEmpty(Model.Description) ? Localizer["NoDescription"] : Model.Description)</p>
                    </div>
                    <div class="mb-3">
                        <strong>@Localizer["DescriptionAr"]:</strong>
                        <p dir="rtl">@(string.IsNullOrEmpty(Model.DescriptionAr) ? Localizer["NoDescription"] : Model.DescriptionAr)</p>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">@Localizer["Pricing"]</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>@Localizer["OriginalTotalPrice"]:</strong> <span class="text-decoration-line-through">@Model.OriginalTotalPrice.ToString("C")</span></p>
                            <p><strong>@Localizer["ComboPrice"]:</strong> <span class="text-success fs-4">@Model.ComboPrice.ToString("C")</span></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>@Localizer["Discount"]:</strong> <span class="badge bg-danger fs-6">@Model.DiscountPercentage.ToString("F1")%</span></p>
                            <p><strong>@Localizer["YouSave"]:</strong> <span class="text-success fs-5">@Model.TotalSavings.ToString("C")</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">@Localizer["Schedule"]</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>@Localizer["StartDate"]:</strong> @Model.StartDate.ToString("MM/dd/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>@Localizer["EndDate"]:</strong> @Model.EndDate.ToString("MM/dd/yyyy HH:mm")</p>
                        </div>
                    </div>
                    @if (Model.IsCurrentlyActive)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-clock me-2"></i>
                            <strong>@Localizer["TimeRemaining"]:</strong> 
                            @{
                                var timeRemaining = Model.TimeRemaining;
                                if (timeRemaining.Days > 0)
                                {
                                    <text>@timeRemaining.Days @Localizer["Days"], @timeRemaining.Hours @Localizer["Hours"]</text>
                                }
                                else if (timeRemaining.Hours > 0)
                                {
                                    <text>@timeRemaining.Hours @Localizer["Hours"], @timeRemaining.Minutes @Localizer["Minutes"]</text>
                                }
                                else
                                {
                                    <text>@timeRemaining.Minutes @Localizer["Minutes"]</text>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">@Localizer["ProductsInCombo"]</h5>
                </div>
                <div class="card-body">
                    @if (Model.ComboOfferItems != null && Model.ComboOfferItems.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Product"]</th>
                                        <th>@Localizer["Variant"]</th>
                                        <th>@Localizer["Quantity"]</th>
                                        <th>@Localizer["Price"]</th>
                                        <th>@Localizer["Total"]</th>
                                        <th>@Localizer["Required"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ComboOfferItems.Where(i => !i.IsDeleted).OrderBy(i => i.DisplayOrder))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.Product?.Title</strong>
                                                @if (!string.IsNullOrEmpty(item.Product?.TitleAr))
                                                {
                                                    <br /><small class="text-muted" dir="rtl">@item.Product.TitleAr</small>
                                                }
                                            </td>
                                            <td>
                                                @if (item.ProductVariant != null)
                                                {
                                                    <span class="badge bg-secondary">@item.ProductVariant.VariantName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@item.Quantity</td>
                                            <td>
                                                @if (item.ProductVariant != null)
                                                {
                                                    @item.ProductVariant.Price.ToString("C")
                                                }
                                                else
                                                {
                                                    @item.Product?.Price.ToString("C")
                                                }
                                            </td>
                                            <td>@item.ItemPrice.ToString("C")</td>
                                            <td>
                                                @if (item.IsRequired)
                                                {
                                                    <span class="badge bg-danger">@Localizer["Required"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@Localizer["Optional"]</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["NoProductsInCombo"]
                        </div>
                    }
                    <div class="mt-3">
                        <a asp-action="AddProducts" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>@Localizer["AddProducts"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

