@using Microsoft.AspNetCore.Mvc.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@model BulkyBook.Models.ComboOffer

@{
    ViewData["Title"] = Localizer["ManageComboProducts"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="bi bi-box-seam me-2"></i>@Localizer["ManageProducts"] - @Model.Name
                </h2>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToList"]
                </a>
            </div>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Localizer["AddProduct"]</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddProduct" method="post">
                        <input type="hidden" name="comboOfferId" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Product"] <span class="text-danger">*</span></label>
                            <select name="productId" class="form-select" required>
                                <option value="">@Localizer["SelectProduct"]</option>
                                @foreach (var product in ViewBag.AvailableProducts as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    <option value="@product.Value">@product.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Quantity"] <span class="text-danger">*</span></label>
                            <input type="number" name="quantity" class="form-control" min="1" value="1" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["DisplayOrder"]</label>
                            <input type="number" name="displayOrder" class="form-control" min="0" value="0" />
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" name="isRequired" class="form-check-input" checked />
                                <label class="form-check-label">@Localizer["Required"]</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-circle me-2"></i>@Localizer["AddProduct"]
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">@Localizer["ProductsInCombo"] (@Model.ComboOfferItems.Count(i => !i.IsDeleted))</h5>
                </div>
                <div class="card-body">
                    @if (Model.ComboOfferItems != null && Model.ComboOfferItems.Any(i => !i.IsDeleted))
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Product"]</th>
                                        <th>@Localizer["Quantity"]</th>
                                        <th>@Localizer["Price"]</th>
                                        <th>@Localizer["Total"]</th>
                                        <th>@Localizer["DisplayOrder"]</th>
                                        <th>@Localizer["Required"]</th>
                                        <th>@Localizer["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ComboOfferItems.Where(i => !i.IsDeleted).OrderBy(i => i.DisplayOrder))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.Product?.Title</strong>
                                                @if (item.ProductVariant != null)
                                                {
                                                    <br /><small class="text-muted">Variant: @item.ProductVariant.VariantName</small>
                                                }
                                            </td>
                                            <td>@item.Quantity</td>
                                            <td>
                                                @if (item.ProductVariant != null)
                                                {
                                                    @item.ProductVariant.Price.ToString("C")
                                                }
                                                else
                                                {
                                                    @item.Product?.Price.ToString("C")
                                                }
                                            </td>
                                            <td>@item.ItemPrice.ToString("C")</td>
                                            <td>@item.DisplayOrder</td>
                                            <td>
                                                @if (item.IsRequired)
                                                {
                                                    <span class="badge bg-danger">@Localizer["Required"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@Localizer["Optional"]</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="RemoveProduct" method="post" class="d-inline">
                                                    <input type="hidden" name="comboOfferId" value="@Model.Id" />
                                                    <input type="hidden" name="itemId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('@Localizer["AreYouSureRemoveProduct"]')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3 p-3 bg-light rounded">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>@Localizer["OriginalTotalPrice"]:</strong> <span class="text-decoration-line-through">@Model.OriginalTotalPrice.ToString("C")</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>@Localizer["ComboPrice"]:</strong> <span class="text-success fs-5">@Model.ComboPrice.ToString("C")</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <strong>@Localizer["YouSave"]:</strong> <span class="text-success">@Model.TotalSavings.ToString("C")</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>@Localizer["Discount"]:</strong> <span class="badge bg-danger">@Model.DiscountPercentage.ToString("F1")%</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle me-2"></i>@Localizer["NoProductsInCombo"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

