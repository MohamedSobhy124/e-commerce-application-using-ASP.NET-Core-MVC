@using Microsoft.AspNetCore.Mvc.Localization
@inject IStringLocalizer<BulkyBook.SharedResources> Localizer
@model BulkyBook.Models.ComboOffer

@{
    ViewData["Title"] = Localizer["CreateComboOffer"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="bi bi-box-seam me-2"></i>@Localizer["CreateComboOffer"]
            </h2>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>@Localizer["BasicInformation"]</h5>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">@Localizer["Name"] <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NameAr" class="form-label">@Localizer["NameAr"] <span class="text-danger">*</span></label>
                                <input asp-for="NameAr" class="form-control" dir="rtl" />
                                <span asp-validation-for="NameAr" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DescriptionAr" class="form-label">@Localizer["DescriptionAr"]</label>
                            <textarea asp-for="DescriptionAr" class="form-control" rows="3" dir="rtl"></textarea>
                            <span asp-validation-for="DescriptionAr" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Images"] <span class="text-danger">*</span></label>
                            <input type="file" name="files" class="form-control" accept="image/*" multiple required />
                            <span class="text-danger field-validation-valid" data-valmsg-for="files" data-valmsg-replace="true"></span>
                            <small class="form-text text-muted">@Localizer["AtLeastOneImageRequired"]</small>
                            <div id="fileCount" class="mt-2 text-info" style="display: none;">
                                <i class="bi bi-info-circle"></i> <span id="fileCountText">0 files selected</span>
                            </div>
                            <div id="imagePreview" class="mt-3 d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-currency-dollar me-2"></i>@Localizer["Pricing"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ComboPrice" class="form-label">@Localizer["ComboPrice"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">AED</span>
                                <input asp-for="ComboPrice" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="ComboPrice" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["TotalPriceForCombo"]</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>@Localizer["Note"]:</strong> @Localizer["OriginalPriceWillBeCalculated"] @Localizer["AfterAddingProducts"]
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>@Localizer["Schedule"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label">@Localizer["StartDate"] <span class="text-danger">*</span></label>
                                <input asp-for="StartDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label">@Localizer["EndDate"] <span class="text-danger">*</span></label>
                                <input asp-for="EndDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>@Localizer["Settings"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MinimumQuantity" class="form-label">@Localizer["MinimumQuantity"]</label>
                            <input asp-for="MinimumQuantity" class="form-control" type="number" min="1" value="1" />
                            <span asp-validation-for="MinimumQuantity" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["MinimumComboQuantity"]</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaximumQuantity" class="form-label">@Localizer["MaximumQuantityPerCustomer"]</label>
                            <input asp-for="MaximumQuantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="MaximumQuantity" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["LeaveEmptyForUnlimited"]</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisplayOrder" class="form-label">@Localizer["DisplayOrder"]</label>
                            <input asp-for="DisplayOrder" class="form-control" type="number" min="0" value="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            <small class="form-text text-muted">@Localizer["LowerNumbersDisplayFirst"]</small>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>@Localizer["CreateComboOffer"]
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>@Localizer["BackToList"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function() {
            const fileInput = document.querySelector('input[type="file"][name="files"]');
            const preview = document.getElementById('imagePreview');
            const form = fileInput ? fileInput.closest('form') : null;
            let selectedFiles = [];
            
            if (fileInput && form) {
                // Update file input before form submission
                form.addEventListener('submit', function(e) {
                    console.log('Form submitting. Selected files count:', selectedFiles.length);
                    
                    // Ensure files are updated
                    if (selectedFiles.length > 0) {
                        updateFileInput();
                        
                        // Verify the update worked
                        console.log('File input files count after update:', fileInput.files.length);
                        
                        if (fileInput.files.length !== selectedFiles.length) {
                            console.warn('File count mismatch! Expected:', selectedFiles.length, 'Got:', fileInput.files.length);
                            // Try alternative method
                            e.preventDefault();
                            submitFormWithFiles();
                            return false;
                        }
                    }
                });
                
                fileInput.addEventListener('change', function(e) {
                    console.log('File input changed. Files selected:', this.files.length);
                    
                    // Add new files to the array
                    if (this.files && this.files.length > 0) {
                        Array.from(this.files).forEach(file => {
                            if (file.type.startsWith('image/')) {
                                // Check if file is not already in the array
                                const isDuplicate = selectedFiles.some(f => f.name === file.name && f.size === file.size && f.lastModified === file.lastModified);
                                if (!isDuplicate) {
                                    selectedFiles.push(file);
                                    console.log('Added file:', file.name, 'Total files:', selectedFiles.length);
                                }
                            }
                        });
                    }
                    
                    // Update the file input with all accumulated files
                    updateFileInput();
                    // Update preview
                    updatePreview();
                });
                
                function updateFileInput() {
                    if (selectedFiles.length === 0) {
                        console.log('No files to update');
                        return;
                    }
                    
                    try {
                        const dataTransfer = new DataTransfer();
                        selectedFiles.forEach(file => {
                            dataTransfer.items.add(file);
                        });
                        fileInput.files = dataTransfer.files;
                        console.log('File input updated. Files in input:', fileInput.files.length);
                    } catch (err) {
                        console.error('DataTransfer API not supported:', err);
                        alert('Your browser does not support multiple file selection. Please select all files at once.');
                    }
                }
                
                function submitFormWithFiles() {
                    const formData = new FormData(form);
                    
                    // Remove old files
                    formData.delete('files');
                    
                    // Add all accumulated files
                    selectedFiles.forEach(file => {
                        formData.append('files', file);
                    });
                    
                    // Submit via fetch
                    fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': form.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            return response.text().then(html => {
                                document.open();
                                document.write(html);
                                document.close();
                            });
                        }
                    })
                    .catch(err => {
                        console.error('Form submission error:', err);
                        alert('Error submitting form. Please try again.');
                    });
                }
                
                function updatePreview() {
                    // Update file count
                    const fileCountDiv = document.getElementById('fileCount');
                    const fileCountText = document.getElementById('fileCountText');
                    if (fileCountDiv && fileCountText) {
                        if (selectedFiles.length > 0) {
                            fileCountDiv.style.display = 'block';
                            fileCountText.textContent = selectedFiles.length + ' file(s) selected';
                        } else {
                            fileCountDiv.style.display = 'none';
                        }
                    }
                    
                    preview.innerHTML = '';
                    selectedFiles.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const imgWrapper = document.createElement('div');
                            imgWrapper.className = 'position-relative';
                            imgWrapper.style.display = 'inline-block';
                            imgWrapper.style.margin = '5px';
                            
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'img-thumbnail';
                            img.style.maxHeight = '150px';
                            img.style.maxWidth = '150px';
                            img.style.objectFit = 'cover';
                            
                            const removeBtn = document.createElement('button');
                            removeBtn.type = 'button';
                            removeBtn.className = 'btn btn-sm btn-danger position-absolute top-0 end-0 m-1';
                            removeBtn.style.zIndex = '10';
                            removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                            removeBtn.onclick = function() {
                                selectedFiles.splice(index, 1);
                                updateFileInput();
                                updatePreview();
                            };
                            
                            imgWrapper.appendChild(img);
                            imgWrapper.appendChild(removeBtn);
                            preview.appendChild(imgWrapper);
                        };
                        reader.readAsDataURL(file);
                    });
                }
            }
        })();
    </script>
}

